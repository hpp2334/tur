{
    "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
    "files": {
        "includes": [
            "**",
            "!!**/dist",
            "!!**/.rslib",
            "!!**/.runtime-build",
            "!!**/node_modules",
            "!!**/target",
            "!!**/pkg",
            "!!**/generated",
            "!!**/cases-generated.ts",
            "!!**/generated.ts",
            "!!**/test-results"
        ]
    },
    "vcs": {
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "rules": {
            "a11y": {
                "noStaticElementInteractions": "off"
            },
            "suspicious": {
                "noConfusingVoidType": "off",
                "noExplicitAny": "error"
            },
            "complexity": {
                "noUselessEmptyExport": "off"
            },
            "correctness": {
                "noUnusedImports": "off"
            }
        }
    }
}
