// The tur playground — one rut module (the Phase-4 rewrite of the
// playground-view bundle). Layout: a case-list sidebar beside an editor
// pane and a viewer pane; selecting a case loads its source into the
// editor (a multiline Input on a realm-minted controller) and RUNS it —
// `run_case` compiles through the host `pg_compile` row (which registers
// the source Rust-side and answers its id), destroys the previous child
// and spawns a fresh one under a new controller (the `runCase`
// destroy-then-spawn swap). The viewer hosts the child through a bound
// `VirtualAppView`; each controller's `va_status` rail is a watchable
// atom (`va_status_atom` + `rs_watch`) whose deliveries settle the
// viewer's state Switch (the boa viewer's FallbackView / RuntimeError
// shapes).
//
// The case registry (`pg_case_count` / `pg_case_name` / `pg_case_source`)
// is generated by scripts/gen-cases.cjs into cases_gen.rut and concatenated
// after this module by the website's `playgroundSource()`.
use tur::{ ALIGN_CENTER, AXIS_VERTICAL, CROSS_ALIGN_CENTER, CROSS_ALIGN_STRETCH, STACK_FIT_EXPAND,
    mount, pg_case_count, pg_case_name, pg_case_source, pg_compile, pg_compile_diags,
    rs_get_str, rs_list_new, rs_list_push, rs_set_bool, rs_set_str, rs_source_bool, rs_source_str,
    rs_source_value, rs_watch, rs_watch_start, rs_watch_stop, st_put, st_take, stf_put, stf_take,
    tctrl_new, tctrl_set_text, tctrl_text, undo_new, va_app_atom, va_app_set, va_controller,
    va_create_source, va_destroy, va_error, va_source_handle, va_status, va_status_atom };
use tur_kit::{ Column, Condition, Container, Each, Expanded, Input, PointerInteract, Row,
    ScrollView, SizedBox, Stack, Switch, Text, VirtualApp };

// ---- design tokens ---------------------------------------------------------
//
// The light theme from demo/playground-view/DESIGN-SYSTEM.md §1.1/§2 — the
// single source of truth for visual decisions (the boa reference palette:
// warm-tinted ink neutrals + the saturated teal signature + the coral
// complement + AA-verified status colors).
//
// Every value is a u64 packed **0xRRGGBBAA** (opaque = `| 0xFF`) — the kit
// header's color law, pinned natively by
// `libs/tur-integration-tests/tests/element/color_packing_law.rs`. The
// primitive palette (INK_* / TEAL_* / CORAL_* / STATUS_*) is the raw
// material; the views below use only the semantic layer (BG_* / TEXT_* /
// ACCENT_*), never a primitive directly. Module `let` initializers must be
// literals in this build, so the semantic layer restates the primitive's
// packed value (its origin is in the trailing comment) instead of aliasing.

// primitives — ink (warm-tinted neutrals)
let INK_50: u64 = 0xFBFCFDFFu64;
let INK_100: u64 = 0xF4F6F9FFu64;
let INK_150: u64 = 0xECEFF4FFu64;
let INK_200: u64 = 0xE1E5ECFFu64;
let INK_300: u64 = 0xD4D9E0FFu64;
let INK_400: u64 = 0xB8C0CCFFu64;
let INK_500: u64 = 0x8A94A3FFu64;
let INK_600: u64 = 0x5E6878FFu64;
let INK_700: u64 = 0x3A4250FFu64;
let INK_800: u64 = 0x1F2530FFu64;
let INK_900: u64 = 0x0A0E14FFu64;

// primitives — teal (the saturated cyan-leaning signature)
let TEAL_200: u64 = 0x7DF5D0FFu64;
let TEAL_300: u64 = 0x00E8B8FFu64;
let TEAL_400: u64 = 0x00C69AFFu64;
let TEAL_500: u64 = 0x00A886FFu64;
let TEAL_600: u64 = 0x008A6EFFu64;
let TEAL_700: u64 = 0x006E58FFu64;
let TEAL_800: u64 = 0x005440FFu64;

// primitives — coral (the warm complement; used sparingly)
let CORAL_300: u64 = 0xFFB3A3FFu64;
let CORAL_400: u64 = 0xFF8A72FFu64;
let CORAL_500: u64 = 0xE85D44FFu64;
let CORAL_700: u64 = 0xB03A1FFFu64;

// primitives — status (AA on ink.50; info reuses teal.700)
let STATUS_SUCCESS: u64 = 0x00A06BFFu64;
let STATUS_WARNING: u64 = 0xC47700FFu64;
let STATUS_ERROR: u64 = 0xD63A2FFFu64;
let STATUS_INFO: u64 = 0x006E58FFu64;

// semantic layer — what the views use (origin primitives in the comments)
let BG_APP: u64 = 0xFBFCFDFFu64; // ink.50
let BG_PANEL: u64 = 0xF4F6F9FFu64; // ink.100
let BG_ELEVATED: u64 = 0xECEFF4FFu64; // ink.150
let BG_HOVER: u64 = 0xE1E5ECFFu64; // ink.200
let BG_SELECTED: u64 = 0x7DF5D0FFu64; // teal.200
let BG_CODE: u64 = 0xFBFCFDFFu64; // ink.50
let BG_VIEWER: u64 = 0xFBFCFDFFu64; // ink.50 (bg.viewer)
let BG_DANGER: u64 = 0xFFF0EEFFu64; // #fff0ee (bg.danger)
let TEXT_PRIMARY: u64 = 0x1F2530FFu64; // ink.800
let TEXT_BODY: u64 = 0x3A4250FFu64; // ink.700
let TEXT_SECONDARY: u64 = 0x5E6878FFu64; // ink.600
let TEXT_TERTIARY: u64 = 0x8A94A3FFu64; // ink.500
let TEXT_PLACEHOLDER: u64 = 0xB8C0CCFFu64; // ink.400
let TEXT_CODE: u64 = 0x1F2530FFu64; // ink.800 (code.fg)
let TEXT_ON_ACCENT: u64 = 0x0A0E14FFu64; // ink.900 (text.onAccent)
let TEXT_ON_DANGER: u64 = 0x8A1A14FFu64; // #8a1a14 (text.onDanger)
let TEXT_INVERSE: u64 = 0xFBFCFDFFu64; // ink.50 (text.inverse)
let ACCENT_CURSOR: u64 = 0x00A886FFu64; // teal.500
let ACCENT_PRIMARY: u64 = 0x00C69AFFu64; // teal.400


let K_CTRL: u64 = 1;
let K_SELECTED: u64 = 2;
let K_NAMES: u64 = 3;
let K_STATUS: u64 = 4;
let K_VCTRL: u64 = 5;
let K_VERR: u64 = 6;
let K_HINT: u64 = 8;
let K_STATE: u64 = 9;
let K_APP: u64 = 10;
let K_HINTON: u64 = 11;
let K_VSTAT: u64 = 12;
let K_WATCH: u64 = 13;

entry fn start() -> u64 {
    // The sidebar's case list (from the generated registry).
    let names = rs_list_new();
    let n = pg_case_count();
    let mut i = 0;
    while (i < n as i32) {
        rs_list_push(names, pg_case_name(i as u64));
        i += 1;
    }
    let names_atom = rs_source_value(names);
    stf_put(K_NAMES, names_atom as f64);

    let selected = rs_source_str("");
    stf_put(K_SELECTED, selected as f64);
    let status = rs_source_str("pick a case");
    stf_put(K_STATUS, status as f64);
    let ctrl = tctrl_new();
    st_put(K_CTRL, ctrl);

    // The viewer's status rail: the state Switch + hint / error message
    // atoms the watch deliveries settle, and the reactive `app$` binding
    // atom (Nil — nothing bound until the first run).
    let state = rs_source_str("none");
    let verr = rs_source_str("");
    let hint = rs_source_str("(no case)");
    let hint_on = rs_source_bool(true);
    let app_atom = va_app_atom();
    stf_put(K_STATE, state as f64);
    stf_put(K_VERR, verr as f64);
    stf_put(K_HINT, hint as f64);
    stf_put(K_HINTON, hint_on as f64);
    stf_put(K_APP, app_atom as f64);

    // The controller stash starts seeded with a never-bound sentinel (an
    // empty module) so `run_case`'s destroy-then-spawn can unconditionally
    // `va_destroy` the stashed controller — and the status watch has a
    // rail to ride until the first run swaps in the real one.
    let seed = va_create_source("use tur::{ mount };\nentry fn start() {\n}\n");
    let seed_ctrl = va_controller(seed);
    st_put(K_VCTRL, seed_ctrl);
    watch_controller(seed_ctrl);

    build_ui();
    return status;
}

// Watch the controller's status rail (`va_status_atom` + `rs_watch`):
// the transitions deliver as intents into `on_vstat`, which settles the
// viewer's state atoms.
fn watch_controller(vctrl: opaque) {
    let stat = va_status_atom(vctrl);
    stf_put(K_VSTAT, stat as f64);
    let watch = rs_watch(stat, "on_vstat", 0);
    rs_watch_start(watch);
    st_put(K_WATCH, watch);
}

// The whole tree, built at start. A fresh Input mounts per build; on
// selection the controller write refreshes the mounted editable in place
// (see `case_tap`).
fn build_ui() {
    let names_atom = stf_take(K_NAMES) as u64;
    let ctrl = st_take(K_CTRL);
    let status = stf_take(K_STATUS) as u64;
    let state = stf_take(K_STATE) as u64;
    let verr = stf_take(K_VERR) as u64;
    let hint = stf_take(K_HINT) as u64;
    let hint_on = stf_take(K_HINTON) as u64;
    let app_atom = stf_take(K_APP) as u64;

    // ---- sidebar ------------------------------------------------------
    let sidebar = Container.builder().width_height(220.0, 0.0).color(BG_PANEL)
        .child(ScrollView.builder().axis(AXIS_VERTICAL)
            .child(Column.builder().child(Each.builder(names_atom).item_builder("side_item").build()).build())
            .build())
        .build();

    // ---- editor pane ----------------------------------------------------
    let title = Text.builder().text("playground — rut").color(TEXT_PRIMARY).font_size(14.0).build();
    let editor = Input.builder().controller(ctrl).undo(undo_new()).placeholder("select a case…")
        .color(TEXT_CODE).placeholder_color(TEXT_PLACEHOLDER).cursor_color(ACCENT_CURSOR)
        .width_height(1000.0, 480.0)
        .multiline(true).query_key("editor").build();
    let status_t = Text.builder().text_bound(status).color(TEXT_SECONDARY).query_key("status").build();

    // The toolbar: the Run button (primary teal fill — the boa shape).
    let run = PointerInteract.builder().ids(0, 0).on_tap("run_case").query_key("run")
        .child(Container.builder().width_height(72.0, 28.0).color(ACCENT_PRIMARY).radius(6.0)
            .alignment(ALIGN_CENTER)
            .child(Text.builder().text("Run").color(TEXT_ON_ACCENT).font_size(13.0).build())
            .build())
        .build();
    let toolbar = Container.builder().width_height(0.0, 40.0).color(BG_ELEVATED).padding(6.0)
        .child(Row.builder().child(run).build())
        .build();

    let pane = Column.builder().cross_alignment(CROSS_ALIGN_STRETCH)
        .child(Container.builder().width_height(0.0, 44.0).color(BG_ELEVATED).child(title).build())
        .child(toolbar)
        .child(Expanded.builder().flex(1.0)
            .child(Container.builder().color(BG_CODE).padding(12.0).child(editor).build())
            .build())
        .child(Container.builder().width_height(0.0, 32.0).color(BG_ELEVATED).padding(8.0)
            .child(status_t).build())
        .build();

    // ---- viewer pane ----------------------------------------------------
    // The Switch replaces the viewer only on FAILURE (the boa ErrorPanel
    // shapes); the fallback branch keeps the `VirtualAppView` mounted so
    // the bound controller always has a host to spawn into. The "(no
    // case)" / "starting..." hint is the FallbackView shape — an overlay
    // the child's first frame paints over (the Condition drops it once
    // the child settles).
    let viewer_title = Text.builder().text("viewer").color(TEXT_PRIMARY).font_size(14.0).build();
    let viewer = Column.builder().cross_alignment(CROSS_ALIGN_STRETCH)
        .child(Container.builder().width_height(0.0, 44.0).color(BG_ELEVATED).child(viewer_title).build())
        .child(Expanded.builder().flex(1.0)
            .child(Switch.builder().value_source(state)
                .cases("error", error_view("Runtime error", verr))
                .cases("compile-error", error_view("Compile error", verr))
                .fallback(ready_viewer(app_atom, hint, hint_on))
                .query_key("viewer-switch")
                .build())
            .build())
        .build();

    let shell = Container.builder().color(BG_APP).child(
        Row.builder().child(sidebar)
            .child(Expanded.builder().flex(1.0).child(pane).build())
            .child(Expanded.builder().flex(1.0).child(viewer).build())
            .build(),
    ).build();
    mount(shell);
    stf_put(K_NAMES, names_atom as f64);
    st_put(K_CTRL, ctrl);
    stf_put(K_STATUS, status as f64);
    stf_put(K_STATE, state as f64);
    stf_put(K_VERR, verr as f64);
    stf_put(K_HINT, hint as f64);
    stf_put(K_HINTON, hint_on as f64);
    stf_put(K_APP, app_atom as f64);
}

// The live viewer: the bound host + the hint overlay. Fit-expand so the
// overlay fills (and centers its label) while visible; the hidden branch
// is a decoration-less box that passes pointers through to the child.
fn ready_viewer(app_atom: u64, hint: u64, hint_on: u64) -> opaque {
    let host = VirtualApp.builder().bind(app_atom).query_key("viewer").build();
    let overlay = Condition.builder(hint_on)
        .then(Container.builder().color(BG_VIEWER).alignment(ALIGN_CENTER)
            .child(Text.builder().text_bound(hint).font_size(13.0).color(TEXT_TERTIARY)
                .query_key("viewer/hint").build())
            .build())
        .else_branch(SizedBox.builder(0.0, 0.0).build())
        .build();
    return Stack.builder().fit(STACK_FIT_EXPAND).child(host).child(overlay).build();
}

// The error panels — the boa RuntimeErrorView / ErrorPanel shape: red
// panel, "!" badge, title + message (the message atom is shared: the
// compile diags and the child's `va_error` land in the same rail).
fn error_view(title_text: str, err: u64) -> opaque {
    return Container.builder().color(BG_DANGER).padding(24.0).alignment(ALIGN_CENTER)
        .child(Column.builder().cross_alignment(CROSS_ALIGN_CENTER)
            .child(Container.builder().width_height(32.0, 32.0).radius(16.0).color(STATUS_ERROR)
                .alignment(ALIGN_CENTER)
                .child(Text.builder().text("!").font_size(18.0).color(TEXT_INVERSE).build())
                .build())
            .child(SizedBox.builder(0.0, 16.0).build())
            .child(Text.builder().text(title_text).font_size(14.0).color(TEXT_ON_DANGER).build())
            .child(SizedBox.builder(0.0, 8.0).build())
            .child(Text.builder().text_bound(err).font_size(12.0).color(TEXT_ON_DANGER).build())
            .build())
        .build();
}

// A sidebar entry — tapping loads + runs the case. The Each index IS
// the tap id (the intent's first argument).
entry fn side_item(i: u64, name: str) -> opaque {
    let row = Container.builder().width_height(0.0, 32.0).padding(8.0)
        .child(Text.builder().text(name).color(TEXT_BODY).font_size(13.0).build())
        .build();
    return PointerInteract.builder().ids(i, i).on_tap("case_tap").child(row).build();
}

entry fn case_tap(idx: u64, _b: u64, _n: f64) {
    let name = pg_case_name(idx);
    // Select: load the source into the editor controller, then run it.
    // The mounted Input refreshes on the write itself — `tctrl_set_text`
    // marks the mounted editable dirty and requests a frame — so no
    // re-mount is needed here (a mid-drain re-mount would wedge the
    // frame's render).
    let ctrl = st_take(K_CTRL);
    tctrl_set_text(ctrl, pg_case_source(name));
    st_put(K_CTRL, ctrl);
    let selected = stf_take(K_SELECTED) as u64;
    rs_set_str(selected, f"{name}");
    stf_put(K_SELECTED, selected as f64);
    run_case(0, 0, 0.0);
}

// The test rail's probe: select + run by sidebar index (the corpus
// probe-entry convention — `call_rut_entry` drives the (u64, f64) shape).
entry fn select(i: u64, _b: f64) {
    case_tap(i, 0, 0.0);
}

// The test rail's probe: report the live controller's `va_status` into the
// caller's str atom.
entry fn probe(state: u64, _b: f64) {
    let vctrl = st_take(K_VCTRL);
    let s = va_status(vctrl);
    st_put(K_VCTRL, vctrl);
    rs_set_str(state, s);
}

// Compile the editor's current source; on success destroy the previous
// child and spawn a fresh one under a new controller (the `runCase`
// destroy-then-spawn swap). On failure the viewer flips to the
// compile-error panel and the diagnostics land in the status line.
entry fn run_case(_a: u64, _b: u64, _n: f64) {
    let ctrl = st_take(K_CTRL);
    let src = tctrl_text(ctrl);
    st_put(K_CTRL, ctrl);

    let id = pg_compile(src);
    if (id == 0) {
        let diags = pg_compile_diags();
        let status = stf_take(K_STATUS) as u64;
        rs_set_str(status, diags);
        stf_put(K_STATUS, status as f64);
        let verr = stf_take(K_VERR) as u64;
        rs_set_str(verr, diags);
        stf_put(K_VERR, verr as f64);
        let state = stf_take(K_STATE) as u64;
        rs_set_str(state, "compile-error");
        stf_put(K_STATE, state as f64);
        return;
    }

    // Destroy-then-spawn: retire the previous child (and its status
    // watch), mint the new controller from the compile row's source id,
    // and swap the viewer's reactive `app$` atom — the mounted
    // `VirtualAppView` rebinds in the same flush and the new child
    // spawns. The new controller's status rail is watched in its place.
    let old = st_take(K_VCTRL);
    va_destroy(old);
    rs_watch_stop(st_take(K_WATCH));
    let vctrl = va_controller(va_source_handle(id));
    st_put(K_VCTRL, vctrl);
    watch_controller(vctrl);
    let app_atom = stf_take(K_APP) as u64;
    va_app_set(app_atom, vctrl);
    stf_put(K_APP, app_atom as f64);

    // The status rail: spawning (the watch deliveries settle it into
    // ready/error).
    let state = stf_take(K_STATE) as u64;
    rs_set_str(state, "spawning");
    stf_put(K_STATE, state as f64);
    let verr = stf_take(K_VERR) as u64;
    rs_set_str(verr, "");
    stf_put(K_VERR, verr as f64);
    let hint = stf_take(K_HINT) as u64;
    rs_set_str(hint, "starting...");
    stf_put(K_HINT, hint as f64);
    let hint_on = stf_take(K_HINTON) as u64;
    rs_set_bool(hint_on, true);
    stf_put(K_HINTON, hint_on as f64);
    let status = stf_take(K_STATUS) as u64;
    rs_set_str(status, "starting...");
    stf_put(K_STATUS, status as f64);
}

// The status-watch delivery (a Click-shaped intent: report, watched
// atom, seq). Stale rails (a destroyed controller's atom still firing on
// its `destroyed` write) are ignored by identity; the live rail settles
// the viewer atoms — the boa FallbackView / RuntimeError states.
entry fn on_vstat(_report: u64, watched: u64, _n: f64) {
    let cur = stf_take(K_VSTAT) as u64;
    stf_put(K_VSTAT, cur as f64);
    if (watched != cur) {
        return;
    }
    let s = rs_get_str(watched);
    if (s == "running") {
        let state = stf_take(K_STATE) as u64;
        rs_set_str(state, "ready");
        stf_put(K_STATE, state as f64);
        hide_hint();
        let status = stf_take(K_STATUS) as u64;
        rs_set_str(status, "ok");
        stf_put(K_STATUS, status as f64);
    }
    if (s == "error") {
        let vctrl = st_take(K_VCTRL);
        let msg = va_error(vctrl);
        st_put(K_VCTRL, vctrl);
        let verr = stf_take(K_VERR) as u64;
        rs_set_str(verr, msg);
        stf_put(K_VERR, verr as f64);
        let state = stf_take(K_STATE) as u64;
        rs_set_str(state, "error");
        stf_put(K_STATE, state as f64);
        hide_hint();
        let status = stf_take(K_STATUS) as u64;
        rs_set_str(status, f"runtime error: {msg}");
        stf_put(K_STATUS, status as f64);
    }
}

fn hide_hint() {
    let hint_on = stf_take(K_HINTON) as u64;
    rs_set_bool(hint_on, false);
    stf_put(K_HINTON, hint_on as f64);
    let hint = stf_take(K_HINT) as u64;
    rs_set_str(hint, "");
    stf_put(K_HINT, hint as f64);
}
