// The tur playground — one rut module (the Phase-4 rewrite of the
// playground-view bundle). Layout: a case-list sidebar beside an editor
// pane; selecting a case loads its source into the editor (a multiline
// Input on a realm-minted controller) and compiles it through the host
// `pg_compile` row (the retired swc plugin's replacement), reporting the
// diagnostics in the status line.
//
// The case registry (`pg_case_count` / `pg_case_name` / `pg_case_source`)
// is generated by scripts/gen-cases.cjs into cases_gen.rut and concatenated
// after this module by the website's `playgroundSource()`.
use tur::{ AXIS_VERTICAL, CROSS_ALIGN_STRETCH, mount, pg_case_count, pg_case_name, pg_case_source,
    pg_compile, rs_list_new, rs_list_push, rs_set_str, rs_source_str, rs_source_value, st_put,
    st_take, stf_put, stf_take, tctrl_new, tctrl_set_text, tctrl_text, undo_new };
use tur_kit::{ Column, Container, Each, Expanded, Input, PointerInteract, Row, ScrollView, Text };


let K_CTRL: u64 = 1;
let K_SELECTED: u64 = 2;
let K_NAMES: u64 = 3;
let K_STATUS: u64 = 4;

entry fn start() -> u64 {
    // The sidebar's case list (from the generated registry).
    let names = rs_list_new();
    let n = pg_case_count();
    let mut i = 0;
    while (i < n as i32) {
        rs_list_push(names, pg_case_name(i as u64));
        i += 1;
    }
    let names_atom = rs_source_value(names);
    stf_put(K_NAMES, names_atom as f64);

    let selected = rs_source_str("");
    stf_put(K_SELECTED, selected as f64);
    let status = rs_source_str("pick a case");
    stf_put(K_STATUS, status as f64);
    let ctrl = tctrl_new();
    st_put(K_CTRL, ctrl);
    build_ui();
    return names_atom;
}

// The whole tree, (re)built at start and after each selection (a fresh
// Input mounts the controller's current text).
fn build_ui() {
    let names_atom = stf_take(K_NAMES) as u64;
    let ctrl = st_take(K_CTRL);
    let status = stf_take(K_STATUS) as u64;
    let mut row = Row.new();

    // ---- sidebar ------------------------------------------------------
    let mut sidebar = Container.new();
    sidebar.width_height(220.0, 0.0);
    sidebar.color(0x0F172AFFu64);
    let mut sidebar_list = Column.new();
    sidebar_list.child(Each.new(names_atom).item_builder("side_item").build());
    let scroller = ScrollView.new().axis(AXIS_VERTICAL).child(sidebar_list.build()).build();
    sidebar.child(scroller);
    row.child(sidebar.build());

    // ---- editor pane ----------------------------------------------------
    let mut pane = Column.new();
    pane.cross_alignment(CROSS_ALIGN_STRETCH);
    let mut toolbar = Container.new();
    toolbar.width_height(0.0, 44.0);
    toolbar.color(0x1E293BFFu64);
    let mut title = Text.new();

    title.text("playground — rut");
    title.font_size(14.0);
    toolbar.child(title.build());
    pane.child(toolbar.build());

    let mut editor_wrap = Container.new();
    editor_wrap.color(0x0B1220FFu64);
    editor_wrap.padding(12.0);
    let undo = undo_new();
    let mut editor = Input.new().controller(ctrl).undo(undo).placeholder("select a case…").width_height(1000.0, 480.0).multiline(true).query_key("editor").build();
    editor_wrap.child(editor);
    pane.child(Expanded.new().flex(1.0).child(editor_wrap.build()).build());

    let mut status_bar = Container.new();
    status_bar.width_height(0.0, 32.0);
    status_bar.color(0x020617FFu64);
    status_bar.padding(8.0);
    let mut status_t = Text.new();

    status_t.text_bound(status);
    status_t.query_key("status");
    status_bar.child(status_t.build());
    pane.child(status_bar.build());

    row.child(Expanded.new().flex(1.0).child(pane.build()).build());
    mount(row.build());
    stf_put(K_NAMES, names_atom as f64);
    st_put(K_CTRL, ctrl);
    stf_put(K_STATUS, status as f64);
}

// A sidebar entry — tapping loads + compiles the case. The Each index IS
// the tap id (the intent's first argument).
entry fn side_item(i: u64, name: str) -> opaque {
    let mut b = Container.new();
    b.width_height(0.0, 32.0);
    b.padding(8.0);
    let mut t = Text.new();

    t.text(name);
    t.font_size(13.0);
    b.child(t.build());
    return PointerInteract.new().ids(i, i).on_tap("case_tap").child(b.build()).build();
}

entry fn case_tap(idx: u64, _b: u64, _n: f64) {
    let name = pg_case_name(idx);
    // Select: load the source into the editor controller, then compile.
    // (The Input re-mounting on selection is a follow-up — the C1 rows do
    // not yet refresh a mounted editable on programmatic controller writes,
    // so the tree is NOT rebuilt here: a mid-drain re-mount wedges the
    // frame's render.)
    let ctrl = st_take(K_CTRL);
    tctrl_set_text(ctrl, pg_case_source(name));
    st_put(K_CTRL, ctrl);
    let selected = stf_take(K_SELECTED) as u64;
    rs_set_str(selected, f"{name}");
    stf_put(K_SELECTED, selected as f64);
    compile(0, 0.0);
}

// Compile the editor's current source; the answer lands in the status bar.
entry fn compile(_a: u64, _b: f64) {
    let ctrl = st_take(K_CTRL);
    let src = tctrl_text(ctrl);
    let status = stf_take(K_STATUS) as u64;
    rs_set_str(status, pg_compile(src));
    stf_put(K_STATUS, status as f64);
    st_put(K_CTRL, ctrl);
}
