// The tur playground — one rut module (the Phase-4 rewrite of the
// playground-view bundle). Layout: a case-list sidebar beside an editor
// pane; selecting a case loads its source into the editor (a multiline
// Input on a realm-minted controller) and compiles it through the host
// `pg_compile` row (the retired swc plugin's replacement), reporting the
// diagnostics in the status line.
//
// The case registry (`pg_case_count` / `pg_case_name` / `pg_case_source`)
// is generated by scripts/gen-cases.cjs into cases_gen.rut and concatenated
// after this module by the website's `playgroundSource()`.
use tur::{
 CROSS_ALIGN_STRETCH, el_box_new, box_color, box_padding, box_radius, box_size,
 el_build, el_child, el_column, el_expand, el_input_opts, el_pi, el_qkey,
 el_row, el_scroll, el_sizedbox, el_text_bound_new, el_text_new, el_vqkey,
 flex_cross_align, mount, rs_each, rs_list_new, rs_list_push, rs_set_str,
 rs_source_str, rs_source_value, stf_put, stf_take, tctrl_new, tctrl_set_text,
 tctrl_text, text_size, undo_new,
};

let K_CTRL: u64 = 1;
let K_SELECTED: u64 = 2;
let K_NAMES: u64 = 3;
let K_STATUS: u64 = 4;

entry fn start() -> u64 {
    // The sidebar's case list (from the generated registry).
    let names = rs_list_new();
    let n = pg_case_count();
    let mut i = 0;
    while (i < n as i32) {
        rs_list_push(names, pg_case_name(i as u64));
        i += 1;
    }
    let names_atom = rs_source_value(names);
    stf_put(K_NAMES, names_atom as f64);

    let selected = rs_source_str("");
    stf_put(K_SELECTED, selected as f64);
    let status = rs_source_str("pick a case");
    stf_put(K_STATUS, status as f64);
    let ctrl = tctrl_new();
    st_put(K_CTRL, ctrl);
    build_ui();
    return names_atom;
}

// The whole tree, (re)built at start and after each selection (a fresh
// Input mounts the controller's current text).
fn build_ui() {
    let names_atom = stf_take(K_NAMES) as u64;
    let ctrl = st_take(K_CTRL);
    let status = stf_take(K_STATUS) as u64;
    let row = el_row();

    // ---- sidebar ------------------------------------------------------
    let sidebar = el_box_new();
    box_size(sidebar, 220.0, 0.0);
    box_color(sidebar, 0x0F172AFFu64);
    let sidebar_list = el_column();
    el_child(sidebar_list, rs_each(names_atom, "side_item"));
    let scroller = el_scroll(true, el_build(sidebar_list));
    el_child(sidebar, scroller);
    el_child(row, el_build(sidebar));

    // ---- editor pane ----------------------------------------------------
    let pane = el_column();
    flex_cross_align(pane, CROSS_ALIGN_STRETCH);
    let toolbar = el_box_new();
    box_size(toolbar, 0.0, 44.0);
    box_color(toolbar, 0x1E293BFFu64);
    let title = el_text_new("playground — rut");
    text_size(title, 14.0);
    el_child(toolbar, el_build(title));
    el_child(pane, el_build(toolbar));

    let editor_wrap = el_box_new();
    box_color(editor_wrap, 0x0B1220FFu64);
    box_padding(editor_wrap, 12.0);
    let undo = undo_new();
    let editor = el_input_opts(ctrl, undo, "select a case…", 1000.0, 480.0, 1);
    el_child(editor_wrap, el_vqkey(editor, "editor"));
    el_child(pane, el_expand(1.0, el_build(editor_wrap)));

    let status_bar = el_box_new();
    box_size(status_bar, 0.0, 32.0);
    box_color(status_bar, 0x020617FFu64);
    box_padding(status_bar, 8.0);
    let status_t = el_text_bound_new(status);
    el_qkey(status_t, "status");
    el_child(status_bar, el_build(status_t));
    el_child(pane, el_build(status_bar));

    el_child(row, el_expand(1.0, el_build(pane)));
    mount(el_build(row));
    stf_put(K_NAMES, names_atom as f64);
    st_put(K_CTRL, ctrl);
    stf_put(K_STATUS, status as f64);
}

// A sidebar entry — tapping loads + compiles the case. The Each index IS
// the tap id (the intent's first argument).
entry fn side_item(i: u64, name: str) -> opaque {
    let b = el_box_new();
    box_size(b, 0.0, 32.0);
    box_padding(b, 8.0);
    let t = el_text_new(name);
    text_size(t, 13.0);
    el_child(b, el_build(t));
    return el_pi(i, i, "case_tap", "", 0, "", el_build(b));
}

entry fn case_tap(idx: u64, _b: u64, _n: f64) {
    let name = pg_case_name(idx);
    // Select: load the source into the editor controller, then compile.
    // (The Input re-mounting on selection is a follow-up — the C1 rows do
    // not yet refresh a mounted editable on programmatic controller writes,
    // so the tree is NOT rebuilt here: a mid-drain re-mount wedges the
    // frame's render.)
    let ctrl = st_take(K_CTRL);
    tctrl_set_text(ctrl, pg_case_source(name));
    st_put(K_CTRL, ctrl);
    let selected = stf_take(K_SELECTED) as u64;
    rs_set_str(selected, f"{name}");
    stf_put(K_SELECTED, selected as f64);
    compile(0, 0.0);
}

// Compile the editor's current source; the answer lands in the status bar.
entry fn compile(_a: u64, _b: f64) {
    let ctrl = st_take(K_CTRL);
    let src = tctrl_text(ctrl);
    let status = stf_take(K_STATUS) as u64;
    rs_set_str(status, pg_compile(src));
    stf_put(K_STATUS, status as f64);
    st_put(K_CTRL, ctrl);
}
