fn pg_case_source(name: str) -> str {
    if (name == "clickable-text") {
        return "// clickable-text: a PointerInteract wrapping a bound Text — the click\n// swaps the atom's content.\nuse tur::{ CROSS_ALIGN_START, mount, rs_set_str, rs_source_str };\nuse tur_kit::{ Column, PointerInteract, Text };\n\n\nentry fn start() -> u64 {\n    let content = rs_source_str(\"before\");\n    let mut col = Column().cross_alignment(CROSS_ALIGN_START);\n    let t = Text().text_bound(content).query_key(\"click-text\");\n    col.child(PointerInteract().ids(content, content).on_tap(\"ts_click\").child(t.build()).build());\n    mount(col.build());\n    return content;\n}\n\nentry fn ts_click(content: u64, _b: u64, _n: f64) {\n    rs_set_str(content, \"after\");\n}\n";
    }
    if (name == "column-basic") {
        return "// column-basic: two fixed-height children stacked vertically (the root\n// Column fills the viewport; cross axis start-aligned).\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Column, Container };\n\n\nfn box_h(h: f64) -> opaque {\n    let b = Container().width_height(0.0, h);\n    return b.build();\n}\n\nentry fn start() {\n    let col = Column().cross_alignment(CROSS_ALIGN_START).child(box_h(50.0)).child(box_h(30.0));\n    mount(col.build());\n}\n";
    }
    if (name == "column-container-text-intrinsic") {
        return "// column-container-text-intrinsic: a padded, unsized Container in a Column\n// sizes from its Text child's intrinsic measurement.\nuse tur::{ mount };\nuse tur_kit::{ Column, Container, Text };\n\n\nentry fn start() {\n    let mut col = Column();\n    let b = Container()\n        .padding(48.0)\n        .query_key(\"container\")\n        .child(Text().text(\"Empty State\").font_size(24.0).query_key(\"text\").build());\n    col.child(b.build());\n    mount(col.build());\n}\n";
    }
    if (name == "column-cross-start") {
        return "// column-cross-start: one 100x50 box, cross axis start-aligned.\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Column, Container };\n\n\nentry fn start() {\n    let col = Column().cross_alignment(CROSS_ALIGN_START).child(Container().width_height(100.0, 50.0).build());\n    mount(col.build());\n}\n";
    }
    if (name == "column-expanded-container-text") {
        return "// column-expanded-container-text: a padded unsized Container sized from\n// its Text child, wrapped in Expanded inside a max Column.\nuse tur::{ mount };\nuse tur_kit::{ Column, Container, Expanded, Text };\n\n\nentry fn start() {\n    let mut col = Column();\n    let b = Container()\n        .padding(48.0)\n        .query_key(\"container\")\n        .child(Text().text(\"Empty State\").font_size(24.0).build());\n    col.child(Expanded().flex(1.0).child(b.build()).build());\n    mount(col.build());\n}\n";
    }
    if (name == "column-main-end") {
        return "// column-main-end: two fixed-height children pinned to the main-axis end.\nuse tur::{ CROSS_ALIGN_START, MAIN_ALIGN_END, mount };\nuse tur_kit::{ Column, Container };\n\n\nfn box_h(h: f64) -> opaque {\n    let b = Container().width_height(0.0, h);\n    return b.build();\n}\n\nentry fn start() {\n    let col = Column()\n        .main_alignment(MAIN_ALIGN_END)\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(box_h(50.0))\n        .child(box_h(30.0));\n    mount(col.build());\n}\n";
    }
    if (name == "column-nested") {
        return "// column-nested: a Column inside a Column. Non-flex children receive\n// UNBOUNDED main-axis constraints, so the inner Column (default\n// MainAxisSize.max) must degenerate to content size (Flutter RenderFlex\n// parity).\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Column, Container };\n\n\nfn box_h(h: f64) -> opaque {\n    let b = Container().width_height(0.0, h);\n    return b.build();\n}\n\nentry fn start() {\n    let outer = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(box_h(50.0))\n        .child(Column().cross_alignment(CROSS_ALIGN_START).child(box_h(30.0)).build())\n        .child(box_h(40.0));\n    mount(outer.build());\n}\n";
    }
    if (name == "column-overflow") {
        return "// column-overflow: three 300px children in a Min column — total 900px\n// overflows the 600px viewport. Children keep their natural height (not\n// squished to 0).\nuse tur::{ MAIN_SIZE_MIN, mount };\nuse tur_kit::{ Column, Container };\n\n\nfn box_h(h: f64) -> opaque {\n    let b = Container().width_height(0.0, h);\n    return b.build();\n}\n\nentry fn start() {\n    let col = Column()\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(box_h(300.0))\n        .child(box_h(300.0))\n        .child(box_h(300.0));\n    mount(col.build());\n}\n";
    }
    if (name == "column-stretch-container-text") {
        return "// column-stretch-container-text: Column(crossAlignment: Stretch) around a\n// padded unsized Container + Text — full-width colored strip.\nuse tur::{ CROSS_ALIGN_STRETCH, mount };\nuse tur_kit::{ Column, Container, Text };\n\n\nentry fn start() {\n    let col = Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .child(Container().color(0xFF0000FFu64).padding(20.0).query_key(\"container\").child(Text().text(\"Empty State\").build()).build());\n    mount(col.build());\n}\n";
    }
    if (name == "complex-animation") {
        return "// complex-animation: the showcase twin — a controller-driven animation\n// with explicit tween composition (opacity + translate on one target).\nuse tur::{ anim_ctrl, anim_forward, anim_repeat, mount, rs_source_f64 };\nuse tur_kit::{ Column, Container, Expanded, SizedBox, Text };\nuse tur_anim_kit::{ Opacity };\n\n\nentry fn start() -> u64 {\n    let t = rs_source_f64();\n    let ctrl = anim_ctrl(t, 2000.0, \"easeInOut\", 0, \"a_tick\", \"a_end\");\n    anim_repeat(ctrl, 1000);\n    anim_forward(ctrl);\n\n    let mut col = Column()\n        .child(SizedBox(400.0, 40.0).child(Text().text(\"complex-animation: repeat + tween\").build()).build());\n    let target = Container().width_height(60.0, 60.0).color(0x6366F1FFu64);\n    let opacity = Opacity(0.0).bound(t).child(target.build()).build();\n    col.child(Expanded().flex(1.0).child(opacity).build());\n    mount(col.build());\n    return t;\n}\n\nentry fn a_tick(_atom: u64, _t: f64) {\n}\n\nentry fn a_end(_atom: u64, _v: f64) {\n}\n";
    }
    if (name == "composited-transform-basic") {
        return "// composited-transform-basic: default TopLeft/TopLeft anchors, zero\n// targetOffset — the follower lands on the target's top-left (100, 80).\nuse tur::{ ALIGN_TOP_LEFT, ct_link_new, mount };\nuse tur_kit::{ CompositedFollower, CompositedTarget, Container, Positioned, SizedBox, Stack };\n\n\nentry fn start() {\n    let link = ct_link_new();\n    let mut stack = Stack()\n        .child(SizedBox(400.0, 600.0).child(Container().build()).build());\n    let target_child = SizedBox(60.0, 40.0).child(Container().build()).build();\n    let target = CompositedTarget().link(link).child(target_child).build();\n    stack.child(Positioned().left(100.0).top(80.0).child(target).build());\n    let red = Container().width_height(20.0, 20.0).color(0xFF0000FFu64);\n    let follower = CompositedFollower().link(link).target_anchor(ALIGN_TOP_LEFT).follower_anchor(ALIGN_TOP_LEFT).child(red.build()).build();\n    stack.child(follower);\n    mount(stack.build());\n}\n";
    }
    if (name == "composited-transform-follower-anchor") {
        return "// composited-transform-follower-anchor: explicit follower anchor — the\n// follower's BOTTOM_RIGHT lands on the target's top-left (the anchor\n// math the subsystem solves).\nuse tur::{ ALIGN_BOTTOM_RIGHT, ALIGN_TOP_RIGHT, ct_link_new, mount };\nuse tur_kit::{ CompositedFollower, CompositedTarget, Container, Positioned, SizedBox, Stack };\n\n\nentry fn start() {\n    let link = ct_link_new();\n    let mut stack = Stack()\n        .child(SizedBox(400.0, 600.0).child(Container().build()).build());\n    let target_child = SizedBox(60.0, 40.0).child(Container().build()).build();\n    let target = CompositedTarget().link(link).child(target_child).build();\n    stack.child(Positioned().left(100.0).top(80.0).child(target).build());\n    let red = Container().width_height(60.0, 40.0).color(0x2563EBFFu64).color(0xFF0000FFu64);\n    let follower = CompositedFollower().link(link).target_anchor(ALIGN_BOTTOM_RIGHT).follower_anchor(ALIGN_TOP_RIGHT).child(red.build()).build();\n    stack.child(follower);\n    mount(stack.build());\n}\n";
    }
    if (name == "composited-transform-follower-under-transform") {
        return "// composited-transform-follower-under-transform: the FOLLOWER's ancestor\n// carries a paint-only translate (50, 30) — the subsystem solves\n// parent_world^-1 * translate so the follower lands on the target (100, 80).\nuse tur::{ ALIGN_TOP_LEFT, ct_link_new, mount };\nuse tur_kit::{ CompositedFollower, CompositedTarget, Container, Positioned, SizedBox, Stack };\nuse tur_anim_kit::{ Transform };\n\n\nentry fn start() {\n    let link = ct_link_new();\n    let mut stack = Stack()\n        .child(SizedBox(400.0, 600.0).child(Container().build()).build());\n    let target_child = SizedBox(60.0, 40.0).child(Container().build()).build();\n    let target = CompositedTarget().link(link).child(target_child).build();\n    stack.child(Positioned().left(100.0).top(80.0).child(target).build());\n    let red = Container().width_height(20.0, 20.0).color(0xFF0000FFu64);\n    let follower = CompositedFollower().link(link).target_anchor(ALIGN_TOP_LEFT).follower_anchor(ALIGN_TOP_LEFT).child(red.build()).build();\n    let transformed = Transform(1.0, 0.0, 50.0, 30.0).child(follower).build();\n    stack.child(transformed);\n    mount(stack.build());\n}\n";
    }
    if (name == "composited-transform-reactive-anchor") {
        return "// composited-transform-reactive-anchor: the target anchor resolves from an\n// atom; the button (20, 540) flips it to BottomRight — the follower\n// relocates to the target's bottom-right (160, 120).\nuse tur::{ ALIGN_TOP_LEFT, ct_link_new, mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ CompositedFollower, CompositedTarget, Container, PointerInteract, Positioned, SizedBox, Stack };\n\n\nentry fn start() -> u64 {\n    let anchor = rs_source_f64();\n    rs_set_f64(anchor, 0.0);\n    let link = ct_link_new();\n    let mut stack = Stack()\n        .child(SizedBox(400.0, 600.0).child(Container().build()).build());\n    let target_child = SizedBox(60.0, 40.0).child(Container().build()).build();\n    let target = CompositedTarget().link(link).child(target_child).build();\n    stack.child(Positioned().left(100.0).top(80.0).child(target).build());\n    let red = Container().width_height(20.0, 20.0).color(0xFF0000FFu64);\n    let follower = CompositedFollower().link(link).target_anchor_bound(anchor).follower_anchor(ALIGN_TOP_LEFT).child(red.build()).build();\n    stack.child(follower);\n\n    let btn = Container().width_height(60.0, 30.0).color(0x4F46E1FFu64);\n    stack.child(Positioned().left(20.0).top(540.0).child(PointerInteract().ids(anchor, anchor).on_tap(\"b_flip\").child(btn.build()).build()).build());\n    mount(stack.build());\n    return anchor;\n}\n\nentry fn b_flip(anchor: u64, _b: u64, _n: f64) {\n    rs_set_f64(anchor, 8.0);\n}\n";
    }
    if (name == "composited-transform-scroll") {
        return "// composited-transform-scroll: the target lives inside a scrollable\n// (content offset y=100); scrolling moves the target and the follower\n// tracks it.\nuse tur::{ ALIGN_TOP_LEFT, AXIS_VERTICAL, ct_link_new, mount };\nuse tur_kit::{ Column, CompositedFollower, CompositedTarget, Container, Positioned, ScrollView, SizedBox, Stack };\n\n\nentry fn start() {\n    let link = ct_link_new();\n    let mut stack = Stack()\n        .child(SizedBox(400.0, 600.0).child(Container().build()).build());\n\n    // The scrollable viewport (200x200) with 400px of content; the target\n    // sits at content y=100 (after a 100px spacer).\n    let mut content = Column()\n        .child(SizedBox(200.0, 100.0).child(Container().build()).build());\n    let target_child = SizedBox(60.0, 40.0).child(Container().build()).build();\n    let target = CompositedTarget().link(link).child(target_child).build();\n    content.child(target);\n    content.child(SizedBox(200.0, 300.0).child(Container().build()).build());\n    let scroller = ScrollView().axis(AXIS_VERTICAL).child(content.build()).build();\n    stack.child(Positioned().width(200.0).height(200.0).child(scroller).build());\n\n    let red = Container().width_height(20.0, 20.0).color(0xFF0000FFu64);\n    let follower = CompositedFollower().link(link).target_anchor(ALIGN_TOP_LEFT).follower_anchor(ALIGN_TOP_LEFT).child(red.build()).build();\n    stack.child(follower);\n    mount(stack.build());\n}\n";
    }
    if (name == "composited-transform-sibling-relayout") {
        return "// composited-transform-sibling-relayout: an unrelated sibling's reactive\n// height flip forces the common Stack to relayout — the follower must keep\n// painting at the tracked (100, 80).\nuse tur::{ ALIGN_TOP_LEFT, ct_link_new, mount, rs_set_f64, rs_source_f64, stf_put };\nuse tur_kit::{ CompositedFollower, CompositedTarget, Container, PointerInteract, Positioned, SizedBox, Stack };\n\n\nlet K_TALL: u64 = 1;\n\nentry fn start() -> u64 {\n    let tall = rs_source_f64();\n    rs_set_f64(tall, 0.0);\n    stf_put(K_TALL, tall as f64);\n    let link = ct_link_new();\n    let mut stack = Stack()\n        .child(SizedBox(400.0, 600.0).child(Container().build()).build());\n    let target_child = SizedBox(60.0, 40.0).child(Container().build()).build();\n    let target = CompositedTarget().link(link).child(target_child).build();\n    stack.child(Positioned().left(100.0).top(80.0).child(target).build());\n    let red = Container().width_height(20.0, 20.0).color(0xFF0000FFu64);\n    let follower = CompositedFollower().link(link).target_anchor(ALIGN_TOP_LEFT).follower_anchor(ALIGN_TOP_LEFT).child(red.build()).build();\n    stack.child(follower);\n\n    // The reactive sibling (non-positioned): height flips 10 -> 120.\n    let sib = Container().width_height(40.0, 0.0).color(0x4F46E1FFu64);\n    stack.child(sib.build());\n\n    let btn = Container().width_height(60.0, 30.0).color(0x16A34AFFu64);\n    stack.child(Positioned().left(300.0).top(540.0).child(PointerInteract().ids(tall, tall).on_tap(\"b_tall\").child(btn.build()).build()).build());\n    mount(stack.build());\n    return tall;\n}\n\nentry fn b_tall(tall: u64, _b: u64, _n: f64) {\n    rs_set_f64(tall, 120.0);\n}\n";
    }
    if (name == "composited-transform-transform") {
        return "// composited-transform-transform: the target sits under a paint-only\n// Transform translate (50, 10) at layout (20, 20) — the follower tracks the\n// PAINTED position (70, 30).\nuse tur::{ ALIGN_TOP_LEFT, ct_link_new, mount };\nuse tur_kit::{ CompositedFollower, CompositedTarget, Container, Positioned, SizedBox, Stack };\nuse tur_anim_kit::{ Transform };\n\n\nentry fn start() {\n    let link = ct_link_new();\n    let mut stack = Stack()\n        .child(SizedBox(400.0, 600.0).child(Container().build()).build());\n    let target_child = SizedBox(60.0, 40.0).child(Container().build()).build();\n    let target = CompositedTarget().link(link).child(target_child).build();\n    let transformed = Transform(1.0, 0.0, 50.0, 10.0).child(target).build();\n    stack.child(Positioned().left(20.0).top(20.0).child(transformed).build());\n    let red = Container().width_height(20.0, 20.0).color(0xFF0000FFu64);\n    let follower = CompositedFollower().link(link).target_anchor(ALIGN_TOP_LEFT).follower_anchor(ALIGN_TOP_LEFT).child(red.build()).build();\n    stack.child(follower);\n    mount(stack.build());\n}\n";
    }
    if (name == "condition-basic") {
        return "// condition-basic: a Condition whose then-branch renders (pre-built\n// branches swapped by the engine — no rut during flush).\nuse tur::{ mount, rs_source_bool };\nuse tur_kit::{ Condition, Container, Text };\n\n\nentry fn start() {\n    let when = rs_source_bool(true);\n    let then_box = Container()\n        .width_height(200.0, 100.0)\n        .color(0x303030FF)\n        .query_key(\"then-branch\")\n        .child(Text().text(\"then-branch\").build());\n    let else_box = Container()\n        .width_height(200.0, 100.0)\n        .color(0x501A1AFF)\n        .query_key(\"else-branch\")\n        .child(Text().text(\"else-branch\").build());\n    let c = Condition(when).then(then_box.build()).else_branch(else_box.build()).query_key(\"condition-basic\").build();\n\n    mount(c);\n}\n";
    }
    if (name == "container-basic") {
        return "// container-basic: a padded container around a fixed-size child.\nuse tur::{ mount };\nuse tur_kit::{ Container };\n\n\nentry fn start() {\n    let outer = Container().padding(16.0).child(Container().width_height(100.0, 100.0).build());\n    mount(outer.build());\n}\n";
    }
    if (name == "container-border") {
        return "// container-border: explicit size + padding + color + inside border +\n// radius around a Text.\nuse tur::{ BORDER_INSIDE, mount };\nuse tur_kit::{ Container, Text };\n\n\nentry fn start() {\n    let b = Container()\n        .width_height(200.0, 200.0)\n        .padding(16.0)\n        .color(0xFFFFFFFFu64)\n        .border(0x000000FFu64, 2.0, BORDER_INSIDE)\n        .radius(8.0)\n        .child(Text().text(\"Border\").font_size(16.0).build())\n        .query_key(\"border-container\");\n    mount(b.build());\n}\n";
    }
    if (name == "container-clip-rounded") {
        return "// container-clip-rounded: a rounded, hard-edge-clipped container holding\n// an oversized red child (the corners must clip).\nuse tur::{ CLIP_HARD_EDGE, mount };\nuse tur_kit::{ Container };\n\n\nentry fn start() {\n    let b = Container()\n        .width_height(200.0, 200.0)\n        .radius(40.0)\n        .clip(CLIP_HARD_EDGE)\n        .child(Container().width_height(200.0, 200.0).color(0xFF0000FFu64).build());\n    mount(b.build());\n}\n";
    }
    if (name == "container-flex-sized") {
        return "// container-flex-sized: a Column of fixed-size colored \"buttons\" with\n// labeled children (the counter-family shapes).\nuse tur::{ mount };\nuse tur_kit::{ Column, Container, Text };\n\n\nentry fn start() {\n    let col = Column().child(qkey_button(\"btn\", \"Btn\")).child(qkey_button(\"btn2\", \"Btn2\"));\n    mount(col.build());\n}\n\n// A 100x44 colored pill with a centered 14px label.\nfn qkey_button(key: str, label: str) -> opaque {\n    let b = Container()\n        .width_height(100.0, 44.0)\n        .color(0x6366F1FFu64)\n        .query_key(key)\n        .child(Text().text(label).font_size(14.0).build());\n    return b.build();\n}\n";
    }
    if (name == "container-padding-offset") {
        return "// container-padding-offset: a padded container around a start-aligned\n// column holding one fixed-size child.\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Column, Container };\n\n\nentry fn start() {\n    let mut outer = Container().width_height(200.0, 100.0).padding(20.0);\n    let col = Column().cross_alignment(CROSS_ALIGN_START).child(Container().width_height(40.0, 40.0).build());\n    outer.child(col.build());\n    mount(outer.build());\n}\n";
    }
    if (name == "container-shadow") {
        return "// container-shadow: an elevated card — size + color + radius + shadow —\n// around a Text.\nuse tur::{ mount };\nuse tur_kit::{ Container, Text };\n\n\nentry fn start() {\n    let b = Container()\n        .width_height(200.0, 200.0)\n        .color(0xFFFFFFFFu64)\n        .radius(8.0)\n        .shadow(0x00000050u64, 12.0, 4.0, 4.0)\n        .child(Text().text(\"Shadow\").font_size(16.0).build());\n    mount(b.build());\n}\n";
    }
    if (name == "container-update-clear-prop") {
        return "// container-update-clear-prop: the checkbox's color prop is bound to a\n// brush atom — toggling clears it (a Nil brush fails the decode and the\n// prop resolves to absent) while the border stays.\nuse tur::{ BORDER_CENTER, mount, rs_list_new, rs_set_brush, rs_source_value, stf_put, stf_take };\nuse tur_kit::{ Container, PointerInteract };\n\n\nlet K_CHECKED: u64 = 1;\nlet K_COLOR: u64 = 2;\n\nentry fn start() -> u64 {\n    let checked = rs_source_value(rs_list_new());\n    let color = rs_source_value(rs_list_new());\n    stf_put(K_CHECKED, checked as f64);\n    stf_put(K_COLOR, color as f64);\n    rs_set_brush(color, 0x22C35EFFu64);\n\n    let mut outer = Container().width_height(200.0, 100.0).padding(20.0);\n\n    let checkbox = Container()\n        .width_height(40.0, 40.0)\n        .radius(8.0)\n        .color_bound(color)\n        .border(0xE2E8F0FFu64, 2.0, BORDER_CENTER)\n        .query_key(\"checkbox\");\n    outer.child(PointerInteract().id(checked).on_click(\"b_toggle\").query_key(\"rut/gesture\").child(checkbox.build()).build());\n\n    mount(outer.build());\n    return checked;\n}\n\nentry fn b_toggle(_a: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    // Uncheck: clear the color (the brush atom gets Nil).\n    let color = stf_take(K_COLOR) as u64;\n    rs_set_brush(color, 0);\n    stf_put(K_COLOR, color as f64);\n}\n";
    }
    if (name == "countdown") {
        return "// countdown: a 1 Hz countdown with start/pause/reset, an edit modal (a\n// pre-filled Input + confirm), and a ticking display derived from the\n// remaining atom. The ticker is an async loop over `sleep(1000)` with a\n// generation guard (a stale loop exits when a new start supersedes it).\n// State atom ids ride the scalar stash (stf_*).\nuse futures::{ launch_future, sleep };\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, MAIN_ALIGN_CENTER, mem_get, mem_new, mem_set, mount,\n    rs_derive, rs_get_bool, rs_get_f64, rs_set_bool, rs_set_f64, rs_source_bool, rs_source_f64,\n    st_put, st_take, stf_put, stf_take, str_parse_f64, tctrl_new, tctrl_set_text, tctrl_text,\n    undo_new };\nuse tur_kit::{ Column, Condition, Container, Input, PointerInteract, Row, Text };\n\n\nlet K_GEN: u64 = 1;\nlet K_CTRL: u64 = 2;\nlet K_REMAINING: u64 = 3;\nlet K_INITIAL: u64 = 4;\nlet K_RUNNING: u64 = 5;\nlet K_EDITING: u64 = 6;\n\nentry fn start() -> u64 {\n    let remaining = rs_source_f64();\n    rs_set_f64(remaining, 60.0);\n    let initial = rs_source_f64();\n    rs_set_f64(initial, 60.0);\n    let running = rs_source_bool(false);\n    let editing = rs_source_bool(false);\n    stf_put(K_REMAINING, remaining as f64);\n    stf_put(K_INITIAL, initial as f64);\n    stf_put(K_RUNNING, running as f64);\n    stf_put(K_EDITING, editing as f64);\n    st_put(K_GEN, mem_new(0.0));\n\n    let display = rs_derive(\"fmt_display\", remaining);\n\n    let mut col = Column()\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Text().text_bound_derived(display).query_key(\"display\").build())\n        .child(Row().main_alignment(MAIN_ALIGN_CENTER).child(button(\"btn-start\", \"Start\", \"b_start\", running, running)).child(button(\"btn-pause\", \"Pause\", \"b_pause\", running, running)).child(button(\"btn-reset\", \"Reset\", \"b_reset\", initial, remaining)).child(button(\"btn-edit\", \"Edit\", \"b_edit\", initial, editing)).build());\n\n    // The edit modal overlay (both branches authored at start).\n    let modal = build_modal(initial, remaining);\n    let empty = Container();\n    col.child(Condition(editing).then(modal).else_branch(empty.build()).build());\n\n    mount(col.build());\n    return remaining;\n}\n\n// A pill button with a query key; both atoms cross to the entry.\nfn button(key: str, label: str, cb: str, a: u64, b: u64) -> opaque {\n    let bld = Container()\n        .width_height(90.0, 40.0)\n        .color(0x6366F1FF)\n        .alignment(ALIGN_CENTER)\n        .radius(8.0)\n        .query_key(key)\n        .child(Text().text(label).build());\n    return PointerInteract().ids(a, b).on_tap(cb).child(bld.build()).build();\n}\n\n// The edit modal: a centered card with a pre-filled Input + confirm.\nfn build_modal(initial: u64, remaining: u64) -> opaque {\n    let ctrl = tctrl_new();\n    tctrl_set_text(ctrl, f\"{rs_get_f64(initial) as u64}\");\n    st_put(K_CTRL, ctrl);\n\n    let mut card = Container()\n        .width_height(240.0, 140.0)\n        .color(0xFFFFFFFFu64)\n        .radius(12.0)\n        .padding(16.0)\n        .alignment(ALIGN_CENTER);\n\n    let mut col = Column()\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Text().text(\"Set seconds\").build());\n    let undo = undo_new();\n    let input = Input().controller(ctrl).undo(undo).placeholder(\"seconds\").width_height(180.0, 32.0).query_key(\"edit-input\").build();\n    col.child(input);\n    col.child(button(\"btn-confirm\", \"Confirm\", \"b_confirm\", initial, remaining));\n    card.child(col.build());\n    return card.build();\n}\n\n// \"m:ss\" display format.\nentry fn fmt_display(v: f64) -> str {\n    let total = v as u64;\n    let m = total / 60;\n    let s = total % 60;\n    if (s < 10) {\n        return f\"{m}:0{s}\";\n    }\n    return f\"{m}:{s}\";\n}\n\n// The 1 Hz ticker. `g` pins the generation: a stale loop (superseded by a\n// later start / pause) exits without ticking.\nasync fn ticker(g: f64) -> str {\n    let running = stf_take(K_RUNNING) as u64;\n    while (rs_get_bool(running)) {\n        await sleep(1000);\n        if (gen_read() != g) {\n            stf_put(K_RUNNING, running as f64);\n            return \"\";\n        }\n        if (!rs_get_bool(running)) {\n            stf_put(K_RUNNING, running as f64);\n            return \"\";\n        }\n        let remaining = stf_take(K_REMAINING) as u64;\n        let r = rs_get_f64(remaining);\n        if (r <= 1.0) {\n            rs_set_f64(remaining, 0.0);\n            rs_set_bool(running, false);\n            stf_put(K_REMAINING, remaining as f64);\n            stf_put(K_RUNNING, running as f64);\n            return \"\";\n        }\n        rs_set_f64(remaining, r - 1.0);\n        stf_put(K_REMAINING, remaining as f64);\n    }\n    stf_put(K_RUNNING, running as f64);\n    return \"\";\n}\n\nfn gen_read() -> f64 {\n    let cell = st_take(K_GEN);\n    let v = mem_get(cell);\n    st_put(K_GEN, cell);\n    return v;\n}\n\nfn gen_bump() -> f64 {\n    let cell = st_take(K_GEN);\n    let g = mem_get(cell) + 1.0;\n    mem_set(cell, g);\n    st_put(K_GEN, cell);\n    return g;\n}\n\nentry fn b_start(_running: u64, _b: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    if (rs_get_bool(running)) {\n        stf_put(K_RUNNING, running as f64);\n        return;\n    }\n    rs_set_bool(running, true);\n    stf_put(K_RUNNING, running as f64);\n    launch_future(ticker(gen_bump()));\n}\n\nentry fn b_pause(_running: u64, _b: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n}\n\nentry fn b_reset(initial: u64, remaining: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n    rs_set_f64(remaining, rs_get_f64(initial));\n}\n\nentry fn b_edit(initial: u64, editing: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n    // (Re-)seed the modal controller with the current initial value.\n    let ctrl = st_take(K_CTRL);\n    tctrl_set_text(ctrl, f\"{rs_get_f64(initial) as u64}\");\n    st_put(K_CTRL, ctrl);\n    rs_set_bool(editing, true);\n}\n\nentry fn b_confirm(initial: u64, remaining: u64, _n: f64) {\n    let ctrl = st_take(K_CTRL);\n    let v = str_parse_f64(tctrl_text(ctrl));\n    rs_set_f64(initial, v);\n    rs_set_f64(remaining, v);\n    let editing = stf_take(K_EDITING) as u64;\n    rs_set_bool(editing, false);\n    stf_put(K_EDITING, editing as f64);\n}\n";
    }
    if (name == "counter") {
        return "// counter: a reactive count label between -/+ pill buttons — the full\n// interactive loop (button → intent entry → atom write → re-render).\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, mount, rs_get_f64, rs_set_f64, rs_set_str, rs_source_f64,\n    rs_source_str };\nuse tur_kit::{ Column, Container, PointerInteract, Row, Text };\n\n\nentry fn start() -> u64 {\n    let count = rs_source_f64();\n    let label = rs_source_str(\"Count: 0\");\n\n    let mut col = Column()\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Text().text_bound(label).query_key(\"count\").font_size(36.0).build());\n\n    let mut row = Row().cross_alignment(CROSS_ALIGN_CENTER);\n    let pad = rs_source_f64();\n    row.child(button(count, label, \"ts_dec\", \"-1\", \"dec\"));\n    row.child(gap());\n    row.child(button(count, label, \"ts_inc\", \"+1\", \"inc\"));\n    col.child(row.build());\n\n    let bg = Container().color(0xF8FAFCFFu64).child(col.build());\n    mount(bg.build());\n    return count;\n}\n\n// A 100x44 indigo pill with a centered label.\nfn button(count: u64, label: u64, cb: str, text: str, key: str) -> opaque {\n    let b = Container()\n        .width_height(100.0, 44.0)\n        .color(0x6366F1FFu64)\n        .alignment(ALIGN_CENTER)\n        .query_key(key)\n        .child(Text().text(text).font_size(18.0).build());\n    return PointerInteract().ids(count, label).on_tap(cb).child(b.build()).build();\n}\n\nfn gap() -> opaque {\n    let b = Container().width_height(12.0, 0.0);\n    return b.build();\n}\n\nfn refresh(count: u64, label: u64) {\n    rs_set_str(label, f\"Count: {rs_get_f64(count) as u64}\");\n}\n\nentry fn ts_inc(count: u64, label: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n    refresh(count, label);\n}\n\nentry fn ts_dec(count: u64, label: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) - 1.0);\n    refresh(count, label);\n}\n";
    }
    if (name == "drag-delta-tracking") {
        return "// drag-delta-tracking: a drag pad computing deltaFromStart/deltaFromLast\n// (the VDivider pattern). Scratch numbers ride stashed mem cells; the\n// transcript atom renders \"dsx,dsy,dlx,dly\" for the test to parse.\nuse tur::{ mem_get, mem_new, mem_set, mount, rs_set_str, rs_source_str, st_put, st_take };\nuse tur_kit::{ Container, PointerInteract, Text };\n\n\nlet K_SX: u64 = 2;\nlet K_SY: u64 = 3;\nlet K_LX: u64 = 4;\nlet K_LY: u64 = 5;\n\nentry fn start() -> u64 {\n    let info = rs_source_str(\"0,0,0,0\");\n    st_put(K_SX, mem_new(0.0));\n    st_put(K_SY, mem_new(0.0));\n    st_put(K_LX, mem_new(0.0));\n    st_put(K_LY, mem_new(0.0));\n\n    let b = Container()\n        .width_height(200.0, 200.0)\n        .color(0x6366F1FF)\n        .query_key(\"drag-target\")\n        .child(Text().text_bound(info).query_key(\"drag-info\").build());\n\n    let pad = PointerInteract().id(info).on_down(\"g_down\").on_move(\"g_move\").on_up(\"g_up\").query_key(\"rut/gesture\").child(b.build()).build();\n    mount(pad);\n    return info;\n}\n\n// From-start + from-last deltas, read BEFORE the last-point update.\nfn emit(id: u64, gx: f64, gy: f64) {\n    let sx = st_take(K_SX);\n    let sy = st_take(K_SY);\n    let lx = st_take(K_LX);\n    let ly = st_take(K_LY);\n    let dsx = gx - mem_get(sx);\n    let dsy = gy - mem_get(sy);\n    let dlx = gx - mem_get(lx);\n    let dly = gy - mem_get(ly);\n    rs_set_str(id, f\"{dsx},{dsy},{dlx},{dly}\");\n    st_put(K_SX, sx);\n    st_put(K_SY, sy);\n    st_put(K_LX, lx);\n    st_put(K_LY, ly);\n}\n\nentry fn g_down(id: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    let sx = st_take(K_SX);\n    let sy = st_take(K_SY);\n    mem_set(sx, gx);\n    mem_set(sy, gy);\n    st_put(K_SX, sx);\n    st_put(K_SY, sy);\n    move_last(gx, gy);\n    emit(id, gx, gy);\n}\n\nentry fn g_move(id: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    emit(id, gx, gy);\n    move_last(gx, gy);\n}\n\n// The test's explicit reset probe (the `__resetDrag` seam): clear the\n// drag tracking so post-release hover-moves produce no deltas.\nentry fn reset(id: u64, _b: f64) {\n    let sx = st_take(K_SX);\n    let sy = st_take(K_SY);\n    let lx = st_take(K_LX);\n    let ly = st_take(K_LY);\n    mem_set(sx, 0.0);\n    mem_set(sy, 0.0);\n    mem_set(lx, 0.0);\n    mem_set(ly, 0.0);\n    st_put(K_SX, sx);\n    st_put(K_SY, sy);\n    st_put(K_LX, lx);\n    st_put(K_LY, ly);\n    rs_set_str(id, \"0,0,0,0\");\n}\n\nfn move_last(gx: f64, gy: f64) {\n    let lx = st_take(K_LX);\n    let ly = st_take(K_LY);\n    mem_set(lx, gx);\n    mem_set(ly, gy);\n    st_put(K_LX, lx);\n    st_put(K_LY, ly);\n}\n";
    }
    if (name == "drag-over-text") {
        return "// drag-over-text: a Positioned -> Transform -> PointerInteract -> Text\n// piece — a non-selectable Text must not steal touch drags from the\n// PointerInteract beneath. The down count renders into `down-count`.\nuse tur::{ ALIGN_TOP_LEFT, mem_get, mem_new, mem_set, mount, rs_set_str, rs_source_str, st_put,\n    st_take, stf_put, stf_take };\nuse tur_kit::{ Container, PointerInteract, SizedBox, Stack, Text };\nuse tur_anim_kit::{ Transform };\n\n\nlet K_COUNT: u64 = 1;\nlet K_PHASE: u64 = 2;\n\nentry fn start() -> u64 {\n    let count = rs_source_str(\"0\");\n    st_put(K_COUNT, mem_new(0.0));\n    let phase = rs_source_str(\"\");\n    stf_put(K_PHASE, phase as f64);\n\n    let mut stack = Stack()\n        .alignment(ALIGN_TOP_LEFT)\n        .child(SizedBox(400.0, 400.0).child(Container().build()).build());\n\n    let label = Text().text(\"drag me\").font_size(14.0);\n    let piece = Container().width_height(80.0, 40.0).query_key(\"drag-target\").child(label.build());\n    let pad = PointerInteract().id(count).on_down(\"g_down\").on_move(\"g_move\").on_up(\"g_up\").query_key(\"rut/gesture\").child(piece.build()).build();\n    stack.child(Transform(1.0, 0.0, 60.0, 50.0).child(pad).build());\n\n    let count_t = Text().text_bound(count).query_key(\"down-count\");\n    stack.child(count_t.build());\n    mount(stack.build());\n    return count;\n}\n\nentry fn g_down(count: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let cell = st_take(K_COUNT);\n    let n = mem_get(cell) + 1.0;\n    mem_set(cell, n);\n    st_put(K_COUNT, cell);\n    rs_set_str(count, f\"{n as u64}\");\n    let phase = stf_take(K_PHASE) as u64;\n    rs_set_str(phase, \"down\");\n    stf_put(K_PHASE, phase as f64);\n}\n\nentry fn g_move(_count: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let phase = stf_take(K_PHASE) as u64;\n    rs_set_str(phase, \"move\");\n    stf_put(K_PHASE, phase as f64);\n}\n\nentry fn g_up(_count: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let phase = stf_take(K_PHASE) as u64;\n    rs_set_str(phase, \"up\");\n    stf_put(K_PHASE, phase as f64);\n}\n";
    }
    if (name == "drag-redrag-multi") {
        return "// drag-redrag-multi: two tiles sharing one lift controller — the\n// multi-tile jigsaw repro. Per-tile event transcripts render into\n// `tile-events-0` / `tile-events-1`.\nuse tur::{ ALIGN_TOP_LEFT, anim_ctrl, anim_forward, anim_reverse, mount, rs_get_str, rs_set_str,\n    rs_source_f64, rs_source_str, st_put, st_take, stf_put, stf_take };\nuse tur_kit::{ Container, PointerInteract, Positioned, SizedBox, Stack, Text };\n\n\nlet K_CTRL: u64 = 1;\nlet K_T0: u64 = 2;\nlet K_T1: u64 = 3;\n\nentry fn start() -> u64 {\n    let lift = rs_source_f64();\n    let ctrl = anim_ctrl(lift, 180.0, \"linear\", 0, \"a_tick\", \"a_end\");\n    st_put(K_CTRL, ctrl);\n\n    let t0 = rs_source_str(\"\");\n    let t1 = rs_source_str(\"\");\n    stf_put(K_T0, t0 as f64);\n    stf_put(K_T1, t1 as f64);\n\n    let mut stack = Stack()\n        .alignment(ALIGN_TOP_LEFT)\n        .child(SizedBox(300.0, 200.0).child(Container().build()).build());\n\n    // Tile 0 at (10, 10); tile 1 at (150, 100). The tile index rides the\n    // gesture's second id slot (100 + index).\n    let b0 = Container().width_height(100.0, 60.0).color(0x6366F1FFu64).query_key(\"tile-0\");\n    stack.child(Positioned().left(10.0).top(10.0).child(PointerInteract().ids(0, 100).on_click(\"g_down\").on_down(\"g_down\").on_move(\"g_move\").on_up(\"g_up\").query_key(\"rut/gesture\").child(b0.build()).build()).build());\n    let b1 = Container().width_height(100.0, 60.0).color(0x6366F1FFu64).query_key(\"tile-1\");\n    stack.child(Positioned().left(150.0).top(100.0).child(PointerInteract().ids(1, 101).on_click(\"g_down\").on_down(\"g_down\").on_move(\"g_move\").on_up(\"g_up\").query_key(\"rut/gesture\").child(b1.build()).build()).build());\n\n    // Transcript readouts.\n    let t0t = Text().text_bound(t0).query_key(\"tile-events-0\");\n    stack.child(t0t.build());\n    let t1t = Text().text_bound(t1).query_key(\"tile-events-1\");\n    stack.child(t1t.build());\n\n    mount(stack.build());\n    return lift;\n}\n\nentry fn a_tick(_atom: u64, _t: f64) {\n}\n\nentry fn a_end(_atom: u64, _v: f64) {\n}\n\n// The `__resetDrag` seam.\nentry fn reset(_a: u64, _b: f64) {\n    let t0 = stf_take(K_T0) as u64;\n    let t1 = stf_take(K_T1) as u64;\n    rs_set_str(t0, \"\");\n    rs_set_str(t1, \"\");\n    stf_put(K_T0, t0 as f64);\n    stf_put(K_T1, t1 as f64);\n}\n\nfn say(idx: u64, line: str) {\n    // K_T0=2, K_T1=3 — the tile index selects the transcript slot. The\n    // transcript ACCUMULATES (the test checks down+move are present).\n    let key = K_T0 + idx;\n    let t = stf_take(key) as u64;\n    rs_set_str(t, f\"{rs_get_str(t)} {line}\");\n    stf_put(key, t as f64);\n}\n\nentry fn g_down(idx: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let ctrl = st_take(K_CTRL);\n    anim_forward(ctrl);\n    st_put(K_CTRL, ctrl);\n    say(idx, \"down\");\n}\n\nentry fn g_move(idx: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    say(idx, \"move\");\n}\n\nentry fn g_up(idx: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let ctrl = st_take(K_CTRL);\n    anim_reverse(ctrl);\n    st_put(K_CTRL, ctrl);\n    say(idx, \"up\");\n}\n";
    }
    if (name == "drag-with-lift") {
        return "// drag-with-lift: the jigsaw piece mechanic — pointer-down drives a lift\n// animation (forward on down, reverse on up). The last gesture phase\n// renders into the `last-event` Text.\nuse tur::{ anim_ctrl, anim_forward, anim_reverse, mount, rs_set_str, rs_source_f64, rs_source_str,\n    st_put, st_take, stf_put, stf_take };\nuse tur_kit::{ Column, Container, PointerInteract, Text };\n\n\nlet K_PHASE: u64 = 1;\nlet K_CTRL: u64 = 2;\n\nentry fn start() -> u64 {\n    let phase = rs_source_str(\"\");\n    stf_put(K_PHASE, phase as f64);\n    let lift = rs_source_f64();\n    let ctrl = anim_ctrl(lift, 180.0, \"linear\", 0, \"a_tick\", \"a_end\");\n    st_put(K_CTRL, ctrl);\n\n    let b = Container()\n        .width_height(80.0, 40.0)\n        .query_key(\"lift-target\")\n        .child(Text().text(\"piece\").build());\n    let pad = PointerInteract().id(phase).on_down(\"g_down\").on_move(\"g_move\").on_up(\"g_up\").query_key(\"rut/gesture\").child(b.build()).build();\n\n    let phase_t = Text().text_bound(phase).query_key(\"last-event\").build();\n    let root = Column().child(pad).child(phase_t);\n    mount(root.build());\n    return phase;\n}\n\nentry fn a_tick(_atom: u64, _t: f64) {\n}\n\nentry fn a_end(_atom: u64, _v: f64) {\n}\n\n// The `__resetDrag` seam (the lift keeps settling; only the transcript clears).\nentry fn reset(_a: u64, _b: f64) {\n    let phase = stf_take(K_PHASE) as u64;\n    rs_set_str(phase, \"\");\n    stf_put(K_PHASE, phase as f64);\n}\n\nentry fn g_down(phase: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let ctrl = st_take(K_CTRL);\n    anim_forward(ctrl);\n    st_put(K_CTRL, ctrl);\n    rs_set_str(phase, \"down\");\n}\n\nentry fn g_move(phase: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    rs_set_str(phase, \"move\");\n}\n\nentry fn g_up(phase: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let ctrl = st_take(K_CTRL);\n    anim_reverse(ctrl);\n    st_put(K_CTRL, ctrl);\n    rs_set_str(phase, \"up\");\n}\n";
    }
    if (name == "expanded-basic") {
        return "// expanded-basic: a fixed-height child plus an Expanded filling the\n// remaining main axis.\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Column, Container, Expanded };\n\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n\nentry fn start() {\n    let col = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(box_wh(0.0, 50.0))\n        .child(Expanded().flex(1.0).child(box_wh(0.0, 0.0)).build());\n    mount(col.build());\n}\n";
    }
    if (name == "expanded-flex-weights") {
        return "// expanded-flex-weights: two Expanded children sharing the main axis 2:1.\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Column, Container, Expanded };\n\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n\nentry fn start() {\n    let col = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(Expanded().flex(2.0).child(box_wh(0.0, 0.0)).build())\n        .child(Expanded().flex(1.0).child(box_wh(0.0, 0.0)).build());\n    mount(col.build());\n}\n";
    }
    if (name == "expanded-multiple") {
        return "// expanded-multiple: two Expanded children sharing the main axis evenly.\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Column, Container, Expanded };\n\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n\nentry fn start() {\n    let col = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(Expanded().flex(1.0).child(box_wh(0.0, 0.0)).build())\n        .child(Expanded().flex(1.0).child(box_wh(0.0, 0.0)).build());\n    mount(col.build());\n}\n";
    }
    if (name == "flex-nested-sidebar") {
        return "// flex-nested-sidebar: a 200px sidebar Column beside a content Column in\n// a Row (the classic two-pane shape).\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Column, Container, Row };\n\n\nentry fn start() {\n    let mut row = Row();\n    let sidebar = Container()\n        .width_height(200.0, 0.0)\n        .child(Column().cross_alignment(CROSS_ALIGN_START).child(box_wh(0.0, 40.0)).build());\n    row.child(sidebar.build());\n    let content = Container()\n        .child(Column().cross_alignment(CROSS_ALIGN_START).child(box_wh(0.0, 30.0)).build());\n    row.child(content.build());\n    mount(row.build());\n}\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n";
    }
    if (name == "flex-row-cross-stretch") {
        return "// flex-row-cross-stretch: fixed-width children stretched to the row's\n// full cross axis (the viewport height).\nuse tur::{ CROSS_ALIGN_STRETCH, mount };\nuse tur_kit::{ Container, Row };\n\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n\nentry fn start() {\n    let row = Row()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .child(box_wh(50.0, 0.0))\n        .child(box_wh(30.0, 0.0));\n    mount(row.build());\n}\n";
    }
    if (name == "flex-row-expanded") {
        return "// flex-row-expanded: a fixed-width child plus an Expanded filling the\n// remaining main axis.\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Container, Expanded, Row };\n\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n\nentry fn start() {\n    let row = Row()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(box_wh(50.0, 0.0))\n        .child(Expanded().flex(1.0).child(box_wh(0.0, 0.0)).build());\n    mount(row.build());\n}\n";
    }
    if (name == "flex-row-main-center") {
        return "// flex-row-main-center: two fixed-width children centered on the main axis.\nuse tur::{ CROSS_ALIGN_START, MAIN_ALIGN_CENTER, mount };\nuse tur_kit::{ Container, Row };\n\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n\nentry fn start() {\n    let row = Row()\n        .main_alignment(MAIN_ALIGN_CENTER)\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(box_wh(50.0, 0.0))\n        .child(box_wh(30.0, 0.0));\n    mount(row.build());\n}\n";
    }
    if (name == "flex-row-main-end") {
        return "// flex-row-main-end: two fixed-width children pinned to the main-axis end.\nuse tur::{ CROSS_ALIGN_START, MAIN_ALIGN_END, mount };\nuse tur_kit::{ Container, Row };\n\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n\nentry fn start() {\n    let row = Row()\n        .main_alignment(MAIN_ALIGN_END)\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(box_wh(50.0, 0.0))\n        .child(box_wh(30.0, 0.0));\n    mount(row.build());\n}\n";
    }
    if (name == "flex-todolist-sidebar") {
        return "// flex-todolist-sidebar: the todolist two-pane shell — a 200px tab\n// sidebar beside a padded content column.\nuse tur::{ CROSS_ALIGN_CENTER, MAIN_ALIGN_SPACE_BETWEEN, mount };\nuse tur_kit::{ Column, Container, Row, Text };\n\n\nentry fn start() {\n    let mut row = Row();\n    // Sidebar: one active tab pill.\n    let mut sidebar = Container().color(0x1A1A2EFF).width_height(200.0, 0.0);\n    let mut tabs = Column();\n    let tab = Container()\n        .color(0x0F3460FF)\n        .padding(12.0)\n        .child(Text().text(\"TodoList\").font_size(14.0).build());\n    tabs.child(tab.build());\n    sidebar.child(tabs.build());\n    row.child(sidebar.build());\n    // Content: heading + list shell.\n    let mut content = Container().padding(16.0);\n    let mut col = Column()\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Text().text(\"Todo List\").font_size(24.0).build())\n        .child(box_h(16.0));\n    let list = Column()\n        .child(Row().main_alignment(MAIN_ALIGN_SPACE_BETWEEN).child(Text().text(\"Buy milk\").build()).build());\n    col.child(list.build());\n    content.child(col.build());\n    row.child(content.build());\n    mount(row.build());\n}\n\nfn box_h(h: f64) -> opaque {\n    let b = Container().width_height(0.0, h);\n    return b.build();\n}\n";
    }
    if (name == "focus-clear-on-click") {
        return "// focus-clear-on-click: a focused Input above a PointerInteract button —\n// clicking the button clears focus (the gesture handler's outside-click\n// path).\nuse tur::{ mount, rs_get_f64, rs_set_f64, rs_set_str, rs_source_f64, rs_source_str, tctrl_new, undo_new };\nuse tur_kit::{ Column, Input, PointerInteract, Text };\n\n\nentry fn start() -> u64 {\n    let clicks = rs_source_f64();\n    let label = rs_source_str(\"clicks: 0\");\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n\n    let mut col = Column();\n    let input = Input().controller(ctrl).undo(undo).width_height(200.0, 30.0).query_key(\"editable\").build();\n    col.child(input);\n    let t = Text().text_bound(label).query_key(\"button\");\n    col.child(PointerInteract().ids(clicks, label).on_tap(\"b_click\").child(t.build()).build());\n    mount(col.build());\n    return clicks;\n}\n\nentry fn b_click(clicks: u64, label: u64, _n: f64) {\n    rs_set_f64(clicks, rs_get_f64(clicks) + 1.0);\n    rs_set_str(label, f\"clicks: {rs_get_f64(clicks) as u64}\");\n}\n";
    }
    if (name == "four-color-quadrants") {
        return "// four-color-quadrants: a 2x2 grid of 100x100 colored quadrants (Stack +\n// positioned fills) — the vello render fixtures sample exact pixels.\nuse tur::{ mount };\nuse tur_kit::{ Container, Positioned, Stack };\n\n\nfn quad(color: u64) -> opaque {\n    let b = Container().width_height(100.0, 100.0).color(color);\n    return b.build();\n}\n\nentry fn start() {\n    let stack = Stack()\n        .child(Positioned().left(0.0).top(0.0).child(quad(0xFF0000FFu64)).build())\n        .child(Positioned().left(100.0).top(0.0).child(quad(0x00FF00FFu64)).build())\n        .child(Positioned().left(0.0).top(100.0).child(quad(0x0000FFFFu64)).build())\n        .child(Positioned().left(100.0).top(100.0).child(quad(0xFFFF00FFu64)).build());\n    mount(stack.build());\n}\n";
    }
    if (name == "grid-aspect") {
        return "// grid-aspect: aspect-ratio tiles in a grid row (square tiles via equal\n// width/height).\nuse tur::{ mount };\nuse tur_kit::{ Container, Row, SizedBox, Text };\n\n\nentry fn tile(label: str, color: u64) -> opaque {\n    let b = Container()\n        .width_height(100.0, 100.0)\n        .color(color)\n        .child(Text().text(label).font_size(14.0).build());\n    return b.build();\n}\n\nentry fn start() {\n    let row = Row()\n        .child(tile(\"A\", 0xEF4444FFu64))\n        .child(tile(\"B\", 0x22C55EFFu64))\n        .child(tile(\"C\", 0x3B82F6FFu64));\n    mount(SizedBox(400.0, 200.0).child(row.build()).build());\n}\n";
    }
    if (name == "grid-basic") {
        return "// grid-basic: a small static grid of tiles (Row/Column composition).\nuse tur::{ mount };\nuse tur_kit::{ Column, Container, Row, SizedBox };\n\n\nentry fn tile(color: u64) -> opaque {\n    let b = Container().width_height(80.0, 80.0).color(color);\n    return b.build();\n}\n\nentry fn start() {\n    let mut col = Column();\n    let r0 = Row().child(tile(0xEF4444FFu64)).child(tile(0x22C55EFFu64));\n    let r1 = Row().child(tile(0x3B82F6FFu64)).child(tile(0xEAB308FFu64));\n    col.child(r0.build());\n    col.child(r1.build());\n    mount(SizedBox(200.0, 200.0).child(col.build()).build());\n}\n";
    }
    if (name == "grid-gallery") {
        return "// grid-gallery: a header + scrollable tile grid (the hover-cursor demo\n// surface).\nuse tur::{ CROSS_ALIGN_CENTER, CURSOR_POINTER, mount };\nuse tur_kit::{ Column, Container, Expanded, MouseRegion, Row, SizedBox, Text };\n\n\nentry fn tile(i: u64) -> opaque {\n    let b = Container()\n        .width_height(100.0, 100.0)\n        .color(0x1E293BFF)\n        .child(Text().text(f\"tile {i}\").font_size(12.0).build());\n    return MouseRegion().cursor(CURSOR_POINTER).behavior(0).child(b.build()).build();\n}\n\nentry fn start() {\n    let mut col = Column().cross_alignment(CROSS_ALIGN_CENTER);\n    let row = Row().child(tile(0)).child(tile(1)).child(tile(2));\n    col.child(SizedBox(400.0, 40.0).child(Container().build()).build());\n    col.child(row.build());\n    mount(Expanded().flex(1.0).child(col.build()).build());\n}\n";
    }
    if (name == "hit-test-opaqueness") {
        return "// hit-test-opaqueness: the absorption matrix — a colored Container\n// absorbs; a decoration-less Container passes through; an opaque\n// PointerInteract catches invisible hits; a translucent MouseRegion joins\n// the path without blocking. The beneath-target's down count renders into\n// the `beneath-downs` Text (the test parses it).\nuse tur::{ ALIGN_TOP_LEFT, CURSOR_AUTO, mem_get, mem_new, mem_set, mount, rs_set_str, rs_source_str,\n    st_put, st_take };\nuse tur_kit::{ Container, MouseRegion, PointerInteract, Positioned, SizedBox, Stack, Text };\n\n\nlet K_COUNT: u64 = 7;\n\nentry fn start() -> u64 {\n    let downs = rs_source_str(\"0\");\n    st_put(K_COUNT, mem_new(0.0));\n\n    let mut stack = Stack().alignment(ALIGN_TOP_LEFT);\n\n    // The opaque gesture target beneath (fills the 400x600 stack).\n    let target = Container()\n        .width_height(400.0, 600.0)\n        .child(Text().text_bound(downs).query_key(\"beneath-downs\").build());\n    stack.child(PointerInteract().id(downs).on_down(\"g_down\").query_key(\"rut/gesture\").child(target.build()).build());\n\n    // A decoration-less full-size Container — transparent.\n    let plain = Container().width_height(400.0, 600.0).query_key(\"plain\");\n    stack.child(plain.build());\n\n    // A painted red 200x200 surface at the top-left — absorbs.\n    let red = Container().width_height(200.0, 200.0).color(0xEF4444FFu64).query_key(\"red\");\n    stack.child(red.build());\n\n    // A translucent MouseRegion over the right half (x 200..400).\n    let region_child = SizedBox(200.0, 600.0).child(Container().build()).query_key(\"region\").build();\n    let region = MouseRegion().cursor(CURSOR_AUTO).behavior(1).child(region_child).build();\n    stack.child(Positioned().left(200.0).width(200.0).height(600.0).child(region).build());\n\n    mount(stack.build());\n    return downs;\n}\n\nentry fn g_down(downs: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let cell = st_take(K_COUNT);\n    let n = mem_get(cell) + 1.0;\n    mem_set(cell, n);\n    st_put(K_COUNT, cell);\n    rs_set_str(downs, f\"{n as u64}\");\n}\n";
    }
    if (name == "hit-through-overlay") {
        return "// hit-through-overlay: the floating-pill pattern — a full-size invisible\n// overlay must not steal pointer/wheel input from the scrollable beneath;\n// the opaque anchored pill still consumes clicks. The counters render into\n// bound Texts (`beneath-downs` / `pill-clicks`).\nuse tur::{ AXIS_VERTICAL, CROSS_ALIGN_STRETCH, mem_get, mem_new, mem_set, mount, rs_set_str,\n    rs_source_str, st_put, st_take };\nuse tur_kit::{ Column, Container, PointerInteract, Positioned, ScrollView, Stack, Text };\n\n\nlet K_DOWNS: u64 = 7;\nlet K_CLICKS: u64 = 8;\n\nentry fn start() -> u64 {\n    let downs = rs_source_str(\"0\");\n    let clicks = rs_source_str(\"0\");\n    st_put(K_DOWNS, mem_new(0.0));\n    st_put(K_CLICKS, mem_new(0.0));\n\n    let mut stack = Stack();\n\n    // The scrollable beneath, wrapped in a gesture target so pointer\n    // events reaching THROUGH the overlay are observable.\n    let content = Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .child(box_h(300.0))\n        .child(box_h(300.0))\n        .child(box_h(300.0));\n    let scroller = ScrollView().axis(AXIS_VERTICAL).child(content.build()).query_key(\"sv\").build();\n    stack.child(PointerInteract().id(downs).on_down(\"g_down\").child(scroller).build());\n\n    // The invisible full-size overlay: no decoration, no gesture.\n    let overlay = Container().width_height(400.0, 600.0).query_key(\"overlay\");\n    stack.child(overlay.build());\n\n    // The floating pill, anchored bottom-right.\n    let pill_box = Container().width_height(64.0, 28.0).query_key(\"pill\");\n    let pill = PointerInteract().ids(clicks, clicks).on_tap(\"pill_click\").child(pill_box.build()).build();\n    stack.child(Positioned().right(8.0).bottom(8.0).child(pill).build());\n\n    // Counter readouts (the test parses these).\n    let downs_t = Text().text_bound(downs).query_key(\"beneath-downs\");\n    stack.child(downs_t.build());\n    let clicks_t = Text().text_bound(clicks).query_key(\"pill-clicks\");\n    stack.child(clicks_t.build());\n\n    mount(stack.build());\n    return downs;\n}\n\nentry fn g_down(downs: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let cell = st_take(K_DOWNS);\n    let n = mem_get(cell) + 1.0;\n    mem_set(cell, n);\n    st_put(K_DOWNS, cell);\n    rs_set_str(downs, f\"{n as u64}\");\n}\n\nentry fn pill_click(clicks: u64, _b: u64, _n: f64) {\n    let cell = st_take(K_CLICKS);\n    let n = mem_get(cell) + 1.0;\n    mem_set(cell, n);\n    st_put(K_CLICKS, cell);\n    rs_set_str(clicks, f\"{n as u64}\");\n}\n\nfn box_h(h: f64) -> opaque {\n    let b = Container().width_height(0.0, h);\n    return b.build();\n}\n";
    }
    if (name == "image-basic") {
        return "// image-basic: a synthetic 1x1-ish RGBA resource in a fixed-size Image.\nuse tur::{ BOXFIT_FILL, img_res_solid, mount };\nuse tur_kit::{ Container, Image };\n\n\nentry fn start() {\n    let res = img_res_solid(1, 1, 0xFF6366F1u64);\n    let mut outer = Container().width_height(200.0, 100.0);\n    let img = Image(res).width(200.0).height(100.0).fit(BOXFIT_FILL).build();\n    outer.child(img);\n    mount(outer.build());\n}\n";
    }
    if (name == "implicit-animations") {
        return "// implicit-animations: animated style channels driven by one shared\n// controller (the Animated* twin) — the toggle flips the target and\n// restarts the controller (the ImplicitlyAnimatedWidget retarget).\nuse tur::{ anim_ctrl, anim_forward, anim_reverse, mount, rs_get_bool, rs_set_bool, rs_source_bool,\n    rs_source_f64, st_put, st_take, stf_put };\nuse tur_kit::{ Column, Container, PointerInteract, Text };\n\n\nlet K_CTRL: u64 = 1;\nlet K_EXPANDED: u64 = 2;\n\nentry fn start() -> u64 {\n    let expanded = rs_source_bool(false);\n    stf_put(K_EXPANDED, expanded as f64);\n    let progress = rs_source_f64();\n    let ctrl = anim_ctrl(progress, 300.0, \"easeInOut\", 0, \"a_tick\", \"a_end\");\n    st_put(K_CTRL, ctrl);\n\n    let mut col = Column();\n    let box_b = Container().width_height(100.0, 40.0).color(0x6366F1FFu64).query_key(\"animated-box\");\n    col.child(PointerInteract().ids(expanded, expanded).on_tap(\"b_toggle\").child(box_b.build()).build());\n    col.child(Text().text(\"toggle me\").build());\n    mount(col.build());\n    return expanded;\n}\n\nentry fn a_tick(_atom: u64, _t: f64) {\n}\n\nentry fn a_end(_atom: u64, _v: f64) {\n}\n\nentry fn b_toggle(expanded: u64, _b: u64, _n: f64) {\n    rs_set_bool(expanded, !rs_get_bool(expanded));\n    // Retarget: reverse or forward the shared controller.\n    let ctrl = st_take(K_CTRL);\n    if (rs_get_bool(expanded)) {\n        anim_forward(ctrl);\n    } else {\n        anim_reverse(ctrl);\n    }\n    st_put(K_CTRL, ctrl);\n}\n";
    }
    if (name == "input-cursor-mid") {
        return "// input-cursor-mid: the same shape as input-typing (the cursor-mid-tick\n// seam is a no-op probe on the rut side too).\nuse tur::{ mount, tctrl_new, undo_new };\nuse tur_kit::{ Container, Input };\n\n\nentry fn start() {\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n    let outer = Container()\n        .child(Input().controller(ctrl).undo(undo).width_height(200.0, 30.0).build());\n    mount(outer.build());\n}\n\n// The `__setCursorMidTick` seam's rut twin: a deliberate no-op.\nentry fn set_cursor_mid_tick(_a: u64, _b: f64) {\n}\n";
    }
    if (name == "input-multiline") {
        return "// input-multiline: a multiline editable with an explicit size.\nuse tur::{ mount, tctrl_new, undo_new };\nuse tur_kit::{ Container, Input };\n\n\nentry fn start() {\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n    let outer = Container()\n        .child(Input().controller(ctrl).undo(undo).width_height(300.0, 400.0).multiline(true).build());\n    mount(outer.build());\n}\n";
    }
    if (name == "input-typing") {
        return "// input-typing: an editable Input wired to a realm-minted controller.\nuse tur::{ mount, tctrl_new, undo_new };\nuse tur_kit::{ Container, Input };\n\n\nentry fn start() {\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n    let outer = Container()\n        .child(Input().controller(ctrl).undo(undo).width_height(200.0, 30.0).build());\n    mount(outer.build());\n}\n";
    }
    if (name == "jigsaw-puzzle") {
        return "// jigsaw-puzzle: the drag-a-tile board (the regression fixture family the\n// drag-with-lift / drag-redrag-multi tests pin, as a playable board).\nuse tur::{ ALIGN_TOP_LEFT, mount, rs_set_f64, rs_set_str, rs_source_f64, rs_source_str, stf_put, stf_take };\nuse tur_kit::{ Container, PointerInteract, Positioned, SizedBox, Stack, Text };\n\n\nlet K_X: u64 = 1;\nlet K_Y: u64 = 2;\nlet K_PIECE: u64 = 3;\n\nentry fn start() -> u64 {\n    let x = rs_source_f64();\n    let y = rs_source_f64();\n    stf_put(K_X, x as f64);\n    stf_put(K_Y, y as f64);\n    let piece = rs_source_str(\"A\");\n    stf_put(K_PIECE, piece as f64);\n\n    let mut stack = Stack()\n        .alignment(ALIGN_TOP_LEFT)\n        .child(SizedBox(300.0, 300.0).child(Container().build()).build());\n    let b = Container()\n        .width_height(80.0, 80.0)\n        .color(0x6366F1FFu64)\n        .query_key(\"piece\")\n        .child(Text().text(\"A\").build());\n    let pad = PointerInteract().ids(piece, piece).on_click(\"g_down\").on_down(\"g_down\").on_move(\"g_move\").on_up(\"g_up\").query_key(\"rut/gesture\").child(b.build()).build();\n    let pos = Positioned().left(10.0).top(10.0).child(pad).build();\n    stack.child(pos);\n    mount(stack.build());\n    return piece;\n}\n\nentry fn g_down(piece: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    rs_set_str(piece, \"dragging\");\n}\n\nentry fn g_move(piece: u64, _id: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    let x = stf_take(K_X) as u64;\n    let y = stf_take(K_Y) as u64;\n    rs_set_f64(x, gx - 40.0);\n    rs_set_f64(y, gy - 40.0);\n    stf_put(K_X, x as f64);\n    stf_put(K_Y, y as f64);\n}\n\nentry fn g_up(piece: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    rs_set_str(piece, \"A\");\n}\n";
    }
    if (name == "layout-invalidation-descendant-position") {
        return "// layout-invalidation-descendant-position: a reactive-width container\n// around an end-aligned Row holding a tracker box — the tracker's X must\n// track the width change through the intermediate Row (the divider-drag\n// position-gap repro). The `set_width` probe drives the change.\nuse tur::{ MAIN_ALIGN_END, mount, rs_set_f64, rs_source_f64, stf_put, stf_take };\nuse tur_kit::{ Container, Row };\n\n\nlet K_WIDTH: u64 = 1;\n\nentry fn start() -> u64 {\n    let width = rs_source_f64();\n    rs_set_f64(width, 100.0);\n    stf_put(K_WIDTH, width as f64);\n\n    let mut outer = Container().width_bound(width);\n    let row = Row()\n        .main_alignment(MAIN_ALIGN_END)\n        .child(Container().width_height(20.0, 20.0).color(0x22C55EFFu64).query_key(\"tracker\").build());\n    outer.child(row.build());\n    mount(outer.build());\n    return width;\n}\n\n// The `__setWidth(w)` seam.\nentry fn set_width(a: u64, _b: f64) {\n    let width = stf_take(K_WIDTH) as u64;\n    rs_set_f64(width, a as f64);\n    stf_put(K_WIDTH, width as f64);\n}\n";
    }
    if (name == "layout-invalidation-reactive-flex") {
        return "// layout-invalidation-reactive-flex: two reactive flex weights — the\n// `set_flex` probe flips them (a click would mark extra nodes dirty via\n// the gesture handler and mask the layout-invalidation behavior).\nuse tur::{ mount, rs_set_f64, rs_source_f64, stf_put, stf_take };\nuse tur_kit::{ Container, Expanded, Row };\n\n\nlet K_A: u64 = 1;\nlet K_B: u64 = 2;\n\nentry fn start() -> u64 {\n    let flex_a = rs_source_f64();\n    rs_set_f64(flex_a, 1.0);\n    let flex_b = rs_source_f64();\n    rs_set_f64(flex_b, 1.0);\n    stf_put(K_A, flex_a as f64);\n    stf_put(K_B, flex_b as f64);\n\n    let mut row = Row();\n    let a = Expanded().flex_bound(flex_a).child(qkey_box(\"a\", 0xEF4444FFu64)).build();\n    row.child(a);\n    let b = Expanded().flex_bound(flex_b).child(qkey_box(\"b\", 0x3B82F6FFu64)).build();\n    row.child(b);\n    mount(row.build());\n    return flex_a;\n}\n\nfn qkey_box(key: str, color: u64) -> opaque {\n    let b = Container().width_height(0.0, 0.0).color(color).query_key(key);\n    return b.build();\n}\n\n// The `__setFlex(a, b)` seam: flip both weights (a crosses the u64 slot,\n// b the f64 slot).\nentry fn set_flex(a_new: u64, b_new: f64) {\n    let flex_a = stf_take(K_A) as u64;\n    let flex_b = stf_take(K_B) as u64;\n    rs_set_f64(flex_a, a_new as f64);\n    rs_set_f64(flex_b, b_new);\n    stf_put(K_A, flex_a as f64);\n    stf_put(K_B, flex_b as f64);\n}\n";
    }
    if (name == "lazy-grid-basic") {
        return "// lazy-grid-basic: a virtualized grid (max cross 150, square cells).\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyGrid };\n\n\nentry fn cell(i: u64) -> opaque {\n    let mut b = Container().width_height(0.0, 0.0);\n    if (i % 2 == 0) {\n        b.color(0x303030FF);\n    } else {\n        b.color(0x1A1A1AFF);\n    }\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 60.0);\n    let grid = LazyGrid().item_builder(\"cell\").count(count).max_cross(150.0).aspect(1.0).query_key(\"lazy-grid-basic\").build();\n    mount(grid);\n}\n";
    }
    if (name == "lazy-grid-gallery") {
        return "// lazy-grid-gallery: a header row above a virtualized gallery grid in a\n// column.\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Column, Container, Expanded, LazyGrid, Text };\n\n\nentry fn cell(i: u64) -> opaque {\n    let b = Container()\n        .width_height(0.0, 0.0)\n        .color(0x1E293BFF)\n        .child(Text().text(f\"tile {i}\").font_size(12.0).build());\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 120.0);\n    let mut col = Column();\n    let header = Container()\n        .width_height(0.0, 40.0)\n        .color(0x0F172AFF)\n        .child(Text().text(\"Gallery\").font_size(16.0).build());\n    col.child(header.build());\n    let grid = LazyGrid().item_builder(\"cell\").count(count).max_cross(150.0).aspect(1.0).build();\n    col.child(Expanded().flex(1.0).child(grid).build());\n    mount(col.build());\n}\n";
    }
    if (name == "lazy-grid-scroll") {
        return "// lazy-grid-scroll: a 600-cell grid — wheeling mounts rows outside the\n// initial build set.\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyGrid };\n\n\nentry fn cell(i: u64) -> opaque {\n    let mut b = Container().width_height(0.0, 0.0);\n    if (i % 2 == 0) {\n        b.color(0x303030FF);\n    } else {\n        b.color(0x1A1A1AFF);\n    }\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 600.0);\n    let grid = LazyGrid().item_builder(\"cell\").count(count).max_cross(150.0).aspect(1.0).query_key(\"lazy-grid-scroll\").build();\n    mount(grid);\n}\n";
    }
    if (name == "lazy-list-basic") {
        return "// lazy-list-basic: a 20-row virtualized vertical list (50px rows).\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyList };\n\n\nentry fn row(i: u64) -> opaque {\n    let mut b = Container().width_height(400.0, 50.0);\n    if (i % 2 == 0) {\n        b.color(0x303030FF);\n    } else {\n        b.color(0x1A1A1AFF);\n    }\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 20.0);\n    let list = LazyList().item_builder(\"row\").count(count).item_extent(50.0).query_key(\"lazy-list-basic\").build();\n    mount(list);\n}\n";
    }
    if (name == "lazy-list-row") {
        return "// lazy-list-row: a 50-item HORIZONTAL virtualized list (80px columns).\nuse tur::{ AXIS_HORIZONTAL, mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyList };\n\n\nentry fn item(i: u64) -> opaque {\n    let mut b = Container().width_height(80.0, 300.0);\n    if (i % 2 == 0) {\n        b.color(0x303030FF);\n    } else {\n        b.color(0x1A1A1AFF);\n    }\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 50.0);\n    let list = LazyList().item_builder(\"item\").count(count).axis(AXIS_HORIZONTAL).item_extent(80.0).query_key(\"lazy-list-row\").build();\n    mount(list);\n}\n";
    }
    if (name == "lazy-list-scroll") {
        return "// lazy-list-scroll: a 100-row virtualized list (wheeling mounts rows\n// outside the initial build set).\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyList };\n\n\nentry fn row(i: u64) -> opaque {\n    let mut b = Container().width_height(400.0, 50.0);\n    if (i % 2 == 0) {\n        b.color(0x303030FF);\n    } else {\n        b.color(0x1A1A1AFF);\n    }\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 100.0);\n    let list = LazyList().item_builder(\"row\").count(count).item_extent(50.0).query_key(\"lazy-list-scroll\").build();\n    mount(list);\n}\n";
    }
    if (name == "lazy-list-var-sizes") {
        return "// lazy-list-var-sizes: an unmeasured (var-extent) LazyList — rows report\n// their own heights (deterministic per-index sizes).\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyList, Text };\n\n\nentry fn row(i: u64) -> opaque {\n    let h = ((i * 37) % 120) as f64 + 30.0;\n    let b = Container()\n        .width_height(400.0, h)\n        .color(0x0B1220FF)\n        .child(Text().text(f\"#{i} h={h as u64}\").font_size(11.0).build());\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 500.0);\n    // itemExtent 0 = unmeasured (var sizes).\n    let list = LazyList().item_builder(\"row\").count(count).query_key(\"lazy-list-var-sizes\").build();\n    mount(list);\n}\n";
    }
    if (name == "lazy-list-virtualized") {
        return "// lazy-list-virtualized: a 2000-row list — only the visible window mounts.\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, Expanded, LazyList, Text };\n\n\nentry fn row(i: u64) -> opaque {\n    let b = Container()\n        .width_height(400.0, 40.0)\n        .color(0x0F172AFF)\n        .child(Text().text(f\"row {i}\").font_size(12.0).build());\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 2000.0);\n    let list = LazyList().item_builder(\"row\").count(count).item_extent(40.0).build();\n    mount(Expanded().flex(1.0).child(list).build());\n}\n";
    }
    if (name == "mouse-region-cursor") {
        return "// mouse-region-cursor: a MouseRegion whose cursor + enter/exit drive the\n// shell cursor and the bound state label.\nuse tur::{ CURSOR_COL_RESIZE, mount, rs_set_str, rs_source_str };\nuse tur_kit::{ Column, Container, MouseRegion, Text };\n\n\nentry fn start() -> u64 {\n    let state = rs_source_str(\"\");\n    let mut col = Column();\n    let b = Container().width_height(100.0, 50.0).child(Text().text_bound(state).query_key(\"mr-state\").build());\n    col.child(MouseRegion().on_enter(\"mr_enter\", state).on_exit(\"mr_exit\", state).cursor(CURSOR_COL_RESIZE).behavior(0).child(b.build()).build());\n    mount(col.build());\n    return state;\n}\n\nentry fn mr_enter(state: u64, _b: u64, _n: f64) {\n    rs_set_str(state, \"entered\");\n}\n\nentry fn mr_exit(state: u64, _b: u64, _n: f64) {\n    rs_set_str(state, \"exited\");\n}\n";
    }
    if (name == "mouse-region-reactive-cursor") {
        return "// mouse-region-reactive-cursor: the cursor resolves from a str atom each\n// layout — flipping the atom re-resolves the cursor on hover.\nuse tur::{ mount, rs_set_str, rs_source_str };\nuse tur_kit::{ Column, Container, MouseRegion, Text };\n\n\nentry fn start() -> u64 {\n    let cursor = rs_source_str(\"pointer\");\n    let state = rs_source_str(\"\");\n    let mut col = Column();\n    let b = Container().width_height(100.0, 50.0).child(Text().text_bound(state).build());\n    col.child(MouseRegion().on_enter(\"mr_enter\", state).on_exit(\"mr_exit\", state).cursor_bound(cursor).behavior(0).child(b.build()).build());\n    let ct = Text().text_bound(cursor).query_key(\"cursor-atom\");\n    col.child(ct.build());\n    mount(col.build());\n    return cursor;\n}\n\nentry fn set_cursor(cursor: u64, code: f64) {\n    // code indexes the standard keyword table (the test passes the enum\n    // position of the cursor it wants).\n    let name = cursor_name(code as u64);\n    rs_set_str(cursor, name);\n}\n\nentry fn mr_enter(_state: u64, _b: u64, _n: f64) {\n}\n\nentry fn mr_exit(_state: u64, _b: u64, _n: f64) {\n}\n\n// The standard CSS keyword for a cursor code (the el_mouse_region_bound\n// decode reads the same table).\nfn cursor_name(code: u64) -> str {\n    if (code == 27) {\n        return \"ew-resize\";\n    }\n    if (code == 5) {\n        return \"pointer\";\n    }\n    return \"default\";\n}\n";
    }
    if (name == "password-input") {
        return "// password-input: an obscure-toggle input — typing renders bullets and a\n// reveal button flips the obscure flag (a rebuild).\nuse tur::{ mount, rs_get_bool, rs_set_bool, rs_source_bool, tctrl_new, undo_new };\nuse tur_kit::{ Column, Container, Input, PointerInteract, Text };\n\n\nentry fn start() -> u64 {\n    let obscure = rs_source_bool(true);\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n\n    let mut col = Column();\n    let input = Input().controller(ctrl).undo(undo).placeholder(\"password\").width_height(220.0, 32.0).obscure(true).query_key(\"password-input\").build();\n    col.child(input);\n    col.child(PointerInteract().ids(obscure, obscure).on_tap(\"b_toggle\").child(Text().text(\"reveal\").build()).build());\n    let root = Container().child(col.build());\n    mount(root.build());\n    return obscure;\n}\n\nentry fn b_toggle(obscure: u64, _b: u64, _n: f64) {\n    rs_set_bool(obscure, !rs_get_bool(obscure));\n}\n";
    }
    if (name == "pointer-drag") {
        return "// pointer-drag: a gesture pad reporting down/move/up — the phase label\n// and the last position ride two bound atoms (both cross in the intents).\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_START, mount, rs_set_str, rs_source_str };\nuse tur_kit::{ Column, Container, PointerInteract, Text };\n\n\nentry fn start() -> u64 {\n    let phase = rs_source_str(\"idle\");\n    let pos = rs_source_str(\"0,0\");\n\n    let mut col = Column().cross_alignment(CROSS_ALIGN_START);\n\n    let b = Container()\n        .width_height(100.0, 50.0)\n        .color(0xCCCCCCFFu64)\n        .alignment(ALIGN_CENTER)\n        .child(Text().text_bound(phase).query_key(\"drag-phase\").build());\n\n    col.child(PointerInteract().ids(phase, pos).on_down(\"g_down\").on_move(\"g_move\").on_up(\"g_up\").query_key(\"rut/gesture\").child(b.build()).build());\n\n    let pos_t = Text().text_bound(pos).query_key(\"drag-pos\");\n    col.child(pos_t.build());\n\n    mount(col.build());\n    return phase;\n}\n\nentry fn g_down(phase: u64, pos: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    rs_set_str(pos, f\"{gx as u64},{gy as u64}\");\n    rs_set_str(phase, \"down\");\n}\n\nentry fn g_move(phase: u64, pos: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    rs_set_str(pos, f\"{gx as u64},{gy as u64}\");\n    rs_set_str(phase, \"move\");\n}\n\nentry fn g_up(phase: u64, pos: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    rs_set_str(pos, f\"{gx as u64},{gy as u64}\");\n    rs_set_str(phase, \"up\");\n}\n";
    }
    if (name == "pointer-interact-basic") {
        return "// pointer-interact-basic: an opaque gesture pad around a fixed-size box.\nuse tur::{ mount, rs_source_f64 };\nuse tur_kit::{ Container, PointerInteract };\n\n\nentry fn start() {\n    let pad = rs_source_f64();\n    let b = Container().width_height(100.0, 50.0);\n    mount(PointerInteract().ids(pad, pad).child(b.build()).build());\n}\n";
    }
    if (name == "pointer-interact-empty") {
        return "// pointer-interact-empty: a bare PointerInteract with no child — the\n// invisible hit-target widget (zero-sized, still absorbs at its point).\nuse tur::{ mount, rs_source_f64 };\nuse tur_kit::{ PointerInteract };\n\n\nentry fn start() {\n    let pad = rs_source_f64();\n    mount(PointerInteract().ids(pad, pad).build());\n}\n";
    }
    if (name == "pointer-interact-in-column") {
        return "// pointer-interact-in-column: two gesture pads stacked in a column.\nuse tur::{ CROSS_ALIGN_START, mount, rs_source_f64 };\nuse tur_kit::{ Column, Container, PointerInteract };\n\n\nentry fn start() {\n    let pad = rs_source_f64();\n    let mut col = Column().cross_alignment(CROSS_ALIGN_START);\n    let a = Container().width_height(80.0, 40.0);\n    let b = Container().width_height(60.0, 30.0);\n    col.child(PointerInteract().ids(pad, pad).child(a.build()).build());\n    col.child(PointerInteract().ids(pad, pad).child(b.build()).build());\n    mount(col.build());\n}\n";
    }
    if (name == "pointer-interact-nested") {
        return "// pointer-interact-nested: nested gesture pads — the opaque inner blocks\n// the outer, the translucent inner lets both fire. The result labels are\n// derived atoms over the two counter pairs (the C8 derive rail).\nuse tur::{ CROSS_ALIGN_START, MAIN_SIZE_MIN, mount, rs_derive2, rs_get_f64, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Column, Container, PointerInteract, Row, Text };\n\n\nentry fn start() -> u64 {\n    let outer_o = rs_source_f64();\n    let inner_o = rs_source_f64();\n    let outer_t = rs_source_f64();\n    let inner_t = rs_source_f64();\n    let d_o = rs_derive2(\"fmt_o\", outer_o, inner_o);\n    let d_t = rs_derive2(\"fmt_t\", outer_t, inner_t);\n\n    let mut col = Column().cross_alignment(CROSS_ALIGN_START).main_axis_size(MAIN_SIZE_MIN);\n\n    // Opaque pair: the inner (opaque) absorbs the click.\n    let mut outer_box = Container().width_height(80.0, 40.0).query_key(\"outer-opaque\");\n    let mut inner_row = Row();\n    let inner_box = Container().width_height(60.0, 30.0).query_key(\"inner-opaque\");\n    inner_row.child(PointerInteract().ids(inner_o, inner_o).on_tap(\"ts_inner_o\").child(inner_box.build()).build());\n    outer_box.child(inner_row.build());\n    col.child(PointerInteract().ids(outer_o, outer_o).on_tap(\"ts_outer_o\").child(outer_box.build()).build());\n\n    // Translucent pair: the inner joins the path; the outer fires too.\n    let mut outer_t_box = Container().width_height(80.0, 40.0).query_key(\"outer-translucent\");\n    let mut t_row = Row();\n    let inner_t_box = Container().width_height(60.0, 30.0).query_key(\"inner-translucent\");\n    t_row.child(PointerInteract().ids(inner_t, inner_t).on_tap(\"ts_inner_t\").behavior(1).child(inner_t_box.build()).build());\n    outer_t_box.child(t_row.build());\n    col.child(PointerInteract().ids(outer_t, outer_t).on_tap(\"ts_outer_t\").child(outer_t_box.build()).build());\n\n    let ro = Text().text_bound_derived(d_o).query_key(\"result-opaque\");\n    col.child(ro.build());\n    let rt = Text().text_bound_derived(d_t).query_key(\"result-translucent\");\n    col.child(rt.build());\n\n    mount(col.build());\n    return outer_o;\n}\n\n// The derive bodies — synchronous VM calls during flush.\nentry fn fmt_o(a: f64, b: f64) -> str {\n    return f\"opaque:{a as u64}/{b as u64}\";\n}\n\nentry fn fmt_t(a: f64, b: f64) -> str {\n    return f\"translucent:{a as u64}/{b as u64}\";\n}\n\nentry fn ts_outer_o(count: u64, _b: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n}\n\nentry fn ts_inner_o(count: u64, _b: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n}\n\nentry fn ts_outer_t(count: u64, _b: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n}\n\nentry fn ts_inner_t(count: u64, _b: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n}\n";
    }
    if (name == "pointer-region-enter-exit-race") {
        return "// pointer-region-enter-exit-race: two regions sharing one hover atom —\n// moving A->B in a single event must land on \"B\" (exit-before-enter).\nuse tur::{ mount, rs_set_str, rs_source_str };\nuse tur_kit::{ Column, Container, MouseRegion, Text };\n\n\nentry fn start() -> u64 {\n    let hover = rs_source_str(\"\");\n    let mut col = Column();\n\n    let a = Container().width_height(100.0, 50.0).color(0xEF4444FFu64).query_key(\"a\");\n    col.child(MouseRegion().on_enter(\"a_enter\", hover).on_exit(\"a_exit\", hover).cursor(0).behavior(0).child(a.build()).build());\n\n    let b = Container().width_height(100.0, 50.0).color(0x3B82F6FF).query_key(\"b\");\n    col.child(MouseRegion().on_enter(\"b_enter\", hover).on_exit(\"b_exit\", hover).cursor(0).behavior(0).child(b.build()).build());\n\n    let t = Text().text_bound(hover).query_key(\"hover\");\n    col.child(t.build());\n    mount(col.build());\n    return hover;\n}\n\nentry fn a_enter(hover: u64, _b: u64, _n: f64) {\n    rs_set_str(hover, \"A\");\n}\n\nentry fn a_exit(hover: u64, _b: u64, _n: f64) {\n    rs_set_str(hover, \"\");\n}\n\nentry fn b_enter(hover: u64, _b: u64, _n: f64) {\n    rs_set_str(hover, \"B\");\n}\n\nentry fn b_exit(hover: u64, _b: u64, _n: f64) {\n    rs_set_str(hover, \"\");\n}\n";
    }
    if (name == "pointer-region-text") {
        return "// pointer-region-text: a MouseRegion whose enter/exit writes the bound\n// label inside a padded, centered surface.\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_START, CURSOR_AUTO, mount, rs_set_str, rs_source_str };\nuse tur_kit::{ Column, Container, MouseRegion, Text };\n\n\nentry fn start() -> u64 {\n    let state = rs_source_str(\"idle\");\n    let mut col = Column().cross_alignment(CROSS_ALIGN_START);\n\n    let b = Container()\n        .width_height(100.0, 50.0)\n        .color(0xCCCCCCFFu64)\n        .alignment(ALIGN_CENTER)\n        .child(Text().text_bound(state).query_key(\"region-text\").build());\n\n    col.child(MouseRegion().on_enter(\"mr_enter\", state).on_exit(\"mr_exit\", state).cursor(CURSOR_AUTO).behavior(0).child(b.build()).build());\n    mount(col.build());\n    return state;\n}\n\nentry fn mr_enter(state: u64, _b: u64, _n: f64) {\n    rs_set_str(state, \"entered\");\n}\n\nentry fn mr_exit(state: u64, _b: u64, _n: f64) {\n    rs_set_str(state, \"exited\");\n}\n";
    }
    if (name == "positioned-basic") {
        return "// positioned-basic: a positioned child anchored (10, 20) inside a Stack.\nuse tur::{ mount };\nuse tur_kit::{ Container, Positioned, Stack };\n\n\nentry fn start() {\n    let mut stack = Stack();\n    let sb = Container().width_height(50.0, 50.0);\n    stack.child(Positioned().left(10.0).top(20.0).child(sb.build()).build());\n    mount(stack.build());\n}\n";
    }
    if (name == "positioned-only-stack") {
        return "// positioned-only-stack: a Stack with ONLY positioned children sizes to\n// the biggest size the incoming constraints allow (Flutter RenderStack).\nuse tur::{ mount };\nuse tur_kit::{ Container, Expanded, Positioned, Stack };\n\n\nentry fn start() {\n    let stack = Stack()\n        .child(Positioned().left(5.0).top(5.0).child(qkey_sized(10.0, 10.0, \"dot\")).build());\n    mount(Expanded().flex(1.0).child(stack.build()).build());\n}\n\nfn qkey_sized(w: f64, h: f64, key: str) -> opaque {\n    let b = Container().width_height(w, h).query_key(key);\n    return b.build();\n}\n";
    }
    if (name == "positioned-right-bottom") {
        return "// positioned-right-bottom: edge anchors resolve against the STACK's own\n// final size (200x300), not the incoming constraints (Flutter parity).\nuse tur::{ mount };\nuse tur_kit::{ Container, Positioned, Stack };\n\n\nfn sized(w: f64, h: f64, key: str) -> opaque {\n    let mut b = Container().width_height(w, h);\n    if (key != \"\") {\n        b.query_key(key);\n    }\n    return b.build();\n}\n\nentry fn start() {\n    let stack = Stack()\n        .child(sized(200.0, 300.0, \"\"))\n        .child(Positioned().right(8.0).bottom(8.0).child(sized(60.0, 24.0, \"rb-pill\")).build())\n        .child(Positioned().left(10.0).right(10.0).child(sized(0.0, 20.0, \"lr-pair\")).build());\n    mount(stack.build());\n}\n";
    }
    if (name == "rich-text-bold") {
        return "use tur::{ mount };\nuse tur_kit::{ Spans, Text };\n\n\nentry fn start() {\n    let mut t = Text().text(\"\").font_size(14.0);\n    let spans = Spans().add(\"Normal\", 0.0, 0, 0.0, 0).add(\"Bold\", 0.0, 0, 700.0, 0);\n    t.spans(spans);\n    mount(t.build());\n}\n";
    }
    if (name == "rich-text-color") {
        return "use tur::{ mount };\nuse tur_kit::{ Spans, Text };\n\n\nentry fn start() {\n    let mut t = Text().text(\"\").font_size(14.0);\n    let spans = Spans()\n        .add(\"White\", 0.0, 0, 0.0, 0)\n        .add(\"Red\", 0.0, 0xFF0000FFu64, 0.0, 0)\n        .add(\"Green\", 0.0, 0x00FF00FFu64, 0.0, 0);\n    t.spans(spans);\n    mount(t.build());\n}\n";
    }
    if (name == "rich-text-empty") {
        return "use tur::{ mount };\nuse tur_kit::{ Spans, Text };\n\n\nentry fn start() {\n    let mut t = Text().text(\"\").font_size(14.0);\n    let spans = Spans().add(\"\", 0.0, 0, 0.0, 0);\n    t.spans(spans);\n    mount(t.build());\n}\n";
    }
    if (name == "rich-text-font-size") {
        return "use tur::{ mount };\nuse tur_kit::{ Spans, Text };\n\n\nentry fn start() {\n    let mut t = Text().text(\"\").font_size(14.0);\n    let spans = Spans().add(\"Small\", 0.0, 0, 0.0, 0).add(\"Big\", 28.0, 0, 0.0, 0);\n    t.spans(spans);\n    mount(t.build());\n}\n";
    }
    if (name == "rich-text-inheritance") {
        return "use tur::{ mount };\nuse tur_kit::{ Spans, Text };\n\n\nentry fn start() {\n    let mut t = Text().text(\"\").font_size(20.0);\n    let spans = Spans()\n        .add(\"Inherited\", 0.0, 0xFF0000FFu64, 0.0, 0)\n        .add(\"Override\", 10.0, 0x00FF00FFu64, 0.0, 0);\n    t.spans(spans);\n    mount(t.build());\n}\n";
    }
    if (name == "rich-text-italic") {
        return "use tur::{ mount };\nuse tur_kit::{ Spans, Text };\n\n\nentry fn start() {\n    let mut t = Text().text(\"\").font_size(14.0);\n    let spans = Spans().add(\"Normal\", 0.0, 0, 0.0, 0).add(\"Italic\", 0.0, 0, 0.0, 1);\n    t.spans(spans);\n    mount(t.build());\n}\n";
    }
    if (name == "rich-text-multi-span") {
        return "use tur::{ mount };\nuse tur_kit::{ Spans, Text };\n\n\nentry fn start() {\n    let mut t = Text().text(\"\").font_size(14.0);\n    let spans = Spans()\n        .add(\"Hello \", 0.0, 0, 0.0, 0)\n        .add(\"Bold\", 0.0, 0, 700.0, 0)\n        .add(\" World\", 0.0, 0, 0.0, 0);\n    t.spans(spans);\n    mount(t.build());\n}\n";
    }
    if (name == "rich-text-single-span") {
        return "use tur::{ mount };\nuse tur_kit::{ Spans, Text };\n\n\nentry fn start() {\n    let mut t = Text().text(\"\").font_size(14.0);\n    let spans = Spans().add(\"Hello World\", 0.0, 0, 0.0, 0);\n    t.spans(spans);\n    mount(t.build());\n}\n";
    }
    if (name == "row-basic") {
        return "// row-basic: two fixed-width children laid out horizontally.\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Container, Row };\n\n\nfn box_w(w: f64) -> opaque {\n    let b = Container().width_height(w, 0.0);\n    return b.build();\n}\n\nentry fn start() {\n    let row = Row().cross_alignment(CROSS_ALIGN_START).child(box_w(50.0)).child(box_w(30.0));\n    mount(row.build());\n}\n";
    }
    if (name == "row-cross-center") {
        return "// row-cross-center: a 200x36 container centering a row of two boxes on\n// the cross axis.\nuse tur::{ CROSS_ALIGN_CENTER, mount };\nuse tur_kit::{ Container, Row };\n\n\nentry fn start() {\n    let outer = Container()\n        .width_height(200.0, 36.0)\n        .padding(0.0)\n        .child(Row().cross_alignment(CROSS_ALIGN_CENTER).child(box_wh(20.0, 20.0)).child(box_wh(40.0, 10.0)).build());\n    mount(outer.build());\n}\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n";
    }
    if (name == "row-cross-center-in-column") {
        return "// row-cross-center-in-column: a min-size centering Row in a Column.\nuse tur::{ CROSS_ALIGN_CENTER, CROSS_ALIGN_START, MAIN_SIZE_MIN, mount };\nuse tur_kit::{ Column, Container, Row };\n\n\nentry fn start() {\n    let col = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(Row().cross_alignment(CROSS_ALIGN_CENTER).main_axis_size(MAIN_SIZE_MIN).child(box_wh(20.0, 20.0)).child(box_wh(40.0, 10.0)).build())\n        .child(box_wh(0.0, 30.0))\n        .child(box_wh(0.0, 20.0));\n    mount(col.build());\n}\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n";
    }
    if (name == "row-cross-stretch-no-height") {
        return "// row-cross-stretch-no-height: a Stretch Row gives non-flex children its\n// full cross height; the Expanded supplies the bounded height inside the\n// unbounded Column (sidebar + divider + expanded content pane).\nuse tur::{ CROSS_ALIGN_START, CROSS_ALIGN_STRETCH, mount };\nuse tur_kit::{ Column, Container, Expanded, Row };\n\n\nentry fn start() {\n    let mut col = Column().cross_alignment(CROSS_ALIGN_START);\n    let row = Row()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .child(box_w(100.0))\n        .child(box_w(8.0))\n        .child(Expanded().flex(1.0).child(box_w(0.0)).build());\n    col.child(Expanded().flex(1.0).child(row.build()).build());\n    mount(col.build());\n}\n\nfn box_w(w: f64) -> opaque {\n    let b = Container().width_height(w, 0.0);\n    return b.build();\n}\n";
    }
    if (name == "row-nested") {
        return "// row-nested (Flutter parity): non-flex children of a flex receive unbounded\n// main-axis constraints, so the inner Row (default MainAxisSize.max) must\n// shrink-wrap to its content width instead of consuming the outer Row's\n// full width — leaving the following sibling visible.\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Container, Row };\n\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n\nentry fn start() {\n    let outer = Row()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(Row().child(box_wh(20.0, 0.0)).child(box_wh(30.0, 0.0)).build())\n        .child(box_wh(50.0, 10.0));\n    mount(outer.build());\n}\n";
    }
    if (name == "row-with-each") {
        return "// row-with-each: an Each inside a content-sized Row — the Row must not\n// inflate to the parent Column's height (the regression the test pins).\nuse tur::{ CROSS_ALIGN_STRETCH, mount, rs_list_new, rs_list_push, rs_source_value };\nuse tur_kit::{ Column, Container, Each, Expanded, Row, SizedBox, Text };\n\n\nentry fn item(_i: u64, s: str) -> opaque {\n    let t = Text().text(s).font_size(13.0);\n    return t.build();\n}\n\nentry fn start() {\n    let seg = rs_list_new();\n    rs_list_push(seg, \"a\");\n    rs_list_push(seg, \"b\");\n    let seg_atom = rs_source_value(seg);\n\n    let col = Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .child(Row().child(SizedBox(16.0, 16.0).child(Container().build()).build()).child(Each(seg_atom).item_builder(\"item\").build()).build())\n        .child(SizedBox(40.0, 10.0).child(Container().build()).build())\n        .child(Expanded().flex(1.0).child(Container().build()).build());\n    mount(col.build());\n}\n";
    }
    if (name == "scroll-container-text") {
        return "// scroll-container-text: a padded unsized Container sized from its Text\n// child inside a vertical ScrollView's content Column.\nuse tur::{ AXIS_VERTICAL, mount };\nuse tur_kit::{ Column, Container, ScrollView, Text };\n\n\nentry fn start() {\n    let b = Container()\n        .padding(48.0)\n        .query_key(\"container\")\n        .child(Text().text(\"Empty State\").font_size(24.0).build());\n    let col = Column().child(b.build());\n    mount(ScrollView().axis(AXIS_VERTICAL).child(col.build()).build());\n}\n";
    }
    if (name == "scroll-view-basic") {
        return "// scroll-view-basic: a vertical scroll viewport around a 3x200 column.\nuse tur::{ AXIS_VERTICAL, CROSS_ALIGN_STRETCH, mount };\nuse tur_kit::{ Column, Container, ScrollView };\n\n\nentry fn start() {\n    let content = Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .child(box_h(200.0))\n        .child(box_h(200.0))\n        .child(box_h(200.0));\n    let sv = ScrollView().axis(AXIS_VERTICAL).child(content.build()).query_key(\"scroll-view\").build();\n    mount(sv);\n}\n\nfn box_h(h: f64) -> opaque {\n    let b = Container().width_height(0.0, h);\n    return b.build();\n}\n";
    }
    if (name == "scroll-view-nested") {
        return "// scroll-view-nested: a vertical ScrollView inside a horizontal one. The\n// outer sits in a Row — `Expanded` supplies the bounded viewport (non-flex\n// flex children get unbounded main-axis constraints, Flutter parity).\nuse tur::{ AXIS_VERTICAL, CROSS_ALIGN_START, CROSS_ALIGN_STRETCH, mount };\nuse tur_kit::{ Column, Container, Expanded, Row, ScrollView, SizedBox };\n\n\nentry fn start() {\n    let mut row = Row().child(SizedBox(200.0, 0.0).child(Container().build()).build());\n    let mut outer_content = Column().cross_alignment(CROSS_ALIGN_START).child(box_h(100.0));\n    let mut inner_wrapper = Container().width_height(0.0, 200.0).query_key(\"inner-wrapper\");\n    let inner_content = Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .child(box_h(200.0))\n        .child(box_h(200.0))\n        .child(box_h(200.0));\n    let inner = ScrollView().axis(AXIS_VERTICAL).child(inner_content.build()).build();\n    inner_wrapper.child(inner);\n    outer_content.child(inner_wrapper.build());\n    outer_content.child(box_h(400.0));\n    let outer = ScrollView().axis(AXIS_VERTICAL).child(outer_content.build()).query_key(\"outer-scroll\").build();\n    row.child(Expanded().flex(1.0).child(outer).build());\n    mount(row.build());\n}\n\nfn box_h(h: f64) -> opaque {\n    let b = Container().width_height(0.0, h);\n    return b.build();\n}\n";
    }
    if (name == "scroll-view-offset") {
        return "// scroll-view-offset: a scroll viewport with a one-shot initial offset\n// (the controller's initialOffset twin) — the content offset starts at\n// -100.\nuse tur::{ AXIS_VERTICAL, CROSS_ALIGN_STRETCH, mount };\nuse tur_kit::{ Column, Container, ScrollView };\n\n\nentry fn start() {\n    let content = Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .child(box_h(200.0))\n        .child(box_h(200.0))\n        .child(box_h(200.0));\n    let sv = ScrollView().axis(AXIS_VERTICAL).initial_offset(100.0).child(content.build()).query_key(\"scroll-view\").build();\n    mount(sv);\n}\n\nfn box_h(h: f64) -> opaque {\n    let b = Container().width_height(0.0, h);\n    return b.build();\n}\n";
    }
    if (name == "scroll-view-shrink-wrap") {
        return "// scroll-view-shrink-wrap: the viewport shrink-wraps to its content\n// (120x80) under the root's loose constraints (Flutter\n// _RenderSingleChildViewport parity).\nuse tur::{ AXIS_VERTICAL, CROSS_ALIGN_START, mount };\nuse tur_kit::{ Column, Container, ScrollView };\n\n\nentry fn start() {\n    let content = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(sized(120.0, 40.0))\n        .child(sized(60.0, 40.0));\n    let sv = ScrollView().axis(AXIS_VERTICAL).child(content.build()).query_key(\"sv\").build();\n    mount(sv);\n}\n\nfn sized(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n";
    }
    if (name == "sized-box-basic") {
        return "// sized-box-basic: an exactly-sized box wrapping a Text child.\nuse tur::{ mount };\nuse tur_kit::{ SizedBox, Text };\n\n\nentry fn start() {\n    mount(SizedBox(100.0, 50.0).child(Text().text(\"Hi\").build()).build());\n}\n";
    }
    if (name == "stack-basic") {
        return "// stack-basic: two non-positioned children — the Stack sizes to the\n// largest one and paints them overlaid.\nuse tur::{ mount };\nuse tur_kit::{ Container, Stack };\n\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = Container().width_height(w, h);\n    return b.build();\n}\n\nentry fn start() {\n    let stack = Stack().child(box_wh(100.0, 100.0)).child(box_wh(200.0, 200.0));\n    mount(stack.build());\n}\n";
    }
    if (name == "switch-demo") {
        return "// switch-demo: a toggle switch authored from the gesture + box rows (the\n// Switch widget's corpus twin).\nuse tur::{ mount, rs_get_bool, rs_set_bool, rs_source_bool, stf_put, stf_take };\nuse tur_kit::{ Column, Container, PointerInteract, SizedBox };\n\n\nlet K_ON: u64 = 1;\n\nentry fn start() -> u64 {\n    let on = rs_source_bool(true);\n    stf_put(K_ON, on as f64);\n    let mut col = Column();\n    let track = Container()\n        .width_height(64.0, 32.0)\n        .color(0x22C55EFFu64)\n        .radius(16.0)\n        .padding(4.0)\n        .query_key(\"switch\")\n        .child(thumb(on));\n    col.child(PointerInteract().id(on).on_click(\"b_toggle\").query_key(\"rut/gesture\").child(track.build()).build());\n    mount(SizedBox(400.0, 200.0).child(col.build()).build());\n    return on;\n}\n\nfn thumb(on: u64) -> opaque {\n    let knob = Container().width_height(24.0, 24.0).color(0xFFFFFFFFu64).radius(12.0);\n    let side = Container().width_height(32.0, 24.0).alignment(thumb_align()).child(knob.build());\n    return side.build();\n}\n\nfn thumb_align() -> u64 {\n    let on = stf_take(K_ON) as u64;\n    stf_put(K_ON, on as f64);\n    if (rs_get_bool(on)) {\n        return 5;\n    }\n    return 3;\n}\n\nentry fn b_toggle(_a: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let on = stf_take(K_ON) as u64;\n    rs_set_bool(on, !rs_get_bool(on));\n    stf_put(K_ON, on as f64);\n}\n";
    }
    if (name == "table-basic") {
        return "// table-basic: shared column geometry with a header row, stripes and\n// dividers (the Table widget's corpus twin, authored from flex rows).\nuse tur::{ mount };\nuse tur_kit::{ Column, Container, Row, SizedBox, Text };\n\n\nfn header_cell(label: str, w: f64) -> opaque {\n    let b = Container().width_height(w, 0.0).padding(8.0).child(Text().text(label).font_size(12.0).build());\n    return b.build();\n}\n\nfn cell(label: str, w: f64) -> opaque {\n    let b = Container().width_height(w, 0.0).padding(8.0).child(Text().text(label).font_size(14.0).build());\n    return b.build();\n}\n\nfn header() -> opaque {\n    let r = Row()\n        .child(header_cell(\"PLANET\", 150.0))\n        .child(header_cell(\"NOTES\", 100.0))\n        .child(header_cell(\"DISTANCE\", 100.0));\n    return r.build();\n}\n\nfn planet(name: str, notes: str, distance: str) -> opaque {\n    let r = Row().child(cell(name, 150.0)).child(cell(notes, 100.0)).child(cell(distance, 100.0));\n    let wrapped = Container().width_height(0.0, 36.0).child(r.build());\n    return wrapped.build();\n}\n\nentry fn start() {\n    let table = Column()\n        .child(header())\n        .child(planet(\"Mercury\", \"Smallest planet\", \"0.39 AU\"))\n        .child(planet(\"Venus\", \"Hottest surface\", \"0.72 AU\"))\n        .child(planet(\"Earth\", \"Home of life\", \"1.00 AU\"))\n        .child(planet(\"Mars\", \"The red planet\", \"1.52 AU\"));\n    let frame = Container().color(0x0B1220FF).child(table.build());\n    mount(SizedBox(400.0, 240.0).child(frame.build()).build());\n}\n";
    }
    if (name == "table-reactive") {
        return "// table-reactive: the table twin with a reactive row set — a button adds\n// a planet through an Each over the rows atom.\nuse tur::{ mount, rs_get_value, rs_list_new, rs_list_push, rs_set_value, rs_source_value,\n    rs_value_item, rs_value_len };\nuse tur_kit::{ Column, Container, Each, PointerInteract, Row, SizedBox, Text };\n\n\nentry fn row(_i: u64, name: str) -> opaque {\n    let mut r = Row();\n    let c = Container().width_height(150.0, 0.0).padding(8.0).child(Text().text(name).font_size(14.0).build());\n    r.child(c.build());\n    return r.build();\n}\n\nentry fn start() -> u64 {\n    let rows = rs_list_new();\n    rs_list_push(rows, \"Mercury\");\n    rs_list_push(rows, \"Venus\");\n    let rows_atom = rs_source_value(rows);\n\n    let mut col = Column();\n    let head = Container()\n        .width_height(0.0, 32.0)\n        .color(0x1E293BFF)\n        .child(Text().text(\"PLANET\").font_size(12.0).build());\n    col.child(head.build());\n    col.child(Each(rows_atom).item_builder(\"row\").build());\n    col.child(PointerInteract().ids(rows_atom, rows_atom).on_tap(\"b_add\").child(Text().text(\"add row\").build()).build());\n    let frame = Container().color(0x0B1220FF).child(col.build());\n    mount(SizedBox(400.0, 240.0).child(frame.build()).build());\n    return rows_atom;\n}\n\nentry fn b_add(rows: u64, _b: u64, _n: f64) {\n    // Read-modify-write: rebuild the list with one more row.\n    let cur = rs_get_value(rows);\n    let n = rs_value_len(cur);\n    let fresh = rs_list_new();\n    let mut i = 0;\n    while (i < n as i32) {\n        rs_list_push(fresh, rs_value_item(cur, i as u64));\n        i += 1;\n    }\n    rs_list_push(fresh, f\"Planet {n as u64}\");\n    rs_set_value(rows, fresh);\n}\n";
    }
    if (name == "text-basic") {
        return "// text-basic: a single 14px Text as the root child.\nuse tur::{ mount };\nuse tur_kit::{ Text };\n\n\nentry fn start() {\n    let t = Text().text(\"Hello\").font_size(14.0);\n    mount(t.build());\n}\n";
    }
    if (name == "text-ellipsis") {
        return "// text-ellipsis: the long line ellipsized at two lines.\nuse tur::{ mount };\nuse tur_kit::{ Text };\n\n\nentry fn start() {\n    let t = Text()\n        .text(\"Hello World this is a long text that should wrap\")\n        .font_size(14.0)\n        .max_lines(2)\n        .ellipsis();\n    mount(t.build());\n}\n";
    }
    if (name == "text-empty-content") {
        return "// text-empty-content: empty text content measures to zero.\nuse tur::{ mount };\nuse tur_kit::{ Text };\n\n\nentry fn start() {\n    mount(Text().text(\"\").build());\n}\n";
    }
    if (name == "text-font-size") {
        return "// text-font-size: a Fragment of 14px and 28px Texts — the root's children\n// stay flat (the fragment is layout-transparent).\nuse tur::{ mount };\nuse tur_kit::{ Fragment, Text };\n\n\nentry fn start() {\n    let small = Text().text(\"Hello\").font_size(14.0);\n    let large = Text().text(\"Hello\").font_size(28.0);\n    mount(Fragment().children([small.build(), large.build()]).build());\n}\n";
    }
    if (name == "text-font-weight") {
        return "// text-font-weight: weight 400 vs 700 at the same size — the bold run\n// measures wider.\nuse tur::{ mount };\nuse tur_kit::{ Fragment, Text };\n\n\nentry fn start() {\n    let normal = Text().text(\"Hello\").font_size(20.0).font_weight(400.0);\n    let bold = Text().text(\"Hello\").font_size(20.0).font_weight(700.0);\n    mount(Fragment().children([normal.build(), bold.build()]).build());\n}\n";
    }
    if (name == "text-in-column") {
        return "// text-in-column: two Texts stacked in a start-aligned Column.\nuse tur::{ CROSS_ALIGN_START, mount };\nuse tur_kit::{ Column, Text };\n\n\nentry fn start() {\n    let mut col = Column().cross_alignment(CROSS_ALIGN_START);\n    let first = Text().text(\"First\").font_size(14.0);\n    let second = Text().text(\"Second\").font_size(14.0);\n    col.child(first.build());\n    col.child(second.build());\n    mount(col.build());\n}\n";
    }
    if (name == "text-max-lines") {
        return "// text-max-lines: the long line clipped to two lines.\nuse tur::{ mount };\nuse tur_kit::{ Text };\n\n\nentry fn start() {\n    let t = Text()\n        .text(\"Hello World this is a long text that should wrap\")\n        .font_size(14.0)\n        .max_lines(2)\n        .clip();\n    mount(t.build());\n}\n";
    }
    if (name == "text-wrapping") {
        return "// text-wrapping: a long 14px line wraps within the width budget.\nuse tur::{ mount };\nuse tur_kit::{ Text };\n\n\nentry fn start() {\n    let t = Text().text(\"Hello World this is a long text that should wrap\").font_size(14.0);\n    mount(t.build());\n}\n";
    }
    if (name == "todolist") {
        return "// todolist: the checkable list showcase (the corpus's composite surface:\n// scroll + per-item gestures + derived count).\nuse tur::{ AXIS_VERTICAL, MAIN_ALIGN_SPACE_BETWEEN, mount, rs_derive, rs_list_new, rs_list_push,\n    rs_set_value, rs_source_value, stf_put, stf_take };\nuse tur_kit::{ Column, Container, Each, Expanded, PointerInteract, Row, ScrollView, SizedBox, Text };\n\n\nlet K_ITEMS: u64 = 1;\n\nentry fn item(_i: u64, s: str) -> opaque {\n    let r = Row()\n        .main_alignment(MAIN_ALIGN_SPACE_BETWEEN)\n        .child(Text().text(s).build())\n        .child(Container().width_height(20.0, 20.0).query_key(\"check\").build());\n    let wrap = Container().width_height(0.0, 44.0).child(r.build());\n    return PointerInteract().ids(_i, 0).on_click(\"it_tap\").query_key(\"rut/gesture\").child(wrap.build()).build();\n}\n\nentry fn start() -> u64 {\n    let items = rs_list_new();\n    rs_list_push(items, \"Buy milk\");\n    rs_list_push(items, \"Ship phase 4\");\n    rs_list_push(items, \"Walk the dog\");\n    let items_atom = rs_source_value(items);\n    stf_put(K_ITEMS, items_atom as f64);\n    let count = rs_derive(\"fmt_count\", items_atom);\n\n    let mut col = Column();\n    let head = Container()\n        .width_height(0.0, 48.0)\n        .child(Text().text_bound_derived(count).query_key(\"count\").build());\n    col.child(head.build());\n    let content = Column().child(Each(items_atom).item_builder(\"item\").build());\n    let scroller = ScrollView().axis(AXIS_VERTICAL).child(content.build()).build();\n    col.child(Expanded().flex(1.0).child(scroller).build());\n    let add = Container()\n        .width_height(0.0, 48.0)\n        .child(PointerInteract().ids(items_atom, items_atom).on_tap(\"b_add\").child(Text().text(\"+ add\").build()).build());\n    col.child(add.build());\n    mount(SizedBox(400.0, 600.0).child(col.build()).build());\n}\n\nentry fn fmt_count(_v: f64) -> str {\n    return \"todos\";\n}\n\nentry fn it_tap(_idx: u64, _b: u64, _n: f64) {\n}\n\nentry fn b_add(_a: u64, _b: u64, _n: f64) {\n    let items = stf_take(K_ITEMS) as u64;\n    let fresh = rs_list_new();\n    rs_list_push(fresh, \"Buy milk\");\n    rs_list_push(fresh, \"Ship phase 4\");\n    rs_list_push(fresh, \"Walk the dog\");\n    rs_list_push(fresh, \"New todo\");\n    rs_set_value(items, fresh);\n    stf_put(K_ITEMS, items as f64);\n}\n";
    }
    if (name == "transform-translate-hit") {
        return "// transform-translate-hit: a box laid out at (0,0) painted at (100,80)\n// via a paint-only Transform translate — clickable at the PAINTED center.\n// The click flips the hit atom; the Condition mounts the red confirmation\n// box (the branch swap adds one container node).\nuse tur::{ ALIGN_TOP_LEFT, mount, rs_set_bool, rs_source_bool };\nuse tur_kit::{ Condition, Container, PointerInteract, SizedBox, Stack, Text };\nuse tur_anim_kit::{ Transform };\n\n\nentry fn start() {\n    let hit = rs_source_bool(false);\n\n    let mut stack = Stack()\n        .alignment(ALIGN_TOP_LEFT)\n        .child(SizedBox(400.0, 600.0).child(Container().build()).build());\n\n    let indigo = Container().width_height(40.0, 40.0).color(0x4F46E1FFu64);\n    let pi = PointerInteract().ids(hit, hit).on_tap(\"b_hit\").child(indigo.build()).build();\n    stack.child(Transform(1.0, 0.0, 100.0, 80.0).child(pi).build());\n\n    // The confirmation box appears when the click registers (the else\n    // branch is a Text — not a container — so the container count grows\n    // by exactly one when the red box mounts).\n    let red = Container().width_height(40.0, 40.0).color(0xFF0000FFu64);\n    stack.child(Condition(hit).then(red.build()).else_branch(Text().text(\"\").build()).build());\n\n    mount(stack.build());\n}\n\nentry fn b_hit(hit: u64, _b: u64, _n: f64) {\n    rs_set_bool(hit, true);\n}\n";
    }
    if (name == "vello-column-basic") {
        return "// vello-column-basic: a colored container with two text rows — the vello\n// render smoke fixture.\nuse tur::{ mount };\nuse tur_kit::{ Column, Container, Text };\n\n\nentry fn start() {\n    let col = Column()\n        .child(Text().text(\"hello vello\").build())\n        .child(Text().text(\"second line\").build());\n    mount(Container().color(0xF0F4F8FFu64).padding(12.0).child(col.build()).build());\n}\n";
    }
    return "";
}
