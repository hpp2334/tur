fn pg_case_source(name: str) -> str {
    if (name == "clickable-text") {
        return "// clickable-text: a PointerInteract wrapping a bound Text — the click\n// swaps the atom's content.\nuse tur::{ CROSS_ALIGN_START, el_build, el_child, el_column, el_pi, el_qkey, el_text_bound_new, flex_cross_align, mount, rs_set_str, rs_source_str };\n\nentry fn start() -> u64 {\n    let content = rs_source_str(\"before\");\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    let t = el_text_bound_new(content);\n    el_qkey(t, \"click-text\");\n    el_child(col, el_pi(content, content, \"ts_click\", \"\", 0, \"\", el_build(t)));\n    mount(el_build(col));\n    return content;\n}\n\nentry fn ts_click(content: u64, _b: u64, _n: f64) {\n    rs_set_str(content, \"after\");\n}\n";
    }
    if (name == "column-basic") {
        return "// column-basic: two fixed-height children stacked vertically (the root\n// Column fills the viewport; cross axis start-aligned).\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_column, flex_cross_align, mount };\n\nfn box_h(h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    el_child(col, box_h(50.0));\n    el_child(col, box_h(30.0));\n    mount(el_build(col));\n}\n";
    }
    if (name == "column-container-text-intrinsic") {
        return "// column-container-text-intrinsic: a padded, unsized Container in a Column\n// sizes from its Text child's intrinsic measurement.\nuse tur::{ el_box_new, box_padding, el_build, el_child, el_column, el_qkey, el_text_new, text_size, mount };\n\nentry fn start() {\n    let col = el_column();\n    let b = el_box_new();\n    box_padding(b, 48.0);\n    el_qkey(b, \"container\");\n    let t = el_text_new(\"Empty State\");\n    text_size(t, 24.0);\n    el_qkey(t, \"text\");\n    el_child(b, el_build(t));\n    el_child(col, el_build(b));\n    mount(el_build(col));\n}\n";
    }
    if (name == "column-cross-start") {
        return "// column-cross-start: one 100x50 box, cross axis start-aligned.\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_column, flex_cross_align, mount };\n\nentry fn start() {\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    let sb = el_box_new();\n    box_size(sb, 100.0, 50.0);\n    el_child(col, el_build(sb));\n    mount(el_build(col));\n}\n";
    }
    if (name == "column-expanded-container-text") {
        return "// column-expanded-container-text: a padded unsized Container sized from\n// its Text child, wrapped in Expanded inside a max Column.\nuse tur::{ el_box_new, box_padding, el_build, el_child, el_column, el_expand, el_qkey, el_text_new, text_size, mount };\n\nentry fn start() {\n    let col = el_column();\n    let b = el_box_new();\n    box_padding(b, 48.0);\n    el_qkey(b, \"container\");\n    let t = el_text_new(\"Empty State\");\n    text_size(t, 24.0);\n    el_child(b, el_build(t));\n    el_child(col, el_expand(1.0, el_build(b)));\n    mount(el_build(col));\n}\n";
    }
    if (name == "column-main-end") {
        return "// column-main-end: two fixed-height children pinned to the main-axis end.\nuse tur::{ CROSS_ALIGN_START, MAIN_ALIGN_END, el_box_new, box_size, el_build, el_child, el_column, flex_cross_align, flex_main_align, mount };\n\nfn box_h(h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let col = el_column();\n    flex_main_align(col, MAIN_ALIGN_END);\n    flex_cross_align(col, CROSS_ALIGN_START);\n    el_child(col, box_h(50.0));\n    el_child(col, box_h(30.0));\n    mount(el_build(col));\n}\n";
    }
    if (name == "column-nested") {
        return "// column-nested: a Column inside a Column. Non-flex children receive\n// UNBOUNDED main-axis constraints, so the inner Column (default\n// MainAxisSize.max) must degenerate to content size (Flutter RenderFlex\n// parity).\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_column, flex_cross_align, mount };\n\nfn box_h(h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let outer = el_column();\n    flex_cross_align(outer, CROSS_ALIGN_START);\n    el_child(outer, box_h(50.0));\n    let inner = el_column();\n    flex_cross_align(inner, CROSS_ALIGN_START);\n    el_child(inner, box_h(30.0));\n    el_child(outer, el_build(inner));\n    el_child(outer, box_h(40.0));\n    mount(el_build(outer));\n}\n";
    }
    if (name == "column-overflow") {
        return "// column-overflow: three 300px children in a Min column — total 900px\n// overflows the 600px viewport. Children keep their natural height (not\n// squished to 0).\nuse tur::{ MAIN_SIZE_MIN, el_box_new, box_size, el_build, el_child, el_column, flex_main_size, mount };\n\nfn box_h(h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let col = el_column();\n    flex_main_size(col, MAIN_SIZE_MIN);\n    el_child(col, box_h(300.0));\n    el_child(col, box_h(300.0));\n    el_child(col, box_h(300.0));\n    mount(el_build(col));\n}\n";
    }
    if (name == "column-stretch-container-text") {
        return "// column-stretch-container-text: Column(crossAlignment: Stretch) around a\n// padded unsized Container + Text — full-width colored strip.\nuse tur::{ CROSS_ALIGN_STRETCH, el_box_new, box_color, box_padding, el_build, el_child, el_column, el_qkey, el_text_new, flex_cross_align, mount };\n\nentry fn start() {\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_STRETCH);\n    let b = el_box_new();\n    box_color(b, 0xFF0000FFu64);\n    box_padding(b, 20.0);\n    el_qkey(b, \"container\");\n    el_child(b, el_build(el_text_new(\"Empty State\")));\n    el_child(col, el_build(b));\n    mount(el_build(col));\n}\n";
    }
    if (name == "complex-animation") {
        return "// complex-animation: the showcase twin — a controller-driven animation\n// with explicit tween composition (opacity + translate on one target).\nuse tur::{ anim_ctrl, anim_forward, anim_repeat, curve_eval, el_box_new, box_color, box_size, el_build, el_child, el_column, el_expand, el_opacity_bound, el_sizedbox, el_text_new, mount, rs_source_f64 };\n\nentry fn start() -> u64 {\n    let t = rs_source_f64();\n    let ctrl = anim_ctrl(t, 2000.0, \"easeInOut\", 0, \"a_tick\", \"a_end\");\n    anim_repeat(ctrl, 1000);\n    anim_forward(ctrl);\n\n    let col = el_column();\n    el_child(col, el_sizedbox(400.0, 40.0, el_build(el_text_new(\"complex-animation: repeat + tween\"))));\n    let target = el_box_new();\n    box_size(target, 60.0, 60.0);\n    box_color(target, 0x6366F1FFu64);\n    let opacity = el_opacity_bound(t, target);\n    el_child(col, el_expand(1.0, opacity));\n    mount(el_build(col));\n    return t;\n}\n\nentry fn a_tick(_atom: u64, _t: f64) {\n}\n\nentry fn a_end(_atom: u64, _v: f64) {\n}\n";
    }
    if (name == "composited-transform-basic") {
        return "// composited-transform-basic: default TopLeft/TopLeft anchors, zero\n// targetOffset — the follower lands on the target's top-left (100, 80).\nuse tur::{ ALIGN_TOP_LEFT, el_box_new, box_color, box_size, el_build, el_child, el_ct_follower, el_ct_target, ct_link_new, el_positioned, el_qkey, el_sizedbox, el_stack, mount };\n\nentry fn start() {\n    let link = ct_link_new();\n    let stack = el_stack();\n    el_child(stack, el_sizedbox(400.0, 600.0, el_build(el_box_new())));\n    let target_child = el_sizedbox(60.0, 40.0, el_build(el_box_new()));\n    let target = el_ct_target(link, target_child);\n    el_child(stack, el_positioned(100.0, 80.0, target));\n    let red = el_box_new();\n    box_size(red, 20.0, 20.0);\n    box_color(red, 0xFF0000FFu64);\n    let follower = el_ct_follower(link, ALIGN_TOP_LEFT, ALIGN_TOP_LEFT, 0.0, 0.0, el_build(red));\n    el_child(stack, follower);\n    mount(el_build(stack));\n}\n";
    }
    if (name == "composited-transform-follower-anchor") {
        return "// composited-transform-follower-anchor: explicit follower anchor — the\n// follower's BOTTOM_RIGHT lands on the target's top-left (the anchor\n// math the subsystem solves).\nuse tur::{ ALIGN_BOTTOM_RIGHT, ALIGN_TOP_LEFT, el_box_new, box_color, box_size, el_build, el_child, el_ct_follower, el_ct_target, ct_link_new, el_positioned, el_sizedbox, el_stack, mount };\n\nentry fn start() {\n    let link = ct_link_new();\n    let stack = el_stack();\n    el_child(stack, el_sizedbox(400.0, 600.0, el_build(el_box_new())));\n    let target_child = el_sizedbox(60.0, 40.0, el_build(el_box_new()));\n    let target = el_ct_target(link, target_child);\n    el_child(stack, el_positioned(100.0, 80.0, target));\n    let red = el_box_new();\n    box_size(red, 20.0, 20.0);\n    box_color(red, 0xFF0000FFu64);\n    let follower = el_ct_follower(link, ALIGN_TOP_LEFT, ALIGN_BOTTOM_RIGHT, 0.0, 0.0, el_build(red));\n    el_child(stack, follower);\n    mount(el_build(stack));\n}\n";
    }
    if (name == "composited-transform-follower-under-transform") {
        return "// composited-transform-follower-under-transform: the FOLLOWER's ancestor\n// carries a paint-only translate (50, 30) — the subsystem solves\n// parent_world^-1 * translate so the follower lands on the target (100, 80).\nuse tur::{ ALIGN_TOP_LEFT, el_box_new, box_color, box_size, el_build, el_child, el_ct_follower, el_ct_target, ct_link_new, el_positioned, el_sizedbox, el_stack, el_transform, mount };\n\nentry fn start() {\n    let link = ct_link_new();\n    let stack = el_stack();\n    el_child(stack, el_sizedbox(400.0, 600.0, el_build(el_box_new())));\n    let target_child = el_sizedbox(60.0, 40.0, el_build(el_box_new()));\n    let target = el_ct_target(link, target_child);\n    el_child(stack, el_positioned(100.0, 80.0, target));\n    let red = el_box_new();\n    box_size(red, 20.0, 20.0);\n    box_color(red, 0xFF0000FFu64);\n    let follower = el_ct_follower(link, ALIGN_TOP_LEFT, ALIGN_TOP_LEFT, 0.0, 0.0, el_build(red));\n    let transformed = el_transform(1.0, 0.0, 50.0, 30.0, follower);\n    el_child(stack, transformed);\n    mount(el_build(stack));\n}\n";
    }
    if (name == "composited-transform-reactive-anchor") {
        return "// composited-transform-reactive-anchor: the target anchor resolves from an\n// atom; the button (20, 540) flips it to BottomRight — the follower\n// relocates to the target's bottom-right (160, 120).\nuse tur::{ ALIGN_BOTTOM_RIGHT, ALIGN_TOP_LEFT, el_box_new, box_color, box_size, el_build, el_child, el_ct_follower_bound, el_ct_target, ct_link_new, el_pi, el_positioned, el_qkey, el_sizedbox, el_stack, mount, rs_set_f64, rs_source_f64 };\n\nentry fn start() -> u64 {\n    let anchor = rs_source_f64();\n    rs_set_f64(anchor, 0.0);\n    let link = ct_link_new();\n    let stack = el_stack();\n    el_child(stack, el_sizedbox(400.0, 600.0, el_build(el_box_new())));\n    let target_child = el_sizedbox(60.0, 40.0, el_build(el_box_new()));\n    let target = el_ct_target(link, target_child);\n    el_child(stack, el_positioned(100.0, 80.0, target));\n    let red = el_box_new();\n    box_size(red, 20.0, 20.0);\n    box_color(red, 0xFF0000FFu64);\n    let follower = el_ct_follower_bound(link, anchor, ALIGN_TOP_LEFT, 0.0, 0.0, el_build(red));\n    el_child(stack, follower);\n\n    let btn = el_box_new();\n    box_size(btn, 60.0, 30.0);\n    box_color(btn, 0x4F46E1FFu64);\n    el_child(stack, el_positioned(20.0, 540.0, el_pi(anchor, anchor, \"b_flip\", \"\", 0, \"\", el_build(btn))));\n    mount(el_build(stack));\n    return anchor;\n}\n\nentry fn b_flip(anchor: u64, _b: u64, _n: f64) {\n    rs_set_f64(anchor, 8.0);\n}\n";
    }
    if (name == "composited-transform-scroll") {
        return "// composited-transform-scroll: the target lives inside a scrollable\n// (content offset y=100); scrolling moves the target and the follower\n// tracks it.\nuse tur::{ ALIGN_TOP_LEFT, el_box_new, box_color, box_size, el_build, el_child, el_column, el_ct_follower, el_ct_target, ct_link_new, el_positioned_full, el_qkey, el_sizedbox, el_stack, el_scroll, mount };\n\nentry fn start() {\n    let link = ct_link_new();\n    let stack = el_stack();\n    el_child(stack, el_sizedbox(400.0, 600.0, el_build(el_box_new())));\n\n    // The scrollable viewport (200x200) with 400px of content; the target\n    // sits at content y=100 (after a 100px spacer).\n    let content = el_column();\n    el_child(content, el_sizedbox(200.0, 100.0, el_build(el_box_new())));\n    let target_child = el_sizedbox(60.0, 40.0, el_build(el_box_new()));\n    let target = el_ct_target(link, target_child);\n    el_child(content, target);\n    el_child(content, el_sizedbox(200.0, 300.0, el_build(el_box_new())));\n    let scroller = el_scroll(true, el_build(content));\n    el_child(stack, el_positioned_full(0.0, 0.0, 0.0, 0.0, 200.0, 200.0, scroller));\n\n    let red = el_box_new();\n    box_size(red, 20.0, 20.0);\n    box_color(red, 0xFF0000FFu64);\n    let follower = el_ct_follower(link, ALIGN_TOP_LEFT, ALIGN_TOP_LEFT, 0.0, 0.0, el_build(red));\n    el_child(stack, follower);\n    mount(el_build(stack));\n}\n";
    }
    if (name == "composited-transform-sibling-relayout") {
        return "// composited-transform-sibling-relayout: an unrelated sibling's reactive\n// height flip forces the common Stack to relayout — the follower must keep\n// painting at the tracked (100, 80).\nuse tur::{ ALIGN_TOP_LEFT, el_box_new, box_color, box_size, box_height_bound, el_build, el_child, el_ct_follower, el_ct_target, ct_link_new, el_pi, el_positioned, el_qkey, el_sizedbox, el_stack, mount, rs_set_f64, rs_source_f64, stf_put, stf_take };\n\nlet K_TALL: u64 = 1;\n\nentry fn start() -> u64 {\n    let tall = rs_source_f64();\n    rs_set_f64(tall, 0.0);\n    stf_put(K_TALL, tall as f64);\n    let link = ct_link_new();\n    let stack = el_stack();\n    el_child(stack, el_sizedbox(400.0, 600.0, el_build(el_box_new())));\n    let target_child = el_sizedbox(60.0, 40.0, el_build(el_box_new()));\n    let target = el_ct_target(link, target_child);\n    el_child(stack, el_positioned(100.0, 80.0, target));\n    let red = el_box_new();\n    box_size(red, 20.0, 20.0);\n    box_color(red, 0xFF0000FFu64);\n    let follower = el_ct_follower(link, ALIGN_TOP_LEFT, ALIGN_TOP_LEFT, 0.0, 0.0, el_build(red));\n    el_child(stack, follower);\n\n    // The reactive sibling (non-positioned): height flips 10 -> 120.\n    let sib = el_box_new();\n    box_size(sib, 40.0, 0.0);\n    box_color(sib, 0x4F46E1FFu64);\n    el_child(stack, el_build(sib));\n\n    let btn = el_box_new();\n    box_size(btn, 60.0, 30.0);\n    box_color(btn, 0x16A34AFFu64);\n    el_child(stack, el_positioned(300.0, 540.0, el_pi(tall, tall, \"b_tall\", \"\", 0, \"\", el_build(btn))));\n    mount(el_build(stack));\n    return tall;\n}\n\nentry fn b_tall(tall: u64, _b: u64, _n: f64) {\n    rs_set_f64(tall, 120.0);\n}\n";
    }
    if (name == "composited-transform-transform") {
        return "// composited-transform-transform: the target sits under a paint-only\n// Transform translate (50, 10) at layout (20, 20) — the follower tracks the\n// PAINTED position (70, 30).\nuse tur::{ ALIGN_TOP_LEFT, el_box_new, box_color, box_size, el_build, el_child, el_ct_follower, el_ct_target, ct_link_new, el_positioned, el_sizedbox, el_stack, el_transform, mount };\n\nentry fn start() {\n    let link = ct_link_new();\n    let stack = el_stack();\n    el_child(stack, el_sizedbox(400.0, 600.0, el_build(el_box_new())));\n    let target_child = el_sizedbox(60.0, 40.0, el_build(el_box_new()));\n    let target = el_ct_target(link, target_child);\n    let transformed = el_transform(1.0, 0.0, 50.0, 10.0, target);\n    el_child(stack, el_positioned(20.0, 20.0, transformed));\n    let red = el_box_new();\n    box_size(red, 20.0, 20.0);\n    box_color(red, 0xFF0000FFu64);\n    let follower = el_ct_follower(link, ALIGN_TOP_LEFT, ALIGN_TOP_LEFT, 0.0, 0.0, el_build(red));\n    el_child(stack, follower);\n    mount(el_build(stack));\n}\n";
    }
    if (name == "condition-basic") {
        return "// condition-basic: a Condition whose then-branch renders (pre-built\n// branches swapped by the engine — no rut during flush).\nuse tur::{ condition, el_box_new, box_color, box_size, el_build, el_qkey, el_text_new, mount, rs_source_bool };\n\nentry fn start() {\n    let when = rs_source_bool(true);\n    let then_box = el_box_new();\n    box_size(then_box, 200.0, 100.0);\n    box_color(then_box, 0x303030FF);\n    el_qkey(then_box, \"then-branch\");\n    el_child(then_box, el_build(el_text_new(\"then-branch\")));\n    let else_box = el_box_new();\n    box_size(else_box, 200.0, 100.0);\n    box_color(else_box, 0x501A1AFF);\n    el_qkey(else_box, \"else-branch\");\n    el_child(else_box, el_build(el_text_new(\"else-branch\")));\n    let c = condition(when, el_build(then_box), el_build(else_box));\n    el_qkey(c, \"condition-basic\");\n    mount(c);\n}\n";
    }
    if (name == "container-basic") {
        return "// container-basic: a padded container around a fixed-size child.\nuse tur::{ el_box_new, box_padding, box_size, el_build, el_child, mount };\n\nentry fn start() {\n    let outer = el_box_new();\n    box_padding(outer, 16.0);\n    let inner = el_box_new();\n    box_size(inner, 100.0, 100.0);\n    el_child(outer, el_build(inner));\n    mount(el_build(outer));\n}\n";
    }
    if (name == "container-border") {
        return "// container-border: explicit size + padding + color + inside border +\n// radius around a Text.\nuse tur::{ BORDER_INSIDE, el_box_new, box_border, box_color, box_padding, box_radius, box_size, el_build, el_child, el_text_new, text_size, mount, el_qkey };\n\nentry fn start() {\n    let b = el_box_new();\n    box_size(b, 200.0, 200.0);\n    box_padding(b, 16.0);\n    box_color(b, 0xFFFFFFFFu64);\n    box_border(b, 0x000000FFu64, 2.0, BORDER_INSIDE);\n    box_radius(b, 8.0);\n    let label = el_text_new(\"Border\");\n    text_size(label, 16.0);\n    el_child(b, el_build(label));\n    el_qkey(b, \"border-container\");\n    mount(el_build(b));\n}\n";
    }
    if (name == "container-clip-rounded") {
        return "// container-clip-rounded: a rounded, hard-edge-clipped container holding\n// an oversized red child (the corners must clip).\nuse tur::{ CLIP_HARD_EDGE, el_box_new, box_clip, box_color, box_radius, box_size, el_build, el_child, mount };\n\nentry fn start() {\n    let b = el_box_new();\n    box_size(b, 200.0, 200.0);\n    box_radius(b, 40.0);\n    box_clip(b, CLIP_HARD_EDGE);\n    let red = el_box_new();\n    box_size(red, 200.0, 200.0);\n    box_color(red, 0xFF0000FFu64);\n    el_child(b, el_build(red));\n    mount(el_build(b));\n}\n";
    }
    if (name == "container-flex-sized") {
        return "// container-flex-sized: a Column of fixed-size colored \"buttons\" with\n// labeled children (the counter-family shapes).\nuse tur::{ el_box_new, box_color, box_size, el_build, el_child, el_column, el_qkey, el_text_new, text_size, mount };\n\nentry fn start() {\n    let col = el_column();\n    el_child(col, qkey_button(\"btn\", \"Btn\"));\n    el_child(col, qkey_button(\"btn2\", \"Btn2\"));\n    mount(el_build(col));\n}\n\n// A 100x44 colored pill with a centered 14px label.\nfn qkey_button(key: str, label: str) -> opaque {\n    let b = el_box_new();\n    box_size(b, 100.0, 44.0);\n    box_color(b, 0x6366F1FFu64);\n    el_qkey(b, key);\n    let t = el_text_new(label);\n    text_size(t, 14.0);\n    el_child(b, el_build(t));\n    return el_build(b);\n}\n";
    }
    if (name == "container-padding-offset") {
        return "// container-padding-offset: a padded container around a start-aligned\n// column holding one fixed-size child.\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_padding, box_size, el_build, el_child, el_column, flex_cross_align, mount };\n\nentry fn start() {\n    let outer = el_box_new();\n    box_size(outer, 200.0, 100.0);\n    box_padding(outer, 20.0);\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    let inner = el_box_new();\n    box_size(inner, 40.0, 40.0);\n    el_child(col, el_build(inner));\n    el_child(outer, el_build(col));\n    mount(el_build(outer));\n}\n";
    }
    if (name == "container-shadow") {
        return "// container-shadow: an elevated card — size + color + radius + shadow —\n// around a Text.\nuse tur::{ el_box_new, box_color, box_padding, box_radius, box_shadow, box_size, el_build, el_child, el_text_new, text_size, mount };\n\nentry fn start() {\n    let b = el_box_new();\n    box_size(b, 200.0, 200.0);\n    box_color(b, 0xFFFFFFFFu64);\n    box_radius(b, 8.0);\n    box_shadow(b, 0x00000050u64, 12.0, 4.0, 4.0);\n    let label = el_text_new(\"Shadow\");\n    text_size(label, 16.0);\n    el_child(b, el_build(label));\n    mount(el_build(b));\n}\n";
    }
    if (name == "container-update-clear-prop") {
        return "// container-update-clear-prop: the checkbox's color prop is bound to a\n// brush atom — toggling clears it (a Nil brush fails the decode and the\n// prop resolves to absent) while the border stays.\nuse tur::{ BORDER_CENTER, box_border, box_color_bound, box_padding, box_radius, box_size, el_box_new, el_build, el_child, el_gesture, el_qkey, mount, rs_set_brush, rs_source_value, stf_put, stf_take };\n\nlet K_CHECKED: u64 = 1;\nlet K_COLOR: u64 = 2;\n\nentry fn start() -> u64 {\n    let checked = rs_source_value(rs_list_new());\n    let color = rs_source_value(rs_list_new());\n    stf_put(K_CHECKED, checked as f64);\n    stf_put(K_COLOR, color as f64);\n    rs_set_brush(color, 0x22C35EFFu64);\n\n    let outer = el_box_new();\n    box_size(outer, 200.0, 100.0);\n    box_padding(outer, 20.0);\n\n    let checkbox = el_box_new();\n    box_size(checkbox, 40.0, 40.0);\n    box_radius(checkbox, 8.0);\n    box_color_bound(checkbox, color);\n    box_border(checkbox, 0xE2E8F0FFu64, 2.0, BORDER_CENTER);\n    el_qkey(checkbox, \"checkbox\");\n    el_child(outer, el_gesture(checked, \"b_toggle\", \"\", \"\", \"\", \"\", el_build(checkbox)));\n\n    mount(el_build(outer));\n    return checked;\n}\n\nentry fn b_toggle(_a: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    // Uncheck: clear the color (the brush atom gets Nil).\n    let color = stf_take(K_COLOR) as u64;\n    rs_set_brush(color, 0);\n    stf_put(K_COLOR, color as f64);\n}\n";
    }
    if (name == "countdown") {
        return "// countdown: a 1 Hz countdown with start/pause/reset, an edit modal (a\n// pre-filled Input + confirm), and a ticking display derived from the\n// remaining atom. The ticker is an async loop over `sleep(1000)` with a\n// generation guard (a stale loop exits when a new start supersedes it).\n// State atom ids ride the scalar stash (stf_*).\nuse core::RunContext;\nuse async_host::{ launch_future, sleep };\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, MAIN_ALIGN_CENTER, box_align, box_color, box_padding, box_radius, box_size, el_box_new, el_build, el_child, el_column, el_input, el_pi, el_qkey, el_row, el_text_bound_d, el_text_new, el_vqkey, flex_cross_align, flex_main_align, mem_get, mem_new, mem_set, mount, condition, rs_derive, rs_get_bool, rs_get_f64, rs_set_bool, rs_set_f64, rs_source_bool, rs_source_f64, str_parse_f64, st_put, st_take, stf_put, stf_take, tctrl_new, tctrl_set_text, tctrl_text, undo_new };\n\nlet K_GEN: u64 = 1;\nlet K_CTRL: u64 = 2;\nlet K_REMAINING: u64 = 3;\nlet K_INITIAL: u64 = 4;\nlet K_RUNNING: u64 = 5;\nlet K_EDITING: u64 = 6;\n\nentry fn start() -> u64 {\n    let remaining = rs_source_f64();\n    rs_set_f64(remaining, 60.0);\n    let initial = rs_source_f64();\n    rs_set_f64(initial, 60.0);\n    let running = rs_source_bool(false);\n    let editing = rs_source_bool(false);\n    stf_put(K_REMAINING, remaining as f64);\n    stf_put(K_INITIAL, initial as f64);\n    stf_put(K_RUNNING, running as f64);\n    stf_put(K_EDITING, editing as f64);\n    st_put(K_GEN, mem_new(0.0));\n\n    let display = rs_derive(\"fmt_display\", remaining);\n\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_CENTER);\n\n    let display_t = el_vqkey(el_text_bound_d(display), \"display\");\n    el_child(col, display_t);\n\n    let row = el_row();\n    flex_main_align(row, MAIN_ALIGN_CENTER);\n    el_child(row, button(\"btn-start\", \"Start\", \"b_start\", running, running));\n    el_child(row, button(\"btn-pause\", \"Pause\", \"b_pause\", running, running));\n    el_child(row, button(\"btn-reset\", \"Reset\", \"b_reset\", initial, remaining));\n    el_child(row, button(\"btn-edit\", \"Edit\", \"b_edit\", initial, editing));\n    el_child(col, el_build(row));\n\n    // The edit modal overlay (both branches authored at start).\n    let modal = build_modal(initial, remaining);\n    let empty = el_box_new();\n    el_child(col, condition(editing, modal, el_build(empty)));\n\n    mount(el_build(col));\n    return remaining;\n}\n\n// A pill button with a query key; both atoms cross to the entry.\nfn button(key: str, label: str, cb: str, a: u64, b: u64) -> opaque {\n    let bld = el_box_new();\n    box_size(bld, 90.0, 40.0);\n    box_color(bld, 0x6366F1FF);\n    box_align(bld, ALIGN_CENTER);\n    box_radius(bld, 8.0);\n    el_qkey(bld, key);\n    el_child(bld, el_build(el_text_new(label)));\n    return el_pi(a, b, cb, \"\", 0, \"\", el_build(bld));\n}\n\n// The edit modal: a centered card with a pre-filled Input + confirm.\nfn build_modal(initial: u64, remaining: u64) -> opaque {\n    let ctrl = tctrl_new();\n    tctrl_set_text(ctrl, f\"{rs_get_f64(initial) as u64}\");\n    st_put(K_CTRL, ctrl);\n\n    let card = el_box_new();\n    box_size(card, 240.0, 140.0);\n    box_color(card, 0xFFFFFFFFu64);\n    box_radius(card, 12.0);\n    box_padding(card, 16.0);\n    box_align(card, ALIGN_CENTER);\n\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_CENTER);\n    el_child(col, el_build(el_text_new(\"Set seconds\")));\n    let undo = undo_new();\n    let input = el_input(ctrl, undo, \"seconds\", 180.0, 32.0);\n    el_child(col, el_vqkey(input, \"edit-input\"));\n    el_child(col, button(\"btn-confirm\", \"Confirm\", \"b_confirm\", initial, remaining));\n    el_child(card, el_build(col));\n    return el_build(card);\n}\n\n// \"m:ss\" display format.\nentry fn fmt_display(v: f64) -> str {\n    let total = v as u64;\n    let m = total / 60;\n    let s = total % 60;\n    if (s < 10) {\n        return f\"{m}:0{s}\";\n    }\n    return f\"{m}:{s}\";\n}\n\n// The 1 Hz ticker. `g` pins the generation: a stale loop (superseded by a\n// later start / pause) exits without ticking.\nasync fn ticker(cx: RunContext, g: f64) -> str {\n    let running = stf_take(K_RUNNING) as u64;\n    while (rs_get_bool(running)) {\n        await sleep(1000);\n        if (gen_read() != g) {\n            stf_put(K_RUNNING, running as f64);\n            return \"\";\n        }\n        if (!rs_get_bool(running)) {\n            stf_put(K_RUNNING, running as f64);\n            return \"\";\n        }\n        let remaining = stf_take(K_REMAINING) as u64;\n        let r = rs_get_f64(remaining);\n        if (r <= 1.0) {\n            rs_set_f64(remaining, 0.0);\n            rs_set_bool(running, false);\n            stf_put(K_REMAINING, remaining as f64);\n            stf_put(K_RUNNING, running as f64);\n            return \"\";\n        }\n        rs_set_f64(remaining, r - 1.0);\n        stf_put(K_REMAINING, remaining as f64);\n    }\n    stf_put(K_RUNNING, running as f64);\n    return \"\";\n}\n\nfn gen_read() -> f64 {\n    let cell = st_take(K_GEN);\n    let v = mem_get(cell);\n    st_put(K_GEN, cell);\n    return v;\n}\n\nfn gen_bump() -> f64 {\n    let cell = st_take(K_GEN);\n    let g = mem_get(cell) + 1.0;\n    mem_set(cell, g);\n    st_put(K_GEN, cell);\n    return g;\n}\n\nentry fn b_start(_running: u64, _b: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    if (rs_get_bool(running)) {\n        stf_put(K_RUNNING, running as f64);\n        return;\n    }\n    rs_set_bool(running, true);\n    stf_put(K_RUNNING, running as f64);\n    launch_future(ticker(gen_bump()));\n}\n\nentry fn b_pause(_running: u64, _b: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n}\n\nentry fn b_reset(initial: u64, remaining: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n    rs_set_f64(remaining, rs_get_f64(initial));\n}\n\nentry fn b_edit(initial: u64, editing: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n    // (Re-)seed the modal controller with the current initial value.\n    let ctrl = st_take(K_CTRL);\n    tctrl_set_text(ctrl, f\"{rs_get_f64(initial) as u64}\");\n    st_put(K_CTRL, ctrl);\n    rs_set_bool(editing, true);\n}\n\nentry fn b_confirm(initial: u64, remaining: u64, _n: f64) {\n    let ctrl = st_take(K_CTRL);\n    let v = str_parse_f64(tctrl_text(ctrl));\n    rs_set_f64(initial, v);\n    rs_set_f64(remaining, v);\n    let editing = stf_take(K_EDITING) as u64;\n    rs_set_bool(editing, false);\n    stf_put(K_EDITING, editing as f64);\n}\n";
    }
    if (name == "counter") {
        return "// counter: a reactive count label between -/+ pill buttons — the full\n// interactive loop (button → intent entry → atom write → re-render).\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, el_box_new, box_align, box_color, box_padding, box_size, el_build, el_child, el_column, el_pi, el_qkey, el_row, el_text_bound_new, el_text_new, flex_cross_align, text_size, mount, rs_get_f64, rs_set_f64, rs_set_str, rs_source_f64, rs_source_str };\n\nentry fn start() -> u64 {\n    let count = rs_source_f64();\n    let label = rs_source_str(\"Count: 0\");\n\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_CENTER);\n    let ctext = el_text_bound_new(label);\n    el_qkey(ctext, \"count\");\n    text_size(ctext, 36.0);\n    el_child(col, el_build(ctext));\n\n    let row = el_row();\n    flex_cross_align(row, CROSS_ALIGN_CENTER);\n    let pad = rs_source_f64();\n    el_child(row, button(count, label, \"ts_dec\", \"-1\", \"dec\"));\n    el_child(row, gap());\n    el_child(row, button(count, label, \"ts_inc\", \"+1\", \"inc\"));\n    el_child(col, el_build(row));\n\n    let bg = el_box_new();\n    box_color(bg, 0xF8FAFCFFu64);\n    el_child(bg, el_build(col));\n    mount(el_build(bg));\n    return count;\n}\n\n// A 100x44 indigo pill with a centered label.\nfn button(count: u64, label: u64, cb: str, text: str, key: str) -> opaque {\n    let b = el_box_new();\n    box_size(b, 100.0, 44.0);\n    box_color(b, 0x6366F1FFu64);\n    box_align(b, ALIGN_CENTER);\n    el_qkey(b, key);\n    let t = el_text_new(text);\n    text_size(t, 18.0);\n    el_child(b, el_build(t));\n    return el_pi(count, label, cb, \"\", 0, \"\", el_build(b));\n}\n\nfn gap() -> opaque {\n    let b = el_box_new();\n    box_size(b, 12.0, 0.0);\n    return el_build(b);\n}\n\nfn refresh(count: u64, label: u64) {\n    rs_set_str(label, f\"Count: {rs_get_f64(count) as u64}\");\n}\n\nentry fn ts_inc(count: u64, label: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n    refresh(count, label);\n}\n\nentry fn ts_dec(count: u64, label: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) - 1.0);\n    refresh(count, label);\n}\n";
    }
    if (name == "drag-delta-tracking") {
        return "// drag-delta-tracking: a drag pad computing deltaFromStart/deltaFromLast\n// (the VDivider pattern). Scratch numbers ride stashed mem cells; the\n// transcript atom renders \"dsx,dsy,dlx,dly\" for the test to parse.\nuse tur::{ el_box_new, box_color, box_size, el_build, el_gesture, el_qkey, el_text_bound_new, mem_get, mem_new, mem_set, mount, rs_set_str, rs_source_f64, rs_source_str, st_put, st_take };\n\nlet K_SX: u64 = 2;\nlet K_SY: u64 = 3;\nlet K_LX: u64 = 4;\nlet K_LY: u64 = 5;\n\nentry fn start() -> u64 {\n    let info = rs_source_str(\"0,0,0,0\");\n    st_put(K_SX, mem_new(0.0));\n    st_put(K_SY, mem_new(0.0));\n    st_put(K_LX, mem_new(0.0));\n    st_put(K_LY, mem_new(0.0));\n\n    let b = el_box_new();\n    box_size(b, 200.0, 200.0);\n    box_color(b, 0x6366F1FF);\n    el_qkey(b, \"drag-target\");\n    let info_t = el_text_bound_new(info);\n    el_qkey(info_t, \"drag-info\");\n    el_child(b, el_build(info_t));\n\n    let pad = el_gesture(info, \"\", \"g_down\", \"g_move\", \"g_up\", \"\", el_build(b));\n    mount(pad);\n    return info;\n}\n\n// From-start + from-last deltas, read BEFORE the last-point update.\nfn emit(id: u64, gx: f64, gy: f64) {\n    let sx = st_take(K_SX);\n    let sy = st_take(K_SY);\n    let lx = st_take(K_LX);\n    let ly = st_take(K_LY);\n    let dsx = gx - mem_get(sx);\n    let dsy = gy - mem_get(sy);\n    let dlx = gx - mem_get(lx);\n    let dly = gy - mem_get(ly);\n    rs_set_str(id, f\"{dsx},{dsy},{dlx},{dly}\");\n    st_put(K_SX, sx);\n    st_put(K_SY, sy);\n    st_put(K_LX, lx);\n    st_put(K_LY, ly);\n}\n\nentry fn g_down(id: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    let sx = st_take(K_SX);\n    let sy = st_take(K_SY);\n    mem_set(sx, gx);\n    mem_set(sy, gy);\n    st_put(K_SX, sx);\n    st_put(K_SY, sy);\n    move_last(gx, gy);\n    emit(id, gx, gy);\n}\n\nentry fn g_move(id: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    emit(id, gx, gy);\n    move_last(gx, gy);\n}\n\n// The test's explicit reset probe (the `__resetDrag` seam): clear the\n// drag tracking so post-release hover-moves produce no deltas.\nentry fn reset(id: u64, _b: f64) {\n    let sx = st_take(K_SX);\n    let sy = st_take(K_SY);\n    let lx = st_take(K_LX);\n    let ly = st_take(K_LY);\n    mem_set(sx, 0.0);\n    mem_set(sy, 0.0);\n    mem_set(lx, 0.0);\n    mem_set(ly, 0.0);\n    st_put(K_SX, sx);\n    st_put(K_SY, sy);\n    st_put(K_LX, lx);\n    st_put(K_LY, ly);\n    rs_set_str(id, \"0,0,0,0\");\n}\n\nfn move_last(gx: f64, gy: f64) {\n    let lx = st_take(K_LX);\n    let ly = st_take(K_LY);\n    mem_set(lx, gx);\n    mem_set(ly, gy);\n    st_put(K_LX, lx);\n    st_put(K_LY, ly);\n}\n";
    }
    if (name == "drag-over-text") {
        return "// drag-over-text: a Positioned -> Transform -> PointerInteract -> Text\n// piece — a non-selectable Text must not steal touch drags from the\n// PointerInteract beneath. The down count renders into `down-count`.\nuse tur::{ ALIGN_TOP_LEFT, el_box_new, box_size, el_build, el_child, el_gesture, el_qkey, el_sizedbox, el_stack, el_text_bound_new, el_text_new, el_transform, mount, mem_get, mem_new, mem_set, rs_set_str, rs_source_str, stack_align, st_put, st_take, stf_put, stf_take, text_size };\n\nlet K_COUNT: u64 = 1;\nlet K_PHASE: u64 = 2;\n\nentry fn start() -> u64 {\n    let count = rs_source_str(\"0\");\n    st_put(K_COUNT, mem_new(0.0));\n    let phase = rs_source_str(\"\");\n    stf_put(K_PHASE, phase as f64);\n\n    let stack = el_stack();\n    stack_align(stack, ALIGN_TOP_LEFT);\n    el_child(stack, el_sizedbox(400.0, 400.0, el_build(el_box_new())));\n\n    let label = el_text_new(\"drag me\");\n    text_size(label, 14.0);\n    let piece = el_box_new();\n    box_size(piece, 80.0, 40.0);\n    el_qkey(piece, \"drag-target\");\n    el_child(piece, el_build(label));\n    let pad = el_gesture(count, \"\", \"g_down\", \"g_move\", \"g_up\", \"\", el_build(piece));\n    el_child(stack, el_transform(1.0, 0.0, 60.0, 50.0, pad));\n\n    let count_t = el_text_bound_new(count);\n    el_qkey(count_t, \"down-count\");\n    el_child(stack, el_build(count_t));\n    mount(el_build(stack));\n    return count;\n}\n\nentry fn g_down(count: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let cell = st_take(K_COUNT);\n    let n = mem_get(cell) + 1.0;\n    mem_set(cell, n);\n    st_put(K_COUNT, cell);\n    rs_set_str(count, f\"{n as u64}\");\n    let phase = stf_take(K_PHASE) as u64;\n    rs_set_str(phase, \"down\");\n    stf_put(K_PHASE, phase as f64);\n}\n\nentry fn g_move(_count: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let phase = stf_take(K_PHASE) as u64;\n    rs_set_str(phase, \"move\");\n    stf_put(K_PHASE, phase as f64);\n}\n\nentry fn g_up(_count: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let phase = stf_take(K_PHASE) as u64;\n    rs_set_str(phase, \"up\");\n    stf_put(K_PHASE, phase as f64);\n}\n";
    }
    if (name == "drag-redrag-multi") {
        return "// drag-redrag-multi: two tiles sharing one lift controller — the\n// multi-tile jigsaw repro. Per-tile event transcripts render into\n// `tile-events-0` / `tile-events-1`.\nuse tur::{ ALIGN_TOP_LEFT, anim_ctrl, anim_forward, anim_reverse, el_box_new, box_color, box_size, el_build, el_child, el_column, el_gesture2, el_pi, el_positioned, el_qkey, el_sizedbox, el_stack, el_text_bound_new, el_text_new, mount, rs_get_str, rs_set_str, rs_source_f64, rs_source_str, stack_align, st_put, st_take, stf_put, stf_take };\n\nlet K_CTRL: u64 = 1;\nlet K_T0: u64 = 2;\nlet K_T1: u64 = 3;\n\nentry fn start() -> u64 {\n    let lift = rs_source_f64();\n    let ctrl = anim_ctrl(lift, 180.0, \"linear\", 0, \"a_tick\", \"a_end\");\n    st_put(K_CTRL, ctrl);\n\n    let t0 = rs_source_str(\"\");\n    let t1 = rs_source_str(\"\");\n    stf_put(K_T0, t0 as f64);\n    stf_put(K_T1, t1 as f64);\n\n    let stack = el_stack();\n    stack_align(stack, ALIGN_TOP_LEFT);\n    el_child(stack, el_sizedbox(300.0, 200.0, el_build(el_box_new())));\n\n    // Tile 0 at (10, 10); tile 1 at (150, 100). The tile index rides the\n    // gesture's second id slot (100 + index).\n    let b0 = el_box_new();\n    box_size(b0, 100.0, 60.0);\n    box_color(b0, 0x6366F1FFu64);\n    el_qkey(b0, \"tile-0\");\n    el_child(stack, el_positioned(10.0, 10.0, el_gesture2(0, 100, \"g_down\", \"g_down\", \"g_move\", \"g_up\", \"\", el_build(b0))));\n    let b1 = el_box_new();\n    box_size(b1, 100.0, 60.0);\n    box_color(b1, 0x6366F1FFu64);\n    el_qkey(b1, \"tile-1\");\n    el_child(stack, el_positioned(150.0, 100.0, el_gesture2(1, 101, \"g_down\", \"g_down\", \"g_move\", \"g_up\", \"\", el_build(b1))));\n\n    // Transcript readouts.\n    let t0t = el_text_bound_new(t0);\n    el_qkey(t0t, \"tile-events-0\");\n    el_child(stack, el_build(t0t));\n    let t1t = el_text_bound_new(t1);\n    el_qkey(t1t, \"tile-events-1\");\n    el_child(stack, el_build(t1t));\n\n    mount(el_build(stack));\n    return lift;\n}\n\nentry fn a_tick(_atom: u64, _t: f64) {\n}\n\nentry fn a_end(_atom: u64, _v: f64) {\n}\n\n// The `__resetDrag` seam.\nentry fn reset(_a: u64, _b: f64) {\n    let t0 = stf_take(K_T0) as u64;\n    let t1 = stf_take(K_T1) as u64;\n    rs_set_str(t0, \"\");\n    rs_set_str(t1, \"\");\n    stf_put(K_T0, t0 as f64);\n    stf_put(K_T1, t1 as f64);\n}\n\nfn say(idx: u64, line: str) {\n    // K_T0=2, K_T1=3 — the tile index selects the transcript slot. The\n    // transcript ACCUMULATES (the test checks down+move are present).\n    let key = K_T0 + idx;\n    let t = stf_take(key) as u64;\n    rs_set_str(t, f\"{rs_get_str(t)} {line}\");\n    stf_put(key, t as f64);\n}\n\nentry fn g_down(idx: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let ctrl = st_take(K_CTRL);\n    anim_forward(ctrl);\n    st_put(K_CTRL, ctrl);\n    say(idx, \"down\");\n}\n\nentry fn g_move(idx: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    say(idx, \"move\");\n}\n\nentry fn g_up(idx: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let ctrl = st_take(K_CTRL);\n    anim_reverse(ctrl);\n    st_put(K_CTRL, ctrl);\n    say(idx, \"up\");\n}\n";
    }
    if (name == "drag-with-lift") {
        return "// drag-with-lift: the jigsaw piece mechanic — pointer-down drives a lift\n// animation (forward on down, reverse on up). The last gesture phase\n// renders into the `last-event` Text.\nuse tur::{ anim_ctrl, anim_forward, anim_reverse, el_box_new, box_size, el_build, el_child, el_gesture, el_qkey, el_text_new, el_vqkey, mount, rs_set_str, rs_source_f64, rs_source_str, st_put, st_take, stf_put, stf_take };\n\nlet K_PHASE: u64 = 1;\nlet K_CTRL: u64 = 2;\n\nentry fn start() -> u64 {\n    let phase = rs_source_str(\"\");\n    stf_put(K_PHASE, phase as f64);\n    let lift = rs_source_f64();\n    let ctrl = anim_ctrl(lift, 180.0, \"linear\", 0, \"a_tick\", \"a_end\");\n    st_put(K_CTRL, ctrl);\n\n    let b = el_box_new();\n    box_size(b, 80.0, 40.0);\n    el_qkey(b, \"lift-target\");\n    el_child(b, el_build(el_text_new(\"piece\")));\n    let pad = el_gesture(phase, \"\", \"g_down\", \"g_move\", \"g_up\", \"\", el_build(b));\n\n    let phase_t = el_vqkey(el_text_bound(phase), \"last-event\");\n    let root = el_column();\n    el_child(root, pad);\n    el_child(root, phase_t);\n    mount(el_build(root));\n    return phase;\n}\n\nentry fn a_tick(_atom: u64, _t: f64) {\n}\n\nentry fn a_end(_atom: u64, _v: f64) {\n}\n\n// The `__resetDrag` seam (the lift keeps settling; only the transcript clears).\nentry fn reset(_a: u64, _b: f64) {\n    let phase = stf_take(K_PHASE) as u64;\n    rs_set_str(phase, \"\");\n    stf_put(K_PHASE, phase as f64);\n}\n\nentry fn g_down(phase: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let ctrl = st_take(K_CTRL);\n    anim_forward(ctrl);\n    st_put(K_CTRL, ctrl);\n    rs_set_str(phase, \"down\");\n}\n\nentry fn g_move(phase: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    rs_set_str(phase, \"move\");\n}\n\nentry fn g_up(phase: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let ctrl = st_take(K_CTRL);\n    anim_reverse(ctrl);\n    st_put(K_CTRL, ctrl);\n    rs_set_str(phase, \"up\");\n}\n";
    }
    if (name == "expanded-basic") {
        return "// expanded-basic: a fixed-height child plus an Expanded filling the\n// remaining main axis.\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_column, el_expand, flex_cross_align, mount };\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    el_child(col, box_wh(0.0, 50.0));\n    el_child(col, el_expand(1.0, box_wh(0.0, 0.0)));\n    mount(el_build(col));\n}\n";
    }
    if (name == "expanded-flex-weights") {
        return "// expanded-flex-weights: two Expanded children sharing the main axis 2:1.\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_column, el_expand, flex_cross_align, mount };\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    el_child(col, el_expand(2.0, box_wh(0.0, 0.0)));\n    el_child(col, el_expand(1.0, box_wh(0.0, 0.0)));\n    mount(el_build(col));\n}\n";
    }
    if (name == "expanded-multiple") {
        return "// expanded-multiple: two Expanded children sharing the main axis evenly.\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_column, el_expand, flex_cross_align, mount };\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    el_child(col, el_expand(1.0, box_wh(0.0, 0.0)));\n    el_child(col, el_expand(1.0, box_wh(0.0, 0.0)));\n    mount(el_build(col));\n}\n";
    }
    if (name == "flex-nested-sidebar") {
        return "// flex-nested-sidebar: a 200px sidebar Column beside a content Column in\n// a Row (the classic two-pane shape).\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_column, el_row, flex_cross_align, mount };\n\nentry fn start() {\n    let row = el_row();\n    let sidebar = el_box_new();\n    box_size(sidebar, 200.0, 0.0);\n    let scol = el_column();\n    flex_cross_align(scol, CROSS_ALIGN_START);\n    el_child(scol, box_wh(0.0, 40.0));\n    el_child(sidebar, el_build(scol));\n    el_child(row, el_build(sidebar));\n    let content = el_box_new();\n    let ccol = el_column();\n    flex_cross_align(ccol, CROSS_ALIGN_START);\n    el_child(ccol, box_wh(0.0, 30.0));\n    el_child(content, el_build(ccol));\n    el_child(row, el_build(content));\n    mount(el_build(row));\n}\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n";
    }
    if (name == "flex-row-cross-stretch") {
        return "// flex-row-cross-stretch: fixed-width children stretched to the row's\n// full cross axis (the viewport height).\nuse tur::{ CROSS_ALIGN_STRETCH, el_box_new, box_size, el_build, el_child, el_row, flex_cross_align, mount };\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let row = el_row();\n    flex_cross_align(row, CROSS_ALIGN_STRETCH);\n    el_child(row, box_wh(50.0, 0.0));\n    el_child(row, box_wh(30.0, 0.0));\n    mount(el_build(row));\n}\n";
    }
    if (name == "flex-row-expanded") {
        return "// flex-row-expanded: a fixed-width child plus an Expanded filling the\n// remaining main axis.\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_expand, el_row, flex_cross_align, mount };\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let row = el_row();\n    flex_cross_align(row, CROSS_ALIGN_START);\n    el_child(row, box_wh(50.0, 0.0));\n    el_child(row, el_expand(1.0, box_wh(0.0, 0.0)));\n    mount(el_build(row));\n}\n";
    }
    if (name == "flex-row-main-center") {
        return "// flex-row-main-center: two fixed-width children centered on the main axis.\nuse tur::{ CROSS_ALIGN_START, MAIN_ALIGN_CENTER, el_box_new, box_size, el_build, el_child, el_row, flex_cross_align, flex_main_align, mount };\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let row = el_row();\n    flex_main_align(row, MAIN_ALIGN_CENTER);\n    flex_cross_align(row, CROSS_ALIGN_START);\n    el_child(row, box_wh(50.0, 0.0));\n    el_child(row, box_wh(30.0, 0.0));\n    mount(el_build(row));\n}\n";
    }
    if (name == "flex-row-main-end") {
        return "// flex-row-main-end: two fixed-width children pinned to the main-axis end.\nuse tur::{ CROSS_ALIGN_START, MAIN_ALIGN_END, el_box_new, box_size, el_build, el_child, el_row, flex_cross_align, flex_main_align, mount };\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let row = el_row();\n    flex_main_align(row, MAIN_ALIGN_END);\n    flex_cross_align(row, CROSS_ALIGN_START);\n    el_child(row, box_wh(50.0, 0.0));\n    el_child(row, box_wh(30.0, 0.0));\n    mount(el_build(row));\n}\n";
    }
    if (name == "flex-todolist-sidebar") {
        return "// flex-todolist-sidebar: the todolist two-pane shell — a 200px tab\n// sidebar beside a padded content column.\nuse tur::{ CROSS_ALIGN_CENTER, MAIN_ALIGN_SPACE_BETWEEN, el_box_new, box_align, box_color, box_padding, box_size, el_build, el_child, el_column, el_row, el_text_new, flex_cross_align, flex_main_align, text_size, mount };\n\nentry fn start() {\n    let row = el_row();\n    // Sidebar: one active tab pill.\n    let sidebar = el_box_new();\n    box_color(sidebar, 0x1A1A2EFF);\n    box_size(sidebar, 200.0, 0.0);\n    let tabs = el_column();\n    let tab = el_box_new();\n    box_color(tab, 0x0F3460FF);\n    box_padding(tab, 12.0);\n    let label = el_text_new(\"TodoList\");\n    text_size(label, 14.0);\n    el_child(tab, el_build(label));\n    el_child(tabs, el_build(tab));\n    el_child(sidebar, el_build(tabs));\n    el_child(row, el_build(sidebar));\n    // Content: heading + list shell.\n    let content = el_box_new();\n    box_padding(content, 16.0);\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_CENTER);\n    let heading = el_text_new(\"Todo List\");\n    text_size(heading, 24.0);\n    el_child(col, el_build(heading));\n    el_child(col, box_h(16.0));\n    let list = el_column();\n    let item = el_row();\n    flex_main_align(item, MAIN_ALIGN_SPACE_BETWEEN);\n    el_child(item, el_build(el_text_new(\"Buy milk\")));\n    el_child(list, el_build(item));\n    el_child(col, el_build(list));\n    el_child(content, el_build(col));\n    el_child(row, el_build(content));\n    mount(el_build(row));\n}\n\nfn box_h(h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, h);\n    return el_build(b);\n}\n";
    }
    if (name == "focus-clear-on-click") {
        return "// focus-clear-on-click: a focused Input above a PointerInteract button —\n// clicking the button clears focus (the gesture handler's outside-click\n// path).\nuse tur::{ el_build, el_child, el_column, el_input, el_pi, el_qkey, el_text_bound_new, el_vqkey, mount, rs_get_f64, rs_set_f64, rs_source_f64, tctrl_new, undo_new };\n\nentry fn start() -> u64 {\n    let clicks = rs_source_f64();\n    let label = rs_source_str(\"clicks: 0\");\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n\n    let col = el_column();\n    let input = el_input(ctrl, undo, \"\", 200.0, 30.0);\n    el_child(col, el_vqkey(input, \"editable\"));\n    let t = el_text_bound_new(label);\n    el_qkey(t, \"button\");\n    el_child(col, el_pi(clicks, label, \"b_click\", \"\", 0, \"\", el_build(t)));\n    mount(el_build(col));\n    return clicks;\n}\n\nentry fn b_click(clicks: u64, label: u64, _n: f64) {\n    rs_set_f64(clicks, rs_get_f64(clicks) + 1.0);\n    rs_set_str(label, f\"clicks: {rs_get_f64(clicks) as u64}\");\n}\n";
    }
    if (name == "four-color-quadrants") {
        return "// four-color-quadrants: a 2x2 grid of 100x100 colored quadrants (Stack +\n// positioned fills) — the vello render fixtures sample exact pixels.\nuse tur::{ el_box_new, box_color, box_size, el_build, el_child, el_positioned, el_stack, mount };\n\nfn quad(color: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 100.0, 100.0);\n    box_color(b, color);\n    return el_build(b);\n}\n\nentry fn start() {\n    let stack = el_stack();\n    el_child(stack, el_positioned(0.0, 0.0, quad(0xFF0000FFu64)));\n    el_child(stack, el_positioned(100.0, 0.0, quad(0x00FF00FFu64)));\n    el_child(stack, el_positioned(0.0, 100.0, quad(0x0000FFFFu64)));\n    el_child(stack, el_positioned(100.0, 100.0, quad(0xFFFF00FFu64)));\n    mount(el_build(stack));\n}\n";
    }
    if (name == "grid-aspect") {
        return "// grid-aspect: aspect-ratio tiles in a grid row (square tiles via equal\n// width/height).\nuse tur::{ el_box_new, box_color, box_size, el_build, el_child, el_row, el_sizedbox, el_text_new, mount, text_size };\n\nentry fn tile(label: str, color: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 100.0, 100.0);\n    box_color(b, color);\n    let t = el_text_new(label);\n    text_size(t, 14.0);\n    el_child(b, el_build(t));\n    return el_build(b);\n}\n\nentry fn start() {\n    let row = el_row();\n    el_child(row, tile(\"A\", 0xEF4444FFu64));\n    el_child(row, tile(\"B\", 0x22C55EFFu64));\n    el_child(row, tile(\"C\", 0x3B82F6FFu64));\n    mount(el_sizedbox(400.0, 200.0, el_build(row)));\n}\n";
    }
    if (name == "grid-basic") {
        return "// grid-basic: a small static grid of tiles (Row/Column composition).\nuse tur::{ el_box_new, box_color, box_size, el_build, el_child, el_column, el_row, el_sizedbox, mount };\n\nentry fn tile(color: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 80.0, 80.0);\n    box_color(b, color);\n    return el_build(b);\n}\n\nentry fn start() {\n    let col = el_column();\n    let r0 = el_row();\n    el_child(r0, tile(0xEF4444FFu64));\n    el_child(r0, tile(0x22C55EFFu64));\n    let r1 = el_row();\n    el_child(r1, tile(0x3B82F6FFu64));\n    el_child(r1, tile(0xEAB308FFu64));\n    el_child(col, r0);\n    el_child(col, r1);\n    mount(el_sizedbox(200.0, 200.0, el_build(col)));\n}\n";
    }
    if (name == "grid-gallery") {
        return "// grid-gallery: a header + scrollable tile grid (the hover-cursor demo\n// surface).\nuse tur::{ CURSOR_POINTER, CROSS_ALIGN_CENTER, el_box_new, box_color, box_size, el_build, el_child, el_column, el_expand, el_mouse_region, el_sizedbox, el_text_new, flex_cross_align, mount, text_size };\n\nentry fn tile(i: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 100.0, 100.0);\n    box_color(b, 0x1E293BFF);\n    let label = el_text_new(f\"tile {i}\");\n    text_size(label, 12.0);\n    el_child(b, el_build(label));\n    return el_mouse_region(i, \"\", \"\", CURSOR_POINTER, 0, el_build(b));\n}\n\nentry fn start() {\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_CENTER);\n    let row = el_row();\n    el_child(row, tile(0));\n    el_child(row, tile(1));\n    el_child(row, tile(2));\n    el_child(col, el_sizedbox(400.0, 40.0, el_build(el_box_new())));\n    el_child(col, row);\n    mount(el_expand(1.0, el_build(col)));\n}\n";
    }
    if (name == "hit-test-opaqueness") {
        return "// hit-test-opaqueness: the absorption matrix — a colored Container\n// absorbs; a decoration-less Container passes through; an opaque\n// PointerInteract catches invisible hits; a translucent MouseRegion joins\n// the path without blocking. The beneath-target's down count renders into\n// the `beneath-downs` Text (the test parses it).\nuse tur::{ ALIGN_TOP_LEFT, CURSOR_AUTO, el_box_new, box_color, box_size, el_build, el_child, el_gesture, el_mouse_region, el_pi, el_positioned_full, el_qkey, el_sizedbox, el_stack, el_text_bound_new, el_vqkey, mem_get, mem_new, mem_set, mount, rs_set_str, rs_source_str, stack_align, st_put, st_take };\n\nlet K_COUNT: u64 = 7;\n\nentry fn start() -> u64 {\n    let downs = rs_source_str(\"0\");\n    st_put(K_COUNT, mem_new(0.0));\n\n    let stack = el_stack();\n    stack_align(stack, ALIGN_TOP_LEFT);\n\n    // The opaque gesture target beneath (fills the 400x600 stack).\n    let target = el_box_new();\n    box_size(target, 400.0, 600.0);\n    let downs_t = el_text_bound_new(downs);\n    el_qkey(downs_t, \"beneath-downs\");\n    el_child(target, el_build(downs_t));\n    el_child(stack, el_gesture(downs, \"\", \"g_down\", \"\", \"\", \"\", el_build(target)));\n\n    // A decoration-less full-size Container — transparent.\n    let plain = el_box_new();\n    box_size(plain, 400.0, 600.0);\n    el_qkey(plain, \"plain\");\n    el_child(stack, el_build(plain));\n\n    // A painted red 200x200 surface at the top-left — absorbs.\n    let red = el_box_new();\n    box_size(red, 200.0, 200.0);\n    box_color(red, 0xEF4444FFu64);\n    el_qkey(red, \"red\");\n    el_child(stack, el_build(red));\n\n    // A translucent MouseRegion over the right half (x 200..400).\n    let region_child = el_vqkey(el_sizedbox(200.0, 600.0, el_build(el_box_new())), \"region\");\n    let region = el_mouse_region(downs, \"\", \"\", CURSOR_AUTO, 1, region_child);\n    el_child(stack, el_positioned_full(200.0, 0.0, 0.0, 0.0, 200.0, 600.0, region));\n\n    mount(el_build(stack));\n    return downs;\n}\n\nentry fn g_down(downs: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let cell = st_take(K_COUNT);\n    let n = mem_get(cell) + 1.0;\n    mem_set(cell, n);\n    st_put(K_COUNT, cell);\n    rs_set_str(downs, f\"{n as u64}\");\n}\n";
    }
    if (name == "hit-through-overlay") {
        return "// hit-through-overlay: the floating-pill pattern — a full-size invisible\n// overlay must not steal pointer/wheel input from the scrollable beneath;\n// the opaque anchored pill still consumes clicks. The counters render into\n// bound Texts (`beneath-downs` / `pill-clicks`).\nuse tur::{ CROSS_ALIGN_STRETCH, el_box_new, box_size, el_build, el_child, el_column, el_pi, el_positioned_edges, el_qkey, el_scroll, el_stack, el_text_bound_new, el_vqkey, flex_cross_align, mem_get, mem_new, mem_set, mount, rs_set_str, rs_source_str, st_put, st_take };\n\nlet K_DOWNS: u64 = 7;\nlet K_CLICKS: u64 = 8;\n\nentry fn start() -> u64 {\n    let downs = rs_source_str(\"0\");\n    let clicks = rs_source_str(\"0\");\n    st_put(K_DOWNS, mem_new(0.0));\n    st_put(K_CLICKS, mem_new(0.0));\n\n    let stack = el_stack();\n\n    // The scrollable beneath, wrapped in a gesture target so pointer\n    // events reaching THROUGH the overlay are observable.\n    let content = el_column();\n    flex_cross_align(content, CROSS_ALIGN_STRETCH);\n    el_child(content, box_h(300.0));\n    el_child(content, box_h(300.0));\n    el_child(content, box_h(300.0));\n    let scroller = el_vqkey(el_scroll(true, el_build(content)), \"sv\");\n    el_child(stack, el_pi(downs, downs, \"\", \"g_down\", 0, \"\", scroller));\n\n    // The invisible full-size overlay: no decoration, no gesture.\n    let overlay = el_box_new();\n    box_size(overlay, 400.0, 600.0);\n    el_qkey(overlay, \"overlay\");\n    el_child(stack, el_build(overlay));\n\n    // The floating pill, anchored bottom-right.\n    let pill_box = el_box_new();\n    box_size(pill_box, 64.0, 28.0);\n    el_qkey(pill_box, \"pill\");\n    let pill = el_pi(clicks, clicks, \"pill_click\", \"\", 0, \"\", el_build(pill_box));\n    el_child(stack, el_positioned_edges(0.0, 0.0, 8.0, 8.0, pill));\n\n    // Counter readouts (the test parses these).\n    let downs_t = el_text_bound_new(downs);\n    el_qkey(downs_t, \"beneath-downs\");\n    el_child(stack, el_build(downs_t));\n    let clicks_t = el_text_bound_new(clicks);\n    el_qkey(clicks_t, \"pill-clicks\");\n    el_child(stack, el_build(clicks_t));\n\n    mount(el_build(stack));\n    return downs;\n}\n\nentry fn g_down(downs: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let cell = st_take(K_DOWNS);\n    let n = mem_get(cell) + 1.0;\n    mem_set(cell, n);\n    st_put(K_DOWNS, cell);\n    rs_set_str(downs, f\"{n as u64}\");\n}\n\nentry fn pill_click(clicks: u64, _b: u64, _n: f64) {\n    let cell = st_take(K_CLICKS);\n    let n = mem_get(cell) + 1.0;\n    mem_set(cell, n);\n    st_put(K_CLICKS, cell);\n    rs_set_str(clicks, f\"{n as u64}\");\n}\n\nfn box_h(h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, h);\n    return el_build(b);\n}\n";
    }
    if (name == "image-basic") {
        return "// image-basic: a synthetic 1x1-ish RGBA resource in a fixed-size Image.\nuse tur::{ BOXFIT_FILL, el_box_new, box_size, el_build, el_child, el_image, img_res_solid, mount };\n\nentry fn start() {\n    let res = img_res_solid(1, 1, 0xFF6366F1u64);\n    let outer = el_box_new();\n    box_size(outer, 200.0, 100.0);\n    let img = el_image(res, 200.0, 100.0, BOXFIT_FILL);\n    el_child(outer, img);\n    mount(el_build(outer));\n}\n";
    }
    if (name == "implicit-animations") {
        return "// implicit-animations: animated style channels driven by one shared\n// controller (the Animated* twin) — the toggle flips the target and\n// restarts the controller (the ImplicitlyAnimatedWidget retarget).\nuse tur::{ anim_ctrl, anim_forward, anim_reverse, el_box_new, box_color, box_size, el_build, el_child, el_column, el_pi, el_qkey, el_text_new, mount, rs_get_bool, rs_set_bool, rs_source_bool, stf_put, stf_take };\n\nlet K_CTRL: u64 = 1;\nlet K_EXPANDED: u64 = 2;\n\nentry fn start() -> u64 {\n    let expanded = rs_source_bool(false);\n    stf_put(K_EXPANDED, expanded as f64);\n    let progress = rs_source_f64();\n    let ctrl = anim_ctrl(progress, 300.0, \"easeInOut\", 0, \"a_tick\", \"a_end\");\n    st_put(K_CTRL, ctrl);\n\n    let col = el_column();\n    let box_b = el_box_new();\n    box_size(box_b, 100.0, 40.0);\n    box_color(box_b, 0x6366F1FFu64);\n    el_qkey(box_b, \"animated-box\");\n    el_child(col, el_pi(expanded, expanded, \"b_toggle\", \"\", 0, \"\", el_build(box_b)));\n    el_child(col, el_build(el_text_new(\"toggle me\")));\n    mount(el_build(col));\n    return expanded;\n}\n\nentry fn a_tick(_atom: u64, _t: f64) {\n}\n\nentry fn a_end(_atom: u64, _v: f64) {\n}\n\nentry fn b_toggle(expanded: u64, _b: u64, _n: f64) {\n    rs_set_bool(expanded, !rs_get_bool(expanded));\n    // Retarget: reverse or forward the shared controller.\n    let ctrl = st_take(K_CTRL);\n    if (rs_get_bool(expanded)) {\n        anim_forward(ctrl);\n    } else {\n        anim_reverse(ctrl);\n    }\n    st_put(K_CTRL, ctrl);\n}\n";
    }
    if (name == "input-cursor-mid") {
        return "// input-cursor-mid: the same shape as input-typing (the cursor-mid-tick\n// seam is a no-op probe on the rut side too).\nuse tur::{ el_box_new, el_build, el_child, el_input, mount, tctrl_new, undo_new };\n\nentry fn start() {\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n    let outer = el_box_new();\n    el_child(outer, el_input(ctrl, undo, \"\", 200.0, 30.0));\n    mount(el_build(outer));\n}\n\n// The `__setCursorMidTick` seam's rut twin: a deliberate no-op.\nentry fn set_cursor_mid_tick(_a: u64, _b: f64) {\n}\n";
    }
    if (name == "input-multiline") {
        return "// input-multiline: a multiline editable with an explicit size.\nuse tur::{ el_box_new, el_build, el_child, el_input_opts, mount, tctrl_new, undo_new };\n\nentry fn start() {\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n    let outer = el_box_new();\n    el_child(outer, el_input_opts(ctrl, undo, \"\", 300.0, 400.0, 1));\n    mount(el_build(outer));\n}\n";
    }
    if (name == "input-typing") {
        return "// input-typing: an editable Input wired to a realm-minted controller.\nuse tur::{ el_box_new, el_build, el_child, el_input, mount, tctrl_new, undo_new };\n\nentry fn start() {\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n    let outer = el_box_new();\n    el_child(outer, el_input(ctrl, undo, \"\", 200.0, 30.0));\n    mount(el_build(outer));\n}\n";
    }
    if (name == "jigsaw-puzzle") {
        return "// jigsaw-puzzle: the drag-a-tile board (the regression fixture family the\n// drag-with-lift / drag-redrag-multi tests pin, as a playable board).\nuse tur::{ ALIGN_TOP_LEFT, el_box_new, box_color, box_size, el_build, el_child, el_gesture2, el_positioned, el_qkey, el_sizedbox, el_stack, el_text_new, mount, rs_set_f64, rs_source_f64, rs_source_str, stack_align, stf_put, stf_take };\n\nlet K_X: u64 = 1;\nlet K_Y: u64 = 2;\nlet K_PIECE: u64 = 3;\n\nentry fn start() -> u64 {\n    let x = rs_source_f64();\n    let y = rs_source_f64();\n    stf_put(K_X, x as f64);\n    stf_put(K_Y, y as f64);\n    let piece = rs_source_str(\"A\");\n    stf_put(K_PIECE, piece as f64);\n\n    let stack = el_stack();\n    stack_align(stack, ALIGN_TOP_LEFT);\n    el_child(stack, el_sizedbox(300.0, 300.0, el_build(el_box_new())));\n    let b = el_box_new();\n    box_size(b, 80.0, 80.0);\n    box_color(b, 0x6366F1FFu64);\n    el_qkey(b, \"piece\");\n    let label = el_text_new(\"A\");\n    el_child(b, el_build(label));\n    let pad = el_gesture2(piece, piece, \"g_down\", \"g_down\", \"g_move\", \"g_up\", \"\", el_build(b));\n    let pos = el_positioned(10.0, 10.0, pad);\n    el_child(stack, pos);\n    mount(el_build(stack));\n    return piece;\n}\n\nentry fn g_down(piece: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    rs_set_str(piece, \"dragging\");\n}\n\nentry fn g_move(piece: u64, _id: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    let x = stf_take(K_X) as u64;\n    let y = stf_take(K_Y) as u64;\n    rs_set_f64(x, gx - 40.0);\n    rs_set_f64(y, gy - 40.0);\n    stf_put(K_X, x as f64);\n    stf_put(K_Y, y as f64);\n}\n\nentry fn g_up(piece: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    rs_set_str(piece, \"A\");\n}\n";
    }
    if (name == "layout-invalidation-descendant-position") {
        return "// layout-invalidation-descendant-position: a reactive-width container\n// around an end-aligned Row holding a tracker box — the tracker's X must\n// track the width change through the intermediate Row (the divider-drag\n// position-gap repro). The `set_width` probe drives the change.\nuse tur::{ MAIN_ALIGN_END, el_box_new, box_color, box_size, box_width_bound, el_build, el_child, el_qkey, el_row, flex_main_align, mount, rs_set_f64, rs_source_f64, stf_put, stf_take };\n\nlet K_WIDTH: u64 = 1;\n\nentry fn start() -> u64 {\n    let width = rs_source_f64();\n    rs_set_f64(width, 100.0);\n    stf_put(K_WIDTH, width as f64);\n\n    let outer = el_box_new();\n    box_width_bound(outer, width);\n    let row = el_row();\n    flex_main_align(row, MAIN_ALIGN_END);\n    let tracker = el_box_new();\n    box_size(tracker, 20.0, 20.0);\n    box_color(tracker, 0x22C55EFFu64);\n    el_qkey(tracker, \"tracker\");\n    el_child(row, el_build(tracker));\n    el_child(outer, el_build(row));\n    mount(el_build(outer));\n    return width;\n}\n\n// The `__setWidth(w)` seam.\nentry fn set_width(a: u64, _b: f64) {\n    let width = stf_take(K_WIDTH) as u64;\n    rs_set_f64(width, a as f64);\n    stf_put(K_WIDTH, width as f64);\n}\n";
    }
    if (name == "layout-invalidation-reactive-flex") {
        return "// layout-invalidation-reactive-flex: two reactive flex weights — the\n// `set_flex` probe flips them (a click would mark extra nodes dirty via\n// the gesture handler and mask the layout-invalidation behavior).\nuse tur::{ el_box_new, box_color, box_size, el_build, el_child, el_expand_bound, el_row, el_qkey, mount, rs_set_f64, rs_source_f64, stf_put, stf_take };\n\nlet K_A: u64 = 1;\nlet K_B: u64 = 2;\n\nentry fn start() -> u64 {\n    let flex_a = rs_source_f64();\n    rs_set_f64(flex_a, 1.0);\n    let flex_b = rs_source_f64();\n    rs_set_f64(flex_b, 1.0);\n    stf_put(K_A, flex_a as f64);\n    stf_put(K_B, flex_b as f64);\n\n    let row = el_row();\n    let a = el_expand_bound(flex_a, qkey_box(\"a\", 0xEF4444FFu64));\n    el_child(row, a);\n    let b = el_expand_bound(flex_b, qkey_box(\"b\", 0x3B82F6FFu64));\n    el_child(row, b);\n    mount(el_build(row));\n    return flex_a;\n}\n\nfn qkey_box(key: str, color: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, 0.0);\n    box_color(b, color);\n    el_qkey(b, key);\n    return el_build(b);\n}\n\n// The `__setFlex(a, b)` seam: flip both weights (a crosses the u64 slot,\n// b the f64 slot).\nentry fn set_flex(a_new: u64, b_new: f64) {\n    let flex_a = stf_take(K_A) as u64;\n    let flex_b = stf_take(K_B) as u64;\n    rs_set_f64(flex_a, a_new as f64);\n    rs_set_f64(flex_b, b_new);\n    stf_put(K_A, flex_a as f64);\n    stf_put(K_B, flex_b as f64);\n}\n";
    }
    if (name == "lazy-grid-basic") {
        return "// lazy-grid-basic: a virtualized grid (max cross 150, square cells).\nuse tur::{ el_box_new, box_color, box_size, el_build, el_lazy_grid, el_vqkey, mount, rs_set_f64, rs_source_f64 };\n\nentry fn cell(i: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, 0.0);\n    if (i % 2 == 0) {\n        box_color(b, 0x303030FF);\n    } else {\n        box_color(b, 0x1A1A1AFF);\n    }\n    return el_build(b);\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 60.0);\n    let grid = el_lazy_grid(\"cell\", count, 150.0, 1.0);\n    mount(el_vqkey(grid, \"lazy-grid-basic\"));\n}\n";
    }
    if (name == "lazy-grid-gallery") {
        return "// lazy-grid-gallery: a header row above a virtualized gallery grid in a\n// column.\nuse tur::{ CROSS_ALIGN_CENTER, el_box_new, box_color, box_size, el_build, el_child, el_column, el_expand, el_lazy_grid, el_text_new, flex_cross_align, mount, rs_set_f64, rs_source_f64, text_size };\n\nentry fn cell(i: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, 0.0);\n    box_color(b, 0x1E293BFF);\n    let label = el_text_new(f\"tile {i}\");\n    text_size(label, 12.0);\n    el_child(b, el_build(label));\n    return el_build(b);\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 120.0);\n    let col = el_column();\n    let header = el_box_new();\n    box_size(header, 0.0, 40.0);\n    box_color(header, 0x0F172AFF);\n    let title = el_text_new(\"Gallery\");\n    text_size(title, 16.0);\n    el_child(header, el_build(title));\n    el_child(col, header);\n    let grid = el_lazy_grid(\"cell\", count, 150.0, 1.0);\n    el_child(col, el_expand(1.0, grid));\n    mount(el_build(col));\n}\n";
    }
    if (name == "lazy-grid-scroll") {
        return "// lazy-grid-scroll: a 600-cell grid — wheeling mounts rows outside the\n// initial build set.\nuse tur::{ el_box_new, box_color, box_size, el_build, el_lazy_grid, el_vqkey, mount, rs_set_f64, rs_source_f64 };\n\nentry fn cell(i: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, 0.0);\n    if (i % 2 == 0) {\n        box_color(b, 0x303030FF);\n    } else {\n        box_color(b, 0x1A1A1AFF);\n    }\n    return el_build(b);\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 600.0);\n    let grid = el_lazy_grid(\"cell\", count, 150.0, 1.0);\n    mount(el_vqkey(grid, \"lazy-grid-scroll\"));\n}\n";
    }
    if (name == "lazy-list-basic") {
        return "// lazy-list-basic: a 20-row virtualized vertical list (50px rows).\nuse tur::{ el_box_new, box_color, box_size, el_build, el_child, el_lazy_list, el_vqkey, mount, rs_set_f64, rs_source_f64 };\n\nentry fn row(i: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 400.0, 50.0);\n    if (i % 2 == 0) {\n        box_color(b, 0x303030FF);\n    } else {\n        box_color(b, 0x1A1A1AFF);\n    }\n    return el_build(b);\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 20.0);\n    let list = el_lazy_list(\"row\", count, 50.0);\n    mount(el_vqkey(list, \"lazy-list-basic\"));\n}\n";
    }
    if (name == "lazy-list-row") {
        return "// lazy-list-row: a 50-item HORIZONTAL virtualized list (80px columns).\nuse tur::{ el_box_new, box_color, box_size, el_build, el_lazy_list_h, el_vqkey, mount, rs_set_f64, rs_source_f64 };\n\nentry fn item(i: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 80.0, 300.0);\n    if (i % 2 == 0) {\n        box_color(b, 0x303030FF);\n    } else {\n        box_color(b, 0x1A1A1AFF);\n    }\n    return el_build(b);\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 50.0);\n    let list = el_lazy_list_h(\"item\", count, 80.0);\n    mount(el_vqkey(list, \"lazy-list-row\"));\n}\n";
    }
    if (name == "lazy-list-scroll") {
        return "// lazy-list-scroll: a 100-row virtualized list (wheeling mounts rows\n// outside the initial build set).\nuse tur::{ el_box_new, box_color, box_size, el_build, el_lazy_list, el_vqkey, mount, rs_set_f64, rs_source_f64 };\n\nentry fn row(i: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 400.0, 50.0);\n    if (i % 2 == 0) {\n        box_color(b, 0x303030FF);\n    } else {\n        box_color(b, 0x1A1A1AFF);\n    }\n    return el_build(b);\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 100.0);\n    let list = el_lazy_list(\"row\", count, 50.0);\n    mount(el_vqkey(list, \"lazy-list-scroll\"));\n}\n";
    }
    if (name == "lazy-list-var-sizes") {
        return "// lazy-list-var-sizes: an unmeasured (var-extent) LazyList — rows report\n// their own heights (deterministic per-index sizes).\nuse tur::{ el_box_new, box_color, box_size, el_build, el_child, el_lazy_list, el_text_new, el_vqkey, mount, rs_set_f64, rs_source_f64, text_size };\n\nentry fn row(i: u64) -> opaque {\n    let h = 30.0 + (i * 37) % 120;\n    let b = el_box_new();\n    box_size(b, 400.0, h);\n    box_color(b, 0x0B1220FF);\n    let label = el_text_new(f\"#{i} h={h as u64}\");\n    text_size(label, 11.0);\n    el_child(b, el_build(label));\n    return el_build(b);\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 500.0);\n    // itemExtent 0 = unmeasured (var sizes).\n    let list = el_lazy_list(\"row\", count, 0.0);\n    mount(el_vqkey(list, \"lazy-list-var-sizes\"));\n}\n";
    }
    if (name == "lazy-list-virtualized") {
        return "// lazy-list-virtualized: a 2000-row list — only the visible window mounts.\nuse tur::{ el_box_new, box_color, box_size, el_build, el_child, el_expand, el_lazy_list, el_text_new, mount, rs_set_f64, rs_source_f64, text_size };\n\nentry fn row(i: u64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 400.0, 40.0);\n    box_color(b, 0x0F172AFF);\n    let label = el_text_new(f\"row {i}\");\n    text_size(label, 12.0);\n    el_child(b, el_build(label));\n    return el_build(b);\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 2000.0);\n    let list = el_lazy_list(\"row\", count, 40.0);\n    mount(el_expand(1.0, list));\n}\n";
    }
    if (name == "mouse-region-cursor") {
        return "// mouse-region-cursor: a MouseRegion whose cursor + enter/exit drive the\n// shell cursor and the bound state label.\nuse tur::{ CURSOR_COL_RESIZE, el_box_new, box_size, el_build, el_child, el_column, el_mouse_region, el_qkey, el_text_bound_new, mount, rs_set_str, rs_source_str };\n\nentry fn start() -> u64 {\n    let state = rs_source_str(\"\");\n    let col = el_column();\n    let b = el_box_new();\n    box_size(b, 100.0, 50.0);\n    let t = el_text_bound_new(state);\n    el_qkey(t, \"mr-state\");\n    el_child(b, el_build(t));\n    el_child(col, el_mouse_region(state, \"mr_enter\", \"mr_exit\", CURSOR_COL_RESIZE, 0, el_build(b)));\n    mount(el_build(col));\n    return state;\n}\n\nentry fn mr_enter(state: u64, _b: u64, _n: f64) {\n    rs_set_str(state, \"entered\");\n}\n\nentry fn mr_exit(state: u64, _b: u64, _n: f64) {\n    rs_set_str(state, \"exited\");\n}\n";
    }
    if (name == "mouse-region-reactive-cursor") {
        return "// mouse-region-reactive-cursor: the cursor resolves from a str atom each\n// layout — flipping the atom re-resolves the cursor on hover.\nuse tur::{ el_box_new, box_size, el_build, el_child, el_column, el_mouse_region, el_text_bound_new, mount, rs_set_str, rs_source_str };\n\nentry fn start() -> u64 {\n    let cursor = rs_source_str(\"pointer\");\n    let state = rs_source_str(\"\");\n    let col = el_column();\n    let b = el_box_new();\n    box_size(b, 100.0, 50.0);\n    let t = el_text_bound_new(state);\n    el_child(b, el_build(t));\n    el_child(col, el_mouse_region_bound(state, \"mr_enter\", \"mr_exit\", cursor, 0, el_build(b)));\n    let ct = el_text_bound_new(cursor);\n    el_qkey(ct, \"cursor-atom\");\n    el_child(col, el_build(ct));\n    mount(el_build(col));\n    return cursor;\n}\n\nentry fn set_cursor(cursor: u64, code: f64) {\n    // code indexes the standard keyword table (the test passes the enum\n    // position of the cursor it wants).\n    let name = cursor_name(code as u64);\n    rs_set_str(cursor, name);\n}\n\nentry fn mr_enter(_state: u64, _b: u64, _n: f64) {\n}\n\nentry fn mr_exit(_state: u64, _b: u64, _n: f64) {\n}\n\n// The standard CSS keyword for a cursor code (the el_mouse_region_bound\n// decode reads the same table).\nfn cursor_name(code: u64) -> str {\n    if (code == 27) {\n        return \"ew-resize\";\n    }\n    if (code == 5) {\n        return \"pointer\";\n    }\n    return \"default\";\n}\n";
    }
    if (name == "password-input") {
        return "// password-input: an obscure-toggle input — typing renders bullets and a\n// reveal button flips the obscure flag (a rebuild).\nuse tur::{ el_box_new, el_build, el_child, el_column, el_input, el_pi, el_qkey, el_text_new, el_vqkey, mount, rs_get_bool, rs_set_bool, rs_source_bool, tctrl_new, undo_new };\n\nentry fn start() -> u64 {\n    let obscure = rs_source_bool(true);\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n\n    let col = el_column();\n    let input = el_input_opts(ctrl, undo, \"password\", 220.0, 32.0, 2);\n    el_child(col, el_vqkey(input, \"password-input\"));\n    el_child(col, el_pi(obscure, obscure, \"b_toggle\", \"\", 0, \"\", el_build(el_text_new(\"reveal\"))));\n    let root = el_box_new();\n    el_child(root, el_build(col));\n    mount(root);\n    return obscure;\n}\n\nentry fn b_toggle(obscure: u64, _b: u64, _n: f64) {\n    rs_set_bool(obscure, !rs_get_bool(obscure));\n}\n";
    }
    if (name == "pointer-drag") {
        return "// pointer-drag: a gesture pad reporting down/move/up — the phase label\n// and the last position ride two bound atoms (both cross in the intents).\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_START, el_box_new, box_align, box_color, box_size, el_build, el_child, el_column, el_gesture2, el_qkey, el_text_bound_new, flex_cross_align, mount, rs_set_str, rs_source_str };\n\nentry fn start() -> u64 {\n    let phase = rs_source_str(\"idle\");\n    let pos = rs_source_str(\"0,0\");\n\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n\n    let b = el_box_new();\n    box_size(b, 100.0, 50.0);\n    box_color(b, 0xCCCCCCFFu64);\n    box_align(b, ALIGN_CENTER);\n    let phase_t = el_text_bound_new(phase);\n    el_qkey(phase_t, \"drag-phase\");\n    el_child(b, el_build(phase_t));\n\n    el_child(col, el_gesture2(phase, pos, \"\", \"g_down\", \"g_move\", \"g_up\", \"\", el_build(b)));\n\n    let pos_t = el_text_bound_new(pos);\n    el_qkey(pos_t, \"drag-pos\");\n    el_child(col, el_build(pos_t));\n\n    mount(el_build(col));\n    return phase;\n}\n\nentry fn g_down(phase: u64, pos: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    rs_set_str(pos, f\"{gx as u64},{gy as u64}\");\n    rs_set_str(phase, \"down\");\n}\n\nentry fn g_move(phase: u64, pos: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    rs_set_str(pos, f\"{gx as u64},{gy as u64}\");\n    rs_set_str(phase, \"move\");\n}\n\nentry fn g_up(phase: u64, pos: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    rs_set_str(pos, f\"{gx as u64},{gy as u64}\");\n    rs_set_str(phase, \"up\");\n}\n";
    }
    if (name == "pointer-interact-basic") {
        return "// pointer-interact-basic: an opaque gesture pad around a fixed-size box.\nuse tur::{ el_box_new, box_size, el_build, el_pi, mount, rs_source_f64 };\n\nentry fn start() {\n    let pad = rs_source_f64();\n    let b = el_box_new();\n    box_size(b, 100.0, 50.0);\n    mount(el_pi(pad, pad, \"\", \"\", 0, \"\", el_build(b)));\n}\n";
    }
    if (name == "pointer-interact-empty") {
        return "// pointer-interact-empty: a bare PointerInteract with no child — the\n// invisible hit-target widget (zero-sized, still absorbs at its point).\nuse tur::{ el_pi_empty, mount, rs_source_f64 };\n\nentry fn start() {\n    let pad = rs_source_f64();\n    mount(el_pi_empty(pad, pad, \"\", \"\", 0, \"\"));\n}\n";
    }
    if (name == "pointer-interact-in-column") {
        return "// pointer-interact-in-column: two gesture pads stacked in a column.\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_column, el_pi, flex_cross_align, mount, rs_source_f64 };\n\nentry fn start() {\n    let pad = rs_source_f64();\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    let a = el_box_new();\n    box_size(a, 80.0, 40.0);\n    let b = el_box_new();\n    box_size(b, 60.0, 30.0);\n    el_child(col, el_pi(pad, pad, \"\", \"\", 0, \"\", el_build(a)));\n    el_child(col, el_pi(pad, pad, \"\", \"\", 0, \"\", el_build(b)));\n    mount(el_build(col));\n}\n";
    }
    if (name == "pointer-interact-nested") {
        return "// pointer-interact-nested: nested gesture pads — the opaque inner blocks\n// the outer, the translucent inner lets both fire. The result labels are\n// derived atoms over the two counter pairs (the C8 derive rail).\nuse tur::{ CROSS_ALIGN_START, MAIN_SIZE_MIN, el_box_new, box_size, el_build, el_child, el_column, el_pi, el_qkey, el_row, el_text_bound_d_new, flex_cross_align, flex_main_size, mount, rs_derive2, rs_get_f64, rs_set_f64, rs_source_f64 };\n\nentry fn start() -> u64 {\n    let outer_o = rs_source_f64();\n    let inner_o = rs_source_f64();\n    let outer_t = rs_source_f64();\n    let inner_t = rs_source_f64();\n    let d_o = rs_derive2(\"fmt_o\", outer_o, inner_o);\n    let d_t = rs_derive2(\"fmt_t\", outer_t, inner_t);\n\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    flex_main_size(col, MAIN_SIZE_MIN);\n\n    // Opaque pair: the inner (opaque) absorbs the click.\n    let outer_box = el_box_new();\n    box_size(outer_box, 80.0, 40.0);\n    el_qkey(outer_box, \"outer-opaque\");\n    let inner_row = el_row();\n    let inner_box = el_box_new();\n    box_size(inner_box, 60.0, 30.0);\n    el_qkey(inner_box, \"inner-opaque\");\n    el_child(inner_row, el_pi(inner_o, inner_o, \"ts_inner_o\", \"\", 0, \"\", el_build(inner_box)));\n    el_child(outer_box, el_build(inner_row));\n    el_child(col, el_pi(outer_o, outer_o, \"ts_outer_o\", \"\", 0, \"\", el_build(outer_box)));\n\n    // Translucent pair: the inner joins the path; the outer fires too.\n    let outer_t_box = el_box_new();\n    box_size(outer_t_box, 80.0, 40.0);\n    el_qkey(outer_t_box, \"outer-translucent\");\n    let t_row = el_row();\n    let inner_t_box = el_box_new();\n    box_size(inner_t_box, 60.0, 30.0);\n    el_qkey(inner_t_box, \"inner-translucent\");\n    el_child(t_row, el_pi(inner_t, inner_t, \"ts_inner_t\", \"\", 1, \"\", el_build(inner_t_box)));\n    el_child(outer_t_box, el_build(t_row));\n    el_child(col, el_pi(outer_t, outer_t, \"ts_outer_t\", \"\", 0, \"\", el_build(outer_t_box)));\n\n    let ro = el_text_bound_d_new(d_o);\n    el_qkey(ro, \"result-opaque\");\n    el_child(col, el_build(ro));\n    let rt = el_text_bound_d_new(d_t);\n    el_qkey(rt, \"result-translucent\");\n    el_child(col, el_build(rt));\n\n    mount(el_build(col));\n    return outer_o;\n}\n\n// The derive bodies — synchronous VM calls during flush.\nentry fn fmt_o(a: f64, b: f64) -> str {\n    return f\"opaque:{a as u64}/{b as u64}\";\n}\n\nentry fn fmt_t(a: f64, b: f64) -> str {\n    return f\"translucent:{a as u64}/{b as u64}\";\n}\n\nentry fn ts_outer_o(count: u64, _b: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n}\n\nentry fn ts_inner_o(count: u64, _b: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n}\n\nentry fn ts_outer_t(count: u64, _b: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n}\n\nentry fn ts_inner_t(count: u64, _b: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n}\n";
    }
    if (name == "pointer-region-enter-exit-race") {
        return "// pointer-region-enter-exit-race: two regions sharing one hover atom —\n// moving A->B in a single event must land on \"B\" (exit-before-enter).\nuse tur::{ el_box_new, box_color, box_size, el_build, el_child, el_column, el_mouse_region, el_qkey, el_text_bound_new, mount, rs_set_str, rs_source_str };\n\nentry fn start() -> u64 {\n    let hover = rs_source_str(\"\");\n    let col = el_column();\n\n    let a = el_box_new();\n    box_size(a, 100.0, 50.0);\n    box_color(a, 0xEF4444FFu64);\n    el_qkey(a, \"a\");\n    el_child(col, el_mouse_region(hover, \"a_enter\", \"a_exit\", 0, 0, el_build(a)));\n\n    let b = el_box_new();\n    box_size(b, 100.0, 50.0);\n    box_color(b, 0x3B82F6FF);\n    el_qkey(b, \"b\");\n    el_child(col, el_mouse_region(hover, \"b_enter\", \"b_exit\", 0, 0, el_build(b)));\n\n    let t = el_text_bound_new(hover);\n    el_qkey(t, \"hover\");\n    el_child(col, el_build(t));\n    mount(el_build(col));\n    return hover;\n}\n\nentry fn a_enter(hover: u64, _b: u64, _n: f64) {\n    rs_set_str(hover, \"A\");\n}\n\nentry fn a_exit(hover: u64, _b: u64, _n: f64) {\n    rs_set_str(hover, \"\");\n}\n\nentry fn b_enter(hover: u64, _b: u64, _n: f64) {\n    rs_set_str(hover, \"B\");\n}\n\nentry fn b_exit(hover: u64, _b: u64, _n: f64) {\n    rs_set_str(hover, \"\");\n}\n";
    }
    if (name == "pointer-region-text") {
        return "// pointer-region-text: a MouseRegion whose enter/exit writes the bound\n// label inside a padded, centered surface.\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_START, CURSOR_AUTO, el_box_new, box_align, box_color, box_size, el_build, el_child, el_column, el_mouse_region, el_qkey, el_text_bound_new, flex_cross_align, mount, rs_set_str, rs_source_str };\n\nentry fn start() -> u64 {\n    let state = rs_source_str(\"idle\");\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n\n    let b = el_box_new();\n    box_size(b, 100.0, 50.0);\n    box_color(b, 0xCCCCCCFFu64);\n    box_align(b, ALIGN_CENTER);\n    let t = el_text_bound_new(state);\n    el_qkey(t, \"region-text\");\n    el_child(b, el_build(t));\n\n    el_child(col, el_mouse_region(state, \"mr_enter\", \"mr_exit\", CURSOR_AUTO, 0, el_build(b)));\n    mount(el_build(col));\n    return state;\n}\n\nentry fn mr_enter(state: u64, _b: u64, _n: f64) {\n    rs_set_str(state, \"entered\");\n}\n\nentry fn mr_exit(state: u64, _b: u64, _n: f64) {\n    rs_set_str(state, \"exited\");\n}\n";
    }
    if (name == "positioned-basic") {
        return "// positioned-basic: a positioned child anchored (10, 20) inside a Stack.\nuse tur::{ el_box_new, box_size, el_build, el_child, el_positioned, el_stack, mount };\n\nentry fn start() {\n    let stack = el_stack();\n    let sb = el_box_new();\n    box_size(sb, 50.0, 50.0);\n    el_child(stack, el_positioned(10.0, 20.0, el_build(sb)));\n    mount(el_build(stack));\n}\n";
    }
    if (name == "positioned-only-stack") {
        return "// positioned-only-stack: a Stack with ONLY positioned children sizes to\n// the biggest size the incoming constraints allow (Flutter RenderStack).\nuse tur::{ el_box_new, box_size, el_build, el_child, el_expand, el_positioned, el_qkey, el_stack, mount };\n\nentry fn start() {\n    let stack = el_stack();\n    el_child(stack, el_positioned(5.0, 5.0, qkey_sized(10.0, 10.0, \"dot\")));\n    mount(el_expand(1.0, el_build(stack)));\n}\n\nfn qkey_sized(w: f64, h: f64, key: str) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    el_qkey(b, key);\n    return el_build(b);\n}\n";
    }
    if (name == "positioned-right-bottom") {
        return "// positioned-right-bottom: edge anchors resolve against the STACK's own\n// final size (200x300), not the incoming constraints (Flutter parity).\nuse tur::{ el_box_new, box_size, el_build, el_child, el_positioned_edges, el_qkey, el_stack, mount };\n\nfn sized(w: f64, h: f64, key: str) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    if (key != \"\") {\n        el_qkey(b, key);\n    }\n    return el_build(b);\n}\n\nentry fn start() {\n    let stack = el_stack();\n    el_child(stack, sized(200.0, 300.0, \"\"));\n    el_child(stack, el_positioned_edges(0.0, 0.0, 8.0, 8.0, sized(60.0, 24.0, \"rb-pill\")));\n    el_child(stack, el_positioned_edges(10.0, 0.0, 10.0, 0.0, sized(0.0, 20.0, \"lr-pair\")));\n    mount(el_build(stack));\n}\n";
    }
    if (name == "rich-text-bold") {
        return "use tur::{ el_build, el_text_new, mount, span_add, spans_new, text_size, text_spans };\n\nentry fn start() {\n    let t = el_text_new(\"\");\n    text_size(t, 14.0);\n    let spans = spans_new();\n    span_add(spans, \"Normal\", 0.0, 0, 0.0, 0);\n    span_add(spans, \"Bold\", 0.0, 0, 700.0, 0);\n    text_spans(t, spans);\n    mount(el_build(t));\n}\n";
    }
    if (name == "rich-text-color") {
        return "use tur::{ el_build, el_text_new, mount, span_add, spans_new, text_size, text_spans };\n\nentry fn start() {\n    let t = el_text_new(\"\");\n    text_size(t, 14.0);\n    let spans = spans_new();\n    span_add(spans, \"White\", 0.0, 0, 0.0, 0);\n    span_add(spans, \"Red\", 0.0, 0xFF0000FFu64, 0.0, 0);\n    span_add(spans, \"Green\", 0.0, 0x00FF00FFu64, 0.0, 0);\n    text_spans(t, spans);\n    mount(el_build(t));\n}\n";
    }
    if (name == "rich-text-empty") {
        return "use tur::{ el_build, el_text_new, mount, span_add, spans_new, text_size, text_spans };\n\nentry fn start() {\n    let t = el_text_new(\"\");\n    text_size(t, 14.0);\n    let spans = spans_new();\n    span_add(spans, \"\", 0.0, 0, 0.0, 0);\n    text_spans(t, spans);\n    mount(el_build(t));\n}\n";
    }
    if (name == "rich-text-font-size") {
        return "use tur::{ el_build, el_text_new, mount, span_add, spans_new, text_size, text_spans };\n\nentry fn start() {\n    let t = el_text_new(\"\");\n    text_size(t, 14.0);\n    let spans = spans_new();\n    span_add(spans, \"Small\", 0.0, 0, 0.0, 0);\n    span_add(spans, \"Big\", 28.0, 0, 0.0, 0);\n    text_spans(t, spans);\n    mount(el_build(t));\n}\n";
    }
    if (name == "rich-text-inheritance") {
        return "use tur::{ el_build, el_text_new, mount, span_add, spans_new, text_size, text_spans };\n\nentry fn start() {\n    let t = el_text_new(\"\");\n    text_size(t, 20.0);\n    let spans = spans_new();\n    span_add(spans, \"Inherited\", 0.0, 0xFF0000FFu64, 0.0, 0);\n    span_add(spans, \"Override\", 10.0, 0x00FF00FFu64, 0.0, 0);\n    text_spans(t, spans);\n    mount(el_build(t));\n}\n";
    }
    if (name == "rich-text-italic") {
        return "use tur::{ el_build, el_text_new, mount, span_add, spans_new, text_size, text_spans };\n\nentry fn start() {\n    let t = el_text_new(\"\");\n    text_size(t, 14.0);\n    let spans = spans_new();\n    span_add(spans, \"Normal\", 0.0, 0, 0.0, 0);\n    span_add(spans, \"Italic\", 0.0, 0, 0.0, 1);\n    text_spans(t, spans);\n    mount(el_build(t));\n}\n";
    }
    if (name == "rich-text-multi-span") {
        return "use tur::{ el_build, el_text_new, mount, span_add, spans_new, text_size, text_spans };\n\nentry fn start() {\n    let t = el_text_new(\"\");\n    text_size(t, 14.0);\n    let spans = spans_new();\n    span_add(spans, \"Hello \", 0.0, 0, 0.0, 0);\n    span_add(spans, \"Bold\", 0.0, 0, 700.0, 0);\n    span_add(spans, \" World\", 0.0, 0, 0.0, 0);\n    text_spans(t, spans);\n    mount(el_build(t));\n}\n";
    }
    if (name == "rich-text-single-span") {
        return "use tur::{ el_build, el_text_new, mount, span_add, spans_new, text_size, text_spans };\n\nentry fn start() {\n    let t = el_text_new(\"\");\n    text_size(t, 14.0);\n    let spans = spans_new();\n    span_add(spans, \"Hello World\", 0.0, 0, 0.0, 0);\n    text_spans(t, spans);\n    mount(el_build(t));\n}\n";
    }
    if (name == "row-basic") {
        return "// row-basic: two fixed-width children laid out horizontally.\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_row, flex_cross_align, mount };\n\nfn box_w(w: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, 0.0);\n    return el_build(b);\n}\n\nentry fn start() {\n    let row = el_row();\n    flex_cross_align(row, CROSS_ALIGN_START);\n    el_child(row, box_w(50.0));\n    el_child(row, box_w(30.0));\n    mount(el_build(row));\n}\n";
    }
    if (name == "row-cross-center") {
        return "// row-cross-center: a 200x36 container centering a row of two boxes on\n// the cross axis.\nuse tur::{ CROSS_ALIGN_CENTER, el_box_new, box_padding, box_size, el_build, el_child, el_row, flex_cross_align, mount };\n\nentry fn start() {\n    let outer = el_box_new();\n    box_size(outer, 200.0, 36.0);\n    box_padding(outer, 0.0);\n    let row = el_row();\n    flex_cross_align(row, CROSS_ALIGN_CENTER);\n    el_child(row, box_wh(20.0, 20.0));\n    el_child(row, box_wh(40.0, 10.0));\n    el_child(outer, el_build(row));\n    mount(el_build(outer));\n}\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n";
    }
    if (name == "row-cross-center-in-column") {
        return "// row-cross-center-in-column: a min-size centering Row in a Column.\nuse tur::{ CROSS_ALIGN_CENTER, CROSS_ALIGN_START, MAIN_SIZE_MIN, el_box_new, box_size, el_build, el_child, el_column, el_row, flex_cross_align, flex_main_size, mount };\n\nentry fn start() {\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    let row = el_row();\n    flex_cross_align(row, CROSS_ALIGN_CENTER);\n    flex_main_size(row, MAIN_SIZE_MIN);\n    el_child(row, box_wh(20.0, 20.0));\n    el_child(row, box_wh(40.0, 10.0));\n    el_child(col, el_build(row));\n    el_child(col, box_wh(0.0, 30.0));\n    el_child(col, box_wh(0.0, 20.0));\n    mount(el_build(col));\n}\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n";
    }
    if (name == "row-cross-stretch-no-height") {
        return "// row-cross-stretch-no-height: a Stretch Row gives non-flex children its\n// full cross height; the Expanded supplies the bounded height inside the\n// unbounded Column (sidebar + divider + expanded content pane).\nuse tur::{ CROSS_ALIGN_STRETCH, CROSS_ALIGN_START, el_box_new, box_color, box_size, el_build, el_child, el_column, el_expand, el_row, flex_cross_align, mount };\n\nentry fn start() {\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    let row = el_row();\n    flex_cross_align(row, CROSS_ALIGN_STRETCH);\n    el_child(row, box_w(100.0));\n    el_child(row, box_w(8.0));\n    el_child(row, el_expand(1.0, box_w(0.0)));\n    el_child(col, el_expand(1.0, el_build(row)));\n    mount(el_build(col));\n}\n\nfn box_w(w: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, 0.0);\n    return el_build(b);\n}\n";
    }
    if (name == "row-nested") {
        return "// row-nested (Flutter parity): non-flex children of a flex receive unbounded\n// main-axis constraints, so the inner Row (default MainAxisSize.max) must\n// shrink-wrap to its content width instead of consuming the outer Row's\n// full width — leaving the following sibling visible.\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_row, flex_cross_align, mount };\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let outer = el_row();\n    flex_cross_align(outer, CROSS_ALIGN_START);\n    let inner = el_row();\n    el_child(inner, box_wh(20.0, 0.0));\n    el_child(inner, box_wh(30.0, 0.0));\n    el_child(outer, el_build(inner));\n    el_child(outer, box_wh(50.0, 10.0));\n    mount(el_build(outer));\n}\n";
    }
    if (name == "row-with-each") {
        return "// row-with-each: an Each inside a content-sized Row — the Row must not\n// inflate to the parent Column's height (the regression the test pins).\nuse tur::{ CROSS_ALIGN_STRETCH, el_box_new, el_build, el_child, el_column, el_expand, el_row, el_sizedbox, el_text_new, rs_each, rs_list_new, rs_list_push, rs_source_value, flex_cross_align, mount, text_size };\n\nentry fn item(_i: u64, s: str) -> opaque {\n    let t = el_text_new(s);\n    text_size(t, 13.0);\n    return el_build(t);\n}\n\nentry fn start() {\n    let seg = rs_list_new();\n    rs_list_push(seg, \"a\");\n    rs_list_push(seg, \"b\");\n    let seg_atom = rs_source_value(seg);\n\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_STRETCH);\n    let row = el_row();\n    el_child(row, el_sizedbox(16.0, 16.0, el_build(el_box_new())));\n    el_child(row, rs_each(seg_atom, \"item\"));\n    el_child(col, el_build(row));\n    el_child(col, el_sizedbox(40.0, 10.0, el_build(el_box_new())));\n    el_child(col, el_expand(1.0, el_build(el_box_new())));\n    mount(el_build(col));\n}\n";
    }
    if (name == "scroll-container-text") {
        return "// scroll-container-text: a padded unsized Container sized from its Text\n// child inside a vertical ScrollView's content Column.\nuse tur::{ el_box_new, box_padding, el_build, el_child, el_column, el_qkey, el_scroll, el_text_new, text_size, mount };\n\nentry fn start() {\n    let b = el_box_new();\n    box_padding(b, 48.0);\n    el_qkey(b, \"container\");\n    let t = el_text_new(\"Empty State\");\n    text_size(t, 24.0);\n    el_child(b, el_build(t));\n    let col = el_column();\n    el_child(col, el_build(b));\n    mount(el_scroll(true, el_build(col)));\n}\n";
    }
    if (name == "scroll-view-basic") {
        return "// scroll-view-basic: a vertical scroll viewport around a 3x200 column.\nuse tur::{ CROSS_ALIGN_STRETCH, el_box_new, box_size, el_build, el_child, el_column, el_scroll, el_vqkey, flex_cross_align, mount };\n\nentry fn start() {\n    let content = el_column();\n    flex_cross_align(content, CROSS_ALIGN_STRETCH);\n    el_child(content, box_h(200.0));\n    el_child(content, box_h(200.0));\n    el_child(content, box_h(200.0));\n    let sv = el_scroll(true, el_build(content));\n    mount(el_vqkey(sv, \"scroll-view\"));\n}\n\nfn box_h(h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, h);\n    return el_build(b);\n}\n";
    }
    if (name == "scroll-view-nested") {
        return "// scroll-view-nested: a vertical ScrollView inside a horizontal one. The\n// outer sits in a Row — `Expanded` supplies the bounded viewport (non-flex\n// flex children get unbounded main-axis constraints, Flutter parity).\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_column, el_expand, el_row, el_scroll, el_sizedbox, el_vqkey, flex_cross_align, mount };\n\nentry fn start() {\n    let row = el_row();\n    el_child(row, el_sizedbox(200.0, 0.0, el_build(el_box_new())));\n    let outer_content = el_column();\n    flex_cross_align(outer_content, CROSS_ALIGN_START);\n    el_child(outer_content, box_h(100.0));\n    let inner_wrapper = el_box_new();\n    box_size(inner_wrapper, 0.0, 200.0);\n    el_qkey(inner_wrapper, \"inner-wrapper\");\n    let inner_content = el_column();\n    flex_cross_align(inner_content, CROSS_ALIGN_STRETCH);\n    el_child(inner_content, box_h(200.0));\n    el_child(inner_content, box_h(200.0));\n    el_child(inner_content, box_h(200.0));\n    let inner = el_scroll(true, el_build(inner_content));\n    el_child(inner_wrapper, inner);\n    el_child(outer_content, el_build(inner_wrapper));\n    el_child(outer_content, box_h(400.0));\n    let outer = el_scroll(true, el_build(outer_content));\n    el_child(row, el_expand(1.0, el_vqkey(outer, \"outer-scroll\")));\n    mount(el_build(row));\n}\n\nfn box_h(h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, h);\n    return el_build(b);\n}\n";
    }
    if (name == "scroll-view-offset") {
        return "// scroll-view-offset: a scroll viewport with a one-shot initial offset\n// (the controller's initialOffset twin) — the content offset starts at\n// -100.\nuse tur::{ CROSS_ALIGN_STRETCH, el_box_new, box_size, el_build, el_child, el_column, el_scroll_at, el_vqkey, flex_cross_align, mount };\n\nentry fn start() {\n    let content = el_column();\n    flex_cross_align(content, CROSS_ALIGN_STRETCH);\n    el_child(content, box_h(200.0));\n    el_child(content, box_h(200.0));\n    el_child(content, box_h(200.0));\n    let sv = el_scroll_at(100.0, true, el_build(content));\n    mount(el_vqkey(sv, \"scroll-view\"));\n}\n\nfn box_h(h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, 0.0, h);\n    return el_build(b);\n}\n";
    }
    if (name == "scroll-view-shrink-wrap") {
        return "// scroll-view-shrink-wrap: the viewport shrink-wraps to its content\n// (120x80) under the root's loose constraints (Flutter\n// _RenderSingleChildViewport parity).\nuse tur::{ CROSS_ALIGN_START, el_box_new, box_size, el_build, el_child, el_column, el_scroll, el_vqkey, flex_cross_align, mount };\n\nentry fn start() {\n    let content = el_column();\n    flex_cross_align(content, CROSS_ALIGN_START);\n    el_child(content, sized(120.0, 40.0));\n    el_child(content, sized(60.0, 40.0));\n    let sv = el_scroll(true, el_build(content));\n    mount(el_vqkey(sv, \"sv\"));\n}\n\nfn sized(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n";
    }
    if (name == "sized-box-basic") {
        return "// sized-box-basic: an exactly-sized box wrapping a Text child.\nuse tur::{ el_sizedbox, el_text, el_build, mount };\n\nentry fn start() {\n    mount(el_sizedbox(100.0, 50.0, el_text(\"Hi\")));\n}\n";
    }
    if (name == "stack-basic") {
        return "// stack-basic: two non-positioned children — the Stack sizes to the\n// largest one and paints them overlaid.\nuse tur::{ el_box_new, box_size, el_build, el_child, el_stack, mount };\n\nfn box_wh(w: f64, h: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, h);\n    return el_build(b);\n}\n\nentry fn start() {\n    let stack = el_stack();\n    el_child(stack, box_wh(100.0, 100.0));\n    el_child(stack, box_wh(200.0, 200.0));\n    mount(el_build(stack));\n}\n";
    }
    if (name == "switch-demo") {
        return "// switch-demo: a toggle switch authored from the gesture + box rows (the\n// Switch widget's corpus twin).\nuse tur::{ ALIGN_CENTER_LEFT, ALIGN_CENTER_RIGHT, condition, el_box_new, box_align, box_color, box_padding, box_radius, box_size, el_build, el_child, el_column, el_gesture, el_pi, el_qkey, el_sizedbox, el_sizedbox, mount, rs_get_bool, rs_set_bool, rs_source_bool, stf_put, stf_take };\n\nlet K_ON: u64 = 1;\n\nentry fn start() -> u64 {\n    let on = rs_source_bool(true);\n    stf_put(K_ON, on as f64);\n    let col = el_column();\n    let track = el_box_new();\n    box_size(track, 64.0, 32.0);\n    box_color(track, 0x22C55EFFu64);\n    box_radius(track, 16.0);\n    box_padding(track, 4.0);\n    el_qkey(track, \"switch\");\n    el_child(track, el_build(thumb(on)));\n    el_child(col, el_gesture(on, \"b_toggle\", \"\", \"\", \"\", \"\", el_build(track)));\n    mount(el_sizedbox(400.0, 200.0, el_build(col)));\n    return on;\n}\n\nfn thumb(on: u64) -> opaque {\n    let knob = el_box_new();\n    box_size(knob, 24.0, 24.0);\n    box_color(knob, 0xFFFFFFFFu64);\n    box_radius(knob, 12.0);\n    let side = el_box_new();\n    box_size(side, 32.0, 24.0);\n    box_align(side, thumb_align());\n    el_child(side, el_build(knob));\n    return el_build(side);\n}\n\nfn thumb_align() -> u64 {\n    let on = stf_take(K_ON) as u64;\n    stf_put(K_ON, on as f64);\n    if (rs_get_bool(on)) {\n        return 5;\n    }\n    return 3;\n}\n\nentry fn b_toggle(_a: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    let on = stf_take(K_ON) as u64;\n    rs_set_bool(on, !rs_get_bool(on));\n    stf_put(K_ON, on as f64);\n}\n";
    }
    if (name == "table-basic") {
        return "// table-basic: shared column geometry with a header row, stripes and\n// dividers (the Table widget's corpus twin, authored from flex rows).\nuse tur::{ CROSS_ALIGN_CENTER, MAIN_ALIGN_SPACE_BETWEEN, el_box_new, box_color, box_padding, box_size, el_build, el_child, el_column, el_row, el_sizedbox, el_text_new, flex_cross_align, mount, text_size };\n\nfn header_cell(label: str, w: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, 0.0);\n    box_padding(b, 8.0);\n    let t = el_text_new(label);\n    text_size(t, 12.0);\n    el_child(b, el_build(t));\n    return el_build(b);\n}\n\nfn cell(label: str, w: f64) -> opaque {\n    let b = el_box_new();\n    box_size(b, w, 0.0);\n    box_padding(b, 8.0);\n    let t = el_text_new(label);\n    text_size(t, 14.0);\n    el_child(b, el_build(t));\n    return el_build(b);\n}\n\nfn header() -> opaque {\n    let r = el_row();\n    el_child(r, header_cell(\"PLANET\", 150.0));\n    el_child(r, header_cell(\"NOTES\", 100.0));\n    el_child(r, header_cell(\"DISTANCE\", 100.0));\n    return el_build(r);\n}\n\nfn planet(name: str, notes: str, distance: str) -> opaque {\n    let r = el_row();\n    el_child(r, cell(name, 150.0));\n    el_child(r, cell(notes, 100.0));\n    el_child(r, cell(distance, 100.0));\n    let wrapped = el_box_new();\n    box_size(wrapped, 0.0, 36.0);\n    el_child(wrapped, el_build(r));\n    return el_build(wrapped);\n}\n\nentry fn start() {\n    let table = el_column();\n    el_child(table, header());\n    el_child(table, planet(\"Mercury\", \"Smallest planet\", \"0.39 AU\"));\n    el_child(table, planet(\"Venus\", \"Hottest surface\", \"0.72 AU\"));\n    el_child(table, planet(\"Earth\", \"Home of life\", \"1.00 AU\"));\n    el_child(table, planet(\"Mars\", \"The red planet\", \"1.52 AU\"));\n    let frame = el_box_new();\n    box_color(frame, 0x0B1220FF);\n    el_child(frame, el_build(table));\n    mount(el_sizedbox(400.0, 240.0, el_build(frame)));\n}\n";
    }
    if (name == "table-reactive") {
        return "// table-reactive: the table twin with a reactive row set — a button adds\n// a planet through an Each over the rows atom.\nuse tur::{ el_box_new, box_color, box_padding, box_size, el_build, el_child, el_column, el_pi, el_row, el_sizedbox, el_text_new, mount, rs_each, rs_get_value, rs_list_new, rs_list_push, rs_set_value, rs_source_value, text_size };\n\nentry fn row(_i: u64, name: str) -> opaque {\n    let r = el_row();\n    let c = el_box_new();\n    box_size(c, 150.0, 0.0);\n    box_padding(c, 8.0);\n    let t = el_text_new(name);\n    text_size(t, 14.0);\n    el_child(c, el_build(t));\n    el_child(r, c);\n    return el_build(r);\n}\n\nentry fn start() -> u64 {\n    let rows = rs_list_new();\n    rs_list_push(rows, \"Mercury\");\n    rs_list_push(rows, \"Venus\");\n    let rows_atom = rs_source_value(rows);\n\n    let col = el_column();\n    let head = el_box_new();\n    box_size(head, 0.0, 32.0);\n    box_color(head, 0x1E293BFF);\n    let ht = el_text_new(\"PLANET\");\n    text_size(ht, 12.0);\n    el_child(head, el_build(ht));\n    el_child(col, head);\n    el_child(col, rs_each(rows_atom, \"row\"));\n    el_child(col, el_pi(rows_atom, rows_atom, \"b_add\", \"\", 0, \"\", el_build(el_text_new(\"add row\"))));\n    let frame = el_box_new();\n    box_color(frame, 0x0B1220FF);\n    el_child(frame, el_build(col));\n    mount(el_sizedbox(400.0, 240.0, el_build(frame)));\n    return rows_atom;\n}\n\nentry fn b_add(rows: u64, _b: u64, _n: f64) {\n    // Read-modify-write: rebuild the list with one more row.\n    let cur = rs_get_value(rows);\n    let n = rs_value_len(cur);\n    let fresh = rs_list_new();\n    let mut i = 0;\n    while (i < n as i32) {\n        rs_list_push(fresh, rs_value_item(cur, i as u64));\n        i += 1;\n    }\n    rs_list_push(fresh, f\"Planet {n as u64}\");\n    rs_set_value(rows, fresh);\n}\n";
    }
    if (name == "text-basic") {
        return "// text-basic: a single 14px Text as the root child.\nuse tur::{ el_build, el_text_new, text_size, mount };\n\nentry fn start() {\n    let t = el_text_new(\"Hello\");\n    text_size(t, 14.0);\n    mount(el_build(t));\n}\n";
    }
    if (name == "text-ellipsis") {
        return "// text-ellipsis: the long line ellipsized at two lines.\nuse tur::{ el_build, el_text_new, text_ellipsis, text_max_lines, text_size, mount };\n\nentry fn start() {\n    let t = el_text_new(\"Hello World this is a long text that should wrap\");\n    text_size(t, 14.0);\n    text_max_lines(t, 2);\n    text_ellipsis(t);\n    mount(el_build(t));\n}\n";
    }
    if (name == "text-empty-content") {
        return "// text-empty-content: empty text content measures to zero.\nuse tur::{ el_build, el_text_new, mount };\n\nentry fn start() {\n    mount(el_build(el_text_new(\"\")));\n}\n";
    }
    if (name == "text-font-size") {
        return "// text-font-size: a Fragment of 14px and 28px Texts — the root's children\n// stay flat (the fragment is layout-transparent).\nuse tur::{ el_build, el_fragment2, el_text_new, text_size, mount };\n\nentry fn start() {\n    let small = el_text_new(\"Hello\");\n    text_size(small, 14.0);\n    let large = el_text_new(\"Hello\");\n    text_size(large, 28.0);\n    mount(el_fragment2(el_build(small), el_build(large)));\n}\n";
    }
    if (name == "text-font-weight") {
        return "// text-font-weight: weight 400 vs 700 at the same size — the bold run\n// measures wider.\nuse tur::{ el_build, el_fragment2, el_text_new, text_size, text_weight, mount };\n\nentry fn start() {\n    let normal = el_text_new(\"Hello\");\n    text_size(normal, 20.0);\n    text_weight(normal, 400.0);\n    let bold = el_text_new(\"Hello\");\n    text_size(bold, 20.0);\n    text_weight(bold, 700.0);\n    mount(el_fragment2(el_build(normal), el_build(bold)));\n}\n";
    }
    if (name == "text-in-column") {
        return "// text-in-column: two Texts stacked in a start-aligned Column.\nuse tur::{ CROSS_ALIGN_START, el_build, el_child, el_column, el_text_new, text_size, flex_cross_align, mount };\n\nentry fn start() {\n    let col = el_column();\n    flex_cross_align(col, CROSS_ALIGN_START);\n    let first = el_text_new(\"First\");\n    text_size(first, 14.0);\n    let second = el_text_new(\"Second\");\n    text_size(second, 14.0);\n    el_child(col, el_build(first));\n    el_child(col, el_build(second));\n    mount(el_build(col));\n}\n";
    }
    if (name == "text-max-lines") {
        return "// text-max-lines: the long line clipped to two lines.\nuse tur::{ el_build, el_text_new, text_clip, text_max_lines, text_size, mount };\n\nentry fn start() {\n    let t = el_text_new(\"Hello World this is a long text that should wrap\");\n    text_size(t, 14.0);\n    text_max_lines(t, 2);\n    text_clip(t);\n    mount(el_build(t));\n}\n";
    }
    if (name == "text-wrapping") {
        return "// text-wrapping: a long 14px line wraps within the width budget.\nuse tur::{ el_build, el_text_new, text_size, mount };\n\nentry fn start() {\n    let t = el_text_new(\"Hello World this is a long text that should wrap\");\n    text_size(t, 14.0);\n    mount(el_build(t));\n}\n";
    }
    if (name == "todolist") {
        return "// todolist: the checkable list showcase (the corpus's composite surface:\n// scroll + per-item gestures + derived count).\nuse tur::{ CROSS_ALIGN_STRETCH, MAIN_ALIGN_SPACE_BETWEEN, el_box_new, box_size, el_build, el_child, el_column, el_expand, el_gesture2, el_pi, el_qkey, el_row, el_scroll, el_sizedbox, el_text_bound_d, el_text_new, flex_main_align, mount, rs_derive, rs_list_new, rs_list_push, rs_source_value, stf_put, stf_take };\n\nlet K_ITEMS: u64 = 1;\n\nentry fn item(_i: u64, s: str) -> opaque {\n    let r = el_row();\n    flex_main_align(r, MAIN_ALIGN_SPACE_BETWEEN);\n    let label = el_text_new(s);\n    el_child(r, el_build(label));\n    let check = el_box_new();\n    box_size(check, 20.0, 20.0);\n    el_qkey(check, \"check\");\n    el_child(r, el_build(check));\n    let wrap = el_box_new();\n    box_size(wrap, 0.0, 44.0);\n    el_child(wrap, el_build(r));\n    return el_gesture2(_i, 0, \"it_tap\", \"\", \"\", \"\", \"\", el_build(wrap));\n}\n\nentry fn start() -> u64 {\n    let items = rs_list_new();\n    rs_list_push(items, \"Buy milk\");\n    rs_list_push(items, \"Ship phase 4\");\n    rs_list_push(items, \"Walk the dog\");\n    let items_atom = rs_source_value(items);\n    stf_put(K_ITEMS, items_atom as f64);\n    let count = rs_derive(\"fmt_count\", items_atom);\n\n    let col = el_column();\n    let head = el_box_new();\n    box_size(head, 0.0, 48.0);\n    let ht = el_text_bound_d(count);\n    el_qkey(ht, \"count\");\n    el_child(head, ht);\n    el_child(col, head);\n    let content = el_column();\n    el_child(content, rs_each(items_atom, \"item\"));\n    let scroller = el_scroll(true, el_build(content));\n    el_child(col, el_expand(1.0, scroller));\n    let add = el_box_new();\n    box_size(add, 0.0, 48.0);\n    el_child(add, el_pi(items_atom, items_atom, \"b_add\", \"\", 0, \"\", el_build(el_text_new(\"+ add\"))));\n    el_child(col, add);\n    mount(el_sizedbox(400.0, 600.0, el_build(col)));\n}\n\nentry fn fmt_count(_v: f64) -> str {\n    return \"todos\";\n}\n\nentry fn it_tap(_idx: u64, _b: u64, _n: f64) {\n}\n\nentry fn b_add(_a: u64, _b: u64, _n: f64) {\n    let items = stf_take(K_ITEMS) as u64;\n    let fresh = rs_list_new();\n    rs_list_push(fresh, \"Buy milk\");\n    rs_list_push(fresh, \"Ship phase 4\");\n    rs_list_push(fresh, \"Walk the dog\");\n    rs_list_push(fresh, \"New todo\");\n    rs_set_value(items, fresh);\n    stf_put(K_ITEMS, items as f64);\n}\n";
    }
    if (name == "transform-translate-hit") {
        return "// transform-translate-hit: a box laid out at (0,0) painted at (100,80)\n// via a paint-only Transform translate — clickable at the PAINTED center.\n// The click flips the hit atom; the Condition mounts the red confirmation\n// box (the branch swap adds one container node).\nuse tur::{ ALIGN_TOP_LEFT, condition, el_box_new, box_color, box_size, el_build, el_child, el_pi, el_qkey, el_sizedbox, el_stack, el_text_new, el_transform, mount, rs_source_bool, stack_align };\n\nentry fn start() {\n    let hit = rs_source_bool(false);\n\n    let stack = el_stack();\n    stack_align(stack, ALIGN_TOP_LEFT);\n    el_child(stack, el_sizedbox(400.0, 600.0, el_build(el_box_new())));\n\n    let indigo = el_box_new();\n    box_size(indigo, 40.0, 40.0);\n    box_color(indigo, 0x4F46E1FFu64);\n    let pi = el_pi(hit, hit, \"b_hit\", \"\", 0, \"\", el_build(indigo));\n    el_child(stack, el_transform(1.0, 0.0, 100.0, 80.0, pi));\n\n    // The confirmation box appears when the click registers (the else\n    // branch is a Text — not a container — so the container count grows\n    // by exactly one when the red box mounts).\n    let red = el_box_new();\n    box_size(red, 40.0, 40.0);\n    box_color(red, 0xFF0000FFu64);\n    el_child(stack, condition(hit, el_build(red), el_build(el_text_new(\"\"))));\n\n    mount(el_build(stack));\n}\n\nentry fn b_hit(hit: u64, _b: u64, _n: f64) {\n    rs_set_bool(hit, true);\n}\n";
    }
    if (name == "vello-column-basic") {
        return "// vello-column-basic: a colored container with two text rows — the vello\n// render smoke fixture.\nuse tur::{ el_box, el_column, el_text, el_build, el_child, mount };\n\nentry fn start() {\n    let col = el_column();\n    el_child(col, el_text(\"hello vello\"));\n    el_child(col, el_text(\"second line\"));\n    mount(el_box(0xF0F4F8FFu64, 12.0, el_build(col)));\n}\n";
    }
    return "";
}
