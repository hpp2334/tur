fn pg_case_source(name: str) -> str {
    if (name == "complex-animation") {
        return "// complex-animation: \"Animated Card Studio\" — the controller-driven\n// animation showcase (the boa-era twin, ported to the kit's fluent\n// idiom). One explicit AnimationController (Rust-held, stashed) ticks\n// the eased progress into the `a_tick` entry, which maps it into the\n// animated channels: card width (120 → 280), card radius (8 → 40, the\n// bound-radius row), card hue (indigo → coral via the color tween), the\n// inner square's opacity pulse + ROTATION (the bound-angle row:\n// Transform().rotate_bound(progress) — the angle re-resolves through the\n// live atom and the subtree NEVER re-mounts; no rebuild channel), the\n// orbiting dot (Positioned bounds over math_sin/math_cos) and the %\n// readout. The transport (play / pause / resume / reverse / stop), the\n// speed selector (0.5x–4x, in-place), the curve selector (recreates the\n// controller mid-flight and seeks it to the frozen progress) and the\n// loop toggle (infinite repeat) are intent entries over the scalar\n// stash — the boa interactions, names + ids, never closures.\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, MAIN_ALIGN_CENTER, MAIN_SIZE_MIN, anim_forward,\n    anim_pause, anim_repeat, anim_resume, anim_reverse, anim_seek, anim_speed, anim_status,\n    anim_stop, anim_value, color_tween_lerp, math_cos, math_sin, mount, rs_get_bool,\n    rs_set_brush, rs_set_f64, rs_set_str, rs_source_bool, rs_source_f64, rs_source_str,\n    st_put, st_take, stf_put, stf_take, tween_lerp };\nuse tur_kit::{ Column, Container, PointerInteract, Positioned, Row, SizedBox, Stack, Text };\nuse tur_anim_kit::{ Opacity, Transform, anim_ctrl };\n\n\nlet K_CTRL: u64 = 1;\nlet K_PROGRESS: u64 = 2;\nlet K_CURVE: u64 = 3;\nlet K_LOOPB: u64 = 4;\nlet K_WIDTH: u64 = 5;\nlet K_HUE: u64 = 6;\nlet K_INNER: u64 = 7;\nlet K_PCT: u64 = 8;\nlet K_STATUS: u64 = 9;\nlet K_BADGE: u64 = 10;\nlet K_SP0: u64 = 11;\nlet K_SP1: u64 = 12;\nlet K_SP2: u64 = 13;\nlet K_SP3: u64 = 14;\nlet K_CV0: u64 = 15;\nlet K_CV1: u64 = 16;\nlet K_CV2: u64 = 17;\nlet K_CV3: u64 = 18;\nlet K_LP: u64 = 19;\nlet K_ORBIT_X: u64 = 21;\nlet K_ORBIT_Y: u64 = 22;\nlet K_RADIUS: u64 = 23;\n\n// The tween endpoints (the boa card: width 120→280, radius 8→40,\n// indigo→coral; the orbit rides a radius-80 circle).\nlet W_MIN: f64 = 120.0;\nlet W_MAX: f64 = 280.0;\nlet R_MIN: f64 = 8.0;\nlet R_MAX: f64 = 40.0;\nlet ORBIT_CX: f64 = 150.0;\nlet ORBIT_CY: f64 = 90.0;\nlet ORBIT_R: f64 = 80.0;\nlet TAU: f64 = 6.283185307179586;\nlet HUE_MIN: u64 = 0x6366F1FFu64;\nlet HUE_MAX: u64 = 0xE85D44FFu64;\nlet GREEN: u64 = 0x22C55EFFu64;\nlet AMBER: u64 = 0xF59E0BFFu64;\nlet INDIGO: u64 = 0x6366F1FFu64;\nlet SLATE: u64 = 0x94A3B8FFu64;\nlet CHIP_ON: u64 = 0x1E293BFFu64;\nlet CHIP_OFF: u64 = 0xE2E8F0FFu64;\nlet CURVE_ON: u64 = 0x0D9488FFu64;\nlet LOOP_ON: u64 = 0xDB2777FFu64;\n\nentry fn start() -> u64 {\n    let progress = rs_source_f64();\n    let width = rs_source_f64();\n    let hue = rs_source_f64();\n    let inner = rs_source_f64();\n    let pct = rs_source_str(\"0%\");\n    let status = rs_source_str(\"STOPPED\");\n    let badge = rs_source_f64();\n    let looping = rs_source_bool(false);\n    let sp0 = rs_source_f64();\n    let sp1 = rs_source_f64();\n    let sp2 = rs_source_f64();\n    let sp3 = rs_source_f64();\n    let cv0 = rs_source_f64();\n    let cv1 = rs_source_f64();\n    let cv2 = rs_source_f64();\n    let cv3 = rs_source_f64();\n    let lp = rs_source_f64();\n    let orbit_x = rs_source_f64();\n    let orbit_y = rs_source_f64();\n    let radius = rs_source_f64();\n\n    rs_set_f64(width, W_MIN);\n    rs_set_f64(inner, 0.35);\n    rs_set_f64(radius, R_MIN);\n    rs_set_f64(orbit_x, ORBIT_CX + ORBIT_R);\n    rs_set_f64(orbit_y, ORBIT_CY);\n    rs_set_brush(badge, SLATE);\n    rs_set_brush(hue, HUE_MIN); // the card boots indigo (the bound-brush seed)\n\n    // The stash: atom ids + the controller state cross into the entries\n    // as plain scalars (entries cannot capture locals).\n    stf_put(K_PROGRESS, progress as f64);\n    stf_put(K_WIDTH, width as f64);\n    stf_put(K_HUE, hue as f64);\n    stf_put(K_INNER, inner as f64);\n    stf_put(K_PCT, pct as f64);\n    stf_put(K_STATUS, status as f64);\n    stf_put(K_BADGE, badge as f64);\n    stf_put(K_SP0, sp0 as f64);\n    stf_put(K_SP1, sp1 as f64);\n    stf_put(K_SP2, sp2 as f64);\n    stf_put(K_SP3, sp3 as f64);\n    stf_put(K_CV0, cv0 as f64);\n    stf_put(K_CV1, cv1 as f64);\n    stf_put(K_CV2, cv2 as f64);\n    stf_put(K_CV3, cv3 as f64);\n    stf_put(K_LP, lp as f64);\n    stf_put(K_ORBIT_X, orbit_x as f64);\n    stf_put(K_ORBIT_Y, orbit_y as f64);\n    stf_put(K_RADIUS, radius as f64);\n    stf_put(K_CURVE, 3.0); // easeInOut — the boa boot curve\n    stf_put(K_LOOPB, 0.0);\n    let ctrl = anim_ctrl(progress, 2400.0, \"easeInOut\", 1 as u64, a_tick, a_end);\n    st_put(K_CTRL, ctrl);\n\n    paint_speed(1.0);\n    paint_curve(3.0);\n    paint_loop();\n\n    let mut col = Column()\n        .main_alignment(MAIN_ALIGN_CENTER)\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Text().text(\"Animated Card Studio\").font_size(16.0).color(0x0F172AFFu64).query_key(\"cas-title\").build())\n        .child(SizedBox(0.0, 8.0).build())\n        .child(Row().main_axis_size(MAIN_SIZE_MIN).cross_alignment(CROSS_ALIGN_CENTER).child(status_badge()).child(gap(12.0)).child(\n            Text().text_bound(pct).font_size(12.0).color(0x475569FFu64).query_key(\"cas-pct\").build(),\n        ).build())\n        .child(SizedBox(0.0, 28.0).build())\n        .child(stage())\n        .child(SizedBox(0.0, 28.0).build())\n        .child(Row().main_axis_size(MAIN_SIZE_MIN).child(pill(\"Play\", GREEN, b_play, \"cas-play\")).child(gap(6.0))\n            .child(pill(\"Pause\", AMBER, b_pause, \"cas-pause\")).child(gap(6.0))\n            .child(pill(\"Resume\", 0x0EA5E9FFu64, b_resume, \"cas-resume\")).child(gap(6.0))\n            .child(pill(\"Reverse\", 0x8B5CF6FFu64, b_reverse, \"cas-reverse\")).child(gap(6.0))\n            .child(pill(\"Stop\", 0xEF4444FFu64, b_stop, \"cas-stop\")).build())\n        .child(SizedBox(0.0, 16.0).build())\n        .child(Row().main_axis_size(MAIN_SIZE_MIN).cross_alignment(CROSS_ALIGN_CENTER).child(Text().text(\"Speed:\").font_size(11.0).color(0x64748BFFu64).build())\n            .child(gap(8.0))\n            .child(chip(sp0, \"0.5x\", b_speed0, \"cas-s0\")).child(gap(4.0))\n            .child(chip(sp1, \"1x\", b_speed1, \"cas-s1\")).child(gap(4.0))\n            .child(chip(sp2, \"2x\", b_speed2, \"cas-s2\")).child(gap(4.0))\n            .child(chip(sp3, \"4x\", b_speed3, \"cas-s3\")).build())\n        .child(SizedBox(0.0, 12.0).build())\n        .child(Row().main_axis_size(MAIN_SIZE_MIN).cross_alignment(CROSS_ALIGN_CENTER).child(Text().text(\"Curve:\").font_size(11.0).color(0x64748BFFu64).build())\n            .child(gap(8.0))\n            .child(chip(cv0, \"linear\", b_curve0, \"cas-c0\")).child(gap(4.0))\n            .child(chip(cv1, \"easeIn\", b_curve1, \"cas-c1\")).child(gap(4.0))\n            .child(chip(cv2, \"easeOut\", b_curve2, \"cas-c2\")).child(gap(4.0))\n            .child(chip(cv3, \"easeInOut\", b_curve3, \"cas-c3\")).child(gap(12.0))\n            .child(chip(lp, \"Loop\", b_loop, \"cas-loop\")).build())\n        .child(SizedBox(0.0, 16.0).build())\n        .child(Text().text(\"Controls: pause mid-play, change speed/curve, resume\").font_size(10.0).color(0x94A3B8FFu64).build());\n    mount(Container().color(0xF8FAFCFFu64).alignment(ALIGN_CENTER).child(col.build()).build());\n    return progress;\n}\n\n// ---- the animated stage --------------------------------------------------------\n\n// The boa stage: a 360×200 canvas with the card at (100, 20) and the\n// orbiting dot riding its bound anchors (the tick writes\n// cx + r·cos / cy + r·sin of the eased progress).\nfn stage() -> opaque {\n    let orbit_x = stf_take(K_ORBIT_X) as u64;\n    stf_put(K_ORBIT_X, orbit_x as f64);\n    let orbit_y = stf_take(K_ORBIT_Y) as u64;\n    stf_put(K_ORBIT_Y, orbit_y as f64);\n    let dot = Positioned()\n        .left_bound(orbit_x)\n        .top_bound(orbit_y)\n        .child(\n            Container()\n                .width_height(20.0, 20.0)\n                .radius(999.0)\n                .color(GREEN)\n                .shadow(0x22C55E78u64, 16.0, 0.0, 0.0)\n                .query_key(\"cas-dot\")\n                .build(),\n        )\n        .build();\n    return Stack()\n        .child(SizedBox(360.0, 200.0).build())\n        .child(Positioned().left(100.0).top(20.0).child(card()).build())\n        .child(dot)\n        .build();\n}\n\n// The card: width + hue + radius ride their atoms (the tick's write\n// targets); the inner white square pulses its opacity with the progress\n// and SPINS through the bound row — Transform().rotate_bound(progress)\n// re-resolves the angle through the live atom (the subscribe → relayout\n// rail) and the subtree never re-mounts.\nfn card() -> opaque {\n    let width = stf_take(K_WIDTH) as u64;\n    stf_put(K_WIDTH, width as f64);\n    let hue = stf_take(K_HUE) as u64;\n    stf_put(K_HUE, hue as f64);\n    let inner = stf_take(K_INNER) as u64;\n    stf_put(K_INNER, inner as f64);\n    let radius = stf_take(K_RADIUS) as u64;\n    stf_put(K_RADIUS, radius as f64);\n    let progress = stf_take(K_PROGRESS) as u64;\n    stf_put(K_PROGRESS, progress as f64);\n    let square = Container().width_height(60.0, 60.0).color(0xFFFFFFFFu64).radius(12.0).build();\n    let spin = Transform(1.0, 0.0, 0.0, 0.0).rotate_bound(progress).child(square).build();\n    let pulse = Opacity(0.35).bound(inner).child(spin).build();\n    let mut c = Container().width_bound(width).height(160.0).color_bound(hue).radius_bound(radius)\n        .shadow(0x0F172A50u64, 24.0, 0.0, 8.0)\n        .alignment(ALIGN_CENTER)\n        .query_key(\"cas-card\");\n    c.child(pulse);\n    return c.build();\n}\n\n// The status badge: the label bound to the status atom, the fill bound to\n// the badge brush atom.\nfn status_badge() -> opaque {\n    let status = stf_take(K_STATUS) as u64;\n    stf_put(K_STATUS, status as f64);\n    let badge = stf_take(K_BADGE) as u64;\n    stf_put(K_BADGE, badge as f64);\n    let mut b = Container().padding(6.0).radius(999.0).color_bound(badge);\n    b.child(Text().text_bound(status).font_size(10.0).color(0xFFFFFFFFu64).query_key(\"cas-status\").build());\n    return b.build();\n}\n\n// ---- transport entries ---------------------------------------------------------\n\nfn b_play(_a: u64, _b: u64, _n: f64) {\n    let c = st_take(K_CTRL);\n    anim_forward(c);\n    st_put(K_CTRL, c);\n    sync(c);\n}\n\nfn b_pause(_a: u64, _b: u64, _n: f64) {\n    let c = st_take(K_CTRL);\n    anim_pause(c);\n    st_put(K_CTRL, c);\n    sync(c);\n}\n\nfn b_resume(_a: u64, _b: u64, _n: f64) {\n    let c = st_take(K_CTRL);\n    anim_resume(c);\n    st_put(K_CTRL, c);\n    sync(c);\n}\n\nfn b_reverse(_a: u64, _b: u64, _n: f64) {\n    let c = st_take(K_CTRL);\n    anim_reverse(c);\n    st_put(K_CTRL, c);\n    sync(c);\n}\n\nfn b_stop(_a: u64, _b: u64, _n: f64) {\n    let c = st_take(K_CTRL);\n    anim_stop(c);\n    st_put(K_CTRL, c);\n    sync(c);\n}\n\n// Speed retimes the controller in place (no recreate).\nfn b_speed0(_a: u64, _b: u64, _n: f64) { speed_to(0.5, 0.0); }\nfn b_speed1(_a: u64, _b: u64, _n: f64) { speed_to(1.0, 1.0); }\nfn b_speed2(_a: u64, _b: u64, _n: f64) { speed_to(2.0, 2.0); }\nfn b_speed3(_a: u64, _b: u64, _n: f64) { speed_to(4.0, 3.0); }\n\nfn speed_to(factor: f64, idx: f64) {\n    let c = st_take(K_CTRL);\n    anim_speed(c, factor);\n    st_put(K_CTRL, c);\n    paint_speed(idx);\n}\n\n// Curve + loop: the boa recreate-and-seek — a fresh controller over the\n// same progress atom, seeked to the frozen value, swapped into the stash.\nfn b_curve0(_a: u64, _b: u64, _n: f64) { curve_to(0.0); }\nfn b_curve1(_a: u64, _b: u64, _n: f64) { curve_to(1.0); }\nfn b_curve2(_a: u64, _b: u64, _n: f64) { curve_to(2.0); }\nfn b_curve3(_a: u64, _b: u64, _n: f64) { curve_to(3.0); }\n\nfn b_loop(_a: u64, _b: u64, _n: f64) {\n    let prev = stf_take(K_LOOPB);\n    let next = prev <= 0.5;\n    stf_put(K_LOOPB, flag(next));\n    recreate();\n    paint_loop();\n}\n\nfn curve_to(idx: f64) {\n    stf_put(K_CURVE, idx);\n    recreate();\n    paint_curve(idx);\n}\n\n// Swap in a fresh controller (the stashed curve idx + loop flag) seeked\n// to the old one's frozen value.\nfn recreate() {\n    let prev = st_take(K_CTRL);\n    let t = anim_value(prev);\n    let next = make_ctrl();\n    anim_seek(next, t);\n    st_put(K_CTRL, next);\n    sync(next);\n}\n\nfn make_ctrl() -> opaque {\n    let progress = stf_take(K_PROGRESS) as u64;\n    stf_put(K_PROGRESS, progress as f64);\n    let idx = stf_take(K_CURVE);\n    stf_put(K_CURVE, idx);\n    let looping = stf_take(K_LOOPB) > 0.5;\n    stf_put(K_LOOPB, flag(looping));\n    let mut repeat: u64 = 1;\n    if (looping) {\n        repeat = 18446744073709551615.0 as u64; // the infinite crossing\n    }\n    return anim_ctrl(progress, 2400.0, curve_name(idx), repeat, a_tick, a_end);\n}\n\nfn curve_name(idx: f64) -> str {\n    if (idx < 0.5) { return \"linear\"; }\n    if (idx < 1.5) { return \"easeIn\"; }\n    if (idx < 2.5) { return \"easeOut\"; }\n    return \"easeInOut\";\n}\n\nfn flag(b: bool) -> f64 {\n    if (b) { return 1.0; }\n    return 0.0;\n}\n\n// ---- the tick: progress → the animated channels --------------------------------\n\nfn a_tick(_id: u64, v: f64) {\n    let width = stf_take(K_WIDTH) as u64;\n    stf_put(K_WIDTH, width as f64);\n    rs_set_f64(width, tween_lerp(W_MIN, W_MAX, v));\n    let radius = stf_take(K_RADIUS) as u64;\n    stf_put(K_RADIUS, radius as f64);\n    rs_set_f64(radius, tween_lerp(R_MIN, R_MAX, v));\n    let hue = stf_take(K_HUE) as u64;\n    stf_put(K_HUE, hue as f64);\n    rs_set_brush(hue, color_tween_lerp(HUE_MIN, HUE_MAX, v));\n    let inner = stf_take(K_INNER) as u64;\n    stf_put(K_INNER, inner as f64);\n    rs_set_f64(inner, 0.35 + 0.65 * v);\n    let pct = stf_take(K_PCT) as u64;\n    stf_put(K_PCT, pct as f64);\n    rs_set_str(pct, f\"{(v * 100.0) as u64}%\");\n    // The rotation channel: the progress atom IS the bound angle's source\n    // (Transform().rotate_bound reads it reactively) — the tick just\n    // advances it; no list rewrite, no re-mount.\n    let progress = stf_take(K_PROGRESS) as u64;\n    stf_put(K_PROGRESS, progress as f64);\n    rs_set_f64(progress, v);\n    // The orbit: (cx + r·cos, cy + r·sin) of a full turn.\n    let orbit_x = stf_take(K_ORBIT_X) as u64;\n    stf_put(K_ORBIT_X, orbit_x as f64);\n    let orbit_y = stf_take(K_ORBIT_Y) as u64;\n    stf_put(K_ORBIT_Y, orbit_y as f64);\n    rs_set_f64(orbit_x, ORBIT_CX + ORBIT_R * math_cos(TAU * v));\n    rs_set_f64(orbit_y, ORBIT_CY + ORBIT_R * math_sin(TAU * v));\n}\n\nfn a_end(_id: u64, _v: f64) {\n    let c = st_take(K_CTRL);\n    st_put(K_CTRL, c);\n    sync(c);\n}\n\n// Status → the badge label (uppercased, the boa badge) + the fill brush.\nfn sync(c: opaque) {\n    let s = anim_status(c);\n    let status = stf_take(K_STATUS) as u64;\n    stf_put(K_STATUS, status as f64);\n    rs_set_str(status, upper(s));\n    let badge = stf_take(K_BADGE) as u64;\n    stf_put(K_BADGE, badge as f64);\n    rs_set_brush(badge, badge_color(s));\n}\n\nfn upper(s: str) -> str {\n    if (s == \"stopped\") { return \"STOPPED\"; }\n    if (s == \"forward\") { return \"FORWARD\"; }\n    if (s == \"reverse\") { return \"REVERSE\"; }\n    if (s == \"paused\") { return \"PAUSED\"; }\n    if (s == \"completed\") { return \"COMPLETED\"; }\n    return s;\n}\n\nfn badge_color(s: str) -> u64 {\n    if (s == \"forward\" || s == \"reverse\") { return GREEN; }\n    if (s == \"paused\") { return AMBER; }\n    if (s == \"completed\") { return INDIGO; }\n    return SLATE;\n}\n\n// ---- the chip paint helpers (the selected-state brushes) -----------------------\n\nfn paint_speed(sel: f64) {\n    let sp0 = stf_take(K_SP0) as u64;\n    stf_put(K_SP0, sp0 as f64);\n    let sp1 = stf_take(K_SP1) as u64;\n    stf_put(K_SP1, sp1 as f64);\n    let sp2 = stf_take(K_SP2) as u64;\n    stf_put(K_SP2, sp2 as f64);\n    let sp3 = stf_take(K_SP3) as u64;\n    stf_put(K_SP3, sp3 as f64);\n    rs_set_brush(sp0, chip_color(sel == 0.0));\n    rs_set_brush(sp1, chip_color(sel == 1.0));\n    rs_set_brush(sp2, chip_color(sel == 2.0));\n    rs_set_brush(sp3, chip_color(sel == 3.0));\n}\n\nfn paint_curve(sel: f64) {\n    let cv0 = stf_take(K_CV0) as u64;\n    stf_put(K_CV0, cv0 as f64);\n    let cv1 = stf_take(K_CV1) as u64;\n    stf_put(K_CV1, cv1 as f64);\n    let cv2 = stf_take(K_CV2) as u64;\n    stf_put(K_CV2, cv2 as f64);\n    let cv3 = stf_take(K_CV3) as u64;\n    stf_put(K_CV3, cv3 as f64);\n    rs_set_brush(cv0, curve_chip_color(sel == 0.0));\n    rs_set_brush(cv1, curve_chip_color(sel == 1.0));\n    rs_set_brush(cv2, curve_chip_color(sel == 2.0));\n    rs_set_brush(cv3, curve_chip_color(sel == 3.0));\n}\n\nfn paint_loop() {\n    let lp = stf_take(K_LP) as u64;\n    stf_put(K_LP, lp as f64);\n    let on = stf_take(K_LOOPB) > 0.5;\n    stf_put(K_LOOPB, flag(on));\n    rs_set_brush(lp, loop_color(on));\n}\n\nfn chip_color(sel: bool) -> u64 {\n    if (sel) { return CHIP_ON; }\n    return CHIP_OFF;\n}\n\nfn curve_chip_color(sel: bool) -> u64 {\n    if (sel) { return CURVE_ON; }\n    return CHIP_OFF;\n}\n\nfn loop_color(on: bool) -> u64 {\n    if (on) { return LOOP_ON; }\n    return CHIP_OFF;\n}\n\n// ---- the builders ---------------------------------------------------------------\n\n// A transport pill (the boa Button): a PointerInteract pad over a colored\n// label.\nfn pill(label: str, color: u64, cb: fn(u64, u64, f64), key: str) -> opaque {\n    let mut b = Container().padding(8.0).radius(6.0).color(color).query_key(key);\n    b.child(Text().text(label).font_size(11.0).color(0xFFFFFFFFu64).build());\n    return PointerInteract().on_tap(cb).child(b.build()).build();\n}\n\n// A selectable chip (speed / curve / loop): the fill rides its brush atom.\nfn chip(atom: u64, label: str, cb: fn(u64, u64, f64), key: str) -> opaque {\n    let mut b = Container().padding(6.0).radius(6.0).color_bound(atom).query_key(key);\n    b.child(Text().text(label).font_size(10.0).color(0x475569FFu64).build());\n    return PointerInteract().on_tap(cb).child(b.build()).build();\n}\n\nfn gap(w: f64) -> opaque {\n    return Container().width_height(w, 0.0).build();\n}\n";
    }
    if (name == "countdown") {
        return "// countdown: a 1 Hz countdown with start/pause/reset, an edit modal (a\n// pre-filled Input + confirm), and a ticking display derived from the\n// remaining atom. The ticker is an async loop over `sleep(1000)` with a\n// generation guard (a stale loop exits when a new start supersedes it).\n// State atom ids ride the scalar stash (stf_*).\n//\n// The boa design: a light slate page with the 96px display centered in\n// the pane, a \"● Ready/Running\" status pill, a big emerald Start that\n// swaps to an amber Pause (a Condition on the running atom; the Start\n// label re-derives to \"Restart\" once drained), ghost Edit/Reset buttons,\n// and a scrim modal. The modal rides `then_build(edit_modal)` — the\n// branch builder runs at ACTIVATION, so it mints the text controller\n// pre-filled with the live `initial` (the old boot-time pre-build +\n// `b_edit` re-seed workaround is gone).\nuse futures::{ launch_future, sleep };\nuse tur::{\n    ALIGN_CENTER, BORDER_INSIDE, CROSS_ALIGN_CENTER, CROSS_ALIGN_STRETCH, CURSOR_POINTER,\n    HIT_TEST_OPAQUE, MAIN_ALIGN_END, MAIN_SIZE_MIN, STACK_FIT_EXPAND, mem_get, mem_new, mem_set,\n    mount, rs_get_bool, rs_get_f64, rs_set_bool, rs_set_f64, rs_source_bool, rs_source_f64,\n    st_put, st_take, stf_put, stf_take, str_parse_f64, tctrl_new, tctrl_set_text, tctrl_text,\n    undo_new,\n};\nuse tur_kit::{\n    Column, Condition, Container, Input, MouseRegion, PointerInteract, Row, SizedBox, Stack, Text,\n    rs_derive,\n};\n\n\nlet K_CTRL: u64 = 2;\nlet K_EDITING: u64 = 4;\nlet K_INITIAL: u64 = 5;\nlet K_GEN: u64 = 6;\nlet K_RUNNING: u64 = 7;\nlet K_REMAINING: u64 = 8;\n\n// The light-slate palette (the boa countdown).\nlet PAGE_BG: u64 = 0xF8FAFCFFu64;\nlet CARD_BG: u64 = 0xFFFFFFFFu64;\nlet CARD_BORDER: u64 = 0xE2E8F0FFu64;\nlet TEXT: u64 = 0x0F172AFFu64;\nlet TEXT_MUTED: u64 = 0x64748BFFu64;\nlet TEXT_FAINT: u64 = 0x94A3B8FFu64;\nlet BTN_FG: u64 = 0xFFFFFFFFu64;\nlet START: u64 = 0x10B981FFu64;\nlet START_SHADOW: u64 = 0x10B9815Au64;\nlet PAUSE: u64 = 0xF59E0BFFu64;\nlet PAUSE_SHADOW: u64 = 0xF59E0B5Au64;\nlet BACKDROP: u64 = 0x0F172A6Eu64;\n\nentry fn start() -> u64 {\n    let remaining = rs_source_f64();\n    rs_set_f64(remaining, 60.0);\n    let initial = rs_source_f64();\n    rs_set_f64(initial, 60.0);\n    let running = rs_source_bool(false);\n    let editing = rs_source_bool(false);\n    stf_put(K_REMAINING, remaining as f64);\n    stf_put(K_INITIAL, initial as f64);\n    stf_put(K_RUNNING, running as f64);\n    stf_put(K_EDITING, editing as f64);\n\n    let display = rs_derive(fmt_display, remaining);\n    let start_label = rs_derive(fmt_start_label, remaining);\n\n    st_put(K_GEN, mem_new(0.0));\n\n    let edit_button = ghost_button(\"btn-edit\", \"Edit\", b_edit, initial, editing);\n    let reset_button = ghost_button(\"btn-reset\", \"Reset\", b_reset, initial, remaining);\n\n    // The primary action: amber Pause while running, emerald\n    // Start/Restart otherwise (the label re-derives over `remaining`).\n    let primary = Condition(running)\n        .then_build(fn () -> View { return pad(\"btn-pause\", \"Pause\", PAUSE, PAUSE_SHADOW, b_pause); })\n        .else_build(fn () -> View { return start_pad(start_label, b_start); })\n        .build();\n\n    // The status pill: a green dot + \"Running\" while ticking, muted +\n    // \"Ready\" otherwise.\n    let status = Condition(running)\n        .then_build(fn () -> View { return chip_status(true); })\n        .else_build(fn () -> View { return chip_status(false); })\n        .build();\n\n    // The edit modal overlays the pane while `editing` is set.\n    let modal = Condition(editing)\n        .then_build(fn () -> View { return edit_modal(); })\n        .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })\n        .build();\n\n    let pane = Column()\n        .main_axis_size(MAIN_SIZE_MIN)\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Text().text(\"COUNTDOWN\").font_size(11.0).color(TEXT_FAINT).build())\n        .child(SizedBox(0.0, 10.0).build())\n        .child(Text().text_bound_derived(display).font_size(96.0).color(TEXT).query_key(\"display\").build())\n        .child(SizedBox(0.0, 12.0).build())\n        .child(status)\n        .child(SizedBox(0.0, 36.0).build())\n        .child(primary)\n        .child(SizedBox(0.0, 12.0).build())\n        .child(\n            Row()\n                .main_axis_size(MAIN_SIZE_MIN)\n                .cross_alignment(CROSS_ALIGN_CENTER)\n                .child(edit_button)\n                .child(SizedBox(10.0, 0.0).build())\n                .child(reset_button)\n                .build(),\n        )\n        .build();\n\n    // The pane centered in the viewer; the modal overlays it when open.\n    let page = Container().color(PAGE_BG).alignment(ALIGN_CENTER).child(pane).build();\n    mount(Stack().fit(STACK_FIT_EXPAND).child(page).child(modal).build());\n    return remaining;\n}\n\n// ---- the styled pieces -------------------------------------------------------\n\n// The big rounded primary button (the boa PrimaryButton).\nfn pad(key: str, label: str, bg: u64, shade: u64, cb: fn(u64, u64, f64)) -> opaque {\n    let face = Container()\n        .width_height(220.0, 48.0)\n        .radius(12.0)\n        .color(bg)\n        .shadow(shade, 14.0, 0.0, 6.0)\n        .alignment(ALIGN_CENTER)\n        .child(Text().text(label).font_size(15.0).color(BTN_FG).build())\n        .build();\n    return PointerInteract()\n        .on_tap(cb)\n        .query_key(key)\n        .child(face)\n        .build();\n}\n\n// The Start pad: the label rides the derive (\"Restart\" once drained).\nfn start_pad(label_atom: u64, cb: fn(u64, u64, f64)) -> opaque {\n    let face = Container()\n        .width_height(220.0, 48.0)\n        .radius(12.0)\n        .color(START)\n        .shadow(START_SHADOW, 14.0, 0.0, 6.0)\n        .alignment(ALIGN_CENTER)\n        .child(Text().text_bound_derived(label_atom).font_size(15.0).color(BTN_FG).build())\n        .build();\n    return PointerInteract()\n        .on_tap(cb)\n        .query_key(\"btn-start\")\n        .child(face)\n        .build();\n}\n\n// The bordered ghost button (the boa GhostButton).\nfn ghost_button(key: str, label: str, cb: fn(u64, u64, f64), a: u64, b: u64) -> opaque {\n    let face = Container()\n        .padding(10.0)\n        .radius(10.0)\n        .border(CARD_BORDER, 1.0, BORDER_INSIDE)\n        .color(CARD_BG)\n        .child(Text().text(label).font_size(13.0).color(TEXT_MUTED).build())\n        .build();\n    return MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(\n            PointerInteract()\n                .ids(a, b)\n                .on_tap(cb)\n                .query_key(key)\n                .child(face)\n                .build(),\n        )\n        .build();\n}\n\n// The \"● Ready/Running\" pill: a dot + label in a bordered capsule.\nfn chip_status(running: bool) -> opaque {\n    let mut dot: u64 = TEXT_MUTED;\n    let mut label: str = \"Ready\";\n    if (running) {\n        dot = START;\n        label = \"Running\";\n    }\n    return Container()\n        .padding(6.0)\n        .radius(999.0)\n        .border(CARD_BORDER, 1.0, BORDER_INSIDE)\n        .color(CARD_BG)\n        .child(\n            Row()\n                .main_axis_size(MAIN_SIZE_MIN)\n                .cross_alignment(CROSS_ALIGN_CENTER)\n                .child(Container().width_height(7.0, 7.0).radius(999.0).color(dot).build())\n                .child(SizedBox(6.0, 0.0).build())\n                .child(Text().text(label).font_size(11.0).color(TEXT_MUTED).build())\n                .build(),\n        )\n        .build();\n}\n\n// The edit modal: a dimmed scrim (tap = cancel) around the card; the card\n// swallows its own taps. Runs at ACTIVATION — the controller is minted\n// fresh and pre-filled with the live `initial`.\nfn edit_modal() -> opaque {\n    let initial = stf_take(K_INITIAL) as u64;\n    stf_put(K_INITIAL, initial as f64);\n    let ctrl = tctrl_new();\n    tctrl_set_text(ctrl, f\"{rs_get_f64(initial) as u64}\");\n    st_put(K_CTRL, ctrl);\n\n    let undo = undo_new();\n    let field = Input()\n        .controller(ctrl)\n        .undo(undo)\n        .placeholder(\"Positive integer\")\n        .font_size(14.0)\n        .width_height(332.0, 32.0)\n        .query_key(\"edit-input\")\n        .build();\n\n    let card = Container()\n        .width(380.0)\n        .radius(14.0)\n        .padding(22.0)\n        .color(CARD_BG)\n        .border(CARD_BORDER, 1.0, BORDER_INSIDE)\n        .child(\n            Column()\n                .main_axis_size(MAIN_SIZE_MIN)\n                .cross_alignment(CROSS_ALIGN_STRETCH)\n                .child(Text().text(\"Set duration\").font_size(18.0).color(TEXT).build())\n                .child(SizedBox(0.0, 6.0).build())\n                .child(Text().text(\"Enter a positive integer (seconds).\").font_size(13.0).color(TEXT_MUTED).build())\n                .child(SizedBox(0.0, 16.0).build())\n                .child(\n                    Container()\n                        .padding(4.0)\n                        .radius(8.0)\n                        .border(CARD_BORDER, 1.0, BORDER_INSIDE)\n                        .child(field)\n                        .build(),\n                )\n                .child(SizedBox(0.0, 18.0).build())\n                .child(\n                    Row()\n                        .main_alignment(MAIN_ALIGN_END)\n                        .main_axis_size(MAIN_SIZE_MIN)\n                        .child(ghost_button(\"btn-cancel\", \"Cancel\", b_cancel, 0, 0))\n                        .child(SizedBox(8.0, 0.0).build())\n                        .child(\n                            MouseRegion()\n                                .cursor(CURSOR_POINTER)\n                                .child(\n                                    PointerInteract()\n                                        .on_tap(b_confirm)\n                                        .query_key(\"btn-confirm\")\n                                        .child(\n                                            Container()\n                                                .width_height(220.0, 48.0)\n                                                .radius(12.0)\n                                                .color(START)\n                                                .shadow(START_SHADOW, 14.0, 0.0, 6.0)\n                                                .alignment(ALIGN_CENTER)\n                                                .child(Text().text(\"Save\").font_size(15.0).color(BTN_FG).build())\n                                                .build(),\n                                        )\n                                        .build(),\n                                )\n                                .build(),\n                        )\n                        .build(),\n                )\n                .build(),\n        )\n        .build();\n\n    let inner = PointerInteract()\n        .behavior(HIT_TEST_OPAQUE)\n        .on_tap(b_swallow)\n        .child(card)\n        .build();\n    let scrim = Container()\n        .color(BACKDROP)\n        .alignment(ALIGN_CENTER)\n        .child(inner)\n        .build();\n    return PointerInteract()\n        .behavior(HIT_TEST_OPAQUE)\n        .on_tap(b_cancel)\n        .query_key(\"edit-modal\")\n        .child(scrim)\n        .build();\n}\n\n// ---- the display + label derives ----------------------------------------------\n\n// \"m:ss\" display format.\nfn fmt_display(v: f64) -> str {\n    let total = v as u64;\n    let m = total / 60;\n    let s = total % 60;\n    if (s < 10) {\n        return f\"{m}:0{s}\";\n    }\n    return f\"{m}:{s}\";\n}\n\n// The primary label under the else branch: \"Restart\" once drained.\nfn fmt_start_label(v: f64) -> str {\n    if (v == 0.0) {\n        return \"Restart\";\n    }\n    return \"Start\";\n}\n\n// ---- the 1 Hz ticker ------------------------------------------------------------\n\n// `g` pins the generation: a stale loop (superseded by a later start /\n// pause) exits without ticking. The running-atom id is taken and restored\n// IMMEDIATELY — the slot must stay populated across the awaits, or a tap\n// handler firing mid-tick reads an empty slot (0) and writes to atom 0.\nasync fn ticker(g: f64) -> str {\n    let running = stf_take(K_RUNNING) as u64;\n    stf_put(K_RUNNING, running as f64);\n    while (rs_get_bool(running)) {\n        await sleep(1000);\n        if (gen_read() != g) {\n            return \"\";\n        }\n        if (!rs_get_bool(running)) {\n            return \"\";\n        }\n        let remaining = stf_take(K_REMAINING) as u64;\n        stf_put(K_REMAINING, remaining as f64);\n        let r = rs_get_f64(remaining);\n        if (r <= 1.0) {\n            rs_set_f64(remaining, 0.0);\n            rs_set_bool(running, false);\n            return \"\";\n        }\n        rs_set_f64(remaining, r - 1.0);\n    }\n    return \"\";\n}\n\nfn gen_read() -> f64 {\n    let cell = st_take(K_GEN);\n    let v = mem_get(cell);\n    st_put(K_GEN, cell);\n    return v;\n}\n\nfn gen_bump() -> f64 {\n    let cell = st_take(K_GEN);\n    let g = mem_get(cell) + 1.0;\n    mem_set(cell, g);\n    st_put(K_GEN, cell);\n    return g;\n}\n\n// ---- the taps -------------------------------------------------------------------\n\nfn b_start(_a: u64, _b: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    if (rs_get_bool(running)) {\n        stf_put(K_RUNNING, running as f64);\n        return;\n    }\n    rs_set_bool(running, true);\n    stf_put(K_RUNNING, running as f64);\n    launch_future(ticker(gen_bump()));\n}\n\nfn b_pause(_a: u64, _b: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n}\n\nfn b_reset(initial: u64, remaining: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n    rs_set_f64(remaining, rs_get_f64(initial));\n}\n\n// Open the editor: stop the clock; the modal branch builds fresh (and\n// pre-seeds its controller) at activation.\nfn b_edit(initial: u64, editing: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n    rs_set_bool(editing, true);\n}\n\nfn b_cancel(_a: u64, _b: u64, _n: f64) {\n    let editing = stf_take(K_EDITING) as u64;\n    rs_set_bool(editing, false);\n    stf_put(K_EDITING, editing as f64);\n}\n\n// Clicks inside the card stop at the card (the scrim's cancel never sees them).\nfn b_swallow(_a: u64, _b: u64, _n: f64) {}\n\nfn b_confirm(_a: u64, _b: u64, _n: f64) {\n    let ctrl = st_take(K_CTRL);\n    let v = str_parse_f64(tctrl_text(ctrl));\n    let initial = stf_take(K_INITIAL) as u64;\n    rs_set_f64(initial, v);\n    stf_put(K_INITIAL, initial as f64);\n    let remaining = stf_take(K_REMAINING) as u64;\n    rs_set_f64(remaining, v);\n    stf_put(K_REMAINING, remaining as f64);\n    let editing = stf_take(K_EDITING) as u64;\n    rs_set_bool(editing, false);\n    stf_put(K_EDITING, editing as f64);\n}\n";
    }
    if (name == "counter") {
        return "// counter: a reactive count label between -/+ pill buttons — the full\n// interactive loop (button → intent entry → atom write → re-render),\n// dressed to the boa design: the slate page, the 36px \"Count: N\" readout\n// (a derive over the count atom) and the centered 100×44 indigo pill row.\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, MAIN_ALIGN_CENTER, mount, rs_derive, rs_get_f64,\n    rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Column, Container, PointerInteract, Row, SizedBox, Text };\n\n\nentry fn start() -> u64 {\n    let count = rs_source_f64();\n    let label = rs_derive(fmt_count, count);\n\n    let col = Column()\n        .main_alignment(MAIN_ALIGN_CENTER)\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Text().text_bound_derived(label).query_key(\"count\").font_size(36.0).color(0x1E293BFFu64).build())\n        .child(\n            Row()\n                .main_alignment(MAIN_ALIGN_CENTER)\n                .child(button(count, ts_dec, \"-1\", \"dec\"))\n                .child(SizedBox(12.0, 0.0).build())\n                .child(button(count, ts_inc, \"+1\", \"inc\"))\n                .build(),\n        )\n        .build();\n\n    // The boa page: the slate fill centers the column in the pane.\n    mount(Container().color(0xF8FAFCFFu64).alignment(ALIGN_CENTER).child(col).build());\n    return count;\n}\n\n// A 100x44 indigo pill with a centered label.\nfn button(count: u64, cb: fn(u64, u64, f64), text: str, key: str) -> opaque {\n    let b = Container()\n        .width_height(100.0, 44.0)\n        .radius(8.0)\n        .color(0x6366F1FFu64)\n        .alignment(ALIGN_CENTER)\n        .query_key(key)\n        .child(Text().text(text).font_size(18.0).color(0xFFFFFFFFu64).build());\n    return PointerInteract().ids(count, count).on_tap(cb).child(b.build()).build();\n}\n\n// \"Count: N\" off the live count atom.\nfn fmt_count(v: f64) -> str {\n    return f\"Count: {v as u64}\";\n}\n\nfn ts_inc(count: u64, _b: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n}\n\nfn ts_dec(count: u64, _b: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) - 1.0);\n}\n";
    }
    if (name == "github-viewer") {
        return "// github-viewer: browse a public GitHub repo — landing form (\"owner/repo\"\n// + quick-pick chips), a loading state, and an explorer (breadcrumb,\n// stats, the directory listing with per-row taps, a selection footer).\n// Single-file port of the boa TSX original (a 6-file case: index/landing/\n// explorer/state/theme/ui — the explorer view is inlined here).\n//\n// Host surface: `net_request` (the async capability row) rides the rut\n// weave (`launch_future` + `await`), exactly like the countdown ticker.\n// GitHub's REST API is CORS-friendly, so the wasm build fetches it\n// directly. Degradation: an empty response body (the net row completes\n// empty on transport failure) becomes a visible error banner; a JSON\n// error payload (404 / rate limit) surfaces the API's own message.\n//\n// JSON: the engine ships no parse row, so the two payloads the case\n// reads (the repo meta object + the contents array of flat objects) are\n// scanned by a tiny cursor parser below — `json_get_str` (one object's\n// scalar field) and `json_contents` (an array walk into a display list).\n// Escapes decode the common pairs; `\\uXXXX` mints U+FFFD.\n//\n// Rust-boundary notes for future editors: unannotated float locals are\n// `f32` by the default-width rule (annotate `: f64` when handing them to\n// rows), and f-string braces take no nested string literals (bind a\n// local first).\nuse futures::launch_future;\nuse tur::{\n    ALIGN_CENTER, AXIS_VERTICAL, BORDER_INSIDE, CROSS_ALIGN_CENTER, CROSS_ALIGN_STRETCH,\n    CROSS_ALIGN_START, MAIN_ALIGN_END, MAIN_SIZE_MIN, img_res_svg, mount, net_request, rs_get_str,\n    rs_get_value, rs_list_new, rs_list_push, rs_set_bool, rs_set_str, rs_set_value,\n    rs_source_bool, rs_source_f64, rs_source_str, rs_source_value, rs_value_item, st_put, st_take,\n    stf_put, stf_take, str_parse_f64, tctrl_new, tctrl_set_text, tctrl_text, undo_new,\n};\nuse tur_kit::{ Column, Condition, Container, Each, Expanded, Image, Input, PointerInteract, Row, ScrollView, SizedBox, Switch, Text };\n\n\n// The scalar-stash keys (atom ids + the text controller ride them).\nlet K_MODE: u64 = 1;\nlet K_ERR: u64 = 2;\nlet K_ERRHAS: u64 = 3;\nlet K_REPO: u64 = 4;\nlet K_DESC: u64 = 5;\nlet K_STATS: u64 = 6;\nlet K_PATH: u64 = 7;\nlet K_SEL: u64 = 8;\nlet K_FILES: u64 = 9;\nlet K_EMPTY: u64 = 10;\nlet K_CTRL: u64 = 20;\nlet K_UNDO: u64 = 21;\nlet K_ICO_GH: u64 = 22;\n\n// The octocat brand mark (the boa state.ts GitHub glyph, rasterised\n// through the image rail).\nlet SVG_GITHUB: str = \"<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='#4f46e5'><path d='M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z'/></svg>\";\n\n// The boa theme (Notion / Linear-style light palette).\nlet PAGE_BG: u64 = 0xF8FAFCFFu64;\nlet PANEL: u64 = 0xFFFFFFFFu64;\nlet BORDER: u64 = 0xE2E8F0FFu64;\nlet TEXT: u64 = 0x0F172AFFu64;\nlet TEXT_MUTED: u64 = 0x64748BFFu64;\nlet TEXT_SUBTLE: u64 = 0x94A3B8FFu64;\nlet ACCENT: u64 = 0x4F46E5FFu64;\nlet ACCENT_SOFT: u64 = 0xEEF2FFFFu64;\nlet ACCENT_FG: u64 = 0xFFFFFFFFu64;\nlet DANGER: u64 = 0xEF4444FFu64;\nlet DANGER_SOFT: u64 = 0xFEF2F2FFu64;\nlet SUBTLE_BUTTON: u64 = 0xF1F5F9FFu64;\nlet SUBTLE_BUTTON_FG: u64 = 0x334155FFu64;\nlet INPUT_BG: u64 = 0xF8FAFCFFu64;\nlet INPUT_BORDER: u64 = 0xCBD5E1FFu64;\nlet DIR_ICON: u64 = 0x6366F1FFu64;\nlet FILE_ICON: u64 = 0x94A3B8FFu64;\n\n// ASCII codepoints the scanner compares against (typed so the literals\n// land on `u32`).\nlet C_QUOTE: u32 = 34;\nlet C_COMMA: u32 = 44;\nlet C_COLON: u32 = 58;\nlet C_PIPE: u32 = 124;\nlet C_SPACE: u32 = 32;\nlet C_SLASH: u32 = 47;\nlet C_BACKSLASH: u32 = 92;\nlet C_LBRACE: u32 = 123;\nlet C_RBRACE: u32 = 125;\nlet C_LBRACKET: u32 = 91;\nlet C_RBRACKET: u32 = 93;\n\nentry fn start() -> u64 {\n    let mode = rs_source_str(\"landing\");\n    let err = rs_source_str(\"\");\n    let err_has = rs_source_bool(false);\n    let repo_full = rs_source_str(\"\");\n    let desc = rs_source_str(\"\");\n    let stats = rs_source_str(\"\");\n    let path = rs_source_str(\"\");\n    let selected = rs_source_str(\"\");\n    let files = rs_source_value(rs_list_new());\n    let is_empty = rs_source_bool(false);\n    stf_put(K_MODE, mode as f64);\n    stf_put(K_ERR, err as f64);\n    stf_put(K_ERRHAS, err_has as f64);\n    stf_put(K_REPO, repo_full as f64);\n    stf_put(K_DESC, desc as f64);\n    stf_put(K_STATS, stats as f64);\n    stf_put(K_PATH, path as f64);\n    stf_put(K_SEL, selected as f64);\n    stf_put(K_FILES, files as f64);\n    stf_put(K_EMPTY, is_empty as f64);\n    let ctrl = tctrl_new();\n    // The boa landing boots with the draft pre-filled.\n    tctrl_set_text(ctrl, \"facebook/react\");\n    st_put(K_CTRL, ctrl);\n    st_put(K_UNDO, undo_new());\n    stf_put(K_ICO_GH, img_res_svg(SVG_GITHUB) as f64);\n\n    let body = Switch()\n        .value_source(mode)\n        .query_key(\"gh-body\")\n        .cases(\"landing\", landing_view())\n        .cases(\"loading\", loading_view())\n        .cases(\"explorer\", explorer_view())\n        .build();\n    let page = Container().color(PAGE_BG).padding(22.0).child(body).build();\n    let root = Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .child(Expanded().flex(1.0).child(page).build())\n        .build();\n    mount(root);\n    return mode;\n}\n\n// ---- shared chrome ---------------------------------------------------------\n\n// A compact pill button (the boa Button/IconButton composite).\nfn pill(key: str, label: str, cb: fn(u64, u64, f64), a: u64, bg: u64, fg: u64) -> opaque {\n    let face = Container()\n        .padding(9.0)\n        .radius(8.0)\n        .color(bg)\n        .child(Text().text(label).font_size(13.0).color(fg).build())\n        .build();\n    return PointerInteract()\n        .ids(a, a)\n        .on_tap(cb)\n        .query_key(key)\n        .child(face)\n        .build();\n}\n\n// The error banner row (a visible failure state on landing + explorer).\nfn error_banner() -> opaque {\n    let err = stf_take(K_ERR) as u64;\n    let err_has = stf_take(K_ERRHAS) as u64;\n    stf_put(K_ERR, err as f64);\n    stf_put(K_ERRHAS, err_has as f64);\n    let banner = Container()\n        .padding(10.0)\n        .radius(8.0)\n        .color(DANGER_SOFT)\n        .child(Text().text_bound(err).font_size(12.0).color(DANGER).query_key(\"gh-err\").build())\n        .build();\n    return Condition(err_has).then(banner).else_branch(SizedBox(0.0, 0.0).build()).build();\n}\n\n// ---- landing ---------------------------------------------------------------\n\nfn landing_view() -> opaque {\n    let err_has = stf_take(K_ERRHAS) as u64;\n    stf_put(K_ERRHAS, err_has as f64);\n    let ctrl = st_take(K_CTRL);\n    let undo = st_take(K_UNDO);\n    // The boa Field: the \"Repository\" caption over the bordered input.\n    let field = Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(Text().text(\"Repository\").font_size(11.0).color(TEXT_SUBTLE).query_key(\"gh-field-label\").build())\n        .child(SizedBox(0.0, 6.0).build())\n        .child(\n            Container()\n                .radius(7.0)\n                .padding(9.0)\n                .color(INPUT_BG)\n                .border(INPUT_BORDER, 1.0, BORDER_INSIDE)\n                .child(\n                    Input()\n                        .controller(ctrl)\n                        .undo(undo)\n                        .placeholder(\"facebook/react\")\n                        .font_size(14.0)\n                        .width_height(0.0, 22.0)\n                        .query_key(\"gh-input\")\n                        .build(),\n                )\n                .build(),\n        )\n        .build();\n    st_put(K_CTRL, ctrl);\n    st_put(K_UNDO, undo);\n    // Fixed 360 card (the boa card capped at `min(440, vw - 44)`; the\n    // playground's viewer pane is ~390 of content — 440 overflows it).\n    let card = Container()\n        .width(360.0)\n        .padding(34.0)\n        .radius(14.0)\n        .color(PANEL)\n        .border(BORDER, 1.0, BORDER_INSIDE)\n        .child(\n            Column()\n                .cross_alignment(CROSS_ALIGN_START)\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(brand_mark())\n                .child(SizedBox(0.0, 18.0).build())\n                .child(Text().text(\"Browse a public repo\").font_size(18.0).color(TEXT).build())\n                .child(SizedBox(0.0, 6.0).build())\n                .child(Text().text(\"Enter a repo as \\\"owner/name\\\" to explore its files.\").font_size(13.0).color(TEXT_MUTED).build())\n                .child(SizedBox(0.0, 20.0).build())\n                .child(field)\n                .child(SizedBox(0.0, 8.0).build())\n                .child(error_banner())\n                .child(SizedBox(0.0, 8.0).build())\n                .child(Row().main_alignment(MAIN_ALIGN_END).child(pill(\"gh-browse\", \"Browse\", b_browse, 0, ACCENT, ACCENT_FG)).build())\n                .child(SizedBox(0.0, 22.0).build())\n                .child(Text().text(\"Try one of these\").font_size(11.0).color(TEXT_SUBTLE).build())\n                .child(SizedBox(0.0, 8.0).build())\n                .child(suggestion_row())\n                .build(),\n        )\n        .build();\n    return Container().alignment(ALIGN_CENTER).child(card).build();\n}\n\n// The 40x40 rounded brand mark (the boa octocat badge, an inline SVG\n// through the image rail).\nfn brand_mark() -> opaque {\n    let gh = stf_take(K_ICO_GH) as u64;\n    stf_put(K_ICO_GH, gh as f64);\n    let mark = Container()\n        .width_height(40.0, 40.0)\n        .radius(10.0)\n        .color(ACCENT_SOFT)\n        .alignment(ALIGN_CENTER)\n        .child(Image(gh).width(24.0).height(24.0).query_key(\"gh-mark\").build())\n        .build();\n    return mark;\n}\n\nfn suggestion_row() -> opaque {\n    // Stacked (the boa mobile variant) — the three chips overflow the\n    // 360 card's content width in a row. The boa quick-pick set (all\n    // under jsDelivr's 50 MB tree cap).\n    return Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(pill(\"gh-sug-0\", \"facebook/react\", b_sug, 0, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))\n        .child(SizedBox(0.0, 6.0).build())\n        .child(pill(\"gh-sug-1\", \"tailwindlabs/tailwindcss\", b_sug, 1, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))\n        .child(SizedBox(0.0, 6.0).build())\n        .child(pill(\"gh-sug-2\", \"vuejs/core\", b_sug, 2, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))\n        .build();\n}\n\n// ---- loading ---------------------------------------------------------------\n\nfn loading_view() -> opaque {\n    return Container()\n        .alignment(ALIGN_CENTER)\n        .child(Text().text(\"Loading…\").font_size(13.0).color(TEXT_SUBTLE).query_key(\"gh-loading\").build())\n        .build();\n}\n\n// ---- explorer --------------------------------------------------------------\n\nfn explorer_view() -> opaque {\n    let repo_full = stf_take(K_REPO) as u64;\n    let desc = stf_take(K_DESC) as u64;\n    let path = stf_take(K_PATH) as u64;\n    let stats = stf_take(K_STATS) as u64;\n    let selected = stf_take(K_SEL) as u64;\n    let is_empty = stf_take(K_EMPTY) as u64;\n    stf_put(K_REPO, repo_full as f64);\n    stf_put(K_DESC, desc as f64);\n    stf_put(K_PATH, path as f64);\n    stf_put(K_STATS, stats as f64);\n    stf_put(K_SEL, selected as f64);\n    stf_put(K_EMPTY, is_empty as f64);\n    let list = ScrollView()\n        .axis(AXIS_VERTICAL)\n        .child(\n            Column()\n                .cross_alignment(CROSS_ALIGN_STRETCH)\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(Each(files).item_builder(item_file).build())\n                .build(),\n        )\n        .build();\n    let empty = Container()\n        .alignment(ALIGN_CENTER)\n        .padding(40.0)\n        .child(\n            Column()\n                .cross_alignment(CROSS_ALIGN_CENTER)\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(Text().text(\"This folder is empty\").font_size(14.0).color(TEXT).build())\n                .child(SizedBox(0.0, 6.0).build())\n                .child(Text().text(\"No files to show at this path.\").font_size(12.0).color(TEXT_SUBTLE).build())\n                .build(),\n        )\n        .build();\n    return Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .child(\n            Row()\n                .cross_alignment(CROSS_ALIGN_CENTER)\n                .child(pill(\"gh-back\", \"Back\", b_back, 0, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))\n                .child(SizedBox(10.0, 0.0).build())\n                .child(Text().text_bound(repo_full).font_size(13.0).font_weight(600.0).color(ACCENT).query_key(\"gh-crumb\").build())\n                .child(SizedBox(6.0, 0.0).build())\n                .child(Text().text_bound(path).font_size(13.0).color(TEXT_SUBTLE).query_key(\"gh-path\").build())\n                .build(),\n        )\n        .child(SizedBox(0.0, 4.0).build())\n        .child(Text().text_bound(desc).font_size(12.0).color(TEXT_MUTED).query_key(\"gh-desc\").build())\n        .child(SizedBox(0.0, 8.0).build())\n        .child(error_banner())\n        .child(SizedBox(0.0, 8.0).build())\n        .child(\n            Row()\n                .cross_alignment(CROSS_ALIGN_CENTER)\n                .child(pill(\"gh-refresh\", \"Refresh\", b_refresh, 0, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))\n                .child(SizedBox(10.0, 0.0).build())\n                .child(Text().text_bound(stats).font_size(12.0).color(TEXT_MUTED).query_key(\"gh-stats\").build())\n                .build(),\n        )\n        .child(SizedBox(0.0, 8.0).build())\n        .child(Expanded().flex(1.0).child(Condition(is_empty).then(empty).else_branch(list).build()).build())\n        .child(\n            Container()\n                .padding(6.0)\n                .child(Text().text_bound(selected).font_size(12.0).color(TEXT_SUBTLE).query_key(\"gh-selected\").build())\n                .build(),\n        )\n        .build();\n}\n\n// One listing row: icon square + name + size (dirs sort first — the two\n// array passes below order them).\nfn item_file(i: u64, s: str) -> opaque {\n    let is_dir = s.starts_with(0, \"d|\");\n    let n = s.len();\n    let mut name = \"\";\n    let mut size_txt = \"\";\n    if (is_dir) {\n        name = s.slice(2, n);\n    } else {\n        let mut k = 2;\n        while (k < n) {\n            if (s.code_at(k) == C_PIPE) {\n                break;\n            }\n            k = k + 1;\n        }\n        name = s.slice(2, k);\n        size_txt = fmt_size(s.slice(k + 1, n));\n    }\n    let mut icon = DIR_ICON;\n    if (!is_dir) {\n        icon = FILE_ICON;\n    }\n    let row = Row()\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Container().width_height(14.0, 14.0).radius(3.0).color(icon).build())\n        .child(SizedBox(10.0, 0.0).build())\n        .child(Expanded().flex(1.0).child(Text().text(name).font_size(13.0).color(TEXT).build()).build())\n        .child(SizedBox(10.0, 0.0).build())\n        .child(Text().text(size_txt).font_size(11.0).color(TEXT_SUBTLE).build())\n        .build();\n    let card = Container()\n        .padding(9.0)\n        .radius(8.0)\n        .color(PANEL)\n        .border(BORDER, 1.0, BORDER_INSIDE)\n        .child(row)\n        .build();\n    return PointerInteract()\n        .ids(i, i)\n        .on_tap(b_row)\n        .query_key(\"gh-row\")\n        .child(card)\n        .build();\n}\n\n// ---- actions ---------------------------------------------------------------\n\n// The Browse tap: read the draft, validate the owner/name shape, launch.\nfn b_browse(_a: u64, _b: u64, _n: f64) {\n    let ctrl = st_take(K_CTRL);\n    let draft = tctrl_text(ctrl);\n    st_put(K_CTRL, ctrl);\n    open_draft(draft);\n}\n\n// A quick-pick chip: pre-fill the field and open directly.\nfn b_sug(a: u64, _b: u64, _n: f64) {\n    let ctrl = st_take(K_CTRL);\n    let mut name = \"facebook/react\";\n    if (a == 1) {\n        name = \"tailwindlabs/tailwindcss\";\n    } else if (a == 2) {\n        name = \"vuejs/core\";\n    }\n    tctrl_set_text(ctrl, name);\n    st_put(K_CTRL, ctrl);\n    open_draft(name);\n}\n\n// Back: up one directory, or back to the landing when at the root.\nfn b_back(_a: u64, _b: u64, _n: f64) {\n    let path = stf_take(K_PATH) as u64;\n    let selected = stf_take(K_SEL) as u64;\n    let cur = rs_get_str(path);\n    if (cur == \"\") {\n        stf_put(K_PATH, path as f64);\n        stf_put(K_SEL, selected as f64);\n        go_landing();\n        return;\n    }\n    let n = cur.len();\n    let mut sep: i32 = -1;\n    let mut k = 0;\n    while (k < n) {\n        if (cur.code_at(k) == C_SLASH) {\n            sep = k;\n        }\n        k = k + 1;\n    }\n    if (sep < 0) {\n        rs_set_str(path, \"\");\n    } else {\n        rs_set_str(path, cur.slice(0, sep));\n    }\n    rs_set_str(selected, \"\");\n    stf_put(K_PATH, path as f64);\n    stf_put(K_SEL, selected as f64);\n    launch_future(fetch_dir());\n}\n\n// Re-fetch the current directory.\nfn b_refresh(_a: u64, _b: u64, _n: f64) {\n    launch_future(fetch_dir());\n}\n\n// A listing-row tap: a directory descends (a fresh contents fetch); a\n// file fills the selection footer.\nfn b_row(a: u64, _b: u64, _n: f64) {\n    let files = stf_take(K_FILES) as u64;\n    stf_put(K_FILES, files as f64);\n    let v = rs_get_value(files);\n    let s = rs_value_item(v, a);\n    if (s.starts_with(0, \"d|\")) {\n        let name = s.slice(2, s.len());\n        let path = stf_take(K_PATH) as u64;\n        let selected = stf_take(K_SEL) as u64;\n        let cur = rs_get_str(path);\n        let mut next = name;\n        if (cur != \"\") {\n            next = f\"{cur}/{name}\";\n        }\n        rs_set_str(path, next);\n        rs_set_str(selected, \"\");\n        stf_put(K_PATH, path as f64);\n        stf_put(K_SEL, selected as f64);\n        launch_future(fetch_dir());\n        return;\n    }\n    let n = s.len();\n    let mut k = 2;\n    while (k < n) {\n        if (s.code_at(k) == C_PIPE) {\n            break;\n        }\n        k = k + 1;\n    }\n    let name = s.slice(2, k);\n    let size = fmt_size(s.slice(k + 1, n));\n    let selected = stf_take(K_SEL) as u64;\n    rs_set_str(selected, f\"{name} — {size}\");\n    stf_put(K_SEL, selected as f64);\n}\n\nfn open_draft(draft: str) {\n    let full = parse_repo(draft);\n    let err = stf_take(K_ERR) as u64;\n    let err_has = stf_take(K_ERRHAS) as u64;\n    if (full == \"\") {\n        rs_set_str(err, \"Enter a repo as \\\"owner/name\\\" — e.g. facebook/react\");\n        rs_set_bool(err_has, true);\n        stf_put(K_ERR, err as f64);\n        stf_put(K_ERRHAS, err_has as f64);\n        return;\n    }\n    rs_set_str(err, \"\");\n    rs_set_bool(err_has, false);\n    stf_put(K_ERR, err as f64);\n    stf_put(K_ERRHAS, err_has as f64);\n    let repo_full = stf_take(K_REPO) as u64;\n    rs_set_str(repo_full, full);\n    stf_put(K_REPO, repo_full as f64);\n    launch_future(open_repo());\n}\n\nfn go_landing() {\n    let mode = stf_take(K_MODE) as u64;\n    let err = stf_take(K_ERR) as u64;\n    let err_has = stf_take(K_ERRHAS) as u64;\n    let desc = stf_take(K_DESC) as u64;\n    let stats = stf_take(K_STATS) as u64;\n    let path = stf_take(K_PATH) as u64;\n    let selected = stf_take(K_SEL) as u64;\n    let is_empty = stf_take(K_EMPTY) as u64;\n    rs_set_str(mode, \"landing\");\n    rs_set_str(err, \"\");\n    rs_set_bool(err_has, false);\n    rs_set_str(desc, \"\");\n    rs_set_str(stats, \"\");\n    rs_set_str(path, \"\");\n    rs_set_str(selected, \"\");\n    rs_set_bool(is_empty, false);\n    stf_put(K_MODE, mode as f64);\n    stf_put(K_ERR, err as f64);\n    stf_put(K_ERRHAS, err_has as f64);\n    stf_put(K_DESC, desc as f64);\n    stf_put(K_STATS, stats as f64);\n    stf_put(K_PATH, path as f64);\n    stf_put(K_SEL, selected as f64);\n    stf_put(K_EMPTY, is_empty as f64);\n}\n\n// The repo-meta journey: mode → loading, GET the repo, surface its error\n// payload or seed the explorer and fetch the root listing.\nasync fn open_repo() -> str {\n    set_mode(\"loading\");\n    let repo_full = stf_take(K_REPO) as u64;\n    let full = rs_get_str(repo_full);\n    stf_put(K_REPO, repo_full as f64);\n    let url = f\"https://api.github.com/repos/{full}\";\n    let body = await net_request(url, \"GET\");\n    if (body.len() == 0) {\n        fail(\"Network request failed — the browser may be offline.\", false);\n        return \"\";\n    }\n    let meta = body.decode();\n    let name = json_get_str(meta, \"full_name\");\n    if (name == \"\") {\n        let msg = json_get_str(meta, \"message\");\n        if (msg == \"\") {\n            fail(\"Unexpected response from the GitHub API.\", false);\n        } else {\n            fail(f\"{msg} — check the name (owner/repo).\", false);\n        }\n        return \"\";\n    }\n    let desc = stf_take(K_DESC) as u64;\n    let stats = stf_take(K_STATS) as u64;\n    let path = stf_take(K_PATH) as u64;\n    let selected = stf_take(K_SEL) as u64;\n    rs_set_str(repo_full, name);\n    rs_set_str(desc, json_get_str(meta, \"description\"));\n    rs_set_str(stats, fmt_stats(meta));\n    rs_set_str(path, \"\");\n    rs_set_str(selected, \"\");\n    stf_put(K_DESC, desc as f64);\n    stf_put(K_STATS, stats as f64);\n    stf_put(K_PATH, path as f64);\n    stf_put(K_SEL, selected as f64);\n    await fetch_dir();\n    return \"\";\n}\n\n// The directory journey: GET .../contents[/path], fill the display list\n// (dirs first), flip the empty flag, settle on the explorer.\nasync fn fetch_dir() -> str {\n    let repo_full = stf_take(K_REPO) as u64;\n    let path = stf_take(K_PATH) as u64;\n    let full = rs_get_str(repo_full);\n    let dir = rs_get_str(path);\n    stf_put(K_REPO, repo_full as f64);\n    stf_put(K_PATH, path as f64);\n    let mut url = f\"https://api.github.com/repos/{full}/contents\";\n    if (dir != \"\") {\n        url = f\"https://api.github.com/repos/{full}/contents/{dir}\";\n    }\n    let body = await net_request(url, \"GET\");\n    if (body.len() == 0) {\n        fail(\"Network request failed — the browser may be offline.\", true);\n        return \"\";\n    }\n    let text = body.decode();\n    let fresh = rs_list_new();\n    let ndirs = json_contents(text, fresh, true);\n    let nfiles = json_contents(text, fresh, false);\n    if (ndirs < 0 || nfiles < 0) {\n        fail(\"Unexpected file-list response from the GitHub API.\", true);\n        return \"\";\n    }\n    let files = stf_take(K_FILES) as u64;\n    let is_empty = stf_take(K_EMPTY) as u64;\n    rs_set_value(files, fresh);\n    rs_set_bool(is_empty, ndirs + nfiles == 0);\n    stf_put(K_FILES, files as f64);\n    stf_put(K_EMPTY, is_empty as f64);\n    set_mode(\"explorer\");\n    return \"\";\n}\n\nfn set_mode(mode: str) {\n    let atom = stf_take(K_MODE) as u64;\n    rs_set_str(atom, mode);\n    stf_put(K_MODE, atom as f64);\n}\n\n// The failure rail: the message lands on the banner; `explorer` keeps the\n// listing visible under it, anything else falls back to the landing.\nfn fail(msg: str, stay: bool) {\n    let err = stf_take(K_ERR) as u64;\n    let err_has = stf_take(K_ERRHAS) as u64;\n    rs_set_str(err, msg);\n    rs_set_bool(err_has, true);\n    stf_put(K_ERR, err as f64);\n    stf_put(K_ERRHAS, err_has as f64);\n    if (stay) {\n        set_mode(\"explorer\");\n    } else {\n        set_mode(\"landing\");\n    }\n}\n\n// ---- helpers ---------------------------------------------------------------\n\n// \"owner/repo\" out of a draft; \"\" when the shape is wrong (a `.git`\n// suffix is stripped).\nfn parse_repo(draft: str) -> str {\n    let n = draft.len();\n    let mut a = 0;\n    while (a < n && draft.code_at(a) == C_SPACE) {\n        a = a + 1;\n    }\n    let mut b = n;\n    while (b > a && draft.code_at(b - 1) == C_SPACE) {\n        b = b - 1;\n    }\n    let t = draft.slice(a, b);\n    let m = t.len();\n    let mut sep: i32 = -1;\n    let mut k = 0;\n    while (k < m) {\n        if (t.code_at(k) == C_SLASH) {\n            sep = k;\n            break;\n        }\n        k = k + 1;\n    }\n    if (sep <= 0 || sep >= m - 1) {\n        return \"\";\n    }\n    let owner = t.slice(0, sep);\n    let mut repo = t.slice(sep + 1, m);\n    let rl = repo.len();\n    if (rl > 4 && repo.starts_with(rl - 4, \".git\")) {\n        repo = repo.slice(0, rl - 4);\n    }\n    return f\"{owner}/{repo}\";\n}\n\n// \"rust · stars 12.3k · forks 4.5k · issues 123\" — the language folded in\n// when present.\nfn fmt_stats(meta: str) -> str {\n    let lang = json_get_str(meta, \"language\");\n    let stars = json_get_str(meta, \"stargazers_count\");\n    let forks = json_get_str(meta, \"forks_count\");\n    let issues = json_get_str(meta, \"open_issues_count\");\n    let mut out = \"\";\n    if (lang != \"\") {\n        out = f\"{out}{lang} · \";\n    }\n    return f\"{out}stars {fmt_count(stars)} · forks {fmt_count(forks)} · issues {fmt_count(issues)}\";\n}\n\n// 12345 → \"12.3k\"; 123 → \"123\".\nfn fmt_count(s: str) -> str {\n    let v: f64 = str_parse_f64(s);\n    if (v >= 1000.0) {\n        let d = ((v / 1000.0) * 10.0) as u64;\n        return f\"{d / 10}.{d % 10}k\";\n    }\n    return f\"{v as u64}\";\n}\n\n// 2739 → \"2.7 KB\"; 12 → \"12 B\".\nfn fmt_size(s: str) -> str {\n    if (s == \"\") {\n        return \"—\";\n    }\n    let v: f64 = str_parse_f64(s);\n    if (v < 1024.0) {\n        return f\"{v as u64} B\";\n    }\n    let mut x: f64 = v / 1024.0;\n    let mut unit = \"KB\";\n    if (v >= 1048576.0) {\n        x = v / 1048576.0;\n        unit = \"MB\";\n    }\n    let d = (x * 10.0) as u64;\n    return f\"{d / 10}.{d % 10} {unit}\";\n}\n\n// ---- the JSON scanner ------------------------------------------------------\n\nfn ws(c: u32) -> bool {\n    return c == C_SPACE || c == 9 || c == 10 || c == 13;\n}\n\nfn skip_ws(t: str, i: i32) -> i32 {\n    let n = t.len();\n    let mut j = i;\n    while (j < n && ws(t.code_at(j))) {\n        j = j + 1;\n    }\n    return j;\n}\n\n// The index just past the string literal opening at `i` (escapes skip\n// whole pairs).\nfn str_end(t: str, i: i32) -> i32 {\n    let n = t.len();\n    let mut j = i + 1;\n    while (j < n) {\n        let c = t.code_at(j);\n        if (c == C_BACKSLASH) {\n            j = j + 2;\n            continue;\n        }\n        if (c == C_QUOTE) {\n            return j + 1;\n        }\n        j = j + 1;\n    }\n    return n;\n}\n\n// Decode the string literal whose opening quote sits at `i` (the common\n// escapes; `\\uXXXX` mints U+FFFD).\nfn str_unquote(t: str, i: i32) -> str {\n    let end = str_end(t, i);\n    let raw = t.slice(i + 1, end - 1);\n    let n = raw.len();\n    let mut out = \"\";\n    let mut k = 0;\n    while (k < n) {\n        let c = raw.code_at(k);\n        if (c != C_BACKSLASH) {\n            out = f\"{out}{raw.slice(k, k + 1)}\";\n            k = k + 1;\n            continue;\n        }\n        if (k + 1 >= n) {\n            break;\n        }\n        let e = raw.code_at(k + 1);\n        if (e == C_QUOTE) {\n            out = f\"{out}\\\"\";\n        } else if (e == C_BACKSLASH) {\n            out = f\"{out}\\\\\";\n        } else if (e == C_SLASH) {\n            out = f\"{out}/\";\n        } else if (e == 110) {\n            out = f\"{out}\\n\";\n        } else if (e == 116) {\n            out = f\"{out}\\t\";\n        } else if (e == 117) {\n            out = f\"{out}\\u{FFFD}\";\n            k = k + 6;\n            continue;\n        } else {\n            out = f\"{out}{raw.slice(k + 1, k + 2)}\";\n        }\n        k = k + 2;\n    }\n    return out;\n}\n\n// Skip one JSON value at `i`; answers the index just past it (strings,\n// nested containers walked with depth, scalars to the next delimiter).\nfn json_skip(t: str, i: i32) -> i32 {\n    let n = t.len();\n    let j = skip_ws(t, i);\n    if (j >= n) {\n        return n;\n    }\n    let c = t.code_at(j);\n    if (c == C_QUOTE) {\n        return str_end(t, j);\n    }\n    if (c == C_LBRACE || c == C_LBRACKET) {\n        let mut depth = 0;\n        let mut k = j;\n        while (k < n) {\n            let d = t.code_at(k);\n            if (d == C_QUOTE) {\n                k = str_end(t, k);\n                continue;\n            }\n            if (d == C_LBRACE || d == C_LBRACKET) {\n                depth = depth + 1;\n            } else if (d == C_RBRACE || d == C_RBRACKET) {\n                depth = depth - 1;\n                if (depth == 0) {\n                    return k + 1;\n                }\n            }\n            k = k + 1;\n        }\n        return n;\n    }\n    let mut k = j;\n    while (k < n) {\n        let d = t.code_at(k);\n        if (d == C_COMMA || d == C_RBRACE || d == C_RBRACKET || ws(d)) {\n            break;\n        }\n        k = k + 1;\n    }\n    return k;\n}\n\n// One object's scalar field: the decoded string for string values, the\n// raw text for numbers/bools, \"\" when absent (or the value is\n// null/container).\nfn json_get_str(t: str, key: str) -> str {\n    let n = t.len();\n    let mut i = skip_ws(t, 0);\n    if (i >= n || t.code_at(i) != C_LBRACE) {\n        return \"\";\n    }\n    i = skip_ws(t, i + 1);\n    while (i < n) {\n        if (t.code_at(i) == C_RBRACE) {\n            return \"\";\n        }\n        if (t.code_at(i) != C_QUOTE) {\n            return \"\";\n        }\n        let key_end = str_end(t, i);\n        let k = t.slice(i + 1, key_end - 1);\n        let j = skip_ws(t, key_end);\n        if (j >= n || t.code_at(j) != C_COLON) {\n            return \"\";\n        }\n        let vs = skip_ws(t, j + 1);\n        if (k == key) {\n            if (vs < n && t.code_at(vs) == C_QUOTE) {\n                return str_unquote(t, vs);\n            }\n            if (vs < n && t.code_at(vs) != C_LBRACE && t.code_at(vs) != C_LBRACKET) {\n                let vend = json_skip(t, vs);\n                return t.slice(vs, vend);\n            }\n            return \"\";\n        }\n        i = skip_ws(t, json_skip(t, vs));\n        if (i < n && t.code_at(i) == C_COMMA) {\n            i = skip_ws(t, i + 1);\n        }\n    }\n    return \"\";\n}\n\n// Walk a JSON array of flat objects; push \"d|name\" (dirs pass) or\n// \"f|name|bytes\" (files pass) onto `out`. Answers the item count seen, or\n// -1 when the payload is not an array of objects.\nfn json_contents(t: str, out: opaque, dirs_only: bool) -> i32 {\n    let n = t.len();\n    let mut i = skip_ws(t, 0);\n    if (i >= n || t.code_at(i) != C_LBRACKET) {\n        return -1;\n    }\n    i = skip_ws(t, i + 1);\n    let mut count: i32 = 0;\n    while (i < n) {\n        if (t.code_at(i) == C_RBRACKET) {\n            return count;\n        }\n        if (t.code_at(i) != C_LBRACE) {\n            return -1;\n        }\n        let iend = json_skip(t, i);\n        let item = t.slice(i, iend);\n        let kind = json_get_str(item, \"type\");\n        let is_dir = kind == \"dir\";\n        if (is_dir == dirs_only) {\n            let name = json_get_str(item, \"name\");\n            if (is_dir) {\n                rs_list_push(out, f\"d|{name}\");\n            } else {\n                let size = json_get_str(item, \"size\");\n                rs_list_push(out, f\"f|{name}|{size}\");\n            }\n            count = count + 1;\n        }\n        i = skip_ws(t, iend);\n        if (i < n && t.code_at(i) == C_COMMA) {\n            i = skip_ws(t, i + 1);\n        }\n    }\n    return count;\n}\n";
    }
    if (name == "grid-aspect") {
        return "// grid-aspect: aspect-ratio + fixed-extent grid cells (the boa port, plus\n// the mainAxisExtent grid its header comment promises). The first grid\n// tiles 10 hue cells at childAspectRatio 2 (each cell twice as wide as it\n// is tall: cell_main = cell_cross / 2); the second exercises\n// `main_extent`, which overrides the aspect with a fixed 40px row height.\n// Both grids ride `max_cross` 160 for the column count.\nuse tur::{ CROSS_ALIGN_START, MAIN_SIZE_MIN, mount };\nuse tur_kit::{ Column, Container, Grid, ScrollView, SizedBox, Text };\n\n\nlet LABEL_FG: u64 = 0xFFFFFFFFu64;\nlet CAPTION_FG: u64 = 0x94A3B8FFu64;\n\nentry fn start() {\n    let page = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(Text().text(\"aspect 2:1 (10 cells)\").font_size(11.0).color(CAPTION_FG).build())\n        .child(SizedBox(0.0, 6.0).build())\n        .child(aspect_grid())\n        .child(SizedBox(0.0, 16.0).build())\n        .child(Text().text(\"mainAxisExtent 40 (10 cells)\").font_size(11.0).color(CAPTION_FG).build())\n        .child(SizedBox(0.0, 6.0).build())\n        .child(extent_grid())\n        .build();\n    mount(ScrollView().child(page).build());\n}\n\n// The aspect-2 grid: 10 hue cells labeled #i.\nfn aspect_grid() -> opaque {\n    let mut grid = Grid().max_cross(160.0).aspect(2.0).spacing(6.0, 6.0).query_key(\"grid-aspect\");\n    let mut i: u64 = 0;\n    while (i < 10) {\n        let cell = Container()\n            .color(hsl_packed(i as f64 * 36.0 + 40.0, 60.0, 55.0))\n            .child(Text().text(f\"#{i}\").font_size(12.0).color(LABEL_FG).build());\n        grid.child(cell.build());\n        i = i + 1;\n    }\n    return grid.build();\n}\n\n// The fixed-extent grid: main_extent pins each row at 40px tall\n// (overriding the aspect), same 10-cell ramp.\nfn extent_grid() -> opaque {\n    let mut grid = Grid().max_cross(160.0).main_extent(40.0).spacing(6.0, 6.0).query_key(\"grid-aspect-extent\");\n    let mut i: u64 = 0;\n    while (i < 10) {\n        let cell = Container()\n            .color(hsl_packed(i as f64 * 36.0 + 40.0, 60.0, 55.0))\n            .child(Text().text(f\"#{i}\").font_size(12.0).color(LABEL_FG).build());\n        grid.child(cell.build());\n        i = i + 1;\n    }\n    return grid.build();\n}\n\n// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).\nfn hsl_packed(h: f64, s: f64, l: f64) -> u64 {\n    let sat: f64 = s / 100.0;\n    let light: f64 = l / 100.0;\n    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;\n    let hue: f64 = h % 360.0;\n    let hp: f64 = hue / 60.0;\n    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));\n    let mut r1: f64 = 0.0;\n    let mut g1: f64 = 0.0;\n    let mut b1: f64 = 0.0;\n    if (hp < 1.0) {\n        r1 = c;\n        g1 = x;\n    } else if (hp < 2.0) {\n        r1 = x;\n        g1 = c;\n    } else if (hp < 3.0) {\n        g1 = c;\n        b1 = x;\n    } else if (hp < 4.0) {\n        g1 = x;\n        b1 = c;\n    } else if (hp < 5.0) {\n        r1 = x;\n        b1 = c;\n    } else {\n        r1 = c;\n        b1 = x;\n    }\n    let m: f64 = light - c / 2.0;\n    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;\n    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;\n    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;\n    return r * 16777216 + g * 65536 + b * 256 + 255;\n}\n\nfn abs_f(v: f64) -> f64 {\n    if (v < 0.0) {\n        return -v;\n    }\n    return v;\n}\n";
    }
    if (name == "grid-basic") {
        return "// grid-basic: a static Grid of 12 hue cells (the boa port). The column\n// count derives from `max_cross` (140) and the pane width — Flutter's\n// maxCrossAxisExtent semantics (ceil) — so the cells tile row-major as\n// squares with an 8px gutter. Cells are flat colored boxes: the grid\n// hands each child its tight cell rect, so no explicit sizing here.\n//\n// The child loop feeding `.child()` runs BEFORE the single `.build()`\n// (build-then-mutate stays out; repetition is just the loop).\nuse tur::mount;\nuse tur_kit::{ Container, Grid };\n\n\nentry fn start() {\n    let mut grid = Grid().max_cross(140.0).spacing(8.0, 8.0).query_key(\"grid-basic\");\n    let mut i: u64 = 0;\n    while (i < 12) {\n        grid.child(Container().color(hsl_packed(i as f64 * 30.0, 65.0, 55.0)).build());\n        i = i + 1;\n    }\n    mount(grid.build());\n}\n\n// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).\nfn hsl_packed(h: f64, s: f64, l: f64) -> u64 {\n    let sat: f64 = s / 100.0;\n    let light: f64 = l / 100.0;\n    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;\n    let hue: f64 = h % 360.0;\n    let hp: f64 = hue / 60.0;\n    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));\n    let mut r1: f64 = 0.0;\n    let mut g1: f64 = 0.0;\n    let mut b1: f64 = 0.0;\n    if (hp < 1.0) {\n        r1 = c;\n        g1 = x;\n    } else if (hp < 2.0) {\n        r1 = x;\n        g1 = c;\n    } else if (hp < 3.0) {\n        g1 = c;\n        b1 = x;\n    } else if (hp < 4.0) {\n        g1 = x;\n        b1 = c;\n    } else if (hp < 5.0) {\n        r1 = x;\n        b1 = c;\n    } else {\n        r1 = c;\n        b1 = x;\n    }\n    let m: f64 = light - c / 2.0;\n    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;\n    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;\n    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;\n    return r * 16777216 + g * 65536 + b * 256 + 255;\n}\n\nfn abs_f(v: f64) -> f64 {\n    if (v < 0.0) {\n        return -v;\n    }\n    return v;\n}\n";
    }
    if (name == "grid-gallery") {
        return "// grid-gallery: \"Grid Gallery\" — the interactive tile gallery (the full\n// boa port). The header (title + a live subtitle \"tile #i · 1:1 ·\n// maxExtent 150\") sits above aspect chips (1:1 / 16:9 / 9:16), density\n// chips (Dense / Normal / Sparse), and a styled scrollable tile grid with\n// centered labels; tapping a tile paints its white selection ring and\n// re-derives the subtitle.\n//\n// Reactivity: the Grid's max_cross / aspect rows are static per build, so\n// the chips re-key ONE Switch over the COMBINED mode string\n// (\"1:1/150\" …) whose nine lazy cases rebuild the grid fresh per mode\n// (each activation reads live state). The case grid stays FLAT — a switch\n// branch that mounts ANOTHER switch mid-flush would defer that inner\n// switch's initial case activation (a known mounting-order gap), so the\n// aspect × density matrix is spelled out instead of nested. Tile rings\n// ride per-tile brush atoms (rs_set_brush); the subtitle's three\n// fragments are 1-dep derives over the aspect / density / selection\n// atoms.\n//\n// The child loop feeding `.child()` runs BEFORE the single `.build()`\n// (build-then-mutate stays out; repetition is just the loop).\nuse tur::{\n    ALIGN_CENTER, CROSS_ALIGN_START, CURSOR_POINTER, MAIN_SIZE_MIN, mount, rs_get_f64,\n    rs_set_brush, rs_set_f64, rs_set_str, rs_source_f64, rs_source_str, stf_put, stf_take,\n};\nuse tur_kit::{\n    Column, Container, Expanded, Grid, MouseRegion, PointerInteract, Row, ScrollView, SizedBox,\n    Switch, Text, rs_derive,\n};\n\n\n// The scalar-stash keys (atom ids + the ring brushes ride them; the 27\n// ring brushes live at K_TILES + i).\nlet K_ASPECT: u64 = 1;\nlet K_MAXEXT: u64 = 2;\nlet K_SEL: u64 = 3;\nlet K_AKEY: u64 = 4;\nlet K_DKEY: u64 = 5;\nlet K_MODE: u64 = 6;\nlet K_A0: u64 = 7;\nlet K_A1: u64 = 8;\nlet K_A2: u64 = 9;\nlet K_D0: u64 = 10;\nlet K_D1: u64 = 11;\nlet K_D2: u64 = 12;\nlet K_PREV: u64 = 13;\nlet K_TILES: u64 = 100;\n\n// The boa palette (deep slate page, indigo active chips).\nlet PAGE_BG: u64 = 0x0F172AFFu64;\nlet TITLE_FG: u64 = 0xF1F5F9FFu64;\nlet SUB_FG: u64 = 0x94A3B8FFu64;\nlet PANEL_BG: u64 = 0x020617FFu64;\nlet CHIP_ON: u64 = 0x6366F1FFu64;\nlet CHIP_OFF: u64 = 0x1E293BFFu64;\nlet CHIP_FG: u64 = 0xE2E8F0FFu64;\nlet LABEL_FG: u64 = 0xFFFFFFFFu64;\nlet RING_ON: u64 = 0xFFFFFFFFu64;\n\nentry fn start() -> u64 {\n    let aspect = rs_source_f64();\n    rs_set_f64(aspect, 1.0);\n    let maxext = rs_source_f64();\n    rs_set_f64(maxext, 150.0);\n    let sel = rs_source_f64();\n    rs_set_f64(sel, 0.0);\n    let akey = rs_source_str(\"1:1\");\n    let dkey = rs_source_str(\"150\");\n    let mode = rs_source_str(\"1:1/150\");\n    stf_put(K_ASPECT, aspect as f64);\n    stf_put(K_MAXEXT, maxext as f64);\n    stf_put(K_SEL, sel as f64);\n    stf_put(K_AKEY, akey as f64);\n    stf_put(K_DKEY, dkey as f64);\n    stf_put(K_MODE, mode as f64);\n    stf_put(K_PREV, 0.0);\n\n    // The six chip brushes, seeded to the boot state (1:1 + Normal).\n    let a0 = rs_source_f64();\n    stf_put(K_A0, a0 as f64);\n    let a1 = rs_source_f64();\n    stf_put(K_A1, a1 as f64);\n    let a2 = rs_source_f64();\n    stf_put(K_A2, a2 as f64);\n    let d0 = rs_source_f64();\n    stf_put(K_D0, d0 as f64);\n    let d1 = rs_source_f64();\n    stf_put(K_D1, d1 as f64);\n    let d2 = rs_source_f64();\n    stf_put(K_D2, d2 as f64);\n    paint_aspect_chips(\"1:1\");\n    paint_density_chips(\"150\");\n\n    // The subtitle fragments (three 1-dep derives over the state atoms).\n    let d_tile = rs_derive(fmt_tile, sel);\n    let d_aspect = rs_derive(fmt_aspect, aspect);\n    let d_extent = rs_derive(fmt_extent, maxext);\n\n    // The reactive grid: one Switch over the combined mode string — nine\n    // lazy cases, each rebuilding the grid with its literal knobs (the\n    // aspect × density matrix, kept FLAT — see the header note).\n    let grid_switch = Switch()\n        .value_source(mode)\n        .case_build(\"1:1/95\", fn () -> View { return gallery_grid(1.0, 95.0); })\n        .case_build(\"1:1/150\", fn () -> View { return gallery_grid(1.0, 150.0); })\n        .case_build(\"1:1/220\", fn () -> View { return gallery_grid(1.0, 220.0); })\n        .case_build(\"16:9/95\", fn () -> View { return gallery_grid(1.7777778, 95.0); })\n        .case_build(\"16:9/150\", fn () -> View { return gallery_grid(1.7777778, 150.0); })\n        .case_build(\"16:9/220\", fn () -> View { return gallery_grid(1.7777778, 220.0); })\n        .case_build(\"9:16/95\", fn () -> View { return gallery_grid(0.5625, 95.0); })\n        .case_build(\"9:16/150\", fn () -> View { return gallery_grid(0.5625, 150.0); })\n        .case_build(\"9:16/220\", fn () -> View { return gallery_grid(0.5625, 220.0); })\n        .build();\n    let panel = Container()\n        .color(PANEL_BG)\n        .radius(10.0)\n        .padding(10.0)\n        .child(ScrollView().child(grid_switch).build())\n        .build();\n\n    let col = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(Text().text(\"Grid Gallery\").font_size(18.0).color(TITLE_FG).query_key(\"gallery/title\").build())\n        .child(SizedBox(0.0, 4.0).build())\n        .child(subtitle(d_tile, d_aspect, d_extent))\n        .child(SizedBox(0.0, 12.0).build())\n        .child(Row().main_axis_size(MAIN_SIZE_MIN)\n            .child(chip(a0, \"gallery/a-1-1\", \"1:1\", b_a0)).child(SizedBox(6.0, 0.0).build())\n            .child(chip(a1, \"gallery/a-16-9\", \"16:9\", b_a1)).child(SizedBox(6.0, 0.0).build())\n            .child(chip(a2, \"gallery/a-9-16\", \"9:16\", b_a2))\n            .build())\n        .child(SizedBox(0.0, 8.0).build())\n        .child(Row().main_axis_size(MAIN_SIZE_MIN)\n            .child(chip(d0, \"gallery/d-dense\", \"Dense\", b_d0)).child(SizedBox(6.0, 0.0).build())\n            .child(chip(d1, \"gallery/d-normal\", \"Normal\", b_d1)).child(SizedBox(6.0, 0.0).build())\n            .child(chip(d2, \"gallery/d-sparse\", \"Sparse\", b_d2))\n            .build())\n        .child(SizedBox(0.0, 12.0).build())\n        .child(Expanded().flex(1.0).child(panel).build())\n        .build();\n\n    mount(Container().color(PAGE_BG).padding(16.0).child(col).build());\n    return sel;\n}\n\n// \"tile #0 · 1:1 · maxExtent 150\" — three live fragments.\nfn subtitle(d_tile: u64, d_aspect: u64, d_extent: u64) -> opaque {\n    return Row()\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(Text().text_bound_derived(d_tile).font_size(12.0).color(SUB_FG).query_key(\"gallery/subtitle\").build())\n        .child(Text().text(\" · \").font_size(12.0).color(SUB_FG).build())\n        .child(Text().text_bound_derived(d_aspect).font_size(12.0).color(SUB_FG).query_key(\"gallery/aspect-label\").build())\n        .child(Text().text(\" · \").font_size(12.0).color(SUB_FG).build())\n        .child(Text().text_bound_derived(d_extent).font_size(12.0).color(SUB_FG).query_key(\"gallery/extent\").build())\n        .build();\n}\n\n// The 27-tile gallery grid under one (aspect, max_cross) mode.\nfn gallery_grid(aspect: f64, max_cross: f64) -> View {\n    let mut grid = Grid().max_cross(max_cross).aspect(aspect).spacing(8.0, 8.0).query_key(\"gallery/grid\");\n    let mut i: u64 = 0;\n    while (i < 27) {\n        grid.child(tile(i));\n        i = i + 1;\n    }\n    return grid.build();\n}\n\n// One tile: the hue face with a centered label, wrapped in the selection\n// ring (a per-tile brush atom — white when selected, cleared otherwise).\nfn tile(i: u64) -> opaque {\n    let sel = stf_take(K_SEL) as u64;\n    stf_put(K_SEL, sel as f64);\n    let ring = rs_source_f64();\n    rs_set_brush(ring, ring_color(rs_get_f64(sel) == i as f64));\n    stf_put(K_TILES + i, ring as f64);\n    let face = Container()\n        .color(hsl_packed(i as f64 * 360.0 / 27.0, 58.0, 54.0))\n        .radius(5.0)\n        .alignment(ALIGN_CENTER)\n        .child(Text().text(f\"{i}\").font_size(13.0).color(LABEL_FG).build())\n        .build();\n    let framed = Container()\n        .color_bound(ring)\n        .radius(8.0)\n        .padding(3.0)\n        .child(face)\n        .build();\n    return MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(PointerInteract().ids(i, i).on_tap(b_tile).child(framed).build())\n        .build();\n}\n\n// A pill chip: the fill rides its brush atom (indigo when active).\nfn chip(atom: u64, key: str, label: str, cb: fn(u64, u64, f64)) -> opaque {\n    let face = Container()\n        .padding(7.0)\n        .radius(7.0)\n        .color_bound(atom)\n        .child(Text().text(label).font_size(12.0).color(CHIP_FG).build())\n        .build();\n    return MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(\n            PointerInteract()\n                .on_tap(cb)\n                .query_key(key)\n                .child(face)\n                .build(),\n        )\n        .build();\n}\n\n// ---- the subtitle derive formats ---------------------------------------------\n\nfn fmt_tile(v: f64) -> str {\n    return f\"tile #{v as u64}\";\n}\n\nfn fmt_aspect(v: f64) -> str {\n    if (v > 1.01) {\n        return \"16:9\";\n    }\n    if (v < 0.99) {\n        return \"9:16\";\n    }\n    return \"1:1\";\n}\n\nfn fmt_extent(v: f64) -> str {\n    return f\"maxExtent {v as u64}\";\n}\n\n// ---- chip taps -----------------------------------------------------------------\n\nfn b_a0(_a: u64, _b: u64, _n: f64) { set_aspect(\"1:1\", 1.0); }\nfn b_a1(_a: u64, _b: u64, _n: f64) { set_aspect(\"16:9\", 16.0 / 9.0); }\nfn b_a2(_a: u64, _b: u64, _n: f64) { set_aspect(\"9:16\", 0.5625); }\nfn b_d0(_a: u64, _b: u64, _n: f64) { set_density(\"95\", 95.0); }\nfn b_d1(_a: u64, _b: u64, _n: f64) { set_density(\"150\", 150.0); }\nfn b_d2(_a: u64, _b: u64, _n: f64) { set_density(\"220\", 220.0); }\n\nfn set_aspect(key: str, v: f64) {\n    let akey = stf_take(K_AKEY) as u64;\n    stf_put(K_AKEY, akey as f64);\n    rs_set_str(akey, key);\n    let mode = stf_take(K_MODE) as u64;\n    stf_put(K_MODE, mode as f64);\n    rs_set_str(mode, f\"{key}/{rs_get_str(dkey_of())}\");\n    let aspect = stf_take(K_ASPECT) as u64;\n    stf_put(K_ASPECT, aspect as f64);\n    rs_set_f64(aspect, v);\n    paint_aspect_chips(key);\n}\n\nfn set_density(key: str, v: f64) {\n    let dkey = stf_take(K_DKEY) as u64;\n    stf_put(K_DKEY, dkey as f64);\n    rs_set_str(dkey, key);\n    let mode = stf_take(K_MODE) as u64;\n    stf_put(K_MODE, mode as f64);\n    rs_set_str(mode, f\"{rs_get_str(akey_of())}/{key}\");\n    let maxext = stf_take(K_MAXEXT) as u64;\n    stf_put(K_MAXEXT, maxext as f64);\n    rs_set_f64(maxext, v);\n    paint_density_chips(key);\n}\n\n// The stash-held key atoms (read-only helpers for the mode composition).\nfn dkey_of() -> u64 {\n    let dkey = stf_take(K_DKEY) as u64;\n    stf_put(K_DKEY, dkey as f64);\n    return dkey;\n}\n\nfn akey_of() -> u64 {\n    let akey = stf_take(K_AKEY) as u64;\n    stf_put(K_AKEY, akey as f64);\n    return akey;\n}\n\n// ---- tile taps -----------------------------------------------------------------\n\n// A tile tap: move the selection ring and re-derive the subtitle.\nfn b_tile(i: u64, _b: u64, _n: f64) {\n    let sel = stf_take(K_SEL) as u64;\n    stf_put(K_SEL, sel as f64);\n    rs_set_f64(sel, i as f64);\n    let prev = stf_take(K_PREV) as u64;\n    stf_put(K_PREV, i as f64);\n    ring_brush(prev, false);\n    ring_brush(i, true);\n}\n\n// One ring brush repaint (the atom id rides the scalar stash).\nfn ring_brush(i: u64, on: bool) {\n    let atom = stf_take(K_TILES + i) as u64;\n    stf_put(K_TILES + i, atom as f64);\n    rs_set_brush(atom, ring_color(on));\n}\n\nfn ring_color(on: bool) -> u64 {\n    if (on) {\n        return RING_ON;\n    }\n    return 0x00000000u64;\n}\n\n// ---- the chip brushes ------------------------------------------------------------\n\nfn paint_aspect_chips(sel: str) {\n    paint_chip(K_A0, sel == \"1:1\");\n    paint_chip(K_A1, sel == \"16:9\");\n    paint_chip(K_A2, sel == \"9:16\");\n}\n\nfn paint_density_chips(sel: str) {\n    paint_chip(K_D0, sel == \"95\");\n    paint_chip(K_D1, sel == \"150\");\n    paint_chip(K_D2, sel == \"220\");\n}\n\nfn paint_chip(key: u64, on: bool) {\n    let atom = stf_take(key) as u64;\n    stf_put(key, atom as f64);\n    let mut c: u64 = CHIP_OFF;\n    if (on) {\n        c = CHIP_ON;\n    }\n    rs_set_brush(atom, c);\n}\n\n// ---- the tile ramp ---------------------------------------------------------------\n\n// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).\nfn hsl_packed(h: f64, s: f64, l: f64) -> u64 {\n    let sat: f64 = s / 100.0;\n    let light: f64 = l / 100.0;\n    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;\n    let hue: f64 = h % 360.0;\n    let hp: f64 = hue / 60.0;\n    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));\n    let mut r1: f64 = 0.0;\n    let mut g1: f64 = 0.0;\n    let mut b1: f64 = 0.0;\n    if (hp < 1.0) {\n        r1 = c;\n        g1 = x;\n    } else if (hp < 2.0) {\n        r1 = x;\n        g1 = c;\n    } else if (hp < 3.0) {\n        g1 = c;\n        b1 = x;\n    } else if (hp < 4.0) {\n        g1 = x;\n        b1 = c;\n    } else if (hp < 5.0) {\n        r1 = x;\n        b1 = c;\n    } else {\n        r1 = c;\n        b1 = x;\n    }\n    let m: f64 = light - c / 2.0;\n    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;\n    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;\n    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;\n    return r * 16777216 + g * 65536 + b * 256 + 255;\n}\n\nfn abs_f(v: f64) -> f64 {\n    if (v < 0.0) {\n        return -v;\n    }\n    return v;\n}\n";
    }
    if (name == "implicit-animations") {
        return "// implicit-animations: the Animated* twin — one shared controller eases\n// 0..1 and the a_tick fn maps the eased progress into the box's animated\n// channels (width_bound 100→200, height_bound 40→80, color_bound\n// sky-blue→indigo, radius_bound 12→40, the slide left_bound 30→160 and\n// the label's opacity 0.45→1.0). The toggle flips the `expanded` atom and\n// retargets the controller (forward/reverse) — the\n// ImplicitlyAnimatedWidget retarget, case-side.\n//\n// Pure kit: every channel is a bound prop over the progress the tick\n// writes — the animation rows end-to-end with no per-channel controllers.\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, MAIN_ALIGN_CENTER, MAIN_SIZE_MIN, anim_forward,\n    anim_reverse, color_tween_lerp, mount, rs_get_bool, rs_set_bool, rs_set_brush, rs_set_f64,\n    rs_source_bool, rs_source_f64, st_put, st_take, stf_put, stf_take, tween_lerp };\nuse tur_kit::{ Column, Condition, Container, Expanded, PointerInteract, Positioned, Row, SizedBox,\n    Stack, Text };\nuse tur_anim_kit::{ Opacity, anim_ctrl };\n\n\nlet K_CTRL: u64 = 1;\nlet K_EXPANDED: u64 = 2;\nlet K_WIDTH: u64 = 3;\nlet K_HEIGHT: u64 = 4;\nlet K_COLOR: u64 = 5;\nlet K_RADIUS: u64 = 6;\nlet K_LEFT: u64 = 7;\nlet K_FADE: u64 = 8;\n\n// The tween endpoints (the boa card, retargeted compact ↔ expanded).\nlet W_MIN: f64 = 100.0;\nlet W_MAX: f64 = 200.0;\nlet H_MIN: f64 = 40.0;\nlet H_MAX: f64 = 80.0;\nlet R_MIN: f64 = 12.0;\nlet R_MAX: f64 = 40.0;\nlet X_MIN: f64 = 30.0;\nlet X_MAX: f64 = 160.0;\nlet A_MIN: f64 = 0.45;\nlet A_MAX: f64 = 1.0;\nlet BLUE: u64 = 0x0EA5E9FFu64; // compact — the sky-blue state\nlet INDIGO: u64 = 0x6366F1FFu64; // expanded — the indigo state\n\nentry fn start() -> u64 {\n    let expanded = rs_source_bool(false);\n    stf_put(K_EXPANDED, expanded as f64);\n    let progress = rs_source_f64();\n    let width = rs_source_f64();\n    let height = rs_source_f64();\n    let color = rs_source_f64();\n    let radius = rs_source_f64();\n    let left = rs_source_f64();\n    let fade = rs_source_f64();\n\n    // Seed the channels at the compact state (progress 0).\n    rs_set_f64(width, W_MIN);\n    rs_set_f64(height, H_MIN);\n    rs_set_f64(radius, R_MIN);\n    rs_set_f64(left, X_MIN);\n    rs_set_f64(fade, A_MIN);\n    rs_set_brush(color, BLUE);\n\n    stf_put(K_WIDTH, width as f64);\n    stf_put(K_HEIGHT, height as f64);\n    stf_put(K_COLOR, color as f64);\n    stf_put(K_RADIUS, radius as f64);\n    stf_put(K_LEFT, left as f64);\n    stf_put(K_FADE, fade as f64);\n    let ctrl = anim_ctrl(progress, 600.0, \"easeInOut\", 1, a_tick, a_end);\n    st_put(K_CTRL, ctrl);\n\n    // The Compact↔Expanded label rides the state atom (a Condition swap).\n    let label = Condition(expanded)\n        .then_build(fn () -> View { return Text().text(\"Expanded\").font_size(18.0).color(0xFFFFFFFFu64).build(); })\n        .else_build(fn () -> View { return Text().text(\"Compact\").font_size(18.0).color(0xFFFFFFFFu64).build(); })\n        .build();\n\n    // The animated box: every prop is a bound atom the tick writes.\n    let box_inner = Container()\n        .width_bound(width)\n        .height_bound(height)\n        .color_bound(color)\n        .radius_bound(radius)\n        .alignment(ALIGN_CENTER)\n        .query_key(\"animated-box\")\n        .child(label)\n        .build();\n    let faded = Opacity(1.0).bound(fade).child(box_inner).build();\n\n    // The slide channel: the box glides left ↔ right inside the canvas\n    // (the boa AnimatedPositioned).\n    let card = Stack()\n        .child(SizedBox(340.0, 220.0).build())\n        .child(Positioned().left_bound(left).top(30.0).child(faded).build())\n        .build();\n\n    let toggle = PointerInteract()\n        .ids(expanded, expanded)\n        .on_tap(b_toggle)\n        .query_key(\"implicit-toggle\")\n        .child(\n            Container()\n                .padding(10.0)\n                .radius(8.0)\n                .color(0x1E293BFFu64)\n                .child(\n                    Condition(expanded)\n                        .then_build(fn () -> View { return Text().text(\"◀ Compact\").font_size(12.0).color(0xE2E8F0FFu64).build(); })\n                        .else_build(fn () -> View { return Text().text(\"Expand ▶\").font_size(12.0).color(0xE2E8F0FFu64).build(); })\n                        .build(),\n                )\n                .build(),\n        )\n        .build();\n\n    let col = Column()\n        .main_alignment(MAIN_ALIGN_CENTER)\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(Text().text(\"Implicit Animations\").font_size(16.0).color(0x0F172AFFu64).query_key(\"implicit-title\").build())\n        .child(SizedBox(0.0, 4.0).build())\n        .child(Text().text(\"width · height · color · radius · slide · fade — one controller\").font_size(10.0).color(0x64748BFFu64).build())\n        .child(SizedBox(0.0, 24.0).build())\n        .child(card)\n        .child(SizedBox(0.0, 24.0).build())\n        .child(Row().main_axis_size(MAIN_SIZE_MIN).child(toggle).build())\n        .build();\n\n    mount(Expanded().flex(1.0).child(Container().color(0xF8FAFCFFu64).child(col).build()).build());\n    return expanded;\n}\n\n// The tick: eased progress → every animated channel.\nfn a_tick(_atom: u64, t: f64) {\n    let width = stf_take(K_WIDTH) as u64;\n    stf_put(K_WIDTH, width as f64);\n    rs_set_f64(width, tween_lerp(W_MIN, W_MAX, t));\n    let height = stf_take(K_HEIGHT) as u64;\n    stf_put(K_HEIGHT, height as f64);\n    rs_set_f64(height, tween_lerp(H_MIN, H_MAX, t));\n    let radius = stf_take(K_RADIUS) as u64;\n    stf_put(K_RADIUS, radius as f64);\n    rs_set_f64(radius, tween_lerp(R_MIN, R_MAX, t));\n    let left = stf_take(K_LEFT) as u64;\n    stf_put(K_LEFT, left as f64);\n    rs_set_f64(left, tween_lerp(X_MIN, X_MAX, t));\n    let fade = stf_take(K_FADE) as u64;\n    stf_put(K_FADE, fade as f64);\n    rs_set_f64(fade, tween_lerp(A_MIN, A_MAX, t));\n    let color = stf_take(K_COLOR) as u64;\n    stf_put(K_COLOR, color as f64);\n    rs_set_brush(color, color_tween_lerp(BLUE, INDIGO, t));\n}\n\nfn a_end(_atom: u64, _v: f64) {\n}\n\n// The toggle: flip the state atom, then retarget the shared controller —\n// forward plays toward the expanded state, reverse back to compact.\nfn b_toggle(expanded: u64, _b: u64, _n: f64) {\n    rs_set_bool(expanded, !rs_get_bool(expanded));\n    let ctrl = st_take(K_CTRL);\n    if (rs_get_bool(expanded)) {\n        anim_forward(ctrl);\n    } else {\n        anim_reverse(ctrl);\n    }\n    st_put(K_CTRL, ctrl);\n}\n";
    }
    if (name == "jigsaw-puzzle") {
        return "// jigsaw-puzzle: the full 3×3 drag-and-drop game (the Phase-9 rewrite of\n// the Phase-4 fixture case, ported from the boa reference design).\n//\n//   * Nine colored pieces start in the tray below the board (id order),\n//     each targeting a SHUFFLED slot on the 3×3 board — the piece's label\n//     names its target (\"3\" → slot 3's ghost).\n//   * Drag a piece onto its slot: drop within SNAP_T of the target and it\n//     SNAPS + locks (dim color, stops answering grabs); the \"N / 9 placed\"\n//     derive badge counts it; at 9 / 9 the Solved! overlay flips on.\n//   * A cyan snap highlight (a Condition branch, rebuilt on each drag\n//     activation) appears while the dragged piece sits within threshold of\n//     its target. Shuffle re-shuffles the targets and re-deals the tray.\n//\n// Mechanics (the rails this case rides — no engine code was touched):\n//   * Each piece is a `Positioned` whose left/top are the Phase-6 BOUND\n//     anchors (`left_bound` / `top_bound`) over per-piece f64 atoms —\n//     dragging writes the atoms, the Stack re-lays-out, the piece follows.\n//   * One `PointerInteract` per piece with `.ids(i, i)` — the piece index\n//     rides the two-id rail into SHARED callbacks (no per-piece closures);\n//     atoms and scratch state cross through the stash slots.\n//   * Piece labels are bound str atoms (re-set by deal()); the placed\n//     badge is the one derive (over the count atom); placed pieces re-brush\n//     dim through their brush atoms. Everything mutates through atoms —\n//     the whole tree is ONE chained build (the kit law).\n//   * Drag deltas are frame-formulated (x0 + (gx - g0x)) — absolute, no\n//     read-modify-write drift, frame-independent of the stack's offset.\n//   * Not `Each`: the 9 pieces mount ONCE (a rebuild per move event would\n//     drop pointer capture mid-drag).\nuse tur::{\n    ALIGN_CENTER, ALIGN_TOP_LEFT, BORDER_INSIDE, CROSS_ALIGN_CENTER, CURSOR_POINTER,\n    MAIN_ALIGN_SPACE_BETWEEN, STACK_FIT_EXPAND, mount, rs_get_f64, rs_list_new, rs_set_bool,\n    rs_set_brush, rs_set_f64, rs_set_str, rs_source_bool, rs_source_f64, rs_source_str,\n    rs_source_value, stf_put, stf_take,\n};\nuse tur_kit::{\n    Condition, Container, MouseRegion, PointerInteract, Positioned, Row, SizedBox, Stack, Text,\n    rs_derive,\n};\n\n// ---- the boa geometry --------------------------------------------------------\n\nlet CELL: f64 = 60.0;\nlet GAP_HALF: f64 = 2.0; // GAP / 2 — each piece insets 2px inside its cell\nlet PIECE: f64 = 56.0; // CELL - GAP\nlet BOARD_W: f64 = 180.0; // 3 * CELL\nlet BOARD_X: f64 = 100.0;\nlet BOARD_Y: f64 = 60.0;\nlet TRAY_X: f64 = 100.0;\nlet TRAY_Y: f64 = 300.0; // BOARD_Y + BOARD_W + 60\nlet SNAP_T: f64 = 28.0;\nlet SNAP_T2: f64 = 784.0; // SNAP_T squared (distances compare squared)\nlet PLAY_W: f64 = 380.0;\nlet PLAY_H: f64 = 520.0; // TRAY_Y + BOARD_W + 40\n\n// The boa palette: hue = (slot * 47) % 360 — bright while loose, dim once\n// placed (s 60→35, l 55→42).\nlet BRI0: u64 = 0xD14747FFu64;\nlet BRI1: u64 = 0xD1B347FFu64;\nlet BRI2: u64 = 0x83D147FFu64;\nlet BRI3: u64 = 0x47D178FFu64;\nlet BRI4: u64 = 0x47BFD1FFu64;\nlet BRI5: u64 = 0x4753D1FFu64;\nlet BRI6: u64 = 0xA847D1FFu64;\nlet BRI7: u64 = 0xD1478FFFu64;\nlet BRI8: u64 = 0xD16C47FFu64;\nlet DIM0: u64 = 0x914646FFu64;\nlet DIM1: u64 = 0x918046FFu64;\nlet DIM2: u64 = 0x669146FFu64;\nlet DIM3: u64 = 0x469160FFu64;\nlet DIM4: u64 = 0x468791FFu64;\nlet DIM5: u64 = 0x464C91FFu64;\nlet DIM6: u64 = 0x7A4691FFu64;\nlet DIM7: u64 = 0x91466CFFu64;\nlet DIM8: u64 = 0x915A46FFu64;\n\n// ---- stash slots (the case's side channel — atoms + scratch) ------------------\n\nlet K_SEED: u64 = 1; // the LCG state\nlet K_DRAG: u64 = 2; // the dragged piece id (-1 = none)\nlet K_GX0: u64 = 3; // grab point (global)\nlet K_GY0: u64 = 4;\nlet K_X0: u64 = 5; // the piece's position at grab\nlet K_Y0: u64 = 6;\nlet K_HLX: u64 = 7; // snap-highlight left atom\nlet K_HLY: u64 = 8; // snap-highlight top atom\nlet K_SNAP: u64 = 9; // snap-highlight visibility (bool atom)\nlet K_COUNT: u64 = 10; // placed count (f64 atom — the badge derive's dep)\nlet K_SOLVED: u64 = 11; // the win banner's bool atom\nlet K_PX0: u64 = 20; // piece i left atom (20..29)\nlet K_PY0: u64 = 30; // piece i top atom (30..39)\nlet K_SL0: u64 = 40; // piece i target slot atom (40..49 — read by the snap math)\nlet K_BR0: u64 = 50; // piece i brush atom (50..59)\nlet K_LB0: u64 = 60; // piece i label str atom (60..69)\nlet K_OK0: u64 = 70; // piece i placed flag (70..79)\nlet K_DK0: u64 = 80; // the deal deck (80..89)\nlet K_TMP: u64 = 90;\n\nentry fn start() -> u64 {\n    // Per-piece atoms: left/top (the drag rail), the target slot (read by\n    // the snap math), a brush (re-set bright/dim on deal/place), and the\n    // label str (re-set by deal()).\n    let mut i: u64 = 0;\n    while (i < 9) {\n        let px = rs_source_f64();\n        let py = rs_source_f64();\n        let sl = rs_source_f64();\n        let br = rs_source_value(rs_list_new());\n        let lb = rs_source_str(\"?\");\n        stf_put(K_PX0 + i, px as f64);\n        stf_put(K_PY0 + i, py as f64);\n        stf_put(K_SL0 + i, sl as f64);\n        stf_put(K_BR0 + i, br as f64);\n        stf_put(K_LB0 + i, lb as f64);\n        stf_put(K_OK0 + i, 0.0);\n        i = i + 1;\n    }\n    stf_put(K_HLX, rs_source_f64() as f64);\n    stf_put(K_HLY, rs_source_f64() as f64);\n    stf_put(K_SNAP, rs_source_bool(false) as f64);\n    stf_put(K_COUNT, rs_source_f64() as f64);\n    stf_put(K_SOLVED, rs_source_bool(false) as f64);\n    stf_put(K_SEED, 20261006.0);\n    stf_put(K_DRAG, -1.0);\n    stf_put(K_TMP, 0.0);\n\n    deal();\n\n    // ---- the play area (board + ghosts + tray + highlight + pieces + bar) ----\n\n    let snap_hl = Condition(peek(K_SNAP) as u64)\n        .then_build(fn () -> View {\n            return Positioned()\n                .left_bound(peek(K_HLX) as u64)\n                .top_bound(peek(K_HLY) as u64)\n                .width(PIECE)\n                .height(PIECE)\n                .child(snap_hl_face())\n                .build();\n        })\n        .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })\n        .build();\n\n    let play = Stack()\n        .alignment(ALIGN_TOP_LEFT)\n        .child(SizedBox(PLAY_W, PLAY_H).build())\n        .child(board_bg())\n        .children([ghost(0), ghost(1), ghost(2), ghost(3), ghost(4), ghost(5), ghost(6), ghost(7), ghost(8)])\n        .child(tray_bg())\n        .child(snap_hl)\n        .children([piece(0), piece(1), piece(2), piece(3), piece(4), piece(5), piece(6), piece(7), piece(8)])\n        .child(top_bar())\n        .build();\n\n    let win = Condition(peek(K_SOLVED) as u64)\n        .then_build(win_banner)\n        .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })\n        .build();\n\n    // ---- the root (full-bleed dark, the play area centered, the overlay) ----\n\n    mount(\n        Stack()\n            .fit(STACK_FIT_EXPAND)\n            .child(Container().color(0x020617FFu64).build())\n            .child(Container().alignment(ALIGN_CENTER).child(play).build())\n            .child(win)\n            .build(),\n    );\n    return peek(K_COUNT) as u64;\n}\n\n// ---- the deal (boot + Shuffle share it) ----------------------------------------\n\n// Re-shuffle the targets, re-deal the pieces to the tray in id order, and\n// reset every placed/counter/solved atom. The deck lives in stash cells\n// (rut arrays are immutable); Fisher-Yates over the LCG below.\nfn deal() {\n    let mut i: u64 = 0;\n    while (i < 9) {\n        stf_put(K_DK0 + i, i as f64);\n        i = i + 1;\n    }\n    let mut j: u64 = 0;\n    while (j < 8) {\n        let k = j + (rnd() as u64 % (9 - j));\n        let a = peek(K_DK0 + j);\n        let b = peek(K_DK0 + k);\n        stf_put(K_DK0 + j, b);\n        stf_put(K_DK0 + k, a);\n        j = j + 1;\n    }\n    let mut p: u64 = 0;\n    while (p < 9) {\n        let s = peek(K_DK0 + p) as u64;\n        rs_set_f64(peek(K_SL0 + p) as u64, s as f64);\n        rs_set_str(peek(K_LB0 + p) as u64, fmt_slot(s as f64));\n        rs_set_brush(peek(K_BR0 + p) as u64, bright(s));\n        rs_set_f64(peek(K_PX0 + p) as u64, tray_x(p));\n        rs_set_f64(peek(K_PY0 + p) as u64, tray_y(p));\n        stf_put(K_OK0 + p, 0.0);\n        p = p + 1;\n    }\n    rs_set_f64(peek(K_COUNT) as u64, 0.0);\n    rs_set_bool(peek(K_SNAP) as u64, false);\n    rs_set_bool(peek(K_SOLVED) as u64, false);\n    stf_put(K_DRAG, -1.0);\n}\n\n// Park-Miller in f64 (48271 × 2^31 < 2^53 — exact). Fixed boot seed: deals\n// are deterministic per session, shuffles advance the state.\nfn rnd() -> f64 {\n    let s = stf_take(K_SEED);\n    let n = (s * 48271.0) % 2147483647.0;\n    stf_put(K_SEED, n);\n    return n;\n}\n\n// Read a stash slot without consuming it.\nfn peek(slot: u64) -> f64 {\n    let v = stf_take(slot);\n    stf_put(slot, v);\n    return v;\n}\n\n// ---- the geometry ---------------------------------------------------------------\n\nfn slot_x(s: u64) -> f64 {\n    return BOARD_X + (s % 3) as f64 * CELL + GAP_HALF;\n}\n\nfn slot_y(s: u64) -> f64 {\n    return BOARD_Y + (s / 3) as f64 * CELL + GAP_HALF;\n}\n\nfn tray_x(i: u64) -> f64 {\n    return TRAY_X + (i % 3) as f64 * CELL + GAP_HALF;\n}\n\nfn tray_y(i: u64) -> f64 {\n    return TRAY_Y + (i / 3) as f64 * CELL + GAP_HALF;\n}\n\nfn bright(s: u64) -> u64 {\n    if (s == 0) { return BRI0; }\n    if (s == 1) { return BRI1; }\n    if (s == 2) { return BRI2; }\n    if (s == 3) { return BRI3; }\n    if (s == 4) { return BRI4; }\n    if (s == 5) { return BRI5; }\n    if (s == 6) { return BRI6; }\n    if (s == 7) { return BRI7; }\n    return BRI8;\n}\n\nfn dim(s: u64) -> u64 {\n    if (s == 0) { return DIM0; }\n    if (s == 1) { return DIM1; }\n    if (s == 2) { return DIM2; }\n    if (s == 3) { return DIM3; }\n    if (s == 4) { return DIM4; }\n    if (s == 5) { return DIM5; }\n    if (s == 6) { return DIM6; }\n    if (s == 7) { return DIM7; }\n    return DIM8;\n}\n\n// ---- the drag state machine (shared across all 9 pieces — `.ids(i, i)`) --------\n\nfn p_down(i: u64, _b: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    let ok = stf_take(K_OK0 + i);\n    if (ok > 0.5) {\n        stf_put(K_OK0 + i, ok);\n        return;\n    }\n    stf_put(K_OK0 + i, ok);\n    stf_put(K_DRAG, i as f64);\n    stf_put(K_GX0, gx);\n    stf_put(K_GY0, gy);\n    stf_put(K_X0, rs_get_f64(peek(K_PX0 + i) as u64));\n    stf_put(K_Y0, rs_get_f64(peek(K_PY0 + i) as u64));\n}\n\nfn p_move(i: u64, _b: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    if (peek(K_DRAG) != i as f64) {\n        return;\n    }\n    let nx = peek(K_X0) + (gx - peek(K_GX0));\n    let ny = peek(K_Y0) + (gy - peek(K_GY0));\n    rs_set_f64(peek(K_PX0 + i) as u64, nx);\n    rs_set_f64(peek(K_PY0 + i) as u64, ny);\n    // The snap highlight: the piece's own target while it hovers within\n    // threshold of it (the highlight rides bound anchors onto the slot).\n    let s = rs_get_f64(peek(K_SL0 + i) as u64) as u64;\n    let tx = slot_x(s);\n    let ty = slot_y(s);\n    let d2 = (nx - tx) * (nx - tx) + (ny - ty) * (ny - ty);\n    if (d2 < SNAP_T2) {\n        rs_set_f64(peek(K_HLX) as u64, tx);\n        rs_set_f64(peek(K_HLY) as u64, ty);\n        rs_set_bool(peek(K_SNAP) as u64, true);\n    } else {\n        rs_set_bool(peek(K_SNAP) as u64, false);\n    }\n}\n\nfn p_up(i: u64, _b: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    if (peek(K_DRAG) != i as f64) {\n        return;\n    }\n    stf_put(K_DRAG, -1.0);\n    rs_set_bool(peek(K_SNAP) as u64, false);\n    let nx = rs_get_f64(peek(K_PX0 + i) as u64);\n    let ny = rs_get_f64(peek(K_PY0 + i) as u64);\n    let s = rs_get_f64(peek(K_SL0 + i) as u64) as u64;\n    let tx = slot_x(s);\n    let ty = slot_y(s);\n    let d2 = (nx - tx) * (nx - tx) + (ny - ty) * (ny - ty);\n    if (d2 >= SNAP_T2) {\n        return; // off-target: the piece stays where it was dropped\n    }\n    // Snap + lock: pin to the slot, dim the brush, count it, maybe solve.\n    rs_set_f64(peek(K_PX0 + i) as u64, tx);\n    rs_set_f64(peek(K_PY0 + i) as u64, ty);\n    stf_put(K_OK0 + i, 1.0);\n    rs_set_brush(peek(K_BR0 + i) as u64, dim(s));\n    let count = rs_get_f64(peek(K_COUNT) as u64) + 1.0;\n    rs_set_f64(peek(K_COUNT) as u64, count);\n    if (count >= 9.0) {\n        rs_set_bool(peek(K_SOLVED) as u64, true);\n    }\n}\n\n// Shuffle tap: re-deal (deal() resets every game atom; the derives follow).\nfn b_shuffle(_a: u64, _b: u64, _n: f64) {\n    deal();\n}\n\n// ---- the label formats ------------------------------------------------------------\n\n// The piece label: its target slot, 1-based (crossed to the ghost's static\n// text too; deal() re-sets the bound labels on every re-deal).\nfn fmt_slot(v: f64) -> str {\n    let n = v as u64 + 1;\n    return f\"{n}\";\n}\n\n// The badge: \"N / 9 placed\" — the one derive, over the count atom.\nfn fmt_count(v: f64) -> str {\n    let n = v as u64;\n    return f\"{n} / 9 placed\";\n}\n\n// ---- the view helpers --------------------------------------------------------------\n\nfn piece(i: u64) -> View {\n    let face = Container()\n        .width_height(PIECE, PIECE)\n        .color_bound(peek(K_BR0 + i) as u64)\n        .radius(14.0)\n        .border(0xFFFFFFFFu64, 2.0, BORDER_INSIDE)\n        .alignment(ALIGN_CENTER)\n        .query_key(f\"jw/piece-{i}\")\n        .child(\n            Text()\n                .text_bound(peek(K_LB0 + i) as u64)\n                .font_size(26.0)\n                .color(0xFFFFFFFFu64)\n                .query_key(f\"jw/piece-{i}-label\")\n                .build(),\n        )\n        .build();\n    return Positioned()\n        .left_bound(peek(K_PX0 + i) as u64)\n        .top_bound(peek(K_PY0 + i) as u64)\n        .width(PIECE)\n        .height(PIECE)\n        .child(\n            PointerInteract()\n                .ids(i, i)\n                .on_down2(p_down)\n                .on_move2(p_move)\n                .on_up2(p_up)\n                .query_key(f\"jw/pad-{i}\")\n                .child(face)\n                .build(),\n        )\n        .build();\n}\n\nfn ghost(s: u64) -> View {\n    return Positioned()\n        .left(slot_x(s))\n        .top(slot_y(s))\n        .width(PIECE)\n        .height(PIECE)\n        .child(\n            Container()\n                .width_height(PIECE, PIECE)\n                .color(0x1E293BFFu64)\n                .border(0x475569FFu64, 1.0, BORDER_INSIDE)\n                .radius(12.0)\n                .alignment(ALIGN_CENTER)\n                .query_key(f\"jw/ghost-{s}\")\n                .child(\n                    Text()\n                        .text(fmt_slot(s as f64))\n                        .font_size(16.0)\n                        .color(0x64748BFFu64)\n                        .query_key(f\"jw/ghost-{s}-num\")\n                        .build(),\n                )\n                .build(),\n        )\n        .build();\n}\n\nfn snap_hl_face() -> View {\n    return Container()\n        .width_height(PIECE, PIECE)\n        .color(0x22D3EE40u64)\n        .border(0x22D3EEFFu64, 2.5, BORDER_INSIDE)\n        .radius(14.0)\n        .query_key(\"jw/snap-hl\")\n        .build();\n}\n\nfn board_bg() -> View {\n    let w = BOARD_W + 4.0;\n    return Positioned()\n        .left(BOARD_X - 2.0)\n        .top(BOARD_Y - 2.0)\n        .width(w)\n        .height(w)\n        .child(\n            Container()\n                .width_height(w, w)\n                .color(0x0F172AFFu64)\n                .border(0x3B82F6FFu64, 2.0, BORDER_INSIDE)\n                .radius(16.0)\n                .shadow(0x3B82F628u64, 18.0, 0.0, 0.0)\n                .build(),\n        )\n        .build();\n}\n\nfn tray_bg() -> View {\n    let w = BOARD_W + 4.0;\n    return Positioned()\n        .left(TRAY_X - 2.0)\n        .top(TRAY_Y - 2.0)\n        .width(w)\n        .height(w)\n        .child(\n            Container()\n                .width_height(w, w)\n                .color(0x0A0F1DFFu64)\n                .border(0x334155FFu64, 1.0, BORDER_INSIDE)\n                .radius(16.0)\n                .build(),\n        )\n        .build();\n}\n\nfn top_bar() -> View {\n    let pill = Container()\n        .padding(10.0)\n        .radius(20.0)\n        .color(0x4F46E5FFu64)\n        .border(0x818CF8FFu64, 1.0, BORDER_INSIDE)\n        .shadow(0x4F46E578u64, 12.0, 0.0, 4.0)\n        .child(\n            Text()\n                .text(\"Shuffle\")\n                .font_size(13.0)\n                .color(0xFFFFFFFFu64)\n                .build(),\n        )\n        .build();\n    let chip = Container()\n        .padding(10.0)\n        .radius(8.0)\n        .color(0x1E293BFFu64)\n        .border(0x334155FFu64, 1.0, BORDER_INSIDE)\n        .child(\n            Text()\n                .text_bound_derived(rs_derive(fmt_count, peek(K_COUNT) as u64))\n                .font_size(14.0)\n                .color(0xE2E8F0FFu64)\n                .query_key(\"jw/counter\")\n                .build(),\n        )\n        .build();\n    return Positioned()\n        .left(12.0)\n        .right(12.0)\n        .top(12.0)\n        .child(\n            Row()\n                .main_alignment(MAIN_ALIGN_SPACE_BETWEEN)\n                .cross_alignment(CROSS_ALIGN_CENTER)\n                .child(\n                    MouseRegion()\n                        .cursor(CURSOR_POINTER)\n                        .child(\n                            PointerInteract()\n                                .on_tap(b_shuffle)\n                                .query_key(\"jw/shuffle\")\n                                .child(pill)\n                                .build(),\n                        )\n                        .build(),\n                )\n                .child(chip)\n                .build(),\n        )\n        .build();\n}\n\nfn win_banner() -> View {\n    return Positioned()\n        .left(0.0)\n        .top(0.0)\n        .right(0.0)\n        .bottom(0.0)\n        .child(\n            Container()\n                .color(0x020617C8u64)\n                .alignment(ALIGN_CENTER)\n                .child(\n                    Container()\n                        .padding(24.0)\n                        .radius(18.0)\n                        .color(0x4F46E5FFu64)\n                        .border(0x818CF8FFu64, 2.0, BORDER_INSIDE)\n                        .shadow(0x4F46E5B4u64, 32.0, 0.0, 8.0)\n                        .query_key(\"jw/banner\")\n                        .child(\n                            Text()\n                                .text(\"Solved!\")\n                                .font_size(34.0)\n                                .color(0xFFFFFFFFu64)\n                                .build(),\n                        )\n                        .build(),\n                )\n                .build(),\n        )\n        .build();\n}\n";
    }
    if (name == "lazy-grid-basic") {
        return "// lazy-grid-basic: the boa restyle — 500 labeled hue squares. Hue =\n// (i*47) % 360 at 55/50 (the boa hslToHex sextant math), white index\n// labels (11px, top-left per the boa tile), max cross 110, default square\n// aspect, overscan 1; wheel-scroll mounts only the visible window. The\n// boa 4px grid spacing has no lazy-grid row, so each cell pads 2 — the\n// between-tile gap re-forms as 2+2 of pane background (the sanctioned\n// case-side stand-in; the outer edges sit 2px in where boa's sit flush).\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyGrid, Text };\n\n\nfn cell(i: u64) -> opaque {\n    let tile = Container()\n        .color(hsl_packed(((i * 47) % 360) as f64, 55.0, 50.0))\n        .child(Text().text(f\"{i}\").font_size(11.0).color(0xFFFFFFFFu64).build())\n        .build();\n    return Container().padding(2.0).child(tile).build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 500.0);\n    let grid = LazyGrid()\n        .item_builder(cell)\n        .count(count)\n        .max_cross(110.0)\n        .aspect(1.0)\n        .overscan(1)\n        .query_key(\"lazy-grid-basic\")\n        .build();\n    mount(grid);\n}\n\n// ---- the tile ramp ------------------------------------------------------------\n\n// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).\nfn hsl_packed(h: f64, s: f64, l: f64) -> u64 {\n    let sat: f64 = s / 100.0;\n    let light: f64 = l / 100.0;\n    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;\n    let hue: f64 = h % 360.0;\n    let hp: f64 = hue / 60.0;\n    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));\n    let mut r1: f64 = 0.0;\n    let mut g1: f64 = 0.0;\n    let mut b1: f64 = 0.0;\n    if (hp < 1.0) {\n        r1 = c;\n        g1 = x;\n    } else if (hp < 2.0) {\n        r1 = x;\n        g1 = c;\n    } else if (hp < 3.0) {\n        g1 = c;\n        b1 = x;\n    } else if (hp < 4.0) {\n        g1 = x;\n        b1 = c;\n    } else if (hp < 5.0) {\n        r1 = x;\n        b1 = c;\n    } else {\n        r1 = c;\n        b1 = x;\n    }\n    let m: f64 = light - c / 2.0;\n    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;\n    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;\n    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;\n    return r * 16777216 + g * 65536 + b * 256 + 255;\n}\n\nfn abs_f(v: f64) -> f64 {\n    if (v < 0.0) {\n        return -v;\n    }\n    return v;\n}\n";
    }
    if (name == "lazy-grid-gallery") {
        return "// lazy-grid-gallery: \"Lazy Grid Gallery\" — the massive virtualized palette\n// (the full boa restyle). 6,000 tiles; only the visible window + overscan\n// mounts, so scrolling stays smooth no matter how deep. The flush-left\n// header (title + the \"6000 tiles · only the visible rows mount — scroll\n// to explore\" subtitle) sits above the Square/Wide/Tall aspect chips and\n// the Normal/Dense density chips and an Expanded, rounded panel holding\n// the grid.\n//\n// Reactivity: the LazyGrid's max_cross / aspect rows are static per build,\n// so the chips ride the rebuild-on-change idiom — the grid hangs on a\n// one-item Each and every tap rewrites the list atom, re-mounting a fresh\n// LazyGrid that reads the live aspect / density state (the\n// lazy-list-var-sizes axis-flip pattern; the eager grid-gallery spells the\n// same matrix out as one flat Switch). Chip fills ride per-chip brush\n// atoms (rs_set_brush), seeded + repainted from the tap intents.\n//\n// Deltas vs boa, deliberate: the boa 4px grid spacing has no lazy-grid\n// row, so each cell pads 2 — the between-tile gap re-forms as 2+2 of the\n// panel background; tiles carry a 6px radius (the audit's \"rounded hue\n// tiles\"); the aspect re-derive remounts the grid (scroll resets) where\n// boa reflows in place.\nuse tur::{\n    CROSS_ALIGN_START, CURSOR_POINTER, MAIN_SIZE_MIN, mount, rs_get_bool, rs_get_f64,\n    rs_list_new, rs_list_push, rs_set_bool, rs_set_brush, rs_set_f64, rs_set_value,\n    rs_source_bool, rs_source_f64, rs_source_value, stf_put, stf_take,\n};\nuse tur_kit::{\n    Column, Container, Each, Expanded, LazyGrid, MouseRegion, PointerInteract, Row, SizedBox, Text,\n};\n\n\n// The scalar-stash keys (atom ids cross the entries as f64).\nlet K_ASPECT: u64 = 1; // the aspect atom (1 = square, 2 = wide, 0.5 = tall)\nlet K_DENSE: u64 = 2; // the density bool atom\nlet K_COUNT: u64 = 3; // the 6000-item count atom\nlet K_ITEMS: u64 = 4; // the one-item list re-mounting the grid\nlet K_SQ: u64 = 5; // the Square chip brush\nlet K_WD: u64 = 6; // the Wide chip brush\nlet K_TL: u64 = 7; // the Tall chip brush\nlet K_NM: u64 = 8; // the Normal chip brush\nlet K_DS: u64 = 9; // the Dense chip brush\n\n// The boa palette (the deep-slate gallery chrome).\nlet PAGE_BG: u64 = 0x0F172AFFu64;\nlet TITLE_FG: u64 = 0xF1F5F9FFu64;\nlet SUB_FG: u64 = 0x94A3B8FFu64;\nlet PANEL_BG: u64 = 0x020617FFu64;\nlet CHIP_ON: u64 = 0x6366F1FFu64;\nlet CHIP_OFF: u64 = 0x1E293BFFu64;\nlet CHIP_FG: u64 = 0xE2E8F0FFu64;\n\nentry fn start() {\n    let aspect = rs_source_f64();\n    rs_set_f64(aspect, 1.0);\n    let dense = rs_source_bool(false);\n    let count = rs_source_f64();\n    rs_set_f64(count, 6000.0);\n    let items = rs_source_value(one_list());\n    stf_put(K_ASPECT, aspect as f64);\n    stf_put(K_DENSE, dense as f64);\n    stf_put(K_COUNT, count as f64);\n    stf_put(K_ITEMS, items as f64);\n\n    // The five chip brushes, seeded to the boot state (Square + Normal).\n    let sq = rs_source_f64();\n    stf_put(K_SQ, sq as f64);\n    let wd = rs_source_f64();\n    stf_put(K_WD, wd as f64);\n    let tl = rs_source_f64();\n    stf_put(K_TL, tl as f64);\n    let nm = rs_source_f64();\n    stf_put(K_NM, nm as f64);\n    let ds = rs_source_f64();\n    stf_put(K_DS, ds as f64);\n    paint_chips();\n\n    let col = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .query_key(\"gallery/col\")\n        .child(Text().text(\"Lazy Grid Gallery\").font_size(18.0).color(TITLE_FG).query_key(\"gallery/header\").build())\n        .child(SizedBox(0.0, 4.0).build())\n        .child(Text().text(\"6000 tiles · only the visible rows mount — scroll to explore\").font_size(12.0).color(SUB_FG).build())\n        .child(SizedBox(0.0, 12.0).build())\n        .child(\n            Row()\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(chip(sq, \"gallery/a-square\", \"Square\", b_square))\n                .child(SizedBox(6.0, 0.0).build())\n                .child(chip(wd, \"gallery/a-wide\", \"Wide\", b_wide))\n                .child(SizedBox(6.0, 0.0).build())\n                .child(chip(tl, \"gallery/a-tall\", \"Tall\", b_tall))\n                .build(),\n        )\n        .child(SizedBox(0.0, 8.0).build())\n        .child(\n            Row()\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(chip(nm, \"gallery/d-normal\", \"Normal\", b_normal))\n                .child(SizedBox(6.0, 0.0).build())\n                .child(chip(ds, \"gallery/d-dense\", \"Dense\", b_dense))\n                .build(),\n        )\n        .child(SizedBox(0.0, 12.0).build())\n        .child(\n            Expanded().flex(1.0).child(\n                Container()\n                    .color(PANEL_BG)\n                    .radius(10.0)\n                    .child(Each(items).item_builder(grid_of).build())\n                    .build(),\n            ).build(),\n        )\n        .build();\n\n    mount(Container().color(PAGE_BG).padding(16.0).child(col).build());\n}\n\n// ---- the grid (the rebuild channel) --------------------------------------------\n\n// A fresh one-item list — rewriting it re-invokes the Each (the grid\n// re-mounts with the live aspect / density read at build time).\nfn one_list() -> opaque {\n    let fresh = rs_list_new();\n    rs_list_push(fresh, \"grid\");\n    return fresh;\n}\n\n// The Each branch: one LazyGrid over the LIVE state (aspect shapes the\n// cells; density narrows the max cross 140 → 85 — more, smaller tiles).\nfn grid_of(_i: u64, _s: str) -> opaque {\n    let aspect = stf_take(K_ASPECT) as u64;\n    stf_put(K_ASPECT, aspect as f64);\n    let dense = stf_take(K_DENSE) as u64;\n    stf_put(K_DENSE, dense as f64);\n    let count = stf_take(K_COUNT) as u64;\n    stf_put(K_COUNT, count as f64);\n    let mut max_cross: f64 = 140.0;\n    if (rs_get_bool(dense)) {\n        max_cross = 85.0;\n    }\n    return LazyGrid()\n        .item_builder(tile)\n        .count(count)\n        .max_cross(max_cross)\n        .aspect(rs_get_f64(aspect))\n        .overscan(2)\n        .query_key(\"gallery/grid\")\n        .build();\n}\n\n// One tile: the rounded hue face (hue = (i*37) % 360 at 52/48) with the\n// index label, inset 2 in its cell (the spacing stand-in — see the header\n// note).\nfn tile(i: u64) -> opaque {\n    let face = Container()\n        .color(hsl_packed(((i * 37) % 360) as f64, 52.0, 48.0))\n        .radius(6.0)\n        .child(Text().text(f\"{i}\").font_size(10.0).color(CHIP_FG).build())\n        .build();\n    return Container().padding(2.0).child(face).build();\n}\n\n// ---- the chips -----------------------------------------------------------------\n\n// A pill chip: the fill rides its brush atom (indigo when active).\nfn chip(atom: u64, key: str, label: str, cb: fn(u64, u64, f64)) -> opaque {\n    let face = Container()\n        .padding(7.0)\n        .radius(7.0)\n        .color_bound(atom)\n        .child(Text().text(label).font_size(12.0).color(CHIP_FG).build())\n        .build();\n    return MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(PointerInteract().on_tap(cb).query_key(key).child(face).build())\n        .build();\n}\n\n// ---- the chip taps ---------------------------------------------------------------\n\nfn b_square(_a: u64, _b: u64, _n: f64) { aspect_to(1.0); }\nfn b_wide(_a: u64, _b: u64, _n: f64) { aspect_to(2.0); }\nfn b_tall(_a: u64, _b: u64, _n: f64) { aspect_to(0.5); }\nfn b_normal(_a: u64, _b: u64, _n: f64) { dense_to(false); }\nfn b_dense(_a: u64, _b: u64, _n: f64) { dense_to(true); }\n\n// An aspect tap: write the atom, repaint the chips, remount the grid.\nfn aspect_to(v: f64) {\n    let aspect = stf_take(K_ASPECT) as u64;\n    stf_put(K_ASPECT, aspect as f64);\n    rs_set_f64(aspect, v);\n    paint_chips();\n    remount_grid();\n}\n\n// A density tap: same rail over the bool atom.\nfn dense_to(d: bool) {\n    let dense = stf_take(K_DENSE) as u64;\n    stf_put(K_DENSE, dense as f64);\n    rs_set_bool(dense, d);\n    paint_chips();\n    remount_grid();\n}\n\n// The five chip brushes over the live state (boa: derive-driven pills).\nfn paint_chips() {\n    let aspect = stf_take(K_ASPECT) as u64;\n    stf_put(K_ASPECT, aspect as f64);\n    let dense = stf_take(K_DENSE) as u64;\n    stf_put(K_DENSE, dense as f64);\n    let a = rs_get_f64(aspect);\n    let d = rs_get_bool(dense);\n    let sq = stf_take(K_SQ) as u64;\n    stf_put(K_SQ, sq as f64);\n    let wd = stf_take(K_WD) as u64;\n    stf_put(K_WD, wd as f64);\n    let tl = stf_take(K_TL) as u64;\n    stf_put(K_TL, tl as f64);\n    let nm = stf_take(K_NM) as u64;\n    stf_put(K_NM, nm as f64);\n    let ds = stf_take(K_DS) as u64;\n    stf_put(K_DS, ds as f64);\n    rs_set_brush(sq, chip_color(a > 0.5 && a < 1.5));\n    rs_set_brush(wd, chip_color(a > 1.5));\n    rs_set_brush(tl, chip_color(a < 0.5));\n    rs_set_brush(nm, chip_color(!d));\n    rs_set_brush(ds, chip_color(d));\n}\n\nfn chip_color(on: bool) -> u64 {\n    if (on) {\n        return CHIP_ON;\n    }\n    return CHIP_OFF;\n}\n\n// The rebuild channel: a fresh one-item list re-invokes the Each.\nfn remount_grid() {\n    let items = stf_take(K_ITEMS) as u64;\n    stf_put(K_ITEMS, items as f64);\n    rs_set_value(items, one_list());\n}\n\n// ---- the tile ramp ---------------------------------------------------------------\n\n// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).\nfn hsl_packed(h: f64, s: f64, l: f64) -> u64 {\n    let sat: f64 = s / 100.0;\n    let light: f64 = l / 100.0;\n    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;\n    let hue: f64 = h % 360.0;\n    let hp: f64 = hue / 60.0;\n    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));\n    let mut r1: f64 = 0.0;\n    let mut g1: f64 = 0.0;\n    let mut b1: f64 = 0.0;\n    if (hp < 1.0) {\n        r1 = c;\n        g1 = x;\n    } else if (hp < 2.0) {\n        r1 = x;\n        g1 = c;\n    } else if (hp < 3.0) {\n        g1 = c;\n        b1 = x;\n    } else if (hp < 4.0) {\n        g1 = x;\n        b1 = c;\n    } else if (hp < 5.0) {\n        r1 = x;\n        b1 = c;\n    } else {\n        r1 = c;\n        b1 = x;\n    }\n    let m: f64 = light - c / 2.0;\n    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;\n    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;\n    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;\n    return r * 16777216 + g * 65536 + b * 256 + 255;\n}\n\nfn abs_f(v: f64) -> f64 {\n    if (v < 0.0) {\n        return -v;\n    }\n    return v;\n}\n";
    }
    if (name == "lazy-grid-scroll") {
        return "// lazy-grid-scroll: a 600-cell grid — wheeling mounts rows outside the\n// initial build set.\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyGrid };\n\n\nfn cell(i: u64) -> opaque {\n    let mut b = Container().width_height(0.0, 0.0);\n    if (i % 2 == 0) {\n        b.color(0x303030FF);\n    } else {\n        b.color(0x1A1A1AFF);\n    }\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 600.0);\n    let grid = LazyGrid().item_builder(cell).count(count).max_cross(150.0).aspect(1.0).query_key(\"lazy-grid-scroll\").build();\n    mount(grid);\n}\n";
    }
    if (name == "lazy-list-var-sizes") {
        return "// lazy-list-var-sizes: the boa \"Variable width + height LazyList\" —\n// items with DIFFERENT main-axis extents (no itemExtent: every visible\n// item is measured and anchored). The indigo toggle flips the axis at\n// runtime: the list rides a one-item Each over the axis atom, so the\n// flip re-mounts a fresh LazyList (the rebuild-on-change idiom). Rows\n// show a colored width-bar (cross-axis sizes clamp to the viewport, so\n// \"different widths\" lives INSIDE the row) + the h/bar labels on a\n// zebra fill.\n//\n// Deterministic per-index sizes via the boa sine-hash (math_sin is the\n// engine's only trig row — exactly what the hash needs).\nuse tur::{ ALIGN_CENTER, ALIGN_CENTER_LEFT, ALIGN_TOP_CENTER, AXIS_HORIZONTAL, AXIS_VERTICAL,\n    CURSOR_POINTER, CROSS_ALIGN_CENTER, CROSS_ALIGN_START, MAIN_SIZE_MIN, math_sin, mount,\n    rs_get_bool, rs_list_new, rs_list_push, rs_set_bool, rs_set_value, rs_source_bool,\n    rs_source_value, stf_put, stf_take, str_parse_f64 };\nuse tur_kit::{ Column, Condition, Container, Each, Expanded, LazyList, MouseRegion,\n    PointerInteract, Row, SizedBox, Text };\n\n\nlet ITEM_COUNT: f64 = 2000.0;\n\nlet K_AXIS: u64 = 1; // the axis bool atom (true = vertical)\nlet K_ITEMS: u64 = 2; // the one-item list that re-mounts the list\nlet K_COUNT: u64 = 3; // the item-count atom\n\n// The palette (the hsl(65,55) sweep's table twin), as \"r,g,b\" slots.\nlet BAR_HUES: str = \"217,87,87|217,126,87|203,164,63|132,180,91|71,171,139|70,163,196|79,134,198|110,110,214|146,104,219|180,104,219|204,102,175|197,102,119\";\n\nlet ZEBRA_A: u64 = 0x0F172AFFu64;\nlet ZEBRA_B: u64 = 0x1E293BFFu64;\nlet LABEL: u64 = 0xCBD5E1FFu64;\nlet LABEL_FAINT: u64 = 0x64748BFFu64;\n\nentry fn start() {\n    let axis = rs_source_bool(true);\n    stf_put(K_AXIS, axis as f64);\n    let items = rs_source_value(one_list());\n    stf_put(K_ITEMS, items as f64);\n    let count = rs_source_f64();\n    rs_set_f64(count, ITEM_COUNT);\n    stf_put(K_COUNT, count as f64);\n\n    let toggle = MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(\n            PointerInteract()\n                .ids(axis, items)\n                .on_tap(b_flip)\n                .query_key(\"var-sizes-toggle\")\n                .child(\n                    Container()\n                        .padding(10.0)\n                        .radius(8.0)\n                        .color(0x4F46E5FFu64)\n                        .child(\n                            Condition(axis)\n                                .then_build(fn () -> View { return Text().text(\"Axis: Vertical  (click to flip)\").font_size(13.0).color(0xFFFFFFFFu64).build(); })\n                                .else_build(fn () -> View { return Text().text(\"Axis: Horizontal  (click to flip)\").font_size(13.0).color(0xFFFFFFFFu64).build(); })\n                                .build(),\n                        )\n                        .build(),\n                )\n                .build(),\n        )\n        .build();\n\n    let list_host = Container()\n        .radius(8.0)\n        .color(0x0B1220FFu64)\n        .child(Each(items).item_builder(list_of).build())\n        .build();\n\n    let col = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(toggle)\n        .child(SizedBox(0.0, 12.0).build())\n        .child(Expanded().flex(1.0).child(list_host).build())\n        .build();\n\n    mount(Container().color(0x020617FFu64).padding(16.0).child(col).build());\n}\n\n// A fresh one-item list — rewriting it re-invokes the Each builder (the\n// list re-mounts with the axis read fresh).\nfn one_list() -> opaque {\n    let fresh = rs_list_new();\n    rs_list_push(fresh, \"list\");\n    return fresh;\n}\n\n// The Each branch: one LazyList keyed by the current axis.\nfn list_of(_i: u64, _s: str) -> opaque {\n    let axis = stf_take(K_AXIS);\n    stf_put(K_AXIS, axis);\n    let count = stf_take(K_COUNT);\n    stf_put(K_COUNT, count);\n    if (rs_get_bool(axis as u64)) {\n        return LazyList()\n            .item_builder(item)\n            .count(count as u64)\n            .overscan(2)\n            .axis(AXIS_VERTICAL)\n            .query_key(\"var-sizes-v\")\n            .build();\n    }\n    return LazyList()\n        .item_builder(item)\n        .count(count as u64)\n        .overscan(2)\n        .axis(AXIS_HORIZONTAL)\n        .query_key(\"var-sizes-h\")\n        .build();\n}\n\n// The deterministic main-axis extent: the boa sine-hash → [30, 180].\nfn main_size(i: u64) -> f64 {\n    let x = math_sin(i as f64 * 12.9898) * 43758.5453;\n    return 30.0 + frac_pos(x) * 151.0;\n}\n\n// x - floor(x), floored by hand (no floor row): negatives wrap positive.\nfn frac_pos(x: f64) -> f64 {\n    let mut fl = x as i64 as f64;\n    if (x < 0.0 && fl > x) {\n        fl = fl - 1.0;\n    }\n    return x - fl;\n}\n\n// The inner bar's cross size — the \"different widths\" proof.\nfn cross_size(i: u64) -> f64 {\n    return 60.0 + ((i * 37) % 200) as f64;\n}\n\n// Odd rows carry the lighter zebra fill (boa: #0f172a / #1e293b).\nfn zebra_fill(i: u64) -> u64 {\n    if (i % 2 == 1) {\n        return ZEBRA_B;\n    }\n    return ZEBRA_A;\n}\n\n// One item — a vertical row or a horizontal column, per the live axis.\nfn item(i: u64) -> opaque {\n    let main = main_size(i);\n    let cross = cross_size(i);\n    let bar_color = pal(BAR_HUES, (i * 5) % 12);\n    let zebra = zebra_fill(i);\n    let axis = stf_take(K_AXIS);\n    stf_put(K_AXIS, axis);\n    if (rs_get_bool(axis as u64)) {\n        return vertical_item(i, main, cross, bar_color, zebra);\n    }\n    return horizontal_item(i, main, cross, bar_color, zebra);\n}\n\n// The i'th '|'-separated slot of a data string.\nfn slot(data: str, i: u64) -> str {\n    let n = data.len();\n    let mut start = 0;\n    let mut k = 0;\n    let mut cur: u64 = 0;\n    while (k <= n) {\n        if (k == n || data.code_at(k) == 124) {\n            if (cur == i) {\n                return data.slice(start, k);\n            }\n            cur = cur + 1;\n            start = k + 1;\n        }\n        k = k + 1;\n    }\n    return \"\";\n}\n\n// The i'th \"r,g,b\" slot packed as 0xRRGGBBAA.\nfn pal(data: str, i: u64) -> u64 {\n    let rgb = slot(data, i);\n    let n = rgb.len();\n    let a = idx_of(rgb, 0, 44);\n    let b = idx_of(rgb, a + 1, 44);\n    let r = str_parse_f64(rgb.slice(0, a));\n    let g = str_parse_f64(rgb.slice(a + 1, b));\n    let bl = str_parse_f64(rgb.slice(b + 1, n));\n    return r as u64 * 16777216 + g as u64 * 65536 + bl as u64 * 256 + 255;\n}\n\n// The first ',' from `from` (the r,g,b splitter).\nfn idx_of(s: str, from: i32, c: u32) -> i32 {\n    let n = s.len();\n    let mut k = from;\n    while (k < n) {\n        if (s.code_at(k) == c) {\n            return k;\n        }\n        k = k + 1;\n    }\n    return -1;\n}\n\n// Vertical row: full-width (clamped), height = main; the inner bar of\n// width `cross` + the #i/h/bar label.\nfn vertical_item(i: u64, main: f64, cross: f64, bar_color: u64, zebra: u64) -> opaque {\n    let mut bar_h = main - 16.0;\n    if (bar_h > 26.0) {\n        bar_h = 26.0;\n    }\n    let label = f\"#{i}  h={main as u64}  bar={cross as u64}\";\n    let bar = Container().width_height(cross, bar_h).radius(4.0).color(bar_color).build();\n    let line = Row()\n        .main_axis_size(MAIN_SIZE_MIN)\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(bar)\n        .child(SizedBox(10.0, 0.0).build())\n        .child(Text().text(label).font_size(11.0).color(LABEL).build())\n        .build();\n    return Container()\n        .height(main)\n        .color(zebra)\n        .padding(8.0)\n        .alignment(ALIGN_CENTER_LEFT)\n        .query_key(\"var-sizes-item\")\n        .child(line)\n        .build();\n}\n\n// Horizontal column: full-height (clamped), width = main; the inner bar\n// of height `cross` + the #i / w= labels.\nfn horizontal_item(i: u64, main: f64, cross: f64, bar_color: u64, zebra: u64) -> opaque {\n    let mut bar_w = main - 16.0;\n    if (bar_w > 26.0) {\n        bar_w = 26.0;\n    }\n    let count_label = f\"#{i}\";\n    let width_label = f\"w={main as u64}\";\n    let bar = Container().width_height(bar_w, cross).radius(4.0).color(bar_color).build();\n    let line = Column()\n        .main_axis_size(MAIN_SIZE_MIN)\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(bar)\n        .child(SizedBox(0.0, 8.0).build())\n        .child(Text().text(count_label).font_size(11.0).color(LABEL).build())\n        .child(Text().text(width_label).font_size(10.0).color(LABEL_FAINT).build())\n        .build();\n    return Container()\n        .width(main)\n        .color(zebra)\n        .padding(8.0)\n        .alignment(ALIGN_TOP_CENTER)\n        .child(line)\n        .build();\n}\n\n// The flip: toggle the axis atom + rewrite the one-item list (the Each\n// re-mounts the LazyList with the fresh axis).\nfn b_flip(axis: u64, items: u64, _n: f64) {\n    rs_set_bool(axis, !rs_get_bool(axis));\n    rs_set_value(items, one_list());\n}\n";
    }
    if (name == "lazy-list-virtualized") {
        return "// lazy-list-virtualized: the boa \"10,000-item Contact List\" — fixed\n// 56px rows, only the visible window (+ overscan) mounts. Each row: a\n// colored initials avatar (a rounded Container + Text), the name and the\n// \"Item #i of 10000\" subtitle on a zebra fill.\n//\n// The name/initials/hue are deterministic per index (the boa generator,\n// palette-string twin: module lets are literals-only in this build, so\n// the name lists and the avatar palette ride pipe-joined strings).\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, CROSS_ALIGN_START, MAIN_ALIGN_CENTER, MAIN_SIZE_MIN,\n    mount, rs_set_f64, rs_source_f64, str_parse_f64 };\nuse tur_kit::{ Column, Container, Expanded, LazyList, Row, SizedBox, Text };\n\n\nlet ITEM_COUNT: f64 = 10000.0;\nlet ITEM_HEIGHT: f64 = 56.0;\n\n// The boa name generator (26 first × 26 last, stride 7).\nlet FIRST_NAMES: str = \"Asha|Bryn|Cai|Dara|Eva|Finn|Gita|Hugo|Iris|Jin|Kai|Lior|Mira|Noa|Olin|Pia|Quinn|Ren|Suri|Theo|Uma|Vera|Wim|Xan|Yara|Zane\";\nlet LAST_NAMES: str = \"Albright|Bauer|Cohen|Dixon|Eng|Frost|Grant|Hayes|Iyer|Jang|Kerr|Lin|Mehta|Novak|Okafor|Patel|Quinn|Reyes|Shin|Tran|Ueda|Vargas|Wong|Xu|Yoon|Zhou\";\n\n// The avatar palette (12 pleasant hues — the hsl(60,55) sweep's twin).\nlet HUES: str = \"224,86,86|224,128,86|214,169,69|127,176,105|63,167,150|66,158,185|74,127,181|106,103,206|145,99,207|183,99,207|201,93,159|194,91,110\";\n\nlet TEXT: u64 = 0x0F172AFFu64;\nlet TEXT_MUTED: u64 = 0x64748BFFu64;\nlet ZEBRA: u64 = 0xF8FAFCFFu64;\nlet WHITE: u64 = 0xFFFFFFFFu64;\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, ITEM_COUNT);\n\n    let list = LazyList()\n        .item_builder(row)\n        .count(count)\n        .item_extent(ITEM_HEIGHT)\n        .overscan(4)\n        .query_key(\"lazy-list-virtualized\")\n        .build();\n    mount(Expanded().flex(1.0).child(Container().color(WHITE).child(list).build()).build());\n}\n\n// The i'th '|'-separated slot of a data string.\nfn slot(data: str, i: u64) -> str {\n    let n = data.len();\n    let mut start = 0;\n    let mut k = 0;\n    let mut cur: u64 = 0;\n    while (k <= n) {\n        if (k == n || data.code_at(k) == 124) {\n            if (cur == i) {\n                return data.slice(start, k);\n            }\n            cur = cur + 1;\n            start = k + 1;\n        }\n        k = k + 1;\n    }\n    return \"\";\n}\n\n// The first ',' from `from` (the r,g,b splitter).\nfn idx_of(s: str, from: i32, c: u32) -> i32 {\n    let n = s.len();\n    let mut k = from;\n    while (k < n) {\n        if (s.code_at(k) == c) {\n            return k;\n        }\n        k = k + 1;\n    }\n    return -1;\n}\n\n// The i'th \"r,g,b\" slot packed as 0xRRGGBBAA.\nfn pal(i: u64) -> u64 {\n    let rgb = slot(HUES, i);\n    let n = rgb.len();\n    let a = idx_of(rgb, 0, 44);\n    let b = idx_of(rgb, a + 1, 44);\n    let r = str_parse_f64(rgb.slice(0, a));\n    let g = str_parse_f64(rgb.slice(a + 1, b));\n    let bl = str_parse_f64(rgb.slice(b + 1, n));\n    return r as u64 * 16777216 + g as u64 * 65536 + bl as u64 * 256 + 255;\n}\n\n// \"Asha Bauer\" — the deterministic per-index generator.\nfn name_for(i: u64) -> str {\n    let first = slot(FIRST_NAMES, i % 26);\n    let last = slot(LAST_NAMES, (i * 7) % 26);\n    return f\"{first} {last}\";\n}\n\n// Odd rows carry the faint zebra tint (boa: white / slate-50).\nfn zebra_fill(i: u64) -> u64 {\n    if (i % 2 == 1) {\n        return ZEBRA;\n    }\n    return WHITE;\n}\n\n// The row: initials avatar + name + the \"Item #i of 10000\" subtitle.\nfn row(i: u64) -> opaque {\n    let name = name_for(i);\n    let n = name.len();\n    let mut sp = 0;\n    while (sp < n) {\n        if (name.code_at(sp) == 32) {\n            break;\n        }\n        sp = sp + 1;\n    }\n    let initials = f\"{name.slice(0, 1)}{name.slice(sp + 1, sp + 2)}\";\n    let avatar_bg = pal((i * 11) % 12);\n    let sub = f\"Item #{i + 1} of 10000\";\n    let avatar = Container()\n        .width_height(36.0, 36.0)\n        .radius(999.0)\n        .color(avatar_bg)\n        .alignment(ALIGN_CENTER)\n        .child(Text().text(initials).font_size(13.0).color(WHITE).build())\n        .build();\n    let lines = Column()\n        .main_alignment(MAIN_ALIGN_CENTER)\n        .cross_alignment(CROSS_ALIGN_START)\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(Text().text(name).font_size(13.0).color(TEXT).build())\n        .child(SizedBox(0.0, 2.0).build())\n        .child(Text().text(sub).font_size(11.0).color(TEXT_MUTED).build())\n        .build();\n    let inner = Row()\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(avatar)\n        .child(SizedBox(12.0, 0.0).build())\n        .child(Expanded().flex(1.0).child(lines).build())\n        .build();\n    return Container()\n        .height(ITEM_HEIGHT)\n        .padding(12.0)\n        .color(zebra_fill(i))\n        .query_key(\"contact-row\")\n        .child(inner)\n        .build();\n}\n";
    }
    if (name == "password-input") {
        return "// password-input: the boa design — a plain Input, a password Input, and\n// a live `value: \"…\"` readout of the password controller's true text.\n// Typing renders bullets in the password field while the controller keeps\n// the real value (the on-input rail feeds the readout). A seeded\n// \"hunter2\" boots the field; the reveal pill flips the obscure flag via\n// obscure_bound (the reactive mask — no rebuild) and rebuilds its own\n// label through a Condition on the same atom.\n//\n// Phase-2 note: this case is typed in the playground VIEWER too — the\n// va-child keyboard rail forwards real keys into the focused child input.\nuse tur::{ CROSS_ALIGN_CENTER, CROSS_ALIGN_START, CURSOR_POINTER, mount, rs_get_bool,\n    rs_set_bool, rs_set_str, rs_source_bool, rs_source_str, st_put, st_take, stf_put, tctrl_new,\n    tctrl_set_text, tctrl_text, undo_new };\nuse tur_kit::{ Column, Condition, Container, Input, MouseRegion, PointerInteract, Row, SizedBox,\n    Text };\n\n\nlet K_OBSCURE: u64 = 1;\nlet K_CTRL: u64 = 2;\nlet K_VALUE: u64 = 4;\n\nentry fn start() -> u64 {\n    let obscure = rs_source_bool(true);\n    stf_put(K_OBSCURE, obscure as f64);\n    let value = rs_source_str(\"value: \\\"hunter2\\\"\");\n    stf_put(K_VALUE, value as f64);\n    let ctrl = tctrl_new();\n    tctrl_set_text(ctrl, \"hunter2\");\n    st_put(K_CTRL, ctrl);\n    let undo = undo_new();\n\n    let plain = Input()\n        .controller(tctrl_new())\n        .undo(undo_new())\n        .placeholder(\"Plain\")\n        .font_size(16.0)\n        .width_height(240.0, 38.0)\n        .query_key(\"plain\")\n        .build();\n    let password = Input()\n        .controller(ctrl)\n        .undo(undo)\n        .placeholder(\"Password\")\n        .obscure_bound(obscure)\n        .on_input(on_value, 0)\n        .font_size(16.0)\n        .width_height(240.0, 38.0)\n        .query_key(\"password\")\n        .build();\n\n    let col = Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .child(Text().text(\"Password Input\").font_size(18.0).color(0x0F172AFFu64).query_key(\"password-title\").build())\n        .child(SizedBox(0.0, 12.0).build())\n        .child(plain)\n        .child(SizedBox(0.0, 12.0).build())\n        .child(password)\n        .child(SizedBox(0.0, 12.0).build())\n        .child(\n            Row()\n                .cross_alignment(CROSS_ALIGN_CENTER)\n                .child(Text().text_bound(value).font_size(12.0).color(0x64748BFFu64).query_key(\"password-value\").build())\n                .child(SizedBox(12.0, 0.0).build())\n                .child(Condition(obscure).then_build(fn () -> View { return reveal_pill(\"Show\"); }).else_build(fn () -> View { return reveal_pill(\"Hide\"); }).build())\n                .build(),\n        )\n        .build();\n\n    mount(Container().padding(32.0).child(col).build());\n    return obscure;\n}\n\n// The reveal pill — Show while masked, Hide while revealed. (No ids: the\n// tap handler reads the atom from the stash.)\nfn reveal_pill(label: str) -> opaque {\n    let face = Container()\n        .padding(6.0)\n        .radius(7.0)\n        .color(0xF1F5F9FFu64)\n        .child(Text().text(label).font_size(11.0).color(0x334155FFu64).build())\n        .build();\n    return MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(\n            PointerInteract()\n                .on_tap(b_toggle)\n                .query_key(\"password-reveal\")\n                .child(face)\n                .build(),\n        )\n        .build();\n}\n\n// The on-input rail: the controller's fresh true text lands on the\n// readout atom, wrapped as value: \"…\".\nfn on_value(_id: u64, _b: u64, _n: f64) {\n    let value = stf_take(K_VALUE);\n    stf_put(K_VALUE, value);\n    let ctrl = st_take(K_CTRL);\n    st_put(K_CTRL, ctrl);\n    let text = tctrl_text(ctrl);\n    let q: str = \"\\\"\";\n    rs_set_str(value as u64, f\"value: {q}{text}{q}\");\n}\n\nfn b_toggle(_a: u64, _b: u64, _n: f64) {\n    let obscure = stf_take(K_OBSCURE);\n    stf_put(K_OBSCURE, obscure);\n    rs_set_bool(obscure as u64, !rs_get_bool(obscure as u64));\n}\n";
    }
    if (name == "table-basic") {
        return "// table-basic: the Table element showcase (the boa design) — shared\n// column geometry (a fixed 150px name column, a flex-1 notes column, a\n// flex-2 min-120 distance column) over 6 planets, a\n// PLANET/NOTES/DISTANCE header, alternating stripes and notes that WRAP\n// in the flex column.\n//\n// Sanctioned-surface note: the kit's Table class exposes no stripe/divider\n// rows, so the stripes are cell-painted (odd rows tint their cells) — the\n// same look, authored case-side. Row extents stay intrinsic so the\n// wrapped notes are never clipped. (Module lets are literals-only in this\n// build, so the planet data rides pipe-joined strings.)\nuse tur::{ mount, rs_list_new, rs_list_push, rs_set_value, rs_source_value };\nuse tur_kit::{ Container, Expanded, Table, TableCols, Text };\n\n\n// The planet data (pipe-joined slots — the row builder indexes by row).\nlet P_NAME: str = \"Mercury|Venus|Earth|Mars|Jupiter|Saturn\";\nlet P_NOTES: str = \"Smallest planet, closest to the Sun|Hottest surface in the solar system|The only known home of life|The red planet, home to Olympus Mons|Largest planet, a gas giant|Famous for its ring system\";\nlet P_DIST: str = \"0.39 AU|0.72 AU|1.00 AU|1.52 AU|5.20 AU|9.58 AU\";\n\n// The boa palette (dark slate table on the #0b1220 frame).\nlet HEADER_FG: u64 = 0x94A3B8FFu64;\nlet CELL_FG: u64 = 0xE2E8F0FFu64;\nlet STRIPE: u64 = 0x1E293BFFu64;\n\nentry fn start() {\n    let rows = rs_list_new();\n    let mut i = 0;\n    while (i < 6) {\n        rs_list_push(rows, f\"p{i}\");\n        i = i + 1;\n    }\n    let rows_atom = rs_source_value(rows);\n\n    // Per-column geometry: fixed 150 / flex 1 / flex 2 (min 120) — the\n    // widths resolve against the table width once, and the header + every\n    // row lay their cells on the same boundaries.\n    let cols = TableCols().fixed(150.0).flex(1.0, 0.0).flex(2.0, 120.0);\n\n    let table = Table()\n        .columns(cols)\n        .rows_atom(rows_atom)\n        .header_builder(header_cell)\n        .row_builder(planet_cell)\n        .query_key(\"table-basic\")\n        .build();\n\n    mount(Expanded().flex(1.0).child(Container().color(0x0B1220FFu64).child(table).build()).build());\n}\n\n// The i'th '|'-separated slot of a data string.\nfn slot(data: str, i: u64) -> str {\n    let n = data.len();\n    let mut start = 0;\n    let mut k = 0;\n    let mut cur: u64 = 0;\n    while (k <= n) {\n        if (k == n || data.code_at(k) == 124) {\n            if (cur == i) {\n                return data.slice(start, k);\n            }\n            cur = cur + 1;\n            start = k + 1;\n        }\n        k = k + 1;\n    }\n    return \"\";\n}\n\n// One header cell (called once per column): a padded muted label.\nfn header_cell(col: u64) -> opaque {\n    let mut label = \"PLANET\";\n    if (col == 1) {\n        label = \"NOTES\";\n    } else if (col == 2) {\n        label = \"DISTANCE\";\n    }\n    return Container()\n        .padding(8.0)\n        .child(Text().text(label).font_size(12.0).color(HEADER_FG).build())\n        .build();\n}\n\n// One body cell (called per (row, col)): the striped padded field. Odd\n// rows tint their cell — the case-side stripe.\nfn planet_cell(row: u64, col: u64) -> opaque {\n    let mut text = \"\";\n    if (col == 0) {\n        text = slot(P_NAME, row);\n    } else if (col == 1) {\n        text = slot(P_NOTES, row);\n    } else {\n        text = slot(P_DIST, row);\n    }\n    let label = Text().text(text).font_size(14.0).color(CELL_FG).build();\n    if (row % 2 == 1) {\n        return Container().padding(8.0).color(STRIPE).child(label).build();\n    }\n    return Container().padding(8.0).child(label).build();\n}\n";
    }
    if (name == "table-reactive") {
        return "// table-reactive: the table twin with a reactive row set — a button adds\n// a planet through an Each over the rows atom.\nuse tur::{ CROSS_ALIGN_STRETCH, mount, rs_get_value, rs_list_new, rs_list_push, rs_set_value, rs_source_value,\n    rs_value_item, rs_value_len };\nuse tur_kit::{ Column, Container, Each, PointerInteract, Row, SizedBox, Text };\n\n\nfn row(i: u64, name: str) -> opaque {\n    let mut r = Row().query_key(f\"table/row{i as u64}\");\n    let c = Container().width_height(150.0, 0.0).padding(8.0).child(Text().text(name).font_size(14.0).build());\n    r.child(c.build());\n    return r.build();\n}\n\nentry fn start() -> u64 {\n    let rows = rs_list_new();\n    rs_list_push(rows, \"Mercury\");\n    rs_list_push(rows, \"Venus\");\n    let rows_atom = rs_source_value(rows);\n\n    // The head is a BAND (width_height(0, h) = fixed height, width unset\n    // per the box_size idiom): Stretch spans it over the table so the\n    // header sits flush-left above its rows instead of shrink-wrapping to\n    // the label and floating cross-centered.\n    let mut col = Column().cross_alignment(CROSS_ALIGN_STRETCH).query_key(\"table/col\");\n    let head = Container()\n        .width_height(0.0, 32.0)\n        .color(0x1E293BFF)\n        .query_key(\"table/head\")\n        .child(Text().text(\"PLANET\").font_size(12.0).build());\n    col.child(head.build());\n    col.child(Each(rows_atom).item_builder(row).build());\n    col.child(PointerInteract().ids(rows_atom, rows_atom).on_tap(b_add).child(Text().text(\"add row\").build()).build());\n    let frame = Container().color(0x0B1220FF).child(col.build());\n    mount(SizedBox(400.0, 240.0).child(frame.build()).build());\n    return rows_atom;\n}\n\nfn b_add(rows: u64, _b: u64, _n: f64) {\n    // Read-modify-write: rebuild the list with one more row.\n    let cur = rs_get_value(rows);\n    let n = rs_value_len(cur);\n    let fresh = rs_list_new();\n    let mut i = 0;\n    while (i < n as i32) {\n        rs_list_push(fresh, rs_value_item(cur, i as u64));\n        i += 1;\n    }\n    rs_list_push(fresh, f\"Planet {n as u64}\");\n    rs_set_value(rows, fresh);\n}\n";
    }
    if (name == "text-demo") {
        return "// text-demo: the Text styling showcase — font sizes, weights, colors, a\n// rich-text span run (per-run size / weight / italic / underline / color),\n// and the interactive maxLines + overflow trio (\"clip\" / \"ellipsis\" /\n// \"visible\"). Single-file port of the boa TSX original (generated.ts,\n// \"text-demo\") to the kit.\n//\n// Reactivity: the overflow section's caption and button label are derives\n// over the maxLines source (`rs_derive`, numeric). The prop itself is\n// static per build, so the three cards ride a `Switch` on the mirrored\n// mode string (\"1\" / \"2\" / \"3\") — a maxLines change swaps in a freshly\n// authored card row (the same structural-swap trick the boa explorer used\n// for its download button).\nuse tur::{ BORDER_INSIDE, CURSOR_POINTER, CROSS_ALIGN_END, CROSS_ALIGN_START, CROSS_ALIGN_STRETCH, MAIN_SIZE_MIN, SPAN_ITALIC, SPAN_UNDERLINE, mount, rs_get_f64, rs_set_f64, rs_set_str, rs_source_f64, rs_source_str, stf_put, stf_take };\nuse tur_kit::{\n    Column, Condition, Container, MouseRegion, PointerInteract, Row, rs_derive, ScrollView,\n    SizedBox, Spans, Switch, Text,\n};\n\n\nlet K_MODE: u64 = 1;\n\n// The boa palette (slate text on a soft page, indigo accent).\nlet PAGE_BG: u64 = 0xF8FAFCFFu64;\nlet CARD_BG: u64 = 0xFFFFFFFFu64;\nlet CARD_BORDER: u64 = 0xE2E8F0FFu64;\nlet TEXT: u64 = 0x0F172AFFu64;\nlet TEXT_MUTED: u64 = 0x64748BFFu64;\nlet ACCENT: u64 = 0x4F46E5FFu64;\nlet ACCENT_FG: u64 = 0xFFFFFFFFu64;\nlet ROSE: u64 = 0xE11D48FFu64;\nlet EMERALD: u64 = 0x059669FFu64;\nlet AMBER: u64 = 0xD97706FFu64;\n\nlet BROWN: str = \"The quick brown fox jumps over the lazy dog.\";\n\nentry fn start() -> u64 {\n    let maxlines = rs_source_f64();\n    rs_set_f64(maxlines, 2.0);\n    let mode = rs_source_str(\"2\");\n    stf_put(K_MODE, mode as f64);\n    let caption = rs_derive(fmt_caption, maxlines);\n    let btn_label = rs_derive(fmt_btn, maxlines);\n\n    let mut page = Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(SizedBox(0.0, 16.0).build())\n        .child(Text().text(\"Text\").font_size(22.0).color(TEXT).build())\n        .child(SizedBox(0.0, 4.0).build())\n        .child(Text().text(\"size · weight · color · spans · overflow\").font_size(12.0).color(TEXT_MUTED).build())\n        .child(SizedBox(0.0, 16.0).build())\n        .child(section(\"FONT SIZE\", size_row()))\n        .child(SizedBox(0.0, 12.0).build())\n        .child(section(\"FONT WEIGHT\", weight_col()))\n        .child(SizedBox(0.0, 12.0).build())\n        .child(section(\"COLOR\", color_row()))\n        .child(SizedBox(0.0, 12.0).build())\n        .child(section(\"RICH TEXT (SPANS)\", [spans_line()]))\n        .child(SizedBox(0.0, 12.0).build())\n        .child(section(\"OVERFLOW\", [\n            Text().text_bound_derived(caption).font_size(11.0).color(TEXT_MUTED).query_key(\"overflow-caption\").build(),\n            SizedBox(0.0, 8.0).build(),\n            overflow_cards(mode),\n            SizedBox(0.0, 10.0).build(),\n            cycle_button(maxlines, btn_label),\n        ]))\n        .child(SizedBox(0.0, 16.0).build());\n\n    let scroller = ScrollView().child(page.build()).build();\n    let root = Container().color(PAGE_BG).child(scroller).build();\n    mount(root);\n    return maxlines;\n}\n\n// A titled, content-sized card (the boa `Section`).\nfn section(title: str, kids: [opaque]) -> opaque {\n    return Container()\n        .padding(14.0)\n        .radius(10.0)\n        .color(CARD_BG)\n        .border(CARD_BORDER, 1.0, BORDER_INSIDE)\n        .child(\n            Column()\n                .cross_alignment(CROSS_ALIGN_START)\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(Text().text(title).font_size(11.0).color(TEXT_MUTED).build())\n                .child(SizedBox(0.0, 10.0).build())\n                .children(kids)\n                .build(),\n        )\n        .build();\n}\n\n// The size ladder: Aa at 10 / 14 / 20 / 28, baseline-aligned.\nfn size_row() -> [opaque] {\n    return [\n        Row()\n            .cross_alignment(CROSS_ALIGN_END)\n            .main_axis_size(MAIN_SIZE_MIN)\n            .child(Text().text(\"Aa\").font_size(10.0).color(TEXT).build())\n            .child(SizedBox(12.0, 0.0).build())\n            .child(Text().text(\"Aa\").font_size(14.0).color(TEXT).build())\n            .child(SizedBox(12.0, 0.0).build())\n            .child(Text().text(\"Aa\").font_size(20.0).color(TEXT).build())\n            .child(SizedBox(12.0, 0.0).build())\n            .child(Text().text(\"Aa\").font_size(28.0).color(TEXT).build())\n            .build(),\n    ];\n}\n\n// The weight ladder: the fox sentence at 300 / 400 / 700 / 900.\nfn weight_col() -> [opaque] {\n    return [\n        Text().text(BROWN).font_size(14.0).font_weight(300.0).color(TEXT).build(),\n        SizedBox(0.0, 4.0).build(),\n        Text().text(BROWN).font_size(14.0).font_weight(400.0).color(TEXT).build(),\n        SizedBox(0.0, 4.0).build(),\n        Text().text(BROWN).font_size(14.0).font_weight(700.0).color(TEXT).build(),\n        SizedBox(0.0, 4.0).build(),\n        Text().text(BROWN).font_size(14.0).font_weight(900.0).color(TEXT).build(),\n    ];\n}\n\n// The named colors in one row.\nfn color_row() -> [opaque] {\n    return [\n        Row()\n            .main_axis_size(MAIN_SIZE_MIN)\n            .child(Text().text(\"slate\").font_size(14.0).color(TEXT).build())\n            .child(SizedBox(12.0, 0.0).build())\n            .child(Text().text(\"rose\").font_size(14.0).color(ROSE).build())\n            .child(SizedBox(12.0, 0.0).build())\n            .child(Text().text(\"emerald\").font_size(14.0).color(EMERALD).build())\n            .child(SizedBox(12.0, 0.0).build())\n            .child(Text().text(\"amber\").font_size(14.0).color(AMBER).build())\n            .build(),\n    ];\n}\n\n// The span run: per-run size / weight / italic / underline / color\n// (0 = inherit, the span_add law).\nfn spans_line() -> opaque {\n    let run = Spans()\n        .add(\"The \", 0.0, TEXT, 0.0, 0)\n        .add(\"quick \", 0.0, TEXT, 0.0, SPAN_ITALIC)\n        .add(\"brown \", 0.0, AMBER, 700.0, 0)\n        .add(\"fox \", 0.0, TEXT, 0.0, SPAN_UNDERLINE)\n        .add(\"jumps \", 18.0, TEXT, 0.0, 0)\n        .add(\"over the \", 0.0, TEXT_MUTED, 0.0, 0)\n        .add(\"lazy\", 0.0, EMERALD, 700.0, 0)\n        .add(\" dog.\", 0.0, TEXT_MUTED, 0.0, 0);\n    return Text().font_size(14.0).spans(run).build();\n}\n\n// One truncation card: the fox sentence clipped to `max_lines` lines at a\n// 100px width under the given overflow mode.\nfn overflow_card(kind: str, max_lines: u64) -> opaque {\n    return Container()\n        .width(100.0)\n        .padding(8.0)\n        .radius(8.0)\n        .color(CARD_BG)\n        .border(CARD_BORDER, 1.0, BORDER_INSIDE)\n        .child(\n            Column()\n                .cross_alignment(CROSS_ALIGN_START)\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(Text().text(kind).font_size(11.0).color(TEXT_MUTED).build())\n                .child(SizedBox(0.0, 6.0).build())\n                .child(overflow_text(kind, max_lines))\n                .build(),\n        )\n        .build();\n}\n\n// The styled sentence under one overflow mode (branches keep the chain —\n// no statement-mutated builders).\nfn overflow_text(kind: str, max_lines: u64) -> opaque {\n    if (kind == \"clip\") {\n        return Text().text(BROWN).font_size(12.0).color(TEXT).max_lines(max_lines).clip().build();\n    }\n    if (kind == \"ellipsis\") {\n        return Text().text(BROWN).font_size(12.0).color(TEXT).max_lines(max_lines).ellipsis().build();\n    }\n    return Text().text(BROWN).font_size(12.0).color(TEXT).max_lines(max_lines).overflow_visible().build();\n}\n\n// The three truncation cards, keyed by the mirrored mode string — a\n// maxLines change structurally swaps the row (the prop is static per\n// build).\nfn overflow_cards(mode: u64) -> opaque {\n    return Switch()\n        .value_source(mode)\n        .query_key(\"overflow-cards\")\n        .cases(\"1\", cards_row(1))\n        .cases(\"2\", cards_row(2))\n        .cases(\"3\", cards_row(3))\n        .build();\n}\n\nfn cards_row(max_lines: u64) -> opaque {\n    return Row()\n        .cross_alignment(CROSS_ALIGN_START)\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(overflow_card(\"clip\", max_lines))\n        .child(SizedBox(8.0, 0.0).build())\n        .child(overflow_card(\"ellipsis\", max_lines))\n        .child(SizedBox(8.0, 0.0).build())\n        .child(overflow_card(\"visible\", max_lines))\n        .build();\n}\n\n// The indigo pill button that cycles maxLines (2 → 1 → 3 → 2).\nfn cycle_button(maxlines: u64, btn_label: u64) -> opaque {\n    let pill = Container()\n        .padding(10.0)\n        .radius(8.0)\n        .color(ACCENT)\n        .child(\n            Row()\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(Text().text_bound_derived(btn_label).font_size(13.0).color(ACCENT_FG).build())\n                .build(),\n        )\n        .build();\n    return MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(\n            PointerInteract()\n                .ids(maxlines, maxlines)\n                .on_tap(ts_cycle)\n                .query_key(\"overflow-btn\")\n                .child(pill)\n                .build(),\n        )\n        .build();\n}\n\n// The caption over the cards: \"maxLines = 2  ·  width = 100px\".\nfn fmt_caption(v: f64) -> str {\n    return f\"maxLines = {v as u64}  ·  width = 100px\";\n}\n\n// The button label: \"cycle maxLines (now 2)\".\nfn fmt_btn(v: f64) -> str {\n    return f\"cycle maxLines (now {v as u64})\";\n}\n\n// The tap: cycle 2 → 1 → 3 → 2 and mirror onto the cards' mode string.\nfn ts_cycle(maxlines: u64, _b: u64, _n: f64) {\n    let mode = stf_take(K_MODE) as u64;\n    let cur = rs_get_f64(maxlines);\n    let mut next: f64 = 2.0;\n    if (cur == 2.0) {\n        next = 1.0;\n    } else if (cur == 1.0) {\n        next = 3.0;\n    }\n    rs_set_f64(maxlines, next);\n    rs_set_str(mode, f\"{next as u64}\");\n    stf_put(K_MODE, mode as f64);\n}\n";
    }
    if (name == "todolist") {
        return "// todolist: the boa \"Tasks\" board — a 26px header with the derived\n// \"N items · M done\" counter, an indigo New Task pill, and task cards\n// (colored checkbox + title/subtitle + X button) in a scrollable list.\n// Tapping a card's checkbox toggles its done state; the X opens the\n// remove-confirm modal (a then_build branch that reads the targeted task\n// at open time); New Task opens the add modal (fresh, blank controllers\n// minted at activation).\n//\n// Tasks ride one list atom, each item encoded \"title|desc|done\". Both\n// modals overlay via Condition branches in the root Stack — and unlike\n// the boa reference, NEITHER boots open (the boot-modal bug is not\n// ported).\nuse tur::{ ALIGN_CENTER, AXIS_VERTICAL, BORDER_INSIDE, CROSS_ALIGN_CENTER, CROSS_ALIGN_START,\n    CROSS_ALIGN_STRETCH, CURSOR_POINTER, HIT_TEST_OPAQUE, MAIN_ALIGN_END,\n    MAIN_ALIGN_SPACE_BETWEEN, MAIN_SIZE_MIN, STACK_FIT_EXPAND, img_res_svg, mount, rs_get_value,\n    rs_list_new, rs_list_push, rs_set_bool, rs_set_f64, rs_set_value, rs_source_bool,\n    rs_source_f64, rs_source_value, rs_value_item, rs_value_len, st_put, st_take, stf_put,\n    stf_take, tctrl_new, tctrl_text, undo_new };\nuse tur_kit::{ Column, Condition, Container, Each, Expanded, Image, Input, MouseRegion,\n    PointerInteract, Positioned, Row, ScrollView, SizedBox, Stack, Text, rs_derive2 };\n\n\nlet K_TASKS: u64 = 1;\nlet K_N: u64 = 2;\nlet K_DONE: u64 = 3;\nlet K_ADDOPEN: u64 = 4;\nlet K_RMOPEN: u64 = 5;\nlet K_RMTGT: u64 = 6;\nlet K_TITLE: u64 = 7; // the add modal's title controller\nlet K_DESC: u64 = 8; // the add modal's description controller\n\nlet K_ICO_CHECK: u64 = 10;\nlet K_ICO_CLOSE: u64 = 11;\nlet K_ICO_PLUS: u64 = 12;\n\n// The boa light palette (Notion / Linear-style).\nlet CARD_BG: u64 = 0xFFFFFFFFu64;\nlet CARD_BORDER: u64 = 0xE2E8F0FFu64;\nlet PAGE_BG: u64 = 0xF8FAFCFFu64;\nlet TEXT: u64 = 0x0F172AFFu64;\nlet TEXT_MUTED: u64 = 0x64748BFFu64;\nlet TEXT_STRIKE: u64 = 0x94A3B8FFu64;\nlet ACCENT: u64 = 0x4F46E5FFu64;\nlet ACCENT_FG: u64 = 0xFFFFFFFFu64;\nlet SUCCESS: u64 = 0x22C55EFFu64;\nlet INPUT_BG: u64 = 0xF8FAFCFFu64;\nlet INPUT_BORDER: u64 = 0xCBD5E1FFu64;\nlet BACKDROP: u64 = 0x0F172A6Eu64;\nlet SUBTLE: u64 = 0xF1F5F9FFu64;\nlet SUBTLE_FG: u64 = 0x334155FFu64;\nlet DANGER: u64 = 0xEF4444FFu64;\n\n// The inline icon SVGs (the boa state.ts icons, single-quoted attrs).\nlet SVG_CHECK: str = \"<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#ffffff' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>\";\nlet SVG_CLOSE: str = \"<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#64748b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/></svg>\";\nlet SVG_PLUS: str = \"<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#ffffff' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><line x1='12' y1='5' x2='12' y2='19'/><line x1='5' y1='12' x2='19' y2='12'/></svg>\";\n\nentry fn start() -> u64 {\n    let tasks = rs_source_value(seed_tasks());\n    stf_put(K_TASKS, tasks as f64);\n    let n = rs_source_f64();\n    let done = rs_source_f64();\n    stf_put(K_N, n as f64);\n    stf_put(K_DONE, done as f64);\n    let add_open = rs_source_bool(false);\n    let rm_open = rs_source_bool(false);\n    stf_put(K_ADDOPEN, add_open as f64);\n    stf_put(K_RMOPEN, rm_open as f64);\n    stf_put(K_RMTGT, 0.0);\n\n    sync_counts();\n\n    // The icon resources (inline SVG through the image rail).\n    stf_put(K_ICO_CHECK, img_res_svg(SVG_CHECK) as f64);\n    stf_put(K_ICO_CLOSE, img_res_svg(SVG_CLOSE) as f64);\n    stf_put(K_ICO_PLUS, img_res_svg(SVG_PLUS) as f64);\n\n    let count = rs_derive2(fmt_tasks, n, done);\n\n    let header = Row()\n        .main_alignment(MAIN_ALIGN_SPACE_BETWEEN)\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(\n            Column()\n                .cross_alignment(CROSS_ALIGN_START)\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(Text().text(\"Tasks\").font_size(26.0).color(TEXT).build())\n                .child(SizedBox(0.0, 4.0).build())\n                .child(Text().text_bound_derived(count).font_size(13.0).color(TEXT_MUTED).query_key(\"todo-count\").build())\n                .build(),\n        )\n        .child(add_button())\n        .build();\n\n    let scroller = ScrollView()\n        .axis(AXIS_VERTICAL)\n        .child(\n            Column()\n                .cross_alignment(CROSS_ALIGN_STRETCH)\n                .child(Each(tasks).item_builder(task_row).build())\n                .build(),\n        )\n        .build();\n\n    let page = Container()\n        .color(PAGE_BG)\n        .padding(22.0)\n        .child(\n            Column()\n                .cross_alignment(CROSS_ALIGN_STRETCH)\n                .child(header)\n                .child(SizedBox(0.0, 18.0).build())\n                .child(Expanded().flex(1.0).child(scroller).build())\n                .build(),\n        )\n        .build();\n\n    // The modals overlay the page; neither boots open (the closed branch\n    // is a zero box — cond_build requires both branches).\n    mount(\n        Stack()\n            .fit(STACK_FIT_EXPAND)\n            .child(page)\n            .child(\n                Condition(add_open)\n                    .then_build(fn () -> View { return Positioned().left(0.0).top(0.0).right(0.0).bottom(0.0).child(add_modal()).build(); })\n                    .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })\n                    .build(),\n            )\n            .child(\n                Condition(rm_open)\n                    .then_build(fn () -> View { return Positioned().left(0.0).top(0.0).right(0.0).bottom(0.0).child(remove_modal()).build(); })\n                    .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })\n                    .build(),\n            )\n            .build(),\n    );\n    return tasks;\n}\n\n// ---- the seed data -------------------------------------------------------------\n\n// The boa state.ts seed list.\nfn seed_tasks() -> opaque {\n    let items = rs_list_new();\n    rs_list_push(items, \"Buy groceries|Milk, eggs, sourdough, coffee beans|0\");\n    rs_list_push(items, \"Walk the dog|30 minutes around the park|1\");\n    rs_list_push(items, \"Finish quarterly report|Q2 numbers + projection slides for Monday's review|0\");\n    rs_list_push(items, \"Call mom|Birthday planning for Saturday|0\");\n    rs_list_push(items, \"Read chapter 4|Designing Data-Intensive Applications|0\");\n    return items;\n}\n\n// ---- the item parsing (the \"title|desc|done\" encoding) --------------------------\n\nfn idx_of(s: str, from: i32, c: u32) -> i32 {\n    let n = s.len();\n    let mut k = from;\n    while (k < n) {\n        if (s.code_at(k) == c) {\n            return k;\n        }\n        k = k + 1;\n    }\n    return -1;\n}\n\nfn item_title(s: str) -> str {\n    let p = idx_of(s, 0, 124);\n    if (p < 0) {\n        return s;\n    }\n    return s.slice(0, p);\n}\n\nfn item_desc(s: str) -> str {\n    let a = idx_of(s, 0, 124);\n    if (a < 0) {\n        return \"\";\n    }\n    let b = idx_of(s, a + 1, 124);\n    if (b < 0) {\n        return \"\";\n    }\n    return s.slice(a + 1, b);\n}\n\nfn item_done(s: str) -> bool {\n    let n = s.len();\n    if (n == 0) {\n        return false;\n    }\n    return s.code_at(n - 1) == 49;\n}\n\n// ---- the header pieces -----------------------------------------------------------\n\n// The indigo New Task pill (plus glyph + label).\nfn add_button() -> opaque {\n    let face = Container()\n        .padding(10.0)\n        .radius(8.0)\n        .color(ACCENT)\n        .shadow(0x4F46E550u64, 10.0, 0.0, 4.0)\n        .child(\n            Row()\n                .main_axis_size(MAIN_SIZE_MIN)\n                .cross_alignment(CROSS_ALIGN_CENTER)\n                .child(icon(K_ICO_PLUS, 13.0))\n                .child(SizedBox(7.0, 0.0).build())\n                .child(Text().text(\"New Task\").font_size(13.0).color(ACCENT_FG).build())\n                .build(),\n        )\n        .build();\n    return MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(\n            PointerInteract()\n                .on_tap(b_open_add)\n                .query_key(\"todo-add-open\")\n                .child(face)\n                .build(),\n        )\n        .build();\n}\n\n// A stashed SVG icon at a display size.\nfn icon(slot: u64, size: f64) -> opaque {\n    let res = stf_take(slot) as u64;\n    stf_put(slot, res as f64);\n    return Image(res).width(size).height(size).build();\n}\n\n// ---- the task card ---------------------------------------------------------------\n\nfn task_row(i: u64, s: str) -> opaque {\n    let title = item_title(s);\n    let desc = item_desc(s);\n    let done = item_done(s);\n    let card = Container()\n        .radius(10.0)\n        .padding(14.0)\n        .color(CARD_BG)\n        .border(CARD_BORDER, 1.0, BORDER_INSIDE)\n        .shadow(0x0F172A14u64, 6.0, 0.0, 1.0)\n        .child(\n            Row()\n                .cross_alignment(CROSS_ALIGN_START)\n                .child(checkbox(i, done))\n                .child(SizedBox(12.0, 0.0).build())\n                .child(Expanded().flex(1.0).child(title_block(title, desc, done)).build())\n                .child(SizedBox(8.0, 0.0).build())\n                .child(delete_button(i))\n                .build(),\n        )\n        .build();\n    return Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(row_spacer(i))\n        .child(card)\n        .build();\n}\n\n// The 10px gutter between cards (none above the first).\nfn row_spacer(i: u64) -> opaque {\n    if (i > 0) {\n        return SizedBox(0.0, 10.0).build();\n    }\n    return SizedBox(0.0, 0.0).build();\n}\n\n// The done toggle: a 20px rounded box — green with a check when done, a\n// bordered empty square otherwise.\nfn checkbox(i: u64, done: bool) -> opaque {\n    return MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(\n            PointerInteract()\n                .ids(i, i)\n                .on_tap(it_tap)\n                .query_key(\"todo-check\")\n                .child(checkbox_face(done))\n                .build(),\n        )\n        .build();\n}\n\nfn checkbox_face(done: bool) -> opaque {\n    if (done) {\n        return Container()\n            .width_height(20.0, 20.0)\n            .radius(6.0)\n            .color(SUCCESS)\n            .alignment(ALIGN_CENTER)\n            .child(icon(K_ICO_CHECK, 13.0))\n            .build();\n    }\n    return Container()\n        .width_height(20.0, 20.0)\n        .radius(6.0)\n        .color(CARD_BG)\n        .border(INPUT_BORDER, 1.5, BORDER_INSIDE)\n        .build();\n}\n\n// The title + optional subtitle; done tasks mute the title.\nfn title_block(title: str, desc: str, done: bool) -> opaque {\n    let mut fg = TEXT;\n    if (done) {\n        fg = TEXT_STRIKE;\n    }\n    let t = Text().text(title).font_size(14.0).color(fg).build();\n    if (desc == \"\") {\n        return Column()\n            .cross_alignment(CROSS_ALIGN_START)\n            .main_axis_size(MAIN_SIZE_MIN)\n            .child(t)\n            .build();\n    }\n    return Column()\n        .cross_alignment(CROSS_ALIGN_START)\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(t)\n        .child(SizedBox(0.0, 3.0).build())\n        .child(Text().text(desc).font_size(12.0).color(TEXT_MUTED).build())\n        .build();\n}\n\n// The X button (opens the remove-confirm modal for this row).\nfn delete_button(i: u64) -> opaque {\n    let face = Container()\n        .width_height(26.0, 26.0)\n        .radius(6.0)\n        .color(SUBTLE)\n        .alignment(ALIGN_CENTER)\n        .child(icon(K_ICO_CLOSE, 13.0))\n        .build();\n    return MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(\n            PointerInteract()\n                .ids(i, i)\n                .on_tap(b_rm)\n                .query_key(\"todo-delete\")\n                .child(face)\n                .build(),\n        )\n        .build();\n}\n\n// ---- the modals -------------------------------------------------------------------\n\n// The modal shell: a scrim (tap = dismiss) around a card that swallows\n// its own taps.\nfn modal_shell(scrim_tap: fn(u64, u64, f64), card: opaque) -> opaque {\n    let inner = PointerInteract()\n        .behavior(HIT_TEST_OPAQUE)\n        .on_tap(b_swallow)\n        .child(card)\n        .build();\n    let scrim = Container().color(BACKDROP).alignment(ALIGN_CENTER).child(inner).build();\n    return PointerInteract()\n        .behavior(HIT_TEST_OPAQUE)\n        .on_tap(scrim_tap)\n        .child(scrim)\n        .build();\n}\n\n// A standard modal button (the boa Button).\nfn modal_button(key: str, label: str, bg: u64, fg: u64, cb: fn(u64, u64, f64)) -> opaque {\n    let face = Container()\n        .padding(9.0)\n        .radius(7.0)\n        .color(bg)\n        .child(Text().text(label).font_size(13.0).color(fg).build())\n        .build();\n    return MouseRegion()\n        .cursor(CURSOR_POINTER)\n        .child(\n            PointerInteract()\n                .on_tap(cb)\n                .query_key(key)\n                .child(face)\n                .build(),\n        )\n        .build();\n}\n\n// A labelled field (the boa Field): the caption over the bordered input.\nfn field(caption: str, placeholder: str, ctrl: opaque, undo: opaque, key: str) -> opaque {\n    return Column()\n        .cross_alignment(CROSS_ALIGN_STRETCH)\n        .main_axis_size(MAIN_SIZE_MIN)\n        .child(Text().text(caption).font_size(11.0).color(TEXT_MUTED).build())\n        .child(SizedBox(0.0, 6.0).build())\n        .child(\n            Container()\n                .radius(7.0)\n                .padding(9.0)\n                .color(INPUT_BG)\n                .border(INPUT_BORDER, 1.0, BORDER_INSIDE)\n                .child(\n                    Input()\n                        .controller(ctrl)\n                        .undo(undo)\n                        .placeholder(placeholder)\n                        .font_size(14.0)\n                        .color(TEXT)\n                        .placeholder_color(TEXT_MUTED)\n                        .cursor_color(ACCENT)\n                        .query_key(key)\n                        .width_height(0.0, 22.0)\n                        .build(),\n                )\n                .build(),\n        )\n        .build();\n}\n\n// The add modal — built at ACTIVATION, so its controllers mint fresh and\n// blank every open.\nfn add_modal() -> opaque {\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n    st_put(K_TITLE, ctrl);\n    let dctrl = tctrl_new();\n    let undo2 = undo_new();\n    st_put(K_DESC, dctrl);\n\n    let card = Container()\n        .width(380.0)\n        .radius(14.0)\n        .padding(22.0)\n        .color(CARD_BG)\n        .shadow(0x0F172A1Eu64, 30.0, 0.0, 12.0)\n        .child(\n            Column()\n                .cross_alignment(CROSS_ALIGN_STRETCH)\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(Text().text(\"New Task\").font_size(17.0).color(TEXT).build())\n                .child(SizedBox(0.0, 16.0).build())\n                .child(field(\"Title\", \"What needs doing?\", ctrl, undo, \"todo-add-title\"))\n                .child(SizedBox(0.0, 14.0).build())\n                .child(field(\"Description\", \"Optional details\", dctrl, undo2, \"todo-add-desc\"))\n                .child(SizedBox(0.0, 20.0).build())\n                .child(\n                    Row()\n                        .main_alignment(MAIN_ALIGN_END)\n                        .main_axis_size(MAIN_SIZE_MIN)\n                        .child(modal_button(\"todo-add-cancel\", \"Cancel\", SUBTLE, SUBTLE_FG, b_add_cancel))\n                        .child(SizedBox(8.0, 0.0).build())\n                        .child(modal_button(\"todo-add-submit\", \"Add Task\", ACCENT, ACCENT_FG, b_add_submit))\n                        .build(),\n                )\n                .build(),\n        )\n        .build();\n    return modal_shell(b_add_cancel, card);\n}\n\n// The remove-confirm modal — built at ACTIVATION for the targeted task\n// (the branch reads the live target).\nfn remove_modal() -> opaque {\n    let target = stf_take(K_RMTGT);\n    stf_put(K_RMTGT, target);\n    let tasks = stf_take(K_TASKS);\n    stf_put(K_TASKS, tasks);\n    let item = rs_value_item(rs_get_value(tasks as u64), target as u64);\n    let title = item_title(item);\n    // Bound-quote locals: f-string braces take no escape sequences.\n    let q: str = \"\\\"\";\n    let said = f\"{q}{title}{q} will be permanently removed.\";\n\n    let card = Container()\n        .width(340.0)\n        .radius(14.0)\n        .padding(22.0)\n        .color(CARD_BG)\n        .shadow(0x0F172A1Eu64, 30.0, 0.0, 12.0)\n        .child(\n            Column()\n                .cross_alignment(CROSS_ALIGN_STRETCH)\n                .main_axis_size(MAIN_SIZE_MIN)\n                .child(Text().text(\"Remove task?\").font_size(16.0).color(TEXT).build())\n                .child(SizedBox(0.0, 8.0).build())\n                .child(Text().text(said).font_size(13.0).color(TEXT_MUTED).query_key(\"todo-rm-msg\").build())\n                .child(SizedBox(0.0, 18.0).build())\n                .child(\n                    Row()\n                        .main_alignment(MAIN_ALIGN_END)\n                        .main_axis_size(MAIN_SIZE_MIN)\n                        .child(modal_button(\"todo-rm-cancel\", \"Cancel\", SUBTLE, SUBTLE_FG, b_rm_cancel))\n                        .child(SizedBox(8.0, 0.0).build())\n                        .child(modal_button(\"todo-rm-confirm\", \"Remove\", DANGER, ACCENT_FG, b_rm_confirm))\n                        .build(),\n                )\n                .build(),\n        )\n        .build();\n    return modal_shell(b_rm_cancel, card);\n}\n\n// ---- the actions -------------------------------------------------------------------\n\n// Checkbox tap: flip the row's done flag (rewrite the list atom — the\n// Each rebuilds; the derive recount follows).\nfn it_tap(idx: u64, _b: u64, _n: f64) {\n    let tasks = stf_take(K_TASKS);\n    stf_put(K_TASKS, tasks);\n    let old = rs_get_value(tasks as u64);\n    let count = rs_value_len(old);\n    let fresh = rs_list_new();\n    let mut k: u64 = 0;\n    while (k < count) {\n        let item = rs_value_item(old, k);\n        if (k == idx) {\n            let body = item.slice(0, item.len() - 1);\n            if (item_done(item)) {\n                rs_list_push(fresh, f\"{body}0\");\n            } else {\n                rs_list_push(fresh, f\"{body}1\");\n            }\n        } else {\n            rs_list_push(fresh, item);\n        }\n        k = k + 1;\n    }\n    rs_set_value(tasks as u64, fresh);\n    sync_counts();\n}\n\n// X tap: aim the remove modal at this row and open it.\nfn b_rm(idx: u64, _b: u64, _n: f64) {\n    stf_put(K_RMTGT, idx as f64);\n    let rm_open = stf_take(K_RMOPEN);\n    stf_put(K_RMOPEN, rm_open);\n    rs_set_bool(rm_open as u64, true);\n}\n\n// New Task: open the add modal (its branch mints blank controllers).\nfn b_open_add(_a: u64, _b: u64, _n: f64) {\n    let add_open = stf_take(K_ADDOPEN);\n    stf_put(K_ADDOPEN, add_open);\n    rs_set_bool(add_open as u64, true);\n}\n\nfn b_add_cancel(_a: u64, _b: u64, _n: f64) {\n    let add_open = stf_take(K_ADDOPEN);\n    stf_put(K_ADDOPEN, add_open);\n    rs_set_bool(add_open as u64, false);\n}\n\n// Add Task: the non-empty title appends a fresh open task.\nfn b_add_submit(_a: u64, _b: u64, _n: f64) {\n    let ctrl = st_take(K_TITLE);\n    let raw = tctrl_text(ctrl);\n    st_put(K_TITLE, ctrl);\n    let title = trim(raw);\n    if (title == \"\") {\n        return;\n    }\n    let dctrl = st_take(K_DESC);\n    let desc = trim(tctrl_text(dctrl));\n    st_put(K_DESC, dctrl);\n    let tasks = stf_take(K_TASKS);\n    stf_put(K_TASKS, tasks);\n    let old = rs_get_value(tasks as u64);\n    let fresh = rs_list_new();\n    let count = rs_value_len(old);\n    let mut k: u64 = 0;\n    while (k < count) {\n        rs_list_push(fresh, rs_value_item(old, k));\n        k = k + 1;\n    }\n    rs_list_push(fresh, f\"{title}|{desc}|0\");\n    rs_set_value(tasks as u64, fresh);\n    sync_counts();\n    b_add_cancel(0, 0, 0.0);\n}\n\nfn b_rm_cancel(_a: u64, _b: u64, _n: f64) {\n    let rm_open = stf_take(K_RMOPEN);\n    stf_put(K_RMOPEN, rm_open);\n    rs_set_bool(rm_open as u64, false);\n}\n\nfn b_rm_confirm(_a: u64, _b: u64, _n: f64) {\n    let target = stf_take(K_RMTGT);\n    stf_put(K_RMTGT, target);\n    let tasks = stf_take(K_TASKS);\n    stf_put(K_TASKS, tasks);\n    let old = rs_get_value(tasks as u64);\n    let count = rs_value_len(old);\n    let fresh = rs_list_new();\n    let mut k: u64 = 0;\n    while (k < count) {\n        if (k != target as u64) {\n            rs_list_push(fresh, rs_value_item(old, k));\n        }\n        k = k + 1;\n    }\n    rs_set_value(tasks as u64, fresh);\n    sync_counts();\n    b_rm_cancel(0, 0, 0.0);\n}\n\n// Clicks inside a modal card stop at the card.\nfn b_swallow(_a: u64, _b: u64, _n: f64) {\n}\n\n// ---- the counters -------------------------------------------------------------------\n\n// Recount items + dones off the live list (the header derive's deps).\nfn sync_counts() {\n    let tasks = stf_take(K_TASKS);\n    stf_put(K_TASKS, tasks);\n    let n = stf_take(K_N);\n    stf_put(K_N, n);\n    let done = stf_take(K_DONE);\n    stf_put(K_DONE, done);\n    let old = rs_get_value(tasks as u64);\n    let count = rs_value_len(old);\n    let mut dones: u64 = 0;\n    let mut k: u64 = 0;\n    while (k < count) {\n        if (item_done(rs_value_item(old, k))) {\n            dones = dones + 1;\n        }\n        k = k + 1;\n    }\n    rs_set_f64(n as u64, count as f64);\n    rs_set_f64(done as u64, dones as f64);\n}\n\n// \"N items · M done\".\nfn fmt_tasks(a: f64, b: f64) -> str {\n    return f\"{a as u64} items · {b as u64} done\";\n}\n\n// ASCII trim (the spaces around a draft).\nfn trim(s: str) -> str {\n    let n = s.len();\n    let mut a = 0;\n    while (a < n && s.code_at(a) == 32) {\n        a = a + 1;\n    }\n    let mut b = n;\n    while (b > a && s.code_at(b - 1) == 32) {\n        b = b - 1;\n    }\n    return s.slice(a, b);\n}\n";
    }
    return "";
}
