fn pg_case_source(name: str) -> str {
    if (name == "complex-animation") {
        return "// complex-animation: the showcase twin — a controller-driven animation\n// with explicit tween composition (opacity + translate on one target).\nuse tur::{ anim_ctrl, anim_forward, anim_repeat, mount, rs_source_f64 };\nuse tur_kit::{ Column, Container, Expanded, SizedBox, Text };\nuse tur_anim_kit::{ Opacity };\n\n\nentry fn start() -> u64 {\n    let t = rs_source_f64();\n    let ctrl = anim_ctrl(t, 2000.0, \"easeInOut\", 0, \"a_tick\", \"a_end\");\n    anim_repeat(ctrl, 1000);\n    anim_forward(ctrl);\n\n    let mut col = Column()\n        .child(SizedBox(400.0, 40.0).child(Text().text(\"complex-animation: repeat + tween\").build()).build());\n    let target = Container().width_height(60.0, 60.0).color(0x6366F1FFu64);\n    let opacity = Opacity(0.0).bound(t).child(target.build()).build();\n    col.child(Expanded().flex(1.0).child(opacity).build());\n    mount(col.build());\n    return t;\n}\n\nentry fn a_tick(_atom: u64, _t: f64) {\n}\n\nentry fn a_end(_atom: u64, _v: f64) {\n}\n";
    }
    if (name == "countdown") {
        return "// countdown: a 1 Hz countdown with start/pause/reset, an edit modal (a\n// pre-filled Input + confirm), and a ticking display derived from the\n// remaining atom. The ticker is an async loop over `sleep(1000)` with a\n// generation guard (a stale loop exits when a new start supersedes it).\n// State atom ids ride the scalar stash (stf_*).\nuse futures::{ launch_future, sleep };\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, MAIN_ALIGN_CENTER, mem_get, mem_new, mem_set, mount,\n    rs_derive, rs_get_bool, rs_get_f64, rs_set_bool, rs_set_f64, rs_source_bool, rs_source_f64,\n    st_put, st_take, stf_put, stf_take, str_parse_f64, tctrl_new, tctrl_set_text, tctrl_text,\n    undo_new };\nuse tur_kit::{ Column, Condition, Container, Input, PointerInteract, Row, Text };\n\n\nlet K_GEN: u64 = 1;\nlet K_CTRL: u64 = 2;\nlet K_REMAINING: u64 = 3;\nlet K_INITIAL: u64 = 4;\nlet K_RUNNING: u64 = 5;\nlet K_EDITING: u64 = 6;\n\nentry fn start() -> u64 {\n    let remaining = rs_source_f64();\n    rs_set_f64(remaining, 60.0);\n    let initial = rs_source_f64();\n    rs_set_f64(initial, 60.0);\n    let running = rs_source_bool(false);\n    let editing = rs_source_bool(false);\n    stf_put(K_REMAINING, remaining as f64);\n    stf_put(K_INITIAL, initial as f64);\n    stf_put(K_RUNNING, running as f64);\n    stf_put(K_EDITING, editing as f64);\n    st_put(K_GEN, mem_new(0.0));\n\n    let display = rs_derive(\"fmt_display\", remaining);\n\n    let mut col = Column()\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Text().text_bound_derived(display).query_key(\"display\").build())\n        .child(Row().main_alignment(MAIN_ALIGN_CENTER).child(button(\"btn-start\", \"Start\", \"b_start\", running, running)).child(button(\"btn-pause\", \"Pause\", \"b_pause\", running, running)).child(button(\"btn-reset\", \"Reset\", \"b_reset\", initial, remaining)).child(button(\"btn-edit\", \"Edit\", \"b_edit\", initial, editing)).build());\n\n    // The edit modal overlay (both branches authored at start).\n    let modal = build_modal(initial, remaining);\n    let empty = Container();\n    col.child(Condition(editing).then(modal).else_branch(empty.build()).build());\n\n    mount(col.build());\n    return remaining;\n}\n\n// A pill button with a query key; both atoms cross to the entry.\nfn button(key: str, label: str, cb: str, a: u64, b: u64) -> opaque {\n    let bld = Container()\n        .width_height(90.0, 40.0)\n        .color(0x6366F1FF)\n        .alignment(ALIGN_CENTER)\n        .radius(8.0)\n        .query_key(key)\n        .child(Text().text(label).build());\n    return PointerInteract().ids(a, b).on_tap(cb).child(bld.build()).build();\n}\n\n// The edit modal: a centered card with a pre-filled Input + confirm.\nfn build_modal(initial: u64, remaining: u64) -> opaque {\n    let ctrl = tctrl_new();\n    tctrl_set_text(ctrl, f\"{rs_get_f64(initial) as u64}\");\n    st_put(K_CTRL, ctrl);\n\n    let mut card = Container()\n        .width_height(240.0, 140.0)\n        .color(0xFFFFFFFFu64)\n        .radius(12.0)\n        .padding(16.0)\n        .alignment(ALIGN_CENTER);\n\n    let mut col = Column()\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Text().text(\"Set seconds\").build());\n    let undo = undo_new();\n    let input = Input().controller(ctrl).undo(undo).placeholder(\"seconds\").width_height(180.0, 32.0).query_key(\"edit-input\").build();\n    col.child(input);\n    col.child(button(\"btn-confirm\", \"Confirm\", \"b_confirm\", initial, remaining));\n    card.child(col.build());\n    return card.build();\n}\n\n// \"m:ss\" display format.\nentry fn fmt_display(v: f64) -> str {\n    let total = v as u64;\n    let m = total / 60;\n    let s = total % 60;\n    if (s < 10) {\n        return f\"{m}:0{s}\";\n    }\n    return f\"{m}:{s}\";\n}\n\n// The 1 Hz ticker. `g` pins the generation: a stale loop (superseded by a\n// later start / pause) exits without ticking.\nasync fn ticker(g: f64) -> str {\n    let running = stf_take(K_RUNNING) as u64;\n    while (rs_get_bool(running)) {\n        await sleep(1000);\n        if (gen_read() != g) {\n            stf_put(K_RUNNING, running as f64);\n            return \"\";\n        }\n        if (!rs_get_bool(running)) {\n            stf_put(K_RUNNING, running as f64);\n            return \"\";\n        }\n        let remaining = stf_take(K_REMAINING) as u64;\n        let r = rs_get_f64(remaining);\n        if (r <= 1.0) {\n            rs_set_f64(remaining, 0.0);\n            rs_set_bool(running, false);\n            stf_put(K_REMAINING, remaining as f64);\n            stf_put(K_RUNNING, running as f64);\n            return \"\";\n        }\n        rs_set_f64(remaining, r - 1.0);\n        stf_put(K_REMAINING, remaining as f64);\n    }\n    stf_put(K_RUNNING, running as f64);\n    return \"\";\n}\n\nfn gen_read() -> f64 {\n    let cell = st_take(K_GEN);\n    let v = mem_get(cell);\n    st_put(K_GEN, cell);\n    return v;\n}\n\nfn gen_bump() -> f64 {\n    let cell = st_take(K_GEN);\n    let g = mem_get(cell) + 1.0;\n    mem_set(cell, g);\n    st_put(K_GEN, cell);\n    return g;\n}\n\nentry fn b_start(_running: u64, _b: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    if (rs_get_bool(running)) {\n        stf_put(K_RUNNING, running as f64);\n        return;\n    }\n    rs_set_bool(running, true);\n    stf_put(K_RUNNING, running as f64);\n    launch_future(ticker(gen_bump()));\n}\n\nentry fn b_pause(_running: u64, _b: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n}\n\nentry fn b_reset(initial: u64, remaining: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n    rs_set_f64(remaining, rs_get_f64(initial));\n}\n\nentry fn b_edit(initial: u64, editing: u64, _n: f64) {\n    let running = stf_take(K_RUNNING) as u64;\n    rs_set_bool(running, false);\n    stf_put(K_RUNNING, running as f64);\n    gen_bump();\n    // (Re-)seed the modal controller with the current initial value.\n    let ctrl = st_take(K_CTRL);\n    tctrl_set_text(ctrl, f\"{rs_get_f64(initial) as u64}\");\n    st_put(K_CTRL, ctrl);\n    rs_set_bool(editing, true);\n}\n\nentry fn b_confirm(initial: u64, remaining: u64, _n: f64) {\n    let ctrl = st_take(K_CTRL);\n    let v = str_parse_f64(tctrl_text(ctrl));\n    rs_set_f64(initial, v);\n    rs_set_f64(remaining, v);\n    let editing = stf_take(K_EDITING) as u64;\n    rs_set_bool(editing, false);\n    stf_put(K_EDITING, editing as f64);\n}\n";
    }
    if (name == "counter") {
        return "// counter: a reactive count label between -/+ pill buttons — the full\n// interactive loop (button → intent entry → atom write → re-render).\nuse tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, mount, rs_get_f64, rs_set_f64, rs_set_str, rs_source_f64,\n    rs_source_str };\nuse tur_kit::{ Column, Container, PointerInteract, Row, Text };\n\n\nentry fn start() -> u64 {\n    let count = rs_source_f64();\n    let label = rs_source_str(\"Count: 0\");\n\n    let mut col = Column()\n        .cross_alignment(CROSS_ALIGN_CENTER)\n        .child(Text().text_bound(label).query_key(\"count\").font_size(36.0).build());\n\n    let mut row = Row().cross_alignment(CROSS_ALIGN_CENTER);\n    let pad = rs_source_f64();\n    row.child(button(count, label, \"ts_dec\", \"-1\", \"dec\"));\n    row.child(gap());\n    row.child(button(count, label, \"ts_inc\", \"+1\", \"inc\"));\n    col.child(row.build());\n\n    let bg = Container().color(0xF8FAFCFFu64).child(col.build());\n    mount(bg.build());\n    return count;\n}\n\n// A 100x44 indigo pill with a centered label.\nfn button(count: u64, label: u64, cb: str, text: str, key: str) -> opaque {\n    let b = Container()\n        .width_height(100.0, 44.0)\n        .color(0x6366F1FFu64)\n        .alignment(ALIGN_CENTER)\n        .query_key(key)\n        .child(Text().text(text).font_size(18.0).build());\n    return PointerInteract().ids(count, label).on_tap(cb).child(b.build()).build();\n}\n\nfn gap() -> opaque {\n    let b = Container().width_height(12.0, 0.0);\n    return b.build();\n}\n\nfn refresh(count: u64, label: u64) {\n    rs_set_str(label, f\"Count: {rs_get_f64(count) as u64}\");\n}\n\nentry fn ts_inc(count: u64, label: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) + 1.0);\n    refresh(count, label);\n}\n\nentry fn ts_dec(count: u64, label: u64, _n: f64) {\n    rs_set_f64(count, rs_get_f64(count) - 1.0);\n    refresh(count, label);\n}\n";
    }
    if (name == "grid-aspect") {
        return "// grid-aspect: aspect-ratio tiles in a grid row (square tiles via equal\n// width/height).\nuse tur::{ mount };\nuse tur_kit::{ Container, Row, SizedBox, Text };\n\n\nentry fn tile(label: str, color: u64) -> opaque {\n    let b = Container()\n        .width_height(100.0, 100.0)\n        .color(color)\n        .child(Text().text(label).font_size(14.0).build());\n    return b.build();\n}\n\nentry fn start() {\n    let row = Row()\n        .child(tile(\"A\", 0xEF4444FFu64))\n        .child(tile(\"B\", 0x22C55EFFu64))\n        .child(tile(\"C\", 0x3B82F6FFu64));\n    mount(SizedBox(400.0, 200.0).child(row.build()).build());\n}\n";
    }
    if (name == "grid-basic") {
        return "// grid-basic: a small static grid of tiles (Row/Column composition).\nuse tur::{ mount };\nuse tur_kit::{ Column, Container, Row, SizedBox };\n\n\nentry fn tile(color: u64) -> opaque {\n    let b = Container().width_height(80.0, 80.0).color(color);\n    return b.build();\n}\n\nentry fn start() {\n    let mut col = Column();\n    let r0 = Row().child(tile(0xEF4444FFu64)).child(tile(0x22C55EFFu64));\n    let r1 = Row().child(tile(0x3B82F6FFu64)).child(tile(0xEAB308FFu64));\n    col.child(r0.build());\n    col.child(r1.build());\n    mount(SizedBox(200.0, 200.0).child(col.build()).build());\n}\n";
    }
    if (name == "grid-gallery") {
        return "// grid-gallery: a header + scrollable tile grid (the hover-cursor demo\n// surface).\nuse tur::{ CROSS_ALIGN_CENTER, CURSOR_POINTER, mount };\nuse tur_kit::{ Column, Container, Expanded, MouseRegion, Row, SizedBox, Text };\n\n\nentry fn tile(i: u64) -> opaque {\n    let b = Container()\n        .width_height(100.0, 100.0)\n        .color(0x1E293BFF)\n        .child(Text().text(f\"tile {i}\").font_size(12.0).build());\n    return MouseRegion().cursor(CURSOR_POINTER).behavior(0).child(b.build()).build();\n}\n\nentry fn start() {\n    let mut col = Column().cross_alignment(CROSS_ALIGN_CENTER);\n    let row = Row().child(tile(0)).child(tile(1)).child(tile(2));\n    col.child(SizedBox(400.0, 40.0).child(Container().build()).build());\n    col.child(row.build());\n    mount(Expanded().flex(1.0).child(col.build()).build());\n}\n";
    }
    if (name == "implicit-animations") {
        return "// implicit-animations: animated style channels driven by one shared\n// controller (the Animated* twin) — the toggle flips the target and\n// restarts the controller (the ImplicitlyAnimatedWidget retarget).\nuse tur::{ anim_ctrl, anim_forward, anim_reverse, mount, rs_get_bool, rs_set_bool, rs_source_bool,\n    rs_source_f64, st_put, st_take, stf_put };\nuse tur_kit::{ Column, Container, PointerInteract, Text };\n\n\nlet K_CTRL: u64 = 1;\nlet K_EXPANDED: u64 = 2;\n\nentry fn start() -> u64 {\n    let expanded = rs_source_bool(false);\n    stf_put(K_EXPANDED, expanded as f64);\n    let progress = rs_source_f64();\n    let ctrl = anim_ctrl(progress, 300.0, \"easeInOut\", 0, \"a_tick\", \"a_end\");\n    st_put(K_CTRL, ctrl);\n\n    let mut col = Column();\n    let box_b = Container().width_height(100.0, 40.0).color(0x6366F1FFu64).query_key(\"animated-box\");\n    col.child(PointerInteract().ids(expanded, expanded).on_tap(\"b_toggle\").child(box_b.build()).build());\n    col.child(Text().text(\"toggle me\").build());\n    mount(col.build());\n    return expanded;\n}\n\nentry fn a_tick(_atom: u64, _t: f64) {\n}\n\nentry fn a_end(_atom: u64, _v: f64) {\n}\n\nentry fn b_toggle(expanded: u64, _b: u64, _n: f64) {\n    rs_set_bool(expanded, !rs_get_bool(expanded));\n    // Retarget: reverse or forward the shared controller.\n    let ctrl = st_take(K_CTRL);\n    if (rs_get_bool(expanded)) {\n        anim_forward(ctrl);\n    } else {\n        anim_reverse(ctrl);\n    }\n    st_put(K_CTRL, ctrl);\n}\n";
    }
    if (name == "jigsaw-puzzle") {
        return "// jigsaw-puzzle: the drag-a-tile board (the regression fixture family the\n// drag-with-lift / drag-redrag-multi tests pin, as a playable board).\nuse tur::{ ALIGN_TOP_LEFT, mount, rs_set_f64, rs_set_str, rs_source_f64, rs_source_str, stf_put, stf_take };\nuse tur_kit::{ Container, PointerInteract, Positioned, SizedBox, Stack, Text };\n\n\nlet K_X: u64 = 1;\nlet K_Y: u64 = 2;\nlet K_PIECE: u64 = 3;\n\nentry fn start() -> u64 {\n    let x = rs_source_f64();\n    let y = rs_source_f64();\n    stf_put(K_X, x as f64);\n    stf_put(K_Y, y as f64);\n    let piece = rs_source_str(\"A\");\n    stf_put(K_PIECE, piece as f64);\n\n    let mut stack = Stack()\n        .alignment(ALIGN_TOP_LEFT)\n        .child(SizedBox(300.0, 300.0).child(Container().build()).build());\n    let b = Container()\n        .width_height(80.0, 80.0)\n        .color(0x6366F1FFu64)\n        .query_key(\"piece\")\n        .child(Text().text(\"A\").build());\n    let pad = PointerInteract().ids(piece, piece).on_click(\"g_down\").on_down(\"g_down\").on_move(\"g_move\").on_up(\"g_up\").query_key(\"rut/gesture\").child(b.build()).build();\n    let pos = Positioned().left(10.0).top(10.0).child(pad).build();\n    stack.child(pos);\n    mount(stack.build());\n    return piece;\n}\n\nentry fn g_down(piece: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    rs_set_str(piece, \"dragging\");\n}\n\nentry fn g_move(piece: u64, _id: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {\n    let x = stf_take(K_X) as u64;\n    let y = stf_take(K_Y) as u64;\n    rs_set_f64(x, gx - 40.0);\n    rs_set_f64(y, gy - 40.0);\n    stf_put(K_X, x as f64);\n    stf_put(K_Y, y as f64);\n}\n\nentry fn g_up(piece: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {\n    rs_set_str(piece, \"A\");\n}\n";
    }
    if (name == "lazy-grid-basic") {
        return "// lazy-grid-basic: a virtualized grid (max cross 150, square cells).\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyGrid };\n\n\nentry fn cell(i: u64) -> opaque {\n    let mut b = Container().width_height(0.0, 0.0);\n    if (i % 2 == 0) {\n        b.color(0x303030FF);\n    } else {\n        b.color(0x1A1A1AFF);\n    }\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 60.0);\n    let grid = LazyGrid().item_builder(\"cell\").count(count).max_cross(150.0).aspect(1.0).query_key(\"lazy-grid-basic\").build();\n    mount(grid);\n}\n";
    }
    if (name == "lazy-grid-gallery") {
        return "// lazy-grid-gallery: a header row above a virtualized gallery grid in a\n// column.\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Column, Container, Expanded, LazyGrid, Text };\n\n\nentry fn cell(i: u64) -> opaque {\n    let b = Container()\n        .width_height(0.0, 0.0)\n        .color(0x1E293BFF)\n        .child(Text().text(f\"tile {i}\").font_size(12.0).build());\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 120.0);\n    let mut col = Column();\n    let header = Container()\n        .width_height(0.0, 40.0)\n        .color(0x0F172AFF)\n        .child(Text().text(\"Gallery\").font_size(16.0).build());\n    col.child(header.build());\n    let grid = LazyGrid().item_builder(\"cell\").count(count).max_cross(150.0).aspect(1.0).build();\n    col.child(Expanded().flex(1.0).child(grid).build());\n    mount(col.build());\n}\n";
    }
    if (name == "lazy-grid-scroll") {
        return "// lazy-grid-scroll: a 600-cell grid — wheeling mounts rows outside the\n// initial build set.\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyGrid };\n\n\nentry fn cell(i: u64) -> opaque {\n    let mut b = Container().width_height(0.0, 0.0);\n    if (i % 2 == 0) {\n        b.color(0x303030FF);\n    } else {\n        b.color(0x1A1A1AFF);\n    }\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 600.0);\n    let grid = LazyGrid().item_builder(\"cell\").count(count).max_cross(150.0).aspect(1.0).query_key(\"lazy-grid-scroll\").build();\n    mount(grid);\n}\n";
    }
    if (name == "lazy-list-var-sizes") {
        return "// lazy-list-var-sizes: an unmeasured (var-extent) LazyList — rows report\n// their own heights (deterministic per-index sizes).\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, LazyList, Text };\n\n\nentry fn row(i: u64) -> opaque {\n    let h = ((i * 37) % 120) as f64 + 30.0;\n    let b = Container()\n        .width_height(400.0, h)\n        .color(0x0B1220FF)\n        .child(Text().text(f\"#{i} h={h as u64}\").font_size(11.0).build());\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 500.0);\n    // itemExtent 0 = unmeasured (var sizes).\n    let list = LazyList().item_builder(\"row\").count(count).query_key(\"lazy-list-var-sizes\").build();\n    mount(list);\n}\n";
    }
    if (name == "lazy-list-virtualized") {
        return "// lazy-list-virtualized: a 2000-row list — only the visible window mounts.\nuse tur::{ mount, rs_set_f64, rs_source_f64 };\nuse tur_kit::{ Container, Expanded, LazyList, Text };\n\n\nentry fn row(i: u64) -> opaque {\n    let b = Container()\n        .width_height(400.0, 40.0)\n        .color(0x0F172AFF)\n        .child(Text().text(f\"row {i}\").font_size(12.0).build());\n    return b.build();\n}\n\nentry fn start() {\n    let count = rs_source_f64();\n    rs_set_f64(count, 2000.0);\n    let list = LazyList().item_builder(\"row\").count(count).item_extent(40.0).build();\n    mount(Expanded().flex(1.0).child(list).build());\n}\n";
    }
    if (name == "password-input") {
        return "// password-input: an obscure-toggle input — typing renders bullets and a\n// reveal button flips the obscure flag (a rebuild).\nuse tur::{ mount, rs_get_bool, rs_set_bool, rs_source_bool, tctrl_new, undo_new };\nuse tur_kit::{ Column, Container, Input, PointerInteract, Text };\n\n\nentry fn start() -> u64 {\n    let obscure = rs_source_bool(true);\n    let ctrl = tctrl_new();\n    let undo = undo_new();\n\n    let mut col = Column();\n    let input = Input().controller(ctrl).undo(undo).placeholder(\"password\").width_height(220.0, 32.0).obscure(true).query_key(\"password-input\").build();\n    col.child(input);\n    col.child(PointerInteract().ids(obscure, obscure).on_tap(\"b_toggle\").child(Text().text(\"reveal\").build()).build());\n    let root = Container().child(col.build());\n    mount(root.build());\n    return obscure;\n}\n\nentry fn b_toggle(obscure: u64, _b: u64, _n: f64) {\n    rs_set_bool(obscure, !rs_get_bool(obscure));\n}\n";
    }
    if (name == "table-basic") {
        return "// table-basic: shared column geometry with a header row, stripes and\n// dividers (the Table widget's corpus twin, authored from flex rows).\nuse tur::{ mount };\nuse tur_kit::{ Column, Container, Row, SizedBox, Text };\n\n\nfn header_cell(label: str, w: f64) -> opaque {\n    let b = Container().width_height(w, 0.0).padding(8.0).child(Text().text(label).font_size(12.0).build());\n    return b.build();\n}\n\nfn cell(label: str, w: f64) -> opaque {\n    let b = Container().width_height(w, 0.0).padding(8.0).child(Text().text(label).font_size(14.0).build());\n    return b.build();\n}\n\nfn header() -> opaque {\n    let r = Row()\n        .child(header_cell(\"PLANET\", 150.0))\n        .child(header_cell(\"NOTES\", 100.0))\n        .child(header_cell(\"DISTANCE\", 100.0));\n    return r.build();\n}\n\nfn planet(name: str, notes: str, distance: str) -> opaque {\n    let r = Row().child(cell(name, 150.0)).child(cell(notes, 100.0)).child(cell(distance, 100.0));\n    let wrapped = Container().width_height(0.0, 36.0).child(r.build());\n    return wrapped.build();\n}\n\nentry fn start() {\n    let table = Column()\n        .child(header())\n        .child(planet(\"Mercury\", \"Smallest planet\", \"0.39 AU\"))\n        .child(planet(\"Venus\", \"Hottest surface\", \"0.72 AU\"))\n        .child(planet(\"Earth\", \"Home of life\", \"1.00 AU\"))\n        .child(planet(\"Mars\", \"The red planet\", \"1.52 AU\"));\n    let frame = Container().color(0x0B1220FF).child(table.build());\n    mount(SizedBox(400.0, 240.0).child(frame.build()).build());\n}\n";
    }
    if (name == "table-reactive") {
        return "// table-reactive: the table twin with a reactive row set — a button adds\n// a planet through an Each over the rows atom.\nuse tur::{ mount, rs_get_value, rs_list_new, rs_list_push, rs_set_value, rs_source_value,\n    rs_value_item, rs_value_len };\nuse tur_kit::{ Column, Container, Each, PointerInteract, Row, SizedBox, Text };\n\n\nentry fn row(_i: u64, name: str) -> opaque {\n    let mut r = Row();\n    let c = Container().width_height(150.0, 0.0).padding(8.0).child(Text().text(name).font_size(14.0).build());\n    r.child(c.build());\n    return r.build();\n}\n\nentry fn start() -> u64 {\n    let rows = rs_list_new();\n    rs_list_push(rows, \"Mercury\");\n    rs_list_push(rows, \"Venus\");\n    let rows_atom = rs_source_value(rows);\n\n    let mut col = Column();\n    let head = Container()\n        .width_height(0.0, 32.0)\n        .color(0x1E293BFF)\n        .child(Text().text(\"PLANET\").font_size(12.0).build());\n    col.child(head.build());\n    col.child(Each(rows_atom).item_builder(\"row\").build());\n    col.child(PointerInteract().ids(rows_atom, rows_atom).on_tap(\"b_add\").child(Text().text(\"add row\").build()).build());\n    let frame = Container().color(0x0B1220FF).child(col.build());\n    mount(SizedBox(400.0, 240.0).child(frame.build()).build());\n    return rows_atom;\n}\n\nentry fn b_add(rows: u64, _b: u64, _n: f64) {\n    // Read-modify-write: rebuild the list with one more row.\n    let cur = rs_get_value(rows);\n    let n = rs_value_len(cur);\n    let fresh = rs_list_new();\n    let mut i = 0;\n    while (i < n as i32) {\n        rs_list_push(fresh, rs_value_item(cur, i as u64));\n        i += 1;\n    }\n    rs_list_push(fresh, f\"Planet {n as u64}\");\n    rs_set_value(rows, fresh);\n}\n";
    }
    if (name == "todolist") {
        return "// todolist: the checkable list showcase (the corpus's composite surface:\n// scroll + per-item gestures + derived count).\nuse tur::{ AXIS_VERTICAL, MAIN_ALIGN_SPACE_BETWEEN, mount, rs_derive, rs_list_new, rs_list_push,\n    rs_set_value, rs_source_value, stf_put, stf_take };\nuse tur_kit::{ Column, Container, Each, Expanded, PointerInteract, Row, ScrollView, SizedBox, Text };\n\n\nlet K_ITEMS: u64 = 1;\n\nentry fn item(_i: u64, s: str) -> opaque {\n    let r = Row()\n        .main_alignment(MAIN_ALIGN_SPACE_BETWEEN)\n        .child(Text().text(s).build())\n        .child(Container().width_height(20.0, 20.0).query_key(\"check\").build());\n    let wrap = Container().width_height(0.0, 44.0).child(r.build());\n    return PointerInteract().ids(_i, 0).on_click(\"it_tap\").query_key(\"rut/gesture\").child(wrap.build()).build();\n}\n\nentry fn start() -> u64 {\n    let items = rs_list_new();\n    rs_list_push(items, \"Buy milk\");\n    rs_list_push(items, \"Ship phase 4\");\n    rs_list_push(items, \"Walk the dog\");\n    let items_atom = rs_source_value(items);\n    stf_put(K_ITEMS, items_atom as f64);\n    let count = rs_derive(\"fmt_count\", items_atom);\n\n    let mut col = Column();\n    let head = Container()\n        .width_height(0.0, 48.0)\n        .child(Text().text_bound_derived(count).query_key(\"count\").build());\n    col.child(head.build());\n    let content = Column().child(Each(items_atom).item_builder(\"item\").build());\n    let scroller = ScrollView().axis(AXIS_VERTICAL).child(content.build()).build();\n    col.child(Expanded().flex(1.0).child(scroller).build());\n    let add = Container()\n        .width_height(0.0, 48.0)\n        .child(PointerInteract().ids(items_atom, items_atom).on_tap(\"b_add\").child(Text().text(\"+ add\").build()).build());\n    col.child(add.build());\n    mount(SizedBox(400.0, 600.0).child(col.build()).build());\n}\n\nentry fn fmt_count(_v: f64) -> str {\n    return \"todos\";\n}\n\nentry fn it_tap(_idx: u64, _b: u64, _n: f64) {\n}\n\nentry fn b_add(_a: u64, _b: u64, _n: f64) {\n    let items = stf_take(K_ITEMS) as u64;\n    let fresh = rs_list_new();\n    rs_list_push(fresh, \"Buy milk\");\n    rs_list_push(fresh, \"Ship phase 4\");\n    rs_list_push(fresh, \"Walk the dog\");\n    rs_list_push(fresh, \"New todo\");\n    rs_set_value(items, fresh);\n    stf_put(K_ITEMS, items as f64);\n}\n";
    }
    return "";
}
