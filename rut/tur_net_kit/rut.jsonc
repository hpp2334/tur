// tur_net_kit — the net capability's kit prelude (the authored face over
// the net rows). Owned by the plugin that owns the rows (the layering law
// applied to the kit); embedded by tur-net-capability/src/kit.rs and
// registered as a compile-session prelude only when the Http capability
// is present.
{
  "name": "tur_net_kit",
  "entry": { "lib": "./kit.rut" },
  "deps": {
    "tur_host": { "path": "../tur_host" },
    "tur_kit": { "path": "../tur_kit" }
  }
}
