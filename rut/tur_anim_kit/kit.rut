// tur_anim_kit.rut — the animation family's kit wrappers (the authored
// surface over the `tur` host pkg's animation rows: `el_opacity` /
// `el_opacity_bound` / `el_transform` / the bound transform twins). Owned
// by the plugin that owns the rows (the layering law applied to the kit
// itself): tur-animation registers this prelude alongside its rows, so
// engine plugin sets without animation never see (or need) these classes.
//
// Construction law (as everywhere in the kit): build with the class call
// form — `Opacity(0.5)` / `Transform(scale, rotate, tx, ty)` — over each
// class's `[constructor] fn builder()` (the `.builder()` long form stays
// valid — byte-identical lowering), and CHAIN it:
// `let o = Opacity(0.5).child(kid);` — never `let mut o` + `o.child(..);`
// statement runs.
//
// Handler law (the mutation rail): the controller's tick / end are SEALED
// MUTATIONS — `mutate<f64>(fn (ctx: MutationCtx, v: f64) { ... })` ticks
// (boa wraps onTick in mutate), `mutate(fn (ctx: MutationCtx, _e: nil)
// { ... })` ends. The params are the generic `Mutation<A>` interface; the
// controller seals each under ITS payload shape at install (the f64 tick
// crossing is raw, the payload-less end is nil). Nullable params (the
// `kid: ?opaque` field pattern) let one kit fn serve every combo: the kit
// branches to the row's 0 = absent by null-check.
use tur_host::{ anim_ctrl_mut, anim_forward, anim_pause, anim_repeat, anim_resume, anim_reverse, anim_seek, anim_speed, anim_status, anim_stop, anim_value, el_opacity, el_opacity_bound, el_transform, el_transform_angle_bound, el_transform_scale_bound, el_transform_translate_bound };
use tur_kit::{ Mutation, MutationCtx, Readable, View, mutate };

// The seal tags the controller installs under — the kit spells the same
// numbers as its own consts (rut_runtime::seal_tags; one law, two
// spellings, exactly as tur_kit mirrors them).
let SEAL_NIL: u64 = 0;
let SEAL_F64: u64 = 2;

// The animation controller — the authored face over the `anim_ctrl_mut`
// row: a NOMINAL newtype (`class AnimCtrl(opaque)` — the compiler-given
// `AnimCtrl(v)` is the construction, the field is private), so the row
// calls surface as METHODS and an AnimCtrl can never be confused with
// another handle. The tick is `Mutation<f64>` (the eased progress crosses
// as the invocation payload) and the end is `Mutation<nil>`; either may
// be nil (the controller then only drives its bound channels — polled
// through `.value()`). The tick mutation CAPTURES the channels it
// drives — no id rail, no stash.
pub class AnimCtrl(opaque);

impl AnimCtrl {
  // The erase hatch: the one place a controller goes back to a raw
  // opaque (the `st_*` stash rails are opaque-typed by design).
  pub fn raw(self) -> opaque {
    return self.inner;
  }
  pub fn forward(self) {
    anim_forward(self.inner);
  }
  pub fn reverse(self) {
    anim_reverse(self.inner);
  }
  pub fn pause(self) {
    anim_pause(self.inner);
  }
  pub fn resume(self) {
    anim_resume(self.inner);
  }
  pub fn stop(self) {
    anim_stop(self.inner);
  }
  pub fn seek(self, t: f64) {
    anim_seek(self.inner, t);
  }
  pub fn repeat(self, n: u64) {
    anim_repeat(self.inner, n);
  }
  pub fn speed(self, factor: f64) {
    anim_speed(self.inner, factor);
  }
  // The polled progress (the eased f64 driving the bound channels).
  pub fn value(self) -> f64 {
    return anim_value(self.inner);
  }
  // The transport state ("playing" / "paused" / …).
  pub fn status(self) -> str {
    return anim_status(self.inner);
  }
}

pub fn anim_ctrl(duration_ms: f64, curve: str, repeat: u64, on_tick: ?Mutation<f64>, on_end: ?Mutation<nil>) -> AnimCtrl {
  let mut tick: u64 = 0;
  if (on_tick != nil) {
    tick = on_tick.seal(SEAL_F64);
  }
  let mut end: u64 = 0;
  if (on_end != nil) {
    end = on_end.seal(SEAL_NIL);
  }
  return AnimCtrl(anim_ctrl_mut(duration_ms, curve, repeat, tick, end));
}

// The tick-only twin — `anim_ctrl_tick(dur, curve, repeat, tick)`.
pub fn anim_ctrl_tick(duration_ms: f64, curve: str, repeat: u64, on_tick: Mutation<f64>) -> AnimCtrl {
  return AnimCtrl(anim_ctrl_mut(duration_ms, curve, repeat, on_tick.seal(SEAL_F64), 0));
}

// The end-only twin — `anim_ctrl_end(dur, curve, repeat, end)`.
pub fn anim_ctrl_end(duration_ms: f64, curve: str, repeat: u64, on_end: Mutation<nil>) -> AnimCtrl {
  return AnimCtrl(anim_ctrl_mut(duration_ms, curve, repeat, 0, on_end.seal(SEAL_NIL)));
}

// The bare controller (no callbacks — polled through `.value()`).
pub fn anim_ctrl_open(duration_ms: f64, curve: str, repeat: u64) -> AnimCtrl {
  return AnimCtrl(anim_ctrl_mut(duration_ms, curve, repeat, 0, 0));
}

class Opacity {
  value: f64;
  r: ?Readable<f64>;
  kid: ?opaque;
}

impl Opacity {
  [constructor] pub fn builder(value: f64) -> Self {
    return Self { value: value, r: nil, kid: nil };
  }
  // Bind the opacity to a live f64 (the onTick rail's consumer).
  pub fn bound(mut self, r: Readable<f64>) -> Self {
    self.r = r;
    return self;
  }
  pub fn child(mut self, c: View) -> Self {
    self.kid = c.inner;
    return self;
  }
  pub fn build(self) -> View {
    if (self.r != nil) {
      return View(el_opacity_bound(self.r.atom_id(), self.kid));
    }
    return View(el_opacity(self.value, self.kid));
  }
}

class Transform {
  scale: f64;
  rotate: f64;
  tx: f64;
  ty: f64;
  // The bound channels (nil = static): each channel rides its own live
  // f64 — an orbit writes cx + r·cos / cy + r·sin independently, an
  // eased scale binds alone (the rows are Val-backed per channel).
  scale_r: ?Readable<f64>;
  rotate_r: ?Readable<f64>;
  tx_r: ?Readable<f64>;
  ty_r: ?Readable<f64>;
  kid: ?opaque;
}

impl Transform {
  [constructor] pub fn builder(scale: f64, rotate: f64, tx: f64, ty: f64) -> Self {
    return Self { scale: scale, rotate: rotate, tx: tx, ty: ty, scale_r: nil, rotate_r: nil, tx_r: nil, ty_r: nil, kid: nil };
  }
  // Bind the rotation channel to a live f64 (radians — the onTick rail's
  // consumer): the angle re-resolves through the subscribe → relayout
  // rail and the subtree NEVER re-mounts (no rebuild channel). The rows
  // are ONE bound channel per element — the last bind clears the others
  // (never a silent combo).
  pub fn rotate_bound(mut self, r: Readable<f64>) -> Self {
    self.rotate_r = r;
    self.scale_r = nil;
    self.tx_r = nil;
    self.ty_r = nil;
    return self;
  }
  // The uniform scale rides a live f64 (last bind wins).
  pub fn scale_bound(mut self, r: Readable<f64>) -> Self {
    self.scale_r = r;
    self.rotate_r = nil;
    self.tx_r = nil;
    self.ty_r = nil;
    return self;
  }
  // The translate twins: each offset rides its own live f64 (last bind
  // wins — the translate row is the one multi-channel shape).
  pub fn translate_bound(mut self, tx: Readable<f64>, ty: Readable<f64>) -> Self {
    self.tx_r = tx;
    self.ty_r = ty;
    self.scale_r = nil;
    self.rotate_r = nil;
    return self;
  }
  pub fn child(mut self, c: View) -> Self {
    self.kid = c.inner;
    return self;
  }
  pub fn build(self) -> View {
    if (self.rotate_r != nil) {
      return View(el_transform_angle_bound(self.scale, self.rotate_r.atom_id(), self.tx, self.ty, self.kid));
    }
    if (self.scale_r != nil) {
      return View(el_transform_scale_bound(self.scale_r.atom_id(), self.rotate, self.tx, self.ty, self.kid));
    }
    if (self.tx_r != nil || self.ty_r != nil) {
      let mut tx_atom: u64 = 0;
      if (self.tx_r != nil) {
        tx_atom = self.tx_r.atom_id();
      }
      let mut ty_atom: u64 = 0;
      if (self.ty_r != nil) {
        ty_atom = self.ty_r.atom_id();
      }
      return View(el_transform_translate_bound(self.scale, self.rotate, tx_atom, ty_atom, self.kid));
    }
    return View(el_transform(self.scale, self.rotate, self.tx, self.ty, self.kid));
  }
}
