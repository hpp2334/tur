// text/core — the text family (Text / Spans).

use tur_host::text::core::{
  span_add, spans_new, text_bind, text_bind_derived, text_build, text_clip, text_color,
  text_ellipsis, text_font_family, text_font_family_fallback_clear,
  text_font_family_fallback_push, text_max_lines, text_new, text_overflow_visible, text_qkey,
  text_selectable, text_size, text_spans, text_text, text_weight,
};

// ---- text family (Text / spans) -------------------------------------------

pub class Text {
  spec: opaque;
}

impl Text {
  [constructor] pub fn builder() -> Self {
    return Self { spec: text_new() };
  }
  // The ONE reactive text prop over `Readable<str>` — the handle's kind
  // selects the lane: a derived binds through the derive rail, an `sv()`
  // literal lowers through the static row (pure read off the box), a
  // source binds directly.
  pub fn text(mut self, r: reactive::Readable<str>) -> Self {
    if (r.is_derived()) {
      text_bind_derived(self.spec, r.atom_id());
    } else if (r.atom_id() == 0) {
      text_text(self.spec, r.get());
    } else {
      text_bind(self.spec, r.atom_id());
    }
    return self;
  }
  pub fn font_size(mut self, v: f64) -> Self {
    text_size(self.spec, v);
    return self;
  }
  pub fn font_weight(mut self, v: f64) -> Self {
    text_weight(self.spec, v);
    return self;
  }
  // The primary font family — resolved BY NAME (Flutter's `fontFamily`).
  // Unknown names are skipped (try-next); the engine default family always
  // closes the stack.
  pub fn font_family(mut self, v: str) -> Self {
    text_font_family(self.spec, v);
    return self;
  }
  // The ordered fallback families (Flutter's `fontFamilyFallback`) — the
  // kit composes the list from clear + pushes (no list type in the row
  // ABI), so a repeated call REPLACES the previous list.
  pub fn font_family_fallback(mut self, names: [str]) -> Self {
    text_font_family_fallback_clear(self.spec);
    for (let n of names) {
      text_font_family_fallback_push(self.spec, n);
    }
    return self;
  }
  pub fn color(mut self, packed: u64) -> Self {
    text_color(self.spec, packed);
    return self;
  }
  pub fn max_lines(mut self, n: u64) -> Self {
    text_max_lines(self.spec, n);
    return self;
  }
  pub fn clip(mut self) -> Self {
    text_clip(self.spec);
    return self;
  }
  pub fn ellipsis(mut self) -> Self {
    text_ellipsis(self.spec);
    return self;
  }
  pub fn overflow_visible(mut self) -> Self {
    text_overflow_visible(self.spec);
    return self;
  }
  pub fn selectable(mut self, v: bool) -> Self {
    text_selectable(self.spec, v);
    return self;
  }
  pub fn spans(mut self, list: Spans) -> Self {
    text_spans(self.spec, list.spec);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    text_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> handles::View {
    return handles::View(text_build(self.spec));
  }
}

pub class Spans {
  spec: opaque;
}

impl Spans {
  [constructor] pub fn builder() -> Self {
    return Self { spec: spans_new() };
  }
  pub fn add(mut self, text: str, size: f64, packed: u64, weight: f64, span_flags: flags::SpanFlags) -> Self {
    span_add(self.spec, text, size, packed, weight, flags::span_flags_code(span_flags));
    return self;
  }
}

