// layout/box — the container family (Container / SizedBox).

use tur_host::{
  box_align, box_border, box_build, box_child, box_clip, box_color, box_color_bound, box_height,
  box_height_bound, box_new, box_padding, box_qkey, box_radius, box_radius_bound, box_shadow,
  box_shadow_blur_bound, box_shadow_color_bound, box_shadow_dy_bound, box_size, box_width,
  box_width_bound, sizedbox_build, sizedbox_child, sizedbox_new, sizedbox_qkey,
};

// ---- container family (Container / SizedBox) ------------------------------

pub class Container {
  spec: opaque;
}

impl Container {
  [constructor] pub fn builder() -> Self {
    return Self { spec: box_new() };
  }
  pub fn width_height(mut self, w: f64, h: f64) -> Self {
    box_size(self.spec, w, h);
    return self;
  }
  pub fn padding(mut self, v: f64) -> Self {
    box_padding(self.spec, v);
    return self;
  }
  pub fn width(mut self, v: f64) -> Self {
    box_width(self.spec, v);
    return self;
  }
  pub fn height(mut self, v: f64) -> Self {
    box_height(self.spec, v);
    return self;
  }
  pub fn color(mut self, packed: u64) -> Self {
    box_color(self.spec, packed);
    return self;
  }
  pub fn color_bound(mut self, r: reactive.Readable<u64>) -> Self {
    box_color_bound(self.spec, r.atom_id());
    return self;
  }
  pub fn width_bound(mut self, r: reactive.Readable<f64>) -> Self {
    box_width_bound(self.spec, r.atom_id());
    return self;
  }
  pub fn height_bound(mut self, r: reactive.Readable<f64>) -> Self {
    box_height_bound(self.spec, r.atom_id());
    return self;
  }
  // The reactive corner radius (animated radius rides a derive of the
  // progress atom).
  pub fn radius_bound(mut self, r: reactive.Readable<f64>) -> Self {
    box_radius_bound(self.spec, r.atom_id());
    return self;
  }
  pub fn border(mut self, packed: u64, width: f64, position: flags.BorderPosition) -> Self {
    box_border(self.spec, packed, width, flags.border_pos_code(position));
    return self;
  }
  pub fn radius(mut self, r: f64) -> Self {
    box_radius(self.spec, r);
    return self;
  }
  pub fn shadow(mut self, packed: u64, blur: f64, dx: f64, dy: f64) -> Self {
    box_shadow(self.spec, packed, blur, dx, dy);
    return self;
  }
  // The reactive shadow channels — per-state piece glows (the jigsaw drag
  // states) and eased blur (the implicit-animations shadow) ride atoms, not
  // rebuilds. The bound dy wins over the static offset's y.
  pub fn shadow_color_bound(mut self, r: reactive.Readable<u64>) -> Self {
    box_shadow_color_bound(self.spec, r.atom_id());
    return self;
  }
  pub fn shadow_blur_bound(mut self, r: reactive.Readable<f64>) -> Self {
    box_shadow_blur_bound(self.spec, r.atom_id());
    return self;
  }
  pub fn shadow_dy_bound(mut self, r: reactive.Readable<f64>) -> Self {
    box_shadow_dy_bound(self.spec, r.atom_id());
    return self;
  }
  pub fn alignment(mut self, v: flags.Align) -> Self {
    box_align(self.spec, flags.align_code(v));
    return self;
  }
  pub fn clip(mut self, v: flags.Clip) -> Self {
    box_clip(self.spec, flags.clip_code(v));
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    box_qkey(self.spec, k);
    return self;
  }
  pub fn child(mut self, c: handles.View) -> Self {
    box_child(self.spec, c.inner);
    return self;
  }
  pub fn children(mut self, cs: [handles.View]) -> Self {
    for (let c of cs) {
      box_child(self.spec, c.inner);
    }
    return self;
  }
  pub fn build(self) -> handles.View {
    return handles.View(box_build(self.spec));
  }
}

pub class SizedBox {
  spec: opaque;
}

impl SizedBox {
  [constructor] pub fn builder(w: f64, h: f64) -> Self {
    return Self { spec: sizedbox_new(w, h) };
  }
  pub fn child(mut self, c: handles.View) -> Self {
    sizedbox_child(self.spec, c.inner);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    sizedbox_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> handles.View {
    return handles.View(sizedbox_build(self.spec));
  }
}

