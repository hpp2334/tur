// layout/stack — the stack families (Stack / Positioned).

use tur_host::{
  pos_bottom, pos_build, pos_child, pos_height, pos_left, pos_left_bound, pos_new, pos_right,
  pos_top, pos_top_bound, pos_width, stack_align, stack_build, stack_child, stack_fit, stack_new,
  stack_qkey,
};

// ---- stack + positioned ---------------------------------------------------

pub class Stack {
  spec: opaque;
}

impl Stack {
  [constructor] pub fn builder() -> Self {
    return Self { spec: stack_new() };
  }
  pub fn alignment(mut self, v: flags.Align) -> Self {
    stack_align(self.spec, flags.align_code(v));
    return self;
  }
  pub fn fit(mut self, v: flags.StackFit) -> Self {
    stack_fit(self.spec, flags.stack_fit_code(v));
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    stack_qkey(self.spec, k);
    return self;
  }
  pub fn child(mut self, c: handles.View) -> Self {
    stack_child(self.spec, c.inner);
    return self;
  }
  pub fn children(mut self, cs: [handles.View]) -> Self {
    for (let c of cs) {
      stack_child(self.spec, c.inner);
    }
    return self;
  }
  pub fn build(self) -> handles.View {
    return handles.View(stack_build(self.spec));
  }
}

pub class Positioned {
  spec: opaque;
}

impl Positioned {
  [constructor] pub fn builder() -> Self {
    return Self { spec: pos_new() };
  }
  pub fn left(mut self, v: f64) -> Self {
    pos_left(self.spec, v);
    return self;
  }
  pub fn top(mut self, v: f64) -> Self {
    pos_top(self.spec, v);
    return self;
  }
  // The reactive anchors (drag-to-move writes the live atom; a bound
  // anchor's 0 is a real coordinate, same as the static rows — anchors
  // are verbatim, absence is never calling the row).
  pub fn left_bound(mut self, r: reactive.Readable<f64>) -> Self {
    pos_left_bound(self.spec, r.atom_id());
    return self;
  }
  pub fn top_bound(mut self, r: reactive.Readable<f64>) -> Self {
    pos_top_bound(self.spec, r.atom_id());
    return self;
  }
  pub fn right(mut self, v: f64) -> Self {
    pos_right(self.spec, v);
    return self;
  }
  pub fn bottom(mut self, v: f64) -> Self {
    pos_bottom(self.spec, v);
    return self;
  }
  pub fn width(mut self, v: f64) -> Self {
    pos_width(self.spec, v);
    return self;
  }
  pub fn height(mut self, v: f64) -> Self {
    pos_height(self.spec, v);
    return self;
  }
  pub fn child(mut self, c: handles.View) -> Self {
    pos_child(self.spec, c.inner);
    return self;
  }
  pub fn build(self) -> handles.View {
    return handles.View(pos_build(self.spec));
  }
}

