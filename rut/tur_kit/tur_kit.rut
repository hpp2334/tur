    lazy_grid_builder(self.spec, opaque(cb));
    return self;
  }
  pub fn count(mut self, r: Readable<f64>) -> Self {
    lazy_grid_count(self.spec, r.atom_id());
    return self;
  }
  pub fn axis(mut self, v: u64) -> Self {
