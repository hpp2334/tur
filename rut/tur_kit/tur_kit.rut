// tur_kit.rut — the authored element-construction surface (the kit).
//
// ONE wrapper class per element over its family's `tur` host-pkg rows:
// chainable methods (ONE METHOD PER PROP, named after the historical
// camelCase props in snake_case), `.child(c)` / `.children([...])`
// appending, and `.build()` as the ONLY terminal (each class's build calls
// its FAMILY's build row — `Column.build()` → `flex_build`, …).
//
// Construction law: build with the class call form — `Column()` /
// `SizedBox(400.0, 200.0)` — over each class's `[constructor] fn
// builder()` (the `.builder()` long form stays valid — byte-identical
// lowering), and CHAIN it: `let c = X().prop(..).child(..);` — never
// `let mut c` + `c.prop(..);` statement runs.
//
// Handler law: GESTURE handlers are MUTATIONS over the MutationCtx —
// `on_click(mutate(fn (ctx: MutationCtx, _e: nil) { ctx.set(x, v); }))`
// (the triad: source / derive / mutate, M1; A = nil is the click shape —
// one fn-type law for every payload). The kit seals the user fn into an
// opaque box and hands the ROW only the box; the flush's mutation pass
// invokes it through the dispatch entries below with a fresh ctx (queued
// — never synchronously inside the gesture dispatch). The remaining
// fn-value callback props (on_tap / on_input / on_enter …) keep the
// sealing law — a named `fn` or anonymous literal, sealed into an opaque
// box, fired back through the dispatch entries — until the M2 sweep
// converts them to their typed events. The arity/type check happens at
// THIS boundary, at compile time. Nothing callable crosses the boundary
// as a string. `View` is the user-facing alias for built views.
//
// Reactive bindings are methods (`text_bound(atom)`, `color_bound(atom)`),
// not constructor variants. Flags are the `u64` consts the `tur` pkg
// declares (`ALIGN_*` / `CLIP_*` / `BORDER_*` / `CROSS_ALIGN_*` /
// `MAIN_ALIGN_*` / `MAIN_SIZE_*` / `FIT_*` / `STACK_FIT_*` / `AXIS_*` /
// `BOXFIT_*` / `CURSOR_*` / `HIT_TEST_*` / `SPAN_*`) — import them from
// `tur` directly.
//
// Color law: every `packed: u64` color prop (`color` / `color_bound` /
// `placeholder_color` / `cursor_color` / `border` / `shadow` / `span_add`)
// packs **`0xRRGGBBAA`** — R in bits 31..24, A in bits 7..0. An OPAQUE
// color is `0xRRGGBBFF`; passing a bare `0xRRGGBB` shifts the channels
// (it decodes as a translucent `0x00'GG'BB'??` cyan-ish wash — the law is
// pinned natively by `tests/element/color_packing_law.rs`).
//
// The kit lives OUTSIDE core/ (the layering law): core owns mechanism,
// each plugin owns its spec + rows, and this module — registered as a
// compile-session prelude by the standard bundle assembly — is the stable
// authored surface rut modules import (`use tur_kit::{ Column, … };`).
//
// Shape note: every class holds exactly ONE `spec: opaque` field (the
// family's host-side spec) — no rut-side containers; the host spec
// accumulates children through the `*_child` rows.
use tur::{
  box_align, box_border, box_build, box_child, box_clip, box_color, box_color_bound, box_height,
  box_height_bound, box_new, box_padding, box_qkey, box_radius, box_radius_bound, box_shadow,
  box_shadow_blur_bound, box_shadow_color_bound, box_shadow_dy_bound,
  box_size, box_width, box_width_bound,
  col_fixed, col_flex, cols_new, cond_build, cond_else, cond_else_build, cond_new, cond_qkey,
  cond_then, cond_then_build, ct_follower_build,
  ct_follower_child, ct_follower_follower_anchor, ct_follower_link, ct_follower_new,
  ct_follower_offset, ct_follower_target_anchor, ct_follower_target_anchor_bound, ct_link_new,
  ct_target_build, ct_target_child, ct_target_link, ct_target_new, each_build, each_builder,
  each_new, flex_build, flex_child, flex_column, flex_cross_align, flex_main_align,
  flex_main_size, flex_qkey, flex_row, flexi_build, flexi_child, flexi_fit, flexi_flex,
  flexi_qkey,
  focus_build, focus_child, focus_new, focus_on_blur,
  focus_on_focus, focus_on_key_down, frag_build, frag_child, frag_new, grid_aspect,
  grid_build, grid_child, grid_main_extent, grid_max_cross, grid_qkey, grid_spacing,
  img_build, img_fit, img_height, img_new, img_qkey, img_res_bytes, img_res_solid, img_width,
  input_build, input_color, input_controller, input_cursor_color, input_font_family,
  input_font_size, input_multiline, input_new, input_obscure, input_obscure_bound,
  input_obscure_char,
  input_on_input, input_placeholder, input_placeholder_bound, input_placeholder_color,
  input_qkey, input_size, input_undo, tctrl_new, tctrl_set_text, tctrl_text, undo_new,
  lazy_axis,
  lazy_build, lazy_builder, lazy_count, lazy_grid_aspect, lazy_grid_axis, lazy_grid_build,
  lazy_grid_builder, lazy_grid_count, lazy_grid_item_extent, lazy_grid_max_cross,
  lazy_grid_new, lazy_grid_overscan,
  lazy_grid_qkey, lazy_grid_spacing, lazy_item_extent, lazy_list_new, lazy_overscan, lazy_qkey, lc_before_destroy,
  lc_build, lc_child, lc_new, lc_on_mount, mr_build, mr_child, mr_cursor, mr_cursor_bound,
  mr_new, mr_on_enter, mr_on_exit, mr_behavior, pi_behavior, pi_build, pi_child,
  pi_mut_down, pi_mut_move, pi_mut_up,
  pi_new, pi_on_click, pi_on_context_menu,
  pi_qkey, pos_bottom, pos_build, pos_child, pos_height, pos_left, pos_left_bound, pos_new,
  pos_right, pos_top, pos_top_bound,
  pos_width, rs_derive2_cb, rs_derive_cb, rs_list_new, rs_list_push, rs_map_new, rs_map_set,
  rs_source_value, rs_value_get, rs_value_item, rs_value_len, rs_watch_cb, scroll_axis,
  scroll_build, scroll_child,
  scroll_new, scroll_offset, scroll_qkey,
  sizedbox_build, sizedbox_child, sizedbox_new, sizedbox_qkey,
  span_add, spans_new, stack_align, stack_build, stack_child, stack_fit, stack_new, stack_qkey,
  switch_build, switch_case, switch_case_build, switch_fallback, switch_new, switch_qkey,
  switch_value_derived,
  switch_value_source, table_build, table_col_extent, table_columns, table_header_builder,
  table_new, table_qkey, table_row_builder, table_rows_atom, table_stripe, text_bind,
  text_bind_derived, text_build, text_clip, text_color, text_ellipsis, text_max_lines, text_new,
  text_overflow_visible, text_qkey, text_selectable, text_size, text_spans, text_text, text_weight,
  va_app_atom, va_bind, va_build,
  va_controller, va_controller_set, va_destroy, va_error, va_new, va_qkey, va_size,
  va_create_source, va_source_handle, va_status, va_status_atom,
  // the mutation rail (source / derive / mutate + the ctx rows).
  ctx_bridge, ctx_run_box, ctx_get_box, ctx_set_box, derive_seal, mutate_seal,
  rs_box_stamp, rs_source_box,
};

// The async launch rail's typed surface (the `futures` package rides the
// same run chain the kit compiles in).
use core::{ Future };
use futures::{ launch_future };


// The user-facing view alias: built views cross kit signatures as `View`
// (`fn build_expanded() -> View`, `pub fn child(mut self, c: View)`).
//
// The vocabulary law: biz signatures spell WHAT a value is — views say
// `View`, handles say their type — and bare `opaque` stays infra-only
// (row decls, the dispatch entries, kit internals). `View` and the data
// handles are transparent aliases; the CONTROLLERS are nominal newtypes
// (`class X(opaque)` — the compiler-provided `X(v)` is the construction,
// the `inner` field is private), so a TextCtrl can never be confused
// with another handle and the rows they wrap surface as METHODS, never
// as raw row calls in biz code.
pub type View = opaque;

// A structured store list (`list_new` / `list_push`).
pub type ListHandle = opaque;
// A structured store map (`map_new` / `map_set`).
pub type MapHandle = opaque;
// A mem cell (`mem_new` / `mem_get` / `mem_set` — the generation-guard rail).
pub type MemCell = opaque;
// A virtual-app source (`va_create_source` / `virtual_app_source`).
pub type VAppSource = opaque;

// The text-input controller (`tctrl_new` / `tctrl_set_text` /
// `tctrl_text`; `Input.controller`). Mint with `text_ctrl()`.
pub class TextCtrl(opaque);

impl TextCtrl {
  // The erase hatch: the one place a controller goes back to a raw
  // opaque (the `st_*` stash rails are opaque-typed by design).
  pub fn raw(self) -> opaque {
    return self.inner;
  }
  pub fn set_text(self, s: str) {
    tctrl_set_text(self.inner, s);
  }
  pub fn text(self) -> str {
    return tctrl_text(self.inner);
  }
}

// Mint the input's text controller.
pub fn text_ctrl() -> TextCtrl {
  return TextCtrl(tctrl_new());
}

// The input undo controller (`undo_new`; `Input.undo`). Mint with
// `undo_ctrl()`.
pub class UndoCtrl(opaque);

impl UndoCtrl {
  pub fn raw(self) -> opaque {
    return self.inner;
  }
}

// Mint the input's undo controller.
pub fn undo_ctrl() -> UndoCtrl {
  return UndoCtrl(undo_new());
}

// A virtual-app controller (`va_controller`; `VirtualAppView.controller`).
pub class VAppCtrl(opaque);

impl VAppCtrl {
  pub fn raw(self) -> opaque {
    return self.inner;
  }
  pub fn status(self) -> str {
    return va_status(self.inner);
  }
  pub fn status_atom(self) -> u64 {
    return va_status_atom(self.inner);
  }
  pub fn error(self) -> str {
    return va_error(self.inner);
  }
  pub fn destroy(self) {
    va_destroy(self.inner);
  }
}

// ---- the infra dispatch entries (the callback rail's fire half) ----------
//
// The engine's intent drain calls these with the SEALED callback box as
// the first argument (the only callable shape that ever crosses). Each
// entry recovers the fn value — the downcast spells the same fn type the
// sealing kit method declared, so the ids always match — and calls it.
// One entry per payload shape; the arities are the drain's contract.
//
// Scope law: a kit's dispatch entries live in the SAME module that seals
// its callbacks (the box stamps the sealing unit's fn-type id; the
// downcast must spell the same id). So this kit owns the shapes its
// surfaces declare — click/key/pointer/build/derive — and OTHER kits own
// theirs (tur_anim_kit: `__tur_acb_val`; the net kit: `__tur_ncb_bytes`).
// A fn-type shape is exported by at most ONE kit per program.

entry fn __tur_cb_click(cb: opaque, a: u64, b: u64, n: f64) {
  let f = opaque.downcast<fn(u64, u64, f64)>(cb);
  f(a, b, n);
}

entry fn __tur_cb_key(cb: opaque, id: u64, key: str, code: str, mods: u64, kind: u64) {
  let f = opaque.downcast<fn(u64, str, str, u64, u64)>(cb);
  f(id, key, code, mods, kind);
}

entry fn __tur_cb_ptr1(cb: opaque, id: u64, lx: f64, ly: f64, gx: f64, gy: f64, btn: u64) {
  let f = opaque.downcast<fn(u64, f64, f64, f64, f64, u64)>(cb);
  f(id, lx, ly, gx, gy, btn);
}

entry fn __tur_cb_ptr2(cb: opaque, a: u64, b: u64, lx: f64, ly: f64, gx: f64, gy: f64, btn: u64) {
  let f = opaque.downcast<fn(u64, u64, f64, f64, f64, f64, u64)>(cb);
  f(a, b, lx, ly, gx, gy, btn);
}

// The lazy builders (branch builders / Each / LazyList / LazyGrid /
// Table) — face-called WITH an answer (the built view) during flush. The
// zero-arg entry drives the Condition/Switch branch factories: the
// builder is invoked at activation and re-invoked at every re-activation
// (fresh read of live state).
entry fn __tur_cb_build0(cb: opaque) -> View {
  let f = opaque.downcast<fn() -> View>(cb);
  return f();
}

entry fn __tur_cb_build1(cb: opaque, i: u64) -> View {
  let f = opaque.downcast<fn(u64) -> View>(cb);
  return f(i);
}

entry fn __tur_cb_build2(cb: opaque, i: u64, item: str) -> View {
  let f = opaque.downcast<fn(u64, str) -> View>(cb);
  return f(i, item);
}

entry fn __tur_cb_build2i(cb: opaque, i: u64, col: u64) -> View {
  let f = opaque.downcast<fn(u64, u64) -> View>(cb);
  return f(i, col);
}

// The derive format fns — face-called WITH an answer (the formatted str).
entry fn __tur_cb_str1(cb: opaque, v: f64) -> str {
  let f = opaque.downcast<fn(f64) -> str>(cb);
  return f(v);
}

entry fn __tur_cb_str2(cb: opaque, a: f64, b: f64) -> str {
  let f = opaque.downcast<fn(f64, f64) -> str>(cb);
  return f(a, b);
}

// ---- reactive helpers (the C8 substrate's authored face) ------------------

// Mint a derived atom: `rs_derive(fmt, dep)` — `fmt` is a fn value
// (`fn(v: f64) -> str`) invoked through the guarded face on every
// materialization. (The row underneath is `rs_derive_cb` — the box rail.)
pub fn rs_derive(fmt: fn(f64) -> str, dep: u64) -> u64 {
  return rs_derive_cb(opaque(fmt), dep);
}

// The two-dep twin: `fn(a: f64, b: f64) -> str`.
pub fn rs_derive2(fmt: fn(f64, f64) -> str, da: u64, db: u64) -> u64 {
  return rs_derive2_cb(opaque(fmt), da, db);
}

// Watch an atom: every change queues an intent into `cb` (a fn value with
// the click shape); `report` crosses as the callback's first argument.
pub fn rs_watch(atom: u64, cb: fn(u64, u64, f64), report: u64) -> opaque {
  return rs_watch_cb(atom, opaque(cb), report);
}

// ---- the mutation rail (M1 + the generic unification): source / derive /
// mutate + the ctxs ---------------------------------------------------------
//
// Boa's reactive triad, typed and GENERIC: `source<T>(v)` mints a
// `Readable<T>`, `derive<T>(fn (ctx: DeriveCtx) -> T)` mints a derived
// `Readable<T>` (dependency auto-tracking through the ctx reads), and
// `mutate<A>(fn (ctx: MutationCtx, a: A) { ... })` mints the queued
// mutation the handler pads store — invoked at the flush's mutation pass
// with a fresh `MutationCtx`, never synchronously inside the gesture
// dispatch. The kind NEVER rides a method or constructor name — the
// angle-bracket type argument at the call site is the whole law (the
// per-kind minters and classes of the earlier spikes are gone).
//
// The mechanism is the boxed rail: the kit boxes the value or fn
// (`opaque(..)` — the erasure box), the engine rows decode the box into
// the SAME native KV variant the typed rows store (so every existing
// engine-side read keeps working), and the recovery is `unopaque<T>` —
// the erasure inverse — inside the generic bodies (rut monomorphizes
// generics per instantiation, so T is concrete there; the dispatch
// entries recover the SEALED fns through fixed-type wrappers the mints
// build — one wrapper type per rail, never a per-kind spelling).
// `ctx.run<A>(m, a)` QUEUES the invocation (rut's no-reentrancy law: a
// mutation body runs inside a face call, so a nested synchronous
// invocation would re-borrow the VM; composition reads its effects
// through sources). Writing a derived atom is a checked error (the put
// rejects it through the error rail) — the write-side law.

// The derive-seal tags (the dispatch entry's return kind) and the
// mutate-seal tags (the payload shape) — mirroring
// `rut_runtime::seal_tags` (one law, two spellings). The BOX tags are
// the generic lanes: the wrapper returns / receives an erased box and
// the kit's probe entries recover the kind + the typed value.
let TAG_F64: u64 = 0;
let TAG_STR: u64 = 1;
let TAG_BOOL: u64 = 2;
let TAG_BOX: u64 = 3;
let SEAL_NIL: u64 = 0;
let SEAL_PTR: u64 = 1;
let SEAL_F64: u64 = 2;
let SEAL_ENTER: u64 = 3;
let SEAL_EXIT: u64 = 4;
let SEAL_KEY: u64 = 5;
let SEAL_INPUT: u64 = 6;
let SEAL_FOCUS: u64 = 7;
let SEAL_BLUR: u64 = 8;
let SEAL_MOUNT: u64 = 9;
let SEAL_BYTES: u64 = 10;
let SEAL_BOX: u64 = 11;

// The boxed rail's number stamps (the engine's `rs_box_stamp` answers —
// the KV holds ONE number variant, so the mint reports the width and the
// read re-stamps the recovered box to match).
let STAMP_NUM_F64: u64 = 1;
let STAMP_NUM_U64: u64 = 2;

// The reactive INTERFACES (the plan's hierarchy — the kind rides the
// CLASS, never the method name): any type with the members satisfies
// structurally (rut 442a979: no `impl I for T` — the inherent impl IS
// the satisfaction).
interface Readable<T> {
  fn get(self) -> T;
  fn atom_id(self) -> u64;
  fn is_derived(self) -> bool;
}

// The write face — sources satisfy it; StaticValue (the literal lane)
// does NOT, so `ctx.set` rejects literals at compile time (the
// write-side law, typed).
interface Writable<T> {
  fn put(self, v: T) -> nil;
}

// A RUNNABLE mutation (nil / typed-arg shapes): `ctx.run<A>`'s param.
// `seal(tag)` is the pad-facing install half — the pad method knows its
// payload shape and seals the USER fn under that shape's tag (the tag is
// data spelled at the pad, never a type-directed dispatch).
interface Mutation<A> {
  fn atom_id(self) -> u64;
  fn seal(self, tag: u64) -> u64;
  fn invoke(self, h: opaque, a: A) -> nil;
}

// The ONE generic source class: `h` is the store-bridge marker the rows
// route through; `atom` the raw id; `derived` selects the bind row for
// the reactive props (a derived atom's channel resolves through the
// derive rail); `stamp` the number lane's width (the boxed rail's one
// KV collapse — see `source<T>`). `source<T>` mints writable,
// `derive<T>` derived — ONE class, both mints share it. The reads and
// writes ride the boxed rows; `unopaque<T>` recovers the typed value.
pub class Source<T> {
  h: opaque;
  atom: u64;
  derived: bool;
  stamp: u64;
}

impl<T> Source<T> {
  [constructor] pub fn of(h: opaque, atom: u64, derived: bool, stamp: u64) -> Self {
    return Self { h: h, atom: atom, derived: derived, stamp: stamp };
  }
  pub fn get(self) -> T {
    return unopaque<T>(ctx_get_box(self.h, self.atom, self.stamp));
  }
  pub fn put(self, v: T) -> nil {
    ctx_set_box(self.h, self.atom, opaque(v));
  }
  pub fn atom_id(self) -> u64 {
    return self.atom;
  }
  pub fn is_derived(self) -> bool {
    return self.derived;
  }
}

// The literal lane (the next pass's prop unification): a plain value
// boxed as a readable. NOT Writable — `ctx.set` rejects it at compile
// time. `sv(v)` mints it with plain inference.
pub class StaticValue<T> {
  value: T;
}

impl<T> StaticValue<T> {
  [constructor] pub fn of(v: T) -> Self {
    return Self { value: v };
  }
  pub fn get(self) -> T {
    return self.value;
  }
  pub fn atom_id(self) -> u64 {
    return 0;
  }
  pub fn is_derived(self) -> bool {
    return false;
  }
}

pub fn sv<T>(v: T) -> StaticValue<T> {
  return StaticValue<T>.of(v);
}

// The ONE generic mutation class. `f` is the USER fn's box (the pad
// seals stamp its exact per-A type — the entries downcast it verbatim);
// `run_atom` is the composition atom, sealed eagerly from the fixed-type
// wrapper `wrap` (the drain's BOX lane hands it the boxed arg and the
// wrapper recovers A with `unopaque<A>`). Bodies QUEUE the invocation
// (the VM's no-reentrancy law: a mutation body runs inside a face call).
pub class MutationOf<A> {
  f: opaque;
  wrap: opaque;
  run_atom: u64;
}

impl<A> MutationOf<A> {
  [constructor] pub fn of(f: opaque, wrap: opaque, run_atom: u64) -> Self {
    return Self { f: f, wrap: wrap, run_atom: run_atom };
  }
  pub fn atom_id(self) -> u64 {
    return self.run_atom;
  }
  // The pad-facing install: seal the USER fn under the pad's payload
  // shape (the tag is the pad method's own const).
  pub fn seal(self, tag: u64) -> u64 {
    return mutate_seal(self.f, tag);
  }
  // Composition QUEUES the boxed invocation (the drain's BOX lane).
  pub fn invoke(self, h: opaque, a: A) -> nil {
    ctx_run_box(h, self.run_atom, opaque(a));
  }
}

// The mutations' ctx (boa's `StoreCtx`): read, write, compose — GENERIC
// (`ctx.get<T>` / `ctx.set<T>` / `ctx.run<A>`; angle-bracket type args at
// the call site — the user-surface law; the kind never rides a method
// name). The per-kind knowledge lives in the handles; the ctx bodies are
// three one-liners.
pub class MutationCtx {
  h: opaque;
}

impl MutationCtx {
  [constructor] pub fn over(h: opaque) -> Self {
    return Self { h: h };
  }
  pub fn get<T>(self, r: Readable<T>) -> T {
    return r.get();
  }
  pub fn set<T>(self, s: Writable<T>, v: T) -> nil {
    s.put(v);
  }
  // Composition QUEUES (the VM's no-reentrancy law: a mutation body runs
  // inside a face call; effects read through sources — boa's
  // `ctx.set(navigateToRoot)` shape, deferred).
  pub fn run<A>(self, m: Mutation<A>, a: A) -> nil {
    m.invoke(self.h, a);
  }
}

// The derives' ctx (boa's `ReadonlyStoreCtx`): reads only.
pub class DeriveCtx {
  h: opaque;
}

impl DeriveCtx {
  [constructor] pub fn over(h: opaque) -> Self {
    return Self { h: h };
  }
  pub fn get<T>(self, r: Readable<T>) -> T {
    return r.get();
  }
}

// The task-scoped ctx: a suspended task's own handle — the mutation
// pass's ctx is pass-scoped and must never leak into a task, so `spawn`
// call sites mint one. Its `get`/`set` work across `await`s; composition
// is deferred (the M1 spike: a task spawns a fresh task instead).
pub class TaskCtx {
  h: opaque;
}

impl TaskCtx {
  [constructor] pub fn mint() -> Self {
    return Self { h: ctx_bridge() };
  }
  pub fn get<T>(self, r: Readable<T>) -> T {
    return r.get();
  }
  pub fn set<T>(self, s: Writable<T>, v: T) -> nil {
    s.put(v);
  }
}

// Mint a source atom (`boa: source<T>(value)`): the value crosses boxed,
// the engine decodes it into the same native KV variant the typed rows
// store (existing engine-side reads unchanged), and the stamp records
// the number lane's width so `get` re-stamps the recovered box
// losslessly (u64 brush atoms vs f64 counts — the KV's one collapse).
// The mint answers the CONCRETE class: it satisfies `Readable<T>` and
// `Writable<T>` both (the iface objects track no concrete origin, so the
// write face must flow unboxed); `let r: Readable<T> = source<T>(..)`
// coerces at the annotation as usual.
pub fn source<T>(v: T) -> Source<T> {
  let b = opaque(v);
  let atom = rs_source_box(b);
  let stamp = rs_box_stamp(b);
  return Source<T>.of(ctx_bridge(), atom, false, stamp);
}

// Mint a derived atom whose fn reads through the ctx — dependencies
// auto-track (boa's `derive<T>((ctx) => ctx.get(x$))`). The fixed-type
// wrapper calls the user fn and returns the result boxed; the drain's
// BOX lane recovers kind + value through the kit's probe entries.
pub fn derive<T>(f: fn(DeriveCtx) -> T) -> Source<T> {
  let wrap = fn (ctx: DeriveCtx) -> opaque {
    return opaque(f(ctx));
  };
  return Source<T>.of(ctx_bridge(), derive_seal(opaque(wrap), TAG_BOX), true, STAMP_NUM_F64);
}

// Mint a mutation (`boa: mutate<A>((ctx, a) => ...)`): the engine
// invokes the fn at the flush's mutation pass with a fresh
// `MutationCtx`. The class stores the user fn's box (the pads seal it
// under their payload shape) and an eagerly-sealed composition atom over
// the fixed-type wrapper (what `ctx.run<A>` drains). A = nil is the
// arity-1-looks-like `fn (ctx: MutationCtx, _e: nil)` click shape — one
// fn-type law for every payload. The mint answers the INTERFACE: the
// box records its itable at the mint's own boxing site (the fill was
// proved there — the kit's table), and the itable rides the value.
pub fn mutate<A>(f: fn(MutationCtx, A)) -> Mutation<A> {
  let wrap = fn (ctx: MutationCtx, b: opaque) {
    f(ctx, unopaque<A>(b));
  };
  let run_atom = mutate_seal(opaque(wrap), SEAL_BOX);
  return MutationOf<A>.of(opaque(f), opaque(wrap), run_atom);
}

// The async launch rail: the future binds its handle params at the launch
// site (`spawn(work(TaskCtx.mint(), src, ...))` — async fns have no fn
// values in this build, so the launch IS the call) and the ctx is
// task-scoped (minted at the launch site — `TaskCtx.mint()`).
pub class Task {
  h: ?opaque;
}

impl Task {
  [constructor] pub fn of(h: ?opaque) -> Self {
    return Self { h: h };
  }
}

pub fn spawn<T>(f: Future<T>) -> Task {
  return Task.of(opaque(launch_future<T>(f)));
}

// ---- the event value prelude (M1: the gesture family) ---------------------

enum MouseButton {
  Left,
  Right,
  Middle,
  None,
}

// The engine's button crossing code → the enum (0 primary, 1 middle,
// 2 the context menu's right button).
pub fn mouse_button_of(v: u64) -> MouseButton {
  if (v == 1) {
    return MouseButton.Middle;
  }
  if (v == 2) {
    return MouseButton.Right;
  }
  return MouseButton.Left;
}

class Point {
  x: f64;
  y: f64;
}

impl Point {
  [constructor] pub fn at(x: f64, y: f64) -> Self {
    return Self { x: x, y: y };
  }
}

// One typed event for the whole gesture family (boa's single
// `PointerInteractEvent`): nested Points, reads spell `ev.global.x`.
class PointerEvent {
  local: Point;
  global: Point;
  button: MouseButton;
}

impl PointerEvent {
  [constructor] pub fn of(local: Point, global: Point, button: MouseButton) -> Self {
    return Self { local: local, global: global, button: button };
  }
}

// The region pair (MouseRegion's onEnter / onExit) — positions only.
pub class EnterEvent {
  local: Point;
  global: Point;
}

impl EnterEvent {
  [constructor] pub fn of(local: Point, global: Point) -> Self {
    return Self { local: local, global: global };
  }
}

pub class ExitEvent {
  local: Point;
  global: Point;
}

impl ExitEvent {
  [constructor] pub fn of(local: Point, global: Point) -> Self {
    return Self { local: local, global: global };
  }
}

// The input event (the editable's every keystroke / IME commit): the
// fresh text + whether Enter delivered it.
pub class InputEvent {
  value: str;
  enter: bool;
}

impl InputEvent {
  [constructor] pub fn of(value: str, enter: bool) -> Self {
    return Self { value: value, enter: enter };
  }
}

// The key event (Focusable's onKeyDown): the platform key + code and the
// modifier bitmask (bit0 shift / bit1 ctrl / bit2 alt / bit3 meta).
pub class KeydownEvent {
  key: str;
  code: str;
  modifiers: u64;
}

impl KeydownEvent {
  [constructor] pub fn of(key: str, code: str, modifiers: u64) -> Self {
    return Self { key: key, code: code, modifiers: modifiers };
  }
}

// The payload-less events (the focus lifecycle + mount). They are TYPED
// so a handler's fn signature names its surface; the fields are empty.
pub class FocusEvent {
}

impl FocusEvent {
  [constructor] pub fn of() -> Self {
    return Self { };
  }
}

pub class BlurEvent {
}

impl BlurEvent {
  [constructor] pub fn of() -> Self {
    return Self { };
  }
}

pub class MountEvent {
}

impl MountEvent {
  [constructor] pub fn of() -> Self {
    return Self { };
  }
}

// ---- the mutation rail's dispatch entries (the fire half) -----------------
//
// The sealed mutation's Rust closure face-calls these with the sealed fn
// box + the bridge marker + the payload; the entry constructs the ctx
// (+ the typed event) — rut-side, per the layering law — and calls the
// user's typed fn. One entry per payload shape; the arities are the
// mutation pass's contract (`mutation_entries` in rut_runtime).

entry fn __tur_cb_mnil(cb: opaque, h: opaque) {
  let f = opaque.downcast<fn(MutationCtx, nil)>(cb);
  f(MutationCtx.over(h), nil);
}

entry fn __tur_cb_mptr(cb: opaque, h: opaque, lx: f64, ly: f64, gx: f64, gy: f64, btn: u64) {
  let f = opaque.downcast<fn(MutationCtx, PointerEvent)>(cb);
  f(MutationCtx.over(h), PointerEvent.of(Point.at(lx, ly), Point.at(gx, gy), mouse_button_of(btn)));
}

entry fn __tur_cb_mf64(cb: opaque, h: opaque, a: f64) {
  let f = opaque.downcast<fn(MutationCtx, f64)>(cb);
  f(MutationCtx.over(h), a);
}

// The boxed composition lane: the drain hands the erasure box the kit's
// `invoke` built; the SEALED box is the mint's fixed-type wrapper, which
// recovers A and calls the user fn. One entry for every A.
entry fn __tur_cb_mbox(cb: opaque, h: opaque, b: opaque) {
  let f = opaque.downcast<fn(MutationCtx, opaque)>(cb);
  f(MutationCtx.over(h), b);
}

entry fn __tur_cb_menter(cb: opaque, h: opaque, lx: f64, ly: f64, gx: f64, gy: f64) {
  let f = opaque.downcast<fn(MutationCtx, EnterEvent)>(cb);
  f(MutationCtx.over(h), EnterEvent.of(Point.at(lx, ly), Point.at(gx, gy)));
}

entry fn __tur_cb_mexit(cb: opaque, h: opaque, lx: f64, ly: f64, gx: f64, gy: f64) {
  let f = opaque.downcast<fn(MutationCtx, ExitEvent)>(cb);
  f(MutationCtx.over(h), ExitEvent.of(Point.at(lx, ly), Point.at(gx, gy)));
}

entry fn __tur_cb_mkey(cb: opaque, h: opaque, key: str, code: str, mods: u64) {
  let f = opaque.downcast<fn(MutationCtx, KeydownEvent)>(cb);
  f(MutationCtx.over(h), KeydownEvent.of(key, code, mods));
}

entry fn __tur_cb_minput(cb: opaque, h: opaque, value: str, enter: bool) {
  let f = opaque.downcast<fn(MutationCtx, InputEvent)>(cb);
  f(MutationCtx.over(h), InputEvent.of(value, enter));
}

entry fn __tur_cb_mfocus(cb: opaque, h: opaque) {
  let f = opaque.downcast<fn(MutationCtx, FocusEvent)>(cb);
  f(MutationCtx.over(h), FocusEvent.of());
}

entry fn __tur_cb_mblur(cb: opaque, h: opaque) {
  let f = opaque.downcast<fn(MutationCtx, BlurEvent)>(cb);
  f(MutationCtx.over(h), BlurEvent.of());
}

entry fn __tur_cb_mmount(cb: opaque, h: opaque) {
  let f = opaque.downcast<fn(MutationCtx, MountEvent)>(cb);
  f(MutationCtx.over(h), MountEvent.of());
}

entry fn __tur_cb_mbytes(cb: opaque, h: opaque, data: bytes) {
  let f = opaque.downcast<fn(MutationCtx, bytes)>(cb);
  f(MutationCtx.over(h), data);
}

entry fn __tur_cb_derive_f64(cb: opaque, h: opaque) -> f64 {
  let f = opaque.downcast<fn(DeriveCtx) -> f64>(cb);
  return f(DeriveCtx.over(h));
}

entry fn __tur_cb_derive_str(cb: opaque, h: opaque) -> str {
  let f = opaque.downcast<fn(DeriveCtx) -> str>(cb);
  return f(DeriveCtx.over(h));
}

entry fn __tur_cb_derive_bool(cb: opaque, h: opaque) -> bool {
  let f = opaque.downcast<fn(DeriveCtx) -> bool>(cb);
  return f(DeriveCtx.over(h));
}

// ---- the boxed derive lane (the GENERIC surface) ---------------------------
//
// The mint seals the fixed-type wrapper (`fn(DeriveCtx) -> opaque`, the
// user fn captured); the drain calls it, then recovers kind + value
// through these probes (the drain closure holds no VM, so the unbox runs
// rut-side). The kinds are the drain's contract — `BOX_KIND_*` in
// rut_runtime (one law, two spellings).

entry fn __tur_cb_derive_box(cb: opaque, h: opaque) -> opaque {
  let f = opaque.downcast<fn(DeriveCtx) -> opaque>(cb);
  return f(DeriveCtx.over(h));
}

entry fn __tur_cb_derive_kind(b: opaque) -> u64 {
  if (opaque.downcast<f64>(b) != nil) {
    return 1;
  }
  if (opaque.downcast<str>(b) != nil) {
    return 2;
  }
  if (opaque.downcast<bool>(b) != nil) {
    return 3;
  }
  if (opaque.downcast<u64>(b) != nil) {
    return 4;
  }
  return 0;
}

entry fn __tur_cb_unbox_f64(b: opaque) -> f64 {
  return unopaque<f64>(b);
}

entry fn __tur_cb_unbox_str(b: opaque) -> str {
  return unopaque<str>(b);
}

entry fn __tur_cb_unbox_bool(b: opaque) -> bool {
  return unopaque<bool>(b);
}

entry fn __tur_cb_unbox_u64(b: opaque) -> u64 {
  return unopaque<u64>(b);
}

