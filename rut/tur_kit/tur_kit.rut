class Table {
  spec: opaque;
}

impl Table {
  [constructor] pub fn builder() -> Self {
    return Self { spec: table_new() };
  }
  pub fn columns(mut self, cols: TableCols) -> Self {
    table_columns(self.spec, cols.spec);
    return self;
  }
  pub fn rows_atom(mut self, r: Readable<opaque>) -> Self {
    table_rows_atom(self.spec, r.atom_id());
    return self;
  }
  pub fn row_builder(mut self, cb: fn(u64, u64) -> View) -> Self {
    table_row_builder(self.spec, opaque(cb));
    return self;
  }
  pub fn header_builder(mut self, cb: fn(u64) -> View) -> Self {
    table_header_builder(self.spec, opaque(cb));
    return self;
  }
  // Declarative row stripes painted by the element itself (never the
  // cells): `even` fills even body rows, `odd` fills odd ones. Pass
  // 0x00000000 for "keep the frame showing through" on a parity.
  pub fn stripes(mut self, even: u64, odd: u64) -> Self {
    table_stripe(self.spec, even, odd);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    table_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> View {
    return View(table_build(self.spec));
  }
}

// ---- control flow (Switch / Condition / Each / Fragment) ---------------------

class Switch {
  spec: opaque;
}

impl Switch {
  [constructor] pub fn builder() -> Self {
    return Self { spec: switch_new() };
  }
  // The ONE reactive value prop: the handle's kind selects the row
  // (source binds directly, a derived through the derive rail).
  pub fn value(mut self, r: Readable<str>) -> Self {
    if (r.is_derived()) {
      switch_value_derived(self.spec, r.atom_id());
    } else {
      switch_value_source(self.spec, r.atom_id());
    }
    return self;
  }
  // Appends one case — the historical `cases` prop's crossing (`case` is
  // a reserved word in rut).
  pub fn cases(mut self, key: str, branch: View) -> Self {
    switch_case(self.spec, key, branch.inner);
    return self;
  }
  // The lazy case twin: the branch is a FN VALUE, invoked when the key
  // activates (fresh read of live state).
  pub fn case_build(mut self, key: str, cb: fn() -> View) -> Self {
    switch_case_build(self.spec, key, opaque(cb));
    return self;
  }
  pub fn fallback(mut self, branch: View) -> Self {
    switch_fallback(self.spec, branch.inner);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    switch_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> View {
    return View(switch_build(self.spec));
  }
}

class Condition {
  spec: opaque;
}

impl Condition {
  [constructor] pub fn builder(r: Readable<bool>) -> Self {
    return Self { spec: cond_new(r.atom_id()) };
  }
  pub fn then(mut self, branch: View) -> Self {
    cond_then(self.spec, branch.inner);
    return self;
  }
  pub fn else_branch(mut self, branch: View) -> Self {
    cond_else(self.spec, branch.inner);
    return self;
  }
  // The lazy twins: the branch is a FN VALUE (`fn() -> View`), invoked
  // at activation and re-invoked at every re-activation — the built
  // subtree reads LIVE state each time it mounts (the boa callback
  // semantic; e.g. a modal reads the draft at open time).
  pub fn then_build(mut self, cb: fn() -> View) -> Self {
    cond_then_build(self.spec, opaque(cb));
    return self;
  }
  pub fn else_build(mut self, cb: fn() -> View) -> Self {
    cond_else_build(self.spec, opaque(cb));
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    cond_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> View {
    return View(cond_build(self.spec));
  }
}

class Each {
  spec: opaque;
}

impl Each {
  [constructor] pub fn builder(r: Readable<opaque>) -> Self {
    return Self { spec: each_new(r.atom_id()) };
  }
  pub fn item_builder(mut self, cb: fn(u64, str) -> View) -> Self {
    each_builder(self.spec, opaque(cb));
    return self;
  }
  pub fn build(self) -> View {
    return View(each_build(self.spec));
  }
}

class Fragment {
  spec: opaque;
}

impl Fragment {
  [constructor] pub fn builder() -> Self {
    return Self { spec: frag_new() };
  }
  pub fn child(mut self, c: View) -> Self {
    frag_child(self.spec, c.inner);
    return self;
  }
  pub fn children(mut self, cs: [View]) -> Self {
    for (let c of cs) {
      frag_child(self.spec, c.inner);
    }
    return self;
  }
  pub fn build(self) -> View {
    return View(frag_build(self.spec));
  }
}

// ---- image + virtual app + lifecycle ------------------------------------------

class Image {
  spec: opaque;
}

impl Image {
  [constructor] pub fn builder(res: u64) -> Self {
    return Self { spec: img_new(res) };
  }
  pub fn width(mut self, v: f64) -> Self {
    img_width(self.spec, v);
    return self;
  }
  pub fn height(mut self, v: f64) -> Self {
    img_height(self.spec, v);
    return self;
  }
  pub fn fit(mut self, v: BoxFit) -> Self {
    img_fit(self.spec, box_fit_code(v));
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    img_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> View {
    return View(img_build(self.spec));
  }
}

class VirtualApp {
  spec: opaque;
}

impl VirtualApp {
  [constructor] pub fn builder() -> Self {
    return Self { spec: va_new() };
  }
  pub fn controller(mut self, c: VAppCtrl) -> Self {
    va_controller_set(self.spec, c.raw());
    return self;
  }
  pub fn bind(mut self, atom: u64) -> Self {
    va_bind(self.spec, atom);
    return self;
  }
  pub fn width_height(mut self, w: f64, h: f64) -> Self {
    va_size(self.spec, w, h);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    va_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> View {
    return View(va_build(self.spec));
  }
}

class Lifecycle {
  spec: opaque;
}

impl Lifecycle {
  [constructor] pub fn builder() -> Self {
    return Self { spec: lc_new() };
  }
  pub fn on_mount(mut self, m: Mutation<MountEvent>) -> Self {
    lc_on_mount(self.spec, m.seal(SEAL_MOUNT));
    return self;
  }
  pub fn before_destroy(mut self, cb: fn(u64, u64, f64)) -> Self {
    lc_before_destroy(self.spec, opaque(cb));
    return self;
  }
  pub fn child(mut self, c: View) -> Self {
    lc_child(self.spec, c.inner);
    return self;
  }
  pub fn build(self) -> View {
    return View(lc_build(self.spec));
  }
}

// ---- composited target / follower ------------------------------------------------

class CompositedTarget {
  spec: opaque;
}

impl CompositedTarget {
  [constructor] pub fn builder() -> Self {
    return Self { spec: ct_target_new() };
  }
  pub fn link(mut self, l: LinkCtrl) -> Self {
    ct_target_link(self.spec, l.inner);
    return self;
  }
  pub fn child(mut self, c: View) -> Self {
    ct_target_child(self.spec, c.inner);
    return self;
  }
  pub fn build(self) -> View {
    return View(ct_target_build(self.spec));
  }
}

class CompositedFollower {
  spec: opaque;
}

impl CompositedFollower {
  [constructor] pub fn builder() -> Self {
    return Self { spec: ct_follower_new() };
  }
  pub fn link(mut self, l: LinkCtrl) -> Self {
    ct_follower_link(self.spec, l.inner);
    return self;
  }
  pub fn target_anchor(mut self, v: Align) -> Self {
    ct_follower_target_anchor(self.spec, align_code(v));
    return self;
  }
  // The reactive anchor (the composited-transform corpus's reactive
  // anchor rail).
  pub fn target_anchor_bound(mut self, r: Readable<f64>) -> Self {
    ct_follower_target_anchor_bound(self.spec, r.atom_id());
    return self;
  }
  pub fn follower_anchor(mut self, v: Align) -> Self {
    ct_follower_follower_anchor(self.spec, align_code(v));
    return self;
  }
  pub fn offset(mut self, x: f64, y: f64) -> Self {
    ct_follower_offset(self.spec, x, y);
    return self;
  }
  pub fn child(mut self, c: View) -> Self {
    ct_follower_child(self.spec, c.inner);
    return self;
  }
  pub fn build(self) -> View {
    return View(ct_follower_build(self.spec));
  }
}

// ---- shared helpers ----------------------------------------------------------------

// A LayerLink (the JS `createLayerLink` twin) — the composited
// target/follower pair's shared handle. Mint with `layer_link()`.
pub class LinkCtrl(opaque);

// The structured-value data ops (the list/map builders the case code
// folds into sources; the STATE writes go through the ctx, never these).
// Minting WRAPS: the handle is nominal, the rows take `h.inner` inside
// the class methods (`.push` / `.set` / …).
pub fn list_new() -> ListHandle {
  return ListHandle(rs_list_new());
}

pub fn map_new() -> MapHandle {
  return MapHandle(rs_map_new());
}

// The raw-opaque readers (the store's read-back lane: `ctx.get<opaque>`
// recovers the structured value as a bare opaque — these take it
// directly). The handle-typed surface is the classes' methods.
pub fn value_len(v: opaque) -> u64 {
  return rs_value_len(v);
}

pub fn value_item(v: opaque, index: u64) -> str {
  return rs_value_item(v, index);
}

pub fn value_get(v: opaque, key: str) -> str {
  return rs_value_get(v, key);
}

// Mint a LayerLink for the composited target/follower pair.
pub fn layer_link() -> LinkCtrl {
  return LinkCtrl(ct_link_new());
}

// Register an encoded image resource (PNG/JPEG) — the `createImageResource`
// twin.
pub fn image_resource_bytes(bytes: bytes) -> u64 {
  return img_res_bytes(bytes);
}

// A synthetic solid RGBA image resource (fixture-friendly).
pub fn image_resource_solid(w: u64, h: u64, packed: u64) -> u64 {
  return img_res_solid(w, h, packed);
}

// Rasterise an SVG string into an image resource (the todolist /
// github-viewer icon rail).
pub fn image_resource_svg(src: str) -> u64 {
  return img_res_svg(src);
}

// str -> f64 parse (0 on failure) — the edit-field confirm path.
pub fn str_parse_f64(s: str) -> f64 {
  return str_parse_f64_raw(s);
}

// Trig helpers (f64 radians in/out) — the pure-math rows the orbit /
// wave shapes feed a progress atom through.
pub fn math_sin(x: f64) -> f64 {
  return math_sin_raw(x);
}

pub fn math_cos(x: f64) -> f64 {
  return math_cos_raw(x);
}

// Register a string-authored child module source with the virtual-app
// subsystem — the `createModuleSource` twin.
pub fn virtual_app_source(src: str) -> VAppSource {
  return VAppSource(va_create_source(src));
}

// Lift a Rust-registered source id (e.g. the u64 the `pg_compile` row
// answers) into the source handle — Rust-defined sources enter the realm
// as plain u64s.
pub fn virtual_app_source_handle(id: u64) -> VAppSource {
  return VAppSource(va_source_handle(id));
}

// Mint an EMPTY (Nil) controller-ref atom for the reactive `app$` binding
// (`VirtualApp.bind(atom)` + `virtual_app_set` / `virtual_app_clear`
// swaps).
pub fn virtual_app_atom() -> u64 {
  return va_app_atom();
}

// Swap the reactive `app$` binding to a controller (the mounted
// VirtualAppView rebinds in the same flush).
pub fn virtual_app_set(atom: u64, ctrl: VAppCtrl) {
  va_app_set(atom, ctrl.raw());
}

// Clear the reactive `app$` binding.
pub fn virtual_app_clear(atom: u64) {
  va_app_clear(atom);
}

// Mint a virtual-app controller from a registered source — the
// `createVirtualAppController` twin.
pub fn virtual_app_controller(src: VAppSource) -> VAppCtrl {
  return VAppCtrl(va_controller(src.inner));
}
