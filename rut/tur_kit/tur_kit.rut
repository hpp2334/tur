// ---- gesture family (PointerInteract / MouseRegion / Focusable) -------------

class PointerInteract {
  spec: opaque;
}

impl PointerInteract {
  [constructor] pub fn builder() -> Self {
    return Self { spec: pi_new() };
  }
  // ---- the mutation surface (boa's names, snake_cased) ------------------
  //
  // Handlers are MUTATIONS over the MutationCtx (`on_click(mutate(...))`);
  // the gesture dispatch enqueues the invocation and the flush's mutation
  // pass invokes the fn with a fresh ctx — never synchronously. State
  // binds by closure (the mutation captures its sources), events flow by
  // the typed `PointerEvent` argument — no id args.
  pub fn on_click(mut self, m: Mutation<nil>) -> Self {
    pi_on_click(self.spec, m.seal(SEAL_NIL));
    return self;
  }
  pub fn on_pointer_down(mut self, m: Mutation<PointerEvent>) -> Self {
    pi_mut_down(self.spec, m.seal(SEAL_PTR));
    return self;
  }
  pub fn on_pointer_move(mut self, m: Mutation<PointerEvent>) -> Self {
    pi_mut_move(self.spec, m.seal(SEAL_PTR));
    return self;
  }
  pub fn on_pointer_up(mut self, m: Mutation<PointerEvent>) -> Self {
    pi_mut_up(self.spec, m.seal(SEAL_PTR));
    return self;
  }
  pub fn on_context_menu(mut self, m: Mutation<PointerEvent>) -> Self {
    pi_on_context_menu(self.spec, m.seal(SEAL_PTR));
    return self;
  }
  pub fn behavior(mut self, v: HitTestBehavior) -> Self {
    pi_behavior(self.spec, hit_test_code(v));
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    pi_qkey(self.spec, k);
    return self;
  }
  pub fn child(mut self, c: View) -> Self {
    pi_child(self.spec, c.inner);
    return self;
  }
  pub fn build(self) -> View {
    return View(pi_build(self.spec));
  }
}

