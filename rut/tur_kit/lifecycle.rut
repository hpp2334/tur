// lifecycle.rut — the lifecycle family (Lifecycle).
// Split file 15/17 of tur_kit (the splice order IS rut.jsonc's
// entry.lib + entry.libs).

class Lifecycle {
  spec: opaque;
}

impl Lifecycle {
  [constructor] pub fn builder() -> Self {
    return Self { spec: lc_new() };
  }
  pub fn on_mount(mut self, m: Mutation<MountEvent>) -> Self {
    lc_on_mount(self.spec, m.seal(SEAL_MOUNT));
    return self;
  }
  pub fn before_destroy(mut self, cb: fn(u64, u64, f64)) -> Self {
    lc_before_destroy(self.spec, opaque(cb));
    return self;
  }
  pub fn child(mut self, c: View) -> Self {
    lc_child(self.spec, c.inner);
    return self;
  }
  pub fn build(self) -> View {
    return View(lc_build(self.spec));
  }
}

