// handles.rut — the kit's module head: the nominal handles + the mount
// door + the shared value/math helpers. The kit is a MULTI-FILE module:
// rut.jsonc's entry.lib + entry.libs list the files and their splice
// order (one module, one namespace), and the engine embed joins the same
// list '\n'-joined (the tur_host_decl pin test diffs the two).

// tur_kit — the authored element-construction surface (the kit).
//
// ONE wrapper class per element over its family's `tur` host-pkg rows:
// chainable methods (ONE METHOD PER PROP, named after the historical
// camelCase props in snake_case), `.child(c)` / `.children([...])`
// appending, and `.build()` as the ONLY terminal (each class's build calls
// its FAMILY's build row — `Column.build()` → `flex_build`, …).
//
// Construction law: build with the class call form — `Column()` /
// `SizedBox(400.0, 200.0)` — over each class's `[constructor] fn
// builder()` (the `.builder()` long form stays valid — byte-identical
// lowering), and CHAIN it: `let c = X().prop(..).child(..);` — never
// `let mut c` + `c.prop(..);` statement runs.
//
// Handler law: GESTURE handlers are MUTATIONS over the MutationCtx —
// `on_click(mutate(fn (ctx: MutationCtx, _e: nil) { ctx.set(x, v); }))`
// (the triad: source / derive / mutate, M1; A = nil is the click shape —
// one fn-type law for every payload). The kit seals the user fn into an
// opaque box and hands the ROW only the box; the flush's mutation pass
// invokes it through the dispatch entries (dispatch.rut) with a fresh ctx
// (queued — never synchronously inside the gesture dispatch). The remaining
// fn-value callback props (on_tap / on_input / on_enter …) keep the
// sealing law — a named `fn` or anonymous literal, sealed into an opaque
// box, fired back through the dispatch entries — until the M2 sweep
// converts them to their typed events. The arity/type check happens at
// THIS boundary, at compile time. Nothing callable crosses the boundary
// as a string. `View` is the user-facing view newtype.
//
// Reactive law: ONE prop per reactive-capable name over `Readable<T>`
// (`text(r)`, `color(r)`, `width(r)`, `flex(r)`, `obscure(r)`, …) with a
// param-type sugar overload for the literal (`text("hi")`,
// `color(0xFF'u64)`); the `*_bound` twins are the phase-5 migrants (the
// test snippets still spell them — thin delegates over the unified
// props). The literal lane is `StaticValue<T>` (`sv(v)`) for the props
// without a sugar overload. Sources / derives mint through
// `source<T>(v)` / `derive<T>(fn (ctx: DeriveCtx) -> T)`; ALL reads and
// writes flow through the ctxs (`DeriveCtx` get-only, `MutationCtx`
// get + set + run) — the handles carry NO public getter (there is no
// current store getter).
//
// Flag law: every flag family is a NAME-ONLY enum (`Align`, `MainAlign`,
// `CrossAlign`, `MainAxisSize`, `Clip`, `BorderPosition`, `Axis`,
// `BoxFit`, `StackFit`, `FlexFit`, `Cursor`, `HitTest`, `SpanFlags`) —
// no explicit int values. The private exhaustive `when` mappers (`code`)
// are the SOLE carriers of the row codes (verbatim from the Rust
// consts); kit methods take the enum and unwrap once at the row
// (`flex_main_align(self.spec, code(v))`). Cross-family misuse is a
// compile error. The `tur_host` u64 consts stay pushed for the phase-5
// test migration; the raw-const method overloads below are the same
// story.
//
// Color law: every `packed: u64` color prop (`color` / `color_bound` /
// `placeholder_color` / `cursor_color` / `border` / `shadow` / `span_add`)
// packs **`0xRRGGBBAA`** — R in bits 31..24, A in bits 7..0. An OPAQUE
// color is `0xRRGGBBFF`; passing a bare `0xRRGGBB` shifts the channels
// (it decodes as a translucent `0x00'GG'BB'??` cyan-ish wash — the law is
// pinned natively by `tests/element/color_packing_law.rs`).
//
// The kit lives OUTSIDE core/ (the layering law): core owns mechanism,
// each plugin owns its spec + rows, and this module — registered as a
// compile-session prelude by the standard bundle assembly — is the stable
// authored surface rut modules import (`use tur_kit::{ Column, … };`).
//
// Shape note: every class holds exactly ONE `spec: opaque` field (the
// family's host-side spec) — no rut-side containers; the host spec
// accumulates children through the `*_child` rows.
use tur_host::{
  box_align, box_border, box_build, box_child, box_clip, box_color, box_color_bound, box_height,
  box_height_bound, box_new, box_padding, box_qkey, box_radius, box_radius_bound, box_shadow,
  box_shadow_blur_bound, box_shadow_color_bound, box_shadow_dy_bound,
  box_size, box_width, box_width_bound,
  col_fixed, col_flex, cols_new, cond_build, cond_else, cond_else_build, cond_new, cond_qkey,
  cond_then, cond_then_build, ct_follower_build,
  ct_follower_child, ct_follower_follower_anchor, ct_follower_link, ct_follower_new,
  ct_follower_offset, ct_follower_target_anchor, ct_follower_target_anchor_bound, ct_link_new,
  ct_target_build, ct_target_child, ct_target_link, ct_target_new, each_build, each_builder,
  each_new, flex_build, flex_child, flex_column, flex_cross_align, flex_main_align,
  flex_main_size, flex_qkey, flex_row, flexi_build, flexi_child, flexi_fit, flexi_flex,
  flexi_qkey,
  focus_build, focus_child, focus_new, focus_on_blur,
  focus_on_focus, focus_on_key_down, frag_build, frag_child, frag_new, grid_aspect,
  grid_build, grid_child, grid_main_extent, grid_max_cross, grid_qkey, grid_spacing,
  img_build, img_fit, img_height, img_new, img_qkey, img_res_bytes, img_res_solid, img_width,
  input_build, input_color, input_controller, input_cursor_color, input_font_family,
  input_font_size, input_multiline, input_new, input_obscure, input_obscure_bound,
  input_obscure_char,
  input_on_input, input_placeholder, input_placeholder_bound, input_placeholder_color,
  input_qkey, input_size, input_undo, tctrl_new, tctrl_set_text, tctrl_text, undo_new,
  lazy_axis,
  lazy_build, lazy_builder, lazy_count, lazy_grid_aspect, lazy_grid_axis, lazy_grid_build,
  lazy_grid_builder, lazy_grid_count, lazy_grid_item_extent, lazy_grid_max_cross,
  lazy_grid_new, lazy_grid_overscan,
  lazy_grid_qkey, lazy_grid_spacing, lazy_item_extent, lazy_list_new, lazy_overscan, lazy_qkey, lc_before_destroy,
  lc_build, lc_child, lc_new, lc_on_mount, mount_raw, mr_build, mr_child, mr_cursor, mr_cursor_bound,
  mr_new, mr_on_enter, mr_on_exit, mr_behavior, pi_behavior, pi_build, pi_child,
  pi_mut_down, pi_mut_move, pi_mut_up,
  pi_new, pi_on_click, pi_on_context_menu,
  pi_qkey, pos_bottom, pos_build, pos_child, pos_height, pos_left, pos_left_bound, pos_new,
  pos_right, pos_top, pos_top_bound,
  pos_width, rs_list_new, rs_list_push, rs_map_new, rs_map_set,
  rs_source_value, rs_value_get, rs_value_item, rs_value_len, rs_watch_mut, scroll_axis,
  scroll_build, scroll_child,
  scroll_new, scroll_offset, scroll_qkey,
  sizedbox_build, sizedbox_child, sizedbox_new, sizedbox_qkey,
  span_add, spans_new, stack_align, stack_build, stack_child, stack_fit, stack_new, stack_qkey,
  switch_build, switch_case, switch_case_build, switch_fallback, switch_new, switch_qkey,
  switch_value_derived,
  switch_value_source, table_build, table_col_extent, table_columns, table_header_builder,
  table_new, table_qkey, table_row_builder, table_rows_atom, table_stripe, text_bind,
  text_bind_derived, text_build, text_clip, text_color, text_ellipsis, text_max_lines, text_new,
  text_overflow_visible, text_qkey, text_selectable, text_size, text_spans, text_text, text_weight,
  va_app_atom, va_app_clear, va_app_set, va_bind, va_build,
  va_controller, va_controller_set, va_destroy, va_error, va_new, va_qkey, va_size,
  va_create_source, va_source_handle, va_status, va_status_atom,
  // the pure-math / parse twins (the `mount_raw` pattern — the kit's own
  // wrapper fns shadow the row names, so their bodies reach the rows
  // through these aliases).
  math_sin_raw, math_cos_raw, str_parse_f64_raw,
  // the mutation rail (source / derive / mutate + the ctx rows).
  ctx_bridge, ctx_run_box, ctx_get_box, ctx_set_box, derive_seal, mutate_seal,
  rs_box_stamp, rs_source_box,
};

// The async launch rail's typed surface (the `futures` package rides the
// same run chain the kit compiles in).
use core::{ Future };


// The user-facing view newtype: built views cross kit signatures as
// `View` (`fn build_expanded() -> View`, `pub fn child(mut self, c: View)`).
//
// The vocabulary law: biz signatures spell WHAT a value is — views say
// `View`, handles say their type — and bare `opaque` stays infra-only
// (row decls, the dispatch entries, kit internals). `View` and the data
// handles are NOMINAL newtypes (`class X(opaque)` — the compiler-provided
// `X(v)` is the construction, the `inner` field is private), so a
// TextCtrl can never be confused with another handle and the rows they
// wrap surface as METHODS, never as raw row calls in biz code. The kit
// wraps every row answer (`View(flex_build(..))`) and unwraps every row
// arg (`c.inner`) — a raw view opaque never crosses a kit signature.
//
// Host-seam note: the compiler-provided `X(v)` ctors and the `raw()`
// hatches stay pub — their remaining consumers are the row-probe fixtures
// (the pg rails' `ctrl.raw()` erase) and complex-animation's
// replaceable-controller slot. The STASH consumers are gone (the
// context-crossing entry contract); a further privatization pass lands
// with complex-animation's AppContext restructure.
pub class View(opaque);

impl View {
  // The kit machinery's erase hatch (kit-internal — not on the pkg
  // surface): the one place a built view goes back to the raw opaque
  // the mount row takes.
  fn raw(self) -> opaque {
    return self.inner;
  }
}

// The one mount door users reach — the unwrap happens HERE, never at a
// call site (the row takes the raw RutView opaque). The body calls the
// `mount_raw` twin because this fn's own name shadows the row's.
pub fn mount(v: View) {
  mount_raw(v.raw());
}

// A structured store list (`list_new`; the `.push` / `.len` / `.item`
// method surface). The store lane still crosses as the raw opaque (the
// KV holds structured values as host opaques), so `raw()` is pub for
// the `source<opaque>(handles.raw())` crossings.
pub class ListHandle(opaque);

impl ListHandle {
  // The boxed store lane's erase (the `source<opaque>(list.raw())`
  // crossing) — stays pub: the store holds structured values as host
  // opaques, so a list into a source IS the typed shape.
  pub fn raw(self) -> opaque {
    return self.inner;
  }
  pub fn push(self, item: str) {
    rs_list_push(self.inner, item);
  }
  pub fn len(self) -> u64 {
    return rs_value_len(self.inner);
  }
  pub fn item(self, i: u64) -> str {
    return rs_value_item(self.inner, i);
  }
}

// A structured store map (`map_new`; the `.set` / `.get` / `.len`
// method surface).
pub class MapHandle(opaque);

impl MapHandle {
  // Kit machinery only — nothing outside needs the map's raw yet.
  fn raw(self) -> opaque {
    return self.inner;
  }
  pub fn set(self, key: str, value: str) {
    rs_map_set(self.inner, key, value);
  }
  pub fn get(self, key: str) -> str {
    return rs_value_get(self.inner, key);
  }
  pub fn len(self) -> u64 {
    return rs_value_len(self.inner);
  }
}

// A virtual-app source (`virtual_app_source` / `virtual_app_source_handle`;
// `virtual_app_controller`).
pub class VAppSource(opaque);

// The text-input controller (`tctrl_new` / `tctrl_set_text` /
// `tctrl_text`; `Input.controller`). Mint with `text_ctrl()`.
pub class TextCtrl(opaque);

impl TextCtrl {
  // The row-probe erase (the pg highlight rails + the span probes take
  // the raw opaque). Kit fns mint; only the raw ROWS need this.
  pub fn raw(self) -> opaque {
    return self.inner;
  }
  pub fn set_text(self, s: str) {
    tctrl_set_text(self.inner, s);
  }
  pub fn text(self) -> str {
    return tctrl_text(self.inner);
  }
}

// Mint the input's text controller.
pub fn text_ctrl() -> TextCtrl {
  return TextCtrl(tctrl_new());
}

// The input undo controller (`undo_new`; `Input.undo`). Mint with
// `undo_ctrl()`.
pub class UndoCtrl(opaque);

impl UndoCtrl {
  // The row-probe erase (the undo rows take the raw opaque).
  pub fn raw(self) -> opaque {
    return self.inner;
  }
}

// Mint the input's undo controller.
pub fn undo_ctrl() -> UndoCtrl {
  return UndoCtrl(undo_new());
}

// A virtual-app controller (`va_controller`; `VirtualAppView.controller`).
pub class VAppCtrl(opaque);

impl VAppCtrl {
  // Kit machinery — the virtual-app rows take the raw opaque.
  pub fn raw(self) -> opaque {
    return self.inner;
  }
  pub fn status(self) -> str {
    return va_status(self.inner);
  }
  pub fn status_atom(self) -> u64 {
    return va_status_atom(self.inner);
  }
  // The public read: the controller's status rail as a typed Source<str>
  // (the playground's watch rides it — no raw atom ids in biz code).
  pub fn status_source(self) -> Source<str> {
    return Source<str>.of(ctx_bridge(), va_status_atom(self.inner), false, STAMP_NUM_F64);
  }
  pub fn error(self) -> str {
    return va_error(self.inner);
  }
  pub fn destroy(self) {
    va_destroy(self.inner);
  }
}

// The structured-value data ops (the list/map builders the case code
// folds into sources; the STATE writes go through the ctx, never these).
// Minting WRAPS: the handle is nominal, the rows take `h.inner` inside
// the class methods (`.push` / `.set` / …).
pub fn list_new() -> ListHandle {
  return ListHandle(rs_list_new());
}

pub fn map_new() -> MapHandle {
  return MapHandle(rs_map_new());
}

// The raw-opaque readers (the store's read-back lane: `ctx.get<opaque>`
// recovers the structured value as a bare opaque — these take it
// directly). The handle-typed surface is the classes' methods.
pub fn value_len(v: opaque) -> u64 {
  return rs_value_len(v);
}

pub fn value_item(v: opaque, index: u64) -> str {
  return rs_value_item(v, index);
}

pub fn value_get(v: opaque, key: str) -> str {
  return rs_value_get(v, key);
}
// str -> f64 parse (0 on failure) — the edit-field confirm path.
pub fn str_parse_f64(s: str) -> f64 {
  return str_parse_f64_raw(s);
}

// Trig helpers (f64 radians in/out) — the pure-math rows the orbit /
// wave shapes feed a progress atom through.
pub fn math_sin(x: f64) -> f64 {
  return math_sin_raw(x);
}

pub fn math_cos(x: f64) -> f64 {
  return math_cos_raw(x);
}

