// flags.rut — the per-family NAME-ONLY enums + the row-code mappers.
// Split file 2/17 of tur_kit (the splice order IS rut.jsonc's entry.lib +
// entry.libs; the engine embed joins the same list).

// ---- flags (the per-family enums + the row-code mappers) -------------------
//
// Name-only enums — no explicit int values. The `code()` mappers' literals
// are the SOLE carriers of the row contract (migrated verbatim from the
// `builtin_plugins/*/rut_rows.rs` consts / `FromPrimitive` orders); the
// exhaustive `when` IS the pin — a new member without its code arm is a
// compile error, never a silent 0. Overloaded `code` names are fine
// (distinct param types, not arities).

pub enum Align {
  TopLeft, TopCenter, TopRight,
  CenterLeft, Center, CenterRight,
  BottomLeft, BottomCenter, BottomRight,
}

pub enum MainAlign { Start, Center, End, SpaceBetween, SpaceAround, SpaceEvenly }

pub enum CrossAlign { Start, Center, End, Stretch }

pub enum MainAxisSize { Max, Min }

pub enum StackFit { Loose, Expand, Passthrough }

pub enum Axis { Vertical, Horizontal }

pub enum BoxFit { Fill, Contain, Cover, FitWidth, FitHeight, None }

pub enum BorderPosition { Inside, Center, Outside }

pub enum Clip { None, HardEdge, AntiAlias, AntiAliasWithSaveLayer }

pub enum HitTestBehavior { Opaque, Translucent }

pub enum SpanFlags { None, Italic, Underline }

pub enum Cursor {
  Auto, Default, None, ContextMenu, Help, Pointer, Progress, Wait, Cell,
  Crosshair, Text, VerticalText, Alias, Copy, Move, NoDrop, NotAllowed,
  Grab, Grabbing, EResize, NResize, NeResize, NwResize, SResize, SeResize,
  SwResize, WResize, EwResize, NsResize, NeswResize, NwseResize, ColResize,
  RowResize, AllScroll, ZoomIn, ZoomOut,
}

// THE row contract — the only place the numbers live. One mapper per
// family (the compiler has no overloads — the names carry the family).
fn align_code(a: Align) -> u64 {
  return when (a) {
    Align.TopLeft -> 0,     Align.TopCenter -> 1,    Align.TopRight -> 2,
    Align.CenterLeft -> 3,  Align.Center -> 4,       Align.CenterRight -> 5,
    Align.BottomLeft -> 6,  Align.BottomCenter -> 7, Align.BottomRight -> 8,
  };
}

fn main_align_code(a: MainAlign) -> u64 {
  return when (a) {
    MainAlign.Start -> 0,        MainAlign.Center -> 1,
    MainAlign.End -> 2,          MainAlign.SpaceBetween -> 3,
    MainAlign.SpaceAround -> 4,  MainAlign.SpaceEvenly -> 5,
  };
}

fn cross_align_code(a: CrossAlign) -> u64 {
  return when (a) {
    CrossAlign.Start -> 0, CrossAlign.Center -> 1,
    CrossAlign.End -> 2,   CrossAlign.Stretch -> 3,
  };
}

fn main_size_code(a: MainAxisSize) -> u64 {
  return when (a) {
    MainAxisSize.Max -> 0, MainAxisSize.Min -> 1,
  };
}

fn stack_fit_code(a: StackFit) -> u64 {
  return when (a) {
    StackFit.Loose -> 0, StackFit.Expand -> 1, StackFit.Passthrough -> 2,
  };
}

fn axis_code(a: Axis) -> u64 {
  return when (a) {
    Axis.Vertical -> 0, Axis.Horizontal -> 1,
  };
}

fn box_fit_code(a: BoxFit) -> u64 {
  return when (a) {
    BoxFit.Fill -> 0, BoxFit.Contain -> 1, BoxFit.Cover -> 2,
    BoxFit.FitWidth -> 3, BoxFit.FitHeight -> 4, BoxFit.None -> 5,
  };
}

fn border_pos_code(a: BorderPosition) -> u64 {
  return when (a) {
    BorderPosition.Inside -> 0, BorderPosition.Center -> 1, BorderPosition.Outside -> 2,
  };
}

fn clip_code(a: Clip) -> u64 {
  return when (a) {
    Clip.None -> 0, Clip.HardEdge -> 1, Clip.AntiAlias -> 2,
    Clip.AntiAliasWithSaveLayer -> 3,
  };
}

fn hit_test_code(a: HitTestBehavior) -> u64 {
  return when (a) {
    HitTestBehavior.Opaque -> 0, HitTestBehavior.Translucent -> 1,
  };
}

fn span_flags_code(a: SpanFlags) -> u64 {
  return when (a) {
    SpanFlags.None -> 0, SpanFlags.Italic -> 1, SpanFlags.Underline -> 2,
  };
}

fn cursor_code(a: Cursor) -> u64 {
  return when (a) {
    Cursor.Auto -> 0, Cursor.Default -> 1, Cursor.None -> 2,
    Cursor.ContextMenu -> 3, Cursor.Help -> 4, Cursor.Pointer -> 5,
    Cursor.Progress -> 6, Cursor.Wait -> 7, Cursor.Cell -> 8,
    Cursor.Crosshair -> 9, Cursor.Text -> 10, Cursor.VerticalText -> 11,
    Cursor.Alias -> 12, Cursor.Copy -> 13, Cursor.Move -> 14,
    Cursor.NoDrop -> 15, Cursor.NotAllowed -> 16, Cursor.Grab -> 17,
    Cursor.Grabbing -> 18, Cursor.EResize -> 19, Cursor.NResize -> 20,
    Cursor.NeResize -> 21, Cursor.NwResize -> 22, Cursor.SResize -> 23,
    Cursor.SeResize -> 24, Cursor.SwResize -> 25, Cursor.WResize -> 26,
    Cursor.EwResize -> 27, Cursor.NsResize -> 28, Cursor.NeswResize -> 29,
    Cursor.NwseResize -> 30, Cursor.ColResize -> 31, Cursor.RowResize -> 32,
    Cursor.AllScroll -> 33, Cursor.ZoomIn -> 34, Cursor.ZoomOut -> 35,
  };
}

