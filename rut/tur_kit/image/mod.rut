// image — the image family (Image + the image-resource minters).

use tur_host::{
  img_build, img_fit, img_height, img_new, img_qkey, img_res_bytes, img_res_solid, img_res_svg,
  img_width,
};

pub class Image {
  spec: opaque;
}

impl Image {
  [constructor] pub fn builder(res: u64) -> Self {
    return Self { spec: img_new(res) };
  }
  pub fn width(mut self, v: f64) -> Self {
    img_width(self.spec, v);
    return self;
  }
  pub fn height(mut self, v: f64) -> Self {
    img_height(self.spec, v);
    return self;
  }
  pub fn fit(mut self, v: flags.BoxFit) -> Self {
    img_fit(self.spec, flags.box_fit_code(v));
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    img_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> handles.View {
    return handles.View(img_build(self.spec));
  }
}
// Register an encoded image resource (PNG/JPEG) — the `createImageResource`
// twin.
pub fn image_resource_bytes(bytes: bytes) -> u64 {
  return img_res_bytes(bytes);
}

// A synthetic solid RGBA image resource (fixture-friendly).
pub fn image_resource_solid(w: u64, h: u64, packed: u64) -> u64 {
  return img_res_solid(w, h, packed);
}

// Rasterise an SVG string into an image resource (the todolist /
// github-viewer icon rail).
pub fn image_resource_svg(src: str) -> u64 {
  return img_res_svg(src);
}

