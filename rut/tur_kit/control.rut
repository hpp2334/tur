// control.rut — the control-flow families (Switch / Condition / Each /
// Fragment). Split file 16/17 of tur_kit (the splice order IS
// rut.jsonc's entry.lib + entry.libs).

// ---- control flow (Switch / Condition / Each / Fragment) ---------------------

class Switch {
  spec: opaque;
}

impl Switch {
  [constructor] pub fn builder() -> Self {
    return Self { spec: switch_new() };
  }
  // The ONE reactive value prop: the handle's kind selects the row
  // (source binds directly, a derived through the derive rail).
  pub fn value(mut self, r: Readable<str>) -> Self {
    if (r.is_derived()) {
      switch_value_derived(self.spec, r.atom_id());
    } else {
      switch_value_source(self.spec, r.atom_id());
    }
    return self;
  }
  // Appends one case — the historical `cases` prop's crossing (`case` is
  // a reserved word in rut).
  pub fn cases(mut self, key: str, branch: View) -> Self {
    switch_case(self.spec, key, branch.inner);
    return self;
  }
  // The lazy case twin: the branch is a FN VALUE, invoked when the key
  // activates (fresh read of live state).
  pub fn case_build(mut self, key: str, cb: fn() -> View) -> Self {
    switch_case_build(self.spec, key, opaque(cb));
    return self;
  }
  pub fn fallback(mut self, branch: View) -> Self {
    switch_fallback(self.spec, branch.inner);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    switch_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> View {
    return View(switch_build(self.spec));
  }
}

class Condition {
  spec: opaque;
}

impl Condition {
  [constructor] pub fn builder(r: Readable<bool>) -> Self {
    return Self { spec: cond_new(r.atom_id()) };
  }
  pub fn then(mut self, branch: View) -> Self {
    cond_then(self.spec, branch.inner);
    return self;
  }
  pub fn else_branch(mut self, branch: View) -> Self {
    cond_else(self.spec, branch.inner);
    return self;
  }
  // The lazy twins: the branch is a FN VALUE (`fn() -> View`), invoked
  // at activation and re-invoked at every re-activation — the built
  // subtree reads LIVE state each time it mounts (the boa callback
  // semantic; e.g. a modal reads the draft at open time).
  pub fn then_build(mut self, cb: fn() -> View) -> Self {
    cond_then_build(self.spec, opaque(cb));
    return self;
  }
  pub fn else_build(mut self, cb: fn() -> View) -> Self {
    cond_else_build(self.spec, opaque(cb));
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    cond_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> View {
    return View(cond_build(self.spec));
  }
}

class Each {
  spec: opaque;
}

impl Each {
  [constructor] pub fn builder(r: Readable<opaque>) -> Self {
    return Self { spec: each_new(r.atom_id()) };
  }
  pub fn item_builder(mut self, cb: fn(u64, str) -> View) -> Self {
    each_builder(self.spec, opaque(cb));
    return self;
  }
  pub fn build(self) -> View {
    return View(each_build(self.spec));
  }
}

class Fragment {
  spec: opaque;
}

impl Fragment {
  [constructor] pub fn builder() -> Self {
    return Self { spec: frag_new() };
  }
  pub fn child(mut self, c: View) -> Self {
    frag_child(self.spec, c.inner);
    return self;
  }
  pub fn children(mut self, cs: [View]) -> Self {
    for (let c of cs) {
      frag_child(self.spec, c.inner);
    }
    return self;
  }
  pub fn build(self) -> View {
    return View(frag_build(self.spec));
  }
}

