// tur_playground_kit — the playground compile service's kit prelude (the
// authored face over the pg_* rows). Owned by the plugin that owns the rows
// (the layering law applied to the kit); embedded by
// libs/tur-playground/src/kit.rs and registered as a compile-session prelude
// beside the rows (TurRutPlaygroundPlugin), so hosts without the playground
// service never see (or compile) it.
{
  "name": "tur_playground_kit",
  "deps": {
    "tur_host": { "path": "../tur_host" },
    "tur_kit": { "path": "../tur_kit" }
  }
}
