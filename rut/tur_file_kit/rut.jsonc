// tur_file_kit — the filepicker capability's kit prelude (the authored
// face over the filepicker rows). Owned by the plugin that owns the rows
// (the layering law applied to the kit); embedded by
// tur-filepicker-capability/src/kit.rs and registered as a compile-session
// prelude only when the FilePicker capability is present
// (TurFilePickerPlugin declares it as a hard dep).
{
  "name": "tur_file_kit",
  "deps": {
    "tur_host": { "path": "../tur_host" }
  }
}
