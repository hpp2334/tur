// tur_host — the engine's host pkg: a pure declaration surface whose
// `host fn`s the embedding Rust binds at boot. The Rust rows are the
// compile truth (tur-engine/src/core/rut_runtime: the in-memory decl pkg
// assembled from `tur_decl_pkg()` + every plugin's RutPkgExt rows, the
// bodies installed by `install_tur_pkg`); this directory is the GENERATED
// decl MODULE TREE of that surface — regenerate it with the
// `tur_host_decl` test's bless mode (`TUR_BLESS_TUR_HOST_DECL=1
// cargo nextest run -p tur-integration-tests tur_host_decl`), never by
// hand. The diff test fails when the Rust rows drift from the tree.
//
// The root surface is `mod.d.rut` beside this manifest — the
// auto-discovered default root (lib parity with a body pkg's `mod.rut`),
// so no `entry` is spelled. Each `pub mod X;` in the root mounts
// `X/mod.d.rut` beside it (recursive — `layout/flex` nests under
// `layout`); a consumer's use path spells the tree
// (`use tur_host::store::{ rs_source_str };`).
{
  "name": "tur_host",
  "type": "host"
}
