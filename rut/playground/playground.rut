// The tur playground — one rut module (the Phase-4 rewrite of the
// playground-view bundle). Layout: a toolbar above a case-list sidebar
// beside an editor pane and a viewer pane, above a status bar —
// selecting a case loads its source into the editor (a multiline Input on
// a realm-minted controller) and RUNS it — `run_case` compiles through
// the `pg_compile` row (which registers the source Rust-side and
// answers its id), destroys the previous child and spawns a fresh one
// under a new controller (the `runCase` destroy-then-spawn swap). The
// viewer hosts the child through a bound `VirtualAppView`; each
// controller's status rail is a typed `Source<str>`
// (`VAppCtrl.status_source()`) watched through the boa-model `Watch` —
// the deliveries settle the viewer's state Switch (the boa viewer's
// FallbackView / RuntimeError shapes). Boot auto-selects `counter` (the
// boa INITIAL_CASE): the editor loads its source, the viewer renders and
// the status settles to ready without a tap.
//
// Editor highlighting: `highlight` classifies the source through the
// upstream rut-semantic classifier (Rust-side — token classes plus AST
// name classes: fn/method names and call callees blue, types violet,
// keywords teal, true/false/nil brown, strings / comments / numbers in
// the boa palette; broken source degrades to token classes — never a
// wrong color) and `apply_highlight` writes the colored spans into the
// editor controller — at case load + after a successful Run, matching the
// boa buildHighlightSpans rail. NOT per keystroke (the recorded phase-D
// decision): typed text inherits the caret span's color, so the
// highlighting survives edits until the next re-highlight, and the
// caret-preserving apply never yanks the caret.
//
// Toolbar (48px, the boa metrics): the compact Run + Reset buttons
// (padding-6 content-sized bodies carrying the ▶ / ↻ icon resources —
// SVGs rasterised once at boot through `image_resource_svg`) with the
// "auto" captioned auto-run toggle (debounced recompile+respawn on edit —
// the `input_on_input` intent restarts a 500 ms one-shot animation
// controller; a newer edit stops it) and the Split/Edit/View layout tabs
// (the hidden pane shells into a zero-width container — the boa trick).
//
// Status bar (~20px over a 1px top border): the state dot + label
// (ready / spawning / error / compile-error — the same atom the viewer's
// Switch reads; the label colors ride the status greens/reds), the edited
// pill (`TextCtrl.text` vs the last-compiled source, recomputed on the
// on-input intent — no polling), `compiled Xs ago` (a 1 Hz
// animation-driven clock), the auto-run state (or the "⌘S to run" hint
// while the toggle is off) and the version.
//
// Sidebar polish (phase E + the phase-2 chrome pass): a CASES header
// (10px tertiary label + the registry count) over the list; each row's
// two brushes — the reserved 3px accent bar (teal when selected,
// transparent otherwise: the label never shifts) and the full-width inset
// pill (the boa ink law: hover ink.200, selected ink.150, selected +
// hovered ink.300) — are PER-ROW DERIVES over the shared selection +
// hover sources (the row paints itself; no sweep, no scratch keys); a
// per-row MouseRegion delivers `row_enter` / `row_exit` (the
// pointer-region corpus pattern) and the pointer cursor. The toolbar's
// Run / Reset buttons and the layout tabs carry the same hover rail.
//
// Dividers: a visible 8px band (the ink.300 border ink) on BOTH pane
// boundaries — the sidebar↔editor one and the editor↔viewer one (the
// boa VDivider shape — col-resize cursor, the band turning brand teal
// while dragging; the second one mounts only in split mode). The first
// drag rail resizes the sidebar-width atom (clamped 200–720 px, the boa
// 200 seed), the second the editor-width atom (clamped 360–900 px) —
// the `pointer-drag` corpus pattern, the width atoms riding typed
// sources and the drag scratch riding shared-cell fields.
//
// STATE (the phase-4 restructure): one `AppContext` record built in
// `start` — every reactive rail a typed `Source`, every controller a
// kit handle, the drag scratch shared-cell `f64` fields — passed as
// `cx` into every view-builder and intent fn (rut module fns can't
// capture, so the record IS the module's state; no stash, no raw atom
// ids). The ctx crosses where rut has none of its own: the boot
// selection and the `select` / `probe` probe entries mint it over
// `entry_ctx()` (the entry rail's ctx).
//
// The case registry (`pg_case_count` / `pg_case_name` / `pg_case_source`)
// is generated by scripts/gen-cases.cjs into cases_gen.rut and concatenated
// after this module by the website's `playgroundSource()`.
// Timers ride the animation subsystem (Rust-held anim controllers ticked
// by the engine): the "compiled Xs ago" clock is a 1 Hz self-restarting
// one-shot, and the auto-run debounce is a 500 ms one-shot restarted on
// every edit (`AnimCtrl.stop` = cancellation). The async weave
// (`launch_future` / `sleep`) installs on BOTH targets — the vendored
// decl lowers from the `.d.rut` (wasm has no filesystem) and the bodies
// are pure VM-driving rows.
// (A second `tur_host` use statement is LOAD-BEARING at this rut pin: the
// duplicate-boot-scope type-interning bug collapses kit-fn/row resolution
// in this module when it has fewer than two `tur_host` use lines — the
// documented upstream family. Revisit at the next rut bump.)
use tur_host::mount_raw;
use tur_anim_kit::{ AnimCtrl, anim_ctrl_end, anim_ctrl_open };
use tur_kit::{ Align, BorderPosition, Column, Condition, Container, CrossAlign, Cursor, DeriveCtx,
    Each, EnterEvent, ExitEvent, Expanded, Image, Input, InputEvent, Axis, MainAlign, MainAxisSize,
    MouseRegion, Mutation, MutationCtx, PointerEvent, PointerInteract, Positioned, Readable, Row,
    ScrollView, SizedBox, Source, Stack, StackFit, Switch, Text, TextCtrl, UndoCtrl, VAppCtrl,
    VirtualApp, Watch, bridge, derive, entry_ctx, image_resource_svg, list_new, mount, mutate, text_ctrl,
    undo_ctrl, virtual_app_atom, virtual_app_controller, virtual_app_set, virtual_app_source,
    virtual_app_source_handle, watch };
use tur_host::{ mount_raw, pg_apply_highlight, pg_compile, pg_compile_diags, pg_highlight };

// ---- design tokens ---------------------------------------------------------
//
// The light theme from rut/playground/DESIGN-SYSTEM.md §1.1/§2 — the
// single source of truth for visual decisions (the boa reference palette:
// warm-tinted ink neutrals + the saturated teal signature + the coral
// complement + AA-verified status colors).
//
// Every value is a u64 packed **0xRRGGBBAA** (opaque = `| 0xFF`) — the kit
// header's color law, pinned natively by
// `libs/tur-integration-tests/tests/element/color_packing_law.rs`. The
// primitive palette (INK_* / TEAL_* / CORAL_* / STATUS_*) is the raw
// material; the views below use only the semantic layer (BG_* / TEXT_* /
// ACCENT_*), never a primitive directly. Module `let` initializers must be
// literals in this build, so the semantic layer restates the primitive's
// packed value (its origin is in the trailing comment) instead of aliasing.

// primitives — ink (warm-tinted neutrals)
let INK_50: u64 = 0xFBFCFDFFu64;
let INK_100: u64 = 0xF4F6F9FFu64;
let INK_150: u64 = 0xECEFF4FFu64;
let INK_200: u64 = 0xE1E5ECFFu64;
let INK_300: u64 = 0xD4D9E0FFu64;
let INK_400: u64 = 0xB8C0CCFFu64;
let INK_500: u64 = 0x8A94A3FFu64;
let INK_600: u64 = 0x5E6878FFu64;
let INK_700: u64 = 0x3A4250FFu64;
let INK_800: u64 = 0x1F2530FFu64;
let INK_900: u64 = 0x0A0E14FFu64;

// primitives — teal (the saturated cyan-leaning signature)
let TEAL_200: u64 = 0x7DF5D0FFu64;
let TEAL_300: u64 = 0x00E8B8FFu64;
let TEAL_400: u64 = 0x00C69AFFu64;
let TEAL_500: u64 = 0x00A886FFu64;
let TEAL_600: u64 = 0x008A6EFFu64;
let TEAL_700: u64 = 0x006E58FFu64;
let TEAL_800: u64 = 0x005440FFu64;

// primitives — coral (the warm complement; used sparingly)
let CORAL_300: u64 = 0xFFB3A3FFu64;
let CORAL_400: u64 = 0xFF8A72FFu64;
let CORAL_500: u64 = 0xE85D44FFu64;
let CORAL_700: u64 = 0xB03A1FFFu64;

// primitives — status (AA on ink.50; info reuses teal.700)
let STATUS_SUCCESS: u64 = 0x00A06BFFu64;
let STATUS_WARNING: u64 = 0xC47700FFu64;
let STATUS_ERROR: u64 = 0xD63A2FFFu64;
let STATUS_INFO: u64 = 0x006E58FFu64;

// semantic layer — what the views use (origin primitives in the comments)
let BG_APP: u64 = 0xFBFCFDFFu64; // ink.50
let BG_PANEL: u64 = 0xF4F6F9FFu64; // ink.100
let BG_ELEVATED: u64 = 0xECEFF4FFu64; // ink.150
let BG_HOVER: u64 = 0xE1E5ECFFu64; // ink.200 (bg.hover / bg.controlTray)
let BG_STRONG_HOVER: u64 = 0xD4D9E0FFu64; // ink.300 (bg.strongHover)
let BG_SELECTED: u64 = 0x7DF5D0FFu64; // teal.200
let BG_CODE: u64 = 0xFBFCFDFFu64; // ink.50
let BG_VIEWER: u64 = 0xFBFCFDFFu64; // ink.50 (bg.viewer)
let BG_DANGER: u64 = 0xFFF0EEFFu64; // #fff0ee (bg.danger)
let TEXT_PRIMARY: u64 = 0x1F2530FFu64; // ink.800
let TEXT_BODY: u64 = 0x3A4250FFu64; // ink.700
let TEXT_SECONDARY: u64 = 0x5E6878FFu64; // ink.600
let TEXT_TERTIARY: u64 = 0x8A94A3FFu64; // ink.500
let TEXT_PLACEHOLDER: u64 = 0xB8C0CCFFu64; // ink.400
let TEXT_CODE: u64 = 0x1F2530FFu64; // ink.800 (code.fg)
let TEXT_ON_ACCENT: u64 = 0x0A0E14FFu64; // ink.900 (text.onAccent)
let TEXT_ON_DANGER: u64 = 0x8A1A14FFu64; // #8a1a14 (text.onDanger)
let TEXT_INVERSE: u64 = 0xFBFCFDFFu64; // ink.50 (text.inverse)
let BORDER_SUBTLE: u64 = 0xD4D9E0FFu64; // ink.300 (border.subtle)
let ACCENT_CURSOR: u64 = 0x00A886FFu64; // teal.500
let ACCENT_PRIMARY: u64 = 0x00C69AFFu64; // teal.400
let BTN_PRIMARY_HOVER: u64 = 0x00E8B8FFu64; // teal.300 (bg.button.primaryHover)
let BTN_GHOST: u64 = 0xFBFCFDFFu64; // ink.50 (bg.button.ghost)
let ACCENT_SOLID: u64 = 0x00A886FFu64; // teal.500 (the brand mark)
let ACCENT_COMPLEMENT: u64 = 0xFF8A72FFu64; // coral.400 (the edited dot)
// The viewer's inset card (the boa build measures (248,250,252) inside the
// ink.50 pane — the ink.100-family card surface the case renders on).
let CARD_BG: u64 = 0xF8FAFCFFu64; // #f8fafc

// The toolbar's icon resources — the boa icons.ts SVGs (the ▶ / ↻ pair),
// rasterised once at boot through `image_resource_svg` and laid out at
// 10 / 12 px like the reference buttons.
let RUN_ICON_SVG: str = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#ffffff\"><polygon points=\"6 4 20 12 6 20\"/></svg>";
let RESET_ICON_SVG: str = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3A4250\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"1 4 1 10 7 10\"/><path d=\"M3.51 15a9 9 0 1 0 2.13-9.36L1 10\"/></svg>";

// The module's state: one record, built once in `start`, threaded as
// `cx` through every builder and intent fn. Reactive rails are typed
// `Source`s; handles are kit newtypes; the drag/tab scratch rides
// shared-cell `f64` fields (written through `mut cx` bindings).
struct AppContext {
    // the sidebar's case list (the Each's source)
    names: Source<opaque>,
    // the toolbar's case-name readout
    selected: Source<str>,
    // the selection + hover rails (the row brushes derive over them)
    sel: Source<f64>,
    hover: Source<f64>,
    // the app-state rail: the status bar's dot + label AND the viewer's
    // state Switch both read it (the watch deliveries settle it)
    state: Source<str>,
    verr: Source<str>,
    hint: Source<str>,
    hint_on: Source<bool>,
    // the viewer's reactive `app$` binding atom
    app_atom: u64,
    // the toolbar/status rails
    edited: Source<bool>,
    autorun: Source<bool>,
    layout: Source<str>,
    ago: Source<f64>,
    compiled: Source<str>,
    dot: Source<u64>,
    tab_split: Source<u64>,
    tab_edit: Source<u64>,
    tab_view: Source<u64>,
    // the phase-E rails: the sidebar width (the divider's atom — the
    // clamp lives in the drag intent; the boa seed is 200), the divider's
    // drag brush and drag flag
    sbw: Source<f64>,
    dragging: Source<bool>,
    div_bar: Source<u64>,
    // the phase-4 P0 rails: the editor↔viewer divider (the boa
    // editorWidth$ — the split-mode editor pane rides this atom, the
    // drag intent clamps 360–900)
    edw: Source<f64>,
    edragging: Source<bool>,
    ediv_bar: Source<u64>,
    // the toolbar buttons' hover brushes
    run_h: Source<u64>,
    reset_h: Source<u64>,
    // handles
    ctrl: TextCtrl,
    clock: AnimCtrl,
    debounce: AnimCtrl,
    vctrl: VAppCtrl,
    // the toolbar icons' resource ids (minted once at boot)
    run_icon: u64,
    reset_icon: u64,
    // the shared-cell scratch (the tab hover index, the two dividers'
    // drag-start x — non-reactive, written through `mut cx`)
    tab_h: f64,
    dragx: f64,
    edragx: f64,
}

entry fn start() -> opaque {
    // The sidebar's case list (from the generated registry).
    let names = list_new();
    let n = pg_case_count();
    let mut i = 0;
    while (i < n as i32) {
        names.push(pg_case_name(i as u64));
        i += 1;
    }

    let ctrl = text_ctrl();

    // The brushes seed at the mint (the boot state needs no paint pass):
    // the dot leads green (ready), the split tab carries the selected
    // ink (split is the boot layout), the dividers the subtle border
    // ink, the buttons their resting inks. The timers mint as no-op
    // dummies — the REAL controllers (whose end closures thread `cx`)
    // assign into the record right after construction (the shared-cell
    // write; the dummy never fires a meaningful end).
    let mut cx = AppContext {
        names: source<opaque>(names.raw()),
        selected: source<str>(""),
        sel: source<f64>(-1.0),
        hover: source<f64>(-1.0),
        state: source<str>("ready"),
        verr: source<str>(""),
        hint: source<str>("(no case)"),
        hint_on: source<bool>(true),
        app_atom: virtual_app_atom(),
        edited: source<bool>(false),
        autorun: source<bool>(true),
        layout: source<str>("split"),
        ago: source<f64>(0.0),
        compiled: source<str>(""),
        dot: source<u64>(STATUS_SUCCESS),
        tab_split: source<u64>(BG_APP),
        tab_edit: source<u64>(0),
        tab_view: source<u64>(0),
        sbw: source<f64>(200.0),
        dragging: source<bool>(false),
        div_bar: source<u64>(BORDER_SUBTLE),
        edw: source<f64>(600.0),
        edragging: source<bool>(false),
        ediv_bar: source<u64>(BORDER_SUBTLE),
        run_h: source<u64>(ACCENT_PRIMARY),
        reset_h: source<u64>(BTN_GHOST),
        ctrl: ctrl,
        clock: anim_ctrl_open(1000.0, "linear", 0),
        debounce: anim_ctrl_open(500.0, "linear", 0),
        vctrl: seed_controller(),
        run_icon: image_resource_svg(RUN_ICON_SVG),
        reset_icon: image_resource_svg(RESET_ICON_SVG),
        tab_h: -1.0,
        dragx: 0.0,
        edragx: 0.0,
    };
    cx.clock = anim_ctrl_end(1000.0, "linear", 0, mutate(fn (ctx: MutationCtx, _e: nil) { on_clock_end(ctx, cx); }));
    cx.debounce = anim_ctrl_end(500.0, "linear", 0, mutate(fn (ctx: MutationCtx, _e: nil) { on_debounce_end(ctx, cx); }));

    // The timers start now: the ago clock runs, the debounce waits for
    // the first edit.
    cx.clock.forward();

    // The controller's status watch (the boa-model Watch — the delivery
    // settles the viewer's state atoms through its ctx).
    watch_controller(cx, cx.vctrl);

    build_ui(cx);

    // Boot selection (the boa INITIAL_CASE): select + run `counter` so
    // the editor loads its source, the viewer renders the case and the
    // status settles to ready without a tap. The ctx is the entry rail's.
    let mut boot = 0;
    let mut i = 0;
    while (i < n as i32) {
        if (pg_case_name(i as u64) == "counter") {
            boot = i;
        }
        i += 1;
    }
    case_tap(entry_ctx(), cx, boot as u64);

    // The probe rail's context crossing (the phase-5 contract): start
    // answers the record boxed; the harness holds the token and the
    // select/probe entries take it back as `cx: opaque`.
    return opaque(cx);
}

// The probe seam's downcast (the context-crossing contract).
// contract's `opaque.downcast<AppContext>`).
fn probe_cx(cx: opaque) -> AppContext {
    let c = opaque.downcast<AppContext>(cx);
    if (c == nil) {
        panic("probe: the held context is not an AppContext");
    }
    return c;
}

// The seed child: an empty module under its own controller — the
// destroy-then-spawn swap's unconditional target, and the status watch's
// first rail.
fn seed_controller() -> VAppCtrl {
    let seed = virtual_app_source("use tur_kit::{ mount };\nentry fn start() {\n}\n");
    return virtual_app_controller(seed);
}

// Watch the controller's status rail (the boa-model `Watch` over the
// typed `status_source`): the transitions deliver into `on_vstat`, which
// settles the viewer's state atoms through its ctx.
fn watch_controller(mut cx: AppContext, vctrl: VAppCtrl) {
    let stat = vctrl.status_source();
    let w = watch<str>(stat, mutate(fn (ctx: MutationCtx, _e: nil) {
        on_vstat(ctx, cx, stat, vctrl);
    }));
    w.start();
}

// The whole tree, built at start. A fresh Input mounts per build; on
// selection the controller write refreshes the mounted editable in place
// (see `case_tap`).
fn build_ui(cx: AppContext) {

    let sidebar = sidebar(cx);

    let toolbar = toolbar(cx);

    let editor_pane = editor_pane(cx);

    let viewer_pane = viewer_pane(cx);

    let editor_slot = editor_slot(cx, editor_pane);
    let viewer_slot = viewer_slot(cx, viewer_pane);

    let divider = divider(cx);

    let edivider_slot = edivider_slot(cx);

    let sbar = status_bar(cx);


    let shell = Column().cross_alignment(CrossAlign.Stretch)

        .child(toolbar)

        .child(Expanded().flex(1.0)

            .child(Row().cross_alignment(CrossAlign.Stretch)

                .child(sidebar)

                .child(divider)

                .child(editor_slot)

                .child(edivider_slot)

                .child(viewer_slot)

                .build())

            .build())

        .child(sbar)

        .build();

    mount(shell);
}

    // ---- sidebar ------------------------------------------------------
    // The width rides the divider's atom; the rows paint their own
    // selection/hover brushes (see `side_item`).
fn sidebar(cx: AppContext) -> View {
    // ---- sidebar ------------------------------------------------------
    // The width rides the divider's atom; the rows paint their own
    // selection/hover brushes (see `side_item`). Above the list: the
    // CASES header (the boa SidebarHeader — 10px tertiary label + the
    // registry count, space-between).
    let cases_header = Container().padding(14.0)
        .child(Row().main_alignment(MainAlign.SpaceBetween)
            .child(Text().text("CASES").font_size(10.0).color(TEXT_TERTIARY).build())
            .child(Text().text(f"{pg_case_count()}").font_size(10.0).color(TEXT_TERTIARY)
                .query_key("cases-count").build())
            .build())
        .build();
    let sidebar = Container().width_bound(cx.sbw).color(BG_PANEL).query_key("sidebar")
        .child(Column().cross_alignment(CrossAlign.Stretch)
            .child(cases_header)
            .child(Expanded().flex(1.0)
                .child(ScrollView().axis(Axis.Vertical)
                    .child(Column().cross_alignment(CrossAlign.Stretch)
                        .child(Each(cx.names).item_builder(fn (i: u64, name: str) -> View { return side_item(cx, i, name); }).build()).build())
                    .build())
                .build())
            .build())
        .build();
    return sidebar;
}
    // ---- toolbar --------------------------------------------------------
    // Brand (left) — case name (center, expands) — actions (right).
fn toolbar(cx: AppContext) -> View {
    // ---- toolbar --------------------------------------------------------
    // Brand (left) — case name (center, expands) — actions (right): Run,
    // Reset, the auto-run toggle and the Split/Edit/View tabs (the boa
    // tab cluster sits on the toolbar's right side).
    let brand = Container().padding(12.0)
        .child(Row().main_axis_size(MainAxisSize.Min)
            .child(Text().text("tur").font_size(14.0).color(ACCENT_SOLID).build())
            .child(SizedBox(4.0, 0.0).build())
            .child(Text().text("playground").font_size(11.0).color(TEXT_SECONDARY).build())
            .build())
        .build();
    let case_name = Container().padding(12.0)
        .child(Expanded().flex(1.0)
            .child(Text().text_bound(cx.selected).font_size(13.0).color(TEXT_BODY)
                .query_key("case-name").build())
            .build())
        .build();
    // The action buttons carry hover brushes (MouseRegion enter/exit — the
    // same rail the sidebar rows ride): Run brightens to teal.300, Reset
    // lifts from the ghost ink to the hover ink (the boa button rails).
    // Compact content-sized buttons (padding 6, radius 6) with the ▶ / ↻
    // icons at 10 / 12 px — the boa RunButton / ResetButton metrics.
    let run = MouseRegion()
        .on_enter(mutate<EnterEvent>(fn (ctx: MutationCtx, _ev: EnterEvent) { ctx.set<u64>(cx.run_h, BTN_PRIMARY_HOVER); }))
        .on_exit(mutate<ExitEvent>(fn (ctx: MutationCtx, _ev: ExitEvent) { ctx.set<u64>(cx.run_h, ACCENT_PRIMARY); }))
        .cursor(Cursor.Pointer)
        .child(PointerInteract().on_click(mutate(fn (ctx: MutationCtx, _e: nil) { run_case(ctx, cx); })).query_key("run")
            .child(Container().padding(6.0).radius(6.0).color_bound(cx.run_h)
                .child(Row().main_axis_size(MainAxisSize.Min)
                    .child(Image(cx.run_icon).width(10.0).height(10.0).build())
                    .child(SizedBox(4.0, 0.0).build())
                    .child(Text().text("Run").color(TEXT_ON_ACCENT).font_size(12.0).build())
                    .build())
                .build())
            .build())
        .build();
    let reset = MouseRegion()
        .on_enter(mutate<EnterEvent>(fn (ctx: MutationCtx, _ev: EnterEvent) { ctx.set<u64>(cx.reset_h, BG_HOVER); }))
        .on_exit(mutate<ExitEvent>(fn (ctx: MutationCtx, _ev: ExitEvent) { ctx.set<u64>(cx.reset_h, BTN_GHOST); }))
        .cursor(Cursor.Pointer)
        .child(PointerInteract().on_click(mutate(fn (ctx: MutationCtx, _e: nil) { reset_case(ctx, cx); })).query_key("reset")
            .child(Container().padding(6.0).radius(6.0).color_bound(cx.reset_h)
                .child(Row().main_axis_size(MainAxisSize.Min)
                    .child(Image(cx.reset_icon).width(12.0).height(12.0).build())
                    .child(SizedBox(4.0, 0.0).build())
                    .child(Text().text("Reset").color(TEXT_SECONDARY).font_size(12.0).build())
                    .build())
                .build())
            .build())
        .build();
    let actions = Row().main_axis_size(MainAxisSize.Min)
        .child(run)
        .child(SizedBox(6.0, 0.0).build())
        .child(reset)
        .child(SizedBox(12.0, 0.0).build())
        .child(auto_toggle(cx))
        .child(SizedBox(12.0, 0.0).build())
        .child(layout_tabs(cx))
        .child(SizedBox(12.0, 0.0).build())
        .build();
    let toolbar = Container().width_height(0.0, 48.0).color(BG_ELEVATED)
        .border(BORDER_SUBTLE, 1.0, BorderPosition.Inside).query_key("toolbar")
        .child(Row()
            .child(brand)
            .child(Expanded().flex(1.0).child(case_name).build())
            .child(actions)
            .build())
        .build();
    return toolbar;
}
    // ---- editor pane ----------------------------------------------------
    // The `input_on_input` rail: every user edit delivers `on_edit`.
fn editor_pane(cx: AppContext) -> View {
    // ---- editor pane ----------------------------------------------------
    // The `input_on_input` rail: every user edit delivers `on_edit` (the
    // edited pill + the debounced auto-run). Programmatic controller
    // writes (`TextCtrl.set_text` in case_tap / reset_case) do NOT fire
    // it. The editable fills the pane (a stretch column — no hardcoded
    // width, so the hidden zero-width shell truly collapses it).
    // Monospace 13 — the boa editor's face (uniform glyphs keep the
    // caret math honest). THE BOA SCROLL ARCHITECTURE: the editor never
    // scrolls ITSELF — it hugs its content (no hardcoded height, so the
    // scroll extent grows with the text) inside a pane-filling
    // ScrollView, which owns the scrolling: clamped to content −
    // viewport (a fitting source cannot scroll), push_clip'd (scrolled
    // lines never leave the pane), and the caret-follow rides
    // `ensure_caret_visible`'s ScrollView branch. The self-scroller
    // inside the editable stays at 0 the whole time.
    let editor = Input().controller(cx.ctrl).undo(undo_ctrl()).placeholder("select a case…")
        .color(TEXT_CODE).placeholder_color(TEXT_PLACEHOLDER).cursor_color(ACCENT_CURSOR)
        .font_family("monospace").font_size(13.0)
        .multiline(true).on_input(mutate<InputEvent>(fn (ctx: MutationCtx, _ev: InputEvent) { on_edit(ctx, cx); }))
        .query_key("editor").build();
    let editor_pane = Container().color(BG_CODE).padding(12.0).query_key("editor-pane")
        .child(ScrollView().axis(Axis.Vertical).query_key("editor-scroll")
            .child(Column().cross_alignment(CrossAlign.Stretch).child(editor).build())
            .build())
        .build();
    return editor_pane;
}
    // ---- viewer pane ----------------------------------------------------
    // The boa Viewer shape: the pane is the ink.50 surface.
fn viewer_pane(cx: AppContext) -> View {
    // ---- viewer pane ----------------------------------------------------
    // The boa Viewer shape: the pane is the ink.50 surface and the READY
    // branch renders the case inside an inset card — padding 12 of pane
    // around the card background (`CARD_BG`, the measured (248,250,252)),
    // the VirtualAppView host filling the card. The error branches are
    // full-bleed (the boa ErrorPanel — no card). The Switch replaces the
    // viewer only on FAILURE; the fallback keeps the `VirtualAppView`
    // mounted so the bound controller always has a host to spawn into.
    // The "(no case)" / "starting..." hint is the FallbackView shape — an
    // overlay the child's first frame paints over (the Condition drops it
    // once the child settles).
    let viewer_pane = Container().color(BG_VIEWER).query_key("viewer-pane")
        .child(Switch().value(cx.state)
            .cases("error", error_view("Runtime error", cx.verr))
            .cases("compile-error", error_view("Compile error", cx.verr))
            .fallback(ready_viewer(cx))
            .query_key("viewer-switch")
            .build())
        .build();
    return viewer_pane;
}
    // ---- pane slots (the layout modes) ----------------------------------
    // Split: the editor pane carries the fixed editor-width atom (the
    // second divider's drag target), the viewer is Expanded. Edit: the
    // editor fills the row and the viewer shells into a zero-width
    // container; View: the editor does (the boa shell trick).
fn editor_slot(cx: AppContext, editor_pane: View) -> View {
    // ---- pane slots (the layout modes) ----------------------------------
    // Split: the editor pane carries the fixed editor-width atom (the
    // second divider's drag target — the boa `Container().width(
    // editorWidth$)`), the viewer is Expanded. Edit: the editor fills the
    // row and the viewer shells into a zero-width container; View: the
    // editor does (the boa shell trick — the hidden pane stays mounted,
    // lays out to nothing, and the hard clip keeps its content from
    // bleeding over the visible pane). `width(0)` / `height(0)` are REAL
    // zeros (the box_width / box_height rows — `width_height`'s 0 would
    // mean "unset").
    let slot = Switch().value(cx.layout)
        .cases("view", Container().width(0.0).height(0.0).clip(Clip.HardEdge)
            .child(editor_pane).build())
        .cases("split", Container().width_bound(cx.edw).child(editor_pane).build())
        .fallback(Expanded().flex(1.0).child(editor_pane).build())
        .query_key("editor-slot")
        .build();
    return slot;
}

fn viewer_slot(cx: AppContext, viewer_pane: View) -> View {
    let slot = Switch().value(cx.layout)
        .cases("edit", Container().width(0.0).height(0.0).clip(Clip.HardEdge)
            .child(viewer_pane).build())
        .fallback(Expanded().flex(1.0).child(viewer_pane).build())
        .query_key("viewer-slot")
        .build();
    return slot;
}

fn divider(cx: AppContext) -> View {
    // ---- divider ----------------------------------------------------------
    // The draggable strip between the sidebar and the editor pane: a
    // visible 8px band (the ink.300 border ink — the boa VDivider renders
    // its bar across the whole grab strip) that turns the brand teal
    // while dragging. Drag intents resize the sidebar-width atom (clamped
    // 200–720 in `div_move` — the drag corpus's delta-tracking pattern).
    let divider = MouseRegion().cursor(Cursor.ColResize)
        .child(PointerInteract()
            .on_pointer_down(mutate<PointerEvent>(fn (ctx: MutationCtx, ev: PointerEvent) { div_down(ctx, cx, ev.global.x); }))
            .on_pointer_move(mutate<PointerEvent>(fn (ctx: MutationCtx, ev: PointerEvent) { div_move(ctx, cx, ev.global.x); }))
            .on_pointer_up(mutate<PointerEvent>(fn (ctx: MutationCtx, _ev: PointerEvent) { div_up(ctx, cx); })).query_key("divider")
            .child(Container().width(8.0).color_bound(cx.div_bar).build())
            .build())
        .build();
    return divider;
}
    // ---- the editor↔viewer divider ---------------------------------------
    // The boa shell's second VDivider: visible and draggable only in
    // split mode.
fn edivider_slot(cx: AppContext) -> View {
    // ---- the editor↔viewer divider ---------------------------------------
    // The boa shell's second VDivider: an 8px ink.300 band like the
    // sidebar divider (teal while dragging), visible and draggable only in
    // split mode, resizing the editor-width atom (clamped 360–900 in
    // `ediv_move` — the same delta-tracking drag rail as the sidebar
    // divider above). Outside split mode the pane Switch shells it into a
    // zero box (the boa Condition on `layoutMode === "split"`).
    let edivider = MouseRegion().cursor(Cursor.ColResize)
        .child(PointerInteract()
            .on_pointer_down(mutate<PointerEvent>(fn (ctx: MutationCtx, ev: PointerEvent) { ediv_down(ctx, cx, ev.global.x); }))
            .on_pointer_move(mutate<PointerEvent>(fn (ctx: MutationCtx, ev: PointerEvent) { ediv_move(ctx, cx, ev.global.x); }))
            .on_pointer_up(mutate<PointerEvent>(fn (ctx: MutationCtx, _ev: PointerEvent) { ediv_up(ctx, cx); })).query_key("divider2")
            .child(Container().width(8.0).color_bound(cx.ediv_bar).build())
            .build())
        .build();
    let edivider_slot = Switch().value(cx.layout)
        .cases("edit", SizedBox(0.0, 0.0).build())
        .cases("view", SizedBox(0.0, 0.0).build())
        .fallback(edivider)
        .query_key("divider2-slot")
        .build();
    return edivider_slot;
}
    // ---- status bar -------------------------------------------------------
    // The state dot + label, the edited pill, the ago clock, the
    // auto-run state and the version.
fn status_bar(cx: AppContext) -> View {
    // ---- status bar -------------------------------------------------------
    // The str-format derive rail (rs_derive over the ago atom — the
    // top-level fmt fn + the raw dep). The lambda-capturing
    // `derive(fn ...)` spelling trips an upstream duplicate-type-interning
    // bug at this module's size (the derived materialization traps; the
    // label renders "") — revisit on the next rut bump.
    // The derived atom rides the raw-atom Source spelling (the
    // upstream-workaround shape above).
    let ago_d: Readable<str> = Source<str>.of(bridge(), rs_derive(fmt_ago, cx.ago.atom_id()), false, 1);
    // The state label mirrors the dot's law: green while fine, the status
    // red for the failure states (the boa status bar colors both).
    let sbar_left = Container().padding(4.0)
        .child(Row().main_axis_size(MainAxisSize.Min)
            .child(SizedBox(8.0, 0.0).build())
            .child(Container().width_height(6.0, 6.0).radius(999.0).color_bound(cx.dot)
                .query_key("status-dot").build())
            .child(SizedBox(6.0, 0.0).build())
            .child(state_label(cx))
            .child(edited_pill(cx))
            .child(SizedBox(12.0, 0.0).build())
            .child(Text().text_bound(ago_d).font_size(11.0).color(TEXT_TERTIARY)
                .query_key("compiled-ago").build())
            .build())
        .build();
    let sbar_right = Container().padding(4.0)
        .child(Row().main_axis_size(MainAxisSize.Min)
            .child(auto_state_text(cx))
            .child(SizedBox(12.0, 0.0).build())
            .child(Text().text("tur v0.1").font_size(11.0).color(TEXT_TERTIARY).build())
            .child(SizedBox(8.0, 0.0).build())
            .build())
        .build();
    let sbar = Container().width_height(0.0, 22.0).color(BG_ELEVATED)
        .border(BORDER_SUBTLE, 1.0, BorderPosition.Inside).query_key("status-bar")
        .alignment(Align.Center)
        .child(Row().main_alignment(MainAlign.SpaceBetween)
            .child(sbar_left)
            .child(sbar_right)
            .build())
        .build();

    return sbar;
}


// The live viewer: the boa ReadyViewer shape — 12px of pane ink around
// the inset `CARD_BG` card (the measured (248,250,252) surface) hosting
// the bound child, plus the hint overlay. Fit-expand so the overlay fills
// (and centers its label) while visible; the hidden branch is a
// decoration-less box that passes pointers through to the child.
fn ready_viewer(cx: AppContext) -> View {
    let host = VirtualApp().bind(cx.app_atom).query_key("viewer").build();
    let overlay = Condition(cx.hint_on)
        .then(Container().color(CARD_BG).alignment(Align.Center)
            .child(Text().text_bound(cx.hint).font_size(13.0).color(TEXT_TERTIARY)
                .query_key("viewer/hint").build())
            .build())
        .else_branch(SizedBox(0.0, 0.0).build())
        .build();
    return Container().padding(12.0).color(BG_VIEWER)
        .child(Container().color(CARD_BG).query_key("viewer-card")
            .child(Stack().fit(StackFit.Expand).child(host).child(overlay).build())
            .build())
        .build();
}

// The error panels — the boa RuntimeErrorView / ErrorPanel shape: red
// panel, "!" badge, title + message (the message atom is shared: the
// compile diags and the child's `va_error` land in the same rail).
fn error_view(title_text: str, err: Readable<str>) -> View {
    return Container().color(BG_DANGER).padding(24.0).alignment(Align.Center)
        .child(Column().cross_alignment(CrossAlign.Center)
            .child(Container().width_height(32.0, 32.0).radius(16.0).color(STATUS_ERROR)
                .alignment(Align.Center)
                .child(Text().text("!").font_size(18.0).color(TEXT_INVERSE).build())
                .build())
            .child(SizedBox(0.0, 16.0).build())
            .child(Text().text(title_text).font_size(14.0).color(TEXT_ON_DANGER).build())
            .child(SizedBox(0.0, 8.0).build())
            .child(Text().text_bound(err).font_size(12.0).color(TEXT_ON_DANGER).build())
            .build())
        .build();
}

// The status bar's state label — the Switch rides the app-state atom:
// the failure states read in the status red, everything else in the
// success green (the boa label coloring; the dot leads, text confirms).
fn state_label(cx: AppContext) -> View {
    let ok = Text().text_bound(cx.state).font_size(11.0).color(STATUS_SUCCESS)
        .query_key("app-state").build();
    let err_a = Text().text_bound(cx.state).font_size(11.0).color(STATUS_ERROR)
        .query_key("app-state").build();
    let err_b = Text().text_bound(cx.state).font_size(11.0).color(STATUS_ERROR)
        .query_key("app-state").build();
    return Switch().value(cx.state)
        .cases("error", err_a)
        .cases("compile-error", err_b)
        .fallback(ok)
        .build();
}

// The auto-run toggle — the boa pill with its leading caption: the 11px
// secondary "auto" label, a 6px gap, then the 28x16 capsule with a 12x12
// knob (right when on, left when off). Two pre-built pills over a
// Condition (both branches carry the `autorun` query key; only one
// mounts).
fn auto_toggle(cx: AppContext) -> View {
    let on = PointerInteract().on_click(mutate(fn (ctx: MutationCtx, _e: nil) { b_autorun(ctx, cx); })).query_key("autorun")
        .child(Container().width_height(28.0, 16.0).radius(999.0).color(ACCENT_PRIMARY)
            .child(Stack().fit(StackFit.Expand)
                .child(Positioned().top(2.0).left(14.0)
                    .child(Container().width_height(12.0, 12.0).radius(999.0)
                        .color(TEXT_INVERSE).build())
                    .build())
                .build())
            .build())
        .build();
    let off = PointerInteract().on_click(mutate(fn (ctx: MutationCtx, _e: nil) { b_autorun(ctx, cx); })).query_key("autorun")
        .child(Container().width_height(28.0, 16.0).radius(999.0).color(BG_HOVER)
            .child(Stack().fit(StackFit.Expand)
                .child(Positioned().top(2.0).left(2.0)
                    .child(Container().width_height(12.0, 12.0).radius(999.0)
                        .color(TEXT_INVERSE).build())
                    .build())
                .build())
            .build())
        .build();
    return Row().main_axis_size(MainAxisSize.Min)
        .child(Text().text("auto").font_size(11.0).color(TEXT_SECONDARY)
            .query_key("auto-caption").build())
        .child(SizedBox(6.0, 0.0).build())
        .child(Condition(cx.autorun).then(on).else_branch(off).build())
        .build();
}

// The status bar's auto-run caption ("auto-run on" while the toggle is
// live, the "⌘S to run" keyboard hint otherwise — the boa status bar's
// right cluster).
fn auto_state_text(cx: AppContext) -> View {
    let on = Text().text("auto-run on").font_size(11.0).color(TEXT_TERTIARY)
        .query_key("auto-state").build();
    let off = Text().text("\u{2318}S to run").font_size(11.0).color(TEXT_TERTIARY)
        .query_key("auto-state").build();
    return Condition(cx.autorun).then(on).else_branch(off).build();
}

// The edited pill — a coral dot + "edited", visible only while the editor
// text differs from the last-compiled source.
fn edited_pill(cx: AppContext) -> View {
    let pill = Row().main_axis_size(MainAxisSize.Min)
        .child(SizedBox(12.0, 0.0).build())
        .child(Container().width_height(6.0, 6.0).radius(999.0).color(ACCENT_COMPLEMENT)
            .query_key("edited-pill").build())
        .child(SizedBox(6.0, 0.0).build())
        .child(Text().text("edited").font_size(11.0).color(TEXT_TERTIARY).build())
        .build();
    return Condition(cx.edited).then(pill).else_branch(SizedBox(0.0, 0.0).build()).build();
}

// A layout tab — the segmented control's option. The selected option's
// fill is the tray's selected ink (the brush sources; 0 = transparent); a
// MouseRegion delivers the hover lift (the index rides the shared-cell
// scratch).
fn tab_button(cx: AppContext, label: str, m: Mutation<nil>, key: str, brush: Readable<u64>, idx: u64) -> View {
    return MouseRegion()
        .on_enter(mutate<EnterEvent>(fn (ctx: MutationCtx, _ev: EnterEvent) { tab_enter(ctx, cx, idx); }))
        .on_exit(mutate<ExitEvent>(fn (ctx: MutationCtx, _ev: ExitEvent) { tab_exit(ctx, cx, idx); }))
        .cursor(Cursor.Pointer)
        .child(PointerInteract().on_click(m).query_key(key)
            .child(Container().padding(6.0).radius(4.0).color_bound(brush)
                .child(Text().text(label).font_size(11.0).color(TEXT_SECONDARY).build())
                .build())
            .build())
        .build();
}

// The Split / Edit / View segmented control (the boa toolbar's right
// cluster): a tray with the three tabs.
fn layout_tabs(cx: AppContext) -> View {
    let tray = Row().main_axis_size(MainAxisSize.Min)
        .child(tab_button(cx, "Split", mutate(fn (ctx: MutationCtx, _e: nil) { set_layout(ctx, cx, "split"); }), "tab-split", cx.tab_split, 0))
        .child(tab_button(cx, "Edit", mutate(fn (ctx: MutationCtx, _e: nil) { set_layout(ctx, cx, "edit"); }), "tab-edit", cx.tab_edit, 1))
        .child(tab_button(cx, "View", mutate(fn (ctx: MutationCtx, _e: nil) { set_layout(ctx, cx, "view"); }), "tab-view", cx.tab_view, 2))
        .build();
    return Container().radius(6.0).color(BG_HOVER).padding(2.0).child(tray).build();
}

// A sidebar entry — tapping loads + runs the case. The Each index IS
// the tap id. The row's two brushes (the 3px accent bar + the inset pill
// background) are PER-ROW DERIVES over the shared selection + hover
// sources — the row paints itself whenever the rails move (no sweep, no
// scratch keys). A MouseRegion delivers the hover intents (the
// pointer-region corpus pattern) and the pointer cursor. Geometry = the
// boa NavItem: a 2px gap, then padding-8 around a reserved 3x20 bar, an
// 8px gap and the full-width inset pill (radius 5, padding 7) carrying
// the 13px label — label x ≈ 26.
fn side_item(cx: AppContext, i: u64, name: str) -> View {
    let sel = cx.sel;
    let hov = cx.hover;
    let bar = derive(fn (ctx: DeriveCtx) -> u64 {
        if (ctx.get<f64>(sel) == i as f64) {
            return ACCENT_SOLID;
        }
        return 0;
    });
    let bg = derive(fn (ctx: DeriveCtx) -> u64 {
        let s = ctx.get<f64>(sel) == i as f64;
        let h = ctx.get<f64>(hov) == i as f64;
        if (s) {
            if (h) {
                return BG_STRONG_HOVER;
            }
            return BG_ELEVATED;
        }
        if (h) {
            return BG_HOVER;
        }
        return 0;
    });
    let row = Container().padding(8.0)
        .query_key(f"row/{name}")
        .child(Row().main_axis_size(MainAxisSize.Min)
            // The reserved 3px bar (never clips — boa's trick): teal when
            // selected, transparent otherwise, so the label never shifts.
            .child(Container().width_height(3.0, 20.0).radius(2.0).color_bound(bar).build())
            .child(SizedBox(8.0, 0.0).build())
            .child(Expanded().flex(1.0)
                .child(Container().radius(5.0).padding(7.0).color_bound(bg)
                    .child(Text().text(name).color(TEXT_BODY).font_size(13.0).build())
                    .build())
                .build())
            .build())
        .build();
    let item = MouseRegion()
        .on_enter(mutate<EnterEvent>(fn (ctx: MutationCtx, _ev: EnterEvent) { row_enter(ctx, cx, i); }))
        .on_exit(mutate<ExitEvent>(fn (ctx: MutationCtx, _ev: ExitEvent) { row_exit(ctx, cx, i); }))
        .cursor(Cursor.Pointer)
        .child(PointerInteract().on_click(mutate(fn (ctx: MutationCtx, _e: nil) { case_tap(ctx, cx, i); })).child(row).build())
        .build();
    return Column().cross_alignment(CrossAlign.Stretch)
        .child(SizedBox(0.0, 2.0).build())
        .child(item)
        .build();
}

// The hover intents: entering moves the hover rail (the derives repaint
// the previously-hovered row's lift down and the new row's up); exiting
// drops it — but only if it is THIS row (a batched exit for a stale row
// must not clear the live hover — scrolling under a stationary pointer
// delivers several exits at once). The engine's pointer-region tracker
// orders exit-before-enter across a single sampled move (pinned by the
// corpus race case), so the shared rail can't double-paint.
fn row_enter(ctx: MutationCtx, cx: AppContext, i: u64) {
    ctx.set<f64>(cx.hover, i as f64);
}

fn row_exit(ctx: MutationCtx, cx: AppContext, i: u64) {
    let cur = ctx.get<f64>(cx.hover);
    if (cur == i as f64) {
        ctx.set<f64>(cx.hover, -1.0);
    }
}

fn case_tap(ctx: MutationCtx, mut cx: AppContext, idx: u64) {
    let name = pg_case_name(idx);
    // Select: load the source into the editor controller (highlighted —
    // the case-load rail), then run it. The mounted Input refreshes on the
    // write itself — `TextCtrl.set_text` marks the mounted editable dirty
    // and requests a frame — so no re-mount is needed here (a mid-drain
    // re-mount would wedge the frame's render).
    load_editor(cx, pg_case_source(name));
    ctx.set<str>(cx.selected, f"{name}");
    // The sidebar's selection rail moves; the row brushes re-derive.
    ctx.set<f64>(cx.sel, idx as f64);
    do_run(ctx, cx);
}

// Load `text` into the editor controller and highlight it (the boa
// `setSpans(buildHighlightSpans(...))` load rail). Highlighting runs at
// case load + after a successful Run — NOT per keystroke (the recorded
// phase-D decision): typed text inherits the caret span's color, so the
// highlighting survives edits until the next re-highlight, and a
// per-keystroke apply would churn the layout memo behind the caret for
// every character. The apply keeps the caret, so the auto-run's
// re-highlight never yanks it either.
fn load_editor(cx: AppContext, text: str) {
    cx.ctrl.set_text(text);
    pg_apply_highlight(cx.ctrl.raw(), pg_highlight(text));
}

// The test rail's probe: select + run by sidebar index (the held
// context + the index cross the entry lane).
entry fn select(cx: opaque, i: u64) {
    case_tap(entry_ctx(), probe_cx(cx), i);
}

// The test rail's probe: report the live controller's `va_status` into
// the caller's str atom (the start answer).
entry fn probe(cx: opaque) {
    let c = probe_cx(cx);
    entry_ctx().set<str>(c.state, c.vctrl.status());
}

// Compile the editor's current source; on success destroy the previous
// child and spawn a fresh one under a new controller (the `runCase`
// destroy-then-spawn swap). On failure the viewer flips to the
// compile-error panel and the diagnostics land in the error rail.
fn run_case(ctx: MutationCtx, cx: AppContext) {
    do_run(ctx, cx);
}

fn do_run(ctx: MutationCtx, mut cx: AppContext) {
    let src = cx.ctrl.text();

    let id = pg_compile(src);
    if (id == 0) {
        let diags = pg_compile_diags();
        set_state(ctx, cx, "compile-error");
        ctx.set<str>(cx.verr, diags);
        mark_edited(ctx, cx);
        return;
    }

    // Destroy-then-spawn: retire the previous child (and its status
    // watch), mint the new controller from the compile row's source id,
    // and swap the viewer's reactive `app$` atom — the mounted
    // `VirtualAppView` rebinds in the same flush and the new child
    // spawns. The new controller's status rail is watched in its place.
    cx.vctrl.destroy();
    let vctrl = virtual_app_controller(virtual_app_source_handle(id));
    cx.vctrl = vctrl;
    watch_controller(cx, vctrl);
    virtual_app_set(cx.app_atom, vctrl);

    // A successful Run re-highlights the editor (the compiled source's
    // colors land — the apply keeps the caret where the user left it; the
    // text itself is already current, only the colors refresh).
    pg_apply_highlight(cx.ctrl.raw(), pg_highlight(src));

    // The status rail: spawning (the watch deliveries settle it into
    // ready/error).
    set_state(ctx, cx, "spawning");
    ctx.set<str>(cx.verr, "");
    ctx.set<str>(cx.hint, "starting...");
    ctx.set<bool>(cx.hint_on, true);

    // The compiled baseline moves to the freshly compiled source (the
    // edited pill clears) and the ago clock restarts.
    ctx.set<str>(cx.compiled, src);
    ctx.set<f64>(cx.ago, 0.0);
    mark_edited(ctx, cx);
}

// Reset: restore the selected case's original source into the editor
// controller (highlighted — the same load rail as a selection; the mounted
// editable refreshes on the write) and re-run.
fn reset_case(ctx: MutationCtx, cx: AppContext) {
    let name = ctx.get<str>(cx.selected);
    load_editor(cx, pg_case_source(name));
    do_run(ctx, cx);
}

// ---- the divider's drag rail ----------------------------------------------
// The `pointer-drag` corpus pattern: down records the drag start (the
// shared-cell scratch), move converts the global-x delta into the sidebar
// width (clamped 200–720 px), up releases. The width atom rides the typed
// source; the drag flag gates post-release hover moves (they hit the
// strip too) and drives the while-dragging highlight — the visible band
// turns the brand teal (the boa VDivider: accent bar + tint while
// dragging; the bar covers the whole 8px band, so the teal IS the visible
// state).

fn set_dragging(ctx: MutationCtx, cx: AppContext, on: bool) {
    ctx.set<bool>(cx.dragging, on);
    ctx.set<u64>(cx.div_bar, BORDER_SUBTLE);
    if (on) {
        ctx.set<u64>(cx.div_bar, ACCENT_SOLID);
    }
}

fn div_down(ctx: MutationCtx, mut cx: AppContext, gx: f64) {
    cx.dragx = gx;
    set_dragging(ctx, cx, true);
}

fn div_move(ctx: MutationCtx, mut cx: AppContext, gx: f64) {
    if (!ctx.get<bool>(cx.dragging)) {
        return;
    }
    let dx = gx - cx.dragx;
    cx.dragx = gx;
    let mut w = ctx.get<f64>(cx.sbw) + dx;
    if (w < 200.0) {
        w = 200.0;
    }
    if (w > 720.0) {
        w = 720.0;
    }
    ctx.set<f64>(cx.sbw, w);
}

fn div_up(ctx: MutationCtx, cx: AppContext) {
    set_dragging(ctx, cx, false);
}

// ---- the editor divider's drag rail ----------------------------------------
// The sidebar divider's rail mirrored onto the editor-width atom: down
// records the drag start, move converts the global-x delta into the editor
// width (clamped 360–900), up releases. Its own drag flag gates post-
// release moves and drives the while-dragging highlight (the band turns
// teal). Outside split mode the divider is unmounted, so these intents can
// only fire while the strip is live.

fn set_edragging(ctx: MutationCtx, cx: AppContext, on: bool) {
    ctx.set<bool>(cx.edragging, on);
    ctx.set<u64>(cx.ediv_bar, BORDER_SUBTLE);
    if (on) {
        ctx.set<u64>(cx.ediv_bar, ACCENT_SOLID);
    }
}

fn ediv_down(ctx: MutationCtx, mut cx: AppContext, gx: f64) {
    cx.edragx = gx;
    set_edragging(ctx, cx, true);
}

fn ediv_move(ctx: MutationCtx, mut cx: AppContext, gx: f64) {
    if (!ctx.get<bool>(cx.edragging)) {
        return;
    }
    let dx = gx - cx.edragx;
    cx.edragx = gx;
    let mut w = ctx.get<f64>(cx.edw) + dx;
    if (w < 360.0) {
        w = 360.0;
    }
    if (w > 900.0) {
        w = 900.0;
    }
    ctx.set<f64>(cx.edw, w);
}

fn ediv_up(ctx: MutationCtx, cx: AppContext) {
    set_edragging(ctx, cx, false);
}

// The auto-run toggle. Turning auto-run OFF also cancels any pending
// debounced run.
fn b_autorun(ctx: MutationCtx, mut cx: AppContext) {
    let on = ctx.get<bool>(cx.autorun);
    ctx.set<bool>(cx.autorun, !on);
    if (!on) {
        return;
    }
    cx.debounce.stop();
}

// The layout tabs.
//
// Wasm note (phase-4 P0 audit, 2026-10-05): an earlier session reported a
// worker-side `passStringToWasm0(undefined)` crash on the View switch plus
// a Run/Reset spawn hang. Neither reproduces on a fresh build: the layout
// switch is pure rut (a `Switch` on the layout atom below — no JS↔wasm
// string crosses it; the only string-taking exports on the website surface
// are `create_in` / `createWithBackground` / `loadAndRunRutModule`, all
// boot-time), and Run/Reset re-run instantly through the same
// destroy-then-spawn swap as a case-row tap (pinned natively by the
// `playground_run_button_reruns_the_case` / `playground_reset_restores_…`
// tests). Verified manually on a fresh wasm build: boot → View → Split →
// Run → Reset with a live child, plus typed edits under auto-run — no
// overlay, no hang, viewer intact throughout.
// The tab hover intents (the segmented control's per-tab lift — the boa
// LayoutButton): entering marks the index, exiting clears it; all three
// brushes repaint either way.
fn tab_enter(ctx: MutationCtx, mut cx: AppContext, i: u64) {
    cx.tab_h = i as f64;
    repaint_tabs(ctx, cx);
}

fn tab_exit(ctx: MutationCtx, mut cx: AppContext, i: u64) {
    let cur = cx.tab_h;
    cx.tab_h = -1.0;
    if (cur == i as f64) {
        repaint_tabs(ctx, cx);
    }
}

fn repaint_tabs(ctx: MutationCtx, cx: AppContext) {
    paint_tab(ctx, cx, 0, cx.tab_split);
    paint_tab(ctx, cx, 1, cx.tab_edit);
    paint_tab(ctx, cx, 2, cx.tab_view);
}

// One tab's brush: the tray shows through when idle (transparent), the
// selected ink when active, the hover ink when lifted (the boa
// controlTray / controlSelected / controlTrayHover law).
fn paint_tab(ctx: MutationCtx, cx: AppContext, idx: u64, brush: Readable<u64>) {
    let mode = ctx.get<str>(cx.layout);
    let mut selected = false;
    if (idx == 0 && mode == "split") {
        selected = true;
    }
    if (idx == 1 && mode == "edit") {
        selected = true;
    }
    if (idx == 2 && mode == "view") {
        selected = true;
    }
    let hovered = cx.tab_h == idx as f64;
    ctx.set<u64>(brush, 0);
    if (selected) {
        ctx.set<u64>(brush, BG_APP);
    }
    if (!selected && hovered) {
        ctx.set<u64>(brush, BG_STRONG_HOVER);
    }
}

fn set_layout(ctx: MutationCtx, cx: AppContext, mode: str) {
    ctx.set<str>(cx.layout, mode);
    repaint_tabs(ctx, cx);
}

// The on-input intent (the `input_on_input` rail): recompute the edited
// pill, and with auto-run on restart the debounced recompile+respawn —
// a 500 ms one-shot animation controller that a newer edit stops
// (cancellation = stop; no generation guard needed).
fn on_edit(ctx: MutationCtx, mut cx: AppContext) {
    mark_edited(ctx, cx);
    cx.debounce.stop();
    if (ctx.get<bool>(cx.autorun)) {
        cx.debounce.forward();
    }
}

// The debounce window elapsed: recompile + respawn the editor's source.
fn on_debounce_end(ctx: MutationCtx, cx: AppContext) {
    do_run(ctx, cx);
}

fn mark_edited(ctx: MutationCtx, cx: AppContext) {
    let text = cx.ctrl.text();
    let dirty = text != ctx.get<str>(cx.compiled);
    ctx.set<bool>(cx.edited, dirty);
}

// The "compiled Xs ago" clock: a 1 Hz one-shot that restarts itself (the
// status bar's derive re-formats the label — no polling anywhere else).
fn on_clock_end(ctx: MutationCtx, mut cx: AppContext) {
    ctx.set<f64>(cx.ago, ctx.get<f64>(cx.ago) + 1.0);
    cx.clock.forward();
}

fn fmt_ago(v: f64) -> str {
    if (v < 5.0) {
        return f"compiled just now";
    }
    return f"compiled {v as u64}s ago";
}

// The status-watch delivery (the boa-model Watch: the cb reads the
// watched rail through its ctx). The live rail settles the viewer atoms —
// the boa FallbackView / RuntimeError states. Stale rails can't fire: a
// swap stops the old Watch before the old child's final write flushes.
fn on_vstat(ctx: MutationCtx, cx: AppContext, stat: Readable<str>, vctrl: VAppCtrl) {
    let s = ctx.get<str>(stat);
    if (s == "running") {
        set_state(ctx, cx, "ready");
        ctx.set<bool>(cx.hint_on, false);
        ctx.set<str>(cx.hint, "");
    }
    if (s == "error") {
        let msg = vctrl.error();
        ctx.set<str>(cx.verr, msg);
        set_state(ctx, cx, "error");
        ctx.set<bool>(cx.hint_on, false);
        ctx.set<str>(cx.hint, "");
    }
}

// The app-state atom + the status-dot brush move together (red only for
// the failure states — spawning/ready stay green, the boa dot law).
fn set_state(ctx: MutationCtx, cx: AppContext, s: str) {
    ctx.set<str>(cx.state, s);
    ctx.set<u64>(cx.dot, STATUS_SUCCESS);
    if (s == "error") {
        ctx.set<u64>(cx.dot, STATUS_ERROR);
    }
    if (s == "compile-error") {
        ctx.set<u64>(cx.dot, STATUS_ERROR);
    }
}

