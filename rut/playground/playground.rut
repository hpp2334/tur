// The tur playground — one rut module (the Phase-4 rewrite of the
// playground-view bundle). Layout: a toolbar above a case-list sidebar
// beside an editor pane and a viewer pane, above a status bar —
// selecting a case loads its source into the editor (a multiline Input on
// a realm-minted controller) and RUNS it — `run_case` compiles through
// the host `pg_compile` row (which registers the source Rust-side and
// answers its id), destroys the previous child and spawns a fresh one
// under a new controller (the `runCase` destroy-then-spawn swap). The
// viewer hosts the child through a bound `VirtualAppView`; each
// controller's `va_status` rail is a watchable atom (`va_status_atom` +
// `rs_watch`) whose deliveries settle the viewer's state Switch (the boa
// viewer's FallbackView / RuntimeError shapes). Boot auto-selects
// `counter` (the boa INITIAL_CASE): the editor loads its source, the
// viewer renders and the status settles to ready without a tap.
//
// Editor highlighting: `pg_highlight` classifies the source through the
// upstream rut-semantic classifier (Rust-side — token classes plus AST
// name classes: fn/method names and call callees blue, types violet,
// keywords teal, true/false/nil brown, strings / comments / numbers in the
// boa palette; broken source degrades to token classes — never a wrong
// color) and `pg_apply_highlight` writes the colored spans into the
// editor controller — at case load + after a successful Run, matching the
// boa buildHighlightSpans rail. NOT per keystroke (the recorded phase-D
// decision): typed text inherits the caret span's color, so the
// highlighting survives edits until the next re-highlight, and the
// caret-preserving apply never yanks the caret.
//
// Toolbar (48px, the boa metrics): the compact Run + Reset buttons
// (padding-6 content-sized bodies carrying the ▶ / ↻ icon resources —
// SVGs rasterised once at boot through `img_res_svg`) with the "auto"
// captioned auto-run toggle (debounced recompile+respawn on edit — the
// `input_on_input` intent restarts a 500 ms one-shot animation
// controller; a newer edit stops it) and the Split/Edit/View layout tabs
// (the hidden pane shells into a zero-width container — the boa trick).
//
// Status bar (~20px over a 1px top border): the state dot + label
// (ready / spawning / error / compile-error — the same atom the viewer's
// Switch reads; the label colors ride the status greens/reds), the edited
// pill (`tctrl_text` vs the last-compiled source, recomputed on the
// on-input intent — no polling), `compiled Xs ago` (a 1 Hz
// animation-driven clock), the auto-run state (or the "⌘S to run" hint
// while the toggle is off) and the version.
//
// Sidebar polish (phase E + the phase-2 chrome pass): a CASES header
// (10px tertiary label + the registry count) over the list; each row owns
// two brush atoms — the reserved 3px accent bar (teal when selected,
// transparent otherwise: the label never shifts) and the full-width inset
// pill (the boa ink law: hover ink.200, selected ink.150, selected +
// hovered ink.300) — painted by `apply_row` from the selection + hover
// indices; a per-row MouseRegion delivers `row_enter` / `row_exit` (the
// pointer-region corpus pattern) and the pointer cursor. The toolbar's
// Run / Reset buttons and the layout tabs carry the same hover rail.
//
// Dividers: a visible 8px band (the ink.300 border ink) on BOTH pane
// boundaries — the sidebar↔editor one and the editor↔viewer one (the
// boa VDivider shape — col-resize cursor, the band turning brand teal
// while dragging; the second one mounts only in split mode). The first
// drag rail resizes the sidebar-width atom (clamped 200–720 px, the boa
// 200 seed), the second the editor-width atom (clamped 360–900 px) —
// the `pointer-drag` corpus pattern, width atoms riding the id rail.
//
// The case registry (`pg_case_count` / `pg_case_name` / `pg_case_source`)
// is generated by scripts/gen-cases.cjs into cases_gen.rut and concatenated
// after this module by the website's `playgroundSource()`.
// Timers ride the animation subsystem (Rust-held `anim_ctrl` controllers
// ticked by the engine): the "compiled Xs ago" clock is a 1 Hz self-
// restarting one-shot, and the auto-run debounce is a 500 ms one-shot
// restarted on every edit (`anim_stop` = cancellation). The async weave
// (`launch_future` / `sleep`) is native-only — on wasm an async import
// fails the compile.
use tur::{ ALIGN_CENTER, anim_forward, anim_stop, AXIS_VERTICAL, CLIP_HARD_EDGE,
    CROSS_ALIGN_CENTER, CROSS_ALIGN_STRETCH, CURSOR_COL_RESIZE, CURSOR_POINTER, ctx_bridge,
    img_res_svg, MAIN_ALIGN_SPACE_BETWEEN, MAIN_SIZE_MIN, STACK_FIT_EXPAND, mem_get, mem_new,
    mem_set, mount, pg_apply_highlight, pg_case_count, pg_case_name, pg_case_source, pg_compile,
    pg_compile_diags, pg_highlight, rs_get_bool, rs_get_f64, rs_get_str,
    rs_list_new, rs_list_push, rs_set_bool, rs_set_brush, rs_set_f64, rs_set_str, rs_source_bool,
    rs_source_f64, rs_source_str, rs_source_value, rs_watch_start, rs_watch_stop,
    st_put, stf_put, stf_take, va_app_atom,
    va_app_set, va_create_source, va_source_handle };
use tur_anim_kit::{ AnimCtrl, anim_ctrl_end };
use tur_kit::{ Column, Condition, Container, Each, EnterEvent, Expanded, Image, Input, InputEvent, MouseRegion, Mutation, MutationCtx, PointerEvent, PointerInteract, Positioned, Readable, Row, ScrollView, SizedBox, Source, Stack, Switch, TaskCtx, Text, TextCtrl, UndoCtrl, VAppCtrl, VirtualApp, mutate, rs_derive, rs_watch, text_ctrl, undo_ctrl, virtual_app_controller };

// The handle rebuilders: the raw substrate atom ids cross the stash slots
// (the module's state rail); the kit's bound props take the typed
// handles. The stamp spells the boxed rail's f64 number lane (1 — the
// kit's STAMP_NUM_F64; only the numeric lane reads it, and these raw
// atoms are str/bool/opaque lanes).
fn sr(atom: u64) -> Readable<str> {
    return Source<str>.of(ctx_bridge(), atom, false, 1);
}

fn fr(atom: u64) -> Readable<f64> {
    return Source<f64>.of(ctx_bridge(), atom, false, 1);
}

fn br(atom: u64) -> Readable<bool> {
    return Source<bool>.of(ctx_bridge(), atom, false, 1);
}

// The brush lane (the packed color rides the u64 number width now; the
// stamp spells the boxed rail's u64 lane — the kit's STAMP_NUM_U64).
fn bru(atom: u64) -> Readable<u64> {
    return Source<u64>.of(ctx_bridge(), atom, false, 2);
}

fn op(atom: u64) -> Readable<opaque> {
    return Source<opaque>.of(ctx_bridge(), atom, false, 1);
}

// ---- design tokens ---------------------------------------------------------
//
// The light theme from rut/playground/DESIGN-SYSTEM.md §1.1/§2 — the
// single source of truth for visual decisions (the boa reference palette:
// warm-tinted ink neutrals + the saturated teal signature + the coral
// complement + AA-verified status colors).
//
// Every value is a u64 packed **0xRRGGBBAA** (opaque = `| 0xFF`) — the kit
// header's color law, pinned natively by
// `libs/tur-integration-tests/tests/element/color_packing_law.rs`. The
// primitive palette (INK_* / TEAL_* / CORAL_* / STATUS_*) is the raw
// material; the views below use only the semantic layer (BG_* / TEXT_* /
// ACCENT_*), never a primitive directly. Module `let` initializers must be
// literals in this build, so the semantic layer restates the primitive's
// packed value (its origin is in the trailing comment) instead of aliasing.

// primitives — ink (warm-tinted neutrals)
let INK_50: u64 = 0xFBFCFDFFu64;
let INK_100: u64 = 0xF4F6F9FFu64;
let INK_150: u64 = 0xECEFF4FFu64;
let INK_200: u64 = 0xE1E5ECFFu64;
let INK_300: u64 = 0xD4D9E0FFu64;
let INK_400: u64 = 0xB8C0CCFFu64;
let INK_500: u64 = 0x8A94A3FFu64;
let INK_600: u64 = 0x5E6878FFu64;
let INK_700: u64 = 0x3A4250FFu64;
let INK_800: u64 = 0x1F2530FFu64;
let INK_900: u64 = 0x0A0E14FFu64;

// primitives — teal (the saturated cyan-leaning signature)
let TEAL_200: u64 = 0x7DF5D0FFu64;
let TEAL_300: u64 = 0x00E8B8FFu64;
let TEAL_400: u64 = 0x00C69AFFu64;
let TEAL_500: u64 = 0x00A886FFu64;
let TEAL_600: u64 = 0x008A6EFFu64;
let TEAL_700: u64 = 0x006E58FFu64;
let TEAL_800: u64 = 0x005440FFu64;

// primitives — coral (the warm complement; used sparingly)
let CORAL_300: u64 = 0xFFB3A3FFu64;
let CORAL_400: u64 = 0xFF8A72FFu64;
let CORAL_500: u64 = 0xE85D44FFu64;
let CORAL_700: u64 = 0xB03A1FFFu64;

// primitives — status (AA on ink.50; info reuses teal.700)
let STATUS_SUCCESS: u64 = 0x00A06BFFu64;
let STATUS_WARNING: u64 = 0xC47700FFu64;
let STATUS_ERROR: u64 = 0xD63A2FFFu64;
let STATUS_INFO: u64 = 0x006E58FFu64;

// semantic layer — what the views use (origin primitives in the comments)
let BG_APP: u64 = 0xFBFCFDFFu64; // ink.50
let BG_PANEL: u64 = 0xF4F6F9FFu64; // ink.100
let BG_ELEVATED: u64 = 0xECEFF4FFu64; // ink.150
let BG_HOVER: u64 = 0xE1E5ECFFu64; // ink.200 (bg.hover / bg.controlTray)
let BG_STRONG_HOVER: u64 = 0xD4D9E0FFu64; // ink.300 (bg.strongHover)
let BG_SELECTED: u64 = 0x7DF5D0FFu64; // teal.200
let BG_CODE: u64 = 0xFBFCFDFFu64; // ink.50
let BG_VIEWER: u64 = 0xFBFCFDFFu64; // ink.50 (bg.viewer)
let BG_DANGER: u64 = 0xFFF0EEFFu64; // #fff0ee (bg.danger)
let TEXT_PRIMARY: u64 = 0x1F2530FFu64; // ink.800
let TEXT_BODY: u64 = 0x3A4250FFu64; // ink.700
let TEXT_SECONDARY: u64 = 0x5E6878FFu64; // ink.600
let TEXT_TERTIARY: u64 = 0x8A94A3FFu64; // ink.500
let TEXT_PLACEHOLDER: u64 = 0xB8C0CCFFu64; // ink.400
let TEXT_CODE: u64 = 0x1F2530FFu64; // ink.800 (code.fg)
let TEXT_ON_ACCENT: u64 = 0x0A0E14FFu64; // ink.900 (text.onAccent)
let TEXT_ON_DANGER: u64 = 0x8A1A14FFu64; // #8a1a14 (text.onDanger)
let TEXT_INVERSE: u64 = 0xFBFCFDFFu64; // ink.50 (text.inverse)
let BORDER_SUBTLE: u64 = 0xD4D9E0FFu64; // ink.300 (border.subtle)
let ACCENT_CURSOR: u64 = 0x00A886FFu64; // teal.500
let ACCENT_PRIMARY: u64 = 0x00C69AFFu64; // teal.400
let BTN_PRIMARY_HOVER: u64 = 0x00E8B8FFu64; // teal.300 (bg.button.primaryHover)
let BTN_GHOST: u64 = 0xFBFCFDFFu64; // ink.50 (bg.button.ghost)
let ACCENT_SOLID: u64 = 0x00A886FFu64; // teal.500 (the brand mark)
let ACCENT_COMPLEMENT: u64 = 0xFF8A72FFu64; // coral.400 (the edited dot)
// The viewer's inset card (the boa build measures (248,250,252) inside the
// ink.50 pane — the ink.100-family card surface the case renders on).
let CARD_BG: u64 = 0xF8FAFCFFu64; // #f8fafc

// The toolbar's icon resources — the boa icons.ts SVGs (the ▶ / ↻ pair),
// rasterised once at boot through `img_res_svg` and laid out at 10 / 12 px
// like the reference buttons.
let RUN_ICON_SVG: str = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#ffffff\"><polygon points=\"6 4 20 12 6 20\"/></svg>";
let RESET_ICON_SVG: str = "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#3A4250\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"1 4 1 10 7 10\"/><path d=\"M3.51 15a9 9 0 1 0 2.13-9.36L1 10\"/></svg>";


let K_CTRL: u64 = 1;
let K_SELECTED: u64 = 2;
let K_NAMES: u64 = 3;
let K_STATE: u64 = 4;
let K_VCTRL: u64 = 5;
let K_VERR: u64 = 6;
let K_HINT: u64 = 8;
let K_APP: u64 = 10;
let K_HINTON: u64 = 11;
let K_VSTAT: u64 = 12;
let K_WATCH: u64 = 13;
let K_EDITED: u64 = 14;
let K_AUTORUN: u64 = 15;
let K_LAYOUT: u64 = 16;
let K_AGO: u64 = 17;
let K_COMPILED: u64 = 18;
let K_DOT: u64 = 19;
let K_GEN: u64 = 20;
let K_TAB_SPLIT: u64 = 21;
let K_TAB_EDIT: u64 = 22;
let K_TAB_VIEW: u64 = 23;
let K_CLOCK: u64 = 24;
let K_DEBOUNCE: u64 = 25;
// Phase E rails: the sidebar width atom, the divider's drag state + brush,
// the drag scratch cell, the selection/hover indices, the toolbar buttons'
// hover brushes, the hovered tab index — and the per-row brush base (row i
// paints bar `K_ROW0 + i*2`, background `K_ROW0 + i*2 + 1`).
let K_SBW: u64 = 26;
let K_DRAGGING: u64 = 27;
let K_DIVBAR: u64 = 28;
let K_DRAGX: u64 = 29;
let K_SELIDX: u64 = 30;
let K_HOVERI: u64 = 31;
let K_TABH: u64 = 32;
let K_RUNH: u64 = 33;
let K_RESETH: u64 = 34;
// Phase-4 P0 rails: the editor↔viewer divider — the editor-width atom
// (seed 600, clamped 360–900), its drag flag + brush and its drag
// scratch cell (the same shape as the sidebar divider's rail above).
let K_EDW: u64 = 35;
let K_EDRAGGING: u64 = 36;
let K_EDIVBAR: u64 = 37;
let K_EDRAGX: u64 = 38;
// The toolbar icons' resource ids (minted once at boot — see the SVGs
// above).
let K_RUNICON: u64 = 39;
let K_RESETICON: u64 = 40;
let K_ROW0: u64 = 1000;

entry fn start() -> u64 {
    // The sidebar's case list (from the generated registry).
    let names = rs_list_new();
    let n = pg_case_count();
    let mut i = 0;
    while (i < n as i32) {
        rs_list_push(names, pg_case_name(i as u64));
        i += 1;
    }
    let names_atom = rs_source_value(names);
    stf_put(K_NAMES, names_atom as f64);

    let selected = rs_source_str("");
    stf_put(K_SELECTED, selected as f64);
    let ctrl = text_ctrl();
    st_put(K_CTRL, ctrl.raw());

    // The app-state rail: the status bar's dot + label AND the viewer's
    // state Switch both read it (the watch deliveries settle it).
    let state = rs_source_str("ready");
    let verr = rs_source_str("");
    let hint = rs_source_str("(no case)");
    let hint_on = rs_source_bool(true);
    let app_atom = va_app_atom();
    stf_put(K_STATE, state as f64);
    stf_put(K_VERR, verr as f64);
    stf_put(K_HINT, hint as f64);
    stf_put(K_HINTON, hint_on as f64);
    stf_put(K_APP, app_atom as f64);

    // The toolbar/status rails: the edited pill, auto-run (boa default
    // ON), the layout mode, the compiled-ago clock, the last-compiled
    // baseline (the edited comparison), the status-dot brush and the
    // debounce generation cell.
    let edited = rs_source_bool(false);
    let autorun = rs_source_bool(true);
    let layout = rs_source_str("split");
    let ago = rs_source_f64();
    let compiled = rs_source_str("");
    let dot = rs_source_value(rs_list_new());
    let tab_split_brush = rs_source_value(rs_list_new());
    let tab_edit_brush = rs_source_value(rs_list_new());
    let tab_view_brush = rs_source_value(rs_list_new());
    rs_set_brush(dot, STATUS_SUCCESS);
    rs_set_brush(tab_split_brush, BG_APP);
    stf_put(K_EDITED, edited as f64);
    stf_put(K_AUTORUN, autorun as f64);
    stf_put(K_LAYOUT, layout as f64);
    stf_put(K_AGO, ago as f64);
    stf_put(K_COMPILED, compiled as f64);
    stf_put(K_DOT, dot as f64);
    stf_put(K_TAB_SPLIT, tab_split_brush as f64);
    stf_put(K_TAB_EDIT, tab_edit_brush as f64);
    stf_put(K_TAB_VIEW, tab_view_brush as f64);

    // The timers (animation controllers — the wasm-safe rail): the ago
    // clock starts now; the debounce waits for the first edit.
    let clock = anim_ctrl_end(1000.0, "linear", 0, mutate(fn (_ctx: MutationCtx, _e: nil) { on_clock_end(); }));
    st_put(K_CLOCK, clock.raw());
    clock.forward();
    st_put(K_DEBOUNCE, anim_ctrl_end(500.0, "linear", 0, mutate(fn (_ctx: MutationCtx, _e: nil) { on_debounce_end(); })).raw());

    // The phase-E rails: the sidebar width (the divider's atom — the clamp
    // lives in the drag intent; the boa seed is 200), the divider's drag
    // brush, the drag scratch cell, the selection/hover indices (−1 =
    // none), the hovered tab index and the toolbar buttons' hover brushes.
    let sbw = rs_source_f64();
    rs_set_f64(sbw, 200.0);
    stf_put(K_SBW, sbw as f64);
    let dragging = rs_source_bool(false);
    stf_put(K_DRAGGING, dragging as f64);
    let div_bar = rs_source_value(rs_list_new());
    rs_set_brush(div_bar, BORDER_SUBTLE);
    stf_put(K_DIVBAR, div_bar as f64);
    st_put(K_DRAGX, mem_new(0.0));

    // The phase-4 P0 rails: the editor↔viewer divider (the boa
    // editorWidth$ — the split-mode editor pane rides this atom, the
    // drag intent clamps 360–900).
    let edw = rs_source_f64();
    rs_set_f64(edw, 600.0);
    stf_put(K_EDW, edw as f64);
    let edragging = rs_source_bool(false);
    stf_put(K_EDRAGGING, edragging as f64);
    let ediv_bar = rs_source_value(rs_list_new());
    rs_set_brush(ediv_bar, BORDER_SUBTLE);
    stf_put(K_EDIVBAR, ediv_bar as f64);
    st_put(K_EDRAGX, mem_new(0.0));
    stf_put(K_SELIDX, -1.0);
    stf_put(K_HOVERI, -1.0);
    stf_put(K_TABH, -1.0);
    let run_h = rs_source_value(rs_list_new());
    rs_set_brush(run_h, ACCENT_PRIMARY);
    stf_put(K_RUNH, run_h as f64);
    let reset_h = rs_source_value(rs_list_new());
    rs_set_brush(reset_h, BTN_GHOST);
    stf_put(K_RESETH, reset_h as f64);

    // The toolbar icons: rasterise the boa SVGs once (the ids ride the
    // stash into build_ui).
    stf_put(K_RUNICON, img_res_svg(RUN_ICON_SVG) as f64);
    stf_put(K_RESETICON, img_res_svg(RESET_ICON_SVG) as f64);

    // The controller stash starts seeded with a never-bound sentinel (an
    // empty module) so `run_case`'s destroy-then-spawn can unconditionally
    // `va_destroy` the stashed controller — and the status watch has a
    // rail to ride until the first run swaps in the real one.
    let seed = va_create_source("use tur::{ mount };\nentry fn start() {\n}\n");
    let seed_ctrl = virtual_app_controller(seed);
    st_put(K_VCTRL, seed_ctrl.raw());
    watch_controller(seed_ctrl);

    build_ui();

    // Boot selection (the boa INITIAL_CASE): select + run `counter` so the
    // editor loads its source, the viewer renders the case and the status
    // settles to ready without a tap.
    let mut boot = 0;
    let mut i = 0;
    while (i < n as i32) {
        if (pg_case_name(i as u64) == "counter") {
            boot = i;
        }
        i += 1;
    }
    case_tap(boot as u64);
    return state;
}

// Watch the controller's status rail (`va_status_atom` + `rs_watch`):
// the transitions deliver as intents into `on_vstat`, which settles the
// viewer's state atoms.
fn watch_controller(vctrl: VAppCtrl) {
    let stat = vctrl.status_atom();
    stf_put(K_VSTAT, stat as f64);
    let watch = rs_watch(stat, on_vstat, 0);
    rs_watch_start(watch);
    st_put(K_WATCH, watch);
}

// The whole tree, built at start. A fresh Input mounts per build; on
// selection the controller write refreshes the mounted editable in place
// (see `case_tap`).
fn build_ui() {
    let names_atom = stf_take(K_NAMES) as u64;
    let ctrl = TextCtrl(st_take(K_CTRL));
    let selected = stf_take(K_SELECTED) as u64;
    let state = stf_take(K_STATE) as u64;
    let verr = stf_take(K_VERR) as u64;
    let hint = stf_take(K_HINT) as u64;
    let hint_on = stf_take(K_HINTON) as u64;
    let app_atom = stf_take(K_APP) as u64;
    let edited = stf_take(K_EDITED) as u64;
    let autorun = stf_take(K_AUTORUN) as u64;
    let layout = stf_take(K_LAYOUT) as u64;
    let ago = stf_take(K_AGO) as u64;
    let dot = stf_take(K_DOT) as u64;
    let tab_split_brush = stf_take(K_TAB_SPLIT) as u64;
    let tab_edit_brush = stf_take(K_TAB_EDIT) as u64;
    let tab_view_brush = stf_take(K_TAB_VIEW) as u64;

    // ---- sidebar ------------------------------------------------------
    // The width rides the divider's atom (`K_SBW`); the rows paint their
    // own selection/hover brushes (see `side_item` / `apply_row`). Above
    // the list: the CASES header (the boa SidebarHeader — 10px tertiary
    // label + the registry count, space-between).
    let sbw = stf_take(K_SBW) as u64;
    stf_put(K_SBW, sbw as f64);
    let cases_header = Container().padding(14.0)
        .child(Row().main_alignment(MAIN_ALIGN_SPACE_BETWEEN)
            .child(Text().text("CASES").font_size(10.0).color(TEXT_TERTIARY).build())
            .child(Text().text(f"{pg_case_count()}").font_size(10.0).color(TEXT_TERTIARY)
                .query_key("cases-count").build())
            .build())
        .build();
    let sidebar = Container().width_bound(fr(sbw)).color(BG_PANEL).query_key("sidebar")
        .child(Column().cross_alignment(CROSS_ALIGN_STRETCH)
            .child(cases_header)
            .child(Expanded().flex(1.0)
                .child(ScrollView().axis(AXIS_VERTICAL)
                    .child(Column().cross_alignment(CROSS_ALIGN_STRETCH)
                        .child(Each(op(names_atom)).item_builder(side_item).build()).build())
                    .build())
                .build())
            .build())
        .build();

    // ---- toolbar --------------------------------------------------------
    // Brand (left) — case name (center, expands) — actions (right): Run,
    // Reset, the auto-run toggle and the Split/Edit/View tabs (the boa
    // tab cluster sits on the toolbar's right side).
    let brand = Container().padding(12.0)
        .child(Row().main_axis_size(MAIN_SIZE_MIN)
            .child(Text().text("tur").font_size(14.0).color(ACCENT_SOLID).build())
            .child(SizedBox(4.0, 0.0).build())
            .child(Text().text("playground").font_size(11.0).color(TEXT_SECONDARY).build())
            .build())
        .build();
    let case_name = Container().padding(12.0)
        .child(Expanded().flex(1.0)
            .child(Text().text_bound(sr(selected)).font_size(13.0).color(TEXT_BODY)
                .query_key("case-name").build())
            .build())
        .build();
    // The action buttons carry hover brushes (MouseRegion enter/exit — the
    // same rail the sidebar rows ride): Run brightens to teal.300, Reset
    // lifts from the ghost ink to the hover ink (the boa button rails).
    // Compact content-sized buttons (padding 6, radius 6) with the ▶ / ↻
    // icons at 10 / 12 px — the boa RunButton / ResetButton metrics.
    let run_h = stf_take(K_RUNH) as u64;
    stf_put(K_RUNH, run_h as f64);
    let reset_h = stf_take(K_RESETH) as u64;
    stf_put(K_RESETH, reset_h as f64);
    let run_icon = stf_take(K_RUNICON) as u64;
    stf_put(K_RUNICON, run_icon as f64);
    let reset_icon = stf_take(K_RESETICON) as u64;
    stf_put(K_RESETICON, reset_icon as f64);
    let run = MouseRegion()
        .on_enter(mutate<EnterEvent>(fn (_ctx: MutationCtx, _ev: EnterEvent) { run_hover_on(run_h); }))
        .on_exit(mutate<ExitEvent>(fn (_ctx: MutationCtx, _ev: ExitEvent) { run_hover_off(run_h); }))
        .cursor(CURSOR_POINTER)
        .child(PointerInteract().on_click(mutate(fn (_ctx: MutationCtx, _e: nil) { run_case(); })).query_key("run")
            .child(Container().padding(6.0).radius(6.0).color_bound(bru(run_h))
                .child(Row().main_axis_size(MAIN_SIZE_MIN)
                    .child(Image(run_icon).width(10.0).height(10.0).build())
                    .child(SizedBox(4.0, 0.0).build())
                    .child(Text().text("Run").color(TEXT_ON_ACCENT).font_size(12.0).build())
                    .build())
                .build())
            .build())
        .build();
    let reset = MouseRegion()
        .on_enter(mutate<EnterEvent>(fn (_ctx: MutationCtx, _ev: EnterEvent) { reset_hover_on(reset_h); }))
        .on_exit(mutate<ExitEvent>(fn (_ctx: MutationCtx, _ev: ExitEvent) { reset_hover_off(reset_h); }))
        .cursor(CURSOR_POINTER)
        .child(PointerInteract().on_click(mutate(fn (_ctx: MutationCtx, _e: nil) { reset_case(); })).query_key("reset")
            .child(Container().padding(6.0).radius(6.0).color_bound(bru(reset_h))
                .child(Row().main_axis_size(MAIN_SIZE_MIN)
                    .child(Image(reset_icon).width(12.0).height(12.0).build())
                    .child(SizedBox(4.0, 0.0).build())
                    .child(Text().text("Reset").color(TEXT_SECONDARY).font_size(12.0).build())
                    .build())
                .build())
            .build())
        .build();
    let actions = Row().main_axis_size(MAIN_SIZE_MIN)
        .child(run)
        .child(SizedBox(6.0, 0.0).build())
        .child(reset)
        .child(SizedBox(12.0, 0.0).build())
        .child(auto_toggle(autorun))
        .child(SizedBox(12.0, 0.0).build())
        .child(layout_tabs(tab_split_brush, tab_edit_brush, tab_view_brush))
        .child(SizedBox(12.0, 0.0).build())
        .build();
    let toolbar = Container().width_height(0.0, 48.0).color(BG_ELEVATED)
        .border(BORDER_SUBTLE, 1.0, BORDER_INSIDE).query_key("toolbar")
        .child(Row()
            .child(brand)
            .child(Expanded().flex(1.0).child(case_name).build())
            .child(actions)
            .build())
        .build();

    // ---- editor pane ----------------------------------------------------
    // The `input_on_input` rail: every user edit delivers `on_edit` (the
    // edited pill + the debounced auto-run). Programmatic controller
    // writes (`tctrl_set_text` in case_tap / reset_case) do NOT fire it.
    // The editable fills the pane (a stretch column — no hardcoded width,
    // so the hidden zero-width shell truly collapses it). Monospace 13 —
    // the boa editor's face (uniform glyphs keep the caret math honest).
    // THE BOA SCROLL ARCHITECTURE: the editor never scrolls ITSELF — it
    // hugs its content (no hardcoded height, so the scroll extent grows
    // with the text) inside a pane-filling ScrollView, which owns the
    // scrolling: clamped to content − viewport (a fitting source cannot
    // scroll), push_clip'd (scrolled lines never leave the pane), and the
    // caret-follow rides `ensure_caret_visible`'s ScrollView branch. The
    // self-scroller inside the editable stays at 0 the whole time.
    let editor = Input().controller(ctrl).undo(undo_ctrl()).placeholder("select a case…")
        .color(TEXT_CODE).placeholder_color(TEXT_PLACEHOLDER).cursor_color(ACCENT_CURSOR)
        .font_family("monospace").font_size(13.0)
        .multiline(true).on_input(mutate<InputEvent>(fn (_ctx: MutationCtx, _ev: InputEvent) { on_edit(); }))
        .query_key("editor").build();
    let editor_pane = Container().color(BG_CODE).padding(12.0).query_key("editor-pane")
        .child(ScrollView().axis(AXIS_VERTICAL).query_key("editor-scroll")
            .child(Column().cross_alignment(CROSS_ALIGN_STRETCH).child(editor).build())
            .build())
        .build();

    // ---- viewer pane ----------------------------------------------------
    // The boa Viewer shape: the pane is the ink.50 surface and the READY
    // branch renders the case inside an inset card — padding 12 of pane
    // around the card background (`CARD_BG`, the measured (248,250,252)),
    // the VirtualAppView host filling the card. The error branches are
    // full-bleed (the boa ErrorPanel — no card). The Switch replaces the
    // viewer only on FAILURE; the fallback keeps the `VirtualAppView`
    // mounted so the bound controller always has a host to spawn into.
    // The "(no case)" / "starting..." hint is the FallbackView shape — an
    // overlay the child's first frame paints over (the Condition drops it
    // once the child settles).
    let viewer_pane = Container().color(BG_VIEWER).query_key("viewer-pane")
        .child(Switch().value(sr(state))
            .cases("error", error_view("Runtime error", verr))
            .cases("compile-error", error_view("Compile error", verr))
            .fallback(ready_viewer(app_atom, hint, hint_on))
            .query_key("viewer-switch")
            .build())
        .build();

    // ---- pane slots (the layout modes) ----------------------------------
    // Split: the editor pane carries the fixed editor-width atom (the
    // second divider's drag target — the boa `Container().width(
    // editorWidth$)`), the viewer is Expanded. Edit: the editor fills the
    // row and the viewer shells into a zero-width container; View: the
    // editor does (the boa shell trick — the hidden pane stays mounted,
    // lays out to nothing, and the hard clip keeps its content from
    // bleeding over the visible pane). `width(0)` / `height(0)` are REAL
    // zeros (the box_width / box_height rows — `width_height`'s 0 would
    // mean "unset").
    let edw_slot = stf_take(K_EDW) as u64;
    stf_put(K_EDW, edw_slot as f64);
    let editor_slot = Switch().value(sr(layout))
        .cases("view", Container().width(0.0).height(0.0).clip(CLIP_HARD_EDGE)
            .child(editor_pane).build())
        .cases("split", Container().width_bound(fr(edw_slot)).child(editor_pane).build())
        .fallback(Expanded().flex(1.0).child(editor_pane).build())
        .query_key("editor-slot")
        .build();
    let viewer_slot = Switch().value(sr(layout))
        .cases("edit", Container().width(0.0).height(0.0).clip(CLIP_HARD_EDGE)
            .child(viewer_pane).build())
        .fallback(Expanded().flex(1.0).child(viewer_pane).build())
        .query_key("viewer-slot")
        .build();

    // ---- divider ----------------------------------------------------------
    // The draggable strip between the sidebar and the editor pane: a
    // visible 8px band (the ink.300 border ink — the boa VDivider renders
    // its bar across the whole grab strip) that turns the brand teal
    // while dragging. Drag intents resize the sidebar-width atom (clamped
    // 200–720 in `div_move` — the drag corpus's delta-tracking pattern,
    // the width atom riding the id rail).
    let div_bar = stf_take(K_DIVBAR) as u64;
    stf_put(K_DIVBAR, div_bar as f64);
    let divider = MouseRegion().cursor(CURSOR_COL_RESIZE)
        .child(PointerInteract()
            .on_pointer_down(mutate<PointerEvent>(fn (_ctx: MutationCtx, ev: PointerEvent) { div_down(ev.global.x); }))
            .on_pointer_move(mutate<PointerEvent>(fn (_ctx: MutationCtx, ev: PointerEvent) { div_move(ev.global.x); }))
            .on_pointer_up(mutate<PointerEvent>(fn (_ctx: MutationCtx, _ev: PointerEvent) { div_up(); })).query_key("divider")
            .child(Container().width(8.0).color_bound(bru(div_bar)).build())
            .build())
        .build();

    // ---- the editor↔viewer divider ---------------------------------------
    // The boa shell's second VDivider: an 8px ink.300 band like the
    // sidebar divider (teal while dragging), visible and draggable only in
    // split mode, resizing the editor-width atom (clamped 360–900 in
    // `ediv_move` — the same delta-tracking drag rail as the sidebar
    // divider above). Outside split mode the pane Switch shells it into a
    // zero box (the boa Condition on `layoutMode === "split"`).
    let ediv_bar = stf_take(K_EDIVBAR) as u64;
    stf_put(K_EDIVBAR, ediv_bar as f64);
    let edivider = MouseRegion().cursor(CURSOR_COL_RESIZE)
        .child(PointerInteract()
            .on_pointer_down(mutate<PointerEvent>(fn (_ctx: MutationCtx, ev: PointerEvent) { ediv_down(ev.global.x); }))
            .on_pointer_move(mutate<PointerEvent>(fn (_ctx: MutationCtx, ev: PointerEvent) { ediv_move(ev.global.x); }))
            .on_pointer_up(mutate<PointerEvent>(fn (_ctx: MutationCtx, _ev: PointerEvent) { ediv_up(); })).query_key("divider2")
            .child(Container().width(8.0).color_bound(bru(ediv_bar)).build())
            .build())
        .build();
    let edivider_slot = Switch().value(sr(layout))
        .cases("edit", SizedBox(0.0, 0.0).build())
        .cases("view", SizedBox(0.0, 0.0).build())
        .fallback(edivider)
        .query_key("divider2-slot")
        .build();

    // ---- status bar -------------------------------------------------------
    let ago_d = rs_derive(fmt_ago, ago);
    // The state label mirrors the dot's law: green while fine, the status
    // red for the failure states (the boa status bar colors both). The
    // state atom is already in scope (taken at the top of build_ui).
    let sbar_left = Container().padding(4.0)
        .child(Row().main_axis_size(MAIN_SIZE_MIN)
            .child(SizedBox(8.0, 0.0).build())
            .child(Container().width_height(6.0, 6.0).radius(999.0).color_bound(bru(dot))
                .query_key("status-dot").build())
            .child(SizedBox(6.0, 0.0).build())
            .child(state_label(state))
            .child(edited_pill(edited))
            .child(SizedBox(12.0, 0.0).build())
            .child(Text().text_bound(sr(ago_d)).font_size(11.0).color(TEXT_TERTIARY)
                .query_key("compiled-ago").build())
            .build())
        .build();
    let sbar_right = Container().padding(4.0)
        .child(Row().main_axis_size(MAIN_SIZE_MIN)
            .child(auto_state_text(autorun))
            .child(SizedBox(12.0, 0.0).build())
            .child(Text().text("tur v0.1").font_size(11.0).color(TEXT_TERTIARY).build())
            .child(SizedBox(8.0, 0.0).build())
            .build())
        .build();
    let sbar = Container().width_height(0.0, 22.0).color(BG_ELEVATED)
        .border(BORDER_SUBTLE, 1.0, BORDER_INSIDE).query_key("status-bar")
        .alignment(ALIGN_CENTER)
        .child(Row().main_alignment(MAIN_ALIGN_SPACE_BETWEEN)
            .child(sbar_left)
            .child(sbar_right)
            .build())
        .build();

    let shell = Column().cross_alignment(CROSS_ALIGN_STRETCH)
        .child(toolbar)
        .child(Expanded().flex(1.0)
            .child(Row().cross_alignment(CROSS_ALIGN_STRETCH)
                .child(sidebar)
                .child(divider)
                .child(editor_slot)
                .child(edivider_slot)
                .child(viewer_slot)
                .build())
            .build())
        .child(sbar)
        .build();
    mount(shell);
    stf_put(K_NAMES, names_atom as f64);
    st_put(K_CTRL, ctrl.raw());
    stf_put(K_SELECTED, selected as f64);
    stf_put(K_STATE, state as f64);
    stf_put(K_VERR, verr as f64);
    stf_put(K_HINT, hint as f64);
    stf_put(K_HINTON, hint_on as f64);
    stf_put(K_APP, app_atom as f64);
    stf_put(K_EDITED, edited as f64);
    stf_put(K_AUTORUN, autorun as f64);
    stf_put(K_LAYOUT, layout as f64);
    stf_put(K_AGO, ago as f64);
    stf_put(K_DOT, dot as f64);
    stf_put(K_TAB_SPLIT, tab_split_brush as f64);
    stf_put(K_TAB_EDIT, tab_edit_brush as f64);
    stf_put(K_TAB_VIEW, tab_view_brush as f64);
}

// The live viewer: the boa ReadyViewer shape — 12px of pane ink around
// the inset `CARD_BG` card (the measured (248,250,252) surface) hosting
// the bound child, plus the hint overlay. Fit-expand so the overlay fills
// (and centers its label) while visible; the hidden branch is a
// decoration-less box that passes pointers through to the child.
fn ready_viewer(app_atom: u64, hint: u64, hint_on: u64) -> View {
    let host = VirtualApp().bind(app_atom).query_key("viewer").build();
    let overlay = Condition(br(hint_on))
        .then(Container().color(CARD_BG).alignment(ALIGN_CENTER)
            .child(Text().text_bound(sr(hint)).font_size(13.0).color(TEXT_TERTIARY)
                .query_key("viewer/hint").build())
            .build())
        .else_branch(SizedBox(0.0, 0.0).build())
        .build();
    return Container().padding(12.0).color(BG_VIEWER)
        .child(Container().color(CARD_BG).query_key("viewer-card")
            .child(Stack().fit(STACK_FIT_EXPAND).child(host).child(overlay).build())
            .build())
        .build();
}

// The error panels — the boa RuntimeErrorView / ErrorPanel shape: red
// panel, "!" badge, title + message (the message atom is shared: the
// compile diags and the child's `va_error` land in the same rail).
fn error_view(title_text: str, err: u64) -> View {
    return Container().color(BG_DANGER).padding(24.0).alignment(ALIGN_CENTER)
        .child(Column().cross_alignment(CROSS_ALIGN_CENTER)
            .child(Container().width_height(32.0, 32.0).radius(16.0).color(STATUS_ERROR)
                .alignment(ALIGN_CENTER)
                .child(Text().text("!").font_size(18.0).color(TEXT_INVERSE).build())
                .build())
            .child(SizedBox(0.0, 16.0).build())
            .child(Text().text(title_text).font_size(14.0).color(TEXT_ON_DANGER).build())
            .child(SizedBox(0.0, 8.0).build())
            .child(Text().text_bound(sr(err)).font_size(12.0).color(TEXT_ON_DANGER).build())
            .build())
        .build();
}

// The status bar's state label — the Switch rides the app-state atom:
// the failure states read in the status red, everything else in the
// success green (the boa label coloring; the dot leads, text confirms).
fn state_label(state: u64) -> View {
    let ok = Text().text_bound(sr(state)).font_size(11.0).color(STATUS_SUCCESS)
        .query_key("app-state").build();
    let err_a = Text().text_bound(sr(state)).font_size(11.0).color(STATUS_ERROR)
        .query_key("app-state").build();
    let err_b = Text().text_bound(sr(state)).font_size(11.0).color(STATUS_ERROR)
        .query_key("app-state").build();
    return Switch().value(sr(state))
        .cases("error", err_a)
        .cases("compile-error", err_b)
        .fallback(ok)
        .build();
}

// The auto-run toggle — the boa pill with its leading caption: the 11px
// secondary "auto" label, a 6px gap, then the 28x16 capsule with a 12x12
// knob (right when on, left when off). Two pre-built pills over a
// Condition (both branches carry the `autorun` query key; only one
// mounts).
fn auto_toggle(autorun: u64) -> View {
    let on = PointerInteract().on_click(mutate(fn (_ctx: MutationCtx, _e: nil) { b_autorun(); })).query_key("autorun")
        .child(Container().width_height(28.0, 16.0).radius(999.0).color(ACCENT_PRIMARY)
            .child(Stack().fit(STACK_FIT_EXPAND)
                .child(Positioned().top(2.0).left(14.0)
                    .child(Container().width_height(12.0, 12.0).radius(999.0)
                        .color(TEXT_INVERSE).build())
                    .build())
                .build())
            .build())
        .build();
    let off = PointerInteract().on_click(mutate(fn (_ctx: MutationCtx, _e: nil) { b_autorun(); })).query_key("autorun")
        .child(Container().width_height(28.0, 16.0).radius(999.0).color(BG_HOVER)
            .child(Stack().fit(STACK_FIT_EXPAND)
                .child(Positioned().top(2.0).left(2.0)
                    .child(Container().width_height(12.0, 12.0).radius(999.0)
                        .color(TEXT_INVERSE).build())
                    .build())
                .build())
            .build())
        .build();
    return Row().main_axis_size(MAIN_SIZE_MIN)
        .child(Text().text("auto").font_size(11.0).color(TEXT_SECONDARY)
            .query_key("auto-caption").build())
        .child(SizedBox(6.0, 0.0).build())
        .child(Condition(br(autorun)).then(on).else_branch(off).build())
        .build();
}

// The status bar's auto-run caption ("auto-run on" while the toggle is
// live, the "⌘S to run" keyboard hint otherwise — the boa status bar's
// right cluster).
fn auto_state_text(autorun: u64) -> View {
    let on = Text().text("auto-run on").font_size(11.0).color(TEXT_TERTIARY)
        .query_key("auto-state").build();
    let off = Text().text("\u{2318}S to run").font_size(11.0).color(TEXT_TERTIARY)
        .query_key("auto-state").build();
    return Condition(br(autorun)).then(on).else_branch(off).build();
}

// The edited pill — a coral dot + "edited", visible only while the editor
// text differs from the last-compiled source.
fn edited_pill(edited: u64) -> View {
    let pill = Row().main_axis_size(MAIN_SIZE_MIN)
        .child(SizedBox(12.0, 0.0).build())
        .child(Container().width_height(6.0, 6.0).radius(999.0).color(ACCENT_COMPLEMENT)
            .query_key("edited-pill").build())
        .child(SizedBox(6.0, 0.0).build())
        .child(Text().text("edited").font_size(11.0).color(TEXT_TERTIARY).build())
        .build();
    return Condition(br(edited)).then(pill).else_branch(SizedBox(0.0, 0.0).build()).build();
}

// A layout tab — the segmented control's option. The selected option's
// fill is the tray's selected ink (the brush atoms; 0 = transparent); a
// MouseRegion delivers the hover lift (the index crosses as the id).
fn tab_button(label: str, m: Mutation<nil>, key: str, brush: u64, idx: u64) -> View {
    return MouseRegion()
        .on_enter(mutate<EnterEvent>(fn (_ctx: MutationCtx, _ev: EnterEvent) { tab_enter(idx); }))
        .on_exit(mutate<ExitEvent>(fn (_ctx: MutationCtx, _ev: ExitEvent) { tab_exit(idx); }))
        .cursor(CURSOR_POINTER)
        .child(PointerInteract().on_click(m).query_key(key)
            .child(Container().padding(6.0).radius(4.0).color_bound(bru(brush))
                .child(Text().text(label).font_size(11.0).color(TEXT_SECONDARY).build())
                .build())
            .build())
        .build();
}

// The Split / Edit / View segmented control (the boa toolbar's right
// cluster): a tray with the three tabs.
fn layout_tabs(split_brush: u64, edit_brush: u64, view_brush: u64) -> View {
    let tray = Row().main_axis_size(MAIN_SIZE_MIN)
        .child(tab_button("Split", mutate(fn (_ctx: MutationCtx, _e: nil) { set_layout("split"); }), "tab-split", split_brush, 0))
        .child(tab_button("Edit", mutate(fn (_ctx: MutationCtx, _e: nil) { set_layout("edit"); }), "tab-edit", edit_brush, 1))
        .child(tab_button("View", mutate(fn (_ctx: MutationCtx, _e: nil) { set_layout("view"); }), "tab-view", view_brush, 2))
        .build();
    return Container().radius(6.0).color(BG_HOVER).padding(2.0).child(tray).build();
}

// A sidebar entry — tapping loads + runs the case. The Each index IS
// the tap id (the intent's first argument). Each row owns two brush
// atoms (the 3px accent bar + the inset pill background) painted by
// `apply_row` from the selection/hover state; a MouseRegion delivers the
// hover intents (the pointer-region corpus pattern) and the pointer
// cursor. Geometry = the boa NavItem: a 2px gap, then padding-8 around a
// reserved 3x20 bar, an 8px gap and the full-width inset pill (radius 5,
// padding 7) carrying the 13px label — label x ≈ 26.
fn side_item(i: u64, name: str) -> View {
    let bar = rs_source_value(rs_list_new());
    rs_set_brush(bar, 0);
    stf_put(K_ROW0 + i * 2, bar as f64);
    let bg = rs_source_value(rs_list_new());
    rs_set_brush(bg, 0);
    stf_put(K_ROW0 + i * 2 + 1, bg as f64);
    let row = Container().padding(8.0)
        .query_key(f"row/{name}")
        .child(Row().main_axis_size(MAIN_SIZE_MIN)
            // The reserved 3px bar (never clips — boa's trick): teal when
            // selected, transparent otherwise, so the label never shifts.
            .child(Container().width_height(3.0, 20.0).radius(2.0).color_bound(bru(bar)).build())
            .child(SizedBox(8.0, 0.0).build())
            .child(Expanded().flex(1.0)
                .child(Container().radius(5.0).padding(7.0).color_bound(bru(bg))
                    .child(Text().text(name).color(TEXT_BODY).font_size(13.0).build())
                    .build())
                .build())
            .build())
        .build();
    let item = MouseRegion()
        .on_enter(mutate<EnterEvent>(fn (_ctx: MutationCtx, _ev: EnterEvent) { row_enter(i); }))
        .on_exit(mutate<ExitEvent>(fn (_ctx: MutationCtx, _ev: ExitEvent) { row_exit(i); }))
        .cursor(CURSOR_POINTER)
        .child(PointerInteract().on_click(mutate(fn (_ctx: MutationCtx, _e: nil) { case_tap(i); })).child(row).build())
        .build();
    // Initial paint from the live selection/hover indices: the boot
    // selection (`counter` — the boa INITIAL_CASE) runs before the Each
    // materializes the rows, so `case_tap`'s sweep missed these atoms.
    apply_row(i);
    return Column().cross_alignment(CROSS_ALIGN_STRETCH)
        .child(SizedBox(0.0, 2.0).build())
        .child(item)
        .build();
}

// Paint row `i`'s brushes from the current selection + hover indices.
// Transparent (0) for the un-selected, un-hovered row — the panel shows
// through. The boa pill law: hover = the hover ink (ink.200), selected =
// the elevated ink (ink.150), selected + hovered = the strong-hover ink
// (ink.300); the accent bar is teal only while selected.
fn apply_row(i: u64) {
    let bar = stf_take(K_ROW0 + i * 2) as u64;
    stf_put(K_ROW0 + i * 2, bar as f64);
    let bg = stf_take(K_ROW0 + i * 2 + 1) as u64;
    stf_put(K_ROW0 + i * 2 + 1, bg as f64);
    let sel = stf_take(K_SELIDX);
    stf_put(K_SELIDX, sel);
    let hov = stf_take(K_HOVERI);
    stf_put(K_HOVERI, hov);
    let selected = sel == i as f64;
    let hovered = hov == i as f64;
    rs_set_brush(bar, 0);
    rs_set_brush(bg, 0);
    if (selected) {
        rs_set_brush(bar, ACCENT_SOLID);
        rs_set_brush(bg, BG_ELEVATED);
        if (hovered) {
            rs_set_brush(bg, BG_STRONG_HOVER);
        }
    }
    if (!selected && hovered) {
        rs_set_brush(bg, BG_HOVER);
    }
}

// The hover intents: entering repaints the previously-hovered row (its
// hover lift drops) and the new one; exiting drops the lift. The
// engine's pointer-region tracker orders exit-before-enter across a
// single sampled move (pinned by the corpus race case), so the shared
// hover index can't double-paint.
fn row_enter(i: u64) {
    let prev = stf_take(K_HOVERI);
    stf_put(K_HOVERI, i as f64);
    if (prev >= 0.0 && prev != i as f64) {
        apply_row(prev as u64);
    }
    apply_row(i);
}

fn row_exit(i: u64) {
    // Drop the hover index only if it is THIS row (a batched exit for a
    // stale row must not clear the live hover — scrolling under a
    // stationary pointer delivers several exits at once), but ALWAYS
    // repaint the exiting row: its lift drops either way.
    let cur = stf_take(K_HOVERI);
    if (cur == i as f64) {
        stf_put(K_HOVERI, -1.0);
    } else {
        stf_put(K_HOVERI, cur);
    }
    apply_row(i);
}

fn case_tap(idx: u64) {
    let name = pg_case_name(idx);
    // Select: load the source into the editor controller (highlighted —
    // the case-load rail), then run it. The mounted Input refreshes on the
    // write itself — `tctrl_set_text` marks the mounted editable dirty and
    // requests a frame — so no re-mount is needed here (a mid-drain
    // re-mount would wedge the frame's render).
    load_editor(pg_case_source(name));
    let selected = stf_take(K_SELECTED) as u64;
    rs_set_str(selected, f"{name}");
    stf_put(K_SELECTED, selected as f64);
    // The sidebar's selection paint: un-highlight the previous row, then
    // paint the new one (the accent bar + the row background move).
    let old = stf_take(K_SELIDX);
    if (old != idx as f64) {
        if (old >= 0.0) {
            apply_row(old as u64);
        }
        stf_put(K_SELIDX, idx as f64);
        apply_row(idx);
    }
    do_run();
}

// Load `text` into the editor controller and highlight it (the boa
// `setSpans(buildHighlightSpans(...))` load rail). Highlighting runs at
// case load + after a successful Run — NOT per keystroke (the recorded
// phase-D decision): typed text inherits the caret span's color, so the
// highlighting survives edits until the next re-highlight, and a
// per-keystroke apply would churn the layout memo behind the caret for
// every character. `pg_apply_highlight` keeps the caret, so the auto-run's
// re-highlight never yanks it either.
fn load_editor(text: str) {
    let ctrl = TextCtrl(st_take(K_CTRL));
    ctrl.set_text(text);
    pg_apply_highlight(ctrl.raw(), pg_highlight(text));
    st_put(K_CTRL, ctrl.raw());
}

// The test rail's probe: select + run by sidebar index (the corpus
// probe-entry convention — `call_rut_entry` drives the (u64, f64) shape).
entry fn select(i: u64, _b: f64) {
    case_tap(i);
}

// The test rail's probe: report the live controller's `va_status` into the
// caller's str atom.
entry fn probe(state: u64, _b: f64) {
    let vctrl = VAppCtrl(st_take(K_VCTRL));
    let s = vctrl.status();
    st_put(K_VCTRL, vctrl.raw());
    rs_set_str(state, s);
}

// Compile the editor's current source; on success destroy the previous
// child and spawn a fresh one under a new controller (the `runCase`
// destroy-then-spawn swap). On failure the viewer flips to the
// compile-error panel and the diagnostics land in the error rail.
fn run_case() {
    do_run();
}

fn do_run() {
    let ctrl = TextCtrl(st_take(K_CTRL));
    let src = ctrl.text();
    st_put(K_CTRL, ctrl.raw());

    let id = pg_compile(src);
    if (id == 0) {
        let diags = pg_compile_diags();
        set_state("compile-error");
        let verr = stf_take(K_VERR) as u64;
        rs_set_str(verr, diags);
        stf_put(K_VERR, verr as f64);
        mark_edited();
        return;
    }

    // Destroy-then-spawn: retire the previous child (and its status
    // watch), mint the new controller from the compile row's source id,
    // and swap the viewer's reactive `app$` atom — the mounted
    // `VirtualAppView` rebinds in the same flush and the new child
    // spawns. The new controller's status rail is watched in its place.
    let old = VAppCtrl(st_take(K_VCTRL));
    old.destroy();
    rs_watch_stop(st_take(K_WATCH));
    let vctrl = virtual_app_controller(va_source_handle(id));
    st_put(K_VCTRL, vctrl.raw());
    watch_controller(vctrl);
    let app_atom = stf_take(K_APP) as u64;
    va_app_set(app_atom, vctrl.raw());
    stf_put(K_APP, app_atom as f64);

    // A successful Run re-highlights the editor (the compiled source's
    // colors land — the apply keeps the caret where the user left it; the
    // text itself is already current, only the colors refresh).
    let ectrl = TextCtrl(st_take(K_CTRL));
    pg_apply_highlight(ectrl.raw(), pg_highlight(src));
    st_put(K_CTRL, ectrl.raw());

    // The status rail: spawning (the watch deliveries settle it into
    // ready/error).
    set_state("spawning");
    let verr = stf_take(K_VERR) as u64;
    rs_set_str(verr, "");
    stf_put(K_VERR, verr as f64);
    let hint = stf_take(K_HINT) as u64;
    rs_set_str(hint, "starting...");
    stf_put(K_HINT, hint as f64);
    let hint_on = stf_take(K_HINTON) as u64;
    rs_set_bool(hint_on, true);
    stf_put(K_HINTON, hint_on as f64);

    // The compiled baseline moves to the freshly compiled source (the
    // edited pill clears) and the ago clock restarts.
    let compiled = stf_take(K_COMPILED) as u64;
    rs_set_str(compiled, src);
    stf_put(K_COMPILED, compiled as f64);
    let ago = stf_take(K_AGO) as u64;
    rs_set_f64(ago, 0.0);
    stf_put(K_AGO, ago as f64);
    mark_edited();
}

// Reset: restore the selected case's original source into the editor
// controller (highlighted — the same load rail as a selection; the mounted
// editable refreshes on the write) and re-run.
fn reset_case() {
    let name = rs_get_str(selected_atom());
    load_editor(pg_case_source(name));
    do_run();
}

// ---- the divider's drag rail ----------------------------------------------
// The `pointer-drag` corpus pattern: down records the drag start (the last-x
// scratch cell), move converts the global-x delta into the sidebar width
// (clamped 200–720 px), up releases. The width atom rides the id rail; the
// drag flag gates post-release hover moves (they hit the strip too) and
// drives the while-dragging highlight — the visible band turns the brand
// teal (the boa VDivider: accent bar + tint while dragging; the bar covers
// the whole 8px band, so the teal IS the visible state).

fn set_dragging(on: bool) {
    let dragging = stf_take(K_DRAGGING) as u64;
    rs_set_bool(dragging, on);
    stf_put(K_DRAGGING, dragging as f64);
    let bar = stf_take(K_DIVBAR) as u64;
    rs_set_brush(bar, BORDER_SUBTLE);
    if (on) {
        rs_set_brush(bar, ACCENT_SOLID);
    }
    stf_put(K_DIVBAR, bar as f64);
}

fn div_down(gx: f64) {
    let lastx = st_take(K_DRAGX);
    mem_set(lastx, gx);
    st_put(K_DRAGX, lastx);
    set_dragging(true);
}

fn div_move(gx: f64) {
    let dragging = stf_take(K_DRAGGING) as u64;
    stf_put(K_DRAGGING, dragging as f64);
    if (!rs_get_bool(dragging)) {
        return;
    }
    let sbw = stf_take(K_SBW) as u64;
    stf_put(K_SBW, sbw as f64);
    let lastx = st_take(K_DRAGX);
    let dx = gx - mem_get(lastx);
    mem_set(lastx, gx);
    st_put(K_DRAGX, lastx);
    let mut w = rs_get_f64(sbw) + dx;
    if (w < 200.0) {
        w = 200.0;
    }
    if (w > 720.0) {
        w = 720.0;
    }
    rs_set_f64(sbw, w);
}

fn div_up() {
    set_dragging(false);
}

// ---- the editor divider's drag rail ----------------------------------------
// The sidebar divider's rail mirrored onto the editor-width atom: down
// records the drag start, move converts the global-x delta into the editor
// width (clamped 360–900), up releases. Its own drag flag gates post-
// release moves and drives the while-dragging highlight (the band turns
// teal). Outside split mode the divider is unmounted, so these intents can
// only fire while the strip is live.

fn set_edragging(on: bool) {
    let edragging = stf_take(K_EDRAGGING) as u64;
    rs_set_bool(edragging, on);
    stf_put(K_EDRAGGING, edragging as f64);
    let bar = stf_take(K_EDIVBAR) as u64;
    rs_set_brush(bar, BORDER_SUBTLE);
    if (on) {
        rs_set_brush(bar, ACCENT_SOLID);
    }
    stf_put(K_EDIVBAR, bar as f64);
}

fn ediv_down(gx: f64) {
    let lastx = st_take(K_EDRAGX);
    mem_set(lastx, gx);
    st_put(K_EDRAGX, lastx);
    set_edragging(true);
}

fn ediv_move(gx: f64) {
    let edragging = stf_take(K_EDRAGGING) as u64;
    stf_put(K_EDRAGGING, edragging as f64);
    if (!rs_get_bool(edragging)) {
        return;
    }
    let edw = stf_take(K_EDW) as u64;
    stf_put(K_EDW, edw as f64);
    let lastx = st_take(K_EDRAGX);
    let dx = gx - mem_get(lastx);
    mem_set(lastx, gx);
    st_put(K_EDRAGX, lastx);
    let mut w = rs_get_f64(edw) + dx;
    if (w < 360.0) {
        w = 360.0;
    }
    if (w > 900.0) {
        w = 900.0;
    }
    rs_set_f64(edw, w);
}

fn ediv_up() {
    set_edragging(false);
}

// ---- the toolbar buttons' hover rails --------------------------------------

fn run_hover_on(atom: u64) {
    rs_set_brush(atom, BTN_PRIMARY_HOVER);
}

fn run_hover_off(atom: u64) {
    rs_set_brush(atom, ACCENT_PRIMARY);
}

fn reset_hover_on(atom: u64) {
    rs_set_brush(atom, BG_HOVER);
}

fn reset_hover_off(atom: u64) {
    rs_set_brush(atom, BTN_GHOST);
}

// The auto-run toggle. Turning auto-run OFF also cancels any pending
// debounced run.
fn b_autorun() {
    let autorun = stf_take(K_AUTORUN) as u64;
    rs_set_bool(autorun, !rs_get_bool(autorun));
    stf_put(K_AUTORUN, autorun as f64);
    if (!rs_get_bool(autorun)) {
        let debounce = AnimCtrl(st_take(K_DEBOUNCE));
        debounce.stop();
        st_put(K_DEBOUNCE, debounce.raw());
    }
}

// The layout tabs.
//
// Wasm note (phase-4 P0 audit, 2026-10-05): an earlier session reported a
// worker-side `passStringToWasm0(undefined)` crash on the View switch plus
// a Run/Reset spawn hang. Neither reproduces on a fresh build: the layout
// switch is pure rut (a `Switch` on the layout atom below — no JS↔wasm
// string crosses it; the only string-taking exports on the website surface
// are `create_in` / `createWithBackground` / `loadAndRunRutModule`, all
// boot-time), and Run/Reset re-run instantly through the same
// destroy-then-spawn swap as a case-row tap (pinned natively by the
// `playground_run_button_reruns_the_case` / `playground_reset_restores_…`
// tests). Verified manually on a fresh wasm build: boot → View → Split →
// Run → Reset with a live child, plus typed edits under auto-run — no
// overlay, no hang, viewer intact throughout.
// The tab hover intents (the segmented control's per-tab lift — the boa
// LayoutButton): entering marks the index, exiting clears it; all three
// brushes repaint either way.
fn tab_enter(i: u64) {
    stf_put(K_TABH, i as f64);
    repaint_tabs();
}

fn tab_exit(i: u64) {
    let cur = stf_take(K_TABH);
    stf_put(K_TABH, -1.0);
    if (cur == i as f64) {
        repaint_tabs();
    }
}

fn repaint_tabs() {
    let s = stf_take(K_TAB_SPLIT) as u64;
    paint_tab(0, s);
    stf_put(K_TAB_SPLIT, s as f64);
    let e = stf_take(K_TAB_EDIT) as u64;
    paint_tab(1, e);
    stf_put(K_TAB_EDIT, e as f64);
    let v = stf_take(K_TAB_VIEW) as u64;
    paint_tab(2, v);
    stf_put(K_TAB_VIEW, v as f64);
}

// One tab's brush: the tray shows through when idle (transparent), the
// selected ink when active, the hover ink when lifted (the boa
// controlTray / controlSelected / controlTrayHover law).
fn paint_tab(idx: u64, brush: u64) {
    let hov = stf_take(K_TABH);
    stf_put(K_TABH, hov);
    let layout = stf_take(K_LAYOUT);
    stf_put(K_LAYOUT, layout);
    let mode = rs_get_str(layout as u64);
    let mut selected = false;
    if (idx == 0 && mode == "split") {
        selected = true;
    }
    if (idx == 1 && mode == "edit") {
        selected = true;
    }
    if (idx == 2 && mode == "view") {
        selected = true;
    }
    let hovered = hov == idx as f64;
    rs_set_brush(brush, 0);
    if (selected) {
        rs_set_brush(brush, BG_APP);
    }
    if (!selected && hovered) {
        rs_set_brush(brush, BG_STRONG_HOVER);
    }
}

fn set_layout(mode: str) {
    let layout = stf_take(K_LAYOUT) as u64;
    rs_set_str(layout, mode);
    stf_put(K_LAYOUT, layout as f64);
    repaint_tabs();
}

// The on-input intent (the `input_on_input` rail): recompute the edited
// pill, and with auto-run on restart the debounced recompile+respawn —
// a 500 ms one-shot animation controller that a newer edit stops
// (cancellation = stop; no generation guard needed).
fn on_edit() {
    mark_edited();
    let autorun = stf_take(K_AUTORUN) as u64;
    stf_put(K_AUTORUN, autorun as f64);
    let debounce = AnimCtrl(st_take(K_DEBOUNCE));
    debounce.stop();
    if (rs_get_bool(autorun)) {
        debounce.forward();
    }
    st_put(K_DEBOUNCE, debounce.raw());
}

// The debounce window elapsed: recompile + respawn the editor's source.
fn on_debounce_end() {
    do_run();
}

fn mark_edited() {
    let ctrl = TextCtrl(st_take(K_CTRL));
    let text = ctrl.text();
    st_put(K_CTRL, ctrl.raw());
    let compiled = stf_take(K_COMPILED) as u64;
    let edited = stf_take(K_EDITED) as u64;
    rs_set_bool(edited, text != rs_get_str(compiled));
    stf_put(K_COMPILED, compiled as f64);
    stf_put(K_EDITED, edited as f64);
}

// The "compiled Xs ago" clock: a 1 Hz one-shot that restarts itself (the
// status bar's derive re-formats the label — no polling anywhere else).
fn on_clock_end() {
    let ago = stf_take(K_AGO) as u64;
    rs_set_f64(ago, rs_get_f64(ago) + 1.0);
    stf_put(K_AGO, ago as f64);
    let clock = AnimCtrl(st_take(K_CLOCK));
    clock.forward();
    st_put(K_CLOCK, clock.raw());
}

fn fmt_ago(v: f64) -> str {
    if (v < 5.0) {
        return f"compiled just now";
    }
    return f"compiled {v as u64}s ago";
}

// The status-watch delivery (a Click-shaped intent: report, watched
// atom, seq). Stale rails (a destroyed controller's atom still firing on
// its `destroyed` write) are ignored by identity; the live rail settles
// the viewer atoms — the boa FallbackView / RuntimeError states.
fn on_vstat(_report: u64, watched: u64, _n: f64) {
    let cur = stf_take(K_VSTAT) as u64;
    stf_put(K_VSTAT, cur as f64);
    if (watched != cur) {
        return;
    }
    let s = rs_get_str(watched);
    if (s == "running") {
        set_state("ready");
        hide_hint();
    }
    if (s == "error") {
        let vctrl = VAppCtrl(st_take(K_VCTRL));
        let msg = vctrl.error();
        st_put(K_VCTRL, vctrl.raw());
        let verr = stf_take(K_VERR) as u64;
        rs_set_str(verr, msg);
        stf_put(K_VERR, verr as f64);
        set_state("error");
        hide_hint();
    }
}

// The app-state atom + the status-dot brush move together (red only for
// the failure states — spawning/ready stay green, the boa dot law).
fn set_state(s: str) {
    let state = stf_take(K_STATE) as u64;
    rs_set_str(state, s);
    stf_put(K_STATE, state as f64);
    let dot = stf_take(K_DOT) as u64;
    rs_set_brush(dot, STATUS_SUCCESS);
    if (s == "error") {
        rs_set_brush(dot, STATUS_ERROR);
    }
    if (s == "compile-error") {
        rs_set_brush(dot, STATUS_ERROR);
    }
    stf_put(K_DOT, dot as f64);
}

fn hide_hint() {
    let hint_on = stf_take(K_HINTON) as u64;
    rs_set_bool(hint_on, false);
    stf_put(K_HINTON, hint_on as f64);
    let hint = stf_take(K_HINT) as u64;
    rs_set_str(hint, "");
    stf_put(K_HINT, hint as f64);
}

fn selected_atom() -> u64 {
    let a = stf_take(K_SELECTED) as u64;
    stf_put(K_SELECTED, a as f64);
    return a;
}
