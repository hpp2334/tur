// The tur playground — the root module is the walk's `mod.rut`; the
// generated case registry (`cases_gen.rut`) stays a loose file beside it
// (walk-invisible): the website splices the two with the same '\n'-join
// its `playgroundSource()` performs before `loadAndRunRutModule`. The
// registry is GENERATED by scripts/gen-cases.cjs from rut/cases +
// showcase.json.
{
  "name": "playground",
  "deps": {
    "tur_host": { "path": "../tur_host" },
    "tur_kit": { "path": "../tur_kit" }
  }
}
