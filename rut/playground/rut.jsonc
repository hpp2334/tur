// The tur playground — one rut module spliced from the handwritten
// playground module + the generated case registry (the same '\n'-join the
// website's `playgroundSource()` performs before
// `loadAndRunRutModule`). The registry is GENERATED by
// scripts/gen-cases.cjs from rut/cases + showcase.json.
{
  "name": "playground",
  "entry": {
    "lib": "./playground.rut",
    "libs": ["./cases_gen.rut"]
  },
  "deps": {
    "tur_host": { "path": "../tur_host" },
    "tur_kit": { "path": "../tur_kit" }
  }
}
