// image-basic: a synthetic 1x1-ish RGBA resource in a fixed-size Image.
use tur_host::{ BOXFIT_FILL, img_res_solid, mount };
use tur_kit::{ Container, Image };


entry fn start() {
    let res = img_res_solid(1, 1, 0xFF6366F1u64);
    let mut outer = Container().width_height(200.0, 100.0);
    let img = Image(res).width(200.0).height(100.0).fit(BOXFIT_FILL).build();
    outer.child(img);
    mount(outer.build());
}
