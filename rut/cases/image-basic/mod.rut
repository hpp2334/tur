// image-basic: a synthetic 1x1-ish RGBA resource in a fixed-size Image.
use tur_kit::{ BoxFit, Container, Image, image_resource_solid, mount };

entry fn start() {
    let res = image_resource_solid(1, 1, 0xFF6366F1u64);
    let mut outer = Container().width_height(200.0, 100.0);
    let img = Image(res).width(200.0).height(100.0).fit(BoxFit.Fill).build();
    outer.child(img);
    mount(outer.build());
}
