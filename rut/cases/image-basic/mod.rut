// image-basic: a synthetic 1x1-ish RGBA resource in a fixed-size Image.
// `image_resource_solid`'s packed u64 is RRGGBBAA — a semi-transparent
// yellow here (α=0xC8), so the vello pixel test proves the image BLENDED
// over the white background rather than the background showing through.
use tur_kit::flags::{ BoxFit };
use tur_kit::handles::{ mount };
use tur_kit::image::{ Image, image_resource_solid };
use tur_kit::layout::box::{ Container };

entry fn start() {
    let res = image_resource_solid(1, 1, 0xFFFF00C8u64);
    let mut outer = Container().width_height(200.0, 100.0);
    let img = Image(res).width(200.0).height(100.0).fit(BoxFit::Fill).build();
    outer.child(img);
    mount(outer.build());
}
