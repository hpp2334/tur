// flex-todolist-sidebar: the todolist two-pane shell — a 200px tab
// sidebar beside a padded content column.
use tur_host::{ CROSS_ALIGN_CENTER, MAIN_ALIGN_SPACE_BETWEEN, mount };
use tur_kit::{ Column, Container, Row, Text };


entry fn start() {
    let mut row = Row();
    // Sidebar: one active tab pill.
    let mut sidebar = Container().color(0x1A1A2EFF).width_height(200.0, 0.0);
    let mut tabs = Column();
    let tab = Container()
        .color(0x0F3460FF)
        .padding(12.0)
        .child(Text().text("TodoList").font_size(14.0).build());
    tabs.child(tab.build());
    sidebar.child(tabs.build());
    row.child(sidebar.build());
    // Content: heading + list shell.
    let mut content = Container().padding(16.0);
    let mut col = Column()
        .cross_alignment(CROSS_ALIGN_CENTER)
        .child(Text().text("Todo List").font_size(24.0).build())
        .child(box_h(16.0));
    let list = Column()
        .child(Row().main_alignment(MAIN_ALIGN_SPACE_BETWEEN).child(Text().text("Buy milk").build()).build());
    col.child(list.build());
    content.child(col.build());
    row.child(content.build());
    mount(row.build());
}

fn box_h(h: f64) -> View {
    let b = Container().width_height(0.0, h);
    return b.build();
}
