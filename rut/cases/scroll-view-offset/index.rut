// scroll-view-offset: a scroll viewport with a one-shot initial offset
// (the controller's initialOffset twin) — the content offset starts at
// -100.
use tur_host::{ AXIS_VERTICAL, CROSS_ALIGN_STRETCH, mount };
use tur_kit::{ Column, Container, ScrollView };


entry fn start() {
    let content = Column()
        .cross_alignment(CROSS_ALIGN_STRETCH)
        .child(box_h(200.0))
        .child(box_h(200.0))
        .child(box_h(200.0));
    let sv = ScrollView().axis(AXIS_VERTICAL).initial_offset(100.0).child(content.build()).query_key("scroll-view").build();
    mount(sv);
}

fn box_h(h: f64) -> View {
    let b = Container().width_height(0.0, h);
    return b.build();
}
