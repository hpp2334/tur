// pointer-interact-basic: an opaque gesture pad around a fixed-size box.
use tur_kit::gesture::pointer::{ PointerInteract };
use tur_kit::handles::{ mount };
use tur_kit::layout::box::{ Container };

entry fn start() {
    let b = Container().width_height(100.0, 50.0);
    mount(PointerInteract().child(b.build()).build());
}
