// row-cross-center: a 200x36 container centering a row of two boxes on
// the cross axis.
use tur_host::{ CROSS_ALIGN_CENTER, mount };
use tur_kit::{ Container, Row };


entry fn start() {
    let outer = Container()
        .width_height(200.0, 36.0)
        .padding(0.0)
        .child(Row().cross_alignment(CROSS_ALIGN_CENTER).child(box_wh(20.0, 20.0)).child(box_wh(40.0, 10.0)).build());
    mount(outer.build());
}

fn box_wh(w: f64, h: f64) -> View {
    let b = Container().width_height(w, h);
    return b.build();
}
