// row-cross-center: a 200x36 container centering a row of two boxes on
// the cross axis.
use tur_kit::flags::{ CrossAlign };
use tur_kit::handles::{ View, mount };
use tur_kit::layout::box::{ Container };
use tur_kit::layout::flex::{ Row };

entry fn start() {
    let outer = Container()
        .width_height(200.0, 36.0)
        .padding(0.0)
        .child(Row().cross_alignment(CrossAlign.Center).child(box_wh(20.0, 20.0)).child(box_wh(40.0, 10.0)).build());
    mount(outer.build());
}

fn box_wh(w: f64, h: f64) -> View {
    let b = Container().width_height(w, h);
    return b.build();
}
