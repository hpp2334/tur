// hit-through-overlay: the floating-pill pattern — a full-size invisible
// overlay must not steal pointer/wheel input from the scrollable beneath;
// the opaque anchored pill still consumes clicks. The counters render into
// bound Texts (`beneath-downs` / `pill-clicks`).
use tur::{ AXIS_VERTICAL, CROSS_ALIGN_STRETCH, mount };
use tur_kit::{ Column, Container, Mutation, MutationCtx, PointerEvent, PointerInteract, Positioned, Readable, ScrollView, Source, Stack, Text, mutate, source };


entry fn start() -> u64 {
    let downs: Readable<str> = source<str>("0");
    let clicks: Readable<str> = source<str>("0");
    let down_n: Readable<f64> = source<f64>(0.0);
    let click_n: Readable<f64> = source<f64>(0.0);

    // The counters ride their own sources (the mutations capture the
    // handles — no id rail, no stash).
    let g_down = mutate<PointerEvent>(fn (ctx: MutationCtx, _ev: PointerEvent) {
        ctx.set<f64>(down_n, ctx.get<f64>(down_n) + 1.0);
        ctx.set<str>(downs, f"{ctx.get<f64>(down_n) as u64}");
    });
    let pill_click = mutate(fn (ctx: MutationCtx, _e: nil) {
        ctx.set<f64>(click_n, ctx.get<f64>(click_n) + 1.0);
        ctx.set<str>(clicks, f"{ctx.get<f64>(click_n) as u64}");
    });

    let mut stack = Stack();

    // The scrollable beneath, wrapped in a gesture target so pointer
    // events reaching THROUGH the overlay are observable.
    let content = Column()
        .cross_alignment(CROSS_ALIGN_STRETCH)
        .child(box_h(300.0))
        .child(box_h(300.0))
        .child(box_h(300.0));
    let scroller = ScrollView().axis(AXIS_VERTICAL).child(content.build()).query_key("sv").build();
    stack.child(PointerInteract().on_pointer_down(g_down).child(scroller).build());

    // The invisible full-size overlay: no decoration, no gesture.
    let overlay = Container().width_height(400.0, 600.0).query_key("overlay");
    stack.child(overlay.build());

    // The floating pill, anchored bottom-right.
    let pill_box = Container().width_height(64.0, 28.0).query_key("pill");
    let pill = PointerInteract().on_click(pill_click).child(pill_box.build()).build();
    stack.child(Positioned().right(8.0).bottom(8.0).child(pill).build());

    // Counter readouts (the test parses these).
    let downs_t = Text().text_bound(downs).query_key("beneath-downs");
    stack.child(downs_t.build());
    let clicks_t = Text().text_bound(clicks).query_key("pill-clicks");
    stack.child(clicks_t.build());

    mount(stack.build());
    return down_n.atom_id();
}

fn box_h(h: f64) -> View {
    let b = Container().width_height(0.0, h);
    return b.build();
}
