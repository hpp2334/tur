// vello-column-basic: a colored container with two text rows — the vello
// render smoke fixture.
use tur::{ mount };
use tur_kit::{ Column, Container, Text };


entry fn start() {
    let col = Column()
        .child(Text().text("hello vello").build())
        .child(Text().text("second line").build());
    mount(Container().color(0xF0F4F8FFu64).padding(12.0).child(col.build()).build());
}
