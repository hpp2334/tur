// flex-nested-sidebar: a 200px sidebar Column beside a content Column in
// a Row (the classic two-pane shape).
use tur_kit::flags::{ CrossAlign };
use tur_kit::handles::{ View, mount };
use tur_kit::layout::box::{ Container };
use tur_kit::layout::flex::{ Column, Row };

entry fn start() {
    let mut row = Row();
    let sidebar = Container()
        .width_height(200.0, 0.0)
        .child(Column().cross_alignment(CrossAlign.Start).child(box_wh(0.0, 40.0)).build());
    row.child(sidebar.build());
    let content = Container()
        .child(Column().cross_alignment(CrossAlign.Start).child(box_wh(0.0, 30.0)).build());
    row.child(content.build());
    mount(row.build());
}

fn box_wh(w: f64, h: f64) -> View {
    let b = Container().width_height(w, h);
    return b.build();
}
