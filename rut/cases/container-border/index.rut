// container-border: explicit size + padding + color + inside border +
// radius around a Text.
use tur_host::{ BORDER_INSIDE, mount };
use tur_kit::{ Container, Text };


entry fn start() {
    let b = Container()
        .width_height(200.0, 200.0)
        .padding(16.0)
        .color(0xFFFFFFFFu64)
        .border(0x000000FFu64, 2.0, BORDER_INSIDE)
        .radius(8.0)
        .child(Text().text("Border").font_size(16.0).build())
        .query_key("border-container");
    mount(b.build());
}
