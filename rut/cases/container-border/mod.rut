// container-border: explicit size + padding + color + inside border +
// radius around a Text.
use tur_kit::flags::{ BorderPosition };
use tur_kit::handles::{ mount };
use tur_kit::layout::box::{ Container };
use tur_kit::reactive::{ sv };
use tur_kit::text::core::{ Text };

entry fn start() {
    let b = Container()
        .width_height(200.0, 200.0)
        .padding(16.0)
        .color(sv(0xFFFFFFFFu64))
        .border(0x000000FFu64, 2.0, BorderPosition::Inside)
        .radius(sv(8.0f64))
        .child(Text().text(sv("Border")).font_size(16.0).build())
        .query_key("border-container");
    mount(b.build());
}
