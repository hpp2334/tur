// container-clip-rounded: a rounded, hard-edge-clipped container holding
// an oversized red child (the corners must clip).
use tur_kit::flags::{ Clip };
use tur_kit::handles::{ mount };
use tur_kit::layout::box::{ Container };
use tur_kit::reactive::{ sv };

entry fn start() {
    let b = Container()
        .width_height(200.0, 200.0)
        .radius(sv(40.0f64))
        .clip(Clip::HardEdge)
        .child(Container().width_height(200.0, 200.0).color(sv(0xFF0000FFu64)).build());
    mount(b.build());
}
