// transform-translate-hit: a box laid out at (0,0) painted at (100,80)
// via a paint-only Transform translate — clickable at the PAINTED center.
// The click flips the hit source; the Condition mounts the red
// confirmation box (the branch swap adds one container node).
use tur_host::{ ALIGN_TOP_LEFT, mount };
use tur_kit::{ Condition, Container, Mutation, MutationCtx, PointerInteract, Readable, SizedBox, Source, Stack, Text, mutate, source };
use tur_anim_kit::{ Transform };


entry fn start() {
    let hit: Readable<bool> = source<bool>(false);

    // The tap: flip the hit source (the mutation captures the handle —
    // no id rail, no stash).
    let b_hit = mutate(fn (ctx: MutationCtx, _e: nil) {
        ctx.set<bool>(hit, true);
    });

    let mut stack = Stack()
        .alignment(ALIGN_TOP_LEFT)
        .child(SizedBox(400.0, 600.0).child(Container().build()).build());

    let indigo = Container().width_height(40.0, 40.0).color(0x4F46E1FFu64);
    let pi = PointerInteract().on_click(b_hit).child(indigo.build()).build();
    stack.child(Transform(1.0, 0.0, 100.0, 80.0).child(pi).build());

    // The confirmation box appears when the click registers (the else
    // branch is a Text — not a container — so the container count grows
    // by exactly one when the red box mounts).
    let red = Container().width_height(40.0, 40.0).color(0xFF0000FFu64);
    stack.child(Condition(hit).then(red.build()).else_branch(Text().text("").build()).build());

    mount(stack.build());
}
