// counter: a reactive count label between -/+ pill buttons — the full
// interactive loop (button → mutation queue → ctx.set → re-render),
// dressed to the boa design: the slate page, the 36px "Count: N" readout
// (a derive over the count source) and the centered 100×44 indigo pill
// row. The count is an i64 — the box rail's i64 lane (the engine's
// STAMP_NUM_I64) keeps the -1 walk negative instead of wrapping.
use tur_kit::flags::{ Align, CrossAlign, MainAlign };
use tur_kit::gesture::pointer::{ PointerInteract };
use tur_kit::handles::{ View, mount };
use tur_kit::layout::box::{ Container, SizedBox };
use tur_kit::layout::flex::{ Column, Row };
use tur_kit::reactive::{ DeriveCtx, Mutation, MutationCtx, Readable, Source, derive, mutate, source };
use tur_kit::text::core::{ Text };

entry fn start() -> u64 {
    // The capture stays CONCRETE (`Source<i64>`): the known upstream
    // interface-slot interning bug misbinds a fresh `Readable<i64>`
    // annotation at boot (the concrete class carries the inherent
    // `get`, no interface slot involved).
    let count: Source<i64> = source<i64>(0);
    let label: Readable<str> = derive<str>(fn (ctx: DeriveCtx) -> str {
        return f"Count: {ctx.get<i64>(count)}";
    });

    // The named mutations (boa's named `mutate(...)` values); the source
    // rides by capture.
    let b_inc = mutate(fn (ctx: MutationCtx, _e: nil) {
        ctx.set<i64>(count, ctx.get<i64>(count) + 1);
    });
    let b_dec = mutate(fn (ctx: MutationCtx, _e: nil) {
        ctx.set<i64>(count, ctx.get<i64>(count) - 1);
    });

    let col = Column()
        .main_alignment(MainAlign::Center)
        .cross_alignment(CrossAlign::Center)
        .child(Text().text_bound(label).query_key("count").font_size(36.0).color(0x1E293BFFu64).build())
        .child(
            Row()
                .main_alignment(MainAlign::Center)
                .child(button(b_dec, "-1", "dec"))
                .child(SizedBox(12.0, 0.0).build())
                .child(button(b_inc, "+1", "inc"))
                .build(),
        )
        .build();

    // The boa page: the slate fill centers the column in the pane.
    mount(Container().color(0xF8FAFCFFu64).alignment(Align::Center).child(col).build());
    return count.atom_id();
}

// A 100x44 indigo pill with a centered label; the pad takes the mutation.
fn button(b: Mutation<nil>, text: str, key: str) -> View {
    let face = Container()
        .width_height(100.0, 44.0)
        .radius(8.0)
        .color(0x6366F1FFu64)
        .alignment(Align::Center)
        .query_key(key)
        .child(Text().text(text).font_size(18.0).color(0xFFFFFFFFu64).build());
    return PointerInteract().on_click(b).child(face.build()).build();
}
