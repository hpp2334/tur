// column-cross-start: one 100x50 box, cross axis start-aligned.
use tur_host::{ CROSS_ALIGN_START, mount };
use tur_kit::{ Column, Container };


entry fn start() {
    let col = Column().cross_alignment(CROSS_ALIGN_START).child(Container().width_height(100.0, 50.0).build());
    mount(col.build());
}
