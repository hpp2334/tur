// json — the tiny cursor parser over the two payloads the case reads
// (the repo meta object + the contents array of flat objects):
// `json_get_str` (one object's scalar field) and `json_contents` (an
// array walk into a display list). The engine ships no parse row, so
// this scanner is the whole story. Escapes decode the common pairs;
// `\uXXXX` mints U+FFFD. The compared codepoints live in theme/.

use tur_kit::handles::{ ListHandle };

fn ws(c: u32) -> bool {
    return c == theme::C_SPACE || c == 9 || c == 10 || c == 13;
}

fn skip_ws(t: str, i: i32) -> i32 {
    let n = t.len();
    let mut j = i;
    while (j < n && ws(t.code_at(j))) {
        j = j + 1;
    }
    return j;
}

// The index just past the string literal opening at `i` (escapes skip
// whole pairs).
fn str_end(t: str, i: i32) -> i32 {
    let n = t.len();
    let mut j = i + 1;
    while (j < n) {
        let c = t.code_at(j);
        if (c == theme::C_BACKSLASH) {
            j = j + 2;
            continue;
        }
        if (c == theme::C_QUOTE) {
            return j + 1;
        }
        j = j + 1;
    }
    return n;
}

// Decode the string literal whose opening quote sits at `i` (the common
// escapes; `\uXXXX` mints U+FFFD).
fn str_unquote(t: str, i: i32) -> str {
    let end = str_end(t, i);
    let raw = t.slice(i + 1, end - 1);
    let n = raw.len();
    let mut out = "";
    let mut k = 0;
    while (k < n) {
        let c = raw.code_at(k);
        if (c != theme::C_BACKSLASH) {
            out = f"{out}{raw.slice(k, k + 1)}";
            k = k + 1;
            continue;
        }
        if (k + 1 >= n) {
            break;
        }
        let e = raw.code_at(k + 1);
        if (e == theme::C_QUOTE) {
            out = f"{out}\"";
        } else if (e == theme::C_BACKSLASH) {
            out = f"{out}\\";
        } else if (e == theme::C_SLASH) {
            out = f"{out}/";
        } else if (e == 110) {
            out = f"{out}\n";
        } else if (e == 116) {
            out = f"{out}\t";
        } else if (e == 117) {
            out = f"{out}\u{FFFD}";
            k = k + 6;
            continue;
        } else {
            out = f"{out}{raw.slice(k + 1, k + 2)}";
        }
        k = k + 2;
    }
    return out;
}

// Skip one JSON value at `i`; answers the index just past it (strings,
// nested containers walked with depth, scalars to the next delimiter).
fn json_skip(t: str, i: i32) -> i32 {
    let n = t.len();
    let j = skip_ws(t, i);
    if (j >= n) {
        return n;
    }
    let c = t.code_at(j);
    if (c == theme::C_QUOTE) {
        return str_end(t, j);
    }
    if (c == theme::C_LBRACE || c == theme::C_LBRACKET) {
        let mut depth = 0;
        let mut k = j;
        while (k < n) {
            let d = t.code_at(k);
            if (d == theme::C_QUOTE) {
                k = str_end(t, k);
                continue;
            }
            if (d == theme::C_LBRACE || d == theme::C_LBRACKET) {
                depth = depth + 1;
            } else if (d == theme::C_RBRACE || d == theme::C_RBRACKET) {
                depth = depth - 1;
                if (depth == 0) {
                    return k + 1;
                }
            }
            k = k + 1;
        }
        return n;
    }
    let mut k = j;
    while (k < n) {
        let d = t.code_at(k);
        if (d == theme::C_COMMA || d == theme::C_RBRACE || d == theme::C_RBRACKET || ws(d)) {
            break;
        }
        k = k + 1;
    }
    return k;
}

// One object's scalar field: the decoded string for string values, the
// raw text for numbers/bools, "" when absent (or the value is
// null/container).
pub fn json_get_str(t: str, key: str) -> str {
    let n = t.len();
    let mut i = skip_ws(t, 0);
    if (i >= n || t.code_at(i) != theme::C_LBRACE) {
        return "";
    }
    i = skip_ws(t, i + 1);
    while (i < n) {
        if (t.code_at(i) == theme::C_RBRACE) {
            return "";
        }
        if (t.code_at(i) != theme::C_QUOTE) {
            return "";
        }
        let key_end = str_end(t, i);
        let k = t.slice(i + 1, key_end - 1);
        let j = skip_ws(t, key_end);
        if (j >= n || t.code_at(j) != theme::C_COLON) {
            return "";
        }
        let vs = skip_ws(t, j + 1);
        if (k == key) {
            if (vs < n && t.code_at(vs) == theme::C_QUOTE) {
                return str_unquote(t, vs);
            }
            if (vs < n && t.code_at(vs) != theme::C_LBRACE && t.code_at(vs) != theme::C_LBRACKET) {
                let vend = json_skip(t, vs);
                return t.slice(vs, vend);
            }
            return "";
        }
        i = skip_ws(t, json_skip(t, vs));
        if (i < n && t.code_at(i) == theme::C_COMMA) {
            i = skip_ws(t, i + 1);
        }
    }
    return "";
}

// Walk a JSON array of flat objects; push "d|name" (dirs pass) or
// "f|name|bytes" (files pass) onto `out`. Answers the item count seen, or
// -1 when the payload is not an array of objects.
pub fn json_contents(t: str, out: ListHandle, dirs_only: bool) -> i32 {
    let n = t.len();
    let mut i = skip_ws(t, 0);
    if (i >= n || t.code_at(i) != theme::C_LBRACKET) {
        return -1;
    }
    i = skip_ws(t, i + 1);
    let mut count: i32 = 0;
    while (i < n) {
        if (t.code_at(i) == theme::C_RBRACKET) {
            return count;
        }
        if (t.code_at(i) != theme::C_LBRACE) {
            return -1;
        }
        let iend = json_skip(t, i);
        let item = t.slice(i, iend);
        let kind = json_get_str(item, "type");
        let is_dir = kind == "dir";
        if (is_dir == dirs_only) {
            let name = json_get_str(item, "name");
            if (is_dir) {
                out.push(f"d|{name}");
            } else {
                let size = json_get_str(item, "size");
                out.push(f"f|{name}|{size}");
            }
            count = count + 1;
        }
        i = skip_ws(t, iend);
        if (i < n && t.code_at(i) == theme::C_COMMA) {
            i = skip_ws(t, i + 1);
        }
    }
    return count;
}
