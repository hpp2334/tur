// ASCII codepoints the scanner compares against (typed so the literals
// land on `u32`).
pub let C_QUOTE: u32 = 34;
pub let C_COMMA: u32 = 44;
pub let C_COLON: u32 = 58;
pub let C_PIPE: u32 = 124;
pub let C_SPACE: u32 = 32;
pub let C_SLASH: u32 = 47;
pub let C_BACKSLASH: u32 = 92;
pub let C_LBRACE: u32 = 123;
pub let C_RBRACE: u32 = 125;
pub let C_LBRACKET: u32 = 91;
pub let C_RBRACKET: u32 = 93;
