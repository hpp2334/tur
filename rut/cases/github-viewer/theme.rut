// The listing row icons (the boa feather glyphs — a filled indigo folder,
// an outlined slate document), rendered through the image rail at 17×17.
pub let SVG_FOLDER: str = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='#6366f1'><path d='M3 7a2 2 0 0 1 2-2h3.5a2 2 0 0 1 1.5.7l1 1.3H19a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'/></svg>";
