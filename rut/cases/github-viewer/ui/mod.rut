// ui — the shared chrome: a compact pill button (the boa
// Button/IconButton composite; the mutation rides by parameter) and the
// error banner row (a visible failure state on landing + explorer).

use tur_kit::control_flow::control::{ Condition };
use tur_kit::gesture::pointer::{ PointerInteract };
use tur_kit::handles::{ View };
use tur_kit::layout::box::{ Container, SizedBox };
use tur_kit::reactive::{ Mutation };
use tur_kit::text::core::{ Text };

// A compact pill button (the boa Button/IconButton composite); the
// mutation rides by parameter.
pub fn pill(key: str, label: str, m: Mutation<nil>, bg: u64, fg: u64) -> View {
    let face = Container()
        .padding(9.0)
        .radius(8.0)
        .color(bg)
        .child(Text().text(label).font_size(13.0).color(fg).build())
        .build();
    return PointerInteract()
        .on_click(m)
        .query_key(key)
        .child(face)
        .build();
}

// The error banner row (a visible failure state on landing + explorer).
pub fn error_banner(s: state::Gh) -> View {
    let banner = Container()
        .padding(10.0)
        .radius(8.0)
        .color(theme::DANGER_SOFT)
        .child(Text().text_bound(s.err).font_size(12.0).color(theme::DANGER).query_key("gh-err").build())
        .build();
    return Condition(s.err_has).then(banner).else_branch(SizedBox(0.0, 0.0).build()).build();
}
