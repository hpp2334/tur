// github-viewer: browse a public GitHub repo — landing form ("owner/repo"
// + quick-pick chips), a loading state, and an explorer (breadcrumb,
// stats, the directory listing with per-row taps, a selection footer).
// Single-file port of the boa TSX original (a 6-file case: index/landing/
// explorer/state/theme/ui — the explorer view is inlined here).
//
// Host surface: `net_request` (the async capability row) rides the spawn
// rail — the async journeys take their handles as PARAMETERS (the `Gh`
// bundle of sources) and a task-scoped ctx minted at the launch site; the
// tap mutations capture the bundle. GitHub's REST API is CORS-friendly,
// so the wasm build fetches it directly. Degradation: an empty response
// body (the net row completes empty on transport failure) becomes a
// visible error banner; a JSON error payload (404 / rate limit) surfaces
// the API's own message.
//
// JSON: the engine ships no parse row, so the two payloads the case
// reads (the repo meta object + the contents array of flat objects) are
// scanned by a tiny cursor parser below — `json_get_str` (one object's
// scalar field) and `json_contents` (an array walk into a display list).
// Escapes decode the common pairs; `\uXXXX` mints U+FFFD.
//
// Rust-boundary notes for future editors: unannotated float locals are
// `f32` by the default-width rule (annotate `: f64` when handing them to
// rows), and f-string braces take no nested string literals (bind a
// local first).
use tur_host::{ net_request, spawn, tctrl_set_text };
use tur_kit::{ Align, Axis, BorderPosition, Column, Condition, Container, CrossAlign, Cursor, Each, Expanded, Image, Input, ListHandle, MainAlign, MainAxisSize, MouseRegion, Mutation, MutationCtx, PointerInteract, Readable, Row, ScrollView, SizedBox, Source, Switch, TaskCtx, Text, image_resource_svg, list_new, mount, mutate, source, str_parse_f64, text_ctrl, undo_ctrl };

// The state bundle (the sources every journey reads and writes — handles
// bind at the launch site, captures stay rut-side).
struct Gh {
    mode: Source<str>;
    err: Source<str>;
    err_has: Source<bool>;
    repo_full: Source<str>;
    desc: Source<str>;
    stats: Source<str>;
    path: Source<str>;
    selected: Source<str>;
    files: Source<opaque>;
    is_empty: Source<bool>;
    busy: Source<bool>;
}

// The octocat brand mark (the boa state.ts GitHub glyph, rasterised
// through the image rail).
let SVG_GITHUB: str = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='#4f46e5'><path d='M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.5v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.6.8.5 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z'/></svg>";

// The boa theme (Notion / Linear-style light palette).
let PAGE_BG: u64 = 0xF8FAFCFFu64;
let PANEL: u64 = 0xFFFFFFFFu64;
let BORDER: u64 = 0xE2E8F0FFu64;
let TEXT: u64 = 0x0F172AFFu64;
let TEXT_MUTED: u64 = 0x64748BFFu64;
let TEXT_SUBTLE: u64 = 0x94A3B8FFu64;
let ACCENT: u64 = 0x4F46E5FFu64;
let ACCENT_SOFT: u64 = 0xEEF2FFFFu64;
let ACCENT_FG: u64 = 0xFFFFFFFFu64;
let DANGER: u64 = 0xEF4444FFu64;
let DANGER_SOFT: u64 = 0xFEF2F2FFu64;
let SUBTLE_BUTTON: u64 = 0xF1F5F9FFu64;
let SUBTLE_BUTTON_FG: u64 = 0x334155FFu64;
let INPUT_BG: u64 = 0xF8FAFCFFu64;
let INPUT_BORDER: u64 = 0xCBD5E1FFu64;
let DIR_ICON: u64 = 0x6366F1FFu64;
let FILE_ICON: u64 = 0x94A3B8FFu64;

// ASCII codepoints the scanner compares against (typed so the literals
// land on `u32`).
let C_QUOTE: u32 = 34;
let C_COMMA: u32 = 44;
let C_COLON: u32 = 58;
let C_PIPE: u32 = 124;
let C_SPACE: u32 = 32;
let C_SLASH: u32 = 47;
let C_BACKSLASH: u32 = 92;
let C_LBRACE: u32 = 123;
let C_RBRACE: u32 = 125;
let C_LBRACKET: u32 = 91;
let C_RBRACKET: u32 = 93;

entry fn start() -> u64 {
    let s = Gh {
        mode: source<str>("landing"),
        err: source<str>(""),
        err_has: source<bool>(false),
        repo_full: source<str>(""),
        desc: source<str>(""),
        stats: source<str>(""),
        path: source<str>(""),
        selected: source<str>(""),
        files: source<opaque>(list_new().raw()),
        is_empty: source<bool>(false),
        busy: source<bool>(false),
    };
    let ctrl = text_ctrl();
    // The boa landing boots with the draft pre-filled.
    ctrl.set_text("facebook/react");
    let undo = undo_ctrl();
    let gh = image_resource_svg(SVG_GITHUB);

    // The quick-pick chips: pre-fill the field and open directly (each
    // captures its literal name — no id rails).
    let b_sug0 = sug_mutation(ctrl, s, "facebook/react");
    let b_sug1 = sug_mutation(ctrl, s, "tailwindlabs/tailwindcss");
    let b_sug2 = sug_mutation(ctrl, s, "vuejs/core");
    // The Browse tap: read the draft, validate the owner/name shape, launch.
    let b_browse = mutate(fn (ctx: MutationCtx, _e: nil) {
        open_draft(ctx, s, ctrl.text());
    });

    let body = Switch()
        .value(s.mode)
        .query_key("gh-body")
        .cases("landing", landing_view(s, ctrl, undo, gh, b_browse, b_sug0, b_sug1, b_sug2))
        .cases("explorer", explorer_view(s))
        .build();
    let page = Container().color(PAGE_BG).padding(22.0).child(body).build();
    let root = Column()
        .cross_alignment(CrossAlign.Stretch)
        .child(Expanded().flex(1.0).child(page).build())
        .build();
    mount(root);
    return s.mode.atom_id();
}

// ---- shared chrome ---------------------------------------------------------

// A compact pill button (the boa Button/IconButton composite); the
// mutation rides by parameter.
fn pill(key: str, label: str, m: Mutation<nil>, bg: u64, fg: u64) -> View {
    let face = Container()
        .padding(9.0)
        .radius(8.0)
        .color(bg)
        .child(Text().text(label).font_size(13.0).color(fg).build())
        .build();
    return PointerInteract()
        .on_click(m)
        .query_key(key)
        .child(face)
        .build();
}

// The error banner row (a visible failure state on landing + explorer).
fn error_banner(s: Gh) -> View {
    let banner = Container()
        .padding(10.0)
        .radius(8.0)
        .color(DANGER_SOFT)
        .child(Text().text_bound(s.err).font_size(12.0).color(DANGER).query_key("gh-err").build())
        .build();
    return Condition(s.err_has).then(banner).else_branch(SizedBox(0.0, 0.0).build()).build();
}

// ---- landing ---------------------------------------------------------------

fn landing_view(s: Gh, ctrl: TextCtrl, undo: UndoCtrl, gh: u64, b_browse: Mutation<nil>,
                b_sug0: Mutation<nil>, b_sug1: Mutation<nil>,
                b_sug2: Mutation<nil>) -> View {
    // The boa Field: the "Repository" caption over the bordered input.
    let field = Column()
        .cross_alignment(CrossAlign.Stretch)
        .main_axis_size(MainAxisSize.Min)
        .child(Text().text("Repository").font_size(11.0).color(TEXT_SUBTLE).query_key("gh-field-label").build())
        .child(SizedBox(0.0, 6.0).build())
        .child(
            Container()
                .radius(7.0)
                .padding(9.0)
                .color(INPUT_BG)
                .border(INPUT_BORDER, 1.0, BorderPosition.Inside)
                .child(
                    Input()
                        .controller(ctrl)
                        .undo(undo)
                        .placeholder("facebook/react")
                        .font_size(14.0)
                        .width_height(0.0, 22.0)
                        .query_key("gh-input")
                        .build(),
                )
                .build(),
        )
        .build();
    // Fixed 360 card (the boa card capped at `min(440, vw - 44)`; the
    // playground's viewer pane is ~390 of content — 440 overflows it).
    let card = Container()
        .width(360.0)
        .padding(34.0)
        .radius(14.0)
        .color(PANEL)
        .border(BORDER, 1.0, BorderPosition.Inside)
        .child(
            Column()
                .cross_alignment(CrossAlign.Start)
                .main_axis_size(MainAxisSize.Min)
                .child(brand_mark(gh))
                .child(SizedBox(0.0, 18.0).build())
                .child(Text().text("Browse a public repo").font_size(18.0).color(TEXT).build())
                .child(SizedBox(0.0, 6.0).build())
                .child(Text().text("Enter a repo as \"owner/name\" to explore its files.").font_size(13.0).color(TEXT_MUTED).build())
                .child(SizedBox(0.0, 20.0).build())
                .child(field)
                .child(SizedBox(0.0, 8.0).build())
                .child(error_banner(s))
                .child(SizedBox(0.0, 8.0).build())
                .child(Row().main_alignment(MainAlign.End).child(pill("gh-browse", "Browse", b_browse, ACCENT, ACCENT_FG)).build())
                .child(SizedBox(0.0, 22.0).build())
                .child(Text().text("Try one of these").font_size(11.0).color(TEXT_SUBTLE).build())
                .child(SizedBox(0.0, 8.0).build())
                .child(suggestion_row(b_sug0, b_sug1, b_sug2))
                .build(),
        )
        .build();
    return Container().alignment(Align.Center).child(card).build();
}

// The 40x40 rounded brand mark (the boa octocat badge, an inline SVG
// through the image rail).
fn brand_mark(gh: u64) -> View {
    let mark = Container()
        .width_height(40.0, 40.0)
        .radius(10.0)
        .color(ACCENT_SOFT)
        .alignment(Align.Center)
        .child(Image(gh).width(24.0).height(24.0).query_key("gh-mark").build())
        .build();
    return mark;
}

fn suggestion_row(b_sug0: Mutation<nil>, b_sug1: Mutation<nil>,
                  b_sug2: Mutation<nil>) -> View {
    // Stacked (the boa mobile variant) — the three chips overflow the
    // 360 card's content width in a row. The boa quick-pick set (all
    // under jsDelivr's 50 MB tree cap).
    return Column()
        .cross_alignment(CrossAlign.Start)
        .main_axis_size(MainAxisSize.Min)
        .child(pill("gh-sug-0", "facebook/react", b_sug0, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))
        .child(SizedBox(0.0, 6.0).build())
        .child(pill("gh-sug-1", "tailwindlabs/tailwindcss", b_sug1, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))
        .child(SizedBox(0.0, 6.0).build())
        .child(pill("gh-sug-2", "vuejs/core", b_sug2, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))
        .build();
}

// ---- explorer --------------------------------------------------------------

fn explorer_view(s: Gh) -> View {
    // Back: up one directory, or back to the landing when at the root.
    let b_back = mutate(fn (ctx: MutationCtx, _e: nil) {
        let cur = ctx.get<str>(s.path);
        if (cur == "") {
            go_landing(ctx, s);
            return;
        }
        let n = cur.len();
        let mut sep: i32 = -1;
        let mut k = 0;
        while (k < n) {
            if (cur.code_at(k) == C_SLASH) {
                sep = k;
            }
            k = k + 1;
        }
        if (sep < 0) {
            ctx.set<str>(s.path, "");
        } else {
            ctx.set<str>(s.path, cur.slice(0, sep));
        }
        ctx.set<str>(s.selected, "");
        spawn(fetch_dir(TaskCtx.mint(), s));
    });
    // The crumb tap: back to the repo ROOT listing (the boa
    // navigateToRoot); the handles bind at the launch site.
    let b_root = mutate(fn (ctx: MutationCtx, _e: nil) {
        ctx.set<str>(s.path, "");
        ctx.set<str>(s.selected, "");
        spawn(fetch_dir(TaskCtx.mint(), s));
    });
    // Re-fetch the current directory.
    let b_refresh = mutate(fn (_ctx: MutationCtx, _e: nil) {
        spawn(fetch_dir(TaskCtx.mint(), s));
    });
    let list = ScrollView()
        .axis(Axis.Vertical)
        .child(
            Column()
                .cross_alignment(CrossAlign.Stretch)
                .main_axis_size(MainAxisSize.Min)
                .child(Each(s.files).item_builder(fn (i: u64, f: str) -> View {
                    return item_file(i, f, s);
                }).build())
                .build(),
        )
        .build();
    let loading = Container()
        .alignment(Align.Center)
        .child(Text().text("Loading…").font_size(13.0).color(TEXT_SUBTLE).query_key("gh-loading").build())
        .build();
    let empty = Container()
        .alignment(Align.Center)
        .padding(40.0)
        .child(
            Column()
                .cross_alignment(CrossAlign.Center)
                .main_axis_size(MainAxisSize.Min)
                .child(Text().text("This folder is empty").font_size(14.0).color(TEXT).build())
                .child(SizedBox(0.0, 6.0).build())
                .child(Text().text("No files to show at this path.").font_size(12.0).color(TEXT_SUBTLE).build())
                .build(),
        )
        .build();
    return Column()
        .cross_alignment(CrossAlign.Stretch)
        .child(
            Row()
                .cross_alignment(CrossAlign.Center)
                .child(
                    PointerInteract()
                        .on_click(b_back)
                        .query_key("gh-back")
                        .child(
                            Container()
                                .padding(9.0)
                                .radius(8.0)
                                .color(SUBTLE_BUTTON)
                                .child(Text().text("Back").font_size(13.0).color(SUBTLE_BUTTON_FG).build())
                                .build(),
                        )
                        .build(),
                )
                .child(SizedBox(10.0, 0.0).build())
                // The repo crumb (the boa RepoCrumb): a clickable chip that
                // navigates back to the repo root. 13px accent, padding 4 —
                // no invented weight. The crumb keeps the PARSED draft
                // identity (the crumb source is never overwritten by the
                // API's full_name). The key rides the TEXT (the tests read
                // the label through it; taps still hit the pad beneath).
                .child(
                    MouseRegion()
                        .cursor(Cursor.Pointer)
                        .child(
                            PointerInteract()
                                .on_click(b_root)
                                .child(
                                    Container().padding(4.0).child(
                                        Text().text_bound(s.repo_full).font_size(13.0).color(ACCENT).query_key("gh-crumb").build(),
                                    ).build(),
                                )
                                .build(),
                        )
                        .build(),
                )
                .child(SizedBox(6.0, 0.0).build())
                .child(Text().text_bound(s.path).font_size(13.0).color(TEXT_SUBTLE).query_key("gh-path").build())
                .build(),
        )
        .child(SizedBox(0.0, 4.0).build())
        .child(Text().text_bound(s.desc).font_size(12.0).color(TEXT_MUTED).query_key("gh-desc").build())
        .child(SizedBox(0.0, 8.0).build())
        .child(error_banner(s))
        .child(SizedBox(0.0, 8.0).build())
        .child(
            Row()
                .cross_alignment(CrossAlign.Center)
                .child(pill("gh-refresh", "Refresh", b_refresh, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))
                .child(SizedBox(10.0, 0.0).build())
                .child(Text().text_bound(s.stats).font_size(12.0).color(TEXT_MUTED).query_key("gh-stats").build())
                .build(),
        )
        .child(SizedBox(0.0, 8.0).build())
        .child(
            Expanded()
                .flex(1.0)
                // The file list (the boa fileListView): busy → "Loading…" in
                // the list area; else empty → the empty state; else the list.
                .child(
                    Condition(s.busy)
                        .then(loading)
                        .else_branch(
                            Condition(s.is_empty).then(empty).else_branch(list).build(),
                        )
                        .build(),
                )
                .build(),
        )
        .child(
            Container()
                .padding(6.0)
                .child(Text().text_bound(s.selected).font_size(12.0).color(TEXT_SUBTLE).query_key("gh-selected").build())
                .build(),
        )
        .build();
}

// One listing row: icon square + name + size. The row tap captures the
// row string + the bundle (a directory descends — a fresh contents fetch;
// a file fills the selection footer).
fn item_file(i: u64, s: str, g: Gh) -> View {
    let is_dir = s.starts_with(0, "d|");
    let n = s.len();
    let mut name = "";
    let mut size_txt = "";
    if (is_dir) {
        name = s.slice(2, n);
    } else {
        let mut k = 2;
        while (k < n) {
            if (s.code_at(k) == C_PIPE) {
                break;
            }
            k = k + 1;
        }
        name = s.slice(2, k);
        size_txt = fmt_size(s.slice(k + 1, n));
    }
    let mut icon = DIR_ICON;
    if (!is_dir) {
        icon = FILE_ICON;
    }
    let b_tap = mutate(fn (ctx: MutationCtx, _e: nil) {
        if (s.starts_with(0, "d|")) {
            let dname = s.slice(2, s.len());
            let cur = ctx.get<str>(g.path);
            let mut next = dname;
            if (cur != "") {
                next = f"{cur}/{dname}";
            }
            ctx.set<str>(g.path, next);
            ctx.set<str>(g.selected, "");
            spawn(fetch_dir(TaskCtx.mint(), g));
            return;
        }
        let rn = s.len();
        let mut k = 2;
        while (k < rn) {
            if (s.code_at(k) == C_PIPE) {
                break;
            }
            k = k + 1;
        }
        let fname = s.slice(2, k);
        let size = fmt_size(s.slice(k + 1, rn));
        ctx.set<str>(g.selected, f"{fname} — {size}");
    });
    let row = Row()
        .cross_alignment(CrossAlign.Center)
        .child(Container().width_height(14.0, 14.0).radius(3.0).color(icon).build())
        .child(SizedBox(10.0, 0.0).build())
        .child(Expanded().flex(1.0).child(Text().text(name).font_size(13.0).color(TEXT).build()).build())
        .child(SizedBox(10.0, 0.0).build())
        .child(Text().text(size_txt).font_size(11.0).color(TEXT_SUBTLE).build())
        .build();
    let card = Container()
        .padding(9.0)
        .radius(8.0)
        .color(PANEL)
        .border(BORDER, 1.0, BorderPosition.Inside)
        .child(row)
        .build();
    return PointerInteract()
        .on_click(b_tap)
        .query_key("gh-row")
        .child(card)
        .build();
}

// ---- actions ---------------------------------------------------------------

// A quick-pick chip's mutation: pre-fill the field and open directly.
fn sug_mutation(ctrl: TextCtrl, s: Gh, name: str) -> Mutation<nil> {
    return mutate(fn (ctx: MutationCtx, _e: nil) {
        ctrl.set_text(name);
        open_draft(ctx, s, name);
    });
}

// The draft rail shared by Browse + the chips: validate the owner/name
// shape, then launch the repo journey (the handles bind at the launch
// site).
fn open_draft(ctx: MutationCtx, s: Gh, draft: str) {
    let full = parse_repo(draft);
    if (full == "") {
        ctx.set<str>(s.err, "Enter a repo as \"owner/name\" — e.g. facebook/react");
        ctx.set<bool>(s.err_has, true);
        return;
    }
    ctx.set<str>(s.err, "");
    ctx.set<bool>(s.err_has, false);
    ctx.set<str>(s.repo_full, full);
    spawn(open_repo(TaskCtx.mint(), s));
}

fn go_landing(ctx: MutationCtx, s: Gh) {
    ctx.set<str>(s.mode, "landing");
    ctx.set<str>(s.err, "");
    ctx.set<bool>(s.err_has, false);
    ctx.set<str>(s.desc, "");
    ctx.set<str>(s.stats, "");
    ctx.set<str>(s.path, "");
    ctx.set<str>(s.selected, "");
    ctx.set<bool>(s.is_empty, false);
    ctx.set<bool>(s.busy, false);
}

// The repo-meta journey: land straight on the explorer chrome with the
// list area showing "Loading…" (boa's shape — no full-pane loading), GET
// the repo, surface its error payload or seed the explorer and fetch the
// root listing. The crumb keeps the PARSED draft identity (boa's repo$) —
// the API's full_name never overwrites it.
async fn open_repo(ctx: TaskCtx, s: Gh) -> str {
    ctx.set<bool>(s.busy, true);
    let full = ctx.get<str>(s.repo_full);
    let url = f"https://api.github.com/repos/{full}";
    let body = await net_request(url, "GET");
    if (body.len() == 0) {
        ctx.set<bool>(s.busy, false);
        fail(ctx, s, "Network request failed — the browser may be offline.", false);
        return "";
    }
    let meta = body.decode();
    let name = json_get_str(meta, "full_name");
    if (name == "") {
        ctx.set<bool>(s.busy, false);
        let msg = json_get_str(meta, "message");
        if (msg == "") {
            fail(ctx, s, "Unexpected response from the GitHub API.", false);
        } else {
            fail(ctx, s, f"{msg} — check the name (owner/repo).", false);
        }
        return "";
    }
    ctx.set<str>(s.desc, json_get_str(meta, "description"));
    ctx.set<str>(s.stats, fmt_stats(meta));
    ctx.set<str>(s.path, "");
    ctx.set<str>(s.selected, "");
    await fetch_dir(ctx, s);
    return "";
}

// The directory journey: GET .../contents[/path], fill the display list
// (dirs first), flip the empty flag, settle on the explorer. The list
// area shows "Loading…" while the fetch rides (the busy source).
async fn fetch_dir(ctx: TaskCtx, s: Gh) -> str {
    ctx.set<str>(s.mode, "explorer");
    ctx.set<bool>(s.busy, true);
    let full = ctx.get<str>(s.repo_full);
    let dir = ctx.get<str>(s.path);
    let mut url = f"https://api.github.com/repos/{full}/contents";
    if (dir != "") {
        url = f"https://api.github.com/repos/{full}/contents/{dir}";
    }
    let body = await net_request(url, "GET");
    if (body.len() == 0) {
        ctx.set<bool>(s.busy, false);
        fail(ctx, s, "Network request failed — the browser may be offline.", true);
        return "";
    }
    let text = body.decode();
    let fresh = list_new();
    let ndirs = json_contents(text, fresh, true);
    let nfiles = json_contents(text, fresh, false);
    if (ndirs < 0 || nfiles < 0) {
        ctx.set<bool>(s.busy, false);
        fail(ctx, s, "Unexpected file-list response from the GitHub API.", true);
        return "";
    }
    ctx.set<opaque>(s.files, fresh.raw());
    ctx.set<bool>(s.is_empty, ndirs + nfiles == 0);
    ctx.set<bool>(s.busy, false);
    ctx.set<str>(s.mode, "explorer");
    return "";
}

// The failure rail: the message lands on the banner; `explorer` keeps the
// listing visible under it, anything else falls back to the landing.
fn fail(ctx: TaskCtx, s: Gh, msg: str, stay: bool) {
    ctx.set<str>(s.err, msg);
    ctx.set<bool>(s.err_has, true);
    if (stay) {
        ctx.set<str>(s.mode, "explorer");
    } else {
        ctx.set<str>(s.mode, "landing");
    }
}

// ---- helpers ---------------------------------------------------------------

// "owner/repo" out of a draft; "" when the shape is wrong (a `.git`
// suffix is stripped).
fn parse_repo(draft: str) -> str {
    let n = draft.len();
    let mut a = 0;
    while (a < n && draft.code_at(a) == C_SPACE) {
        a = a + 1;
    }
    let mut b = n;
    while (b > a && draft.code_at(b - 1) == C_SPACE) {
        b = b - 1;
    }
    let t = draft.slice(a, b);
    let m = t.len();
    let mut sep: i32 = -1;
    let mut k = 0;
    while (k < m) {
        if (t.code_at(k) == C_SLASH) {
            sep = k;
            break;
        }
        k = k + 1;
    }
    if (sep <= 0 || sep >= m - 1) {
        return "";
    }
    let owner = t.slice(0, sep);
    let mut repo = t.slice(sep + 1, m);
    let rl = repo.len();
    if (rl > 4 && repo.starts_with(rl - 4, ".git")) {
        repo = repo.slice(0, rl - 4);
    }
    return f"{owner}/{repo}";
}

// "rust · stars 12.3k · forks 4.5k · issues 123" — the language folded in
// when present.
fn fmt_stats(meta: str) -> str {
    let lang = json_get_str(meta, "language");
    let stars = json_get_str(meta, "stargazers_count");
    let forks = json_get_str(meta, "forks_count");
    let issues = json_get_str(meta, "open_issues_count");
    let mut out = "";
    if (lang != "") {
        out = f"{out}{lang} · ";
    }
    return f"{out}stars {fmt_count(stars)} · forks {fmt_count(forks)} · issues {fmt_count(issues)}";
}

// 12345 → "12.3k"; 123 → "123".
fn fmt_count(s: str) -> str {
    let v: f64 = str_parse_f64(s);
    if (v >= 1000.0) {
        let d = ((v / 1000.0) * 10.0) as u64;
        return f"{d / 10}.{d % 10}k";
    }
    return f"{v as u64}";
}

// 2739 → "2.7 KB"; 12 → "12 B".
fn fmt_size(s: str) -> str {
    if (s == "") {
        return "—";
    }
    let v: f64 = str_parse_f64(s);
    if (v < 1024.0) {
        return f"{v as u64} B";
    }
    let mut x: f64 = v / 1024.0;
    let mut unit = "KB";
    if (v >= 1048576.0) {
        x = v / 1048576.0;
        unit = "MB";
    }
    let d = (x * 10.0) as u64;
    return f"{d / 10}.{d % 10} {unit}";
}

// ---- the JSON scanner ------------------------------------------------------

fn ws(c: u32) -> bool {
    return c == C_SPACE || c == 9 || c == 10 || c == 13;
}

fn skip_ws(t: str, i: i32) -> i32 {
    let n = t.len();
    let mut j = i;
    while (j < n && ws(t.code_at(j))) {
        j = j + 1;
    }
    return j;
}

// The index just past the string literal opening at `i` (escapes skip
// whole pairs).
fn str_end(t: str, i: i32) -> i32 {
    let n = t.len();
    let mut j = i + 1;
    while (j < n) {
        let c = t.code_at(j);
        if (c == C_BACKSLASH) {
            j = j + 2;
            continue;
        }
        if (c == C_QUOTE) {
            return j + 1;
        }
        j = j + 1;
    }
    return n;
}

// Decode the string literal whose opening quote sits at `i` (the common
// escapes; `\uXXXX` mints U+FFFD).
fn str_unquote(t: str, i: i32) -> str {
    let end = str_end(t, i);
    let raw = t.slice(i + 1, end - 1);
    let n = raw.len();
    let mut out = "";
    let mut k = 0;
    while (k < n) {
        let c = raw.code_at(k);
        if (c != C_BACKSLASH) {
            out = f"{out}{raw.slice(k, k + 1)}";
            k = k + 1;
            continue;
        }
        if (k + 1 >= n) {
            break;
        }
        let e = raw.code_at(k + 1);
        if (e == C_QUOTE) {
            out = f"{out}\"";
        } else if (e == C_BACKSLASH) {
            out = f"{out}\\";
        } else if (e == C_SLASH) {
            out = f"{out}/";
        } else if (e == 110) {
            out = f"{out}\n";
        } else if (e == 116) {
            out = f"{out}\t";
        } else if (e == 117) {
            out = f"{out}\u{FFFD}";
            k = k + 6;
            continue;
        } else {
            out = f"{out}{raw.slice(k + 1, k + 2)}";
        }
        k = k + 2;
    }
    return out;
}

// Skip one JSON value at `i`; answers the index just past it (strings,
// nested containers walked with depth, scalars to the next delimiter).
fn json_skip(t: str, i: i32) -> i32 {
    let n = t.len();
    let j = skip_ws(t, i);
    if (j >= n) {
        return n;
    }
    let c = t.code_at(j);
    if (c == C_QUOTE) {
        return str_end(t, j);
    }
    if (c == C_LBRACE || c == C_LBRACKET) {
        let mut depth = 0;
        let mut k = j;
        while (k < n) {
            let d = t.code_at(k);
            if (d == C_QUOTE) {
                k = str_end(t, k);
                continue;
            }
            if (d == C_LBRACE || d == C_LBRACKET) {
                depth = depth + 1;
            } else if (d == C_RBRACE || d == C_RBRACKET) {
                depth = depth - 1;
                if (depth == 0) {
                    return k + 1;
                }
            }
            k = k + 1;
        }
        return n;
    }
    let mut k = j;
    while (k < n) {
        let d = t.code_at(k);
        if (d == C_COMMA || d == C_RBRACE || d == C_RBRACKET || ws(d)) {
            break;
        }
        k = k + 1;
    }
    return k;
}

// One object's scalar field: the decoded string for string values, the
// raw text for numbers/bools, "" when absent (or the value is
// null/container).
fn json_get_str(t: str, key: str) -> str {
    let n = t.len();
    let mut i = skip_ws(t, 0);
    if (i >= n || t.code_at(i) != C_LBRACE) {
        return "";
    }
    i = skip_ws(t, i + 1);
    while (i < n) {
        if (t.code_at(i) == C_RBRACE) {
            return "";
        }
        if (t.code_at(i) != C_QUOTE) {
            return "";
        }
        let key_end = str_end(t, i);
        let k = t.slice(i + 1, key_end - 1);
        let j = skip_ws(t, key_end);
        if (j >= n || t.code_at(j) != C_COLON) {
            return "";
        }
        let vs = skip_ws(t, j + 1);
        if (k == key) {
            if (vs < n && t.code_at(vs) == C_QUOTE) {
                return str_unquote(t, vs);
            }
            if (vs < n && t.code_at(vs) != C_LBRACE && t.code_at(vs) != C_LBRACKET) {
                let vend = json_skip(t, vs);
                return t.slice(vs, vend);
            }
            return "";
        }
        i = skip_ws(t, json_skip(t, vs));
        if (i < n && t.code_at(i) == C_COMMA) {
            i = skip_ws(t, i + 1);
        }
    }
    return "";
}

// Walk a JSON array of flat objects; push "d|name" (dirs pass) or
// "f|name|bytes" (files pass) onto `out`. Answers the item count seen, or
// -1 when the payload is not an array of objects.
fn json_contents(t: str, out: ListHandle, dirs_only: bool) -> i32 {
    let n = t.len();
    let mut i = skip_ws(t, 0);
    if (i >= n || t.code_at(i) != C_LBRACKET) {
        return -1;
    }
    i = skip_ws(t, i + 1);
    let mut count: i32 = 0;
    while (i < n) {
        if (t.code_at(i) == C_RBRACKET) {
            return count;
        }
        if (t.code_at(i) != C_LBRACE) {
            return -1;
        }
        let iend = json_skip(t, i);
        let item = t.slice(i, iend);
        let kind = json_get_str(item, "type");
        let is_dir = kind == "dir";
        if (is_dir == dirs_only) {
            let name = json_get_str(item, "name");
            if (is_dir) {
                out.push(f"d|{name}");
            } else {
                let size = json_get_str(item, "size");
                out.push(f"f|{name}|{size}");
            }
            count = count + 1;
        }
        i = skip_ws(t, iend);
        if (i < n && t.code_at(i) == C_COMMA) {
            i = skip_ws(t, i + 1);
        }
    }
    return count;
}
