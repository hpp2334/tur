// lazy-list-row: a 50-item HORIZONTAL virtualized list (80px columns).
use tur_kit::flags::{ Axis };
use tur_kit::handles::{ View, mount };
use tur_kit::layout::box::{ Container };
use tur_kit::reactive::{ Source, source };
use tur_kit::scroll::{ LazyList };

fn item(i: u64) -> View {
    let mut b = Container().width_height(80.0, 300.0);
    if (i % 2 == 0) {
        b.color(0x303030FF);
    } else {
        b.color(0x1A1A1AFF);
    }
    return b.build();
}

entry fn start() {
    let count = source<f64>(50.0);
    let list = LazyList().item_builder(item).count(count).axis(Axis.Horizontal).item_extent(80.0).query_key("lazy-list-row").build();
    mount(list);
}
