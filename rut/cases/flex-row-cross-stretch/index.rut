// flex-row-cross-stretch: fixed-width children stretched to the row's
// full cross axis (the viewport height).
use tur::{ CROSS_ALIGN_STRETCH, mount };
use tur_kit::{ Container, Row };


fn box_wh(w: f64, h: f64) -> View {
    let b = Container().width_height(w, h);
    return b.build();
}

entry fn start() {
    let row = Row()
        .cross_alignment(CROSS_ALIGN_STRETCH)
        .child(box_wh(50.0, 0.0))
        .child(box_wh(30.0, 0.0));
    mount(row.build());
}
