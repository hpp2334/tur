// scroll-view-shrink-wrap: the viewport shrink-wraps to its content
// (120x80) under the root's loose constraints (Flutter
// _RenderSingleChildViewport parity).
use tur_kit::flags::{ Axis, CrossAlign }; use tur_kit::handles::{ View, mount }; use tur_kit::layout::box::{ Container }; use tur_kit::layout::flex::{ Column }; use tur_kit::scroll::{ ScrollView };use tur_kit::reactive::{ sv };


entry fn start() {
    let content = Column()
        .cross_alignment(CrossAlign.Start)
        .child(sized(120.0, 40.0))
        .child(sized(60.0, 40.0));
    let sv = ScrollView().axis(Axis.Vertical).child(content.build()).query_key("sv").build();
    mount(sv);
}

fn sized(w: f64, h: f64) -> View {
    let b = Container().width_height(w, h);
    return b.build();
}
