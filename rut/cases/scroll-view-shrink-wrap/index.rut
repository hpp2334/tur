// scroll-view-shrink-wrap: the viewport shrink-wraps to its content
// (120x80) under the root's loose constraints (Flutter
// _RenderSingleChildViewport parity).
use tur_host::{ AXIS_VERTICAL, CROSS_ALIGN_START };
use tur_kit::{ Column, Container, ScrollView, mount };


entry fn start() {
    let content = Column()
        .cross_alignment(CROSS_ALIGN_START)
        .child(sized(120.0, 40.0))
        .child(sized(60.0, 40.0));
    let sv = ScrollView().axis(AXIS_VERTICAL).child(content.build()).query_key("sv").build();
    mount(sv);
}

fn sized(w: f64, h: f64) -> View {
    let b = Container().width_height(w, h);
    return b.build();
}
