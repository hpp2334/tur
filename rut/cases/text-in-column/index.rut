// text-in-column: two Texts stacked in a start-aligned Column.
use tur_host::{ CROSS_ALIGN_START, mount };
use tur_kit::{ Column, Text };


entry fn start() {
    let mut col = Column().cross_alignment(CROSS_ALIGN_START);
    let first = Text().text("First").font_size(14.0);
    let second = Text().text("Second").font_size(14.0);
    col.child(first.build());
    col.child(second.build());
    mount(col.build());
}
