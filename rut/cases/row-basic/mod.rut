// row-basic: two fixed-width children laid out horizontally.
use tur_kit::flags::{ CrossAlign };
use tur_kit::handles::{ View, mount };
use tur_kit::layout::box::{ Container };
use tur_kit::layout::flex::{ Row };

fn box_w(w: f64) -> View {
    let b = Container().width_height(w, 0.0);
    return b.build();
}

entry fn start() {
    let row = Row().cross_alignment(CrossAlign.Start).child(box_w(50.0)).child(box_w(30.0));
    mount(row.build());
}
