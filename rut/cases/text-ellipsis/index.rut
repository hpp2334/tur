// text-ellipsis: the long line ellipsized at two lines.
use tur_host::{ mount };
use tur_kit::{ Text };


entry fn start() {
    let t = Text()
        .text("Hello World this is a long text that should wrap")
        .font_size(14.0)
        .max_lines(2)
        .ellipsis();
    mount(t.build());
}
