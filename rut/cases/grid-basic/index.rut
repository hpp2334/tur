// grid-basic: a static Grid of 12 hue cells (the boa port). The column
// count derives from `max_cross` (140) and the pane width — Flutter's
// maxCrossAxisExtent semantics (ceil) — so the cells tile row-major as
// squares with an 8px gutter. Cells are flat colored boxes: the grid
// hands each child its tight cell rect, so no explicit sizing here.
//
// The child loop feeding `.child()` runs BEFORE the single `.build()`
// (build-then-mutate stays out; repetition is just the loop).
use tur_host::mount;
use tur_kit::{ Container, Grid };


entry fn start() {
    let mut grid = Grid().max_cross(140.0).spacing(8.0, 8.0).query_key("grid-basic");
    let mut i: u64 = 0;
    while (i < 12) {
        grid.child(Container().color(hsl_packed(i as f64 * 30.0, 65.0, 55.0)).build());
        i = i + 1;
    }
    mount(grid.build());
}

// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).
fn hsl_packed(h: f64, s: f64, l: f64) -> u64 {
    let sat: f64 = s / 100.0;
    let light: f64 = l / 100.0;
    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;
    let hue: f64 = h % 360.0;
    let hp: f64 = hue / 60.0;
    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));
    let mut r1: f64 = 0.0;
    let mut g1: f64 = 0.0;
    let mut b1: f64 = 0.0;
    if (hp < 1.0) {
        r1 = c;
        g1 = x;
    } else if (hp < 2.0) {
        r1 = x;
        g1 = c;
    } else if (hp < 3.0) {
        g1 = c;
        b1 = x;
    } else if (hp < 4.0) {
        g1 = x;
        b1 = c;
    } else if (hp < 5.0) {
        r1 = x;
        b1 = c;
    } else {
        r1 = c;
        b1 = x;
    }
    let m: f64 = light - c / 2.0;
    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;
    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;
    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;
    return r * 16777216 + g * 65536 + b * 256 + 255;
}

fn abs_f(v: f64) -> f64 {
    if (v < 0.0) {
        return -v;
    }
    return v;
}
