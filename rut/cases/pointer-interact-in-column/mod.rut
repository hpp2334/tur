// pointer-interact-in-column: two gesture pads stacked in a column.
use tur_kit::flags::{ CrossAlign };
use tur_kit::gesture::pointer::{ PointerInteract };
use tur_kit::handles::{ mount };
use tur_kit::layout::box::{ Container };
use tur_kit::layout::flex::{ Column };

entry fn start() {
    let mut col = Column().cross_alignment(CrossAlign.Start);
    let a = Container().width_height(80.0, 40.0);
    let b = Container().width_height(60.0, 30.0);
    col.child(PointerInteract().child(a.build()).build());
    col.child(PointerInteract().child(b.build()).build());
    mount(col.build());
}
