// pointer-drag: a gesture pad reporting down/move/up — the phase label
// and the last position ride two bound sources; the drag mutations
// receive the typed `PointerEvent` (state by capture, data by argument).
use tur_host::{ ALIGN_CENTER, CROSS_ALIGN_START, mount };
use tur_kit::{ Column, Container, Mutation, MutationCtx, PointerEvent, PointerInteract, Readable, Source, Text, mutate, source };


entry fn start() -> u64 {
    let phase: Readable<str> = source<str>("idle");
    let pos: Readable<str> = source<str>("0,0");

    let b_down = mutate<PointerEvent>(fn (ctx: MutationCtx, ev: PointerEvent) {
        ctx.set<str>(pos, f"{ev.global.x as u64},{ev.global.y as u64}");
        ctx.set<str>(phase, "down");
    });
    let b_move = mutate<PointerEvent>(fn (ctx: MutationCtx, ev: PointerEvent) {
        ctx.set<str>(pos, f"{ev.global.x as u64},{ev.global.y as u64}");
        ctx.set<str>(phase, "move");
    });
    let b_up = mutate<PointerEvent>(fn (ctx: MutationCtx, ev: PointerEvent) {
        ctx.set<str>(pos, f"{ev.global.x as u64},{ev.global.y as u64}");
        ctx.set<str>(phase, "up");
    });

    let mut col = Column().cross_alignment(CROSS_ALIGN_START);

    let b = Container()
        .width_height(100.0, 50.0)
        .color(0xCCCCCCFFu64)
        .alignment(ALIGN_CENTER)
        .child(Text().text_bound(phase).query_key("drag-phase").build());

    col.child(PointerInteract().on_pointer_down(b_down).on_pointer_move(b_move).on_pointer_up(b_up).query_key("rut/gesture").child(b.build()).build());

    let pos_t = Text().text_bound(pos).query_key("drag-pos");
    col.child(pos_t.build());

    mount(col.build());
    return phase.atom_id();
}
