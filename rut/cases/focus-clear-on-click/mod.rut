// focus-clear-on-click: a focused Input above a PointerInteract button —
// clicking the button clears focus (the gesture handler's outside-click
// path).
use tur_kit::{ Column, Input, Mutation, MutationCtx, PointerInteract, Readable, Source, Text, mount, mutate, source, text_ctrl, undo_ctrl };

entry fn start() -> u64 {
    let clicks: Readable<f64> = source<f64>(0.0);
    let label: Readable<str> = source<str>("clicks: 0");
    let ctrl = text_ctrl();
    let undo = undo_ctrl();

    let b_click = mutate(fn (ctx: MutationCtx, _e: nil) {
        ctx.set<f64>(clicks, ctx.get<f64>(clicks) + 1.0);
        ctx.set<str>(label, f"clicks: {ctx.get<f64>(clicks) as u64}");
    });

    let mut col = Column();
    let input = Input().controller(ctrl).undo(undo).width_height(200.0, 30.0).query_key("editable").build();
    col.child(input);
    let t = Text().text_bound(label).query_key("button");
    col.child(PointerInteract().on_click(b_click).child(t.build()).build());
    mount(col.build());
    return clicks.atom_id();
}
