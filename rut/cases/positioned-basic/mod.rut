// positioned-basic: a positioned child anchored (10, 20) inside a Stack.

use tur_kit::handles::{ mount };
use tur_kit::layout::box::{ Container };
use tur_kit::layout::stack::{ Positioned, Stack };

entry fn start() {
    let mut stack = Stack();
    let sb = Container().width_height(50.0, 50.0);
    stack.child(Positioned().left(10.0).top(20.0).child(sb.build()).build());
    mount(stack.build());
}
