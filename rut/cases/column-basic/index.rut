// column-basic: two fixed-height children stacked vertically (the root
// Column fills the viewport; cross axis start-aligned).
use tur_kit::{ Column, Container, CrossAlign, mount };

fn box_h(h: f64) -> View {
    let b = Container().width_height(0.0, h);
    return b.build();
}

entry fn start() {
    let col = Column().cross_alignment(CrossAlign.Start).child(box_h(50.0)).child(box_h(30.0));
    mount(col.build());
}
