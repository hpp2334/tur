use tur_kit::handles::{ mount };
use tur_kit::text::core::{ Spans, Text };
use tur_kit::flags::{ SpanFlags };
use tur_kit::reactive::{ sv };

entry fn start() {
    let t = Text().text(sv("")).font_size(14.0);
    let spans =
        Spans().add("White", 0.0, 0, 0.0, SpanFlags::None).add(
            "Red",
            0.0,
            4278190335u64,
            0.0,
            SpanFlags::None,
        ).add("Green", 0.0, 16711935u64, 0.0, SpanFlags::None);
    t.spans(spans);
    mount(t.build());
}
