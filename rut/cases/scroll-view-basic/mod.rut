// scroll-view-basic: a vertical scroll viewport around a 3x200 column.
use tur_kit::flags::{ Axis, CrossAlign }; use tur_kit::handles::{ View, mount }; use tur_kit::layout::box::{ Container }; use tur_kit::layout::flex::{ Column }; use tur_kit::scroll::{ ScrollView };use tur_kit::reactive::{ sv };


entry fn start() {
    let content = Column()
        .cross_alignment(CrossAlign.Stretch)
        .child(box_h(200.0))
        .child(box_h(200.0))
        .child(box_h(200.0));
    let sv = ScrollView().axis(Axis.Vertical).child(content.build()).query_key("scroll-view").build();
    mount(sv);
}

fn box_h(h: f64) -> View {
    let b = Container().width_height(0.0, h);
    return b.build();
}
