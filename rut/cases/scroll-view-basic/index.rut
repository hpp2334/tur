// scroll-view-basic: a vertical scroll viewport around a 3x200 column.
use tur::{ AXIS_VERTICAL, CROSS_ALIGN_STRETCH, mount };
use tur_kit::{ Column, Container, ScrollView };


entry fn start() {
    let content = Column()
        .cross_alignment(CROSS_ALIGN_STRETCH)
        .child(box_h(200.0))
        .child(box_h(200.0))
        .child(box_h(200.0));
    let sv = ScrollView().axis(AXIS_VERTICAL).child(content.build()).query_key("scroll-view").build();
    mount(sv);
}

fn box_h(h: f64) -> View {
    let b = Container().width_height(0.0, h);
    return b.build();
}
