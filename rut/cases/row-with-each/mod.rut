// row-with-each: an Each inside a content-sized Row — the Row must not
// inflate to the parent Column's height (the regression the test pins).
use tur_kit::control_flow::control::{ Each };
use tur_kit::flags::{ CrossAlign };
use tur_kit::handles::{ View, list_new, mount };
use tur_kit::layout::box::{ Container, SizedBox };
use tur_kit::layout::flex::{ Column, Expanded, Row };
use tur_kit::reactive::{ Source, source };
use tur_kit::text::core::{ Text };

fn item(_i: u64, s: str) -> View {
    let t = Text().text(s).font_size(13.0);
    return t.build();
}

entry fn start() {
    let seg = list_new();
    seg.push("a");
    seg.push("b");
    let seg_atom = source<opaque>(seg.raw());

    let col = Column()
        .cross_alignment(CrossAlign.Stretch)
        .child(Row().child(SizedBox(16.0, 16.0).child(Container().build()).build()).child(Each(seg_atom).item_builder(item).build()).build())
        .child(SizedBox(40.0, 10.0).child(Container().build()).build())
        .child(Expanded().flex(1.0).child(Container().build()).build());
    mount(col.build());
}
