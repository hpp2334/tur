// row-with-each: an Each inside a content-sized Row — the Row must not
// inflate to the parent Column's height (the regression the test pins).
use tur_host::{ CROSS_ALIGN_STRETCH, mount };
use tur_kit::{ Column, Container, Each, Expanded, Row, SizedBox, Source, Text, list_new, list_push, source };


fn item(_i: u64, s: str) -> View {
    let t = Text().text(s).font_size(13.0);
    return t.build();
}

entry fn start() {
    let seg = list_new();
    list_push(seg, "a");
    list_push(seg, "b");
    let seg_atom = source<opaque>(seg);

    let col = Column()
        .cross_alignment(CROSS_ALIGN_STRETCH)
        .child(Row().child(SizedBox(16.0, 16.0).child(Container().build()).build()).child(Each(seg_atom).item_builder(item).build()).build())
        .child(SizedBox(40.0, 10.0).child(Container().build()).build())
        .child(Expanded().flex(1.0).child(Container().build()).build());
    mount(col.build());
}
