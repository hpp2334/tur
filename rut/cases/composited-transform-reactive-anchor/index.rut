// composited-transform-reactive-anchor: the target anchor resolves from a
// source; the button (20, 540) flips it to BottomRight — the follower
// relocates to the target's bottom-right (160, 120).
use tur_host::{ ALIGN_TOP_LEFT, ct_link_new, mount };
use tur_kit::{ CompositedFollower, CompositedTarget, Container, Mutation, MutationCtx, PointerInteract, Positioned, Readable, SizedBox, Source, Stack, mutate, source };


entry fn start() -> u64 {
    let anchor: Readable<f64> = source<f64>(0.0);
    let b_flip = mutate(fn (ctx: MutationCtx, _e: nil) {
        ctx.set<f64>(anchor, 8.0);
    });
    let link = ct_link_new();
    let mut stack = Stack()
        .child(SizedBox(400.0, 600.0).child(Container().build()).build());
    let target_child = SizedBox(60.0, 40.0).child(Container().build()).build();
    let target = CompositedTarget().link(link).child(target_child).build();
    stack.child(Positioned().left(100.0).top(80.0).child(target).build());
    let red = Container().width_height(20.0, 20.0).color(0xFF0000FFu64);
    let follower = CompositedFollower().link(link).target_anchor_bound(anchor).follower_anchor(ALIGN_TOP_LEFT).child(red.build()).build();
    stack.child(follower);

    let btn = Container().width_height(60.0, 30.0).color(0x4F46E1FFu64);
    stack.child(Positioned().left(20.0).top(540.0).child(PointerInteract().on_click(b_flip).child(btn.build()).build()).build());
    mount(stack.build());
    return anchor.atom_id();
}
