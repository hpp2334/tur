// four-color-quadrants: a 2x2 grid of 100x100 colored quadrants (Stack +
// positioned fills) — the vello render fixtures sample exact pixels.

use tur_kit::{ Container, Positioned, Stack, mount };

fn quad(color: u64) -> View {
    let b = Container().width_height(100.0, 100.0).color(color);
    return b.build();
}

entry fn start() {
    let stack = Stack()
        .child(Positioned().left(0.0).top(0.0).child(quad(0xFF0000FFu64)).build())
        .child(Positioned().left(100.0).top(0.0).child(quad(0x00FF00FFu64)).build())
        .child(Positioned().left(0.0).top(100.0).child(quad(0x0000FFFFu64)).build())
        .child(Positioned().left(100.0).top(100.0).child(quad(0xFFFF00FFu64)).build());
    mount(stack.build());
}
