// color — the boa palette (deep slate page, indigo active chips) + the
// tile ramp (hsl → the packed 0xRRGGBBAA color).

// The boa palette (deep slate page, indigo active chips).
pub let PAGE_BG: u64 = 0x0F172AFFu64;
pub let TITLE_FG: u64 = 0xF1F5F9FFu64;
pub let SUB_FG: u64 = 0x94A3B8FFu64;
pub let PANEL_BG: u64 = 0x020617FFu64;
pub let CHIP_ON: u64 = 0x6366F1FFu64;
pub let CHIP_OFF: u64 = 0x1E293BFFu64;
pub let CHIP_FG: u64 = 0xE2E8F0FFu64;
pub let LABEL_FG: u64 = 0xFFFFFFFFu64;
pub let RING_ON: u64 = 0xFFFFFFFFu64;

// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).
pub fn hsl_packed(h: f64, s: f64, l: f64) -> u64 {
    let sat: f64 = s / 100.0;
    let light: f64 = l / 100.0;
    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;
    let hue: f64 = h % 360.0;
    let hp: f64 = hue / 60.0;
    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));
    let mut r1: f64 = 0.0;
    let mut g1: f64 = 0.0;
    let mut b1: f64 = 0.0;
    if (hp < 1.0) {
        r1 = c;
        g1 = x;
    } else if (hp < 2.0) {
        r1 = x;
        g1 = c;
    } else if (hp < 3.0) {
        g1 = c;
        b1 = x;
    } else if (hp < 4.0) {
        g1 = x;
        b1 = c;
    } else if (hp < 5.0) {
        r1 = x;
        b1 = c;
    } else {
        r1 = c;
        b1 = x;
    }
    let m: f64 = light - c / 2.0;
    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;
    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;
    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;
    return r * 16777216 + g * 65536 + b * 256 + 255;
}

fn abs_f(v: f64) -> f64 {
    if (v < 0.0) {
        return -v;
    }
    return v;
}
