// column-nested: a Column inside a Column. Non-flex children receive
// UNBOUNDED main-axis constraints, so the inner Column (default
// MainAxisSize.max) must degenerate to content size (Flutter RenderFlex
// parity).
use tur_host::{ CROSS_ALIGN_START };
use tur_kit::{ Column, Container, mount };


fn box_h(h: f64) -> View {
    let b = Container().width_height(0.0, h);
    return b.build();
}

entry fn start() {
    let outer = Column()
        .cross_alignment(CROSS_ALIGN_START)
        .child(box_h(50.0))
        .child(Column().cross_alignment(CROSS_ALIGN_START).child(box_h(30.0)).build())
        .child(box_h(40.0));
    mount(outer.build());
}
