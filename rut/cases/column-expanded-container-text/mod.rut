// column-expanded-container-text: a padded unsized Container sized from
// its Text child, wrapped in Expanded inside a max Column.

use tur_kit::handles::{ mount };
use tur_kit::layout::box::{ Container };
use tur_kit::layout::flex::{ Column, Expanded };
use tur_kit::text::core::{ Text };

entry fn start() {
    let mut col = Column();
    let b = Container()
        .padding(48.0)
        .query_key("container")
        .child(Text().text("Empty State").font_size(24.0).build());
    col.child(Expanded().flex(1.0).child(b.build()).build());
    mount(col.build());
}
