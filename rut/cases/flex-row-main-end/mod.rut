// flex-row-main-end: two fixed-width children pinned to the main-axis end.
use tur_kit::{ Container, CrossAlign, MainAlign, Row, mount };

fn box_wh(w: f64, h: f64) -> View {
    let b = Container().width_height(w, h);
    return b.build();
}

entry fn start() {
    let row = Row()
        .main_alignment(MainAlign.End)
        .cross_alignment(CrossAlign.Start)
        .child(box_wh(50.0, 0.0))
        .child(box_wh(30.0, 0.0));
    mount(row.build());
}
