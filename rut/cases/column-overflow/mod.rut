// column-overflow: three 300px children in a Min column — total 900px
// overflows the 600px viewport. Children keep their natural height (not
// squished to 0).
use tur_kit::flags::{ MainAxisSize };
use tur_kit::handles::{ View, mount };
use tur_kit::layout::box::{ Container };
use tur_kit::layout::flex::{ Column };

fn box_h(h: f64) -> View {
    let b = Container().width_height(0.0, h);
    return b.build();
}

entry fn start() {
    let col = Column()
        .main_axis_size(MainAxisSize.Min)
        .child(box_h(300.0))
        .child(box_h(300.0))
        .child(box_h(300.0));
    mount(col.build());
}
