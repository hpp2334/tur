// jigsaw-puzzle: the full 3×3 drag-and-drop game (the Phase-9 rewrite of
// the Phase-4 fixture case, ported from the boa reference design).
//
//   * Nine colored pieces start in the tray below the board (id order),
//     each targeting a SHUFFLED slot on the 3×3 board — the piece's label
//     names its target ("3" → slot 3's ghost).
//   * Drag a piece onto its slot: drop within SNAP_T of the target and it
//     SNAPS + locks (dim fill, own-hue GLOW shadow, stops answering
//     grabs); the "N / 9 placed" derive badge counts it; at 9 / 9 the
//     centered "Solved!" overlay flips on over a full-viewer scrim (the
//     fill rides a Positioned four-edge child in the root stack — the
//     Condition lives INSIDE it so the stretch sizes against the stack).
//   * Game feel (the boa lift): grabbing a piece eases it up to LIFT_MAX
//     (1.1) over 180ms (one shared easeOut controller; the tick mutation
//     writes the dragged piece's bound scale source, the just-released
//     piece settles back) and every piece carries a STATE SHADOW through
//     the bound shadow rows: loose black soft → dragging hard → placed
//     hue glow. Shuffle re-shuffles the targets and re-deals the tray.
//
// Mechanics (the new idiom — no engine code, no stash):
//   * All per-piece state rides ARRAYS OF SOURCES bundled in one `Pieces`
//     struct (state.rut).
//   * Each piece is a `Positioned` whose left/top are BOUND anchors
//     (the reactive left / top anchors) — dragging writes the sources, the
//     Stack re-lays-out, the piece follows (pieces.rut).
//   * The lift controller's tick/end are mutations (`mutate<f64>` /
//     `mutate`) capturing the struct — no stash round-trip.
//   * Drag deltas are frame-formulated (x0 + (gx - g0x)) — absolute, no
//     read-modify-write drift, frame-independent of the stack's offset.
//   * Not `Each`: the 9 pieces mount ONCE (a rebuild per move event would
//     drop pointer capture mid-drag).
//
// The split: the boot + the lift controller + the play assembly (this
// file), the per-piece state bundle + the deal (state.rut), the drag
// state machine (pieces.rut), the chrome (ui.rut), the palette +
// geometry + slot math (theme.rut).
//
// Std-v14 multi-file laws this shape documents (see AGENTS.md): a root
// binds ONE pkg head (a second trips the carried-inst interner), record
// literals take a bare head (construct in the defining module), fn-values
// never cross a module boundary (the tick/end mutations are sealed HERE —
// start's scope, where their closures stay alive — and the u64 seal ids
// cross through pieces::install_ctrl), and written-through params take
// concrete `Source<T>` (the origin law).
mod pieces;
mod state;
mod theme;
mod ui;

use tur_kit::control_flow::control::{ Condition };
use tur_kit::flags::{ Align, StackFit };
use tur_kit::handles::{ View, mount };
use tur_kit::layout::box::{ Container, SizedBox };
use tur_kit::layout::stack::{ Positioned, Stack };
use tur_kit::reactive::{ Mutation, MutationCtx, Source, mutate, source, sv };

entry fn start() -> u64 {
    let p = state::mint();
    let count: Source<f64> = source<f64>(0.0);
    let solved: Source<bool> = source<bool>(false);
    let seed: Source<f64> = source<f64>(20261006.0); // the LCG state

    // The shared lift controller (the boa dragScale$): one 180ms easeOut
    // ease; the tick mutation routes the eased value into the dragged /
    // just-released piece's bound scale source, the end parks a released
    // piece at rest. The MUTATIONS are minted HERE (start's scope — the
    // closures must outlive their defining call) and sealed with the
    // kit's mirror tags (SEAL_F64 = 2, SEAL_NIL = 0); the u64 ids cross
    // through pieces::install_ctrl (the root cannot bind tur_anim_kit
    // heads at the std-v14 pin).
    let a_lift_tick: Mutation<f64> = mutate<f64>(fn (ctx: MutationCtx, v: f64) {
        let scale: f64 = 1.0 + v * (theme::LIFT_MAX - 1.0);
        let d = ctx.get<f64>(p.drag);
        let l = ctx.get<f64>(p.last);
        if (d >= 0.0) {
            ctx.set<f64>(p.sx[d as i32], scale);
        }
        if (l >= 0.0 && l != d) {
            ctx.set<f64>(p.sx[l as i32], scale);
        }
    });
    let a_lift_end: Mutation<nil> = mutate(fn (ctx: MutationCtx, _e: nil) {
        // The controller end parks the scale EXACTLY at rest — but only
        // for a piece that is no longer held (the reverse's completion).
        // Boa's dragScale$ stays at LIFT_MAX for the whole grab: the
        // forward ease completing mid-drag must not drop the piece back
        // while the pointer is still down (the release settles it).
        if (ctx.get<f64>(p.drag) < 0.0) {
            let l = ctx.get<f64>(p.last);
            if (l >= 0.0) {
                ctx.set<f64>(p.sx[l as i32], 1.0);
            }
        }
    });
    let tick = a_lift_tick.seal(2);
    let end = a_lift_end.seal(0);
    let lift = pieces::install_ctrl(tick, end);

    // The initial deal (the ctx face at boot — the channels seed before
    // the first flush) and the Shuffle tap's mutation.
    state::deal(state::boot_ctx(), p, count, solved, seed);
    let b_shuffle = mutate(fn (ctx: MutationCtx, _e: nil) {
        state::deal(ctx, p, count, solved, seed);
    });

    // ---- the play area (board + ghosts + tray + pieces + bar) ----

    let play = Stack()
        .alignment(Align::TopLeft)
        .child(SizedBox(theme::PLAY_W, theme::PLAY_H).build())
        .child(ui::board_bg())
        .children([ui::ghost(0), ui::ghost(1), ui::ghost(2), ui::ghost(3), ui::ghost(4), ui::ghost(5), ui::ghost(6), ui::ghost(7), ui::ghost(8)])
        .child(ui::tray_bg())
        .children([pieces::piece(0, p, count, solved, lift), pieces::piece(1, p, count, solved, lift), pieces::piece(2, p, count, solved, lift), pieces::piece(3, p, count, solved, lift), pieces::piece(4, p, count, solved, lift), pieces::piece(5, p, count, solved, lift), pieces::piece(6, p, count, solved, lift), pieces::piece(7, p, count, solved, lift), pieces::piece(8, p, count, solved, lift)])
        .child(ui::top_bar(b_shuffle, count))
        .build();

    // The win overlay: the four-edge Positioned is a DIRECT stack child so
    // the stretch sizes against the stack; the Condition lives inside it
    // (the audit caught the Condition-wrapped Positioned collapsing to the
    // banner's natural size at the top-left).
    let win = Positioned()
        .left(sv(0.0f64))
        .top(sv(0.0f64))
        .right(0.0)
        .bottom(0.0)
        .child(
            Condition(solved)
                .then_build(fn () -> View { return ui::win_banner(); })
                .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })
                .build(),
        )
        .build();

    // ---- the root (full-bleed dark, the play area centered, the overlay) ----

    mount(
        Stack()
            .fit(StackFit::Expand)
            .child(Container().color(sv(0x020617FFu64)).build())
            .child(Container().alignment(Align::Center).child(play).build())
            .child(win)
            .build(),
    );
    return count.atom_id();
}
