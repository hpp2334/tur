// expanded-flex-weights: two Expanded children sharing the main axis 2:1.
use tur_kit::{ Column, Container, CrossAlign, Expanded, mount };

fn box_wh(w: f64, h: f64) -> View {
    let b = Container().width_height(w, h);
    return b.build();
}

entry fn start() {
    let col = Column()
        .cross_alignment(CrossAlign.Start)
        .child(Expanded().flex(2.0).child(box_wh(0.0, 0.0)).build())
        .child(Expanded().flex(1.0).child(box_wh(0.0, 0.0)).build());
    mount(col.build());
}
