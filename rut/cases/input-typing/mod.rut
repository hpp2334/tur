// input-typing: an editable Input wired to a realm-minted controller.
use tur_kit::handles::{ mount, text_ctrl, undo_ctrl };
use tur_kit::layout::box::{ Container };
use tur_kit::text::input::{ Input };

entry fn start() {
    let ctrl = text_ctrl();
    let undo = undo_ctrl();
    let outer = Container()
        .child(Input().controller(ctrl).undo(undo).width_height(200.0, 30.0).build());
    mount(outer.build());
}
