
use tur_kit::{ Spans, Text, mount };

entry fn start() {
    let mut t = Text().text("").font_size(14.0);
    let spans = Spans()
        .add("Hello ", 0.0, 0, 0.0, SpanFlags.None)
        .add("Bold", 0.0, 0, 700.0, SpanFlags.None)
        .add(" World", 0.0, 0, 0.0, SpanFlags.None);
    t.spans(spans);
    mount(t.build());
}
