// tur_font_kit — the lazy-font kit prelude (the authored face over the font
// rows). Owned by the plugin that owns the rows (the layering law applied to
// the kit); embedded by tur-engine/src/builtin_plugins/font/kit.rs and
// registered as a compile-session prelude only when the Fonts capability is
// present (TurFontPlugin feature-detects it — the TurNetPlugin pattern).
{
  "name": "tur_font_kit",
  "deps": {
    "tur_host": { "path": "../tur_host" }
  }
}
