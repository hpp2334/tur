// tur_font_kit (mod.rut) — the lazy-font kit prelude (the authored face over
// the font rows). Owned by the plugin that owns the rows (the layering law
// applied to the kit): `TurFontPlugin` registers it as a compile-session
// prelude next to the rows, so plugin sets without the Fonts capability
// never see (or compile) this module.
//
// The lazy journey is PLAIN RUT async — `await load_font_data(family)` rides
// the futures prelude. Declares are cheap and idempotent (the rail dedups by
// face identity); text renders on the resolver stack's fallback until the
// load lands, then the epoch-keyed layout memos re-shape (the swap).

use tur_host::font::{ font_declare, font_declare_face, font_load_data };

// Declare a family's default face — pure metadata, no IO, no location (the
// host's provider owns where the bytes come from).
pub fn declare_font(family: str) {
  font_declare(family);
}

// Declare a SPECIFIC static face of the family (the overridden_weight /
// overridden_style selectors the provider catalogs by). Multi-face families
// declare once per face.
pub fn declare_font_face(family: str, weight: f64, italic: bool) {
  font_declare_face(family, weight, italic);
}

// Materialize a declared family: fetch each pending face's bytes through
// the host provider and register them (shared — every instance sees them).
// Resolves `true` when the family shapes under its declared name after this
// call; `false` when the family was never declared or a fetch failed.
// Text under the family renders on the resolver stack's fallback until this
// lands — launch it (not await it) for the fallback-then-swap UX.
pub async fn load_font_data(family: str) -> bool {
  return await font_load_data(family);
}
