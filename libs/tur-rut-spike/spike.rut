// The spike's brain: exercises the four gates the migration plan cares
// about — typed sync crossings, an async host fn driven to idle, a trap
// surfacing at the embedder's call site, and fuel parking + resuming.
use core::{ RunContext };
use async_host::launch_future;
use spike::{ add, greet, record, slow_echo };

fn double_sum(a: i32, b: i32) -> i32 {
    return add(a, b) * 2;
}

entry fn run(a: i32, b: i32) -> str {
    return greet(f"sum={double_sum(a, b)}");
}

entry fn boom() {
    panic("boom!");
}

entry fn spin(n: i32) -> i32 {
    let mut s = 0;
    for (let i = 0; i < n; i += 1) {
        s += i;
    }
    return s;
}

async fn echo_async(cx: RunContext, msg: str, ms: u32) -> str {
    let out = await slow_echo(ms, msg);
    record(out);
    return out;
}

entry fn boot(msg: str, ms: u32) {
    launch_future(echo_async(msg, ms));
}
