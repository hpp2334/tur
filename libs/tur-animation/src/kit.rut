// tur_anim_kit.rut — the animation family's kit wrappers (the authored
// surface over the `tur` host pkg's animation rows: `el_opacity` /
// `el_opacity_bound` / `el_transform` / the bound transform twins). Owned
// by the plugin that owns the rows (the layering law applied to the kit
// itself): tur-animation registers this prelude alongside its rows, so
// engine plugin sets without animation never see (or need) these classes.
//
// Construction law (as everywhere in the kit): build with the class call
// form — `Opacity(0.5)` / `Transform(scale, rotate, tx, ty)` — over each
// class's `[constructor] fn builder()` (the `.builder()` long form stays
// valid — byte-identical lowering), and CHAIN it:
// `let o = Opacity(0.5).child(kid);` — never `let mut o` + `o.child(..);`
// statement runs.
//
// Handler law (the mutation rail): the controller's tick / end are SEALED
// MUTATIONS — `mutate_f64(fn (ctx: MutationCtx, v: f64) { ... })` ticks
// (boa wraps onTick in mutate), `mutate(fn (ctx: MutationCtx) { ... })`
// ends. Nullable class params (the `kid: ?opaque` field pattern) let one
// kit fn serve every combo: the kit branches to the row's 0 = absent by
// null-check.
use tur::{ anim_ctrl_mut, el_opacity, el_opacity_bound, el_transform, el_transform_angle_bound, el_transform_scale_bound, el_transform_translate_bound };
use tur_kit::{ MutF64, MutNil, MutationCtx, Readable, mutate, mutate_f64 };

// The animation controller — the authored face over the `anim_ctrl_mut`
// row. The tick is `Handler<f64>` (`mutate_f64`; the eased progress
// crosses as the invocation payload) and the end is `Handler<nil>`;
// either may be nil (the controller then only drives its bound channels —
// polled through `anim_value`). The tick mutation CAPTURES the channels
// it drives — no id rail, no stash.
pub fn anim_ctrl(duration_ms: f64, curve: str, repeat: u64, on_tick: ?MutF64, on_end: ?MutNil) -> opaque {
  let mut tick: u64 = 0;
  if (on_tick != nil) {
    tick = on_tick.atom_id();
  }
  let mut end: u64 = 0;
  if (on_end != nil) {
    end = on_end.atom_id();
  }
  return anim_ctrl_mut(duration_ms, curve, repeat, tick, end);
}

// The tick-only twin — `anim_ctrl_tick(dur, curve, repeat, tick)`.
pub fn anim_ctrl_tick(duration_ms: f64, curve: str, repeat: u64, on_tick: MutF64) -> opaque {
  return anim_ctrl_mut(duration_ms, curve, repeat, on_tick.atom_id(), 0);
}

// The end-only twin — `anim_ctrl_end(dur, curve, repeat, end)`.
pub fn anim_ctrl_end(duration_ms: f64, curve: str, repeat: u64, on_end: MutNil) -> opaque {
  return anim_ctrl_mut(duration_ms, curve, repeat, 0, on_end.atom_id());
}

// The bare controller (no callbacks — polled through `anim_value`).
pub fn anim_ctrl_open(duration_ms: f64, curve: str, repeat: u64) -> opaque {
  return anim_ctrl_mut(duration_ms, curve, repeat, 0, 0);
}

class Opacity {
  value: f64;
  r: ?Readable<f64>;
  kid: ?opaque;
}

impl Opacity {
  [constructor] pub fn builder(value: f64) -> Self {
    return Self { value: value, r: nil, kid: nil };
  }
  // Bind the opacity to a live f64 (the onTick rail's consumer).
  pub fn bound(mut self, r: Readable<f64>) -> Self {
    self.r = r;
    return self;
  }
  pub fn child(mut self, c: opaque) -> Self {
    self.kid = c;
    return self;
  }
  pub fn build(self) -> opaque {
    if (self.r != nil) {
      return el_opacity_bound(self.r.atom_id(), self.kid);
    }
    return el_opacity(self.value, self.kid);
  }
}

class Transform {
  scale: f64;
  rotate: f64;
  tx: f64;
  ty: f64;
  // The bound channels (nil = static): each channel rides its own live
  // f64 — an orbit writes cx + r·cos / cy + r·sin independently, an
  // eased scale binds alone (the rows are Val-backed per channel).
  scale_r: ?Readable<f64>;
  rotate_r: ?Readable<f64>;
  tx_r: ?Readable<f64>;
  ty_r: ?Readable<f64>;
  kid: ?opaque;
}

impl Transform {
  [constructor] pub fn builder(scale: f64, rotate: f64, tx: f64, ty: f64) -> Self {
    return Self { scale: scale, rotate: rotate, tx: tx, ty: ty, scale_r: nil, rotate_r: nil, tx_r: nil, ty_r: nil, kid: nil };
  }
  // Bind the rotation channel to a live f64 (radians — the onTick rail's
  // consumer): the angle re-resolves through the subscribe → relayout
  // rail and the subtree NEVER re-mounts (no rebuild channel). The rows
  // are ONE bound channel per element — the last bind clears the others
  // (never a silent combo).
  pub fn rotate_bound(mut self, r: Readable<f64>) -> Self {
    self.rotate_r = r;
    self.scale_r = nil;
    self.tx_r = nil;
    self.ty_r = nil;
    return self;
  }
  // The uniform scale rides a live f64 (last bind wins).
  pub fn scale_bound(mut self, r: Readable<f64>) -> Self {
    self.scale_r = r;
    self.rotate_r = nil;
    self.tx_r = nil;
    self.ty_r = nil;
    return self;
  }
  // The translate twins: each offset rides its own live f64 (last bind
  // wins — the translate row is the one multi-channel shape).
  pub fn translate_bound(mut self, tx: Readable<f64>, ty: Readable<f64>) -> Self {
    self.tx_r = tx;
    self.ty_r = ty;
    self.scale_r = nil;
    self.rotate_r = nil;
    return self;
  }
  pub fn child(mut self, c: opaque) -> Self {
    self.kid = c;
    return self;
  }
  pub fn build(self) -> opaque {
    if (self.rotate_r != nil) {
      return el_transform_angle_bound(self.scale, self.rotate_r.atom_id(), self.tx, self.ty, self.kid);
    }
    if (self.scale_r != nil) {
      return el_transform_scale_bound(self.scale_r.atom_id(), self.rotate, self.tx, self.ty, self.kid);
    }
    if (self.tx_r != nil || self.ty_r != nil) {
      let mut tx_atom: u64 = 0;
      if (self.tx_r != nil) {
        tx_atom = self.tx_r.atom_id();
      }
      let mut ty_atom: u64 = 0;
      if (self.ty_r != nil) {
        ty_atom = self.ty_r.atom_id();
      }
      return el_transform_translate_bound(self.scale, self.rotate, tx_atom, ty_atom, self.kid);
    }
    return el_transform(self.scale, self.rotate, self.tx, self.ty, self.kid);
  }
}
