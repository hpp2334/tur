// tur_anim_kit.rut — the animation family's kit wrappers (the authored
// surface over the `tur` host pkg's animation rows: `el_opacity` /
// `el_opacity_bound` / `el_transform`). Owned by the plugin that owns the
// rows (the layering law applied to the kit itself): tur-animation
// registers this prelude alongside its rows, so engine plugin sets without
// animation never see (or need) these classes.
//
// Construction law (as everywhere in the kit): build with the class call
// form — `Opacity(0.5)` / `Transform(scale, rotate, tx, ty)` — over each
// class's `[constructor] fn builder()` (the `.builder()` long form stays
// valid — byte-identical lowering), and CHAIN it:
// `let o = Opacity(0.5).child(kid);` — never `let mut o` + `o.child(..);`
// statement runs.
use tur::{ anim_ctrl_cb, anim_ctrl_cb_e, anim_ctrl_cb_t, anim_ctrl_cb_te, el_opacity, el_opacity_bound, el_transform };

// The animation kit's dispatch entry (the scope law: this kit seals the
// tick/end fn values, so THIS module owns the entry that downcasts them —
// the box stamps this unit's `fn(u64, f64)` id).
entry fn __tur_acb_val(cb: opaque, a: u64, v: f64) {
  let f = opaque.downcast<fn(u64, f64)>(cb);
  f(a, v);
}

// The animation controller — the authored face over the `anim_ctrl_cb*`
// rows (`?opaque` has no param lane — rows are typed — and rut does not
// coerce fn → ?fn at call sites, so each callback combo is its own
// authored fn). The callbacks are fn VALUES (`fn(atom: u64, t: f64)`);
// the kit seals them into opaque boxes rut-side, and the engine's drain
// fires them through the `__tur_cb_val` dispatch entry.
pub fn anim_ctrl(atom: u64, duration_ms: f64, curve: str, repeat: u64, on_tick: fn(u64, f64), on_end: fn(u64, f64)) -> opaque {
  return anim_ctrl_cb_te(atom, duration_ms, curve, repeat, opaque(on_tick), opaque(on_end));
}

// Tick-only twin.
pub fn anim_ctrl_tick(atom: u64, duration_ms: f64, curve: str, repeat: u64, on_tick: fn(u64, f64)) -> opaque {
  return anim_ctrl_cb_t(atom, duration_ms, curve, repeat, opaque(on_tick));
}

// End-only twin.
pub fn anim_ctrl_end(atom: u64, duration_ms: f64, curve: str, repeat: u64, on_end: fn(u64, f64)) -> opaque {
  return anim_ctrl_cb_e(atom, duration_ms, curve, repeat, opaque(on_end));
}

// The bare controller (no callbacks — polled through `anim_value`).
pub fn anim_ctrl_open(atom: u64, duration_ms: f64, curve: str, repeat: u64) -> opaque {
  return anim_ctrl_cb(atom, duration_ms, curve, repeat);
}

class Opacity {
  value: f64;
  atom: u64;
  kid: ?opaque;
}

impl Opacity {
  [constructor] pub fn builder(value: f64) -> Self {
    return Self { value: value, atom: 0, kid: nil };
  }
  // Bind the opacity to an f64 atom (the onTick rail's consumer).
  pub fn bound(mut self, atom: u64) -> Self {
    self.atom = atom;
    return self;
  }
  pub fn child(mut self, c: opaque) -> Self {
    self.kid = c;
    return self;
  }
  pub fn build(self) -> opaque {
    if (self.atom != 0) {
      return el_opacity_bound(self.atom, self.kid);
    }
    return el_opacity(self.value, self.kid);
  }
}

class Transform {
  scale: f64;
  rotate: f64;
  tx: f64;
  ty: f64;
  kid: ?opaque;
}

impl Transform {
  [constructor] pub fn builder(scale: f64, rotate: f64, tx: f64, ty: f64) -> Self {
    return Self { scale: scale, rotate: rotate, tx: tx, ty: ty, kid: nil };
  }
  pub fn child(mut self, c: opaque) -> Self {
    self.kid = c;
    return self;
  }
  pub fn build(self) -> opaque {
    return el_transform(self.scale, self.rotate, self.tx, self.ty, self.kid);
  }
}
