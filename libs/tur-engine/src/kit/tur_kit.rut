// ---- shared helpers ----------------------------------------------------------------

// Mint a LayerLink (the JS `createLayerLink` twin) for the composited
// target/follower pair.
pub fn layer_link() -> opaque {
  return ct_link_new();
}

// Register an encoded image resource (PNG/JPEG) — the `createImageResource`
// twin.
pub fn image_resource_bytes(bytes: bytes) -> u64 {
  return img_res_bytes(bytes);
}

// A synthetic solid RGBA image resource (fixture-friendly).
pub fn image_resource_solid(w: u64, h: u64, packed: u64) -> u64 {
  return img_res_solid(w, h, packed);
}

// Register a string-authored child module source with the virtual-app
// subsystem — the `createModuleSource` twin.
pub fn virtual_app_source(src: str) -> opaque {
  return va_create_source(src);
}

// Lift a Rust-registered source id (e.g. the u64 the `pg_compile` row
// answers) into the source handle — Rust-defined sources enter the realm
// as plain u64s.
pub fn virtual_app_source_handle(id: u64) -> opaque {
  return va_source_handle(id);
}

// Mint an EMPTY (Nil) controller-ref atom for the reactive `app$` binding
// (`VirtualApp.bind(atom)` + `va_app_set` / `va_app_clear` swaps).
pub fn virtual_app_atom() -> u64 {
  return va_app_atom();
}

// Mint a virtual-app controller from a registered source — the
// `createVirtualAppController` twin.
pub fn virtual_app_controller(src: opaque) -> opaque {
  return va_controller(src);
}
