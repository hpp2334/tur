    return self;
  }
  pub fn multiline(mut self, v: bool) -> Self {
    input_multiline(self.spec, v);
    return self;
  }
  pub fn font_family(mut self, v: str) -> Self {
    input_font_family(self.spec, v);
    return self;
  }
  // The on-input rail: every user edit delivers `cb` — a fn value with
  // the click shape — `(id, 0, seq)`; the handler reads the fresh text
  // via `tctrl_text`. Bind `.controller(...)` first — the row installs
  // through the builder's shared controller.
  pub fn on_input(mut self, cb: fn(u64, u64, f64), id: u64) -> Self {
    input_on_input(self.spec, opaque(cb), id);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    input_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> View {
    return input_build(self.spec);
  }
}

// ---- gesture family (PointerInteract / MouseRegion / Focusable) -------------

class PointerInteract {
  spec: opaque;
}

impl PointerInteract {
  [constructor] pub fn builder() -> Self {
    return Self { spec: pi_new() };
  }
  // The single-id rail: pointer callbacks deliver `(id, lx, ly, gx, gy, btn)`.
  pub fn id(mut self, v: u64) -> Self {
    pi_id(self.spec, v);
    return self;
  }
  // The two-id rail: pointer callbacks deliver `(a, b, lx, ly, gx, gy, btn)`;
  // taps deliver the `(a, b, seq)` click shape either way.
  pub fn ids(mut self, a: u64, b: u64) -> Self {
    pi_ids(self.spec, a, b);
    return self;
  }
  pub fn on_tap(mut self, cb: fn(u64, u64, f64)) -> Self {
    pi_on_tap(self.spec, opaque(cb));
    return self;
  }
  pub fn on_click(mut self, cb: fn(u64, f64, f64, f64, f64, u64)) -> Self {
    pi_on_click(self.spec, opaque(cb));
    return self;
  }
  pub fn on_down(mut self, cb: fn(u64, f64, f64, f64, f64, u64)) -> Self {
    pi_on_down(self.spec, opaque(cb));
    return self;
  }
  pub fn on_move(mut self, cb: fn(u64, f64, f64, f64, f64, u64)) -> Self {
    pi_on_move(self.spec, opaque(cb));
    return self;
  }
  pub fn on_up(mut self, cb: fn(u64, f64, f64, f64, f64, u64)) -> Self {
    pi_on_up(self.spec, opaque(cb));
    return self;
  }
  pub fn on_context_menu(mut self, cb: fn(u64, f64, f64, f64, f64, u64)) -> Self {
    pi_on_context_menu(self.spec, opaque(cb));
    return self;
  }
  // The two-id twins: over `.ids(a, b)` the pointer callbacks deliver
  // `(a, b, lx, ly, gx, gy, btn)` (taps stay the `(a, b, seq)` click
  // shape either way — use `on_tap` for that).
  pub fn on_click2(mut self, cb: fn(u64, u64, f64, f64, f64, f64, u64)) -> Self {
    pi_on_click(self.spec, opaque(cb));
    return self;
  }
  pub fn on_down2(mut self, cb: fn(u64, u64, f64, f64, f64, f64, u64)) -> Self {
    pi_on_down(self.spec, opaque(cb));
    return self;
  }
  pub fn on_move2(mut self, cb: fn(u64, u64, f64, f64, f64, f64, u64)) -> Self {
    pi_on_move(self.spec, opaque(cb));
    return self;
  }
  pub fn on_up2(mut self, cb: fn(u64, u64, f64, f64, f64, f64, u64)) -> Self {
    pi_on_up(self.spec, opaque(cb));
    return self;
  }
  pub fn on_context_menu2(mut self, cb: fn(u64, u64, f64, f64, f64, f64, u64)) -> Self {
    pi_on_context_menu(self.spec, opaque(cb));
    return self;
  }
  pub fn behavior(mut self, v: u64) -> Self {
    pi_behavior(self.spec, v);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    pi_qkey(self.spec, k);
    return self;
  }
  pub fn child(mut self, c: View) -> Self {
    pi_child(self.spec, c);
    return self;
  }
  pub fn build(self) -> View {
    return pi_build(self.spec);
  }
}

