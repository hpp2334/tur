// ---- gesture family (PointerInteract / MouseRegion / Focusable) -------------

class PointerInteract {
  spec: opaque;
}

impl PointerInteract {
  pub fn builder() -> Self {
    return Self { spec: pi_new() };
  }
  // The single-id rail: pointer callbacks deliver `(id, lx, ly, gx, gy, btn)`.
  pub fn id(mut self, v: u64) -> Self {
    pi_id(self.spec, v);
    return self;
  }
  // The two-id rail: pointer callbacks deliver `(a, b, lx, ly, gx, gy, btn)`;
  // taps deliver the `(a, b, seq)` click shape either way.
  pub fn ids(mut self, a: u64, b: u64) -> Self {
    pi_ids(self.spec, a, b);
    return self;
  }
  pub fn on_tap(mut self, name: str) -> Self {
    pi_on_tap(self.spec, name);
    return self;
  }
  pub fn on_click(mut self, name: str) -> Self {
    pi_on_click(self.spec, name);
    return self;
  }
  pub fn on_down(mut self, name: str) -> Self {
    pi_on_down(self.spec, name);
    return self;
  }
  pub fn on_move(mut self, name: str) -> Self {
    pi_on_move(self.spec, name);
    return self;
  }
  pub fn on_up(mut self, name: str) -> Self {
    pi_on_up(self.spec, name);
    return self;
  }
  pub fn on_context_menu(mut self, name: str) -> Self {
    pi_on_context_menu(self.spec, name);
    return self;
  }
  pub fn behavior(mut self, v: u64) -> Self {
    pi_behavior(self.spec, v);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    pi_qkey(self.spec, k);
    return self;
  }
  pub fn child(mut self, c: opaque) -> Self {
    pi_child(self.spec, c);
    return self;
  }
  pub fn build(self) -> opaque {
    return pi_build(self.spec);
  }
}

