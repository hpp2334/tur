// ---- control flow (Switch / Condition / Each / Fragment) ---------------------

class Switch {
  spec: opaque;
}

impl Switch {
  [constructor] pub fn builder() -> Self {
    return Self { spec: switch_new() };
  }
  pub fn value_source(mut self, atom: u64) -> Self {
    switch_value_source(self.spec, atom);
    return self;
  }
  pub fn value_derived(mut self, atom: u64) -> Self {
    switch_value_derived(self.spec, atom);
    return self;
  }
  // Appends one case — the historical `cases` prop's crossing (`case` is
  // a reserved word in rut).
  pub fn cases(mut self, key: str, branch: View) -> Self {
    switch_case(self.spec, key, branch);
    return self;
  }
  // The lazy case twin: the branch is a FN VALUE, invoked when the key
  // activates (fresh read of live state).
  pub fn case_build(mut self, key: str, cb: fn() -> View) -> Self {
    switch_case_build(self.spec, key, opaque(cb));
    return self;
  }
  pub fn fallback(mut self, branch: View) -> Self {
    switch_fallback(self.spec, branch);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    switch_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> View {
    return switch_build(self.spec);
  }
}

class Condition {
  spec: opaque;
}

impl Condition {
  [constructor] pub fn builder(atom: u64) -> Self {
    return Self { spec: cond_new(atom) };
  }
  pub fn then(mut self, branch: View) -> Self {
    cond_then(self.spec, branch);
    return self;
  }
  pub fn else_branch(mut self, branch: View) -> Self {
    cond_else(self.spec, branch);
    return self;
  }
  // The lazy twins: the branch is a FN VALUE (`fn() -> View`), invoked
  // at activation and re-invoked at every re-activation — the built
  // subtree reads LIVE state each time it mounts (the boa callback
  // semantic; e.g. a modal reads the draft at open time).
  pub fn then_build(mut self, cb: fn() -> View) -> Self {
    cond_then_build(self.spec, opaque(cb));
    return self;
  }
  pub fn else_build(mut self, cb: fn() -> View) -> Self {
    cond_else_build(self.spec, opaque(cb));
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    cond_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> View {
    return cond_build(self.spec);
  }
}

class Each {
  spec: opaque;
}

impl Each {
  [constructor] pub fn builder(atom: u64) -> Self {
    return Self { spec: each_new(atom) };
  }
  pub fn item_builder(mut self, cb: fn(u64, str) -> View) -> Self {
    each_builder(self.spec, opaque(cb));
    return self;
  }
  pub fn build(self) -> View {
    return each_build(self.spec);
  }
}

class Fragment {
  spec: opaque;
}

impl Fragment {
  [constructor] pub fn builder() -> Self {
    return Self { spec: frag_new() };
  }
  pub fn child(mut self, c: View) -> Self {
