class Flexible {
  spec: opaque;
}

impl Flexible {
  pub fn builder() -> Self {
    let s = flexi_new();
    flexi_fit(s, 1); // FIT_LOOSE — the child shrink-wraps below its slot
    return Self { spec: s };
  }
  pub fn flex(mut self, v: f64) -> Self {
    flexi_flex(self.spec, v);
    return self;
  }
  pub fn flex_bound(mut self, atom: u64) -> Self {
    flexi_flex_bound(self.spec, atom);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    flexi_qkey(self.spec, k);
    return self;
  }
  pub fn child(mut self, c: opaque) -> Self {
    flexi_child(self.spec, c);
    return self;
  }
  pub fn build(self) -> opaque {
    return flexi_build(self.spec);
  }
}

