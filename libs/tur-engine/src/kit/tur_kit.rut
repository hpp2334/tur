    table_header_builder(self.spec, opaque(cb));
    return self;
  }
  // Declarative row stripes painted by the element itself (never the
  // cells): `even` fills even body rows, `odd` fills odd ones. Pass
  // 0x00000000 for "keep the frame showing through" on a parity.
  pub fn stripes(mut self, even: u64, odd: u64) -> Self {
    table_stripe(self.spec, even, odd);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    table_qkey(self.spec, k);
    return self;
  }
