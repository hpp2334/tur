    return self;
  }
  pub fn main_axis_size(mut self, v: u64) -> Self {
    flex_main_size(self.spec, v);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    flex_qkey(self.spec, k);
    return self;
  }
  pub fn child(mut self, c: View) -> Self {
    flex_child(self.spec, c);
    return self;
  }
  pub fn children(mut self, cs: [View]) -> Self {
    for (let c of cs) {
      flex_child(self.spec, c);
    }
    return self;
  }
  pub fn build(self) -> View {
    return flex_build(self.spec);
  }
}

