// ---- composited target / follower ------------------------------------------------

class CompositedTarget {
  spec: opaque;
}

impl CompositedTarget {
  pub fn builder() -> Self {
    return Self { spec: ct_target_new() };
  }
  pub fn link(mut self, l: opaque) -> Self {
    ct_target_link(self.spec, l);
    return self;
  }
  pub fn child(mut self, c: opaque) -> Self {
    ct_target_child(self.spec, c);
    return self;
  }
  pub fn build(self) -> opaque {
    return ct_target_build(self.spec);
  }
}

class CompositedFollower {
  spec: opaque;
}

impl CompositedFollower {
  pub fn builder() -> Self {
    return Self { spec: ct_follower_new() };
  }
  pub fn link(mut self, l: opaque) -> Self {
    ct_follower_link(self.spec, l);
    return self;
  }
  pub fn target_anchor(mut self, v: u64) -> Self {
    ct_follower_target_anchor(self.spec, v);
    return self;
  }
  pub fn target_anchor_bound(mut self, atom: u64) -> Self {
    ct_follower_target_anchor_bound(self.spec, atom);
    return self;
  }
  pub fn follower_anchor(mut self, v: u64) -> Self {
    ct_follower_follower_anchor(self.spec, v);
    return self;
  }
  pub fn offset(mut self, x: f64, y: f64) -> Self {
    ct_follower_offset(self.spec, x, y);
    return self;
  }
  pub fn child(mut self, c: opaque) -> Self {
    ct_follower_child(self.spec, c);
    return self;
  }
  pub fn build(self) -> opaque {
    return ct_follower_build(self.spec);
  }
}

// ---- shared helpers ----------------------------------------------------------------

// Mint a LayerLink (the JS `createLayerLink` twin) for the composited
// target/follower pair.
pub fn layer_link() -> opaque {
  return ct_link_new();
}

// Register an encoded image resource (PNG/JPEG) — the `createImageResource`
// twin.
pub fn image_resource_bytes(bytes: bytes) -> u64 {
  return img_res_bytes(bytes);
}

// A synthetic solid RGBA image resource (fixture-friendly).
pub fn image_resource_solid(w: u64, h: u64, packed: u64) -> u64 {
  return img_res_solid(w, h, packed);
}

// Register a child module source with the virtual-app subsystem — the
// `createModuleSource` twin.
pub fn virtual_app_source(src: str) -> opaque {
  return va_source(src);
}

// Mint a virtual-app controller from a registered source — the
// `createVirtualAppController` twin.
pub fn virtual_app_controller(src: opaque) -> opaque {
  return va_controller(src);
}
