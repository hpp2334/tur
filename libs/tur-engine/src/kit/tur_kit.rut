// ---- control flow (Switch / Condition / Each / Fragment) ---------------------

class Switch {
  spec: opaque;
}

impl Switch {
  pub fn builder() -> Self {
    return Self { spec: switch_new() };
  }
  pub fn value_source(mut self, atom: u64) -> Self {
    switch_value_source(self.spec, atom);
    return self;
  }
  pub fn value_derived(mut self, atom: u64) -> Self {
    switch_value_derived(self.spec, atom);
    return self;
  }
  // Appends one case — the historical `cases` prop's crossing (`case` is
  // a reserved word in rut).
  pub fn cases(mut self, key: str, branch: opaque) -> Self {
    switch_case(self.spec, key, branch);
    return self;
  }
  pub fn fallback(mut self, branch: opaque) -> Self {
    switch_fallback(self.spec, branch);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    switch_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> opaque {
    return switch_build(self.spec);
  }
}

class Condition {
  spec: opaque;
}

impl Condition {
  pub fn builder(atom: u64) -> Self {
    return Self { spec: cond_new(atom) };
  }
  pub fn then(mut self, branch: opaque) -> Self {
    cond_then(self.spec, branch);
    return self;
  }
  pub fn else_branch(mut self, branch: opaque) -> Self {
    cond_else(self.spec, branch);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    cond_qkey(self.spec, k);
    return self;
  }
  pub fn build(self) -> opaque {
    return cond_build(self.spec);
  }
}

class Each {
  spec: opaque;
}

impl Each {
  pub fn builder(atom: u64) -> Self {
    return Self { spec: each_new(atom) };
  }
  pub fn item_builder(mut self, name: str) -> Self {
    each_builder(self.spec, name);
    return self;
  }
  pub fn build(self) -> opaque {
    return each_build(self.spec);
  }
}

class Fragment {
  spec: opaque;
}

impl Fragment {
  pub fn builder() -> Self {
    return Self { spec: frag_new() };
  }
  pub fn child(mut self, c: opaque) -> Self {
    frag_child(self.spec, c);
    return self;
  }
  pub fn children(mut self, cs: [opaque]) -> Self {
    for (let c of cs) {
      frag_child(self.spec, c);
    }
    return self;
  }
  pub fn build(self) -> opaque {
    return frag_build(self.spec);
  }
}

