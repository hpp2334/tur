  // The extent-vocabulary twin of `fixed` (the grid `.main_extent` /
  // lazy `.item_extent` naming): appends a column whose extent (fixed
  // main-axis size) is w — it takes no flex share.
  pub fn extent(mut self, w: f64) -> Self {
    table_col_extent(self.spec, w);
