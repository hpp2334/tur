    return self;
  }
  pub fn cross_alignment(mut self, v: u64) -> Self {
    flex_cross_align(self.spec, v);
    return self;
  }
  pub fn main_axis_size(mut self, v: u64) -> Self {
    flex_main_size(self.spec, v);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    flex_qkey(self.spec, k);
    return self;
  }
  pub fn child(mut self, c: opaque) -> Self {
    flex_child(self.spec, c);
    return self;
  }
  pub fn children(mut self, cs: [opaque]) -> Self {
    for (let c of cs) {
      flex_child(self.spec, c);
    }
    return self;
  }
  pub fn build(self) -> opaque {
    return flex_build(self.spec);
  }
}

