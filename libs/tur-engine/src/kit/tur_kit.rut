}

impl Grid {
  pub fn builder() -> Self {
    return Self { spec: grid_new() };
  }
  pub fn max_cross(mut self, v: f64) -> Self {
    grid_max_cross(self.spec, v);
    return self;
  }
  pub fn aspect(mut self, v: f64) -> Self {
    grid_aspect(self.spec, v);
    return self;
  }
  pub fn spacing(mut self, cross: f64, main: f64) -> Self {
    grid_spacing(self.spec, cross, main);
    return self;
  }
  pub fn main_extent(mut self, v: f64) -> Self {
    grid_main_extent(self.spec, v);
    return self;
  }
  pub fn query_key(mut self, k: str) -> Self {
    grid_qkey(self.spec, k);
    return self;
  }
  pub fn child(mut self, c: opaque) -> Self {
    grid_child(self.spec, c);
    return self;
  }
  pub fn children(mut self, cs: [opaque]) -> Self {
    for (let c of cs) {
      grid_child(self.spec, c);
    }
    return self;
  }
  pub fn build(self) -> opaque {
    return grid_build(self.spec);
  }
}

