// tur_net_kit.rut — the net capability's kit prelude (the authored face
// over this plugin's `tur` host-pkg rows). Owned by the plugin that owns
// the rows (the layering law applied to the kit): registered as a
// compile-session prelude next to the rows, so plugin sets without the
// Http capability never see (or compile) this module.
//
// Callback law (as everywhere in the kit): `net_stream`'s chunk handler
// is a FN VALUE (`fn(id: u64, chunk: bytes)`); the kit seals it into an
// opaque box rut-side and hands the row only the box. The engine fires it
// through this kit's own dispatch entry — the scope law: the kit that
// seals the callback owns the entry that downcasts it.

use tur::{ net_stream_cb };

// The net kit's dispatch entry: `(id, chunk)` per streamed chunk.
entry fn __tur_ncb_bytes(cb: opaque, id: u64, data: bytes) {
  let f = opaque.downcast<fn(u64, bytes)>(cb);
  f(id, data);
}

// Stream a response body: `on_chunk` fires once per chunk (the returned
// task's `task_cancel` wire-aborts the download).
pub fn net_stream(id: u64, url: str, method: str, on_chunk: fn(u64, bytes)) -> opaque {
  return net_stream_cb(id, url, method, opaque(on_chunk));
}
