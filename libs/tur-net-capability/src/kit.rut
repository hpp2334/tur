// tur_net_kit.rut — the net capability's kit prelude (the authored face
// over this plugin's `tur` host-pkg rows). Owned by the plugin that owns
// the rows (the layering law applied to the kit): registered as a
// compile-session prelude next to the rows, so plugin sets without the
// Http capability never see (or compile) this module.
//
// Handler law (the mutation rail): `net_stream`'s chunk handler is a
// SEALED MUTATION — `mutate_bytes(fn (ctx: MutationCtx, chunk: bytes) {
// ... })`; each chunk enqueues the invocation and the flush's mutation
// pass delivers it with the task-scoped ctx.

use tur::{ net_stream_mut };
use tur_kit::{ Mutation, mutate_bytes };

// Stream a response body: the chunk mutation fires once per chunk (the
// returned task's `task_cancel` wire-aborts the download).
pub fn net_stream(url: str, method: str, on_chunk: Mutation<bytes, nil>) -> opaque {
  return net_stream_mut(url, method, on_chunk.atom);
}
