// table-basic: shared column geometry with a header row, stripes and
// dividers (the Table widget's corpus twin, authored from flex rows).
use tur::{ mount };
use tur_kit::{ Column, Container, Row, SizedBox, Text };


fn header_cell(label: str, w: f64) -> opaque {
    let b = Container().width_height(w, 0.0).padding(8.0).child(Text().text(label).font_size(12.0).build());
    return b.build();
}

fn cell(label: str, w: f64) -> opaque {
    let b = Container().width_height(w, 0.0).padding(8.0).child(Text().text(label).font_size(14.0).build());
    return b.build();
}

fn header() -> opaque {
    let r = Row()
        .child(header_cell("PLANET", 150.0))
        .child(header_cell("NOTES", 100.0))
        .child(header_cell("DISTANCE", 100.0));
    return r.build();
}

fn planet(name: str, notes: str, distance: str) -> opaque {
    let r = Row().child(cell(name, 150.0)).child(cell(notes, 100.0)).child(cell(distance, 100.0));
    let wrapped = Container().width_height(0.0, 36.0).child(r.build());
    return wrapped.build();
}

entry fn start() {
    let table = Column()
        .child(header())
        .child(planet("Mercury", "Smallest planet", "0.39 AU"))
        .child(planet("Venus", "Hottest surface", "0.72 AU"))
        .child(planet("Earth", "Home of life", "1.00 AU"))
        .child(planet("Mars", "The red planet", "1.52 AU"));
    let frame = Container().color(0x0B1220FF).child(table.build());
    mount(SizedBox(400.0, 240.0).child(frame.build()).build());
}
