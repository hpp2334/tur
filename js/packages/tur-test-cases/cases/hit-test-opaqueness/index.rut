// hit-test-opaqueness: the absorption matrix — a colored Container
// absorbs; a decoration-less Container passes through; an opaque
// PointerInteract catches invisible hits; a translucent MouseRegion joins
// the path without blocking. The beneath-target's down count renders into
// the `beneath-downs` Text (the test parses it).
use tur::{ ALIGN_TOP_LEFT, CURSOR_AUTO, mount };
use tur_kit::{ Container, MouseRegion, MutationCtx, PointerEvent, PointerInteract, Positioned,
    Readable, SizedBox, Stack, Text, mutate_ev, source_f64, source_str };


entry fn start() -> u64 {
    let downs: Readable<str> = source_str("0");
    let count: Readable<f64> = source_f64(0.0);

    // The down count rides its own source (the mutation captures both
    // handles — no id rail, no stash).
    let g_down = mutate_ev(fn (ctx: MutationCtx, _ev: PointerEvent) {
        ctx.set_f64(count, ctx.get_f64(count) + 1.0);
        ctx.set_str(downs, f"{ctx.get_f64(count) as u64}");
    });

    let mut stack = Stack().alignment(ALIGN_TOP_LEFT);

    // The opaque gesture target beneath (fills the 400x600 stack).
    let target = Container()
        .width_height(400.0, 600.0)
        .child(Text().text_bound(downs).query_key("beneath-downs").build());
    stack.child(PointerInteract().on_pointer_down(g_down).query_key("rut/gesture").child(target.build()).build());

    // A decoration-less full-size Container — transparent.
    let plain = Container().width_height(400.0, 600.0).query_key("plain");
    stack.child(plain.build());

    // A painted red 200x200 surface at the top-left — absorbs.
    let red = Container().width_height(200.0, 200.0).color(0xEF4444FFu64).query_key("red");
    stack.child(red.build());

    // A translucent MouseRegion over the right half (x 200..400).
    let region_child = SizedBox(200.0, 600.0).child(Container().build()).query_key("region").build();
    let region = MouseRegion().cursor(CURSOR_AUTO).behavior(1).child(region_child).build();
    stack.child(Positioned().left(200.0).width(200.0).height(600.0).child(region).build());

    mount(stack.build());
    return downs.atom_id();
}
