// hit-test-opaqueness: the absorption matrix — a colored Container
// absorbs; a decoration-less Container passes through; an opaque
// PointerInteract catches invisible hits; a translucent MouseRegion joins
// the path without blocking. The beneath-target's down count renders into
// the `beneath-downs` Text (the test parses it).
use tur::{ ALIGN_TOP_LEFT, CURSOR_AUTO, mem_get, mem_new, mem_set, mount, rs_set_str, rs_source_str,
    st_put, st_take };
use tur_kit::{ Container, MouseRegion, PointerInteract, Positioned, SizedBox, Stack, Text };


let K_COUNT: u64 = 7;

entry fn start() -> u64 {
    let downs = rs_source_str("0");
    st_put(K_COUNT, mem_new(0.0));

    let mut stack = Stack.new();
    stack.alignment(ALIGN_TOP_LEFT);

    // The opaque gesture target beneath (fills the 400x600 stack).
    let mut target = Container.new();
    target.width_height(400.0, 600.0);
    let mut downs_t = Text.new();

    downs_t.text_bound(downs);
    downs_t.query_key("beneath-downs");
    target.child(downs_t.build());
    stack.child(PointerInteract.new().id(downs).on_down("g_down").query_key("rut/gesture").child(target.build()).build());

    // A decoration-less full-size Container — transparent.
    let mut plain = Container.new();
    plain.width_height(400.0, 600.0);
    plain.query_key("plain");
    stack.child(plain.build());

    // A painted red 200x200 surface at the top-left — absorbs.
    let mut red = Container.new();
    red.width_height(200.0, 200.0);
    red.color(0xEF4444FFu64);
    red.query_key("red");
    stack.child(red.build());

    // A translucent MouseRegion over the right half (x 200..400).
    let region_child = SizedBox.new(200.0, 600.0).child(Container.new().build()).query_key("region").build();
    let region = MouseRegion.new().cursor(CURSOR_AUTO).behavior(1).child(region_child).build();
    stack.child(Positioned.new().left(200.0).width(200.0).height(600.0).child(region).build());

    mount(stack.build());
    return downs;
}

entry fn g_down(downs: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {
    let cell = st_take(K_COUNT);
    let n = mem_get(cell) + 1.0;
    mem_set(cell, n);
    st_put(K_COUNT, cell);
    rs_set_str(downs, f"{n as u64}");
}
