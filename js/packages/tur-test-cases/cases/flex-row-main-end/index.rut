// flex-row-main-end: two fixed-width children pinned to the main-axis end.
use tur::{ CROSS_ALIGN_START, MAIN_ALIGN_END, mount };
use tur_kit::{ Container, Row };


fn box_wh(w: f64, h: f64) -> View {
    let b = Container().width_height(w, h);
    return b.build();
}

entry fn start() {
    let row = Row()
        .main_alignment(MAIN_ALIGN_END)
        .cross_alignment(CROSS_ALIGN_START)
        .child(box_wh(50.0, 0.0))
        .child(box_wh(30.0, 0.0));
    mount(row.build());
}
