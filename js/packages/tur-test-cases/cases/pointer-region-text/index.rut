// pointer-region-text: a MouseRegion whose enter/exit writes the bound
// label inside a padded, centered surface.
use tur::{ ALIGN_CENTER, CROSS_ALIGN_START, CURSOR_AUTO, mount, rs_set_str, rs_source_str };
use tur_kit::{ Column, Container, MouseRegion, Text };


entry fn start() -> u64 {
    let state = rs_source_str("idle");
    let mut col = Column().cross_alignment(CROSS_ALIGN_START);

    let b = Container()
        .width_height(100.0, 50.0)
        .color(0xCCCCCCFFu64)
        .alignment(ALIGN_CENTER)
        .child(Text().text_bound(state).query_key("region-text").build());

    col.child(MouseRegion().on_enter(mr_enter, state).on_exit(mr_exit, state).cursor(CURSOR_AUTO).behavior(0).child(b.build()).build());
    mount(col.build());
    return state;
}

fn mr_enter(state: u64, _b: u64, _n: f64) {
    rs_set_str(state, "entered");
}

fn mr_exit(state: u64, _b: u64, _n: f64) {
    rs_set_str(state, "exited");
}
