// pointer-region-text: a MouseRegion whose enter/exit writes the bound
// label inside a padded, centered surface.
use tur::{ ALIGN_CENTER, CROSS_ALIGN_START, CURSOR_AUTO, mount, rs_set_str, rs_source_str };
use tur_kit::{ Column, Container, MouseRegion, Text };


entry fn start() -> u64 {
    let state = rs_source_str("idle");
    let mut col = Column.builder();
    col.cross_alignment(CROSS_ALIGN_START);

    let mut b = Container.builder();
    b.width_height(100.0, 50.0);
    b.color(0xCCCCCCFFu64);
    b.alignment(ALIGN_CENTER);
    let mut t = Text.builder();

    t.text_bound(state);
    t.query_key("region-text");
    b.child(t.build());

    col.child(MouseRegion.builder().on_enter("mr_enter", state).on_exit("mr_exit", state).cursor(CURSOR_AUTO).behavior(0).child(b.build()).build());
    mount(col.build());
    return state;
}

entry fn mr_enter(state: u64, _b: u64, _n: f64) {
    rs_set_str(state, "entered");
}

entry fn mr_exit(state: u64, _b: u64, _n: f64) {
    rs_set_str(state, "exited");
}
