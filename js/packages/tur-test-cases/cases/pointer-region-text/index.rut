// pointer-region-text: a MouseRegion whose enter/exit writes the bound
// label inside a padded, centered surface. The handlers are mutations
// over the MutationCtx; the state source rides by capture.
use tur::{ ALIGN_CENTER, CROSS_ALIGN_START, CURSOR_AUTO, mount };
use tur_kit::{ Column, Container, EnterEvent, ExitEvent, MouseRegion, MutationCtx, Readable, Text,
    mutate_enter, mutate_exit, source_str };


entry fn start() -> u64 {
    let state: Readable<str> = source_str("idle");
    let b_enter = mutate_enter(fn (ctx: MutationCtx, _ev: EnterEvent) {
        ctx.set<str>(state, "entered");
    });
    let b_exit = mutate_exit(fn (ctx: MutationCtx, _ev: ExitEvent) {
        ctx.set<str>(state, "exited");
    });
    let mut col = Column().cross_alignment(CROSS_ALIGN_START);

    let b = Container()
        .width_height(100.0, 50.0)
        .color(0xCCCCCCFFu64)
        .alignment(ALIGN_CENTER)
        .child(Text().text_bound(state).query_key("region-text").build());

    col.child(MouseRegion().on_enter(b_enter).on_exit(b_exit).cursor(CURSOR_AUTO).behavior(0).child(b.build()).build());
    mount(col.build());
    return state.atom_id();
}
