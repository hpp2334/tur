// mouse-region-reactive-cursor: the cursor resolves from a str atom each
// layout — flipping the atom re-resolves the cursor on hover.
use tur::{ mount, rs_set_str, rs_source_str };
use tur_kit::{ Column, Container, MouseRegion, Text };


entry fn start() -> u64 {
    let cursor = rs_source_str("pointer");
    let state = rs_source_str("");
    let mut col = Column();
    let b = Container().width_height(100.0, 50.0).child(Text().text_bound(state).build());
    col.child(MouseRegion().on_enter(mr_enter, state).on_exit(mr_exit, state).cursor_bound(cursor).behavior(0).child(b.build()).build());
    let ct = Text().text_bound(cursor).query_key("cursor-atom");
    col.child(ct.build());
    mount(col.build());
    return cursor;
}

entry fn set_cursor(cursor: u64, code: f64) {
    // code indexes the standard keyword table (the test passes the enum
    // position of the cursor it wants).
    let name = cursor_name(code as u64);
    rs_set_str(cursor, name);
}

fn mr_enter(_state: u64, _b: u64, _n: f64) {
}

fn mr_exit(_state: u64, _b: u64, _n: f64) {
}

// The standard CSS keyword for a cursor code (the el_mouse_region_bound
// decode reads the same table).
fn cursor_name(code: u64) -> str {
    if (code == 27) {
        return "ew-resize";
    }
    if (code == 5) {
        return "pointer";
    }
    return "default";
}
