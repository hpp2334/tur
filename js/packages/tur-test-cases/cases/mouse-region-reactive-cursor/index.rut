// mouse-region-reactive-cursor: the cursor resolves from a str atom each
// layout — flipping the atom re-resolves the cursor on hover.
use tur::{ el_box_new, box_size, el_build, el_child, el_column, el_mouse_region, el_text_bound_new, mount, rs_set_str, rs_source_str };

entry fn start() -> u64 {
    let cursor = rs_source_str("pointer");
    let state = rs_source_str("");
    let col = el_column();
    let b = el_box_new();
    box_size(b, 100.0, 50.0);
    let t = el_text_bound_new(state);
    el_child(b, el_build(t));
    el_child(col, el_mouse_region_bound(state, "mr_enter", "mr_exit", cursor, 0, el_build(b)));
    let ct = el_text_bound_new(cursor);
    el_qkey(ct, "cursor-atom");
    el_child(col, el_build(ct));
    mount(el_build(col));
    return cursor;
}

entry fn set_cursor(cursor: u64, code: f64) {
    // code indexes the standard keyword table (the test passes the enum
    // position of the cursor it wants).
    let name = cursor_name(code as u64);
    rs_set_str(cursor, name);
}

entry fn mr_enter(_state: u64, _b: u64, _n: f64) {
}

entry fn mr_exit(_state: u64, _b: u64, _n: f64) {
}

// The standard CSS keyword for a cursor code (the el_mouse_region_bound
// decode reads the same table).
fn cursor_name(code: u64) -> str {
    if (code == 27) {
        return "ew-resize";
    }
    if (code == 5) {
        return "pointer";
    }
    return "default";
}
