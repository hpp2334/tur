// composited-transform-reactive-anchor: the target anchor resolves from an
// atom; the button (20, 540) flips it to BottomRight — the follower
// relocates to the target's bottom-right (160, 120).
use tur::{ ALIGN_TOP_LEFT, ct_link_new, mount, rs_set_f64, rs_source_f64 };
use tur_kit::{ CompositedFollower, CompositedTarget, Container, PointerInteract, Positioned, SizedBox, Stack };


entry fn start() -> u64 {
    let anchor = rs_source_f64();
    rs_set_f64(anchor, 0.0);
    let link = ct_link_new();
    let mut stack = Stack.new();
    stack.child(SizedBox.new(400.0, 600.0).child(Container.new().build()).build());
    let target_child = SizedBox.new(60.0, 40.0).child(Container.new().build()).build();
    let target = CompositedTarget.new().link(link).child(target_child).build();
    stack.child(Positioned.new().left(100.0).top(80.0).child(target).build());
    let mut red = Container.new();
    red.width_height(20.0, 20.0);
    red.color(0xFF0000FFu64);
    let follower = CompositedFollower.new().link(link).target_anchor_bound(anchor).follower_anchor(ALIGN_TOP_LEFT).child(red.build()).build();
    stack.child(follower);

    let mut btn = Container.new();
    btn.width_height(60.0, 30.0);
    btn.color(0x4F46E1FFu64);
    stack.child(Positioned.new().left(20.0).top(540.0).child(PointerInteract.new().ids(anchor, anchor).on_tap("b_flip").child(btn.build()).build()).build());
    mount(stack.build());
    return anchor;
}

entry fn b_flip(anchor: u64, _b: u64, _n: f64) {
    rs_set_f64(anchor, 8.0);
}
