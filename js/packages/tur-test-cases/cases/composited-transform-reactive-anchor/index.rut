// composited-transform-reactive-anchor: the target anchor resolves from an
// atom; the button (20, 540) flips it to BottomRight — the follower
// relocates to the target's bottom-right (160, 120).
use tur::{ ALIGN_TOP_LEFT, ct_link_new, mount, rs_set_f64, rs_source_f64 };
use tur_kit::{ CompositedFollower, CompositedTarget, Container, PointerInteract, Positioned, SizedBox, Stack };


entry fn start() -> u64 {
    let anchor = rs_source_f64();
    rs_set_f64(anchor, 0.0);
    let link = ct_link_new();
    let mut stack = Stack()
        .child(SizedBox(400.0, 600.0).child(Container().build()).build());
    let target_child = SizedBox(60.0, 40.0).child(Container().build()).build();
    let target = CompositedTarget().link(link).child(target_child).build();
    stack.child(Positioned().left(100.0).top(80.0).child(target).build());
    let red = Container().width_height(20.0, 20.0).color(0xFF0000FFu64);
    let follower = CompositedFollower().link(link).target_anchor_bound(anchor).follower_anchor(ALIGN_TOP_LEFT).child(red.build()).build();
    stack.child(follower);

    let btn = Container().width_height(60.0, 30.0).color(0x4F46E1FFu64);
    stack.child(Positioned().left(20.0).top(540.0).child(PointerInteract().ids(anchor, anchor).on_tap(b_flip).child(btn.build()).build()).build());
    mount(stack.build());
    return anchor;
}

fn b_flip(anchor: u64, _b: u64, _n: f64) {
    rs_set_f64(anchor, 8.0);
}
