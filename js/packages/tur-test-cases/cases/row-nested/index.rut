// row-nested (Flutter parity): non-flex children of a flex receive unbounded
// main-axis constraints, so the inner Row (default MainAxisSize.max) must
// shrink-wrap to its content width instead of consuming the outer Row's
// full width — leaving the following sibling visible.
use tur::{ CROSS_ALIGN_START, mount };
use tur_kit::{ Container, Row };


fn box_wh(w: f64, h: f64) -> opaque {
    let mut b = Container.builder();
    b.width_height(w, h);
    return b.build();
}

entry fn start() {
    let mut outer = Row.builder();
    outer.cross_alignment(CROSS_ALIGN_START);
    let mut inner = Row.builder();
    inner.child(box_wh(20.0, 0.0));
    inner.child(box_wh(30.0, 0.0));
    outer.child(inner.build());
    outer.child(box_wh(50.0, 10.0));
    mount(outer.build());
}
