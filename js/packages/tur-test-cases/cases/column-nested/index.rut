// column-nested: a Column inside a Column. Non-flex children receive
// UNBOUNDED main-axis constraints, so the inner Column (default
// MainAxisSize.max) must degenerate to content size (Flutter RenderFlex
// parity).
use tur::{ CROSS_ALIGN_START, mount };
use tur_kit::{ Column, Container };


fn box_h(h: f64) -> opaque {
    let mut b = Container.new();
    b.width_height(0.0, h);
    return b.build();
}

entry fn start() {
    let mut outer = Column.new();
    outer.cross_alignment(CROSS_ALIGN_START);
    outer.child(box_h(50.0));
    let mut inner = Column.new();
    inner.cross_alignment(CROSS_ALIGN_START);
    inner.child(box_h(30.0));
    outer.child(inner.build());
    outer.child(box_h(40.0));
    mount(outer.build());
}
