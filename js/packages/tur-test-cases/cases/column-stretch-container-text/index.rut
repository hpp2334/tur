// column-stretch-container-text: Column(crossAlignment: Stretch) around a
// padded unsized Container + Text — full-width colored strip.
use tur::{ CROSS_ALIGN_STRETCH, mount };
use tur_kit::{ Column, Container, Text };


entry fn start() {
    let mut col = Column.builder();
    col.cross_alignment(CROSS_ALIGN_STRETCH);
    let mut b = Container.builder();
    b.color(0xFF0000FFu64);
    b.padding(20.0);
    b.query_key("container");
    b.child(Text.builder().text("Empty State").build());
    col.child(b.build());
    mount(col.build());
}
