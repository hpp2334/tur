// vello-column-basic: a colored container with two text rows — the vello
// render smoke fixture.
use tur::{ el_box, el_column, el_text, el_build, el_child, mount };

entry fn start() {
    let col = el_column();
    el_child(col, el_text("hello vello"));
    el_child(col, el_text("second line"));
    mount(el_box(0xF0F4F8FFu64, 12.0, el_build(col)));
}
