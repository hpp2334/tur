// vello-column-basic: a colored container with two text rows — the vello
// render smoke fixture.
use tur::{ mount };
use tur_kit::{ Column, Container, Text };


entry fn start() {
    let mut col = Column.builder();
    col.child(Text.builder().text("hello vello").build());
    col.child(Text.builder().text("second line").build());
    mount(Container.builder().color(0xF0F4F8FFu64).padding(12.0).child(col.build()).build());
}
