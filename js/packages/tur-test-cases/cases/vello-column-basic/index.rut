// vello-column-basic: a colored container with two text rows — the vello
// render smoke fixture.
use tur::{ mount };
use tur_kit::{ Column, Container, Text };


entry fn start() {
    let mut col = Column.new();
    col.child(Text.new().text("hello vello").build());
    col.child(Text.new().text("second line").build());
    mount(Container.new().color(0xF0F4F8FFu64).padding(12.0).child(col.build()).build());
}
