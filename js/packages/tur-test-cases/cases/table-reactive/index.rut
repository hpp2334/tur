// table-reactive: the table twin with a reactive row set — a button adds
// a planet through an Each over the rows atom. The tap is a mutation over
// the MutationCtx; the rows source rides by capture.
use tur::{ CROSS_ALIGN_STRETCH, mount };
use tur_kit::{ Column, Container, Each, MutationCtx, PointerInteract, Readable, Row, SizedBox, Text,
    list_new, list_push, mutate, source_value, value_item, value_len };


fn row(i: u64, name: str) -> opaque {
    let mut r = Row().query_key(f"table/row{i as u64}");
    let c = Container().width_height(150.0, 0.0).padding(8.0).child(Text().text(name).font_size(14.0).build());
    r.child(c.build());
    return r.build();
}

entry fn start() -> u64 {
    let rows = list_new();
    list_push(rows, "Mercury");
    list_push(rows, "Venus");
    let rows_atom: Readable<opaque> = source_value(rows);
    let b_add = mutate(fn (ctx: MutationCtx) {
        // Read-modify-write: rebuild the list with one more row.
        let cur = ctx.get_value(rows_atom);
        let n = value_len(cur);
        let fresh = list_new();
        let mut i = 0;
        while (i < n as i32) {
            list_push(fresh, value_item(cur, i as u64));
            i += 1;
        }
        list_push(fresh, f"Planet {n as u64}");
        ctx.set_value(rows_atom, fresh);
    });

    // The head is a BAND (width_height(0, h) = fixed height, width unset
    // per the box_size idiom): Stretch spans it over the table so the
    // header sits flush-left above its rows instead of shrink-wrapping to
    // the label and floating cross-centered.
    let mut col = Column().cross_alignment(CROSS_ALIGN_STRETCH).query_key("table/col");
    let head = Container()
        .width_height(0.0, 32.0)
        .color(0x1E293BFF)
        .query_key("table/head")
        .child(Text().text("PLANET").font_size(12.0).build());
    col.child(head.build());
    col.child(Each(rows_atom).item_builder(row).build());
    col.child(PointerInteract().on_click(b_add).child(Text().text("add row").build()).build());
    let frame = Container().color(0x0B1220FF).child(col.build());
    mount(SizedBox(400.0, 240.0).child(frame.build()).build());
    return rows_atom.atom_id();
}
