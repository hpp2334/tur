// table-reactive: the table twin with a reactive row set — a button adds
// a planet through an Each over the rows atom.
use tur::{ mount, rs_get_value, rs_list_new, rs_list_push, rs_set_value, rs_source_value,
    rs_value_item, rs_value_len };
use tur_kit::{ Column, Container, Each, PointerInteract, Row, SizedBox, Text };


entry fn row(_i: u64, name: str) -> opaque {
    let mut r = Row.new();
    let mut c = Container.new();
    c.width_height(150.0, 0.0);
    c.padding(8.0);
    let mut t = Text.new();

    t.text(name);
    t.font_size(14.0);
    c.child(t.build());
    r.child(c.build());
    return r.build();
}

entry fn start() -> u64 {
    let rows = rs_list_new();
    rs_list_push(rows, "Mercury");
    rs_list_push(rows, "Venus");
    let rows_atom = rs_source_value(rows);

    let mut col = Column.new();
    let mut head = Container.new();
    head.width_height(0.0, 32.0);
    head.color(0x1E293BFF);
    let mut ht = Text.new();

    ht.text("PLANET");
    ht.font_size(12.0);
    head.child(ht.build());
    col.child(head.build());
    col.child(Each.new(rows_atom).item_builder("row").build());
    col.child(PointerInteract.new().ids(rows_atom, rows_atom).on_tap("b_add").child(Text.new().text("add row").build()).build());
    let mut frame = Container.new();
    frame.color(0x0B1220FF);
    frame.child(col.build());
    mount(SizedBox.new(400.0, 240.0).child(frame.build()).build());
    return rows_atom;
}

entry fn b_add(rows: u64, _b: u64, _n: f64) {
    // Read-modify-write: rebuild the list with one more row.
    let cur = rs_get_value(rows);
    let n = rs_value_len(cur);
    let fresh = rs_list_new();
    let mut i = 0;
    while (i < n as i32) {
        rs_list_push(fresh, rs_value_item(cur, i as u64));
        i += 1;
    }
    rs_list_push(fresh, f"Planet {n as u64}");
    rs_set_value(rows, fresh);
}
