// row-cross-center-in-column: a min-size centering Row in a Column.
use tur::{ CROSS_ALIGN_CENTER, CROSS_ALIGN_START, MAIN_SIZE_MIN, el_box_new, box_size, el_build, el_child, el_column, el_row, flex_cross_align, flex_main_size, mount };

entry fn start() {
    let col = el_column();
    flex_cross_align(col, CROSS_ALIGN_START);
    let row = el_row();
    flex_cross_align(row, CROSS_ALIGN_CENTER);
    flex_main_size(row, MAIN_SIZE_MIN);
    el_child(row, box_wh(20.0, 20.0));
    el_child(row, box_wh(40.0, 10.0));
    el_child(col, el_build(row));
    el_child(col, box_wh(0.0, 30.0));
    el_child(col, box_wh(0.0, 20.0));
    mount(el_build(col));
}

fn box_wh(w: f64, h: f64) -> opaque {
    let b = el_box_new();
    box_size(b, w, h);
    return el_build(b);
}
