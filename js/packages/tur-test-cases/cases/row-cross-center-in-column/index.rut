// row-cross-center-in-column: a min-size centering Row in a Column.
use tur::{ CROSS_ALIGN_CENTER, CROSS_ALIGN_START, MAIN_SIZE_MIN, mount };
use tur_kit::{ Column, Container, Row };


entry fn start() {
    let mut col = Column.new();
    col.cross_alignment(CROSS_ALIGN_START);
    let mut row = Row.new();
    row.cross_alignment(CROSS_ALIGN_CENTER);
    row.main_axis_size(MAIN_SIZE_MIN);
    row.child(box_wh(20.0, 20.0));
    row.child(box_wh(40.0, 10.0));
    col.child(row.build());
    col.child(box_wh(0.0, 30.0));
    col.child(box_wh(0.0, 20.0));
    mount(col.build());
}

fn box_wh(w: f64, h: f64) -> opaque {
    let mut b = Container.new();
    b.width_height(w, h);
    return b.build();
}
