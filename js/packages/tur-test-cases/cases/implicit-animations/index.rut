// implicit-animations: animated style channels driven by one shared
// controller (the Animated* twin) — the toggle flips the target and
// restarts the controller (the ImplicitlyAnimatedWidget retarget).
use tur::{ anim_ctrl, anim_forward, anim_reverse, mount, rs_get_bool, rs_set_bool, rs_source_bool,
    rs_source_f64, st_put, st_take, stf_put };
use tur_kit::{ Column, Container, PointerInteract, Text };


let K_CTRL: u64 = 1;
let K_EXPANDED: u64 = 2;

entry fn start() -> u64 {
    let expanded = rs_source_bool(false);
    stf_put(K_EXPANDED, expanded as f64);
    let progress = rs_source_f64();
    let ctrl = anim_ctrl(progress, 300.0, "easeInOut", 0, "a_tick", "a_end");
    st_put(K_CTRL, ctrl);

    let mut col = Column();
    let box_b = Container().width_height(100.0, 40.0).color(0x6366F1FFu64).query_key("animated-box");
    col.child(PointerInteract().ids(expanded, expanded).on_tap("b_toggle").child(box_b.build()).build());
    col.child(Text().text("toggle me").build());
    mount(col.build());
    return expanded;
}

entry fn a_tick(_atom: u64, _t: f64) {
}

entry fn a_end(_atom: u64, _v: f64) {
}

entry fn b_toggle(expanded: u64, _b: u64, _n: f64) {
    rs_set_bool(expanded, !rs_get_bool(expanded));
    // Retarget: reverse or forward the shared controller.
    let ctrl = st_take(K_CTRL);
    if (rs_get_bool(expanded)) {
        anim_forward(ctrl);
    } else {
        anim_reverse(ctrl);
    }
    st_put(K_CTRL, ctrl);
}
