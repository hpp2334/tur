// composited-transform-scroll: the target lives inside a scrollable
// (content offset y=100); scrolling moves the target and the follower
// tracks it.
use tur::{ ALIGN_TOP_LEFT, AXIS_VERTICAL, ct_link_new, mount };
use tur_kit::{ Column, CompositedFollower, CompositedTarget, Container, Positioned, ScrollView, SizedBox, Stack };


entry fn start() {
    let link = ct_link_new();
    let mut stack = Stack.new();
    stack.child(SizedBox.new(400.0, 600.0).child(Container.new().build()).build());

    // The scrollable viewport (200x200) with 400px of content; the target
    // sits at content y=100 (after a 100px spacer).
    let mut content = Column.new();
    content.child(SizedBox.new(200.0, 100.0).child(Container.new().build()).build());
    let target_child = SizedBox.new(60.0, 40.0).child(Container.new().build()).build();
    let target = CompositedTarget.new().link(link).child(target_child).build();
    content.child(target);
    content.child(SizedBox.new(200.0, 300.0).child(Container.new().build()).build());
    let scroller = ScrollView.new().axis(AXIS_VERTICAL).child(content.build()).build();
    stack.child(Positioned.new().width(200.0).height(200.0).child(scroller).build());

    let mut red = Container.new();
    red.width_height(20.0, 20.0);
    red.color(0xFF0000FFu64);
    let follower = CompositedFollower.new().link(link).target_anchor(ALIGN_TOP_LEFT).follower_anchor(ALIGN_TOP_LEFT).child(red.build()).build();
    stack.child(follower);
    mount(stack.build());
}
