// drag-delta-tracking: a drag pad computing deltaFromStart/deltaFromLast
// (the VDivider pattern). The scratch points ride f64 sources captured by
// the drag mutations; the transcript source renders "dsx,dsy,dlx,dly" for
// the test to parse.
use tur::{ ctx_bridge, mount };
use tur_kit::{ Container, MutationCtx, PointerEvent, PointerInteract, Readable, Text, mutate_ev,
    source_f64, source_str };


entry fn start() -> u64 {
    let info: Readable<str> = source_str("0,0,0,0");
    let sx: Readable<f64> = source_f64(0.0);
    let sy: Readable<f64> = source_f64(0.0);
    let lx: Readable<f64> = source_f64(0.0);
    let ly: Readable<f64> = source_f64(0.0);

    // The anchor press: from-start + from-last are both 0 (the anchors
    // seed BEFORE the emit reads).
    let b_down = mutate_ev(fn (ctx: MutationCtx, ev: PointerEvent) {
        let gx = ev.global.x;
        let gy = ev.global.y;
        ctx.set_f64(sx, gx);
        ctx.set_f64(sy, gy);
        ctx.set_f64(lx, gx);
        ctx.set_f64(ly, gy);
        ctx.set_str(info, f"{gx - ctx.get_f64(sx)},{gy - ctx.get_f64(sy)},{gx - ctx.get_f64(lx)},{gy - ctx.get_f64(ly)}");
    });
    let b_move = mutate_ev(fn (ctx: MutationCtx, ev: PointerEvent) {
        let gx = ev.global.x;
        let gy = ev.global.y;
        ctx.set_str(info, f"{gx - ctx.get_f64(sx)},{gy - ctx.get_f64(sy)},{gx - ctx.get_f64(lx)},{gy - ctx.get_f64(ly)}");
        ctx.set_f64(lx, gx);
        ctx.set_f64(ly, gy);
    });

    let b = Container()
        .width_height(200.0, 200.0)
        .color(0x6366F1FF)
        .query_key("drag-target")
        .child(Text().text_bound(info).query_key("drag-info").build());

    let pad = PointerInteract().on_pointer_down(b_down).on_pointer_move(b_move).query_key("rut/gesture").child(b.build()).build();
    mount(pad);
    return info.atom_id();
}

// The test's reset probe (the `__resetDrag` seam): clear the transcript —
// the engine stops delivering moves once the pointer is up, so no further
// deltas land. The atom id rides the entry arg.
entry fn reset(atom: u64, _b: f64) {
    let info = Readable<str>.of(ctx_bridge(), atom);
    MutationCtx.over(ctx_bridge()).set_str(info, "0,0,0,0");
}
