// drag-delta-tracking: a drag pad computing deltaFromStart/deltaFromLast
// (the VDivider pattern). Scratch numbers ride stashed mem cells; the
// transcript atom renders "dsx,dsy,dlx,dly" for the test to parse.
use tur::{ mem_get, mem_new, mem_set, mount, rs_set_str, rs_source_str, st_put, st_take };
use tur_kit::{ Container, PointerInteract, Text };


let K_SX: u64 = 2;
let K_SY: u64 = 3;
let K_LX: u64 = 4;
let K_LY: u64 = 5;

entry fn start() -> u64 {
    let info = rs_source_str("0,0,0,0");
    st_put(K_SX, mem_new(0.0));
    st_put(K_SY, mem_new(0.0));
    st_put(K_LX, mem_new(0.0));
    st_put(K_LY, mem_new(0.0));

    let mut b = Container.new();
    b.width_height(200.0, 200.0);
    b.color(0x6366F1FF);
    b.query_key("drag-target");
    let mut info_t = Text.new();

    info_t.text_bound(info);
    info_t.query_key("drag-info");
    b.child(info_t.build());

    let pad = PointerInteract.new().id(info).on_down("g_down").on_move("g_move").on_up("g_up").query_key("rut/gesture").child(b.build()).build();
    mount(pad);
    return info;
}

// From-start + from-last deltas, read BEFORE the last-point update.
fn emit(id: u64, gx: f64, gy: f64) {
    let sx = st_take(K_SX);
    let sy = st_take(K_SY);
    let lx = st_take(K_LX);
    let ly = st_take(K_LY);
    let dsx = gx - mem_get(sx);
    let dsy = gy - mem_get(sy);
    let dlx = gx - mem_get(lx);
    let dly = gy - mem_get(ly);
    rs_set_str(id, f"{dsx},{dsy},{dlx},{dly}");
    st_put(K_SX, sx);
    st_put(K_SY, sy);
    st_put(K_LX, lx);
    st_put(K_LY, ly);
}

entry fn g_down(id: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {
    let sx = st_take(K_SX);
    let sy = st_take(K_SY);
    mem_set(sx, gx);
    mem_set(sy, gy);
    st_put(K_SX, sx);
    st_put(K_SY, sy);
    move_last(gx, gy);
    emit(id, gx, gy);
}

entry fn g_move(id: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {
    emit(id, gx, gy);
    move_last(gx, gy);
}

// The test's explicit reset probe (the `__resetDrag` seam): clear the
// drag tracking so post-release hover-moves produce no deltas.
entry fn reset(id: u64, _b: f64) {
    let sx = st_take(K_SX);
    let sy = st_take(K_SY);
    let lx = st_take(K_LX);
    let ly = st_take(K_LY);
    mem_set(sx, 0.0);
    mem_set(sy, 0.0);
    mem_set(lx, 0.0);
    mem_set(ly, 0.0);
    st_put(K_SX, sx);
    st_put(K_SY, sy);
    st_put(K_LX, lx);
    st_put(K_LY, ly);
    rs_set_str(id, "0,0,0,0");
}

fn move_last(gx: f64, gy: f64) {
    let lx = st_take(K_LX);
    let ly = st_take(K_LY);
    mem_set(lx, gx);
    mem_set(ly, gy);
    st_put(K_LX, lx);
    st_put(K_LY, ly);
}
