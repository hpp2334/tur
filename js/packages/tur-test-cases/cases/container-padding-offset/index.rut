// container-padding-offset: a padded container around a start-aligned
// column holding one fixed-size child.
use tur::{ CROSS_ALIGN_START, el_box_new, box_padding, box_size, el_build, el_child, el_column, flex_cross_align, mount };

entry fn start() {
    let outer = el_box_new();
    box_size(outer, 200.0, 100.0);
    box_padding(outer, 20.0);
    let col = el_column();
    flex_cross_align(col, CROSS_ALIGN_START);
    let inner = el_box_new();
    box_size(inner, 40.0, 40.0);
    el_child(col, el_build(inner));
    el_child(outer, el_build(col));
    mount(el_build(outer));
}
