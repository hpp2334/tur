// pointer-region-enter-exit-race: two regions sharing one hover atom —
// moving A->B in a single event must land on "B" (exit-before-enter).
use tur::{ mount, rs_set_str, rs_source_str };
use tur_kit::{ Column, Container, MouseRegion, Text };


entry fn start() -> u64 {
    let hover = rs_source_str("");
    let mut col = Column.builder();

    let mut a = Container.builder();
    a.width_height(100.0, 50.0);
    a.color(0xEF4444FFu64);
    a.query_key("a");
    col.child(MouseRegion.builder().on_enter("a_enter", hover).on_exit("a_exit", hover).cursor(0).behavior(0).child(a.build()).build());

    let mut b = Container.builder();
    b.width_height(100.0, 50.0);
    b.color(0x3B82F6FF);
    b.query_key("b");
    col.child(MouseRegion.builder().on_enter("b_enter", hover).on_exit("b_exit", hover).cursor(0).behavior(0).child(b.build()).build());

    let mut t = Text.builder();

    t.text_bound(hover);
    t.query_key("hover");
    col.child(t.build());
    mount(col.build());
    return hover;
}

entry fn a_enter(hover: u64, _b: u64, _n: f64) {
    rs_set_str(hover, "A");
}

entry fn a_exit(hover: u64, _b: u64, _n: f64) {
    rs_set_str(hover, "");
}

entry fn b_enter(hover: u64, _b: u64, _n: f64) {
    rs_set_str(hover, "B");
}

entry fn b_exit(hover: u64, _b: u64, _n: f64) {
    rs_set_str(hover, "");
}
