// pointer-region-enter-exit-race: two regions sharing one hover atom —
// moving A->B in a single event must land on "B" (exit-before-enter).
use tur::{ el_box_new, box_color, box_size, el_build, el_child, el_column, el_mouse_region, el_qkey, el_text_bound_new, mount, rs_set_str, rs_source_str };

entry fn start() -> u64 {
    let hover = rs_source_str("");
    let col = el_column();

    let a = el_box_new();
    box_size(a, 100.0, 50.0);
    box_color(a, 0xEF4444FFu64);
    el_qkey(a, "a");
    el_child(col, el_mouse_region(hover, "a_enter", "a_exit", 0, 0, el_build(a)));

    let b = el_box_new();
    box_size(b, 100.0, 50.0);
    box_color(b, 0x3B82F6FF);
    el_qkey(b, "b");
    el_child(col, el_mouse_region(hover, "b_enter", "b_exit", 0, 0, el_build(b)));

    let t = el_text_bound_new(hover);
    el_qkey(t, "hover");
    el_child(col, el_build(t));
    mount(el_build(col));
    return hover;
}

entry fn a_enter(hover: u64, _b: u64, _n: f64) {
    rs_set_str(hover, "A");
}

entry fn a_exit(hover: u64, _b: u64, _n: f64) {
    rs_set_str(hover, "");
}

entry fn b_enter(hover: u64, _b: u64, _n: f64) {
    rs_set_str(hover, "B");
}

entry fn b_exit(hover: u64, _b: u64, _n: f64) {
    rs_set_str(hover, "");
}
