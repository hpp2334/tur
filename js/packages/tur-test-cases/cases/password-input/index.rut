// password-input: the boa design — a plain Input, a password Input, and
// a live `value: "…"` readout of the password controller's true text.
// Typing renders bullets in the password field while the controller keeps
// the real value (the on-input mutation feeds the readout from the typed
// `InputEvent`). A seeded "hunter2" boots the field; the reveal pill flips
// the obscure flag via obscure_bound (the reactive mask — no rebuild) and
// rebuilds its own label through a Condition on the same source.
//
// Phase-2 note: this case is typed in the playground VIEWER too — the
// va-child keyboard rail forwards real keys into the focused child input.
use tur::{ CROSS_ALIGN_CENTER, CROSS_ALIGN_START, CURSOR_POINTER, mount, tctrl_new,
    tctrl_set_text, undo_new };
use tur_kit::{ Column, Condition, Container, Input, InputEvent, MouseRegion, Mutation,
    MutationCtx, PointerInteract, Readable, Row, SizedBox, Text, mutate, mutate_input,
    source_bool, source_str };


entry fn start() -> u64 {
    let obscure: Readable<bool> = source_bool(true);
    let value: Readable<str> = source_str("value: \"hunter2\"");
    let ctrl = tctrl_new();
    tctrl_set_text(ctrl, "hunter2");
    let undo = undo_new();

    // The reveal toggle (the pill's mutation captures the source).
    let b_toggle = mutate(fn (ctx: MutationCtx) {
        ctx.set_bool(obscure, !ctx.get_bool(obscure));
    });

    // The on-input rail: the typed event carries the fresh true text; the
    // controller is captured (the readout wraps it as value: "…").
    let q: str = "\"";
    let b_value = mutate_input(fn (ctx: MutationCtx, ev: InputEvent) {
        ctx.set_str(value, f"value: {q}{ev.value}{q}");
    });

    let plain = Input()
        .controller(tctrl_new())
        .undo(undo_new())
        .placeholder("Plain")
        .font_size(16.0)
        .width_height(240.0, 38.0)
        .query_key("plain")
        .build();
    let password = Input()
        .controller(ctrl)
        .undo(undo)
        .placeholder("Password")
        .obscure_bound(obscure)
        .on_input(b_value)
        .font_size(16.0)
        .width_height(240.0, 38.0)
        .query_key("password")
        .build();

    let col = Column()
        .cross_alignment(CROSS_ALIGN_START)
        .child(Text().text("Password Input").font_size(18.0).color(0x0F172AFFu64).query_key("password-title").build())
        .child(SizedBox(0.0, 12.0).build())
        .child(plain)
        .child(SizedBox(0.0, 12.0).build())
        .child(password)
        .child(SizedBox(0.0, 12.0).build())
        .child(
            Row()
                .cross_alignment(CROSS_ALIGN_CENTER)
                .child(Text().text_bound(value).font_size(12.0).color(0x64748BFFu64).query_key("password-value").build())
                .child(SizedBox(12.0, 0.0).build())
                .child(Condition(obscure).then_build(fn () -> View { return reveal_pill("Show", b_toggle); }).else_build(fn () -> View { return reveal_pill("Hide", b_toggle); }).build())
                .build(),
        )
        .build();

    mount(Container().padding(32.0).child(col).build());
    return obscure.atom_id();
}

// The reveal pill — Show while masked, Hide while revealed. The tap
// mutation rides by parameter (no ids, no stash).
fn reveal_pill(label: str, b_toggle: Mutation<nil, nil>) -> opaque {
    let face = Container()
        .padding(6.0)
        .radius(7.0)
        .color(0xF1F5F9FFu64)
        .child(Text().text(label).font_size(11.0).color(0x334155FFu64).build())
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(
            PointerInteract()
                .on_click(b_toggle)
                .query_key("password-reveal")
                .child(face)
                .build(),
        )
        .build();
}
