// password-input: an obscure-toggle input — typing renders bullets and a
// reveal button flips the obscure flag (a rebuild).
use tur::{ mount, rs_get_bool, rs_set_bool, rs_source_bool, tctrl_new, undo_new };
use tur_kit::{ Column, Container, Input, PointerInteract, Text };


entry fn start() -> u64 {
    let obscure = rs_source_bool(true);
    let ctrl = tctrl_new();
    let undo = undo_new();

    let mut col = Column();
    let input = Input().controller(ctrl).undo(undo).placeholder("password").width_height(220.0, 32.0).obscure(true).query_key("password-input").build();
    col.child(input);
    col.child(PointerInteract().ids(obscure, obscure).on_tap(b_toggle).child(Text().text("reveal").build()).build());
    let root = Container().child(col.build());
    mount(root.build());
    return obscure;
}

fn b_toggle(obscure: u64, _b: u64, _n: f64) {
    rs_set_bool(obscure, !rs_get_bool(obscure));
}
