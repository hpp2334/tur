// transform-translate-hit: a box laid out at (0,0) painted at (100,80)
// via a paint-only Transform translate — clickable at the PAINTED center.
// The click flips the hit atom; the Condition mounts the red confirmation
// box (the branch swap adds one container node).
use tur::{ ALIGN_TOP_LEFT, mount, rs_set_bool, rs_source_bool };
use tur_kit::{ Condition, Container, PointerInteract, SizedBox, Stack, Text };
use tur_anim_kit::{ Transform };


entry fn start() {
    let hit = rs_source_bool(false);

    let mut stack = Stack.new();
    stack.alignment(ALIGN_TOP_LEFT);
    stack.child(SizedBox.new(400.0, 600.0).child(Container.new().build()).build());

    let mut indigo = Container.new();
    indigo.width_height(40.0, 40.0);
    indigo.color(0x4F46E1FFu64);
    let pi = PointerInteract.new().ids(hit, hit).on_tap("b_hit").child(indigo.build()).build();
    stack.child(Transform.new(1.0, 0.0, 100.0, 80.0).child(pi).build());

    // The confirmation box appears when the click registers (the else
    // branch is a Text — not a container — so the container count grows
    // by exactly one when the red box mounts).
    let mut red = Container.new();
    red.width_height(40.0, 40.0);
    red.color(0xFF0000FFu64);
    stack.child(Condition.new(hit).then(red.build()).else_branch(Text.new().text("").build()).build());

    mount(stack.build());
}

entry fn b_hit(hit: u64, _b: u64, _n: f64) {
    rs_set_bool(hit, true);
}
