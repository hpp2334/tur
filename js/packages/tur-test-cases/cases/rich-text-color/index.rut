use tur::{ mount };
use tur_kit::{ Spans, Text };


entry fn start() {
    let mut t = Text().text("").font_size(14.0);
    let spans = Spans()
        .add("White", 0.0, 0, 0.0, 0)
        .add("Red", 0.0, 0xFF0000FFu64, 0.0, 0)
        .add("Green", 0.0, 0x00FF00FFu64, 0.0, 0);
    t.spans(spans);
    mount(t.build());
}
