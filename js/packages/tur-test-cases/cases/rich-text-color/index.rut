use tur::{ mount };
use tur_kit::{ Spans, Text };


entry fn start() {
    let mut t = Text.new();

    t.text("");
    t.font_size(14.0);
    let mut spans = Spans.new();
    spans.add("White", 0.0, 0, 0.0, 0);
    spans.add("Red", 0.0, 0xFF0000FFu64, 0.0, 0);
    spans.add("Green", 0.0, 0x00FF00FFu64, 0.0, 0);
    t.spans(spans);
    mount(t.build());
}
