// scroll-view-nested: a vertical ScrollView inside a horizontal one. The
// outer sits in a Row — `Expanded` supplies the bounded viewport (non-flex
// flex children get unbounded main-axis constraints, Flutter parity).
use tur::{ AXIS_VERTICAL, CROSS_ALIGN_START, CROSS_ALIGN_STRETCH, mount };
use tur_kit::{ Column, Container, Expanded, Row, ScrollView, SizedBox };


entry fn start() {
    let mut row = Row.new();
    row.child(SizedBox.new(200.0, 0.0).child(Container.new().build()).build());
    let mut outer_content = Column.new();
    outer_content.cross_alignment(CROSS_ALIGN_START);
    outer_content.child(box_h(100.0));
    let mut inner_wrapper = Container.new();
    inner_wrapper.width_height(0.0, 200.0);
    inner_wrapper.query_key("inner-wrapper");
    let mut inner_content = Column.new();
    inner_content.cross_alignment(CROSS_ALIGN_STRETCH);
    inner_content.child(box_h(200.0));
    inner_content.child(box_h(200.0));
    inner_content.child(box_h(200.0));
    let inner = ScrollView.new().axis(AXIS_VERTICAL).child(inner_content.build()).build();
    inner_wrapper.child(inner);
    outer_content.child(inner_wrapper.build());
    outer_content.child(box_h(400.0));
    let mut outer = ScrollView.new().axis(AXIS_VERTICAL).child(outer_content.build()).query_key("outer-scroll").build();
    row.child(Expanded.new().flex(1.0).child(outer).build());
    mount(row.build());
}

fn box_h(h: f64) -> opaque {
    let mut b = Container.new();
    b.width_height(0.0, h);
    return b.build();
}
