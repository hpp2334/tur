// text-max-lines: the long line clipped to two lines.
use tur::{ el_build, el_text_new, text_clip, text_max_lines, text_size, mount };

entry fn start() {
    let t = el_text_new("Hello World this is a long text that should wrap");
    text_size(t, 14.0);
    text_max_lines(t, 2);
    text_clip(t);
    mount(el_build(t));
}
