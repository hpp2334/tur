// switch-demo: a toggle switch authored from the gesture + box rows (the
// Switch widget's corpus twin).
use tur::{ ALIGN_CENTER_LEFT, ALIGN_CENTER_RIGHT, condition, el_box_new, box_align, box_color, box_padding, box_radius, box_size, el_build, el_child, el_column, el_gesture, el_pi, el_qkey, el_sizedbox, el_sizedbox, mount, rs_get_bool, rs_set_bool, rs_source_bool, stf_put, stf_take };

let K_ON: u64 = 1;

entry fn start() -> u64 {
    let on = rs_source_bool(true);
    stf_put(K_ON, on as f64);
    let col = el_column();
    let track = el_box_new();
    box_size(track, 64.0, 32.0);
    box_color(track, 0x22C55EFFu64);
    box_radius(track, 16.0);
    box_padding(track, 4.0);
    el_qkey(track, "switch");
    el_child(track, el_build(thumb(on)));
    el_child(col, el_gesture(on, "b_toggle", "", "", "", "", el_build(track)));
    mount(el_sizedbox(400.0, 200.0, el_build(col)));
    return on;
}

fn thumb(on: u64) -> opaque {
    let knob = el_box_new();
    box_size(knob, 24.0, 24.0);
    box_color(knob, 0xFFFFFFFFu64);
    box_radius(knob, 12.0);
    let side = el_box_new();
    box_size(side, 32.0, 24.0);
    box_align(side, thumb_align());
    el_child(side, el_build(knob));
    return el_build(side);
}

fn thumb_align() -> u64 {
    let on = stf_take(K_ON) as u64;
    stf_put(K_ON, on as f64);
    if (rs_get_bool(on)) {
        return 5;
    }
    return 3;
}

entry fn b_toggle(_a: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {
    let on = stf_take(K_ON) as u64;
    rs_set_bool(on, !rs_get_bool(on));
    stf_put(K_ON, on as f64);
}
