// clickable-text: a PointerInteract wrapping a bound Text — the click
// swaps the atom's content. The handler is a MUTATION over the
// MutationCtx (the triad: source / derive / mutate); the source binds by
// capture — no ids, no stash.
use tur::{ CROSS_ALIGN_START, mount };
use tur_kit::{ Column, MutationCtx, PointerInteract, Readable, Text, mutate, source_str };


entry fn start() -> u64 {
    let content: Readable<str> = source_str("before");
    let b_click = mutate(fn (ctx: MutationCtx) {
        ctx.set<str>(content, "after");
    });
    let col = Column().cross_alignment(CROSS_ALIGN_START);
    let t = Text().text_bound(content).query_key("click-text");
    col.child(PointerInteract().on_click(b_click).child(t.build()).build());
    mount(col.build());
    return content.atom_id();
}
