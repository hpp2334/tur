// text-in-column: two Texts stacked in a start-aligned Column.
use tur::{ CROSS_ALIGN_START, mount };
use tur_kit::{ Column, Text };


entry fn start() {
    let mut col = Column.new();
    col.cross_alignment(CROSS_ALIGN_START);
    let mut first = Text.new();

    first.text("First");
    first.font_size(14.0);
    let mut second = Text.new();

    second.text("Second");
    second.font_size(14.0);
    col.child(first.build());
    col.child(second.build());
    mount(col.build());
}
