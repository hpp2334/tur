// lazy-grid-basic: the boa restyle — 500 labeled hue squares. Hue =
// (i*47) % 360 at 55/50 (the boa hslToHex sextant math), white index
// labels (11px, top-left per the boa tile), max cross 110, default square
// aspect, overscan 1; wheel-scroll mounts only the visible window. The
// boa 4px grid spacing has no lazy-grid row, so each cell pads 2 — the
// between-tile gap re-forms as 2+2 of pane background (the sanctioned
// case-side stand-in; the outer edges sit 2px in where boa's sit flush).
use tur::{ mount, rs_set_f64, rs_source_f64 };
use tur_kit::{ Container, LazyGrid, Text };


fn cell(i: u64) -> opaque {
    let tile = Container()
        .color(hsl_packed(((i * 47) % 360) as f64, 55.0, 50.0))
        .child(Text().text(f"{i}").font_size(11.0).color(0xFFFFFFFFu64).build())
        .build();
    return Container().padding(2.0).child(tile).build();
}

entry fn start() {
    let count = rs_source_f64();
    rs_set_f64(count, 500.0);
    let grid = LazyGrid()
        .item_builder(cell)
        .count(count)
        .max_cross(110.0)
        .aspect(1.0)
        .overscan(1)
        .query_key("lazy-grid-basic")
        .build();
    mount(grid);
}

// ---- the tile ramp ------------------------------------------------------------

// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).
fn hsl_packed(h: f64, s: f64, l: f64) -> u64 {
    let sat: f64 = s / 100.0;
    let light: f64 = l / 100.0;
    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;
    let hue: f64 = h % 360.0;
    let hp: f64 = hue / 60.0;
    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));
    let mut r1: f64 = 0.0;
    let mut g1: f64 = 0.0;
    let mut b1: f64 = 0.0;
    if (hp < 1.0) {
        r1 = c;
        g1 = x;
    } else if (hp < 2.0) {
        r1 = x;
        g1 = c;
    } else if (hp < 3.0) {
        g1 = c;
        b1 = x;
    } else if (hp < 4.0) {
        g1 = x;
        b1 = c;
    } else if (hp < 5.0) {
        r1 = x;
        b1 = c;
    } else {
        r1 = c;
        b1 = x;
    }
    let m: f64 = light - c / 2.0;
    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;
    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;
    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;
    return r * 16777216 + g * 65536 + b * 256 + 255;
}

fn abs_f(v: f64) -> f64 {
    if (v < 0.0) {
        return -v;
    }
    return v;
}
