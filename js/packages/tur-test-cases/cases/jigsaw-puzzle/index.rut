// jigsaw-puzzle: the drag-a-tile board (the regression fixture family the
// drag-with-lift / drag-redrag-multi tests pin, as a playable board).
use tur::{ ALIGN_TOP_LEFT, el_box_new, box_color, box_size, el_build, el_child, el_gesture2, el_positioned, el_qkey, el_sizedbox, el_stack, el_text_new, mount, rs_set_f64, rs_source_f64, rs_source_str, stack_align, stf_put, stf_take };

let K_X: u64 = 1;
let K_Y: u64 = 2;
let K_PIECE: u64 = 3;

entry fn start() -> u64 {
    let x = rs_source_f64();
    let y = rs_source_f64();
    stf_put(K_X, x as f64);
    stf_put(K_Y, y as f64);
    let piece = rs_source_str("A");
    stf_put(K_PIECE, piece as f64);

    let stack = el_stack();
    stack_align(stack, ALIGN_TOP_LEFT);
    el_child(stack, el_sizedbox(300.0, 300.0, el_build(el_box_new())));
    let b = el_box_new();
    box_size(b, 80.0, 80.0);
    box_color(b, 0x6366F1FFu64);
    el_qkey(b, "piece");
    let label = el_text_new("A");
    el_child(b, el_build(label));
    let pad = el_gesture2(piece, piece, "g_down", "g_down", "g_move", "g_up", "", el_build(b));
    let pos = el_positioned(10.0, 10.0, pad);
    el_child(stack, pos);
    mount(el_build(stack));
    return piece;
}

entry fn g_down(piece: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {
    rs_set_str(piece, "dragging");
}

entry fn g_move(piece: u64, _id: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {
    let x = stf_take(K_X) as u64;
    let y = stf_take(K_Y) as u64;
    rs_set_f64(x, gx - 40.0);
    rs_set_f64(y, gy - 40.0);
    stf_put(K_X, x as f64);
    stf_put(K_Y, y as f64);
}

entry fn g_up(piece: u64, _id: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {
    rs_set_str(piece, "A");
}
