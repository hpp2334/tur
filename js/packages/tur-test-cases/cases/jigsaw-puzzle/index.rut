// jigsaw-puzzle: the full 3×3 drag-and-drop game (the Phase-9 rewrite of
// the Phase-4 fixture case, ported from the boa reference design).
//
//   * Nine colored pieces start in the tray below the board (id order),
//     each targeting a SHUFFLED slot on the 3×3 board — the piece's label
//     names its target ("3" → slot 3's ghost).
//   * Drag a piece onto its slot: drop within SNAP_T of the target and it
//     SNAPS + locks (dim fill, own-hue GLOW shadow, stops answering
//     grabs); the "N / 9 placed" derive badge counts it; at 9 / 9 the
//     centered "Solved!" overlay flips on over a full-viewer scrim (the
//     fill rides a Positioned four-edge child in the root stack — the
//     Condition lives INSIDE it so the stretch sizes against the stack).
//   * Game feel (the boa lift): grabbing a piece eases it up to LIFT_MAX
//     (1.1) over 180ms (one shared easeOut controller; the tick writes
//     the dragged piece's bound scale atom, the just-released piece
//     settles back) and every piece carries a STATE SHADOW through the
//     bound shadow rows: loose black soft → dragging hard → placed hue
//     glow. Shuffle re-shuffles the targets and re-deals the tray.
//
// Mechanics (the rails this case rides — no engine code was touched):
//   * Each piece is a `Positioned` whose left/top are the Phase-6 BOUND
//     anchors (`left_bound` / `top_bound`) over per-piece f64 atoms —
//     dragging writes the atoms, the Stack re-lays-out, the piece follows.
//   * One `PointerInteract` per piece with `.ids(i, i)` — the piece index
//     rides the two-id rail into SHARED callbacks (no per-piece closures);
//     atoms and scratch state cross through the stash slots.
//   * Piece labels are bound str atoms (re-set by deal()); the placed
//     badge is the one derive (over the count atom). Everything mutates
//     through atoms — the whole tree is ONE chained build (the kit law).
//   * Drag deltas are frame-formulated (x0 + (gx - g0x)) — absolute, no
//     read-modify-write drift, frame-independent of the stack's offset.
//   * Not `Each`: the 9 pieces mount ONCE (a rebuild per move event would
//     drop pointer capture mid-drag).
use tur::{
    ALIGN_CENTER, ALIGN_TOP_LEFT, BORDER_INSIDE, CROSS_ALIGN_CENTER, CURSOR_POINTER,
    MAIN_ALIGN_SPACE_BETWEEN, STACK_FIT_EXPAND, anim_forward, anim_reverse, mount, rs_get_f64,
    rs_set_bool, rs_set_brush, rs_set_f64, rs_set_str, rs_source_bool, rs_source_f64,
    rs_source_str, rs_source_value, st_put, st_take, stf_put, stf_take, rs_list_new,
};
use tur_kit::{
    Condition, Container, MouseRegion, PointerInteract, Positioned, Row, SizedBox, Stack, Text,
    rs_derive,
};
use tur_anim_kit::{ Transform, anim_ctrl };

// ---- the boa geometry --------------------------------------------------------

let CELL: f64 = 60.0;
let GAP_HALF: f64 = 2.0; // GAP / 2 — each piece insets 2px inside its cell
let PIECE: f64 = 56.0; // CELL - GAP
let BOARD_W: f64 = 180.0; // 3 * CELL
let BOARD_X: f64 = 100.0;
let BOARD_Y: f64 = 60.0;
let TRAY_X: f64 = 100.0;
let TRAY_Y: f64 = 300.0; // BOARD_Y + BOARD_W + 60
let SNAP_T: f64 = 28.0;
let SNAP_T2: f64 = 784.0; // SNAP_T squared (distances compare squared)
let PLAY_W: f64 = 380.0;
let PLAY_H: f64 = 520.0; // TRAY_Y + BOARD_W + 40

// The boa palette: hue = (slot * 47) % 360 — bright while loose, dim once
// placed (s 60→35, l 55→42).
let BRI0: u64 = 0xD14747FFu64;
let BRI1: u64 = 0xD1B347FFu64;
let BRI2: u64 = 0x83D147FFu64;
let BRI3: u64 = 0x47D178FFu64;
let BRI4: u64 = 0x47BFD1FFu64;
let BRI5: u64 = 0x4753D1FFu64;
let BRI6: u64 = 0xA847D1FFu64;
let BRI7: u64 = 0xD1478FFFu64;
let BRI8: u64 = 0xD16C47FFu64;
let DIM0: u64 = 0x914646FFu64;
let DIM1: u64 = 0x918046FFu64;
let DIM2: u64 = 0x669146FFu64;
let DIM3: u64 = 0x469160FFu64;
let DIM4: u64 = 0x468791FFu64;
let DIM5: u64 = 0x464C91FFu64;
let DIM6: u64 = 0x7A4691FFu64;
let DIM7: u64 = 0x91466CFFu64;
let DIM8: u64 = 0x915A46FFu64;

// The placed-piece GLOW: the slot's bright hue at alpha 140 (the boa
// pieceRgb shadow — the resolved look). Loose pieces carry the black soft
// shadow, dragged pieces the hard one.
let GLOW0: u64 = 0xD147478Cu64;
let GLOW1: u64 = 0xD1B3478Cu64;
let GLOW2: u64 = 0x83D1478Cu64;
let GLOW3: u64 = 0x47D1788Cu64;
let GLOW4: u64 = 0x47BFD18Cu64;
let GLOW5: u64 = 0x4753D18Cu64;
let GLOW6: u64 = 0xA847D18Cu64;
let GLOW7: u64 = 0xD1478F8Cu64;
let GLOW8: u64 = 0xD16C478Cu64;
let SHADOW_LOOSE: u64 = 0x0000006Eu64; // black @110
let SHADOW_DRAG: u64 = 0x000000B4u64; // black @180
let LIFT_MAX: f64 = 1.1;

// ---- stash slots (the case's side channel — atoms + scratch) ------------------

let K_SEED: u64 = 1; // the LCG state
let K_DRAG: u64 = 2; // the dragged piece id (-1 = none)
let K_GX0: u64 = 3; // grab point (global)
let K_GY0: u64 = 4;
let K_LAST: u64 = 5; // the just-released piece (the settle keeps animating it)
let K_LIFT: u64 = 6; // the shared lift controller
let K_LIFTV: u64 = 7; // the lift progress atom
let K_X0: u64 = 8; // the piece's position at grab
let K_Y0: u64 = 9;
let K_COUNT: u64 = 10; // placed count (f64 atom — the badge derive's dep)
let K_SOLVED: u64 = 11; // the win banner's bool atom
let K_PX0: u64 = 20; // piece i left atom (20..29)
let K_PY0: u64 = 30; // piece i top atom (30..39)
let K_SL0: u64 = 40; // piece i target slot atom (40..49 — read by the snap math)
let K_BR0: u64 = 50; // piece i brush atom (50..59)
let K_LB0: u64 = 60; // piece i label str atom (60..69)
let K_OK0: u64 = 70; // piece i placed flag (70..79)
let K_DK0: u64 = 80; // the deal deck (80..89)
let K_SC0: u64 = 100; // piece i shadow COLOR atom (100..109)
let K_SB0: u64 = 110; // piece i shadow BLUR atom (110..119)
let K_SD0: u64 = 120; // piece i shadow DY atom (120..129)
let K_SX0: u64 = 130; // piece i LIFT SCALE atom (130..139)
let K_TMP: u64 = 90;

entry fn start() -> u64 {
    // Per-piece atoms: left/top (the drag rail), the target slot (read by
    // the snap math), a brush (re-set bright/dim on deal/place), the label
    // str (re-set by deal()), the shadow channels (color/blur/dy — the
    // state shadow) and the lift scale.
    let mut i: u64 = 0;
    while (i < 9) {
        let px = rs_source_f64();
        let py = rs_source_f64();
        let sl = rs_source_f64();
        let br = rs_source_value(rs_list_new());
        let lb = rs_source_str("?");
        let sc = rs_source_value(rs_list_new());
        let sb = rs_source_f64();
        let sd = rs_source_f64();
        let sx = rs_source_f64();
        stf_put(K_PX0 + i, px as f64);
        stf_put(K_PY0 + i, py as f64);
        stf_put(K_SL0 + i, sl as f64);
        stf_put(K_BR0 + i, br as f64);
        stf_put(K_LB0 + i, lb as f64);
        stf_put(K_OK0 + i, 0.0);
        stf_put(K_SC0 + i, sc as f64);
        stf_put(K_SB0 + i, sb as f64);
        stf_put(K_SD0 + i, sd as f64);
        stf_put(K_SX0 + i, sx as f64);
        i = i + 1;
    }
    stf_put(K_COUNT, rs_source_f64() as f64);
    stf_put(K_SOLVED, rs_source_bool(false) as f64);
    stf_put(K_SEED, 20261006.0);
    stf_put(K_DRAG, -1.0);
    stf_put(K_LAST, -1.0);
    stf_put(K_TMP, 0.0);

    // The shared lift controller (the boa dragScale$): one 180ms easeOut
    // ease over the K_LIFTV atom; the tick routes the eased value into the
    // dragged / just-released piece's bound scale atom.
    let liftv = rs_source_f64();
    rs_set_f64(liftv, 0.0);
    stf_put(K_LIFTV, liftv as f64);
    let lift = anim_ctrl(liftv, 180.0, "easeOut", 1, lift_tick, lift_end);
    st_put(K_LIFT, lift);

    deal();

    // ---- the play area (board + ghosts + tray + pieces + bar) ----

    let play = Stack()
        .alignment(ALIGN_TOP_LEFT)
        .child(SizedBox(PLAY_W, PLAY_H).build())
        .child(board_bg())
        .children([ghost(0), ghost(1), ghost(2), ghost(3), ghost(4), ghost(5), ghost(6), ghost(7), ghost(8)])
        .child(tray_bg())
        .children([piece(0), piece(1), piece(2), piece(3), piece(4), piece(5), piece(6), piece(7), piece(8)])
        .child(top_bar())
        .build();

    // The win overlay: the four-edge Positioned is a DIRECT stack child so
    // the stretch sizes against the stack; the Condition lives inside it
    // (the audit caught the Condition-wrapped Positioned collapsing to the
    // banner's natural size at the top-left).
    let win = Positioned()
        .left(0.0)
        .top(0.0)
        .right(0.0)
        .bottom(0.0)
        .child(
            Condition(peek(K_SOLVED) as u64)
                .then_build(win_banner)
                .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })
                .build(),
        )
        .build();

    // ---- the root (full-bleed dark, the play area centered, the overlay) ----

    mount(
        Stack()
            .fit(STACK_FIT_EXPAND)
            .child(Container().color(0x020617FFu64).build())
            .child(Container().alignment(ALIGN_CENTER).child(play).build())
            .child(win)
            .build(),
    );
    return peek(K_COUNT) as u64;
}

// ---- the deal (boot + Shuffle share it) ----------------------------------------

// Re-shuffle the targets, re-deal the pieces to the tray in id order, and
// reset every placed/counter/solved atom. The deck lives in stash cells
// (rut arrays are immutable); Fisher-Yates over the LCG below.
fn deal() {
    let mut i: u64 = 0;
    while (i < 9) {
        stf_put(K_DK0 + i, i as f64);
        i = i + 1;
    }
    let mut j: u64 = 0;
    while (j < 8) {
        let k = j + (rnd() as u64 % (9 - j));
        let a = peek(K_DK0 + j);
        let b = peek(K_DK0 + k);
        stf_put(K_DK0 + j, b);
        stf_put(K_DK0 + k, a);
        j = j + 1;
    }
    let mut p: u64 = 0;
    while (p < 9) {
        let s = peek(K_DK0 + p) as u64;
        rs_set_f64(peek(K_SL0 + p) as u64, s as f64);
        rs_set_str(peek(K_LB0 + p) as u64, fmt_slot(s as f64));
        rs_set_brush(peek(K_BR0 + p) as u64, bright(s));
        rs_set_f64(peek(K_PX0 + p) as u64, tray_x(p));
        rs_set_f64(peek(K_PY0 + p) as u64, tray_y(p));
        stf_put(K_OK0 + p, 0.0);
        // The state shadow resets to loose; the lift scale to 1.
        rs_set_brush(peek(K_SC0 + p) as u64, SHADOW_LOOSE);
        rs_set_f64(peek(K_SB0 + p) as u64, 10.0);
        rs_set_f64(peek(K_SD0 + p) as u64, 4.0);
        rs_set_f64(peek(K_SX0 + p) as u64, 1.0);
        p = p + 1;
    }
    rs_set_f64(peek(K_COUNT) as u64, 0.0);
    rs_set_bool(peek(K_SOLVED) as u64, false);
    stf_put(K_DRAG, -1.0);
    stf_put(K_LAST, -1.0);
}

// Park-Miller in f64 (48271 × 2^31 < 2^53 — exact). Fixed boot seed: deals
// are deterministic per session, shuffles advance the state.
fn rnd() -> f64 {
    let s = stf_take(K_SEED);
    let n = (s * 48271.0) % 2147483647.0;
    stf_put(K_SEED, n);
    return n;
}

// Read a stash slot without consuming it.
fn peek(slot: u64) -> f64 {
    let v = stf_take(slot);
    stf_put(slot, v);
    return v;
}

// ---- the geometry ---------------------------------------------------------------

fn slot_x(s: u64) -> f64 {
    return BOARD_X + (s % 3) as f64 * CELL + GAP_HALF;
}

fn slot_y(s: u64) -> f64 {
    return BOARD_Y + (s / 3) as f64 * CELL + GAP_HALF;
}

fn tray_x(i: u64) -> f64 {
    return TRAY_X + (i % 3) as f64 * CELL + GAP_HALF;
}

fn tray_y(i: u64) -> f64 {
    return TRAY_Y + (i / 3) as f64 * CELL + GAP_HALF;
}

fn bright(s: u64) -> u64 {
    if (s == 0) { return BRI0; }
    if (s == 1) { return BRI1; }
    if (s == 2) { return BRI2; }
    if (s == 3) { return BRI3; }
    if (s == 4) { return BRI4; }
    if (s == 5) { return BRI5; }
    if (s == 6) { return BRI6; }
    if (s == 7) { return BRI7; }
    return BRI8;
}

// The placed glow: the slot's bright hue at alpha 140.
fn glow(s: u64) -> u64 {
    if (s == 0) { return GLOW0; }
    if (s == 1) { return GLOW1; }
    if (s == 2) { return GLOW2; }
    if (s == 3) { return GLOW3; }
    if (s == 4) { return GLOW4; }
    if (s == 5) { return GLOW5; }
    if (s == 6) { return GLOW6; }
    if (s == 7) { return GLOW7; }
    return GLOW8;
}

fn dim(s: u64) -> u64 {
    if (s == 0) { return DIM0; }
    if (s == 1) { return DIM1; }
    if (s == 2) { return DIM2; }
    if (s == 3) { return DIM3; }
    if (s == 4) { return DIM4; }
    if (s == 5) { return DIM5; }
    if (s == 6) { return DIM6; }
    if (s == 7) { return DIM7; }
    return DIM8;
}

// ---- the drag state machine (shared across all 9 pieces — `.ids(i, i)`) --------

fn p_down(i: u64, _b: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {
    let ok = stf_take(K_OK0 + i);
    if (ok > 0.5) {
        stf_put(K_OK0 + i, ok);
        return;
    }
    stf_put(K_OK0 + i, ok);
    // A new grab interrupts the previous settle — park that piece at rest.
    let prev_last = peek(K_LAST);
    if (prev_last >= 0.0 && prev_last != i as f64) {
        rs_set_f64(peek(K_SX0 + prev_last as u64) as u64, 1.0);
    }
    stf_put(K_DRAG, i as f64);
    stf_put(K_LAST, i as f64);
    stf_put(K_GX0, gx);
    stf_put(K_GY0, gy);
    stf_put(K_X0, rs_get_f64(peek(K_PX0 + i) as u64));
    stf_put(K_Y0, rs_get_f64(peek(K_PY0 + i) as u64));
    // The lift: ease up to LIFT_MAX; the shadow hardens.
    let lift = st_take(K_LIFT);
    anim_forward(lift);
    st_put(K_LIFT, lift);
    rs_set_brush(peek(K_SC0 + i) as u64, SHADOW_DRAG);
    rs_set_f64(peek(K_SB0 + i) as u64, 28.0);
    rs_set_f64(peek(K_SD0 + i) as u64, 12.0);
}

fn p_move(i: u64, _b: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {
    if (peek(K_DRAG) != i as f64) {
        return;
    }
    let nx = peek(K_X0) + (gx - peek(K_GX0));
    let ny = peek(K_Y0) + (gy - peek(K_GY0));
    rs_set_f64(peek(K_PX0 + i) as u64, nx);
    rs_set_f64(peek(K_PY0 + i) as u64, ny);
}

fn p_up(i: u64, _b: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {
    if (peek(K_DRAG) != i as f64) {
        return;
    }
    stf_put(K_DRAG, -1.0);
    let nx = rs_get_f64(peek(K_PX0 + i) as u64);
    let ny = rs_get_f64(peek(K_PY0 + i) as u64);
    let s = rs_get_f64(peek(K_SL0 + i) as u64) as u64;
    let tx = slot_x(s);
    let ty = slot_y(s);
    let d2 = (nx - tx) * (nx - tx) + (ny - ty) * (ny - ty);
    if (d2 >= SNAP_T2) {
        // Off-target: back to the loose shadow; the piece settles at rest.
        rs_set_brush(peek(K_SC0 + i) as u64, SHADOW_LOOSE);
        rs_set_f64(peek(K_SB0 + i) as u64, 10.0);
        rs_set_f64(peek(K_SD0 + i) as u64, 4.0);
        let lift = st_take(K_LIFT);
        anim_reverse(lift);
        st_put(K_LIFT, lift);
        return; // the piece stays where it was dropped
    }
    // Snap + lock: pin to the slot, dim the fill, swap in the OWN-HUE GLOW
    // (the boa pieceRgb shadow — the resolved look), count it, maybe solve.
    rs_set_f64(peek(K_PX0 + i) as u64, tx);
    rs_set_f64(peek(K_PY0 + i) as u64, ty);
    stf_put(K_OK0 + i, 1.0);
    rs_set_brush(peek(K_BR0 + i) as u64, dim(s));
    rs_set_brush(peek(K_SC0 + i) as u64, glow(s));
    rs_set_f64(peek(K_SB0 + i) as u64, 18.0);
    rs_set_f64(peek(K_SD0 + i) as u64, 4.0);
    let count = rs_get_f64(peek(K_COUNT) as u64) + 1.0;
    rs_set_f64(peek(K_COUNT) as u64, count);
    if (count >= 9.0) {
        rs_set_bool(peek(K_SOLVED) as u64, true);
    }
    let lift = st_take(K_LIFT);
    anim_reverse(lift);
    st_put(K_LIFT, lift);
}

// The lift tick: the eased 0..1 maps to 1..LIFT_MAX and rides the
// dragged AND just-released pieces' bound scale atoms (the boa gate:
// dragId == id || lastDragId == id reads the shared dragScale$).
fn lift_tick(_id: u64, v: f64) {
    let scale: f64 = 1.0 + v * (LIFT_MAX - 1.0);
    let drag = peek(K_DRAG);
    let last = peek(K_LAST);
    if (drag >= 0.0) {
        rs_set_f64(peek(K_SX0 + drag as u64) as u64, scale);
    }
    if (last >= 0.0 && last != drag) {
        rs_set_f64(peek(K_SX0 + last as u64) as u64, scale);
    }
}

// The settle end: the released piece rests at exactly 1.0.
fn lift_end(_id: u64, _v: f64) {
    let last = peek(K_LAST);
    if (last >= 0.0) {
        rs_set_f64(peek(K_SX0 + last as u64) as u64, 1.0);
    }
}

// Shuffle tap: re-deal (deal() resets every game atom; the derives follow).
fn b_shuffle(_a: u64, _b: u64, _n: f64) {
    deal();
}

// ---- the label formats ------------------------------------------------------------

// The piece label: its target slot, 1-based (crossed to the ghost's static
// text too; deal() re-sets the bound labels on every re-deal).
fn fmt_slot(v: f64) -> str {
    let n = v as u64 + 1;
    return f"{n}";
}

// The badge: "N / 9 placed" — the one derive, over the count atom.
fn fmt_count(v: f64) -> str {
    let n = v as u64;
    return f"{n} / 9 placed";
}

// ---- the view helpers --------------------------------------------------------------

fn piece(i: u64) -> View {
    let face = Container()
        .width_height(PIECE, PIECE)
        .color_bound(peek(K_BR0 + i) as u64)
        .radius(14.0)
        .border(0xFFFFFFFFu64, 2.0, BORDER_INSIDE)
        .shadow_color_bound(peek(K_SC0 + i) as u64)
        .shadow_blur_bound(peek(K_SB0 + i) as u64)
        .shadow_dy_bound(peek(K_SD0 + i) as u64)
        .alignment(ALIGN_CENTER)
        .query_key(f"jw/piece-{i}")
        .child(
            Text()
                .text_bound(peek(K_LB0 + i) as u64)
                .font_size(28.0)
                .color(0xFFFFFFFFu64)
                .query_key(f"jw/piece-{i}-label")
                .build(),
        )
        .build();
    let pad = PointerInteract()
        .ids(i, i)
        .on_down2(p_down)
        .on_move2(p_move)
        .on_up2(p_up)
        .query_key(f"jw/pad-{i}")
        .child(face)
        .build();
    // The boa lift: the pad rides a Transform whose scale is the piece's
    // bound atom (the shared controller eases it 1 → 1.1 on grab, back on
    // release).
    return Positioned()
        .left_bound(peek(K_PX0 + i) as u64)
        .top_bound(peek(K_PY0 + i) as u64)
        .width(PIECE)
        .height(PIECE)
        .child(
            Transform(1.0, 0.0, 0.0, 0.0)
                .scale_bound(peek(K_SX0 + i) as u64)
                .child(pad)
                .build(),
        )
        .build();
}

fn ghost(s: u64) -> View {
    return Positioned()
        .left(slot_x(s))
        .top(slot_y(s))
        .width(PIECE)
        .height(PIECE)
        .child(
            Container()
                .width_height(PIECE, PIECE)
                .color(0x1E293BFFu64)
                .border(0x475569FFu64, 1.0, BORDER_INSIDE)
                .radius(12.0)
                .alignment(ALIGN_CENTER)
                .query_key(f"jw/ghost-{s}")
                .child(
                    Text()
                        .text(fmt_slot(s as f64))
                        .font_size(18.0)
                        .color(0x64748BFFu64)
                        .query_key(f"jw/ghost-{s}-num")
                        .build(),
                )
                .build(),
        )
        .build();
}

fn board_bg() -> View {
    let w = BOARD_W + 4.0;
    return Positioned()
        .left(BOARD_X - 2.0)
        .top(BOARD_Y - 2.0)
        .width(w)
        .height(w)
        .child(
            Container()
                .width_height(w, w)
                .color(0x0F172AFFu64)
                .border(0x3B82F6FFu64, 2.0, BORDER_INSIDE)
                .radius(16.0)
                .shadow(0x3B82F628u64, 18.0, 0.0, 0.0)
                .build(),
        )
        .build();
}

fn tray_bg() -> View {
    let w = BOARD_W + 4.0;
    return Positioned()
        .left(TRAY_X - 2.0)
        .top(TRAY_Y - 2.0)
        .width(w)
        .height(w)
        .child(
            Container()
                .width_height(w, w)
                .color(0x0A0F1DFFu64)
                .border(0x334155FFu64, 1.0, BORDER_INSIDE)
                .radius(16.0)
                .build(),
        )
        .build();
}

fn top_bar() -> View {
    let pill = Container()
        .padding(10.0)
        .radius(20.0)
        .color(0x4F46E5FFu64)
        .border(0x818CF8FFu64, 1.0, BORDER_INSIDE)
        .shadow(0x4F46E578u64, 12.0, 0.0, 4.0)
        .child(
            Text()
                .text("Shuffle")
                .font_size(13.0)
                .color(0xFFFFFFFFu64)
                .build(),
        )
        .build();
    let chip = Container()
        .padding(10.0)
        .radius(8.0)
        .color(0x1E293BFFu64)
        .border(0x334155FFu64, 1.0, BORDER_INSIDE)
        .child(
            Text()
                .text_bound_derived(rs_derive(fmt_count, peek(K_COUNT) as u64))
                .font_size(14.0)
                .color(0xE2E8F0FFu64)
                .query_key("jw/counter")
                .build(),
        )
        .build();
    return Positioned()
        .left(12.0)
        .right(12.0)
        .top(12.0)
        .child(
            Row()
                .main_alignment(MAIN_ALIGN_SPACE_BETWEEN)
                .cross_alignment(CROSS_ALIGN_CENTER)
                .child(
                    MouseRegion()
                        .cursor(CURSOR_POINTER)
                        .child(
                            PointerInteract()
                                .on_tap(b_shuffle)
                                .query_key("jw/shuffle")
                                .child(pill)
                                .build(),
                        )
                        .build(),
                )
                .child(chip)
                .build(),
        )
        .build();
}

fn win_banner() -> View {
    return Positioned()
        .left(0.0)
        .top(0.0)
        .right(0.0)
        .bottom(0.0)
        .child(
            Container()
                .color(0x020617C8u64)
                .alignment(ALIGN_CENTER)
                .child(
                    Container()
                        .padding(24.0)
                        .radius(18.0)
                        .color(0x4F46E5FFu64)
                        .border(0x818CF8FFu64, 2.0, BORDER_INSIDE)
                        .shadow(0x4F46E5B4u64, 32.0, 0.0, 8.0)
                        .query_key("jw/banner")
                        .child(
                            Text()
                                .text("Solved!")
                                .font_size(36.0)
                                .color(0xFFFFFFFFu64)
                                .build(),
                        )
                        .build(),
                )
                .build(),
        )
        .build();
}
