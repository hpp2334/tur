// jigsaw-puzzle: the full 3×3 drag-and-drop game (the Phase-9 rewrite of
// the Phase-4 fixture case, ported from the boa reference design).
//
//   * Nine colored pieces start in the tray below the board (id order),
//     each targeting a SHUFFLED slot on the 3×3 board — the piece's label
//     names its target ("3" → slot 3's ghost).
//   * Drag a piece onto its slot: drop within SNAP_T of the target and it
//     SNAPS + locks (dim color, stops answering grabs); the "N / 9 placed"
//     derive badge counts it; at 9 / 9 the Solved! overlay flips on.
//   * A cyan snap highlight (a Condition branch, rebuilt on each drag
//     activation) appears while the dragged piece sits within threshold of
//     its target. Shuffle re-shuffles the targets and re-deals the tray.
//
// Mechanics (the rails this case rides — no engine code was touched):
//   * Each piece is a `Positioned` whose left/top are the Phase-6 BOUND
//     anchors (`left_bound` / `top_bound`) over per-piece f64 atoms —
//     dragging writes the atoms, the Stack re-lays-out, the piece follows.
//   * One `PointerInteract` per piece with `.ids(i, i)` — the piece index
//     rides the two-id rail into SHARED callbacks (no per-piece closures);
//     atoms and scratch state cross through the stash slots.
//   * Piece labels are bound str atoms (re-set by deal()); the placed
//     badge is the one derive (over the count atom); placed pieces re-brush
//     dim through their brush atoms. Everything mutates through atoms —
//     the whole tree is ONE chained build (the kit law).
//   * Drag deltas are frame-formulated (x0 + (gx - g0x)) — absolute, no
//     read-modify-write drift, frame-independent of the stack's offset.
//   * Not `Each`: the 9 pieces mount ONCE (a rebuild per move event would
//     drop pointer capture mid-drag).
use tur::{
    ALIGN_CENTER, ALIGN_TOP_LEFT, BORDER_INSIDE, CROSS_ALIGN_CENTER, CURSOR_POINTER,
    MAIN_ALIGN_SPACE_BETWEEN, STACK_FIT_EXPAND, mount, rs_get_f64, rs_list_new, rs_set_bool,
    rs_set_brush, rs_set_f64, rs_set_str, rs_source_bool, rs_source_f64, rs_source_str,
    rs_source_value, stf_put, stf_take,
};
use tur_kit::{
    Condition, Container, MouseRegion, PointerInteract, Positioned, Row, SizedBox, Stack, Text,
    rs_derive,
};

// ---- the boa geometry --------------------------------------------------------

let CELL: f64 = 60.0;
let GAP_HALF: f64 = 2.0; // GAP / 2 — each piece insets 2px inside its cell
let PIECE: f64 = 56.0; // CELL - GAP
let BOARD_W: f64 = 180.0; // 3 * CELL
let BOARD_X: f64 = 100.0;
let BOARD_Y: f64 = 60.0;
let TRAY_X: f64 = 100.0;
let TRAY_Y: f64 = 300.0; // BOARD_Y + BOARD_W + 60
let SNAP_T: f64 = 28.0;
let SNAP_T2: f64 = 784.0; // SNAP_T squared (distances compare squared)
let PLAY_W: f64 = 380.0;
let PLAY_H: f64 = 520.0; // TRAY_Y + BOARD_W + 40

// The boa palette: hue = (slot * 47) % 360 — bright while loose, dim once
// placed (s 60→35, l 55→42).
let BRI0: u64 = 0xD14747FFu64;
let BRI1: u64 = 0xD1B347FFu64;
let BRI2: u64 = 0x83D147FFu64;
let BRI3: u64 = 0x47D178FFu64;
let BRI4: u64 = 0x47BFD1FFu64;
let BRI5: u64 = 0x4753D1FFu64;
let BRI6: u64 = 0xA847D1FFu64;
let BRI7: u64 = 0xD1478FFFu64;
let BRI8: u64 = 0xD16C47FFu64;
let DIM0: u64 = 0x914646FFu64;
let DIM1: u64 = 0x918046FFu64;
let DIM2: u64 = 0x669146FFu64;
let DIM3: u64 = 0x469160FFu64;
let DIM4: u64 = 0x468791FFu64;
let DIM5: u64 = 0x464C91FFu64;
let DIM6: u64 = 0x7A4691FFu64;
let DIM7: u64 = 0x91466CFFu64;
let DIM8: u64 = 0x915A46FFu64;

// ---- stash slots (the case's side channel — atoms + scratch) ------------------

let K_SEED: u64 = 1; // the LCG state
let K_DRAG: u64 = 2; // the dragged piece id (-1 = none)
let K_GX0: u64 = 3; // grab point (global)
let K_GY0: u64 = 4;
let K_X0: u64 = 5; // the piece's position at grab
let K_Y0: u64 = 6;
let K_HLX: u64 = 7; // snap-highlight left atom
let K_HLY: u64 = 8; // snap-highlight top atom
let K_SNAP: u64 = 9; // snap-highlight visibility (bool atom)
let K_COUNT: u64 = 10; // placed count (f64 atom — the badge derive's dep)
let K_SOLVED: u64 = 11; // the win banner's bool atom
let K_PX0: u64 = 20; // piece i left atom (20..29)
let K_PY0: u64 = 30; // piece i top atom (30..39)
let K_SL0: u64 = 40; // piece i target slot atom (40..49 — read by the snap math)
let K_BR0: u64 = 50; // piece i brush atom (50..59)
let K_LB0: u64 = 60; // piece i label str atom (60..69)
let K_OK0: u64 = 70; // piece i placed flag (70..79)
let K_DK0: u64 = 80; // the deal deck (80..89)
let K_TMP: u64 = 90;

entry fn start() -> u64 {
    // Per-piece atoms: left/top (the drag rail), the target slot (read by
    // the snap math), a brush (re-set bright/dim on deal/place), and the
    // label str (re-set by deal()).
    let mut i: u64 = 0;
    while (i < 9) {
        let px = rs_source_f64();
        let py = rs_source_f64();
        let sl = rs_source_f64();
        let br = rs_source_value(rs_list_new());
        let lb = rs_source_str("?");
        stf_put(K_PX0 + i, px as f64);
        stf_put(K_PY0 + i, py as f64);
        stf_put(K_SL0 + i, sl as f64);
        stf_put(K_BR0 + i, br as f64);
        stf_put(K_LB0 + i, lb as f64);
        stf_put(K_OK0 + i, 0.0);
        i = i + 1;
    }
    stf_put(K_HLX, rs_source_f64() as f64);
    stf_put(K_HLY, rs_source_f64() as f64);
    stf_put(K_SNAP, rs_source_bool(false) as f64);
    stf_put(K_COUNT, rs_source_f64() as f64);
    stf_put(K_SOLVED, rs_source_bool(false) as f64);
    stf_put(K_SEED, 20261006.0);
    stf_put(K_DRAG, -1.0);
    stf_put(K_TMP, 0.0);

    deal();

    // ---- the play area (board + ghosts + tray + highlight + pieces + bar) ----

    let snap_hl = Condition(peek(K_SNAP) as u64)
        .then_build(fn () -> View {
            return Positioned()
                .left_bound(peek(K_HLX) as u64)
                .top_bound(peek(K_HLY) as u64)
                .width(PIECE)
                .height(PIECE)
                .child(snap_hl_face())
                .build();
        })
        .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })
        .build();

    let play = Stack()
        .alignment(ALIGN_TOP_LEFT)
        .child(SizedBox(PLAY_W, PLAY_H).build())
        .child(board_bg())
        .children([ghost(0), ghost(1), ghost(2), ghost(3), ghost(4), ghost(5), ghost(6), ghost(7), ghost(8)])
        .child(tray_bg())
        .child(snap_hl)
        .children([piece(0), piece(1), piece(2), piece(3), piece(4), piece(5), piece(6), piece(7), piece(8)])
        .child(top_bar())
        .build();

    let win = Condition(peek(K_SOLVED) as u64)
        .then_build(win_banner)
        .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })
        .build();

    // ---- the root (full-bleed dark, the play area centered, the overlay) ----

    mount(
        Stack()
            .fit(STACK_FIT_EXPAND)
            .child(Container().color(0x020617FFu64).build())
            .child(Container().alignment(ALIGN_CENTER).child(play).build())
            .child(win)
            .build(),
    );
    return peek(K_COUNT) as u64;
}

// ---- the deal (boot + Shuffle share it) ----------------------------------------

// Re-shuffle the targets, re-deal the pieces to the tray in id order, and
// reset every placed/counter/solved atom. The deck lives in stash cells
// (rut arrays are immutable); Fisher-Yates over the LCG below.
fn deal() {
    let mut i: u64 = 0;
    while (i < 9) {
        stf_put(K_DK0 + i, i as f64);
        i = i + 1;
    }
    let mut j: u64 = 0;
    while (j < 8) {
        let k = j + (rnd() as u64 % (9 - j));
        let a = peek(K_DK0 + j);
        let b = peek(K_DK0 + k);
        stf_put(K_DK0 + j, b);
        stf_put(K_DK0 + k, a);
        j = j + 1;
    }
    let mut p: u64 = 0;
    while (p < 9) {
        let s = peek(K_DK0 + p) as u64;
        rs_set_f64(peek(K_SL0 + p) as u64, s as f64);
        rs_set_str(peek(K_LB0 + p) as u64, fmt_slot(s as f64));
        rs_set_brush(peek(K_BR0 + p) as u64, bright(s));
        rs_set_f64(peek(K_PX0 + p) as u64, tray_x(p));
        rs_set_f64(peek(K_PY0 + p) as u64, tray_y(p));
        stf_put(K_OK0 + p, 0.0);
        p = p + 1;
    }
    rs_set_f64(peek(K_COUNT) as u64, 0.0);
    rs_set_bool(peek(K_SNAP) as u64, false);
    rs_set_bool(peek(K_SOLVED) as u64, false);
    stf_put(K_DRAG, -1.0);
}

// Park-Miller in f64 (48271 × 2^31 < 2^53 — exact). Fixed boot seed: deals
// are deterministic per session, shuffles advance the state.
fn rnd() -> f64 {
    let s = stf_take(K_SEED);
    let n = (s * 48271.0) % 2147483647.0;
    stf_put(K_SEED, n);
    return n;
}

// Read a stash slot without consuming it.
fn peek(slot: u64) -> f64 {
    let v = stf_take(slot);
    stf_put(slot, v);
    return v;
}

// ---- the geometry ---------------------------------------------------------------

fn slot_x(s: u64) -> f64 {
    return BOARD_X + (s % 3) as f64 * CELL + GAP_HALF;
}

fn slot_y(s: u64) -> f64 {
    return BOARD_Y + (s / 3) as f64 * CELL + GAP_HALF;
}

fn tray_x(i: u64) -> f64 {
    return TRAY_X + (i % 3) as f64 * CELL + GAP_HALF;
}

fn tray_y(i: u64) -> f64 {
    return TRAY_Y + (i / 3) as f64 * CELL + GAP_HALF;
}

fn bright(s: u64) -> u64 {
    if (s == 0) { return BRI0; }
    if (s == 1) { return BRI1; }
    if (s == 2) { return BRI2; }
    if (s == 3) { return BRI3; }
    if (s == 4) { return BRI4; }
    if (s == 5) { return BRI5; }
    if (s == 6) { return BRI6; }
    if (s == 7) { return BRI7; }
    return BRI8;
}

fn dim(s: u64) -> u64 {
    if (s == 0) { return DIM0; }
    if (s == 1) { return DIM1; }
    if (s == 2) { return DIM2; }
    if (s == 3) { return DIM3; }
    if (s == 4) { return DIM4; }
    if (s == 5) { return DIM5; }
    if (s == 6) { return DIM6; }
    if (s == 7) { return DIM7; }
    return DIM8;
}

// ---- the drag state machine (shared across all 9 pieces — `.ids(i, i)`) --------

fn p_down(i: u64, _b: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {
    let ok = stf_take(K_OK0 + i);
    if (ok > 0.5) {
        stf_put(K_OK0 + i, ok);
        return;
    }
    stf_put(K_OK0 + i, ok);
    stf_put(K_DRAG, i as f64);
    stf_put(K_GX0, gx);
    stf_put(K_GY0, gy);
    stf_put(K_X0, rs_get_f64(peek(K_PX0 + i) as u64));
    stf_put(K_Y0, rs_get_f64(peek(K_PY0 + i) as u64));
}

fn p_move(i: u64, _b: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {
    if (peek(K_DRAG) != i as f64) {
        return;
    }
    let nx = peek(K_X0) + (gx - peek(K_GX0));
    let ny = peek(K_Y0) + (gy - peek(K_GY0));
    rs_set_f64(peek(K_PX0 + i) as u64, nx);
    rs_set_f64(peek(K_PY0 + i) as u64, ny);
    // The snap highlight: the piece's own target while it hovers within
    // threshold of it (the highlight rides bound anchors onto the slot).
    let s = rs_get_f64(peek(K_SL0 + i) as u64) as u64;
    let tx = slot_x(s);
    let ty = slot_y(s);
    let d2 = (nx - tx) * (nx - tx) + (ny - ty) * (ny - ty);
    if (d2 < SNAP_T2) {
        rs_set_f64(peek(K_HLX) as u64, tx);
        rs_set_f64(peek(K_HLY) as u64, ty);
        rs_set_bool(peek(K_SNAP) as u64, true);
    } else {
        rs_set_bool(peek(K_SNAP) as u64, false);
    }
}

fn p_up(i: u64, _b: u64, _lx: f64, _ly: f64, _gx: f64, _gy: f64, _btn: u64) {
    if (peek(K_DRAG) != i as f64) {
        return;
    }
    stf_put(K_DRAG, -1.0);
    rs_set_bool(peek(K_SNAP) as u64, false);
    let nx = rs_get_f64(peek(K_PX0 + i) as u64);
    let ny = rs_get_f64(peek(K_PY0 + i) as u64);
    let s = rs_get_f64(peek(K_SL0 + i) as u64) as u64;
    let tx = slot_x(s);
    let ty = slot_y(s);
    let d2 = (nx - tx) * (nx - tx) + (ny - ty) * (ny - ty);
    if (d2 >= SNAP_T2) {
        return; // off-target: the piece stays where it was dropped
    }
    // Snap + lock: pin to the slot, dim the brush, count it, maybe solve.
    rs_set_f64(peek(K_PX0 + i) as u64, tx);
    rs_set_f64(peek(K_PY0 + i) as u64, ty);
    stf_put(K_OK0 + i, 1.0);
    rs_set_brush(peek(K_BR0 + i) as u64, dim(s));
    let count = rs_get_f64(peek(K_COUNT) as u64) + 1.0;
    rs_set_f64(peek(K_COUNT) as u64, count);
    if (count >= 9.0) {
        rs_set_bool(peek(K_SOLVED) as u64, true);
    }
}

// Shuffle tap: re-deal (deal() resets every game atom; the derives follow).
fn b_shuffle(_a: u64, _b: u64, _n: f64) {
    deal();
}

// ---- the label formats ------------------------------------------------------------

// The piece label: its target slot, 1-based (crossed to the ghost's static
// text too; deal() re-sets the bound labels on every re-deal).
fn fmt_slot(v: f64) -> str {
    let n = v as u64 + 1;
    return f"{n}";
}

// The badge: "N / 9 placed" — the one derive, over the count atom.
fn fmt_count(v: f64) -> str {
    let n = v as u64;
    return f"{n} / 9 placed";
}

// ---- the view helpers --------------------------------------------------------------

fn piece(i: u64) -> View {
    let face = Container()
        .width_height(PIECE, PIECE)
        .color_bound(peek(K_BR0 + i) as u64)
        .radius(14.0)
        .border(0xFFFFFFFFu64, 2.0, BORDER_INSIDE)
        .alignment(ALIGN_CENTER)
        .query_key(f"jw/piece-{i}")
        .child(
            Text()
                .text_bound(peek(K_LB0 + i) as u64)
                .font_size(26.0)
                .color(0xFFFFFFFFu64)
                .query_key(f"jw/piece-{i}-label")
                .build(),
        )
        .build();
    return Positioned()
        .left_bound(peek(K_PX0 + i) as u64)
        .top_bound(peek(K_PY0 + i) as u64)
        .width(PIECE)
        .height(PIECE)
        .child(
            PointerInteract()
                .ids(i, i)
                .on_down2(p_down)
                .on_move2(p_move)
                .on_up2(p_up)
                .query_key(f"jw/pad-{i}")
                .child(face)
                .build(),
        )
        .build();
}

fn ghost(s: u64) -> View {
    return Positioned()
        .left(slot_x(s))
        .top(slot_y(s))
        .width(PIECE)
        .height(PIECE)
        .child(
            Container()
                .width_height(PIECE, PIECE)
                .color(0x1E293BFFu64)
                .border(0x475569FFu64, 1.0, BORDER_INSIDE)
                .radius(12.0)
                .alignment(ALIGN_CENTER)
                .query_key(f"jw/ghost-{s}")
                .child(
                    Text()
                        .text(fmt_slot(s as f64))
                        .font_size(16.0)
                        .color(0x64748BFFu64)
                        .query_key(f"jw/ghost-{s}-num")
                        .build(),
                )
                .build(),
        )
        .build();
}

fn snap_hl_face() -> View {
    return Container()
        .width_height(PIECE, PIECE)
        .color(0x22D3EE40u64)
        .border(0x22D3EEFFu64, 2.5, BORDER_INSIDE)
        .radius(14.0)
        .query_key("jw/snap-hl")
        .build();
}

fn board_bg() -> View {
    let w = BOARD_W + 4.0;
    return Positioned()
        .left(BOARD_X - 2.0)
        .top(BOARD_Y - 2.0)
        .width(w)
        .height(w)
        .child(
            Container()
                .width_height(w, w)
                .color(0x0F172AFFu64)
                .border(0x3B82F6FFu64, 2.0, BORDER_INSIDE)
                .radius(16.0)
                .shadow(0x3B82F628u64, 18.0, 0.0, 0.0)
                .build(),
        )
        .build();
}

fn tray_bg() -> View {
    let w = BOARD_W + 4.0;
    return Positioned()
        .left(TRAY_X - 2.0)
        .top(TRAY_Y - 2.0)
        .width(w)
        .height(w)
        .child(
            Container()
                .width_height(w, w)
                .color(0x0A0F1DFFu64)
                .border(0x334155FFu64, 1.0, BORDER_INSIDE)
                .radius(16.0)
                .build(),
        )
        .build();
}

fn top_bar() -> View {
    let pill = Container()
        .padding(10.0)
        .radius(20.0)
        .color(0x4F46E5FFu64)
        .border(0x818CF8FFu64, 1.0, BORDER_INSIDE)
        .shadow(0x4F46E578u64, 12.0, 0.0, 4.0)
        .child(
            Text()
                .text("Shuffle")
                .font_size(13.0)
                .color(0xFFFFFFFFu64)
                .build(),
        )
        .build();
    let chip = Container()
        .padding(10.0)
        .radius(8.0)
        .color(0x1E293BFFu64)
        .border(0x334155FFu64, 1.0, BORDER_INSIDE)
        .child(
            Text()
                .text_bound_derived(rs_derive(fmt_count, peek(K_COUNT) as u64))
                .font_size(14.0)
                .color(0xE2E8F0FFu64)
                .query_key("jw/counter")
                .build(),
        )
        .build();
    return Positioned()
        .left(12.0)
        .right(12.0)
        .top(12.0)
        .child(
            Row()
                .main_alignment(MAIN_ALIGN_SPACE_BETWEEN)
                .cross_alignment(CROSS_ALIGN_CENTER)
                .child(
                    MouseRegion()
                        .cursor(CURSOR_POINTER)
                        .child(
                            PointerInteract()
                                .on_tap(b_shuffle)
                                .query_key("jw/shuffle")
                                .child(pill)
                                .build(),
                        )
                        .build(),
                )
                .child(chip)
                .build(),
        )
        .build();
}

fn win_banner() -> View {
    return Positioned()
        .left(0.0)
        .top(0.0)
        .right(0.0)
        .bottom(0.0)
        .child(
            Container()
                .color(0x020617C8u64)
                .alignment(ALIGN_CENTER)
                .child(
                    Container()
                        .padding(24.0)
                        .radius(18.0)
                        .color(0x4F46E5FFu64)
                        .border(0x818CF8FFu64, 2.0, BORDER_INSIDE)
                        .shadow(0x4F46E5B4u64, 32.0, 0.0, 8.0)
                        .query_key("jw/banner")
                        .child(
                            Text()
                                .text("Solved!")
                                .font_size(34.0)
                                .color(0xFFFFFFFFu64)
                                .build(),
                        )
                        .build(),
                )
                .build(),
        )
        .build();
}
