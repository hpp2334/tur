// scroll-view-shrink-wrap: the viewport shrink-wraps to its content
// (120x80) under the root's loose constraints (Flutter
// _RenderSingleChildViewport parity).
use tur::{ AXIS_VERTICAL, CROSS_ALIGN_START, mount };
use tur_kit::{ Column, Container, ScrollView };


entry fn start() {
    let mut content = Column.builder();
    content.cross_alignment(CROSS_ALIGN_START);
    content.child(sized(120.0, 40.0));
    content.child(sized(60.0, 40.0));
    let mut sv = ScrollView.builder().axis(AXIS_VERTICAL).child(content.build()).query_key("sv").build();
    mount(sv);
}

fn sized(w: f64, h: f64) -> opaque {
    let mut b = Container.builder();
    b.width_height(w, h);
    return b.build();
}
