// row-with-each: an Each inside a content-sized Row — the Row must not
// inflate to the parent Column's height (the regression the test pins).
use tur::{ CROSS_ALIGN_STRETCH, mount, rs_list_new, rs_list_push, rs_source_value };
use tur_kit::{ Column, Container, Each, Expanded, Row, SizedBox, Text };


entry fn item(_i: u64, s: str) -> opaque {
    let mut t = Text.builder();

    t.text(s);
    t.font_size(13.0);
    return t.build();
}

entry fn start() {
    let seg = rs_list_new();
    rs_list_push(seg, "a");
    rs_list_push(seg, "b");
    let seg_atom = rs_source_value(seg);

    let mut col = Column.builder();
    col.cross_alignment(CROSS_ALIGN_STRETCH);
    let mut row = Row.builder();
    row.child(SizedBox.builder(16.0, 16.0).child(Container.builder().build()).build());
    row.child(Each.builder(seg_atom).item_builder("item").build());
    col.child(row.build());
    col.child(SizedBox.builder(40.0, 10.0).child(Container.builder().build()).build());
    col.child(Expanded.builder().flex(1.0).child(Container.builder().build()).build());
    mount(col.build());
}
