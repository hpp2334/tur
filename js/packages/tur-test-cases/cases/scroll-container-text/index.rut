// scroll-container-text: a padded unsized Container sized from its Text
// child inside a vertical ScrollView's content Column.
use tur::{ AXIS_VERTICAL, mount };
use tur_kit::{ Column, Container, ScrollView, Text };


entry fn start() {
    let mut b = Container.builder();
    b.padding(48.0);
    b.query_key("container");
    let mut t = Text.builder();

    t.text("Empty State");
    t.font_size(24.0);
    b.child(t.build());
    let mut col = Column.builder();
    col.child(b.build());
    mount(ScrollView.builder().axis(AXIS_VERTICAL).child(col.build()).build());
}
