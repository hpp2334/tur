// condition-basic: a Condition whose then-branch renders (pre-built
// branches swapped by the engine — no rut during flush).
use tur::{ mount, rs_source_bool };
use tur_kit::{ Condition, Container, Text };


entry fn start() {
    let when = rs_source_bool(true);
    let mut then_box = Container.new();
    then_box.width_height(200.0, 100.0);
    then_box.color(0x303030FF);
    then_box.query_key("then-branch");
    then_box.child(Text.new().text("then-branch").build());
    let mut else_box = Container.new();
    else_box.width_height(200.0, 100.0);
    else_box.color(0x501A1AFF);
    else_box.query_key("else-branch");
    else_box.child(Text.new().text("else-branch").build());
    let c = Condition.new(when).then(then_box.build()).else_branch(else_box.build()).query_key("condition-basic").build();

    mount(c);
}
