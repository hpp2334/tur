// pointer-drag: a gesture pad reporting down/move/up — the phase label
// and the last position ride two bound atoms (both cross in the intents).
use tur::{ ALIGN_CENTER, CROSS_ALIGN_START, mount, rs_set_str, rs_source_str };
use tur_kit::{ Column, Container, PointerInteract, Text };


entry fn start() -> u64 {
    let phase = rs_source_str("idle");
    let pos = rs_source_str("0,0");

    let mut col = Column().cross_alignment(CROSS_ALIGN_START);

    let b = Container()
        .width_height(100.0, 50.0)
        .color(0xCCCCCCFFu64)
        .alignment(ALIGN_CENTER)
        .child(Text().text_bound(phase).query_key("drag-phase").build());

    col.child(PointerInteract().ids(phase, pos).on_down2(g_down).on_move2(g_move).on_up2(g_up).query_key("rut/gesture").child(b.build()).build());

    let pos_t = Text().text_bound(pos).query_key("drag-pos");
    col.child(pos_t.build());

    mount(col.build());
    return phase;
}

fn g_down(phase: u64, pos: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {
    rs_set_str(pos, f"{gx as u64},{gy as u64}");
    rs_set_str(phase, "down");
}

fn g_move(phase: u64, pos: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {
    rs_set_str(pos, f"{gx as u64},{gy as u64}");
    rs_set_str(phase, "move");
}

fn g_up(phase: u64, pos: u64, _lx: f64, _ly: f64, gx: f64, gy: f64, _btn: u64) {
    rs_set_str(pos, f"{gx as u64},{gy as u64}");
    rs_set_str(phase, "up");
}
