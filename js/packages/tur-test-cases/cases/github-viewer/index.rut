// github-viewer: browse a public GitHub repo — landing form ("owner/repo"
// + quick-pick chips), a loading state, and an explorer (breadcrumb,
// stats, the directory listing with per-row taps, a selection footer).
// Single-file port of the boa TSX original (a 6-file case: index/landing/
// explorer/state/theme/ui — the explorer view is inlined here).
//
// Host surface: `net_request` (the async capability row) rides the rut
// weave (`launch_future` + `await`), exactly like the countdown ticker.
// GitHub's REST API is CORS-friendly, so the wasm build fetches it
// directly. Degradation: an empty response body (the net row completes
// empty on transport failure) becomes a visible error banner; a JSON
// error payload (404 / rate limit) surfaces the API's own message.
//
// JSON: the engine ships no parse row, so the two payloads the case
// reads (the repo meta object + the contents array of flat objects) are
// scanned by a tiny cursor parser below — `json_get_str` (one object's
// scalar field) and `json_contents` (an array walk into a display list).
// Escapes decode the common pairs; `\uXXXX` mints U+FFFD.
//
// Rust-boundary notes for future editors: unannotated float locals are
// `f32` by the default-width rule (annotate `: f64` when handing them to
// rows), and f-string braces take no nested string literals (bind a
// local first).
use futures::launch_future;
use tur::{
    ALIGN_CENTER, AXIS_VERTICAL, BORDER_INSIDE, CROSS_ALIGN_CENTER, CROSS_ALIGN_STRETCH,
    CROSS_ALIGN_START, MAIN_ALIGN_END, MAIN_SIZE_MIN, mount, net_request, rs_get_str,
    rs_get_value, rs_list_new, rs_list_push, rs_set_bool, rs_set_str, rs_set_value,
    rs_source_bool, rs_source_f64, rs_source_str, rs_source_value, rs_value_item, st_put, st_take,
    stf_put, stf_take, str_parse_f64, tctrl_new, tctrl_set_text, tctrl_text, undo_new,
};
use tur_kit::{ Column, Condition, Container, Each, Expanded, Input, PointerInteract, Row, ScrollView, SizedBox, Switch, Text };


// The scalar-stash keys (atom ids + the text controller ride them).
let K_MODE: u64 = 1;
let K_ERR: u64 = 2;
let K_ERRHAS: u64 = 3;
let K_REPO: u64 = 4;
let K_DESC: u64 = 5;
let K_STATS: u64 = 6;
let K_PATH: u64 = 7;
let K_SEL: u64 = 8;
let K_FILES: u64 = 9;
let K_EMPTY: u64 = 10;
let K_CTRL: u64 = 20;
let K_UNDO: u64 = 21;

// The boa theme (Notion / Linear-style light palette).
let PAGE_BG: u64 = 0xF8FAFCFFu64;
let PANEL: u64 = 0xFFFFFFFFu64;
let BORDER: u64 = 0xE2E8F0FFu64;
let TEXT: u64 = 0x0F172AFFu64;
let TEXT_MUTED: u64 = 0x64748BFFu64;
let TEXT_SUBTLE: u64 = 0x94A3B8FFu64;
let ACCENT: u64 = 0x4F46E5FFu64;
let ACCENT_SOFT: u64 = 0xEEF2FFFFu64;
let ACCENT_FG: u64 = 0xFFFFFFFFu64;
let DANGER: u64 = 0xEF4444FFu64;
let DANGER_SOFT: u64 = 0xFEF2F2FFu64;
let SUBTLE_BUTTON: u64 = 0xF1F5F9FFu64;
let SUBTLE_BUTTON_FG: u64 = 0x334155FFu64;
let DIR_ICON: u64 = 0x6366F1FFu64;
let FILE_ICON: u64 = 0x94A3B8FFu64;

// ASCII codepoints the scanner compares against (typed so the literals
// land on `u32`).
let C_QUOTE: u32 = 34;
let C_COMMA: u32 = 44;
let C_COLON: u32 = 58;
let C_PIPE: u32 = 124;
let C_SPACE: u32 = 32;
let C_SLASH: u32 = 47;
let C_BACKSLASH: u32 = 92;
let C_LBRACE: u32 = 123;
let C_RBRACE: u32 = 125;
let C_LBRACKET: u32 = 91;
let C_RBRACKET: u32 = 93;

entry fn start() -> u64 {
    let mode = rs_source_str("landing");
    let err = rs_source_str("");
    let err_has = rs_source_bool(false);
    let repo_full = rs_source_str("");
    let desc = rs_source_str("");
    let stats = rs_source_str("");
    let path = rs_source_str("");
    let selected = rs_source_str("");
    let files = rs_source_value(rs_list_new());
    let is_empty = rs_source_bool(false);
    stf_put(K_MODE, mode as f64);
    stf_put(K_ERR, err as f64);
    stf_put(K_ERRHAS, err_has as f64);
    stf_put(K_REPO, repo_full as f64);
    stf_put(K_DESC, desc as f64);
    stf_put(K_STATS, stats as f64);
    stf_put(K_PATH, path as f64);
    stf_put(K_SEL, selected as f64);
    stf_put(K_FILES, files as f64);
    stf_put(K_EMPTY, is_empty as f64);
    let ctrl = tctrl_new();
    st_put(K_CTRL, ctrl);
    st_put(K_UNDO, undo_new());

    let body = Switch()
        .value_source(mode)
        .query_key("gh-body")
        .cases("landing", landing_view())
        .cases("loading", loading_view())
        .cases("explorer", explorer_view())
        .build();
    let page = Container().color(PAGE_BG).padding(22.0).child(body).build();
    let root = Column()
        .cross_alignment(CROSS_ALIGN_STRETCH)
        .child(Expanded().flex(1.0).child(page).build())
        .build();
    mount(root);
    return mode;
}

// ---- shared chrome ---------------------------------------------------------

// A compact pill button (the boa Button/IconButton composite).
fn pill(key: str, label: str, cb: fn(u64, u64, f64), a: u64, bg: u64, fg: u64) -> opaque {
    let face = Container()
        .padding(9.0)
        .radius(8.0)
        .color(bg)
        .child(Text().text(label).font_size(13.0).color(fg).build())
        .build();
    return PointerInteract()
        .ids(a, a)
        .on_tap(cb)
        .query_key(key)
        .child(face)
        .build();
}

// The error banner row (a visible failure state on landing + explorer).
fn error_banner() -> opaque {
    let err = stf_take(K_ERR) as u64;
    let err_has = stf_take(K_ERRHAS) as u64;
    stf_put(K_ERR, err as f64);
    stf_put(K_ERRHAS, err_has as f64);
    let banner = Container()
        .padding(10.0)
        .radius(8.0)
        .color(DANGER_SOFT)
        .child(Text().text_bound(err).font_size(12.0).color(DANGER).query_key("gh-err").build())
        .build();
    return Condition(err_has).then(banner).else_branch(SizedBox(0.0, 0.0).build()).build();
}

// ---- landing ---------------------------------------------------------------

fn landing_view() -> opaque {
    let err_has = stf_take(K_ERRHAS) as u64;
    stf_put(K_ERRHAS, err_has as f64);
    let ctrl = st_take(K_CTRL);
    let undo = st_take(K_UNDO);
    let field = Input()
        .controller(ctrl)
        .undo(undo)
        .placeholder("owner/repo")
        .width_height(280.0, 34.0)
        .font_size(14.0)
        .query_key("gh-input")
        .build();
    st_put(K_CTRL, ctrl);
    st_put(K_UNDO, undo);
    // Fixed 360 card (the boa card capped at `min(440, vw - 44)`; the
    // playground's viewer pane is ~390 of content — 440 overflows it).
    let card = Container()
        .width(360.0)
        .padding(34.0)
        .radius(14.0)
        .color(PANEL)
        .border(BORDER, 1.0, BORDER_INSIDE)
        .child(
            Column()
                .cross_alignment(CROSS_ALIGN_START)
                .main_axis_size(MAIN_SIZE_MIN)
                .child(brand_mark())
                .child(SizedBox(0.0, 18.0).build())
                .child(Text().text("Browse a public repo").font_size(18.0).color(TEXT).build())
                .child(SizedBox(0.0, 6.0).build())
                .child(Text().text("Enter a repo as \"owner/name\" to explore its files.").font_size(13.0).color(TEXT_MUTED).build())
                .child(SizedBox(0.0, 20.0).build())
                .child(field)
                .child(SizedBox(0.0, 8.0).build())
                .child(error_banner())
                .child(SizedBox(0.0, 8.0).build())
                .child(Row().main_alignment(MAIN_ALIGN_END).child(pill("gh-browse", "Browse", b_browse, 0, ACCENT, ACCENT_FG)).build())
                .child(SizedBox(0.0, 22.0).build())
                .child(Text().text("Try one of these").font_size(11.0).color(TEXT_SUBTLE).build())
                .child(SizedBox(0.0, 8.0).build())
                .child(suggestion_row())
                .build(),
        )
        .build();
    return Container().alignment(ALIGN_CENTER).child(card).build();
}

// The 40x40 rounded brand mark (the boa GitHub glyph, as type).
fn brand_mark() -> opaque {
    let mark = Container()
        .width_height(40.0, 40.0)
        .radius(10.0)
        .color(ACCENT_SOFT)
        .alignment(ALIGN_CENTER)
        .child(Text().text("GH").font_size(16.0).font_weight(700.0).color(ACCENT).build())
        .build();
    return mark;
}

fn suggestion_row() -> opaque {
    // Stacked (the boa mobile variant) — the three chips overflow the
    // 360 card's content width in a row.
    return Column()
        .cross_alignment(CROSS_ALIGN_START)
        .main_axis_size(MAIN_SIZE_MIN)
        .child(pill("gh-sug-0", "facebook/react", b_sug, 0, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))
        .child(SizedBox(0.0, 6.0).build())
        .child(pill("gh-sug-1", "torvalds/linux", b_sug, 1, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))
        .child(SizedBox(0.0, 6.0).build())
        .child(pill("gh-sug-2", "rust-lang/rust", b_sug, 2, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))
        .build();
}

// ---- loading ---------------------------------------------------------------

fn loading_view() -> opaque {
    return Container()
        .alignment(ALIGN_CENTER)
        .child(Text().text("Loading…").font_size(13.0).color(TEXT_SUBTLE).query_key("gh-loading").build())
        .build();
}

// ---- explorer --------------------------------------------------------------

fn explorer_view() -> opaque {
    let repo_full = stf_take(K_REPO) as u64;
    let desc = stf_take(K_DESC) as u64;
    let path = stf_take(K_PATH) as u64;
    let stats = stf_take(K_STATS) as u64;
    let selected = stf_take(K_SEL) as u64;
    let is_empty = stf_take(K_EMPTY) as u64;
    stf_put(K_REPO, repo_full as f64);
    stf_put(K_DESC, desc as f64);
    stf_put(K_PATH, path as f64);
    stf_put(K_STATS, stats as f64);
    stf_put(K_SEL, selected as f64);
    stf_put(K_EMPTY, is_empty as f64);
    let list = ScrollView()
        .axis(AXIS_VERTICAL)
        .child(
            Column()
                .cross_alignment(CROSS_ALIGN_STRETCH)
                .main_axis_size(MAIN_SIZE_MIN)
                .child(Each(files).item_builder(item_file).build())
                .build(),
        )
        .build();
    let empty = Container()
        .alignment(ALIGN_CENTER)
        .padding(40.0)
        .child(
            Column()
                .cross_alignment(CROSS_ALIGN_CENTER)
                .main_axis_size(MAIN_SIZE_MIN)
                .child(Text().text("This folder is empty").font_size(14.0).color(TEXT).build())
                .child(SizedBox(0.0, 6.0).build())
                .child(Text().text("No files to show at this path.").font_size(12.0).color(TEXT_SUBTLE).build())
                .build(),
        )
        .build();
    return Column()
        .cross_alignment(CROSS_ALIGN_STRETCH)
        .child(
            Row()
                .cross_alignment(CROSS_ALIGN_CENTER)
                .child(pill("gh-back", "Back", b_back, 0, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))
                .child(SizedBox(10.0, 0.0).build())
                .child(Text().text_bound(repo_full).font_size(13.0).font_weight(600.0).color(ACCENT).query_key("gh-crumb").build())
                .child(SizedBox(6.0, 0.0).build())
                .child(Text().text_bound(path).font_size(13.0).color(TEXT_SUBTLE).query_key("gh-path").build())
                .build(),
        )
        .child(SizedBox(0.0, 4.0).build())
        .child(Text().text_bound(desc).font_size(12.0).color(TEXT_MUTED).query_key("gh-desc").build())
        .child(SizedBox(0.0, 8.0).build())
        .child(error_banner())
        .child(SizedBox(0.0, 8.0).build())
        .child(
            Row()
                .cross_alignment(CROSS_ALIGN_CENTER)
                .child(pill("gh-refresh", "Refresh", b_refresh, 0, SUBTLE_BUTTON, SUBTLE_BUTTON_FG))
                .child(SizedBox(10.0, 0.0).build())
                .child(Text().text_bound(stats).font_size(12.0).color(TEXT_MUTED).query_key("gh-stats").build())
                .build(),
        )
        .child(SizedBox(0.0, 8.0).build())
        .child(Expanded().flex(1.0).child(Condition(is_empty).then(empty).else_branch(list).build()).build())
        .child(
            Container()
                .padding(6.0)
                .child(Text().text_bound(selected).font_size(12.0).color(TEXT_SUBTLE).query_key("gh-selected").build())
                .build(),
        )
        .build();
}

// One listing row: icon square + name + size (dirs sort first — the two
// array passes below order them).
fn item_file(i: u64, s: str) -> opaque {
    let is_dir = s.starts_with(0, "d|");
    let n = s.len();
    let mut name = "";
    let mut size_txt = "";
    if (is_dir) {
        name = s.slice(2, n);
    } else {
        let mut k = 2;
        while (k < n) {
            if (s.code_at(k) == C_PIPE) {
                break;
            }
            k = k + 1;
        }
        name = s.slice(2, k);
        size_txt = fmt_size(s.slice(k + 1, n));
    }
    let mut icon = DIR_ICON;
    if (!is_dir) {
        icon = FILE_ICON;
    }
    let row = Row()
        .cross_alignment(CROSS_ALIGN_CENTER)
        .child(Container().width_height(14.0, 14.0).radius(3.0).color(icon).build())
        .child(SizedBox(10.0, 0.0).build())
        .child(Expanded().flex(1.0).child(Text().text(name).font_size(13.0).color(TEXT).build()).build())
        .child(SizedBox(10.0, 0.0).build())
        .child(Text().text(size_txt).font_size(11.0).color(TEXT_SUBTLE).build())
        .build();
    let card = Container()
        .padding(9.0)
        .radius(8.0)
        .color(PANEL)
        .border(BORDER, 1.0, BORDER_INSIDE)
        .child(row)
        .build();
    return PointerInteract()
        .ids(i, i)
        .on_tap(b_row)
        .query_key("gh-row")
        .child(card)
        .build();
}

// ---- actions ---------------------------------------------------------------

// The Browse tap: read the draft, validate the owner/name shape, launch.
fn b_browse(_a: u64, _b: u64, _n: f64) {
    let ctrl = st_take(K_CTRL);
    let draft = tctrl_text(ctrl);
    st_put(K_CTRL, ctrl);
    open_draft(draft);
}

// A quick-pick chip: pre-fill the field and open directly.
fn b_sug(a: u64, _b: u64, _n: f64) {
    let ctrl = st_take(K_CTRL);
    let mut name = "facebook/react";
    if (a == 1) {
        name = "torvalds/linux";
    } else if (a == 2) {
        name = "rust-lang/rust";
    }
    tctrl_set_text(ctrl, name);
    st_put(K_CTRL, ctrl);
    open_draft(name);
}

// Back: up one directory, or back to the landing when at the root.
fn b_back(_a: u64, _b: u64, _n: f64) {
    let path = stf_take(K_PATH) as u64;
    let selected = stf_take(K_SEL) as u64;
    let cur = rs_get_str(path);
    if (cur == "") {
        stf_put(K_PATH, path as f64);
        stf_put(K_SEL, selected as f64);
        go_landing();
        return;
    }
    let n = cur.len();
    let mut sep: i32 = -1;
    let mut k = 0;
    while (k < n) {
        if (cur.code_at(k) == C_SLASH) {
            sep = k;
        }
        k = k + 1;
    }
    if (sep < 0) {
        rs_set_str(path, "");
    } else {
        rs_set_str(path, cur.slice(0, sep));
    }
    rs_set_str(selected, "");
    stf_put(K_PATH, path as f64);
    stf_put(K_SEL, selected as f64);
    launch_future(fetch_dir());
}

// Re-fetch the current directory.
fn b_refresh(_a: u64, _b: u64, _n: f64) {
    launch_future(fetch_dir());
}

// A listing-row tap: a directory descends (a fresh contents fetch); a
// file fills the selection footer.
fn b_row(a: u64, _b: u64, _n: f64) {
    let files = stf_take(K_FILES) as u64;
    stf_put(K_FILES, files as f64);
    let v = rs_get_value(files);
    let s = rs_value_item(v, a);
    if (s.starts_with(0, "d|")) {
        let name = s.slice(2, s.len());
        let path = stf_take(K_PATH) as u64;
        let selected = stf_take(K_SEL) as u64;
        let cur = rs_get_str(path);
        let mut next = name;
        if (cur != "") {
            next = f"{cur}/{name}";
        }
        rs_set_str(path, next);
        rs_set_str(selected, "");
        stf_put(K_PATH, path as f64);
        stf_put(K_SEL, selected as f64);
        launch_future(fetch_dir());
        return;
    }
    let n = s.len();
    let mut k = 2;
    while (k < n) {
        if (s.code_at(k) == C_PIPE) {
            break;
        }
        k = k + 1;
    }
    let name = s.slice(2, k);
    let size = fmt_size(s.slice(k + 1, n));
    let selected = stf_take(K_SEL) as u64;
    rs_set_str(selected, f"{name} — {size}");
    stf_put(K_SEL, selected as f64);
}

fn open_draft(draft: str) {
    let full = parse_repo(draft);
    let err = stf_take(K_ERR) as u64;
    let err_has = stf_take(K_ERRHAS) as u64;
    if (full == "") {
        rs_set_str(err, "Enter a repo as \"owner/name\" — e.g. facebook/react");
        rs_set_bool(err_has, true);
        stf_put(K_ERR, err as f64);
        stf_put(K_ERRHAS, err_has as f64);
        return;
    }
    rs_set_str(err, "");
    rs_set_bool(err_has, false);
    stf_put(K_ERR, err as f64);
    stf_put(K_ERRHAS, err_has as f64);
    let repo_full = stf_take(K_REPO) as u64;
    rs_set_str(repo_full, full);
    stf_put(K_REPO, repo_full as f64);
    launch_future(open_repo());
}

fn go_landing() {
    let mode = stf_take(K_MODE) as u64;
    let err = stf_take(K_ERR) as u64;
    let err_has = stf_take(K_ERRHAS) as u64;
    let desc = stf_take(K_DESC) as u64;
    let stats = stf_take(K_STATS) as u64;
    let path = stf_take(K_PATH) as u64;
    let selected = stf_take(K_SEL) as u64;
    let is_empty = stf_take(K_EMPTY) as u64;
    rs_set_str(mode, "landing");
    rs_set_str(err, "");
    rs_set_bool(err_has, false);
    rs_set_str(desc, "");
    rs_set_str(stats, "");
    rs_set_str(path, "");
    rs_set_str(selected, "");
    rs_set_bool(is_empty, false);
    stf_put(K_MODE, mode as f64);
    stf_put(K_ERR, err as f64);
    stf_put(K_ERRHAS, err_has as f64);
    stf_put(K_DESC, desc as f64);
    stf_put(K_STATS, stats as f64);
    stf_put(K_PATH, path as f64);
    stf_put(K_SEL, selected as f64);
    stf_put(K_EMPTY, is_empty as f64);
}

// The repo-meta journey: mode → loading, GET the repo, surface its error
// payload or seed the explorer and fetch the root listing.
async fn open_repo() -> str {
    set_mode("loading");
    let repo_full = stf_take(K_REPO) as u64;
    let full = rs_get_str(repo_full);
    stf_put(K_REPO, repo_full as f64);
    let url = f"https://api.github.com/repos/{full}";
    let body = await net_request(url, "GET");
    if (body.len() == 0) {
        fail("Network request failed — the browser may be offline.", false);
        return "";
    }
    let meta = body.decode();
    let name = json_get_str(meta, "full_name");
    if (name == "") {
        let msg = json_get_str(meta, "message");
        if (msg == "") {
            fail("Unexpected response from the GitHub API.", false);
        } else {
            fail(f"{msg} — check the name (owner/repo).", false);
        }
        return "";
    }
    let desc = stf_take(K_DESC) as u64;
    let stats = stf_take(K_STATS) as u64;
    let path = stf_take(K_PATH) as u64;
    let selected = stf_take(K_SEL) as u64;
    rs_set_str(repo_full, name);
    rs_set_str(desc, json_get_str(meta, "description"));
    rs_set_str(stats, fmt_stats(meta));
    rs_set_str(path, "");
    rs_set_str(selected, "");
    stf_put(K_DESC, desc as f64);
    stf_put(K_STATS, stats as f64);
    stf_put(K_PATH, path as f64);
    stf_put(K_SEL, selected as f64);
    await fetch_dir();
    return "";
}

// The directory journey: GET .../contents[/path], fill the display list
// (dirs first), flip the empty flag, settle on the explorer.
async fn fetch_dir() -> str {
    let repo_full = stf_take(K_REPO) as u64;
    let path = stf_take(K_PATH) as u64;
    let full = rs_get_str(repo_full);
    let dir = rs_get_str(path);
    stf_put(K_REPO, repo_full as f64);
    stf_put(K_PATH, path as f64);
    let mut url = f"https://api.github.com/repos/{full}/contents";
    if (dir != "") {
        url = f"https://api.github.com/repos/{full}/contents/{dir}";
    }
    let body = await net_request(url, "GET");
    if (body.len() == 0) {
        fail("Network request failed — the browser may be offline.", true);
        return "";
    }
    let text = body.decode();
    let fresh = rs_list_new();
    let ndirs = json_contents(text, fresh, true);
    let nfiles = json_contents(text, fresh, false);
    if (ndirs < 0 || nfiles < 0) {
        fail("Unexpected file-list response from the GitHub API.", true);
        return "";
    }
    let files = stf_take(K_FILES) as u64;
    let is_empty = stf_take(K_EMPTY) as u64;
    rs_set_value(files, fresh);
    rs_set_bool(is_empty, ndirs + nfiles == 0);
    stf_put(K_FILES, files as f64);
    stf_put(K_EMPTY, is_empty as f64);
    set_mode("explorer");
    return "";
}

fn set_mode(mode: str) {
    let atom = stf_take(K_MODE) as u64;
    rs_set_str(atom, mode);
    stf_put(K_MODE, atom as f64);
}

// The failure rail: the message lands on the banner; `explorer` keeps the
// listing visible under it, anything else falls back to the landing.
fn fail(msg: str, stay: bool) {
    let err = stf_take(K_ERR) as u64;
    let err_has = stf_take(K_ERRHAS) as u64;
    rs_set_str(err, msg);
    rs_set_bool(err_has, true);
    stf_put(K_ERR, err as f64);
    stf_put(K_ERRHAS, err_has as f64);
    if (stay) {
        set_mode("explorer");
    } else {
        set_mode("landing");
    }
}

// ---- helpers ---------------------------------------------------------------

// "owner/repo" out of a draft; "" when the shape is wrong (a `.git`
// suffix is stripped).
fn parse_repo(draft: str) -> str {
    let n = draft.len();
    let mut a = 0;
    while (a < n && draft.code_at(a) == C_SPACE) {
        a = a + 1;
    }
    let mut b = n;
    while (b > a && draft.code_at(b - 1) == C_SPACE) {
        b = b - 1;
    }
    let t = draft.slice(a, b);
    let m = t.len();
    let mut sep: i32 = -1;
    let mut k = 0;
    while (k < m) {
        if (t.code_at(k) == C_SLASH) {
            sep = k;
            break;
        }
        k = k + 1;
    }
    if (sep <= 0 || sep >= m - 1) {
        return "";
    }
    let owner = t.slice(0, sep);
    let mut repo = t.slice(sep + 1, m);
    let rl = repo.len();
    if (rl > 4 && repo.starts_with(rl - 4, ".git")) {
        repo = repo.slice(0, rl - 4);
    }
    return f"{owner}/{repo}";
}

// "rust · stars 12.3k · forks 4.5k · issues 123" — the language folded in
// when present.
fn fmt_stats(meta: str) -> str {
    let lang = json_get_str(meta, "language");
    let stars = json_get_str(meta, "stargazers_count");
    let forks = json_get_str(meta, "forks_count");
    let issues = json_get_str(meta, "open_issues_count");
    let mut out = "";
    if (lang != "") {
        out = f"{out}{lang} · ";
    }
    return f"{out}stars {fmt_count(stars)} · forks {fmt_count(forks)} · issues {fmt_count(issues)}";
}

// 12345 → "12.3k"; 123 → "123".
fn fmt_count(s: str) -> str {
    let v: f64 = str_parse_f64(s);
    if (v >= 1000.0) {
        let d = ((v / 1000.0) * 10.0) as u64;
        return f"{d / 10}.{d % 10}k";
    }
    return f"{v as u64}";
}

// 2739 → "2.7 KB"; 12 → "12 B".
fn fmt_size(s: str) -> str {
    if (s == "") {
        return "—";
    }
    let v: f64 = str_parse_f64(s);
    if (v < 1024.0) {
        return f"{v as u64} B";
    }
    let mut x: f64 = v / 1024.0;
    let mut unit = "KB";
    if (v >= 1048576.0) {
        x = v / 1048576.0;
        unit = "MB";
    }
    let d = (x * 10.0) as u64;
    return f"{d / 10}.{d % 10} {unit}";
}

// ---- the JSON scanner ------------------------------------------------------

fn ws(c: u32) -> bool {
    return c == C_SPACE || c == 9 || c == 10 || c == 13;
}

fn skip_ws(t: str, i: i32) -> i32 {
    let n = t.len();
    let mut j = i;
    while (j < n && ws(t.code_at(j))) {
        j = j + 1;
    }
    return j;
}

// The index just past the string literal opening at `i` (escapes skip
// whole pairs).
fn str_end(t: str, i: i32) -> i32 {
    let n = t.len();
    let mut j = i + 1;
    while (j < n) {
        let c = t.code_at(j);
        if (c == C_BACKSLASH) {
            j = j + 2;
            continue;
        }
        if (c == C_QUOTE) {
            return j + 1;
        }
        j = j + 1;
    }
    return n;
}

// Decode the string literal whose opening quote sits at `i` (the common
// escapes; `\uXXXX` mints U+FFFD).
fn str_unquote(t: str, i: i32) -> str {
    let end = str_end(t, i);
    let raw = t.slice(i + 1, end - 1);
    let n = raw.len();
    let mut out = "";
    let mut k = 0;
    while (k < n) {
        let c = raw.code_at(k);
        if (c != C_BACKSLASH) {
            out = f"{out}{raw.slice(k, k + 1)}";
            k = k + 1;
            continue;
        }
        if (k + 1 >= n) {
            break;
        }
        let e = raw.code_at(k + 1);
        if (e == C_QUOTE) {
            out = f"{out}\"";
        } else if (e == C_BACKSLASH) {
            out = f"{out}\\";
        } else if (e == C_SLASH) {
            out = f"{out}/";
        } else if (e == 110) {
            out = f"{out}\n";
        } else if (e == 116) {
            out = f"{out}\t";
        } else if (e == 117) {
            out = f"{out}\u{FFFD}";
            k = k + 6;
            continue;
        } else {
            out = f"{out}{raw.slice(k + 1, k + 2)}";
        }
        k = k + 2;
    }
    return out;
}

// Skip one JSON value at `i`; answers the index just past it (strings,
// nested containers walked with depth, scalars to the next delimiter).
fn json_skip(t: str, i: i32) -> i32 {
    let n = t.len();
    let j = skip_ws(t, i);
    if (j >= n) {
        return n;
    }
    let c = t.code_at(j);
    if (c == C_QUOTE) {
        return str_end(t, j);
    }
    if (c == C_LBRACE || c == C_LBRACKET) {
        let mut depth = 0;
        let mut k = j;
        while (k < n) {
            let d = t.code_at(k);
            if (d == C_QUOTE) {
                k = str_end(t, k);
                continue;
            }
            if (d == C_LBRACE || d == C_LBRACKET) {
                depth = depth + 1;
            } else if (d == C_RBRACE || d == C_RBRACKET) {
                depth = depth - 1;
                if (depth == 0) {
                    return k + 1;
                }
            }
            k = k + 1;
        }
        return n;
    }
    let mut k = j;
    while (k < n) {
        let d = t.code_at(k);
        if (d == C_COMMA || d == C_RBRACE || d == C_RBRACKET || ws(d)) {
            break;
        }
        k = k + 1;
    }
    return k;
}

// One object's scalar field: the decoded string for string values, the
// raw text for numbers/bools, "" when absent (or the value is
// null/container).
fn json_get_str(t: str, key: str) -> str {
    let n = t.len();
    let mut i = skip_ws(t, 0);
    if (i >= n || t.code_at(i) != C_LBRACE) {
        return "";
    }
    i = skip_ws(t, i + 1);
    while (i < n) {
        if (t.code_at(i) == C_RBRACE) {
            return "";
        }
        if (t.code_at(i) != C_QUOTE) {
            return "";
        }
        let key_end = str_end(t, i);
        let k = t.slice(i + 1, key_end - 1);
        let j = skip_ws(t, key_end);
        if (j >= n || t.code_at(j) != C_COLON) {
            return "";
        }
        let vs = skip_ws(t, j + 1);
        if (k == key) {
            if (vs < n && t.code_at(vs) == C_QUOTE) {
                return str_unquote(t, vs);
            }
            if (vs < n && t.code_at(vs) != C_LBRACE && t.code_at(vs) != C_LBRACKET) {
                let vend = json_skip(t, vs);
                return t.slice(vs, vend);
            }
            return "";
        }
        i = skip_ws(t, json_skip(t, vs));
        if (i < n && t.code_at(i) == C_COMMA) {
            i = skip_ws(t, i + 1);
        }
    }
    return "";
}

// Walk a JSON array of flat objects; push "d|name" (dirs pass) or
// "f|name|bytes" (files pass) onto `out`. Answers the item count seen, or
// -1 when the payload is not an array of objects.
fn json_contents(t: str, out: opaque, dirs_only: bool) -> i32 {
    let n = t.len();
    let mut i = skip_ws(t, 0);
    if (i >= n || t.code_at(i) != C_LBRACKET) {
        return -1;
    }
    i = skip_ws(t, i + 1);
    let mut count: i32 = 0;
    while (i < n) {
        if (t.code_at(i) == C_RBRACKET) {
            return count;
        }
        if (t.code_at(i) != C_LBRACE) {
            return -1;
        }
        let iend = json_skip(t, i);
        let item = t.slice(i, iend);
        let kind = json_get_str(item, "type");
        let is_dir = kind == "dir";
        if (is_dir == dirs_only) {
            let name = json_get_str(item, "name");
            if (is_dir) {
                rs_list_push(out, f"d|{name}");
            } else {
                let size = json_get_str(item, "size");
                rs_list_push(out, f"f|{name}|{size}");
            }
            count = count + 1;
        }
        i = skip_ws(t, iend);
        if (i < n && t.code_at(i) == C_COMMA) {
            i = skip_ws(t, i + 1);
        }
    }
    return count;
}
