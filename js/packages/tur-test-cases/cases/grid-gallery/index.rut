// grid-gallery: a header + scrollable tile grid (the hover-cursor demo
// surface).
use tur::{ CROSS_ALIGN_CENTER, CURSOR_POINTER, mount };
use tur_kit::{ Column, Container, Expanded, MouseRegion, Row, SizedBox, Text };


entry fn tile(i: u64) -> opaque {
    let mut b = Container.new();
    b.width_height(100.0, 100.0);
    b.color(0x1E293BFF);
    let mut label = Text.new();

    label.text(f"tile {i}");
    label.font_size(12.0);
    b.child(label.build());
    return MouseRegion.new().cursor(CURSOR_POINTER).behavior(0).child(b.build()).build();
}

entry fn start() {
    let mut col = Column.new();
    col.cross_alignment(CROSS_ALIGN_CENTER);
    let mut row = Row.new();
    row.child(tile(0));
    row.child(tile(1));
    row.child(tile(2));
    col.child(SizedBox.new(400.0, 40.0).child(Container.new().build()).build());
    col.child(row.build());
    mount(Expanded.new().flex(1.0).child(col.build()).build());
}
