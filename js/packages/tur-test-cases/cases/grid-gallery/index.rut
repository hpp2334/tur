// grid-gallery: a header + scrollable tile grid (the hover-cursor demo
// surface).
use tur::{ CROSS_ALIGN_CENTER, CURSOR_POINTER, mount };
use tur_kit::{ Column, Container, Expanded, MouseRegion, Row, SizedBox, Text };


entry fn tile(i: u64) -> opaque {
    let b = Container()
        .width_height(100.0, 100.0)
        .color(0x1E293BFF)
        .child(Text().text(f"tile {i}").font_size(12.0).build());
    return MouseRegion().cursor(CURSOR_POINTER).behavior(0).child(b.build()).build();
}

entry fn start() {
    let mut col = Column().cross_alignment(CROSS_ALIGN_CENTER);
    let row = Row().child(tile(0)).child(tile(1)).child(tile(2));
    col.child(SizedBox(400.0, 40.0).child(Container().build()).build());
    col.child(row.build());
    mount(Expanded().flex(1.0).child(col.build()).build());
}
