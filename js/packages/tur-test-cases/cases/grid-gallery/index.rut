// grid-gallery: "Grid Gallery" — the interactive tile gallery (the full
// boa port). The header (title + a live subtitle "tile #i · 1:1 ·
// maxExtent 150") sits above aspect chips (1:1 / 16:9 / 9:16), density
// chips (Dense / Normal / Sparse), and a styled scrollable tile grid with
// centered labels; tapping a tile paints its white selection ring and
// re-derives the subtitle.
//
// Reactivity: the Grid's max_cross / aspect rows are static per build, so
// the chips re-key ONE Switch over the COMBINED mode string
// ("1:1/150" …) whose nine lazy cases rebuild the grid fresh per mode
// (each activation reads live state). The case grid stays FLAT — a switch
// branch that mounts ANOTHER switch mid-flush would defer that inner
// switch's initial case activation (a known mounting-order gap), so the
// aspect × density matrix is spelled out instead of nested. Tile rings
// ride per-tile brush atoms (rs_set_brush); the subtitle's three
// fragments are 1-dep derives over the aspect / density / selection
// atoms.
//
// The child loop feeding `.child()` runs BEFORE the single `.build()`
// (build-then-mutate stays out; repetition is just the loop).
use tur::{
    ALIGN_CENTER, CROSS_ALIGN_START, CURSOR_POINTER, MAIN_SIZE_MIN, mount, rs_get_f64,
    rs_set_brush, rs_set_f64, rs_set_str, rs_source_f64, rs_source_str, stf_put, stf_take,
};
use tur_kit::{
    Column, Container, Expanded, Grid, MouseRegion, PointerInteract, Row, ScrollView, SizedBox,
    Switch, Text, rs_derive,
};


// The scalar-stash keys (atom ids + the ring brushes ride them; the 27
// ring brushes live at K_TILES + i).
let K_ASPECT: u64 = 1;
let K_MAXEXT: u64 = 2;
let K_SEL: u64 = 3;
let K_AKEY: u64 = 4;
let K_DKEY: u64 = 5;
let K_MODE: u64 = 6;
let K_A0: u64 = 7;
let K_A1: u64 = 8;
let K_A2: u64 = 9;
let K_D0: u64 = 10;
let K_D1: u64 = 11;
let K_D2: u64 = 12;
let K_PREV: u64 = 13;
let K_TILES: u64 = 100;

// The boa palette (deep slate page, indigo active chips).
let PAGE_BG: u64 = 0x0F172AFFu64;
let TITLE_FG: u64 = 0xF1F5F9FFu64;
let SUB_FG: u64 = 0x94A3B8FFu64;
let PANEL_BG: u64 = 0x020617FFu64;
let CHIP_ON: u64 = 0x6366F1FFu64;
let CHIP_OFF: u64 = 0x1E293BFFu64;
let CHIP_FG: u64 = 0xE2E8F0FFu64;
let LABEL_FG: u64 = 0xFFFFFFFFu64;
let RING_ON: u64 = 0xFFFFFFFFu64;

entry fn start() -> u64 {
    let aspect = rs_source_f64();
    rs_set_f64(aspect, 1.0);
    let maxext = rs_source_f64();
    rs_set_f64(maxext, 150.0);
    let sel = rs_source_f64();
    rs_set_f64(sel, 0.0);
    let akey = rs_source_str("1:1");
    let dkey = rs_source_str("150");
    let mode = rs_source_str("1:1/150");
    stf_put(K_ASPECT, aspect as f64);
    stf_put(K_MAXEXT, maxext as f64);
    stf_put(K_SEL, sel as f64);
    stf_put(K_AKEY, akey as f64);
    stf_put(K_DKEY, dkey as f64);
    stf_put(K_MODE, mode as f64);
    stf_put(K_PREV, 0.0);

    // The six chip brushes, seeded to the boot state (1:1 + Normal).
    let a0 = rs_source_f64();
    stf_put(K_A0, a0 as f64);
    let a1 = rs_source_f64();
    stf_put(K_A1, a1 as f64);
    let a2 = rs_source_f64();
    stf_put(K_A2, a2 as f64);
    let d0 = rs_source_f64();
    stf_put(K_D0, d0 as f64);
    let d1 = rs_source_f64();
    stf_put(K_D1, d1 as f64);
    let d2 = rs_source_f64();
    stf_put(K_D2, d2 as f64);
    paint_aspect_chips("1:1");
    paint_density_chips("150");

    // The subtitle fragments (three 1-dep derives over the state atoms).
    let d_tile = rs_derive(fmt_tile, sel);
    let d_aspect = rs_derive(fmt_aspect, aspect);
    let d_extent = rs_derive(fmt_extent, maxext);

    // The reactive grid: one Switch over the combined mode string — nine
    // lazy cases, each rebuilding the grid with its literal knobs (the
    // aspect × density matrix, kept FLAT — see the header note).
    let grid_switch = Switch()
        .value_source(mode)
        .case_build("1:1/95", fn () -> View { return gallery_grid(1.0, 95.0); })
        .case_build("1:1/150", fn () -> View { return gallery_grid(1.0, 150.0); })
        .case_build("1:1/220", fn () -> View { return gallery_grid(1.0, 220.0); })
        .case_build("16:9/95", fn () -> View { return gallery_grid(1.7777778, 95.0); })
        .case_build("16:9/150", fn () -> View { return gallery_grid(1.7777778, 150.0); })
        .case_build("16:9/220", fn () -> View { return gallery_grid(1.7777778, 220.0); })
        .case_build("9:16/95", fn () -> View { return gallery_grid(0.5625, 95.0); })
        .case_build("9:16/150", fn () -> View { return gallery_grid(0.5625, 150.0); })
        .case_build("9:16/220", fn () -> View { return gallery_grid(0.5625, 220.0); })
        .build();
    let panel = Container()
        .color(PANEL_BG)
        .radius(10.0)
        .padding(10.0)
        .child(ScrollView().child(grid_switch).build())
        .build();

    let col = Column()
        .cross_alignment(CROSS_ALIGN_START)
        .child(Text().text("Grid Gallery").font_size(18.0).color(TITLE_FG).query_key("gallery/title").build())
        .child(SizedBox(0.0, 4.0).build())
        .child(subtitle(d_tile, d_aspect, d_extent))
        .child(SizedBox(0.0, 12.0).build())
        .child(Row().main_axis_size(MAIN_SIZE_MIN)
            .child(chip(a0, "gallery/a-1-1", "1:1", b_a0)).child(SizedBox(6.0, 0.0).build())
            .child(chip(a1, "gallery/a-16-9", "16:9", b_a1)).child(SizedBox(6.0, 0.0).build())
            .child(chip(a2, "gallery/a-9-16", "9:16", b_a2))
            .build())
        .child(SizedBox(0.0, 8.0).build())
        .child(Row().main_axis_size(MAIN_SIZE_MIN)
            .child(chip(d0, "gallery/d-dense", "Dense", b_d0)).child(SizedBox(6.0, 0.0).build())
            .child(chip(d1, "gallery/d-normal", "Normal", b_d1)).child(SizedBox(6.0, 0.0).build())
            .child(chip(d2, "gallery/d-sparse", "Sparse", b_d2))
            .build())
        .child(SizedBox(0.0, 12.0).build())
        .child(Expanded().flex(1.0).child(panel).build())
        .build();

    mount(Container().color(PAGE_BG).padding(16.0).child(col).build());
    return sel;
}

// "tile #0 · 1:1 · maxExtent 150" — three live fragments.
fn subtitle(d_tile: u64, d_aspect: u64, d_extent: u64) -> opaque {
    return Row()
        .main_axis_size(MAIN_SIZE_MIN)
        .child(Text().text_bound_derived(d_tile).font_size(12.0).color(SUB_FG).query_key("gallery/subtitle").build())
        .child(Text().text(" · ").font_size(12.0).color(SUB_FG).build())
        .child(Text().text_bound_derived(d_aspect).font_size(12.0).color(SUB_FG).query_key("gallery/aspect-label").build())
        .child(Text().text(" · ").font_size(12.0).color(SUB_FG).build())
        .child(Text().text_bound_derived(d_extent).font_size(12.0).color(SUB_FG).query_key("gallery/extent").build())
        .build();
}

// The 27-tile gallery grid under one (aspect, max_cross) mode.
fn gallery_grid(aspect: f64, max_cross: f64) -> View {
    let mut grid = Grid().max_cross(max_cross).aspect(aspect).spacing(8.0, 8.0).query_key("gallery/grid");
    let mut i: u64 = 0;
    while (i < 27) {
        grid.child(tile(i));
        i = i + 1;
    }
    return grid.build();
}

// One tile: the hue face with a centered label, wrapped in the selection
// ring (a per-tile brush atom — white when selected, cleared otherwise).
fn tile(i: u64) -> opaque {
    let sel = stf_take(K_SEL) as u64;
    stf_put(K_SEL, sel as f64);
    let ring = rs_source_f64();
    rs_set_brush(ring, ring_color(rs_get_f64(sel) == i as f64));
    stf_put(K_TILES + i, ring as f64);
    let face = Container()
        .color(hsl_packed(i as f64 * 360.0 / 27.0, 58.0, 54.0))
        .radius(5.0)
        .alignment(ALIGN_CENTER)
        .child(Text().text(f"{i}").font_size(13.0).color(LABEL_FG).build())
        .build();
    let framed = Container()
        .color_bound(ring)
        .radius(8.0)
        .padding(3.0)
        .child(face)
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(PointerInteract().ids(i, i).on_tap(b_tile).child(framed).build())
        .build();
}

// A pill chip: the fill rides its brush atom (indigo when active).
fn chip(atom: u64, key: str, label: str, cb: fn(u64, u64, f64)) -> opaque {
    let face = Container()
        .padding(7.0)
        .radius(7.0)
        .color_bound(atom)
        .child(Text().text(label).font_size(12.0).color(CHIP_FG).build())
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(
            PointerInteract()
                .on_tap(cb)
                .query_key(key)
                .child(face)
                .build(),
        )
        .build();
}

// ---- the subtitle derive formats ---------------------------------------------

fn fmt_tile(v: f64) -> str {
    return f"tile #{v as u64}";
}

fn fmt_aspect(v: f64) -> str {
    if (v > 1.01) {
        return "16:9";
    }
    if (v < 0.99) {
        return "9:16";
    }
    return "1:1";
}

fn fmt_extent(v: f64) -> str {
    return f"maxExtent {v as u64}";
}

// ---- chip taps -----------------------------------------------------------------

fn b_a0(_a: u64, _b: u64, _n: f64) { set_aspect("1:1", 1.0); }
fn b_a1(_a: u64, _b: u64, _n: f64) { set_aspect("16:9", 16.0 / 9.0); }
fn b_a2(_a: u64, _b: u64, _n: f64) { set_aspect("9:16", 0.5625); }
fn b_d0(_a: u64, _b: u64, _n: f64) { set_density("95", 95.0); }
fn b_d1(_a: u64, _b: u64, _n: f64) { set_density("150", 150.0); }
fn b_d2(_a: u64, _b: u64, _n: f64) { set_density("220", 220.0); }

fn set_aspect(key: str, v: f64) {
    let akey = stf_take(K_AKEY) as u64;
    stf_put(K_AKEY, akey as f64);
    rs_set_str(akey, key);
    let mode = stf_take(K_MODE) as u64;
    stf_put(K_MODE, mode as f64);
    rs_set_str(mode, f"{key}/{rs_get_str(dkey_of())}");
    let aspect = stf_take(K_ASPECT) as u64;
    stf_put(K_ASPECT, aspect as f64);
    rs_set_f64(aspect, v);
    paint_aspect_chips(key);
}

fn set_density(key: str, v: f64) {
    let dkey = stf_take(K_DKEY) as u64;
    stf_put(K_DKEY, dkey as f64);
    rs_set_str(dkey, key);
    let mode = stf_take(K_MODE) as u64;
    stf_put(K_MODE, mode as f64);
    rs_set_str(mode, f"{rs_get_str(akey_of())}/{key}");
    let maxext = stf_take(K_MAXEXT) as u64;
    stf_put(K_MAXEXT, maxext as f64);
    rs_set_f64(maxext, v);
    paint_density_chips(key);
}

// The stash-held key atoms (read-only helpers for the mode composition).
fn dkey_of() -> u64 {
    let dkey = stf_take(K_DKEY) as u64;
    stf_put(K_DKEY, dkey as f64);
    return dkey;
}

fn akey_of() -> u64 {
    let akey = stf_take(K_AKEY) as u64;
    stf_put(K_AKEY, akey as f64);
    return akey;
}

// ---- tile taps -----------------------------------------------------------------

// A tile tap: move the selection ring and re-derive the subtitle.
fn b_tile(i: u64, _b: u64, _n: f64) {
    let sel = stf_take(K_SEL) as u64;
    stf_put(K_SEL, sel as f64);
    rs_set_f64(sel, i as f64);
    let prev = stf_take(K_PREV) as u64;
    stf_put(K_PREV, i as f64);
    ring_brush(prev, false);
    ring_brush(i, true);
}

// One ring brush repaint (the atom id rides the scalar stash).
fn ring_brush(i: u64, on: bool) {
    let atom = stf_take(K_TILES + i) as u64;
    stf_put(K_TILES + i, atom as f64);
    rs_set_brush(atom, ring_color(on));
}

fn ring_color(on: bool) -> u64 {
    if (on) {
        return RING_ON;
    }
    return 0x00000000u64;
}

// ---- the chip brushes ------------------------------------------------------------

fn paint_aspect_chips(sel: str) {
    paint_chip(K_A0, sel == "1:1");
    paint_chip(K_A1, sel == "16:9");
    paint_chip(K_A2, sel == "9:16");
}

fn paint_density_chips(sel: str) {
    paint_chip(K_D0, sel == "95");
    paint_chip(K_D1, sel == "150");
    paint_chip(K_D2, sel == "220");
}

fn paint_chip(key: u64, on: bool) {
    let atom = stf_take(key) as u64;
    stf_put(key, atom as f64);
    let mut c: u64 = CHIP_OFF;
    if (on) {
        c = CHIP_ON;
    }
    rs_set_brush(atom, c);
}

// ---- the tile ramp ---------------------------------------------------------------

// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).
fn hsl_packed(h: f64, s: f64, l: f64) -> u64 {
    let sat: f64 = s / 100.0;
    let light: f64 = l / 100.0;
    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;
    let hue: f64 = h % 360.0;
    let hp: f64 = hue / 60.0;
    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));
    let mut r1: f64 = 0.0;
    let mut g1: f64 = 0.0;
    let mut b1: f64 = 0.0;
    if (hp < 1.0) {
        r1 = c;
        g1 = x;
    } else if (hp < 2.0) {
        r1 = x;
        g1 = c;
    } else if (hp < 3.0) {
        g1 = c;
        b1 = x;
    } else if (hp < 4.0) {
        g1 = x;
        b1 = c;
    } else if (hp < 5.0) {
        r1 = x;
        b1 = c;
    } else {
        r1 = c;
        b1 = x;
    }
    let m: f64 = light - c / 2.0;
    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;
    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;
    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;
    return r * 16777216 + g * 65536 + b * 256 + 255;
}

fn abs_f(v: f64) -> f64 {
    if (v < 0.0) {
        return -v;
    }
    return v;
}
