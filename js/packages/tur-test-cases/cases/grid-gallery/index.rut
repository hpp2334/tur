// grid-gallery: "Grid Gallery" — the interactive tile gallery (the full
// boa port). The header (title + a live subtitle "tile #i · 1:1 ·
// maxExtent 150") sits above aspect chips (1:1 / 16:9 / 9:16), density
// chips (Dense / Normal / Sparse), and a styled scrollable tile grid with
// top-left labels (boa's alignment-less Container child); tapping a tile
// paints its white selection ring and re-derives the subtitle.
//
// Reactivity: the Grid's max_cross / aspect rows are static per build, so
// the chips re-key ONE Switch over the COMBINED mode string
// ("1:1/150" …) whose nine lazy cases rebuild the grid fresh per mode
// (each activation reads live state). The case grid stays FLAT — a switch
// branch that mounts ANOTHER switch mid-flush would defer that inner
// switch's initial case activation (a known mounting-order gap), so the
// aspect × density matrix is spelled out instead of nested. Tile rings
// ride per-tile brush sources (an array of handles the taps index); the
// subtitle's three fragments are derives over the aspect / density /
// selection sources.
//
// The child loop feeding `.child()` runs BEFORE the single `.build()`
// (build-then-mutate stays out; repetition is just the loop).
use tur::{ CROSS_ALIGN_START, CURSOR_POINTER, MAIN_SIZE_MIN, ctx_bridge, mount };
use tur_kit::{ Column, Container, DeriveCtx, Expanded, Grid, MouseRegion, Mutation, MutationCtx, PointerInteract, Readable, Row, ScrollView, SizedBox, Source, Switch, Text, derive, mutate, source };


// The boa palette (deep slate page, indigo active chips).
let PAGE_BG: u64 = 0x0F172AFFu64;
let TITLE_FG: u64 = 0xF1F5F9FFu64;
let SUB_FG: u64 = 0x94A3B8FFu64;
let PANEL_BG: u64 = 0x020617FFu64;
let CHIP_ON: u64 = 0x6366F1FFu64;
let CHIP_OFF: u64 = 0x1E293BFFu64;
let CHIP_FG: u64 = 0xE2E8F0FFu64;
let LABEL_FG: u64 = 0xFFFFFFFFu64;
let RING_ON: u64 = 0xFFFFFFFFu64;

entry fn start() -> u64 {
    let aspect: Readable<f64> = source<f64>(1.0);
    let maxext: Readable<f64> = source<f64>(150.0);
    let sel: Readable<f64> = source<f64>(0.0);
    let akey: Readable<str> = source<str>("1:1");
    let dkey: Readable<str> = source<str>("150");
    let mode: Readable<str> = source<str>("1:1/150");

    // The six chip brushes (the chip fills ride them).
    let a_chips: [Source<u64>] = [source<u64>(0), source<u64>(0), source<u64>(0)];
    let d_chips: [Source<u64>] = [source<u64>(0), source<u64>(0), source<u64>(0)];
    // The 27 tile selection rings (per-tile brush sources — the taps
    // index the array; the grid rebuilds re-bind the same handles).
    let rings: [Source<u64>] = [
        source<u64>(0), source<u64>(0), source<u64>(0), source<u64>(0), source<u64>(0),
        source<u64>(0), source<u64>(0), source<u64>(0), source<u64>(0), source<u64>(0),
        source<u64>(0), source<u64>(0), source<u64>(0), source<u64>(0), source<u64>(0),
        source<u64>(0), source<u64>(0), source<u64>(0), source<u64>(0), source<u64>(0),
        source<u64>(0), source<u64>(0), source<u64>(0), source<u64>(0), source<u64>(0),
        source<u64>(0), source<u64>(0),
    ];
    let boot: MutationCtx = MutationCtx.over(ctx_bridge());
    paint_chips(boot, a_chips, 0);
    paint_chips(boot, d_chips, 1);
    boot.set<u64>(rings[0], RING_ON);

    // The chip taps (each captures its handles + its literal knob).
    let b_a0 = set_aspect_mutation(aspect, akey, dkey, mode, a_chips, "1:1", 1.0, 0);
    let b_a1 = set_aspect_mutation(aspect, akey, dkey, mode, a_chips, "16:9", 16.0 / 9.0, 1);
    let b_a2 = set_aspect_mutation(aspect, akey, dkey, mode, a_chips, "9:16", 0.5625, 2);
    let b_d0 = set_density_mutation(maxext, akey, dkey, mode, d_chips, "95", 95.0, 0);
    let b_d1 = set_density_mutation(maxext, akey, dkey, mode, d_chips, "150", 150.0, 1);
    let b_d2 = set_density_mutation(maxext, akey, dkey, mode, d_chips, "220", 220.0, 2);

    // The subtitle fragments (three derives over the state sources).
    let d_tile: Readable<str> = derive<str>(fn (ctx: DeriveCtx) -> str {
        return f"tile #{ctx.get<f64>(sel) as u64}";
    });
    let d_aspect: Readable<str> = derive<str>(fn (ctx: DeriveCtx) -> str {
        let v = ctx.get<f64>(aspect);
        if (v > 1.01) {
            return "16:9";
        }
        if (v < 0.99) {
            return "9:16";
        }
        return "1:1";
    });
    let d_extent: Readable<str> = derive<str>(fn (ctx: DeriveCtx) -> str {
        return f"maxExtent {ctx.get<f64>(maxext) as u64}";
    });

    // The reactive grid: one Switch over the combined mode string — the
    // aspect × density matrix, kept FLAT (see the header note). The nine
    // grids build EAGERLY here (direct calls from start()'s body) and the
    // Switch re-keys over the pre-built views: a mutation box's capture
    // cell binds per CALL SITE, so the per-tile tap closures only get
    // their own index when the tile calls are unrolled literals in a
    // direct body — the lazy case_build indirection shared one cell (and
    // a loop shares it across every pad: each tap answering with the last
    // index). The ring/selection state rides the shared sources, so a
    // re-key re-mounts the pre-built grid with the live handles.
    let g_1_95 = gallery_grid(1.0, 95.0, rings, sel);
    let g_1_150 = gallery_grid(1.0, 150.0, rings, sel);
    let g_1_220 = gallery_grid(1.0, 220.0, rings, sel);
    let g_16_95 = gallery_grid(1.7777778, 95.0, rings, sel);
    let g_16_150 = gallery_grid(1.7777778, 150.0, rings, sel);
    let g_16_220 = gallery_grid(1.7777778, 220.0, rings, sel);
    let g_9_95 = gallery_grid(0.5625, 95.0, rings, sel);
    let g_9_150 = gallery_grid(0.5625, 150.0, rings, sel);
    let g_9_220 = gallery_grid(0.5625, 220.0, rings, sel);
    let grid_switch = Switch()
        .value(mode)
        .cases("1:1/95", g_1_95)
        .cases("1:1/150", g_1_150)
        .cases("1:1/220", g_1_220)
        .cases("16:9/95", g_16_95)
        .cases("16:9/150", g_16_150)
        .cases("16:9/220", g_16_220)
        .cases("9:16/95", g_9_95)
        .cases("9:16/150", g_9_150)
        .cases("9:16/220", g_9_220)
        .build();
    let panel = Container()
        .color(PANEL_BG)
        .radius(10.0)
        .padding(10.0)
        .child(ScrollView().child(grid_switch).build())
        .build();

    let col = Column()
        .cross_alignment(CROSS_ALIGN_START)
        .child(Text().text("Grid Gallery").font_size(18.0).color(TITLE_FG).query_key("gallery/title").build())
        .child(SizedBox(0.0, 4.0).build())
        .child(subtitle(d_tile, d_aspect, d_extent))
        .child(SizedBox(0.0, 12.0).build())
        .child(Row().main_axis_size(MAIN_SIZE_MIN)
            .child(chip(a_chips[0], "gallery/a-1-1", "1:1", b_a0)).child(SizedBox(6.0, 0.0).build())
            .child(chip(a_chips[1], "gallery/a-16-9", "16:9", b_a1)).child(SizedBox(6.0, 0.0).build())
            .child(chip(a_chips[2], "gallery/a-9-16", "9:16", b_a2))
            .build())
        .child(SizedBox(0.0, 8.0).build())
        .child(Row().main_axis_size(MAIN_SIZE_MIN)
            .child(chip(d_chips[0], "gallery/d-dense", "Dense", b_d0)).child(SizedBox(6.0, 0.0).build())
            .child(chip(d_chips[1], "gallery/d-normal", "Normal", b_d1)).child(SizedBox(6.0, 0.0).build())
            .child(chip(d_chips[2], "gallery/d-sparse", "Sparse", b_d2))
            .build())
        .child(SizedBox(0.0, 12.0).build())
        .child(Expanded().flex(1.0).child(panel).build())
        .build();

    mount(Container().color(PAGE_BG).padding(16.0).child(col).build());
    return sel.atom_id();
}

// "tile #0 · 1:1 · maxExtent 150" — three live fragments.
fn subtitle(d_tile: Readable<str>, d_aspect: Readable<str>, d_extent: Readable<str>) -> opaque {
    return Row()
        .main_axis_size(MAIN_SIZE_MIN)
        .child(Text().text_bound(d_tile).font_size(12.0).color(SUB_FG).query_key("gallery/subtitle").build())
        .child(Text().text(" · ").font_size(12.0).color(SUB_FG).build())
        .child(Text().text_bound(d_aspect).font_size(12.0).color(SUB_FG).query_key("gallery/aspect-label").build())
        .child(Text().text(" · ").font_size(12.0).color(SUB_FG).build())
        .child(Text().text_bound(d_extent).font_size(12.0).color(SUB_FG).query_key("gallery/extent").build())
        .build();
}

// The 27-tile gallery grid under one (aspect, max_cross) mode. The tile
// calls are UNROLLED literals (jigsaw's piece() law): the VM binds a
// closure's capture cell per CALL SITE, so a single call inside the loop
// would share one cell across every pad (each tap answering with the
// last index) — a literal per tile gives each pad its own index.
fn gallery_grid(aspect: f64, max_cross: f64, rings: [Source<u64>], sel: Readable<f64>) -> View {
    let mut grid = Grid().max_cross(max_cross).aspect(aspect).spacing(8.0, 8.0).query_key("gallery/grid");
    grid.child(tile([0.0], rings, sel));
    grid.child(tile([1.0], rings, sel));
    grid.child(tile([2.0], rings, sel));
    grid.child(tile([3.0], rings, sel));
    grid.child(tile([4.0], rings, sel));
    grid.child(tile([5.0], rings, sel));
    grid.child(tile([6.0], rings, sel));
    grid.child(tile([7.0], rings, sel));
    grid.child(tile([8.0], rings, sel));
    grid.child(tile([9.0], rings, sel));
    grid.child(tile([10.0], rings, sel));
    grid.child(tile([11.0], rings, sel));
    grid.child(tile([12.0], rings, sel));
    grid.child(tile([13.0], rings, sel));
    grid.child(tile([14.0], rings, sel));
    grid.child(tile([15.0], rings, sel));
    grid.child(tile([16.0], rings, sel));
    grid.child(tile([17.0], rings, sel));
    grid.child(tile([18.0], rings, sel));
    grid.child(tile([19.0], rings, sel));
    grid.child(tile([20.0], rings, sel));
    grid.child(tile([21.0], rings, sel));
    grid.child(tile([22.0], rings, sel));
    grid.child(tile([23.0], rings, sel));
    grid.child(tile([24.0], rings, sel));
    grid.child(tile([25.0], rings, sel));
    grid.child(tile([26.0], rings, sel));
    return grid.build();
}

// One tile: the hue face with a top-left label (boa's tile — the Text is
// an alignment-less Container child), wrapped in the selection ring (the
// tile's own brush source — white when selected, cleared otherwise). The
// tap captures the ring array + the selection source. The index rides the
// one-slot array param — each call site passes a DISTINCT literal (the
// capture law: the VM binds a closure's cell per call site, so a loop
// would point every pad at the last iteration's cell).
fn tile(ii: [f64], rings: [Source<u64>], sel: Readable<f64>) -> opaque {
    let i: u64 = ii[0] as u64;
    let b_tap = mutate(fn (ctx: MutationCtx, _e: nil) {
        let prev = ctx.get<f64>(sel) as i32;
        ctx.set<u64>(rings[prev], 0x00000000u64);
        ctx.set<f64>(sel, ii[0]);
        ctx.set<u64>(rings[ii[0] as i32], RING_ON);
    });
    let face = Container()
        .color(hsl_packed(i as f64 * 360.0 / 27.0, 58.0, 54.0))
        .radius(5.0)
        .child(Text().text(f"{i}").font_size(13.0).color(LABEL_FG).build())
        .build();
    let framed = Container()
        .color_bound(rings[i as i32])
        .radius(8.0)
        .padding(3.0)
        .child(face)
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(PointerInteract().on_click(b_tap).child(framed).build())
        .build();
}

// A pill chip: the fill rides its brush source (indigo when active).
fn chip(r: Readable<u64>, key: str, label: str, m: Mutation<nil>) -> opaque {
    let face = Container()
        .padding(7.0)
        .radius(7.0)
        .color_bound(r)
        .child(Text().text(label).font_size(12.0).color(CHIP_FG).build())
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(
            PointerInteract()
                .on_click(m)
                .query_key(key)
                .child(face)
                .build(),
        )
        .build();
}

// ---- the chip taps -------------------------------------------------------------

// One aspect chip's mutation: write the key + the recomposed mode string +
// the aspect value, then repaint the trio.
fn set_aspect_mutation(aspect: Readable<f64>, akey: Readable<str>, dkey: Readable<str>,
                       mode: Readable<str>, chips: [Source<u64>], key: str, v: f64,
                       on_idx: u64) -> Mutation<nil> {
    return mutate(fn (ctx: MutationCtx, _e: nil) {
        ctx.set<str>(akey, key);
        ctx.set<str>(mode, f"{key}/{ctx.get<str>(dkey)}");
        ctx.set<f64>(aspect, v);
        paint_chips(ctx, chips, on_idx);
    });
}

// One density chip's mutation (the mirror twin).
fn set_density_mutation(maxext: Readable<f64>, akey: Readable<str>, dkey: Readable<str>,
                        mode: Readable<str>, chips: [Source<u64>], key: str, v: f64,
                        on_idx: u64) -> Mutation<nil> {
    return mutate(fn (ctx: MutationCtx, _e: nil) {
        ctx.set<str>(dkey, key);
        ctx.set<str>(mode, f"{ctx.get<str>(akey)}/{key}");
        ctx.set<f64>(maxext, v);
        paint_chips(ctx, chips, on_idx);
    });
}

// Paint a chip trio: the active index indigo, the others slate.
fn paint_chips(ctx: MutationCtx, chips: [Source<u64>], on_idx: u64) {
    let mut i: i32 = 0;
    while (i < 3) {
        let mut c: u64 = CHIP_OFF;
        if (i as u64 == on_idx) {
            c = CHIP_ON;
        }
        ctx.set<u64>(chips[i], c);
        i = i + 1;
    }
}

// ---- the tile ramp -------------------------------------------------------------

// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).
fn hsl_packed(h: f64, s: f64, l: f64) -> u64 {
    let sat: f64 = s / 100.0;
    let light: f64 = l / 100.0;
    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;
    let hue: f64 = h % 360.0;
    let hp: f64 = hue / 60.0;
    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));
    let mut r1: f64 = 0.0;
    let mut g1: f64 = 0.0;
    let mut b1: f64 = 0.0;
    if (hp < 1.0) {
        r1 = c;
        g1 = x;
    } else if (hp < 2.0) {
        r1 = x;
        g1 = c;
    } else if (hp < 3.0) {
        g1 = c;
        b1 = x;
    } else if (hp < 4.0) {
        g1 = x;
        b1 = c;
    } else if (hp < 5.0) {
        r1 = x;
        b1 = c;
    } else {
        r1 = c;
        b1 = x;
    }
    let m: f64 = light - c / 2.0;
    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;
    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;
    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;
    return r * 16777216 + g * 65536 + b * 256 + 255;
}

fn abs_f(v: f64) -> f64 {
    if (v < 0.0) {
        return -v;
    }
    return v;
}
