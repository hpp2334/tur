// lazy-list-var-sizes: an unmeasured (var-extent) LazyList — rows report
// their own heights (deterministic per-index sizes).
use tur::{ mount, rs_set_f64, rs_source_f64 };
use tur_kit::{ Container, LazyList, Text };


entry fn row(i: u64) -> opaque {
    let h = ((i * 37) % 120) as f64 + 30.0;
    let mut b = Container.new();
    b.width_height(400.0, h);
    b.color(0x0B1220FF);
    let mut label = Text.new();

    label.text(f"#{i} h={h as u64}");
    label.font_size(11.0);
    b.child(label.build());
    return b.build();
}

entry fn start() {
    let count = rs_source_f64();
    rs_set_f64(count, 500.0);
    // itemExtent 0 = unmeasured (var sizes).
    let mut list = LazyList.new().item_builder("row").count(count).query_key("lazy-list-var-sizes").build();
    mount(list);
}
