// lazy-list-row: a 50-item HORIZONTAL virtualized list (80px columns).
use tur::{ el_box_new, box_color, box_size, el_build, el_lazy_list_h, el_vqkey, mount, rs_set_f64, rs_source_f64 };

entry fn item(i: u64) -> opaque {
    let b = el_box_new();
    box_size(b, 80.0, 300.0);
    if (i % 2 == 0) {
        box_color(b, 0x303030FF);
    } else {
        box_color(b, 0x1A1A1AFF);
    }
    return el_build(b);
}

entry fn start() {
    let count = rs_source_f64();
    rs_set_f64(count, 50.0);
    let list = el_lazy_list_h("item", count, 80.0);
    mount(el_vqkey(list, "lazy-list-row"));
}
