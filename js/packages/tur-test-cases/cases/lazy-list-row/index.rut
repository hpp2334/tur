// lazy-list-row: a 50-item HORIZONTAL virtualized list (80px columns).
use tur::{ AXIS_HORIZONTAL, mount, rs_set_f64, rs_source_f64 };
use tur_kit::{ Container, LazyList };


entry fn item(i: u64) -> opaque {
    let mut b = Container.new();
    b.width_height(80.0, 300.0);
    if (i % 2 == 0) {
        b.color(0x303030FF);
    } else {
        b.color(0x1A1A1AFF);
    }
    return b.build();
}

entry fn start() {
    let count = rs_source_f64();
    rs_set_f64(count, 50.0);
    let mut list = LazyList.new().item_builder("item").count(count).axis(AXIS_HORIZONTAL).item_extent(80.0).query_key("lazy-list-row").build();
    mount(list);
}
