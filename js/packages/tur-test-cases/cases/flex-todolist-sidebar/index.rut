// flex-todolist-sidebar: the todolist two-pane shell — a 200px tab
// sidebar beside a padded content column.
use tur::{ CROSS_ALIGN_CENTER, MAIN_ALIGN_SPACE_BETWEEN, mount };
use tur_kit::{ Column, Container, Row, Text };


entry fn start() {
    let mut row = Row.new();
    // Sidebar: one active tab pill.
    let mut sidebar = Container.new();
    sidebar.color(0x1A1A2EFF);
    sidebar.width_height(200.0, 0.0);
    let mut tabs = Column.new();
    let mut tab = Container.new();
    tab.color(0x0F3460FF);
    tab.padding(12.0);
    let mut label = Text.new();

    label.text("TodoList");
    label.font_size(14.0);
    tab.child(label.build());
    tabs.child(tab.build());
    sidebar.child(tabs.build());
    row.child(sidebar.build());
    // Content: heading + list shell.
    let mut content = Container.new();
    content.padding(16.0);
    let mut col = Column.new();
    col.cross_alignment(CROSS_ALIGN_CENTER);
    let mut heading = Text.new();

    heading.text("Todo List");
    heading.font_size(24.0);
    col.child(heading.build());
    col.child(box_h(16.0));
    let mut list = Column.new();
    let mut item = Row.new();
    item.main_alignment(MAIN_ALIGN_SPACE_BETWEEN);
    item.child(Text.new().text("Buy milk").build());
    list.child(item.build());
    col.child(list.build());
    content.child(col.build());
    row.child(content.build());
    mount(row.build());
}

fn box_h(h: f64) -> opaque {
    let mut b = Container.new();
    b.width_height(0.0, h);
    return b.build();
}
