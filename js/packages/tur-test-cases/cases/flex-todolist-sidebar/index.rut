// flex-todolist-sidebar: the todolist two-pane shell — a 200px tab
// sidebar beside a padded content column.
use tur::{ CROSS_ALIGN_CENTER, MAIN_ALIGN_SPACE_BETWEEN, el_box_new, box_align, box_color, box_padding, box_size, el_build, el_child, el_column, el_row, el_text_new, flex_cross_align, flex_main_align, text_size, mount };

entry fn start() {
    let row = el_row();
    // Sidebar: one active tab pill.
    let sidebar = el_box_new();
    box_color(sidebar, 0x1A1A2EFF);
    box_size(sidebar, 200.0, 0.0);
    let tabs = el_column();
    let tab = el_box_new();
    box_color(tab, 0x0F3460FF);
    box_padding(tab, 12.0);
    let label = el_text_new("TodoList");
    text_size(label, 14.0);
    el_child(tab, el_build(label));
    el_child(tabs, el_build(tab));
    el_child(sidebar, el_build(tabs));
    el_child(row, el_build(sidebar));
    // Content: heading + list shell.
    let content = el_box_new();
    box_padding(content, 16.0);
    let col = el_column();
    flex_cross_align(col, CROSS_ALIGN_CENTER);
    let heading = el_text_new("Todo List");
    text_size(heading, 24.0);
    el_child(col, el_build(heading));
    el_child(col, box_h(16.0));
    let list = el_column();
    let item = el_row();
    flex_main_align(item, MAIN_ALIGN_SPACE_BETWEEN);
    el_child(item, el_build(el_text_new("Buy milk")));
    el_child(list, el_build(item));
    el_child(col, el_build(list));
    el_child(content, el_build(col));
    el_child(row, el_build(content));
    mount(el_build(row));
}

fn box_h(h: f64) -> opaque {
    let b = el_box_new();
    box_size(b, 0.0, h);
    return el_build(b);
}
