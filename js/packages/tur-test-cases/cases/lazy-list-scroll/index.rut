// lazy-list-scroll: a 100-row virtualized list (wheeling mounts rows
// outside the initial build set).
use tur::mount;
use tur_kit::{ Container, LazyList, Source, source };


fn row(i: u64) -> opaque {
    let mut b = Container().width_height(400.0, 50.0);
    if (i % 2 == 0) {
        b.color(0x303030FF);
    } else {
        b.color(0x1A1A1AFF);
    }
    return b.build();
}

entry fn start() {
    let count = source<f64>(100.0);
    let list = LazyList().item_builder(row).count(count).item_extent(50.0).query_key("lazy-list-scroll").build();
    mount(list);
}
