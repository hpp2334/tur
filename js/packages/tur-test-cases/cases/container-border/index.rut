// container-border: explicit size + padding + color + inside border +
// radius around a Text.
use tur::{ BORDER_INSIDE, mount };
use tur_kit::{ Container, Text };


entry fn start() {
    let mut b = Container.new();
    b.width_height(200.0, 200.0);
    b.padding(16.0);
    b.color(0xFFFFFFFFu64);
    b.border(0x000000FFu64, 2.0, BORDER_INSIDE);
    b.radius(8.0);
    let mut label = Text.new();

    label.text("Border");
    label.font_size(16.0);
    b.child(label.build());
    b.query_key("border-container");
    mount(b.build());
}
