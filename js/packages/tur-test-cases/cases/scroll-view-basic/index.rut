// scroll-view-basic: a vertical scroll viewport around a 3x200 column.
use tur::{ AXIS_VERTICAL, CROSS_ALIGN_STRETCH, mount };
use tur_kit::{ Column, Container, ScrollView };


entry fn start() {
    let mut content = Column.builder();
    content.cross_alignment(CROSS_ALIGN_STRETCH);
    content.child(box_h(200.0));
    content.child(box_h(200.0));
    content.child(box_h(200.0));
    let mut sv = ScrollView.builder().axis(AXIS_VERTICAL).child(content.build()).query_key("scroll-view").build();
    mount(sv);
}

fn box_h(h: f64) -> opaque {
    let mut b = Container.builder();
    b.width_height(0.0, h);
    return b.build();
}
