// input-multiline: a multiline editable with an explicit size.
use tur::{ mount, tctrl_new, undo_new };
use tur_kit::{ Container, Input };


entry fn start() {
    let ctrl = tctrl_new();
    let undo = undo_new();
    let outer = Container()
        .child(Input().controller(ctrl).undo(undo).width_height(300.0, 400.0).multiline(true).build());
    mount(outer.build());
}
