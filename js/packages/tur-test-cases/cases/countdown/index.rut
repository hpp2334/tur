// countdown: a 1 Hz countdown with start/pause/reset, an edit modal (a
// pre-filled Input + confirm), and a ticking display derived from the
// remaining atom. The ticker is an async loop over `sleep(1000)` with a
// generation guard (a stale loop exits when a new start supersedes it).
// State atom ids ride the scalar stash (stf_*).
//
// The boa design: a light slate page with the 96px display centered in
// the pane, a "● Ready/Running" status pill, a big emerald Start that
// swaps to an amber Pause (a Condition on the running atom; the Start
// label re-derives to "Restart" once drained), ghost Edit/Reset buttons,
// and a scrim modal. The modal rides `then_build(edit_modal)` — the
// branch builder runs at ACTIVATION, so it mints the text controller
// pre-filled with the live `initial` (the old boot-time pre-build +
// `b_edit` re-seed workaround is gone).
use futures::{ launch_future, sleep };
use tur::{
    ALIGN_CENTER, BORDER_INSIDE, CROSS_ALIGN_CENTER, CROSS_ALIGN_STRETCH, CURSOR_POINTER,
    HIT_TEST_OPAQUE, MAIN_ALIGN_END, MAIN_SIZE_MIN, STACK_FIT_EXPAND, mem_get, mem_new, mem_set,
    mount, rs_get_bool, rs_get_f64, rs_set_bool, rs_set_f64, rs_source_bool, rs_source_f64,
    st_put, st_take, stf_put, stf_take, str_parse_f64, tctrl_new, tctrl_set_text, tctrl_text,
    undo_new,
};
use tur_kit::{
    Column, Condition, Container, Input, MouseRegion, PointerInteract, Row, SizedBox, Stack, Text,
    rs_derive,
};


let K_CTRL: u64 = 2;
let K_EDITING: u64 = 4;
let K_INITIAL: u64 = 5;
let K_GEN: u64 = 6;
let K_RUNNING: u64 = 7;
let K_REMAINING: u64 = 8;

// The light-slate palette (the boa countdown).
let PAGE_BG: u64 = 0xF8FAFCFFu64;
let CARD_BG: u64 = 0xFFFFFFFFu64;
let CARD_BORDER: u64 = 0xE2E8F0FFu64;
let TEXT: u64 = 0x0F172AFFu64;
let TEXT_MUTED: u64 = 0x64748BFFu64;
let TEXT_FAINT: u64 = 0x94A3B8FFu64;
let BTN_FG: u64 = 0xFFFFFFFFu64;
let START: u64 = 0x10B981FFu64;
let START_SHADOW: u64 = 0x10B9815Au64;
let PAUSE: u64 = 0xF59E0BFFu64;
let PAUSE_SHADOW: u64 = 0xF59E0B5Au64;
let BACKDROP: u64 = 0x0F172A6Eu64;

entry fn start() -> u64 {
    let remaining = rs_source_f64();
    rs_set_f64(remaining, 60.0);
    let initial = rs_source_f64();
    rs_set_f64(initial, 60.0);
    let running = rs_source_bool(false);
    let editing = rs_source_bool(false);
    stf_put(K_REMAINING, remaining as f64);
    stf_put(K_INITIAL, initial as f64);
    stf_put(K_RUNNING, running as f64);
    stf_put(K_EDITING, editing as f64);

    let display = rs_derive(fmt_display, remaining);
    let start_label = rs_derive(fmt_start_label, remaining);

    st_put(K_GEN, mem_new(0.0));

    let edit_button = ghost_button("btn-edit", "Edit", b_edit, initial, editing);
    let reset_button = ghost_button("btn-reset", "Reset", b_reset, initial, remaining);

    // The primary action: amber Pause while running, emerald
    // Start/Restart otherwise (the label re-derives over `remaining`).
    let primary = Condition(running)
        .then_build(fn () -> View { return pad("btn-pause", "Pause", PAUSE, PAUSE_SHADOW, b_pause); })
        .else_build(fn () -> View { return start_pad(start_label, b_start); })
        .build();

    // The status pill: a green dot + "Running" while ticking, muted +
    // "Ready" otherwise.
    let status = Condition(running)
        .then_build(fn () -> View { return chip_status(true); })
        .else_build(fn () -> View { return chip_status(false); })
        .build();

    // The edit modal overlays the pane while `editing` is set.
    let modal = Condition(editing)
        .then_build(fn () -> View { return edit_modal(); })
        .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })
        .build();

    let pane = Column()
        .main_axis_size(MAIN_SIZE_MIN)
        .cross_alignment(CROSS_ALIGN_CENTER)
        .child(Text().text("COUNTDOWN").font_size(11.0).color(TEXT_FAINT).build())
        .child(SizedBox(0.0, 10.0).build())
        .child(Text().text_bound_derived(display).font_size(96.0).color(TEXT).query_key("display").build())
        .child(SizedBox(0.0, 12.0).build())
        .child(status)
        .child(SizedBox(0.0, 36.0).build())
        .child(primary)
        .child(SizedBox(0.0, 12.0).build())
        .child(
            Row()
                .main_axis_size(MAIN_SIZE_MIN)
                .cross_alignment(CROSS_ALIGN_CENTER)
                .child(edit_button)
                .child(SizedBox(10.0, 0.0).build())
                .child(reset_button)
                .build(),
        )
        .build();

    // The pane centered in the viewer; the modal overlays it when open.
    let page = Container().color(PAGE_BG).alignment(ALIGN_CENTER).child(pane).build();
    mount(Stack().fit(STACK_FIT_EXPAND).child(page).child(modal).build());
    return remaining;
}

// ---- the styled pieces -------------------------------------------------------

// The big rounded primary button (the boa PrimaryButton).
fn pad(key: str, label: str, bg: u64, shade: u64, cb: fn(u64, u64, f64)) -> opaque {
    let face = Container()
        .width_height(220.0, 48.0)
        .radius(12.0)
        .color(bg)
        .shadow(shade, 14.0, 0.0, 6.0)
        .alignment(ALIGN_CENTER)
        .child(Text().text(label).font_size(15.0).color(BTN_FG).build())
        .build();
    return PointerInteract()
        .on_tap(cb)
        .query_key(key)
        .child(face)
        .build();
}

// The Start pad: the label rides the derive ("Restart" once drained).
fn start_pad(label_atom: u64, cb: fn(u64, u64, f64)) -> opaque {
    let face = Container()
        .width_height(220.0, 48.0)
        .radius(12.0)
        .color(START)
        .shadow(START_SHADOW, 14.0, 0.0, 6.0)
        .alignment(ALIGN_CENTER)
        .child(Text().text_bound_derived(label_atom).font_size(15.0).color(BTN_FG).build())
        .build();
    return PointerInteract()
        .on_tap(cb)
        .query_key("btn-start")
        .child(face)
        .build();
}

// The bordered ghost button (the boa GhostButton).
fn ghost_button(key: str, label: str, cb: fn(u64, u64, f64), a: u64, b: u64) -> opaque {
    let face = Container()
        .padding(10.0)
        .radius(10.0)
        .border(CARD_BORDER, 1.0, BORDER_INSIDE)
        .color(CARD_BG)
        .child(Text().text(label).font_size(13.0).color(TEXT_MUTED).build())
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(
            PointerInteract()
                .ids(a, b)
                .on_tap(cb)
                .query_key(key)
                .child(face)
                .build(),
        )
        .build();
}

// The "● Ready/Running" pill: a dot + label in a bordered capsule.
fn chip_status(running: bool) -> opaque {
    let mut dot: u64 = TEXT_MUTED;
    let mut label: str = "Ready";
    if (running) {
        dot = START;
        label = "Running";
    }
    return Container()
        .padding(6.0)
        .radius(999.0)
        .border(CARD_BORDER, 1.0, BORDER_INSIDE)
        .color(CARD_BG)
        .child(
            Row()
                .main_axis_size(MAIN_SIZE_MIN)
                .cross_alignment(CROSS_ALIGN_CENTER)
                .child(Container().width_height(7.0, 7.0).radius(999.0).color(dot).build())
                .child(SizedBox(6.0, 0.0).build())
                .child(Text().text(label).font_size(11.0).color(TEXT_MUTED).build())
                .build(),
        )
        .build();
}

// The edit modal: a dimmed scrim (tap = cancel) around the card; the card
// swallows its own taps. Runs at ACTIVATION — the controller is minted
// fresh and pre-filled with the live `initial`.
fn edit_modal() -> opaque {
    let initial = stf_take(K_INITIAL) as u64;
    stf_put(K_INITIAL, initial as f64);
    let ctrl = tctrl_new();
    tctrl_set_text(ctrl, f"{rs_get_f64(initial) as u64}");
    st_put(K_CTRL, ctrl);

    let undo = undo_new();
    let field = Input()
        .controller(ctrl)
        .undo(undo)
        .placeholder("Positive integer")
        .font_size(14.0)
        .width_height(332.0, 32.0)
        .query_key("edit-input")
        .build();

    let card = Container()
        .width(380.0)
        .radius(14.0)
        .padding(22.0)
        .color(CARD_BG)
        .border(CARD_BORDER, 1.0, BORDER_INSIDE)
        .child(
            Column()
                .main_axis_size(MAIN_SIZE_MIN)
                .cross_alignment(CROSS_ALIGN_STRETCH)
                .child(Text().text("Set duration").font_size(18.0).color(TEXT).build())
                .child(SizedBox(0.0, 6.0).build())
                .child(Text().text("Enter a positive integer (seconds).").font_size(13.0).color(TEXT_MUTED).build())
                .child(SizedBox(0.0, 16.0).build())
                .child(
                    Container()
                        .padding(4.0)
                        .radius(8.0)
                        .border(CARD_BORDER, 1.0, BORDER_INSIDE)
                        .child(field)
                        .build(),
                )
                .child(SizedBox(0.0, 18.0).build())
                .child(
                    Row()
                        .main_alignment(MAIN_ALIGN_END)
                        .main_axis_size(MAIN_SIZE_MIN)
                        .child(ghost_button("btn-cancel", "Cancel", b_cancel, 0, 0))
                        .child(SizedBox(8.0, 0.0).build())
                        .child(
                            MouseRegion()
                                .cursor(CURSOR_POINTER)
                                .child(
                                    PointerInteract()
                                        .on_tap(b_confirm)
                                        .query_key("btn-confirm")
                                        .child(
                                            Container()
                                                .width_height(220.0, 48.0)
                                                .radius(12.0)
                                                .color(START)
                                                .shadow(START_SHADOW, 14.0, 0.0, 6.0)
                                                .alignment(ALIGN_CENTER)
                                                .child(Text().text("Save").font_size(15.0).color(BTN_FG).build())
                                                .build(),
                                        )
                                        .build(),
                                )
                                .build(),
                        )
                        .build(),
                )
                .build(),
        )
        .build();

    let inner = PointerInteract()
        .behavior(HIT_TEST_OPAQUE)
        .on_tap(b_swallow)
        .child(card)
        .build();
    let scrim = Container()
        .color(BACKDROP)
        .alignment(ALIGN_CENTER)
        .child(inner)
        .build();
    return PointerInteract()
        .behavior(HIT_TEST_OPAQUE)
        .on_tap(b_cancel)
        .query_key("edit-modal")
        .child(scrim)
        .build();
}

// ---- the display + label derives ----------------------------------------------

// "m:ss" display format.
fn fmt_display(v: f64) -> str {
    let total = v as u64;
    let m = total / 60;
    let s = total % 60;
    if (s < 10) {
        return f"{m}:0{s}";
    }
    return f"{m}:{s}";
}

// The primary label under the else branch: "Restart" once drained.
fn fmt_start_label(v: f64) -> str {
    if (v == 0.0) {
        return "Restart";
    }
    return "Start";
}

// ---- the 1 Hz ticker ------------------------------------------------------------

// `g` pins the generation: a stale loop (superseded by a later start /
// pause) exits without ticking. The running-atom id is taken and restored
// IMMEDIATELY — the slot must stay populated across the awaits, or a tap
// handler firing mid-tick reads an empty slot (0) and writes to atom 0.
async fn ticker(g: f64) -> str {
    let running = stf_take(K_RUNNING) as u64;
    stf_put(K_RUNNING, running as f64);
    while (rs_get_bool(running)) {
        await sleep(1000);
        if (gen_read() != g) {
            return "";
        }
        if (!rs_get_bool(running)) {
            return "";
        }
        let remaining = stf_take(K_REMAINING) as u64;
        stf_put(K_REMAINING, remaining as f64);
        let r = rs_get_f64(remaining);
        if (r <= 1.0) {
            rs_set_f64(remaining, 0.0);
            rs_set_bool(running, false);
            return "";
        }
        rs_set_f64(remaining, r - 1.0);
    }
    return "";
}

fn gen_read() -> f64 {
    let cell = st_take(K_GEN);
    let v = mem_get(cell);
    st_put(K_GEN, cell);
    return v;
}

fn gen_bump() -> f64 {
    let cell = st_take(K_GEN);
    let g = mem_get(cell) + 1.0;
    mem_set(cell, g);
    st_put(K_GEN, cell);
    return g;
}

// ---- the taps -------------------------------------------------------------------

fn b_start(_a: u64, _b: u64, _n: f64) {
    let running = stf_take(K_RUNNING) as u64;
    if (rs_get_bool(running)) {
        stf_put(K_RUNNING, running as f64);
        return;
    }
    rs_set_bool(running, true);
    stf_put(K_RUNNING, running as f64);
    launch_future(ticker(gen_bump()));
}

fn b_pause(_a: u64, _b: u64, _n: f64) {
    let running = stf_take(K_RUNNING) as u64;
    rs_set_bool(running, false);
    stf_put(K_RUNNING, running as f64);
    gen_bump();
}

fn b_reset(initial: u64, remaining: u64, _n: f64) {
    let running = stf_take(K_RUNNING) as u64;
    rs_set_bool(running, false);
    stf_put(K_RUNNING, running as f64);
    gen_bump();
    rs_set_f64(remaining, rs_get_f64(initial));
}

// Open the editor: stop the clock; the modal branch builds fresh (and
// pre-seeds its controller) at activation.
fn b_edit(initial: u64, editing: u64, _n: f64) {
    let running = stf_take(K_RUNNING) as u64;
    rs_set_bool(running, false);
    stf_put(K_RUNNING, running as f64);
    gen_bump();
    rs_set_bool(editing, true);
}

fn b_cancel(_a: u64, _b: u64, _n: f64) {
    let editing = stf_take(K_EDITING) as u64;
    rs_set_bool(editing, false);
    stf_put(K_EDITING, editing as f64);
}

// Clicks inside the card stop at the card (the scrim's cancel never sees them).
fn b_swallow(_a: u64, _b: u64, _n: f64) {}

fn b_confirm(_a: u64, _b: u64, _n: f64) {
    let ctrl = st_take(K_CTRL);
    let v = str_parse_f64(tctrl_text(ctrl));
    let initial = stf_take(K_INITIAL) as u64;
    rs_set_f64(initial, v);
    stf_put(K_INITIAL, initial as f64);
    let remaining = stf_take(K_REMAINING) as u64;
    rs_set_f64(remaining, v);
    stf_put(K_REMAINING, remaining as f64);
    let editing = stf_take(K_EDITING) as u64;
    rs_set_bool(editing, false);
    stf_put(K_EDITING, editing as f64);
}
