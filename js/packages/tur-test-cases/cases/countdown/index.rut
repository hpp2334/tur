// countdown: a 1 Hz countdown with start/pause/reset, an edit modal (a
// pre-filled Input + confirm), and a ticking display derived from the
// remaining atom. The ticker is an async loop over `sleep(1000)` with a
// generation guard (a stale loop exits when a new start supersedes it).
// State atom ids ride the scalar stash (stf_*).
use core::RunContext;
use async_host::{ launch_future, sleep };
use tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, MAIN_ALIGN_CENTER, box_align, box_color, box_padding, box_radius, box_size, el_box_new, el_build, el_child, el_column, el_input, el_pi, el_qkey, el_row, el_text_bound_d, el_text_new, el_vqkey, flex_cross_align, flex_main_align, mem_get, mem_new, mem_set, mount, condition, rs_derive, rs_get_bool, rs_get_f64, rs_set_bool, rs_set_f64, rs_source_bool, rs_source_f64, str_parse_f64, st_put, st_take, stf_put, stf_take, tctrl_new, tctrl_set_text, tctrl_text, undo_new };

let K_GEN: u64 = 1;
let K_CTRL: u64 = 2;
let K_REMAINING: u64 = 3;
let K_INITIAL: u64 = 4;
let K_RUNNING: u64 = 5;
let K_EDITING: u64 = 6;

entry fn start() -> u64 {
    let remaining = rs_source_f64();
    rs_set_f64(remaining, 60.0);
    let initial = rs_source_f64();
    rs_set_f64(initial, 60.0);
    let running = rs_source_bool(false);
    let editing = rs_source_bool(false);
    stf_put(K_REMAINING, remaining as f64);
    stf_put(K_INITIAL, initial as f64);
    stf_put(K_RUNNING, running as f64);
    stf_put(K_EDITING, editing as f64);
    st_put(K_GEN, mem_new(0.0));

    let display = rs_derive("fmt_display", remaining);

    let col = el_column();
    flex_cross_align(col, CROSS_ALIGN_CENTER);

    let display_t = el_vqkey(el_text_bound_d(display), "display");
    el_child(col, display_t);

    let row = el_row();
    flex_main_align(row, MAIN_ALIGN_CENTER);
    el_child(row, button("btn-start", "Start", "b_start", running, running));
    el_child(row, button("btn-pause", "Pause", "b_pause", running, running));
    el_child(row, button("btn-reset", "Reset", "b_reset", initial, remaining));
    el_child(row, button("btn-edit", "Edit", "b_edit", initial, editing));
    el_child(col, el_build(row));

    // The edit modal overlay (both branches authored at start).
    let modal = build_modal(initial, remaining);
    let empty = el_box_new();
    el_child(col, condition(editing, modal, el_build(empty)));

    mount(el_build(col));
    return remaining;
}

// A pill button with a query key; both atoms cross to the entry.
fn button(key: str, label: str, cb: str, a: u64, b: u64) -> opaque {
    let bld = el_box_new();
    box_size(bld, 90.0, 40.0);
    box_color(bld, 0x6366F1FF);
    box_align(bld, ALIGN_CENTER);
    box_radius(bld, 8.0);
    el_qkey(bld, key);
    el_child(bld, el_build(el_text_new(label)));
    return el_pi(a, b, cb, "", 0, "", el_build(bld));
}

// The edit modal: a centered card with a pre-filled Input + confirm.
fn build_modal(initial: u64, remaining: u64) -> opaque {
    let ctrl = tctrl_new();
    tctrl_set_text(ctrl, f"{rs_get_f64(initial) as u64}");
    st_put(K_CTRL, ctrl);

    let card = el_box_new();
    box_size(card, 240.0, 140.0);
    box_color(card, 0xFFFFFFFFu64);
    box_radius(card, 12.0);
    box_padding(card, 16.0);
    box_align(card, ALIGN_CENTER);

    let col = el_column();
    flex_cross_align(col, CROSS_ALIGN_CENTER);
    el_child(col, el_build(el_text_new("Set seconds")));
    let undo = undo_new();
    let input = el_input(ctrl, undo, "seconds", 180.0, 32.0);
    el_child(col, el_vqkey(input, "edit-input"));
    el_child(col, button("btn-confirm", "Confirm", "b_confirm", initial, remaining));
    el_child(card, el_build(col));
    return el_build(card);
}

// "m:ss" display format.
entry fn fmt_display(v: f64) -> str {
    let total = v as u64;
    let m = total / 60;
    let s = total % 60;
    if (s < 10) {
        return f"{m}:0{s}";
    }
    return f"{m}:{s}";
}

// The 1 Hz ticker. `g` pins the generation: a stale loop (superseded by a
// later start / pause) exits without ticking.
async fn ticker(cx: RunContext, g: f64) -> str {
    let running = stf_take(K_RUNNING) as u64;
    while (rs_get_bool(running)) {
        await sleep(1000);
        if (gen_read() != g) {
            stf_put(K_RUNNING, running as f64);
            return "";
        }
        if (!rs_get_bool(running)) {
            stf_put(K_RUNNING, running as f64);
            return "";
        }
        let remaining = stf_take(K_REMAINING) as u64;
        let r = rs_get_f64(remaining);
        if (r <= 1.0) {
            rs_set_f64(remaining, 0.0);
            rs_set_bool(running, false);
            stf_put(K_REMAINING, remaining as f64);
            stf_put(K_RUNNING, running as f64);
            return "";
        }
        rs_set_f64(remaining, r - 1.0);
        stf_put(K_REMAINING, remaining as f64);
    }
    stf_put(K_RUNNING, running as f64);
    return "";
}

fn gen_read() -> f64 {
    let cell = st_take(K_GEN);
    let v = mem_get(cell);
    st_put(K_GEN, cell);
    return v;
}

fn gen_bump() -> f64 {
    let cell = st_take(K_GEN);
    let g = mem_get(cell) + 1.0;
    mem_set(cell, g);
    st_put(K_GEN, cell);
    return g;
}

entry fn b_start(_running: u64, _b: u64, _n: f64) {
    let running = stf_take(K_RUNNING) as u64;
    if (rs_get_bool(running)) {
        stf_put(K_RUNNING, running as f64);
        return;
    }
    rs_set_bool(running, true);
    stf_put(K_RUNNING, running as f64);
    launch_future(ticker(gen_bump()));
}

entry fn b_pause(_running: u64, _b: u64, _n: f64) {
    let running = stf_take(K_RUNNING) as u64;
    rs_set_bool(running, false);
    stf_put(K_RUNNING, running as f64);
    gen_bump();
}

entry fn b_reset(initial: u64, remaining: u64, _n: f64) {
    let running = stf_take(K_RUNNING) as u64;
    rs_set_bool(running, false);
    stf_put(K_RUNNING, running as f64);
    gen_bump();
    rs_set_f64(remaining, rs_get_f64(initial));
}

entry fn b_edit(initial: u64, editing: u64, _n: f64) {
    let running = stf_take(K_RUNNING) as u64;
    rs_set_bool(running, false);
    stf_put(K_RUNNING, running as f64);
    gen_bump();
    // (Re-)seed the modal controller with the current initial value.
    let ctrl = st_take(K_CTRL);
    tctrl_set_text(ctrl, f"{rs_get_f64(initial) as u64}");
    st_put(K_CTRL, ctrl);
    rs_set_bool(editing, true);
}

entry fn b_confirm(initial: u64, remaining: u64, _n: f64) {
    let ctrl = st_take(K_CTRL);
    let v = str_parse_f64(tctrl_text(ctrl));
    rs_set_f64(initial, v);
    rs_set_f64(remaining, v);
    let editing = stf_take(K_EDITING) as u64;
    rs_set_bool(editing, false);
    stf_put(K_EDITING, editing as f64);
}
