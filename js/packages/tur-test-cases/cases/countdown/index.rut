// countdown: a 1 Hz countdown with start/pause/reset, an edit modal (a
// pre-filled Input + confirm), and a ticking display derived from the
// remaining atom. The ticker is an async loop over `sleep(1000)` with a
// generation guard (a stale loop exits when a new start supersedes it):
// a spawned task over a task-scoped TaskCtx, the handles and the mem-cell
// generation passed as parameters. State rides typed Readable handles
// captured by the mutations — no ids, no stash.
//
// The boa design: a light slate page with the 96px display centered in
// the pane, a "● Ready/Running" status pill, a big emerald Start that
// swaps to an amber Pause (a Condition on the running atom; the Start
// label re-derives to "Restart" once drained), ghost Edit/Reset buttons,
// and a scrim modal. The modal rides `then_build(...)` — the branch
// builder runs at ACTIVATION over the text controller the edit mutation
// re-seeded with the live `initial` (minted once at boot, next to its
// undo stack).
use futures::{ sleep };
use tur::{
    ALIGN_CENTER, BORDER_INSIDE, CROSS_ALIGN_CENTER, CROSS_ALIGN_STRETCH, CURSOR_POINTER,
    HIT_TEST_OPAQUE, MAIN_ALIGN_END, MAIN_SIZE_MIN, STACK_FIT_EXPAND, mem_get, mem_new, mem_set,
    mount, str_parse_f64, tctrl_new, tctrl_set_text, tctrl_text, undo_new,
};
use tur_kit::{
    Column, Condition, Container, DeriveCtx, Input, MouseRegion, Mutation, MutationCtx,
    PointerInteract, Readable, Row, SizedBox, Stack, TaskCtx, Text, derive_str, mutate, spawn,
    source_bool, source_f64,
};


// The light-slate palette (the boa countdown).
let PAGE_BG: u64 = 0xF8FAFCFFu64;
let CARD_BG: u64 = 0xFFFFFFFFu64;
let CARD_BORDER: u64 = 0xE2E8F0FFu64;
let TEXT: u64 = 0x0F172AFFu64;
let TEXT_MUTED: u64 = 0x64748BFFu64;
let TEXT_FAINT: u64 = 0x94A3B8FFu64;
let BTN_FG: u64 = 0xFFFFFFFFu64;
let START: u64 = 0x10B981FFu64;
let START_SHADOW: u64 = 0x10B9815Au64;
let PAUSE: u64 = 0xF59E0BFFu64;
let PAUSE_SHADOW: u64 = 0xF59E0B5Au64;
let BACKDROP: u64 = 0x0F172A6Eu64;

entry fn start() -> u64 {
    let remaining: Readable<f64> = source_f64(60.0);
    let initial: Readable<f64> = source_f64(60.0);
    let running: Readable<bool> = source_bool(false);
    let editing: Readable<bool> = source_bool(false);

    let display: Readable<str> = derive_str(fn (ctx: DeriveCtx) -> str {
        return fmt_display(ctx.get_f64(remaining));
    });
    let start_label: Readable<str> = derive_str(fn (ctx: DeriveCtx) -> str {
        return fmt_start_label(ctx.get_f64(remaining));
    });

    // The generation guard: the mem cell holds the live generation; the
    // ticker pins its own and exits when superseded.
    let cell = mem_new(0.0);

    // The modal's text controller + undo stack: minted once, re-seeded by
    // the edit mutation at every open.
    let ctrl = tctrl_new();
    let undo = undo_new();

    // Start: guard against double-start, set running, launch the ticker
    // with a fresh generation.
    let b_start = mutate(fn (ctx: MutationCtx) {
        if (ctx.get_bool(running)) {
            return;
        }
        ctx.set_bool(running, true);
        spawn(ticker(TaskCtx.mint(), gen_bump(cell), cell, running, remaining));
    });

    // Pause: stop the clock and supersede any live ticker.
    let b_pause = mutate(fn (ctx: MutationCtx) {
        ctx.set_bool(running, false);
        gen_bump(cell);
    });

    // Reset: stop the clock and restore the initial time.
    let b_reset = mutate(fn (ctx: MutationCtx) {
        ctx.set_bool(running, false);
        gen_bump(cell);
        ctx.set_f64(remaining, ctx.get_f64(initial));
    });

    // Open the editor: stop the clock, supersede any live ticker, mark
    // editing, and pre-seed the modal's controller with the live
    // `initial` (the branch builds fresh at activation, over the seeded
    // controller).
    let b_edit = mutate(fn (ctx: MutationCtx) {
        ctx.set_bool(running, false);
        gen_bump(cell);
        ctx.set_bool(editing, true);
        tctrl_set_text(ctrl, f"{ctx.get_f64(initial) as u64}");
    });

    // Cancel: close the modal.
    let b_cancel = mutate(fn (ctx: MutationCtx) {
        ctx.set_bool(editing, false);
    });

    // Confirm: parse the field, apply it to initial + remaining, close.
    let b_confirm = mutate(fn (ctx: MutationCtx) {
        let v = str_parse_f64(tctrl_text(ctrl));
        ctx.set_f64(initial, v);
        ctx.set_f64(remaining, v);
        ctx.set_bool(editing, false);
    });

    // Clicks inside the card stop at the card (the scrim's cancel never
    // sees them).
    let b_swallow = mutate(fn (_ctx: MutationCtx) {
    });

    let edit_button = ghost_button("btn-edit", "Edit", b_edit);
    let reset_button = ghost_button("btn-reset", "Reset", b_reset);

    // The primary action: amber Pause while running, emerald
    // Start/Restart otherwise (the label re-derives over `remaining`).
    let primary = Condition(running)
        .then_build(fn () -> View { return pad("btn-pause", "Pause", PAUSE, PAUSE_SHADOW, b_pause); })
        .else_build(fn () -> View { return start_pad(start_label, b_start); })
        .build();

    // The status pill: a green dot + "Running" while ticking, muted +
    // "Ready" otherwise.
    let status = Condition(running)
        .then_build(fn () -> View { return chip_status(true); })
        .else_build(fn () -> View { return chip_status(false); })
        .build();

    // The edit modal overlays the pane while `editing` is set.
    let modal = Condition(editing)
        .then_build(fn () -> View { return edit_modal(ctrl, undo, b_confirm, b_cancel, b_swallow); })
        .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })
        .build();

    let pane = Column()
        .main_axis_size(MAIN_SIZE_MIN)
        .cross_alignment(CROSS_ALIGN_CENTER)
        .child(Text().text("COUNTDOWN").font_size(11.0).color(TEXT_FAINT).build())
        .child(SizedBox(0.0, 10.0).build())
        .child(Text().text_bound(display).font_size(96.0).color(TEXT).query_key("display").build())
        .child(SizedBox(0.0, 12.0).build())
        .child(status)
        .child(SizedBox(0.0, 36.0).build())
        .child(primary)
        .child(SizedBox(0.0, 12.0).build())
        .child(
            Row()
                .main_axis_size(MAIN_SIZE_MIN)
                .cross_alignment(CROSS_ALIGN_CENTER)
                .child(edit_button)
                .child(SizedBox(10.0, 0.0).build())
                .child(reset_button)
                .build(),
        )
        .build();

    // The pane centered in the viewer; the modal overlays it when open.
    let page = Container().color(PAGE_BG).alignment(ALIGN_CENTER).child(pane).build();
    mount(Stack().fit(STACK_FIT_EXPAND).child(page).child(modal).build());
    return remaining.atom_id();
}

// ---- the styled pieces -------------------------------------------------------

// The big rounded primary button (the boa PrimaryButton).
fn pad(key: str, label: str, bg: u64, shade: u64, cb: Mutation<nil, nil>) -> opaque {
    let face = Container()
        .width_height(220.0, 48.0)
        .radius(12.0)
        .color(bg)
        .shadow(shade, 14.0, 0.0, 6.0)
        .alignment(ALIGN_CENTER)
        .child(Text().text(label).font_size(15.0).color(BTN_FG).build())
        .build();
    return PointerInteract()
        .on_click(cb)
        .query_key(key)
        .child(face)
        .build();
}

// The Start pad: the label rides the derive ("Restart" once drained).
fn start_pad(label: Readable<str>, cb: Mutation<nil, nil>) -> opaque {
    let face = Container()
        .width_height(220.0, 48.0)
        .radius(12.0)
        .color(START)
        .shadow(START_SHADOW, 14.0, 0.0, 6.0)
        .alignment(ALIGN_CENTER)
        .child(Text().text_bound(label).font_size(15.0).color(BTN_FG).build())
        .build();
    return PointerInteract()
        .on_click(cb)
        .query_key("btn-start")
        .child(face)
        .build();
}

// The bordered ghost button (the boa GhostButton).
fn ghost_button(key: str, label: str, cb: Mutation<nil, nil>) -> opaque {
    let face = Container()
        .padding(10.0)
        .radius(10.0)
        .border(CARD_BORDER, 1.0, BORDER_INSIDE)
        .color(CARD_BG)
        .child(Text().text(label).font_size(13.0).color(TEXT_MUTED).build())
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(
            PointerInteract()
                .on_click(cb)
                .query_key(key)
                .child(face)
                .build(),
        )
        .build();
}

// The "● Ready/Running" pill: a dot + label in a bordered capsule.
fn chip_status(running: bool) -> opaque {
    let mut dot: u64 = TEXT_MUTED;
    let mut label: str = "Ready";
    if (running) {
        dot = START;
        label = "Running";
    }
    return Container()
        .padding(6.0)
        .radius(999.0)
        .border(CARD_BORDER, 1.0, BORDER_INSIDE)
        .color(CARD_BG)
        .child(
            Row()
                .main_axis_size(MAIN_SIZE_MIN)
                .cross_alignment(CROSS_ALIGN_CENTER)
                .child(Container().width_height(7.0, 7.0).radius(999.0).color(dot).build())
                .child(SizedBox(6.0, 0.0).build())
                .child(Text().text(label).font_size(11.0).color(TEXT_MUTED).build())
                .build(),
        )
        .build();
}

// The edit modal: a dimmed scrim (tap = cancel) around the card; the card
// swallows its own taps. Runs at ACTIVATION over the controller the edit
// mutation re-seeded.
fn edit_modal(ctrl: opaque, undo: opaque, b_confirm: Mutation<nil, nil>, b_cancel: Mutation<nil, nil>, b_swallow: Mutation<nil, nil>) -> opaque {
    let field = Input()
        .controller(ctrl)
        .undo(undo)
        .placeholder("Positive integer")
        .font_size(14.0)
        .width_height(332.0, 32.0)
        .query_key("edit-input")
        .build();

    let card = Container()
        .width(380.0)
        .radius(14.0)
        .padding(22.0)
        .color(CARD_BG)
        .border(CARD_BORDER, 1.0, BORDER_INSIDE)
        .child(
            Column()
                .main_axis_size(MAIN_SIZE_MIN)
                .cross_alignment(CROSS_ALIGN_STRETCH)
                .child(Text().text("Set duration").font_size(18.0).color(TEXT).build())
                .child(SizedBox(0.0, 6.0).build())
                .child(Text().text("Enter a positive integer (seconds).").font_size(13.0).color(TEXT_MUTED).build())
                .child(SizedBox(0.0, 16.0).build())
                .child(
                    Container()
                        .padding(4.0)
                        .radius(8.0)
                        .border(CARD_BORDER, 1.0, BORDER_INSIDE)
                        .child(field)
                        .build(),
                )
                .child(SizedBox(0.0, 18.0).build())
                .child(
                    Row()
                        .main_alignment(MAIN_ALIGN_END)
                        .main_axis_size(MAIN_SIZE_MIN)
                        .child(ghost_button("btn-cancel", "Cancel", b_cancel))
                        .child(SizedBox(8.0, 0.0).build())
                        .child(
                            MouseRegion()
                                .cursor(CURSOR_POINTER)
                                .child(
                                    PointerInteract()
                                        .on_click(b_confirm)
                                        .query_key("btn-confirm")
                                        .child(
                                            Container()
                                                .width_height(220.0, 48.0)
                                                .radius(12.0)
                                                .color(START)
                                                .shadow(START_SHADOW, 14.0, 0.0, 6.0)
                                                .alignment(ALIGN_CENTER)
                                                .child(Text().text("Save").font_size(15.0).color(BTN_FG).build())
                                                .build(),
                                        )
                                        .build(),
                                )
                                .build(),
                        )
                        .build(),
                )
                .build(),
        )
        .build();

    let inner = PointerInteract()
        .behavior(HIT_TEST_OPAQUE)
        .on_click(b_swallow)
        .child(card)
        .build();
    let scrim = Container()
        .color(BACKDROP)
        .alignment(ALIGN_CENTER)
        .child(inner)
        .build();
    return PointerInteract()
        .behavior(HIT_TEST_OPAQUE)
        .on_click(b_cancel)
        .query_key("edit-modal")
        .child(scrim)
        .build();
}

// ---- the display + label derives ----------------------------------------------

// "m:ss" display format.
fn fmt_display(v: f64) -> str {
    let total = v as u64;
    let m = total / 60;
    let s = total % 60;
    if (s < 10) {
        return f"{m}:0{s}";
    }
    return f"{m}:{s}";
}

// The primary label under the else branch: "Restart" once drained.
fn fmt_start_label(v: f64) -> str {
    if (v == 0.0) {
        return "Restart";
    }
    return "Start";
}

// ---- the 1 Hz ticker ------------------------------------------------------------

// `g` pins the generation: a stale loop (superseded by a later start /
// pause / edit / reset) exits without ticking. The handles and the mem
// cell ride as parameters; the ctx is task-scoped.
async fn ticker(ctx: TaskCtx, g: f64, cell: opaque, running: Readable<bool>, remaining: Readable<f64>) -> str {
    while (ctx.get_bool(running)) {
        await sleep(1000);
        if (mem_get(cell) != g) {
            return "";
        }
        if (!ctx.get_bool(running)) {
            return "";
        }
        let r = ctx.get_f64(remaining);
        if (r <= 1.0) {
            ctx.set_f64(remaining, 0.0);
            ctx.set_bool(running, false);
            return "";
        }
        ctx.set_f64(remaining, r - 1.0);
    }
    return "";
}

// Bump the generation cell and answer the fresh generation.
fn gen_bump(cell: opaque) -> f64 {
    let g = mem_get(cell) + 1.0;
    mem_set(cell, g);
    return g;
}
