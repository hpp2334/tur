// column-basic: two fixed-height children stacked vertically (the root
// Column fills the viewport; cross axis start-aligned).
use tur::{ CROSS_ALIGN_START, mount };
use tur_kit::{ Column, Container };


fn box_h(h: f64) -> opaque {
    let mut b = Container.new();
    b.width_height(0.0, h);
    return b.build();
}

entry fn start() {
    let mut col = Column.new();
    col.cross_alignment(CROSS_ALIGN_START);
    col.child(box_h(50.0));
    col.child(box_h(30.0));
    mount(col.build());
}
