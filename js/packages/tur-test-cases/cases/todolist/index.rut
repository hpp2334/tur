// todolist: the checkable list showcase (the corpus's composite surface:
// scroll + per-item gestures + derived count).
use tur::{ CROSS_ALIGN_STRETCH, MAIN_ALIGN_SPACE_BETWEEN, el_box_new, box_size, el_build, el_child, el_column, el_expand, el_gesture2, el_pi, el_qkey, el_row, el_scroll, el_sizedbox, el_text_bound_d, el_text_new, flex_main_align, mount, rs_derive, rs_list_new, rs_list_push, rs_source_value, stf_put, stf_take };

let K_ITEMS: u64 = 1;

entry fn item(_i: u64, s: str) -> opaque {
    let r = el_row();
    flex_main_align(r, MAIN_ALIGN_SPACE_BETWEEN);
    let label = el_text_new(s);
    el_child(r, el_build(label));
    let check = el_box_new();
    box_size(check, 20.0, 20.0);
    el_qkey(check, "check");
    el_child(r, el_build(check));
    let wrap = el_box_new();
    box_size(wrap, 0.0, 44.0);
    el_child(wrap, el_build(r));
    return el_gesture2(_i, 0, "it_tap", "", "", "", "", el_build(wrap));
}

entry fn start() -> u64 {
    let items = rs_list_new();
    rs_list_push(items, "Buy milk");
    rs_list_push(items, "Ship phase 4");
    rs_list_push(items, "Walk the dog");
    let items_atom = rs_source_value(items);
    stf_put(K_ITEMS, items_atom as f64);
    let count = rs_derive("fmt_count", items_atom);

    let col = el_column();
    let head = el_box_new();
    box_size(head, 0.0, 48.0);
    let ht = el_text_bound_d(count);
    el_qkey(ht, "count");
    el_child(head, ht);
    el_child(col, head);
    let content = el_column();
    el_child(content, rs_each(items_atom, "item"));
    let scroller = el_scroll(true, el_build(content));
    el_child(col, el_expand(1.0, scroller));
    let add = el_box_new();
    box_size(add, 0.0, 48.0);
    el_child(add, el_pi(items_atom, items_atom, "b_add", "", 0, "", el_build(el_text_new("+ add"))));
    el_child(col, add);
    mount(el_sizedbox(400.0, 600.0, el_build(col)));
}

entry fn fmt_count(_v: f64) -> str {
    return "todos";
}

entry fn it_tap(_idx: u64, _b: u64, _n: f64) {
}

entry fn b_add(_a: u64, _b: u64, _n: f64) {
    let items = stf_take(K_ITEMS) as u64;
    let fresh = rs_list_new();
    rs_list_push(fresh, "Buy milk");
    rs_list_push(fresh, "Ship phase 4");
    rs_list_push(fresh, "Walk the dog");
    rs_list_push(fresh, "New todo");
    rs_set_value(items, fresh);
    stf_put(K_ITEMS, items as f64);
}
