// todolist: the checkable list showcase (the corpus's composite surface:
// scroll + per-item gestures + derived count).
use tur::{ AXIS_VERTICAL, MAIN_ALIGN_SPACE_BETWEEN, mount, rs_list_new, rs_list_push, rs_set_value, rs_source_value, stf_put, stf_take };
use tur_kit::{ Column, Container, Each, Expanded, PointerInteract, Row, ScrollView, SizedBox, Text, rs_derive };


let K_ITEMS: u64 = 1;

fn item(_i: u64, s: str) -> opaque {
    let r = Row()
        .main_alignment(MAIN_ALIGN_SPACE_BETWEEN)
        .child(Text().text(s).build())
        .child(Container().width_height(20.0, 20.0).query_key("check").build());
    let wrap = Container().width_height(0.0, 44.0).child(r.build());
    return PointerInteract().ids(_i, 0).on_tap(it_tap).query_key("rut/gesture").child(wrap.build()).build();
}

entry fn start() -> u64 {
    let items = rs_list_new();
    rs_list_push(items, "Buy milk");
    rs_list_push(items, "Ship phase 4");
    rs_list_push(items, "Walk the dog");
    let items_atom = rs_source_value(items);
    stf_put(K_ITEMS, items_atom as f64);
    let count = rs_derive(fmt_count, items_atom);

    let mut col = Column();
    let head = Container()
        .width_height(0.0, 48.0)
        .child(Text().text_bound_derived(count).query_key("count").build());
    col.child(head.build());
    let content = Column().child(Each(items_atom).item_builder(item).build());
    let scroller = ScrollView().axis(AXIS_VERTICAL).child(content.build()).build();
    col.child(Expanded().flex(1.0).child(scroller).build());
    let add = Container()
        .width_height(0.0, 48.0)
        .child(PointerInteract().ids(items_atom, items_atom).on_tap(b_add).child(Text().text("+ add").build()).build());
    col.child(add.build());
    mount(SizedBox(400.0, 600.0).child(col.build()).build());
}

fn fmt_count(_v: f64) -> str {
    return "todos";
}

fn it_tap(_idx: u64, _b: u64, _n: f64) {
}

fn b_add(_a: u64, _b: u64, _n: f64) {
    let items = stf_take(K_ITEMS) as u64;
    let fresh = rs_list_new();
    rs_list_push(fresh, "Buy milk");
    rs_list_push(fresh, "Ship phase 4");
    rs_list_push(fresh, "Walk the dog");
    rs_list_push(fresh, "New todo");
    rs_set_value(items, fresh);
    stf_put(K_ITEMS, items as f64);
}
