// todolist: the boa "Tasks" board — a 26px header with the derived
// "N items · M done" counter, an indigo New Task pill, and task cards
// (colored checkbox + title/subtitle + X button) in a scrollable list.
// Tapping a card's checkbox toggles its done state; the X opens the
// remove-confirm modal (a then_build branch that reads the targeted task
// at open time); New Task opens the add modal (fresh, blank controllers
// minted at activation).
//
// Tasks ride one list atom, each item encoded "title|desc|done". Both
// modals overlay via Condition branches in the root Stack — and unlike
// the boa reference, NEITHER boots open (the boot-modal bug is not
// ported).
use tur::{ ALIGN_CENTER, AXIS_VERTICAL, BORDER_INSIDE, CROSS_ALIGN_CENTER, CROSS_ALIGN_START,
    CROSS_ALIGN_STRETCH, CURSOR_POINTER, HIT_TEST_OPAQUE, MAIN_ALIGN_END,
    MAIN_ALIGN_SPACE_BETWEEN, MAIN_SIZE_MIN, STACK_FIT_EXPAND, img_res_svg, mount, rs_get_value,
    rs_list_new, rs_list_push, rs_set_bool, rs_set_f64, rs_set_value, rs_source_bool,
    rs_source_f64, rs_source_value, rs_value_item, rs_value_len, st_put, st_take, stf_put,
    stf_take, tctrl_new, tctrl_text, undo_new };
use tur_kit::{ Column, Condition, Container, Each, Expanded, Image, Input, MouseRegion,
    PointerInteract, Positioned, Row, ScrollView, SizedBox, Stack, Text, rs_derive2 };


let K_TASKS: u64 = 1;
let K_N: u64 = 2;
let K_DONE: u64 = 3;
let K_ADDOPEN: u64 = 4;
let K_RMOPEN: u64 = 5;
let K_RMTGT: u64 = 6;
let K_TITLE: u64 = 7; // the add modal's title controller
let K_DESC: u64 = 8; // the add modal's description controller

let K_ICO_CHECK: u64 = 10;
let K_ICO_CLOSE: u64 = 11;
let K_ICO_PLUS: u64 = 12;

// The boa light palette (Notion / Linear-style).
let CARD_BG: u64 = 0xFFFFFFFFu64;
let CARD_BORDER: u64 = 0xE2E8F0FFu64;
let PAGE_BG: u64 = 0xF8FAFCFFu64;
let TEXT: u64 = 0x0F172AFFu64;
let TEXT_MUTED: u64 = 0x64748BFFu64;
let TEXT_STRIKE: u64 = 0x94A3B8FFu64;
let ACCENT: u64 = 0x4F46E5FFu64;
let ACCENT_FG: u64 = 0xFFFFFFFFu64;
let SUCCESS: u64 = 0x22C55EFFu64;
let INPUT_BG: u64 = 0xF8FAFCFFu64;
let INPUT_BORDER: u64 = 0xCBD5E1FFu64;
let BACKDROP: u64 = 0x0F172A6Eu64;
let SUBTLE: u64 = 0xF1F5F9FFu64;
let SUBTLE_FG: u64 = 0x334155FFu64;
let DANGER: u64 = 0xEF4444FFu64;

// The inline icon SVGs (the boa state.ts icons, single-quoted attrs).
let SVG_CHECK: str = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#ffffff' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'><polyline points='20 6 9 17 4 12'/></svg>";
let SVG_CLOSE: str = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#64748b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round'><line x1='18' y1='6' x2='6' y2='18'/><line x1='6' y1='6' x2='18' y2='18'/></svg>";
let SVG_PLUS: str = "<svg xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewBox='0 0 24 24' fill='none' stroke='#ffffff' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><line x1='12' y1='5' x2='12' y2='19'/><line x1='5' y1='12' x2='19' y2='12'/></svg>";

entry fn start() -> u64 {
    let tasks = rs_source_value(seed_tasks());
    stf_put(K_TASKS, tasks as f64);
    let n = rs_source_f64();
    let done = rs_source_f64();
    stf_put(K_N, n as f64);
    stf_put(K_DONE, done as f64);
    let add_open = rs_source_bool(false);
    let rm_open = rs_source_bool(false);
    stf_put(K_ADDOPEN, add_open as f64);
    stf_put(K_RMOPEN, rm_open as f64);
    stf_put(K_RMTGT, 0.0);

    sync_counts();

    // The icon resources (inline SVG through the image rail).
    stf_put(K_ICO_CHECK, img_res_svg(SVG_CHECK) as f64);
    stf_put(K_ICO_CLOSE, img_res_svg(SVG_CLOSE) as f64);
    stf_put(K_ICO_PLUS, img_res_svg(SVG_PLUS) as f64);

    let count = rs_derive2(fmt_tasks, n, done);

    let header = Row()
        .main_alignment(MAIN_ALIGN_SPACE_BETWEEN)
        .cross_alignment(CROSS_ALIGN_CENTER)
        .child(
            Column()
                .cross_alignment(CROSS_ALIGN_START)
                .main_axis_size(MAIN_SIZE_MIN)
                .child(Text().text("Tasks").font_size(26.0).color(TEXT).build())
                .child(SizedBox(0.0, 4.0).build())
                .child(Text().text_bound_derived(count).font_size(13.0).color(TEXT_MUTED).query_key("todo-count").build())
                .build(),
        )
        .child(add_button())
        .build();

    let scroller = ScrollView()
        .axis(AXIS_VERTICAL)
        .child(
            Column()
                .cross_alignment(CROSS_ALIGN_STRETCH)
                .child(Each(tasks).item_builder(task_row).build())
                .build(),
        )
        .build();

    let page = Container()
        .color(PAGE_BG)
        .padding(22.0)
        .child(
            Column()
                .cross_alignment(CROSS_ALIGN_STRETCH)
                .child(header)
                .child(SizedBox(0.0, 18.0).build())
                .child(Expanded().flex(1.0).child(scroller).build())
                .build(),
        )
        .build();

    // The modals overlay the page; neither boots open (the closed branch
    // is a zero box — cond_build requires both branches).
    mount(
        Stack()
            .fit(STACK_FIT_EXPAND)
            .child(page)
            .child(
                Condition(add_open)
                    .then_build(fn () -> View { return Positioned().left(0.0).top(0.0).right(0.0).bottom(0.0).child(add_modal()).build(); })
                    .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })
                    .build(),
            )
            .child(
                Condition(rm_open)
                    .then_build(fn () -> View { return Positioned().left(0.0).top(0.0).right(0.0).bottom(0.0).child(remove_modal()).build(); })
                    .else_build(fn () -> View { return SizedBox(0.0, 0.0).build(); })
                    .build(),
            )
            .build(),
    );
    return tasks;
}

// ---- the seed data -------------------------------------------------------------

// The boa state.ts seed list.
fn seed_tasks() -> opaque {
    let items = rs_list_new();
    rs_list_push(items, "Buy groceries|Milk, eggs, sourdough, coffee beans|0");
    rs_list_push(items, "Walk the dog|30 minutes around the park|1");
    rs_list_push(items, "Finish quarterly report|Q2 numbers + projection slides for Monday's review|0");
    rs_list_push(items, "Call mom|Birthday planning for Saturday|0");
    rs_list_push(items, "Read chapter 4|Designing Data-Intensive Applications|0");
    return items;
}

// ---- the item parsing (the "title|desc|done" encoding) --------------------------

fn idx_of(s: str, from: i32, c: u32) -> i32 {
    let n = s.len();
    let mut k = from;
    while (k < n) {
        if (s.code_at(k) == c) {
            return k;
        }
        k = k + 1;
    }
    return -1;
}

fn item_title(s: str) -> str {
    let p = idx_of(s, 0, 124);
    if (p < 0) {
        return s;
    }
    return s.slice(0, p);
}

fn item_desc(s: str) -> str {
    let a = idx_of(s, 0, 124);
    if (a < 0) {
        return "";
    }
    let b = idx_of(s, a + 1, 124);
    if (b < 0) {
        return "";
    }
    return s.slice(a + 1, b);
}

fn item_done(s: str) -> bool {
    let n = s.len();
    if (n == 0) {
        return false;
    }
    return s.code_at(n - 1) == 49;
}

// ---- the header pieces -----------------------------------------------------------

// The indigo New Task pill (plus glyph + label).
fn add_button() -> opaque {
    let face = Container()
        .padding(10.0)
        .radius(8.0)
        .color(ACCENT)
        .shadow(0x4F46E550u64, 10.0, 0.0, 4.0)
        .child(
            Row()
                .main_axis_size(MAIN_SIZE_MIN)
                .cross_alignment(CROSS_ALIGN_CENTER)
                .child(icon(K_ICO_PLUS, 13.0))
                .child(SizedBox(7.0, 0.0).build())
                .child(Text().text("New Task").font_size(13.0).color(ACCENT_FG).build())
                .build(),
        )
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(
            PointerInteract()
                .on_tap(b_open_add)
                .query_key("todo-add-open")
                .child(face)
                .build(),
        )
        .build();
}

// A stashed SVG icon at a display size.
fn icon(slot: u64, size: f64) -> opaque {
    let res = stf_take(slot) as u64;
    stf_put(slot, res as f64);
    return Image(res).width(size).height(size).build();
}

// ---- the task card ---------------------------------------------------------------

fn task_row(i: u64, s: str) -> opaque {
    let title = item_title(s);
    let desc = item_desc(s);
    let done = item_done(s);
    let card = Container()
        .radius(10.0)
        .padding(14.0)
        .color(CARD_BG)
        .border(CARD_BORDER, 1.0, BORDER_INSIDE)
        .shadow(0x0F172A14u64, 6.0, 0.0, 1.0)
        .child(
            Row()
                .cross_alignment(CROSS_ALIGN_START)
                .child(checkbox(i, done))
                .child(SizedBox(12.0, 0.0).build())
                .child(Expanded().flex(1.0).child(title_block(title, desc, done)).build())
                .child(SizedBox(8.0, 0.0).build())
                .child(delete_button(i))
                .build(),
        )
        .build();
    return Column()
        .cross_alignment(CROSS_ALIGN_STRETCH)
        .main_axis_size(MAIN_SIZE_MIN)
        .child(row_spacer(i))
        .child(card)
        .build();
}

// The 10px gutter between cards (none above the first).
fn row_spacer(i: u64) -> opaque {
    if (i > 0) {
        return SizedBox(0.0, 10.0).build();
    }
    return SizedBox(0.0, 0.0).build();
}

// The done toggle: a 20px rounded box — green with a check when done, a
// bordered empty square otherwise.
fn checkbox(i: u64, done: bool) -> opaque {
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(
            PointerInteract()
                .ids(i, i)
                .on_tap(it_tap)
                .query_key("todo-check")
                .child(checkbox_face(done))
                .build(),
        )
        .build();
}

fn checkbox_face(done: bool) -> opaque {
    if (done) {
        return Container()
            .width_height(20.0, 20.0)
            .radius(6.0)
            .color(SUCCESS)
            .alignment(ALIGN_CENTER)
            .child(icon(K_ICO_CHECK, 13.0))
            .build();
    }
    return Container()
        .width_height(20.0, 20.0)
        .radius(6.0)
        .color(CARD_BG)
        .border(INPUT_BORDER, 1.5, BORDER_INSIDE)
        .build();
}

// The title + optional subtitle; done tasks mute the title.
fn title_block(title: str, desc: str, done: bool) -> opaque {
    let mut fg = TEXT;
    if (done) {
        fg = TEXT_STRIKE;
    }
    let t = Text().text(title).font_size(14.0).color(fg).build();
    if (desc == "") {
        return Column()
            .cross_alignment(CROSS_ALIGN_START)
            .main_axis_size(MAIN_SIZE_MIN)
            .child(t)
            .build();
    }
    return Column()
        .cross_alignment(CROSS_ALIGN_START)
        .main_axis_size(MAIN_SIZE_MIN)
        .child(t)
        .child(SizedBox(0.0, 3.0).build())
        .child(Text().text(desc).font_size(12.0).color(TEXT_MUTED).build())
        .build();
}

// The X button (opens the remove-confirm modal for this row).
fn delete_button(i: u64) -> opaque {
    let face = Container()
        .width_height(26.0, 26.0)
        .radius(6.0)
        .color(SUBTLE)
        .alignment(ALIGN_CENTER)
        .child(icon(K_ICO_CLOSE, 13.0))
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(
            PointerInteract()
                .ids(i, i)
                .on_tap(b_rm)
                .query_key("todo-delete")
                .child(face)
                .build(),
        )
        .build();
}

// ---- the modals -------------------------------------------------------------------

// The modal shell: a scrim (tap = dismiss) around a card that swallows
// its own taps.
fn modal_shell(scrim_tap: fn(u64, u64, f64), card: opaque) -> opaque {
    let inner = PointerInteract()
        .behavior(HIT_TEST_OPAQUE)
        .on_tap(b_swallow)
        .child(card)
        .build();
    let scrim = Container().color(BACKDROP).alignment(ALIGN_CENTER).child(inner).build();
    return PointerInteract()
        .behavior(HIT_TEST_OPAQUE)
        .on_tap(scrim_tap)
        .child(scrim)
        .build();
}

// A standard modal button (the boa Button).
fn modal_button(key: str, label: str, bg: u64, fg: u64, cb: fn(u64, u64, f64)) -> opaque {
    let face = Container()
        .padding(9.0)
        .radius(7.0)
        .color(bg)
        .child(Text().text(label).font_size(13.0).color(fg).build())
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(
            PointerInteract()
                .on_tap(cb)
                .query_key(key)
                .child(face)
                .build(),
        )
        .build();
}

// A labelled field (the boa Field): the caption over the bordered input.
fn field(caption: str, placeholder: str, ctrl: opaque, undo: opaque, key: str) -> opaque {
    return Column()
        .cross_alignment(CROSS_ALIGN_STRETCH)
        .main_axis_size(MAIN_SIZE_MIN)
        .child(Text().text(caption).font_size(11.0).color(TEXT_MUTED).build())
        .child(SizedBox(0.0, 6.0).build())
        .child(
            Container()
                .radius(7.0)
                .padding(9.0)
                .color(INPUT_BG)
                .border(INPUT_BORDER, 1.0, BORDER_INSIDE)
                .child(
                    Input()
                        .controller(ctrl)
                        .undo(undo)
                        .placeholder(placeholder)
                        .font_size(14.0)
                        .color(TEXT)
                        .placeholder_color(TEXT_MUTED)
                        .cursor_color(ACCENT)
                        .query_key(key)
                        .width_height(0.0, 22.0)
                        .build(),
                )
                .build(),
        )
        .build();
}

// The add modal — built at ACTIVATION, so its controllers mint fresh and
// blank every open.
fn add_modal() -> opaque {
    let ctrl = tctrl_new();
    let undo = undo_new();
    st_put(K_TITLE, ctrl);
    let dctrl = tctrl_new();
    let undo2 = undo_new();
    st_put(K_DESC, dctrl);

    let card = Container()
        .width(380.0)
        .radius(14.0)
        .padding(22.0)
        .color(CARD_BG)
        .shadow(0x0F172A1Eu64, 30.0, 0.0, 12.0)
        .child(
            Column()
                .cross_alignment(CROSS_ALIGN_STRETCH)
                .main_axis_size(MAIN_SIZE_MIN)
                .child(Text().text("New Task").font_size(17.0).color(TEXT).build())
                .child(SizedBox(0.0, 16.0).build())
                .child(field("Title", "What needs doing?", ctrl, undo, "todo-add-title"))
                .child(SizedBox(0.0, 14.0).build())
                .child(field("Description", "Optional details", dctrl, undo2, "todo-add-desc"))
                .child(SizedBox(0.0, 20.0).build())
                .child(
                    Row()
                        .main_alignment(MAIN_ALIGN_END)
                        .main_axis_size(MAIN_SIZE_MIN)
                        .child(modal_button("todo-add-cancel", "Cancel", SUBTLE, SUBTLE_FG, b_add_cancel))
                        .child(SizedBox(8.0, 0.0).build())
                        .child(modal_button("todo-add-submit", "Add Task", ACCENT, ACCENT_FG, b_add_submit))
                        .build(),
                )
                .build(),
        )
        .build();
    return modal_shell(b_add_cancel, card);
}

// The remove-confirm modal — built at ACTIVATION for the targeted task
// (the branch reads the live target).
fn remove_modal() -> opaque {
    let target = stf_take(K_RMTGT);
    stf_put(K_RMTGT, target);
    let tasks = stf_take(K_TASKS);
    stf_put(K_TASKS, tasks);
    let item = rs_value_item(rs_get_value(tasks as u64), target as u64);
    let title = item_title(item);
    // Bound-quote locals: f-string braces take no escape sequences.
    let q: str = "\"";
    let said = f"{q}{title}{q} will be permanently removed.";

    let card = Container()
        .width(340.0)
        .radius(14.0)
        .padding(22.0)
        .color(CARD_BG)
        .shadow(0x0F172A1Eu64, 30.0, 0.0, 12.0)
        .child(
            Column()
                .cross_alignment(CROSS_ALIGN_STRETCH)
                .main_axis_size(MAIN_SIZE_MIN)
                .child(Text().text("Remove task?").font_size(16.0).color(TEXT).build())
                .child(SizedBox(0.0, 8.0).build())
                .child(Text().text(said).font_size(13.0).color(TEXT_MUTED).query_key("todo-rm-msg").build())
                .child(SizedBox(0.0, 18.0).build())
                .child(
                    Row()
                        .main_alignment(MAIN_ALIGN_END)
                        .main_axis_size(MAIN_SIZE_MIN)
                        .child(modal_button("todo-rm-cancel", "Cancel", SUBTLE, SUBTLE_FG, b_rm_cancel))
                        .child(SizedBox(8.0, 0.0).build())
                        .child(modal_button("todo-rm-confirm", "Remove", DANGER, ACCENT_FG, b_rm_confirm))
                        .build(),
                )
                .build(),
        )
        .build();
    return modal_shell(b_rm_cancel, card);
}

// ---- the actions -------------------------------------------------------------------

// Checkbox tap: flip the row's done flag (rewrite the list atom — the
// Each rebuilds; the derive recount follows).
fn it_tap(idx: u64, _b: u64, _n: f64) {
    let tasks = stf_take(K_TASKS);
    stf_put(K_TASKS, tasks);
    let old = rs_get_value(tasks as u64);
    let count = rs_value_len(old);
    let fresh = rs_list_new();
    let mut k: u64 = 0;
    while (k < count) {
        let item = rs_value_item(old, k);
        if (k == idx) {
            let body = item.slice(0, item.len() - 1);
            if (item_done(item)) {
                rs_list_push(fresh, f"{body}0");
            } else {
                rs_list_push(fresh, f"{body}1");
            }
        } else {
            rs_list_push(fresh, item);
        }
        k = k + 1;
    }
    rs_set_value(tasks as u64, fresh);
    sync_counts();
}

// X tap: aim the remove modal at this row and open it.
fn b_rm(idx: u64, _b: u64, _n: f64) {
    stf_put(K_RMTGT, idx as f64);
    let rm_open = stf_take(K_RMOPEN);
    stf_put(K_RMOPEN, rm_open);
    rs_set_bool(rm_open as u64, true);
}

// New Task: open the add modal (its branch mints blank controllers).
fn b_open_add(_a: u64, _b: u64, _n: f64) {
    let add_open = stf_take(K_ADDOPEN);
    stf_put(K_ADDOPEN, add_open);
    rs_set_bool(add_open as u64, true);
}

fn b_add_cancel(_a: u64, _b: u64, _n: f64) {
    let add_open = stf_take(K_ADDOPEN);
    stf_put(K_ADDOPEN, add_open);
    rs_set_bool(add_open as u64, false);
}

// Add Task: the non-empty title appends a fresh open task.
fn b_add_submit(_a: u64, _b: u64, _n: f64) {
    let ctrl = st_take(K_TITLE);
    let raw = tctrl_text(ctrl);
    st_put(K_TITLE, ctrl);
    let title = trim(raw);
    if (title == "") {
        return;
    }
    let dctrl = st_take(K_DESC);
    let desc = trim(tctrl_text(dctrl));
    st_put(K_DESC, dctrl);
    let tasks = stf_take(K_TASKS);
    stf_put(K_TASKS, tasks);
    let old = rs_get_value(tasks as u64);
    let fresh = rs_list_new();
    let count = rs_value_len(old);
    let mut k: u64 = 0;
    while (k < count) {
        rs_list_push(fresh, rs_value_item(old, k));
        k = k + 1;
    }
    rs_list_push(fresh, f"{title}|{desc}|0");
    rs_set_value(tasks as u64, fresh);
    sync_counts();
    b_add_cancel(0, 0, 0.0);
}

fn b_rm_cancel(_a: u64, _b: u64, _n: f64) {
    let rm_open = stf_take(K_RMOPEN);
    stf_put(K_RMOPEN, rm_open);
    rs_set_bool(rm_open as u64, false);
}

fn b_rm_confirm(_a: u64, _b: u64, _n: f64) {
    let target = stf_take(K_RMTGT);
    stf_put(K_RMTGT, target);
    let tasks = stf_take(K_TASKS);
    stf_put(K_TASKS, tasks);
    let old = rs_get_value(tasks as u64);
    let count = rs_value_len(old);
    let fresh = rs_list_new();
    let mut k: u64 = 0;
    while (k < count) {
        if (k != target as u64) {
            rs_list_push(fresh, rs_value_item(old, k));
        }
        k = k + 1;
    }
    rs_set_value(tasks as u64, fresh);
    sync_counts();
    b_rm_cancel(0, 0, 0.0);
}

// Clicks inside a modal card stop at the card.
fn b_swallow(_a: u64, _b: u64, _n: f64) {
}

// ---- the counters -------------------------------------------------------------------

// Recount items + dones off the live list (the header derive's deps).
fn sync_counts() {
    let tasks = stf_take(K_TASKS);
    stf_put(K_TASKS, tasks);
    let n = stf_take(K_N);
    stf_put(K_N, n);
    let done = stf_take(K_DONE);
    stf_put(K_DONE, done);
    let old = rs_get_value(tasks as u64);
    let count = rs_value_len(old);
    let mut dones: u64 = 0;
    let mut k: u64 = 0;
    while (k < count) {
        if (item_done(rs_value_item(old, k))) {
            dones = dones + 1;
        }
        k = k + 1;
    }
    rs_set_f64(n as u64, count as f64);
    rs_set_f64(done as u64, dones as f64);
}

// "N items · M done".
fn fmt_tasks(a: f64, b: f64) -> str {
    return f"{a as u64} items · {b as u64} done";
}

// ASCII trim (the spaces around a draft).
fn trim(s: str) -> str {
    let n = s.len();
    let mut a = 0;
    while (a < n && s.code_at(a) == 32) {
        a = a + 1;
    }
    let mut b = n;
    while (b > a && s.code_at(b - 1) == 32) {
        b = b - 1;
    }
    return s.slice(a, b);
}
