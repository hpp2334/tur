// flex-nested-sidebar: a 200px sidebar Column beside a content Column in
// a Row (the classic two-pane shape).
use tur::{ CROSS_ALIGN_START, mount };
use tur_kit::{ Column, Container, Row };


entry fn start() {
    let mut row = Row.builder();
    let mut sidebar = Container.builder();
    sidebar.width_height(200.0, 0.0);
    let mut scol = Column.builder();
    scol.cross_alignment(CROSS_ALIGN_START);
    scol.child(box_wh(0.0, 40.0));
    sidebar.child(scol.build());
    row.child(sidebar.build());
    let mut content = Container.builder();
    let mut ccol = Column.builder();
    ccol.cross_alignment(CROSS_ALIGN_START);
    ccol.child(box_wh(0.0, 30.0));
    content.child(ccol.build());
    row.child(content.build());
    mount(row.build());
}

fn box_wh(w: f64, h: f64) -> opaque {
    let mut b = Container.builder();
    b.width_height(w, h);
    return b.build();
}
