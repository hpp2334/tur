// pointer-interact-nested: nested gesture pads — the opaque inner blocks
// the outer, the translucent inner lets both fire. The result labels are
// derived atoms over the two counter pairs (the C8 derive rail).
use tur::{ CROSS_ALIGN_START, MAIN_SIZE_MIN, mount, rs_get_f64, rs_set_f64, rs_source_f64 };
use tur_kit::{ Column, Container, PointerInteract, Row, Text, rs_derive2 };


entry fn start() -> u64 {
    let outer_o = rs_source_f64();
    let inner_o = rs_source_f64();
    let outer_t = rs_source_f64();
    let inner_t = rs_source_f64();
    let d_o = rs_derive2(fmt_o, outer_o, inner_o);
    let d_t = rs_derive2(fmt_t, outer_t, inner_t);

    let mut col = Column().cross_alignment(CROSS_ALIGN_START).main_axis_size(MAIN_SIZE_MIN);

    // Opaque pair: the inner (opaque) absorbs the click.
    let mut outer_box = Container().width_height(80.0, 40.0).query_key("outer-opaque");
    let mut inner_row = Row();
    let inner_box = Container().width_height(60.0, 30.0).query_key("inner-opaque");
    inner_row.child(PointerInteract().ids(inner_o, inner_o).on_tap(ts_inner_o).child(inner_box.build()).build());
    outer_box.child(inner_row.build());
    col.child(PointerInteract().ids(outer_o, outer_o).on_tap(ts_outer_o).child(outer_box.build()).build());

    // Translucent pair: the inner joins the path; the outer fires too.
    let mut outer_t_box = Container().width_height(80.0, 40.0).query_key("outer-translucent");
    let mut t_row = Row();
    let inner_t_box = Container().width_height(60.0, 30.0).query_key("inner-translucent");
    t_row.child(PointerInteract().ids(inner_t, inner_t).on_tap(ts_inner_t).behavior(1).child(inner_t_box.build()).build());
    outer_t_box.child(t_row.build());
    col.child(PointerInteract().ids(outer_t, outer_t).on_tap(ts_outer_t).child(outer_t_box.build()).build());

    let ro = Text().text_bound_derived(d_o).query_key("result-opaque");
    col.child(ro.build());
    let rt = Text().text_bound_derived(d_t).query_key("result-translucent");
    col.child(rt.build());

    mount(col.build());
    return outer_o;
}

// The derive bodies — synchronous VM calls during flush.
fn fmt_o(a: f64, b: f64) -> str {
    return f"opaque:{a as u64}/{b as u64}";
}

fn fmt_t(a: f64, b: f64) -> str {
    return f"translucent:{a as u64}/{b as u64}";
}

fn ts_outer_o(count: u64, _b: u64, _n: f64) {
    rs_set_f64(count, rs_get_f64(count) + 1.0);
}

fn ts_inner_o(count: u64, _b: u64, _n: f64) {
    rs_set_f64(count, rs_get_f64(count) + 1.0);
}

fn ts_outer_t(count: u64, _b: u64, _n: f64) {
    rs_set_f64(count, rs_get_f64(count) + 1.0);
}

fn ts_inner_t(count: u64, _b: u64, _n: f64) {
    rs_set_f64(count, rs_get_f64(count) + 1.0);
}
