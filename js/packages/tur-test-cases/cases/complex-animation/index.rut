// complex-animation: "Animated Card Studio" — the controller-driven
// animation showcase (the boa-era twin, ported to the kit's fluent
// idiom). One explicit AnimationController (Rust-held, stashed) ticks
// the eased progress into the `a_tick` entry, which maps it into the
// animated channels: card width (120 → 280), card radius (8 → 40, the
// bound-radius row), card hue (indigo → coral via the color tween) and
// the inner white square's ROTATION (the bound-angle row:
// Transform().rotate_bound(progress) — the angle re-resolves through the
// live atom and the subtree NEVER re-mounts; no rebuild channel), the
// orbiting dot (Positioned bounds over math_sin/math_cos riding boa's
// 140/80 center) and the % readout. The transport (play / pause /
// resume / reverse / stop), the speed selector (0.5x–4x, in-place), the
// curve selector (recreates the controller mid-flight and seeks it to
// the DISPLAYED eased progress — boa's `ctx.get(progress$)`) and the
// loop toggle (infinite repeat; the label swaps "Loop" ↔ "Loop ✓" with
// white text when on) are intent entries over the scalar stash — the
// boa interactions, names + ids, never closures.
use tur::{ ALIGN_CENTER, CROSS_ALIGN_CENTER, MAIN_ALIGN_CENTER, MAIN_SIZE_MIN, anim_forward,
    anim_pause, anim_repeat, anim_resume, anim_reverse, anim_seek, anim_speed, anim_status,
    anim_stop, color_tween_lerp, math_cos, math_sin, mount, rs_get_bool, rs_get_f64,
    rs_set_bool, rs_set_brush, rs_set_f64, rs_set_str, rs_source_bool, rs_source_f64,
    rs_source_str, st_put, st_take, stf_put, stf_take, tween_lerp };
use tur_kit::{ Column, Condition, Container, PointerInteract, Positioned, Row, SizedBox, Stack, Text };
use tur_anim_kit::{ Transform, anim_ctrl };


let K_CTRL: u64 = 1;
let K_PROGRESS: u64 = 2;
let K_CURVE: u64 = 3;
let K_LOOPB: u64 = 4;
let K_WIDTH: u64 = 5;
let K_HUE: u64 = 6;
let K_PCT: u64 = 8;
let K_STATUS: u64 = 9;
let K_BADGE: u64 = 10;
let K_SP0: u64 = 11;
let K_SP1: u64 = 12;
let K_SP2: u64 = 13;
let K_SP3: u64 = 14;
let K_CV0: u64 = 15;
let K_CV1: u64 = 16;
let K_CV2: u64 = 17;
let K_CV3: u64 = 18;
let K_LP: u64 = 19;
let K_LOOPON: u64 = 20;
let K_ORBIT_X: u64 = 21;
let K_ORBIT_Y: u64 = 22;
let K_RADIUS: u64 = 23;

// The tween endpoints (the boa card: width 120→280, radius 8→40,
// indigo→coral; the orbit rides a radius-80 circle).
let W_MIN: f64 = 120.0;
let W_MAX: f64 = 280.0;
let R_MIN: f64 = 8.0;
let R_MAX: f64 = 40.0;
let ORBIT_CX: f64 = 140.0;
let ORBIT_CY: f64 = 80.0;
let ORBIT_R: f64 = 80.0;
let TAU: f64 = 6.283185307179586;
let HUE_MIN: u64 = 0x6366F1FFu64;
let HUE_MAX: u64 = 0xE85D44FFu64;
let GREEN: u64 = 0x22C55EFFu64;
let AMBER: u64 = 0xF59E0BFFu64;
let INDIGO: u64 = 0x6366F1FFu64;
let SLATE: u64 = 0x94A3B8FFu64;
let CHIP_ON: u64 = 0x1E293BFFu64;
let CHIP_OFF: u64 = 0xE2E8F0FFu64;
let CURVE_ON: u64 = 0x0D9488FFu64;
let LOOP_ON: u64 = 0xDB2777FFu64;

entry fn start() -> u64 {
    let progress = rs_source_f64();
    let width = rs_source_f64();
    let hue = rs_source_f64();
    let pct = rs_source_str("0%");
    let status = rs_source_str("STOPPED");
    let badge = rs_source_f64();
    let loop_on = rs_source_bool(false);
    let sp0 = rs_source_f64();
    let sp1 = rs_source_f64();
    let sp2 = rs_source_f64();
    let sp3 = rs_source_f64();
    let cv0 = rs_source_f64();
    let cv1 = rs_source_f64();
    let cv2 = rs_source_f64();
    let cv3 = rs_source_f64();
    let lp = rs_source_f64();
    let orbit_x = rs_source_f64();
    let orbit_y = rs_source_f64();
    let radius = rs_source_f64();

    rs_set_f64(width, W_MIN);
    rs_set_f64(radius, R_MIN);
    rs_set_f64(orbit_x, ORBIT_CX + ORBIT_R);
    rs_set_f64(orbit_y, ORBIT_CY);
    rs_set_brush(badge, SLATE);
    rs_set_brush(hue, HUE_MIN); // the card boots indigo (the bound-brush seed)

    // The stash: atom ids + the controller state cross into the entries
    // as plain scalars (entries cannot capture locals).
    stf_put(K_PROGRESS, progress as f64);
    stf_put(K_WIDTH, width as f64);
    stf_put(K_HUE, hue as f64);
    stf_put(K_PCT, pct as f64);
    stf_put(K_STATUS, status as f64);
    stf_put(K_BADGE, badge as f64);
    stf_put(K_SP0, sp0 as f64);
    stf_put(K_SP1, sp1 as f64);
    stf_put(K_SP2, sp2 as f64);
    stf_put(K_SP3, sp3 as f64);
    stf_put(K_CV0, cv0 as f64);
    stf_put(K_CV1, cv1 as f64);
    stf_put(K_CV2, cv2 as f64);
    stf_put(K_CV3, cv3 as f64);
    stf_put(K_LP, lp as f64);
    stf_put(K_LOOPON, loop_on as f64);
    stf_put(K_ORBIT_X, orbit_x as f64);
    stf_put(K_ORBIT_Y, orbit_y as f64);
    stf_put(K_RADIUS, radius as f64);
    stf_put(K_CURVE, 3.0); // easeInOut — the boa boot curve
    stf_put(K_LOOPB, 0.0);
    let ctrl = anim_ctrl(progress, 2400.0, "easeInOut", 1 as u64, a_tick, a_end);
    st_put(K_CTRL, ctrl);

    paint_speed(1.0);
    paint_curve(3.0);
    paint_loop();

    let mut col = Column()
        .main_alignment(MAIN_ALIGN_CENTER)
        .cross_alignment(CROSS_ALIGN_CENTER)
        .child(Text().text("Animated Card Studio").font_size(16.0).color(0x0F172AFFu64).query_key("cas-title").build())
        .child(SizedBox(0.0, 4.0).build())
        .child(Row().main_axis_size(MAIN_SIZE_MIN).cross_alignment(CROSS_ALIGN_CENTER).child(status_badge()).child(gap(12.0)).child(
            Text().text_bound(pct).font_size(12.0).color(0x475569FFu64).query_key("cas-pct").build(),
        ).build())
        .child(SizedBox(0.0, 32.0).build())
        .child(stage())
        .child(SizedBox(0.0, 32.0).build())
        .child(Row().main_axis_size(MAIN_SIZE_MIN).child(pill("Play", GREEN, b_play, "cas-play")).child(gap(6.0))
            .child(pill("Pause", AMBER, b_pause, "cas-pause")).child(gap(6.0))
            .child(pill("Resume", 0x0EA5E9FFu64, b_resume, "cas-resume")).child(gap(6.0))
            .child(pill("Reverse", 0x8B5CF6FFu64, b_reverse, "cas-reverse")).child(gap(6.0))
            .child(pill("Stop", 0xEF4444FFu64, b_stop, "cas-stop")).build())
        .child(SizedBox(0.0, 16.0).build())
        .child(Row().main_axis_size(MAIN_SIZE_MIN).cross_alignment(CROSS_ALIGN_CENTER).child(Text().text("Speed:").font_size(11.0).color(0x64748BFFu64).build())
            .child(gap(8.0))
            .child(chip(sp0, "0.5x", b_speed0, "cas-s0")).child(gap(4.0))
            .child(chip(sp1, "1x", b_speed1, "cas-s1")).child(gap(4.0))
            .child(chip(sp2, "2x", b_speed2, "cas-s2")).child(gap(4.0))
            .child(chip(sp3, "4x", b_speed3, "cas-s3")).build())
        .child(SizedBox(0.0, 12.0).build())
        .child(Row().main_axis_size(MAIN_SIZE_MIN).cross_alignment(CROSS_ALIGN_CENTER).child(Text().text("Curve:").font_size(11.0).color(0x64748BFFu64).build())
            .child(gap(8.0))
            .child(chip(cv0, "linear", b_curve0, "cas-c0")).child(gap(4.0))
            .child(chip(cv1, "easeIn", b_curve1, "cas-c1")).child(gap(4.0))
            .child(chip(cv2, "easeOut", b_curve2, "cas-c2")).child(gap(4.0))
            .child(chip(cv3, "easeInOut", b_curve3, "cas-c3")).child(gap(12.0))
            .child(loop_chip()).build())
        .child(SizedBox(0.0, 16.0).build())
        .child(Text().text("Controls: pause mid-play, change speed/curve, resume").font_size(10.0).color(0x94A3B8FFu64).build());
    mount(Container().color(0xF8FAFCFFu64).alignment(ALIGN_CENTER).child(col.build()).build());
    return progress;
}

// ---- the animated stage --------------------------------------------------------

// The boa stage: a 360×200 canvas with the card at (100, 20) and the
// orbiting dot riding its bound anchors (the tick writes
// cx + r·cos / cy + r·sin of the eased progress).
fn stage() -> opaque {
    let orbit_x = stf_take(K_ORBIT_X) as u64;
    stf_put(K_ORBIT_X, orbit_x as f64);
    let orbit_y = stf_take(K_ORBIT_Y) as u64;
    stf_put(K_ORBIT_Y, orbit_y as f64);
    let dot = Positioned()
        .left_bound(orbit_x)
        .top_bound(orbit_y)
        .child(
            Container()
                .width_height(20.0, 20.0)
                .radius(999.0)
                .color(GREEN)
                .shadow(0x22C55E78u64, 16.0, 0.0, 0.0)
                .query_key("cas-dot")
                .build(),
        )
        .build();
    return Stack()
        .child(SizedBox(360.0, 200.0).build())
        .child(Positioned().left(100.0).top(20.0).child(card()).build())
        .child(dot)
        .build();
}

// The card: width + hue + radius ride their atoms (the tick's write
// targets); the inner white square SPINS through the bound row —
// Transform().rotate_bound(progress) re-resolves the angle through the
// live atom (the subscribe → relayout rail) and the subtree never
// re-mounts. Boa's square is opaque — no opacity channel.
fn card() -> opaque {
    let width = stf_take(K_WIDTH) as u64;
    stf_put(K_WIDTH, width as f64);
    let hue = stf_take(K_HUE) as u64;
    stf_put(K_HUE, hue as f64);
    let radius = stf_take(K_RADIUS) as u64;
    stf_put(K_RADIUS, radius as f64);
    let progress = stf_take(K_PROGRESS) as u64;
    stf_put(K_PROGRESS, progress as f64);
    let square = Container().width_height(60.0, 60.0).color(0xFFFFFFFFu64).radius(12.0).build();
    let spin = Transform(1.0, 0.0, 0.0, 0.0).rotate_bound(progress).child(square).build();
    let mut c = Container().width_bound(width).height(160.0).color_bound(hue).radius_bound(radius)
        .shadow(0x0F172A50u64, 24.0, 0.0, 8.0)
        .alignment(ALIGN_CENTER)
        .query_key("cas-card");
    c.child(spin);
    return c.build();
}

// The loop chip: the fill rides its brush atom; the label swaps
// "Loop" ↔ "Loop ✓" (white when on) through the state atom — boa's
// derive-driven label, case-side.
fn loop_chip() -> opaque {
    let lp = stf_take(K_LP) as u64;
    stf_put(K_LP, lp as f64);
    let loop_on = stf_take(K_LOOPON) as u64;
    stf_put(K_LOOPON, loop_on as f64);
    let mut b = Container().padding(6.0).radius(6.0).color_bound(lp).query_key("cas-loop");
    b.child(
        Condition(loop_on)
            .then_build(fn () -> View { return Text().text("Loop ✓").font_size(10.0).color(0xFFFFFFFFu64).build(); })
            .else_build(fn () -> View { return Text().text("Loop").font_size(10.0).color(0x475569FFu64).build(); })
            .build(),
    );
    return PointerInteract().on_tap(b_loop).child(b.build()).build();
}

// The status badge: the label bound to the status atom, the fill bound to
// the badge brush atom.
fn status_badge() -> opaque {
    let status = stf_take(K_STATUS) as u64;
    stf_put(K_STATUS, status as f64);
    let badge = stf_take(K_BADGE) as u64;
    stf_put(K_BADGE, badge as f64);
    let mut b = Container().padding(6.0).radius(999.0).color_bound(badge);
    b.child(Text().text_bound(status).font_size(10.0).color(0xFFFFFFFFu64).query_key("cas-status").build());
    return b.build();
}

// ---- transport entries ---------------------------------------------------------

fn b_play(_a: u64, _b: u64, _n: f64) {
    let c = st_take(K_CTRL);
    anim_forward(c);
    st_put(K_CTRL, c);
    sync(c);
}

fn b_pause(_a: u64, _b: u64, _n: f64) {
    let c = st_take(K_CTRL);
    anim_pause(c);
    st_put(K_CTRL, c);
    sync(c);
}

fn b_resume(_a: u64, _b: u64, _n: f64) {
    let c = st_take(K_CTRL);
    anim_resume(c);
    st_put(K_CTRL, c);
    sync(c);
}

fn b_reverse(_a: u64, _b: u64, _n: f64) {
    let c = st_take(K_CTRL);
    anim_reverse(c);
    st_put(K_CTRL, c);
    sync(c);
}

fn b_stop(_a: u64, _b: u64, _n: f64) {
    let c = st_take(K_CTRL);
    anim_stop(c);
    st_put(K_CTRL, c);
    sync(c);
}

// Speed retimes the controller in place (no recreate).
fn b_speed0(_a: u64, _b: u64, _n: f64) { speed_to(0.5, 0.0); }
fn b_speed1(_a: u64, _b: u64, _n: f64) { speed_to(1.0, 1.0); }
fn b_speed2(_a: u64, _b: u64, _n: f64) { speed_to(2.0, 2.0); }
fn b_speed3(_a: u64, _b: u64, _n: f64) { speed_to(4.0, 3.0); }

fn speed_to(factor: f64, idx: f64) {
    let c = st_take(K_CTRL);
    anim_speed(c, factor);
    st_put(K_CTRL, c);
    paint_speed(idx);
}

// Curve + loop: the boa recreate-and-seek — a fresh controller over the
// same progress atom, seeked to the frozen value, swapped into the stash.
fn b_curve0(_a: u64, _b: u64, _n: f64) { curve_to(0.0); }
fn b_curve1(_a: u64, _b: u64, _n: f64) { curve_to(1.0); }
fn b_curve2(_a: u64, _b: u64, _n: f64) { curve_to(2.0); }
fn b_curve3(_a: u64, _b: u64, _n: f64) { curve_to(3.0); }

fn b_loop(_a: u64, _b: u64, _n: f64) {
    let prev = stf_take(K_LOOPB);
    let next = prev <= 0.5;
    stf_put(K_LOOPB, flag(next));
    let loop_on = stf_take(K_LOOPON) as u64;
    stf_put(K_LOOPON, loop_on as f64);
    rs_set_bool(loop_on, next);
    recreate();
    paint_loop();
}

fn curve_to(idx: f64) {
    stf_put(K_CURVE, idx);
    recreate();
    paint_curve(idx);
}

// Swap in a fresh controller (the stashed curve idx + loop flag) seeked
// to the DISPLAYED eased progress — boa's `ctx.get(progress$)` — so a
// mid-play curve switch continues from the value on screen.
fn recreate() {
    let prev = st_take(K_CTRL);
    let progress = stf_take(K_PROGRESS) as u64;
    stf_put(K_PROGRESS, progress as f64);
    let t = rs_get_f64(progress);
    let next = make_ctrl();
    anim_seek(next, t);
    st_put(K_CTRL, next);
    sync(next);
}

fn make_ctrl() -> opaque {
    let progress = stf_take(K_PROGRESS) as u64;
    stf_put(K_PROGRESS, progress as f64);
    let idx = stf_take(K_CURVE);
    stf_put(K_CURVE, idx);
    let looping = stf_take(K_LOOPB) > 0.5;
    stf_put(K_LOOPB, flag(looping));
    let mut repeat: u64 = 1;
    if (looping) {
        repeat = 18446744073709551615.0 as u64; // the infinite crossing
    }
    return anim_ctrl(progress, 2400.0, curve_name(idx), repeat, a_tick, a_end);
}

fn curve_name(idx: f64) -> str {
    if (idx < 0.5) { return "linear"; }
    if (idx < 1.5) { return "easeIn"; }
    if (idx < 2.5) { return "easeOut"; }
    return "easeInOut";
}

fn flag(b: bool) -> f64 {
    if (b) { return 1.0; }
    return 0.0;
}

// ---- the tick: progress → the animated channels --------------------------------

fn a_tick(_id: u64, v: f64) {
    let width = stf_take(K_WIDTH) as u64;
    stf_put(K_WIDTH, width as f64);
    rs_set_f64(width, tween_lerp(W_MIN, W_MAX, v));
    let radius = stf_take(K_RADIUS) as u64;
    stf_put(K_RADIUS, radius as f64);
    rs_set_f64(radius, tween_lerp(R_MIN, R_MAX, v));
    let hue = stf_take(K_HUE) as u64;
    stf_put(K_HUE, hue as f64);
    rs_set_brush(hue, color_tween_lerp(HUE_MIN, HUE_MAX, v));
    let pct = stf_take(K_PCT) as u64;
    stf_put(K_PCT, pct as f64);
    rs_set_str(pct, f"{((v * 100.0) + 0.5) as u64}%");
    // The rotation channel: the progress atom IS the bound angle's source
    // (Transform().rotate_bound reads it reactively) — the tick just
    // advances it; no list rewrite, no re-mount.
    let progress = stf_take(K_PROGRESS) as u64;
    stf_put(K_PROGRESS, progress as f64);
    rs_set_f64(progress, v);
    // The orbit: (cx + r·cos, cy + r·sin) of a full turn.
    let orbit_x = stf_take(K_ORBIT_X) as u64;
    stf_put(K_ORBIT_X, orbit_x as f64);
    let orbit_y = stf_take(K_ORBIT_Y) as u64;
    stf_put(K_ORBIT_Y, orbit_y as f64);
    rs_set_f64(orbit_x, ORBIT_CX + ORBIT_R * math_cos(TAU * v));
    rs_set_f64(orbit_y, ORBIT_CY + ORBIT_R * math_sin(TAU * v));
}

fn a_end(_id: u64, _v: f64) {
    let c = st_take(K_CTRL);
    st_put(K_CTRL, c);
    sync(c);
}

// Status → the badge label (uppercased, the boa badge) + the fill brush.
fn sync(c: opaque) {
    let s = anim_status(c);
    let status = stf_take(K_STATUS) as u64;
    stf_put(K_STATUS, status as f64);
    rs_set_str(status, upper(s));
    let badge = stf_take(K_BADGE) as u64;
    stf_put(K_BADGE, badge as f64);
    rs_set_brush(badge, badge_color(s));
}

fn upper(s: str) -> str {
    if (s == "stopped") { return "STOPPED"; }
    if (s == "forward") { return "FORWARD"; }
    if (s == "reverse") { return "REVERSE"; }
    if (s == "paused") { return "PAUSED"; }
    if (s == "completed") { return "COMPLETED"; }
    return s;
}

fn badge_color(s: str) -> u64 {
    if (s == "forward" || s == "reverse") { return GREEN; }
    if (s == "paused") { return AMBER; }
    if (s == "completed") { return INDIGO; }
    return SLATE;
}

// ---- the chip paint helpers (the selected-state brushes) -----------------------

fn paint_speed(sel: f64) {
    let sp0 = stf_take(K_SP0) as u64;
    stf_put(K_SP0, sp0 as f64);
    let sp1 = stf_take(K_SP1) as u64;
    stf_put(K_SP1, sp1 as f64);
    let sp2 = stf_take(K_SP2) as u64;
    stf_put(K_SP2, sp2 as f64);
    let sp3 = stf_take(K_SP3) as u64;
    stf_put(K_SP3, sp3 as f64);
    rs_set_brush(sp0, chip_color(sel == 0.0));
    rs_set_brush(sp1, chip_color(sel == 1.0));
    rs_set_brush(sp2, chip_color(sel == 2.0));
    rs_set_brush(sp3, chip_color(sel == 3.0));
}

fn paint_curve(sel: f64) {
    let cv0 = stf_take(K_CV0) as u64;
    stf_put(K_CV0, cv0 as f64);
    let cv1 = stf_take(K_CV1) as u64;
    stf_put(K_CV1, cv1 as f64);
    let cv2 = stf_take(K_CV2) as u64;
    stf_put(K_CV2, cv2 as f64);
    let cv3 = stf_take(K_CV3) as u64;
    stf_put(K_CV3, cv3 as f64);
    rs_set_brush(cv0, curve_chip_color(sel == 0.0));
    rs_set_brush(cv1, curve_chip_color(sel == 1.0));
    rs_set_brush(cv2, curve_chip_color(sel == 2.0));
    rs_set_brush(cv3, curve_chip_color(sel == 3.0));
}

fn paint_loop() {
    let lp = stf_take(K_LP) as u64;
    stf_put(K_LP, lp as f64);
    let on = stf_take(K_LOOPB) > 0.5;
    stf_put(K_LOOPB, flag(on));
    rs_set_brush(lp, loop_color(on));
}

fn chip_color(sel: bool) -> u64 {
    if (sel) { return CHIP_ON; }
    return CHIP_OFF;
}

fn curve_chip_color(sel: bool) -> u64 {
    if (sel) { return CURVE_ON; }
    return CHIP_OFF;
}

fn loop_color(on: bool) -> u64 {
    if (on) { return LOOP_ON; }
    return CHIP_OFF;
}

// ---- the builders ---------------------------------------------------------------

// A transport pill (the boa Button): a PointerInteract pad over a colored
// label.
fn pill(label: str, color: u64, cb: fn(u64, u64, f64), key: str) -> opaque {
    let mut b = Container().padding(8.0).radius(6.0).color(color).query_key(key);
    b.child(Text().text(label).font_size(11.0).color(0xFFFFFFFFu64).build());
    return PointerInteract().on_tap(cb).child(b.build()).build();
}

// A selectable chip (speed / curve / loop): the fill rides its brush atom.
fn chip(atom: u64, label: str, cb: fn(u64, u64, f64), key: str) -> opaque {
    let mut b = Container().padding(6.0).radius(6.0).color_bound(atom).query_key(key);
    b.child(Text().text(label).font_size(10.0).color(0x475569FFu64).build());
    return PointerInteract().on_tap(cb).child(b.build()).build();
}

fn gap(w: f64) -> opaque {
    return Container().width_height(w, 0.0).build();
}
