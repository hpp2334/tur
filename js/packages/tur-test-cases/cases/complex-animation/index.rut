// complex-animation: the showcase twin — a controller-driven animation
// with explicit tween composition (opacity + translate on one target).
use tur::{ anim_ctrl, anim_forward, anim_repeat, mount, rs_source_f64 };
use tur_kit::{ Column, Container, Expanded, SizedBox, Text };
use tur_anim_kit::{ Opacity };


entry fn start() -> u64 {
    let t = rs_source_f64();
    let ctrl = anim_ctrl(t, 2000.0, "easeInOut", 0, "a_tick", "a_end");
    anim_repeat(ctrl, 1000);
    anim_forward(ctrl);

    let mut col = Column()
        .child(SizedBox(400.0, 40.0).child(Text().text("complex-animation: repeat + tween").build()).build());
    let target = Container().width_height(60.0, 60.0).color(0x6366F1FFu64);
    let opacity = Opacity(0.0).bound(t).child(target.build()).build();
    col.child(Expanded().flex(1.0).child(opacity).build());
    mount(col.build());
    return t;
}

entry fn a_tick(_atom: u64, _t: f64) {
}

entry fn a_end(_atom: u64, _v: f64) {
}
