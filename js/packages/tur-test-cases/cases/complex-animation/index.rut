// complex-animation: the showcase twin — a controller-driven animation
// with explicit tween composition (opacity + translate on one target).
use tur::{ anim_ctrl, anim_forward, anim_repeat, curve_eval, el_box_new, box_color, box_size, el_build, el_child, el_column, el_expand, el_opacity_bound, el_sizedbox, el_text_new, mount, rs_source_f64 };

entry fn start() -> u64 {
    let t = rs_source_f64();
    let ctrl = anim_ctrl(t, 2000.0, "easeInOut", 0, "a_tick", "a_end");
    anim_repeat(ctrl, 1000);
    anim_forward(ctrl);

    let col = el_column();
    el_child(col, el_sizedbox(400.0, 40.0, el_build(el_text_new("complex-animation: repeat + tween"))));
    let target = el_box_new();
    box_size(target, 60.0, 60.0);
    box_color(target, 0x6366F1FFu64);
    let opacity = el_opacity_bound(t, target);
    el_child(col, el_expand(1.0, opacity));
    mount(el_build(col));
    return t;
}

entry fn a_tick(_atom: u64, _t: f64) {
}

entry fn a_end(_atom: u64, _v: f64) {
}
