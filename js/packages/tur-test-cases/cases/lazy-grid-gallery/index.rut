// lazy-grid-gallery: "Lazy Grid Gallery" — the massive virtualized palette
// (the full boa restyle). 6,000 tiles; only the visible window + overscan
// mounts, so scrolling stays smooth no matter how deep. The flush-left
// header (title + the "6,000 tiles · only the visible rows mount — scroll
// to explore" subtitle) sits above the Square/Wide/Tall aspect chips and
// the Normal/Dense density chips and an Expanded, rounded panel holding
// the grid.
//
// Reactivity: the LazyGrid's max_cross / aspect rows are static per build,
// so the chips ride the rebuild-on-change idiom — the grid hangs on a
// one-item Each and every tap rewrites the list source, re-mounting a
// fresh LazyGrid that reads the live aspect / density state (the
// lazy-list-var-sizes axis-flip pattern; the eager grid-gallery spells the
// same matrix out as one flat Switch). Chip fills ride per-chip brush
// sources, seeded + repainted from the tap mutations. The 6,000 count is
// reactive (the lazy count row takes the handle).
//
// Deltas vs boa, deliberate: the boa 4px grid spacing has no lazy-grid
// row, so each cell pads 2 — the between-tile gap re-forms as 2+2 of the
// panel background; tiles carry a 6px radius (the audit's "rounded hue
// tiles"); the aspect re-derive remounts the grid (scroll resets) where
// boa reflows in place.
use tur::{ CROSS_ALIGN_START, CURSOR_POINTER, MAIN_SIZE_MIN, ctx_bridge, mount };
use tur_kit::{
    Column, Container, Each, Expanded, LazyGrid, MouseRegion, Mutation, MutationCtx,
    PointerInteract, Readable, Row, SizedBox, Text, list_new, list_push, mutate, source_bool,
    source_f64, source_value,
};


// The boa palette (the deep-slate gallery chrome).
let PAGE_BG: u64 = 0x0F172AFFu64;
let TITLE_FG: u64 = 0xF1F5F9FFu64;
let SUB_FG: u64 = 0x94A3B8FFu64;
let PANEL_BG: u64 = 0x020617FFu64;
let CHIP_ON: u64 = 0x6366F1FFu64;
let CHIP_OFF: u64 = 0x1E293BFFu64;
let CHIP_FG: u64 = 0xE2E8F0FFu64;

entry fn start() {
    let aspect: Readable<f64> = source_f64(1.0);
    let dense: Readable<bool> = source_bool(false);
    let count: Readable<f64> = source_f64(6000.0);
    let items: Readable<opaque> = source_value(one_list());

    // The five chip brushes (Square / Wide / Tall / Normal / Dense),
    // seeded to the boot state (Square + Normal).
    let chips: [Readable<f64>] = [
        source_f64(0.0), source_f64(0.0), source_f64(0.0), source_f64(0.0), source_f64(0.0),
    ];
    paint_chips(MutationCtx.over(ctx_bridge()), aspect, dense, chips);

    // The chip taps: write the state, repaint the trio, remount the grid.
    let b_square = aspect_mutation(aspect, dense, chips, items, 1.0);
    let b_wide = aspect_mutation(aspect, dense, chips, items, 2.0);
    let b_tall = aspect_mutation(aspect, dense, chips, items, 0.5);
    let b_normal = dense_mutation(aspect, dense, chips, items, false);
    let b_dense = dense_mutation(aspect, dense, chips, items, true);

    let col = Column()
        .cross_alignment(CROSS_ALIGN_START)
        .query_key("gallery/col")
        .child(Text().text("Lazy Grid Gallery").font_size(18.0).color(TITLE_FG).query_key("gallery/header").build())
        .child(SizedBox(0.0, 4.0).build())
        .child(Text().text("6,000 tiles · only the visible rows mount — scroll to explore").font_size(12.0).color(SUB_FG).build())
        .child(SizedBox(0.0, 12.0).build())
        .child(
            Row()
                .main_axis_size(MAIN_SIZE_MIN)
                .child(chip(chips[0], "gallery/a-square", "Square", b_square))
                .child(SizedBox(6.0, 0.0).build())
                .child(chip(chips[1], "gallery/a-wide", "Wide", b_wide))
                .child(SizedBox(6.0, 0.0).build())
                .child(chip(chips[2], "gallery/a-tall", "Tall", b_tall))
                .build(),
        )
        .child(SizedBox(0.0, 8.0).build())
        .child(
            Row()
                .main_axis_size(MAIN_SIZE_MIN)
                .child(chip(chips[3], "gallery/d-normal", "Normal", b_normal))
                .child(SizedBox(6.0, 0.0).build())
                .child(chip(chips[4], "gallery/d-dense", "Dense", b_dense))
                .build(),
        )
        .child(SizedBox(0.0, 12.0).build())
        .child(
            Expanded().flex(1.0).child(
                Container()
                    .color(PANEL_BG)
                    .radius(10.0)
                    .child(Each(items).item_builder(fn (_i: u64, _s: str) -> View {
                        return grid_of(aspect, dense, count);
                    }).build())
                    .build(),
            ).build(),
        )
        .build();

    mount(Container().color(PAGE_BG).padding(16.0).child(col).build());
}

// ---- the grid (the rebuild channel) --------------------------------------------

// A fresh one-item list — rewriting it re-invokes the Each (the grid
// re-mounts with the live aspect / density read at build time).
fn one_list() -> opaque {
    let fresh = list_new();
    list_push(fresh, "grid");
    return fresh;
}

// The Each branch: one LazyGrid over the LIVE state (aspect shapes the
// cells; density narrows the max cross 140 → 85 — more, smaller tiles).
// The handles ride by parameter; the read face is the ctx over the
// bridge.
fn grid_of(aspect: Readable<f64>, dense: Readable<bool>, count: Readable<f64>) -> opaque {
    let read = MutationCtx.over(ctx_bridge());
    let mut max_cross: f64 = 140.0;
    if (read.get_bool(dense)) {
        max_cross = 85.0;
    }
    return LazyGrid()
        .item_builder(tile)
        .count(count)
        .max_cross(max_cross)
        .aspect(read.get_f64(aspect))
        .overscan(2)
        .query_key("gallery/grid")
        .build();
}

// One tile: the rounded hue face (hue = (i*37) % 360 at 52/48) with the
// index label, inset 2 in its cell (the spacing stand-in — see the header
// note).
fn tile(i: u64) -> opaque {
    let face = Container()
        .color(hsl_packed(((i * 37) % 360) as f64, 52.0, 48.0))
        .radius(6.0)
        .child(Text().text(f"{i}").font_size(10.0).color(CHIP_FG).build())
        .build();
    return Container().padding(2.0).child(face).build();
}

// ---- the chips -----------------------------------------------------------------

// A pill chip: the fill rides its brush source (indigo when active).
fn chip(r: Readable<f64>, key: str, label: str, m: Mutation<nil, nil>) -> opaque {
    let face = Container()
        .padding(7.0)
        .radius(7.0)
        .color_bound(r)
        .child(Text().text(label).font_size(12.0).color(CHIP_FG).build())
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(PointerInteract().on_click(m).query_key(key).child(face).build())
        .build();
}

// ---- the chip taps -------------------------------------------------------------

// An aspect tap's mutation: write the value, repaint the chips, remount
// the grid.
fn aspect_mutation(aspect: Readable<f64>, dense: Readable<bool>, chips: [Readable<f64>],
                   items: Readable<opaque>, v: f64) -> Mutation<nil, nil> {
    return mutate(fn (ctx: MutationCtx) {
        ctx.set_f64(aspect, v);
        paint_chips(ctx, aspect, dense, chips);
        ctx.set_value(items, one_list());
    });
}

// A density tap's mutation (the mirror twin over the bool).
fn dense_mutation(aspect: Readable<f64>, dense: Readable<bool>, chips: [Readable<f64>],
                  items: Readable<opaque>, d: bool) -> Mutation<nil, nil> {
    return mutate(fn (ctx: MutationCtx) {
        ctx.set_bool(dense, d);
        paint_chips(ctx, aspect, dense, chips);
        ctx.set_value(items, one_list());
    });
}

// The five chip brushes over the live state (boa: derive-driven pills).
fn paint_chips(ctx: MutationCtx, aspect: Readable<f64>, dense: Readable<bool>,
               chips: [Readable<f64>]) {
    let a = ctx.get_f64(aspect);
    let d = ctx.get_bool(dense);
    ctx.set_brush(chips[0], chip_color(a > 0.5 && a < 1.5));
    ctx.set_brush(chips[1], chip_color(a > 1.5));
    ctx.set_brush(chips[2], chip_color(a < 0.5));
    ctx.set_brush(chips[3], chip_color(!d));
    ctx.set_brush(chips[4], chip_color(d));
}

fn chip_color(on: bool) -> u64 {
    if (on) {
        return CHIP_ON;
    }
    return CHIP_OFF;
}

// ---- the tile ramp ---------------------------------------------------------------

// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).
fn hsl_packed(h: f64, s: f64, l: f64) -> u64 {
    let sat: f64 = s / 100.0;
    let light: f64 = l / 100.0;
    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;
    let hue: f64 = h % 360.0;
    let hp: f64 = hue / 60.0;
    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));
    let mut r1: f64 = 0.0;
    let mut g1: f64 = 0.0;
    let mut b1: f64 = 0.0;
    if (hp < 1.0) {
        r1 = c;
        g1 = x;
    } else if (hp < 2.0) {
        r1 = x;
        g1 = c;
    } else if (hp < 3.0) {
        g1 = c;
        b1 = x;
    } else if (hp < 4.0) {
        g1 = x;
        b1 = c;
    } else if (hp < 5.0) {
        r1 = x;
        b1 = c;
    } else {
        r1 = c;
        b1 = x;
    }
    let m: f64 = light - c / 2.0;
    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;
    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;
    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;
    return r * 16777216 + g * 65536 + b * 256 + 255;
}

fn abs_f(v: f64) -> f64 {
    if (v < 0.0) {
        return -v;
    }
    return v;
}
