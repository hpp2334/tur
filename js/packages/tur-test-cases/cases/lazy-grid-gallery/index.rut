// lazy-grid-gallery: "Lazy Grid Gallery" — the massive virtualized palette
// (the full boa restyle). 6,000 tiles; only the visible window + overscan
// mounts, so scrolling stays smooth no matter how deep. The flush-left
// header (title + the "6000 tiles · only the visible rows mount — scroll
// to explore" subtitle) sits above the Square/Wide/Tall aspect chips and
// the Normal/Dense density chips and an Expanded, rounded panel holding
// the grid.
//
// Reactivity: the LazyGrid's max_cross / aspect rows are static per build,
// so the chips ride the rebuild-on-change idiom — the grid hangs on a
// one-item Each and every tap rewrites the list atom, re-mounting a fresh
// LazyGrid that reads the live aspect / density state (the
// lazy-list-var-sizes axis-flip pattern; the eager grid-gallery spells the
// same matrix out as one flat Switch). Chip fills ride per-chip brush
// atoms (rs_set_brush), seeded + repainted from the tap intents.
//
// Deltas vs boa, deliberate: the boa 4px grid spacing has no lazy-grid
// row, so each cell pads 2 — the between-tile gap re-forms as 2+2 of the
// panel background; tiles carry a 6px radius (the audit's "rounded hue
// tiles"); the aspect re-derive remounts the grid (scroll resets) where
// boa reflows in place.
use tur::{
    CROSS_ALIGN_START, CURSOR_POINTER, MAIN_SIZE_MIN, mount, rs_get_bool, rs_get_f64,
    rs_list_new, rs_list_push, rs_set_bool, rs_set_brush, rs_set_f64, rs_set_value,
    rs_source_bool, rs_source_f64, rs_source_value, stf_put, stf_take,
};
use tur_kit::{
    Column, Container, Each, Expanded, LazyGrid, MouseRegion, PointerInteract, Row, SizedBox, Text,
};


// The scalar-stash keys (atom ids cross the entries as f64).
let K_ASPECT: u64 = 1; // the aspect atom (1 = square, 2 = wide, 0.5 = tall)
let K_DENSE: u64 = 2; // the density bool atom
let K_COUNT: u64 = 3; // the 6000-item count atom
let K_ITEMS: u64 = 4; // the one-item list re-mounting the grid
let K_SQ: u64 = 5; // the Square chip brush
let K_WD: u64 = 6; // the Wide chip brush
let K_TL: u64 = 7; // the Tall chip brush
let K_NM: u64 = 8; // the Normal chip brush
let K_DS: u64 = 9; // the Dense chip brush

// The boa palette (the deep-slate gallery chrome).
let PAGE_BG: u64 = 0x0F172AFFu64;
let TITLE_FG: u64 = 0xF1F5F9FFu64;
let SUB_FG: u64 = 0x94A3B8FFu64;
let PANEL_BG: u64 = 0x020617FFu64;
let CHIP_ON: u64 = 0x6366F1FFu64;
let CHIP_OFF: u64 = 0x1E293BFFu64;
let CHIP_FG: u64 = 0xE2E8F0FFu64;

entry fn start() {
    let aspect = rs_source_f64();
    rs_set_f64(aspect, 1.0);
    let dense = rs_source_bool(false);
    let count = rs_source_f64();
    rs_set_f64(count, 6000.0);
    let items = rs_source_value(one_list());
    stf_put(K_ASPECT, aspect as f64);
    stf_put(K_DENSE, dense as f64);
    stf_put(K_COUNT, count as f64);
    stf_put(K_ITEMS, items as f64);

    // The five chip brushes, seeded to the boot state (Square + Normal).
    let sq = rs_source_f64();
    stf_put(K_SQ, sq as f64);
    let wd = rs_source_f64();
    stf_put(K_WD, wd as f64);
    let tl = rs_source_f64();
    stf_put(K_TL, tl as f64);
    let nm = rs_source_f64();
    stf_put(K_NM, nm as f64);
    let ds = rs_source_f64();
    stf_put(K_DS, ds as f64);
    paint_chips();

    let col = Column()
        .cross_alignment(CROSS_ALIGN_START)
        .query_key("gallery/col")
        .child(Text().text("Lazy Grid Gallery").font_size(18.0).color(TITLE_FG).query_key("gallery/header").build())
        .child(SizedBox(0.0, 4.0).build())
        .child(Text().text("6000 tiles · only the visible rows mount — scroll to explore").font_size(12.0).color(SUB_FG).build())
        .child(SizedBox(0.0, 12.0).build())
        .child(
            Row()
                .main_axis_size(MAIN_SIZE_MIN)
                .child(chip(sq, "gallery/a-square", "Square", b_square))
                .child(SizedBox(6.0, 0.0).build())
                .child(chip(wd, "gallery/a-wide", "Wide", b_wide))
                .child(SizedBox(6.0, 0.0).build())
                .child(chip(tl, "gallery/a-tall", "Tall", b_tall))
                .build(),
        )
        .child(SizedBox(0.0, 8.0).build())
        .child(
            Row()
                .main_axis_size(MAIN_SIZE_MIN)
                .child(chip(nm, "gallery/d-normal", "Normal", b_normal))
                .child(SizedBox(6.0, 0.0).build())
                .child(chip(ds, "gallery/d-dense", "Dense", b_dense))
                .build(),
        )
        .child(SizedBox(0.0, 12.0).build())
        .child(
            Expanded().flex(1.0).child(
                Container()
                    .color(PANEL_BG)
                    .radius(10.0)
                    .child(Each(items).item_builder(grid_of).build())
                    .build(),
            ).build(),
        )
        .build();

    mount(Container().color(PAGE_BG).padding(16.0).child(col).build());
}

// ---- the grid (the rebuild channel) --------------------------------------------

// A fresh one-item list — rewriting it re-invokes the Each (the grid
// re-mounts with the live aspect / density read at build time).
fn one_list() -> opaque {
    let fresh = rs_list_new();
    rs_list_push(fresh, "grid");
    return fresh;
}

// The Each branch: one LazyGrid over the LIVE state (aspect shapes the
// cells; density narrows the max cross 140 → 85 — more, smaller tiles).
fn grid_of(_i: u64, _s: str) -> opaque {
    let aspect = stf_take(K_ASPECT) as u64;
    stf_put(K_ASPECT, aspect as f64);
    let dense = stf_take(K_DENSE) as u64;
    stf_put(K_DENSE, dense as f64);
    let count = stf_take(K_COUNT) as u64;
    stf_put(K_COUNT, count as f64);
    let mut max_cross: f64 = 140.0;
    if (rs_get_bool(dense)) {
        max_cross = 85.0;
    }
    return LazyGrid()
        .item_builder(tile)
        .count(count)
        .max_cross(max_cross)
        .aspect(rs_get_f64(aspect))
        .overscan(2)
        .query_key("gallery/grid")
        .build();
}

// One tile: the rounded hue face (hue = (i*37) % 360 at 52/48) with the
// index label, inset 2 in its cell (the spacing stand-in — see the header
// note).
fn tile(i: u64) -> opaque {
    let face = Container()
        .color(hsl_packed(((i * 37) % 360) as f64, 52.0, 48.0))
        .radius(6.0)
        .child(Text().text(f"{i}").font_size(10.0).color(CHIP_FG).build())
        .build();
    return Container().padding(2.0).child(face).build();
}

// ---- the chips -----------------------------------------------------------------

// A pill chip: the fill rides its brush atom (indigo when active).
fn chip(atom: u64, key: str, label: str, cb: fn(u64, u64, f64)) -> opaque {
    let face = Container()
        .padding(7.0)
        .radius(7.0)
        .color_bound(atom)
        .child(Text().text(label).font_size(12.0).color(CHIP_FG).build())
        .build();
    return MouseRegion()
        .cursor(CURSOR_POINTER)
        .child(PointerInteract().on_tap(cb).query_key(key).child(face).build())
        .build();
}

// ---- the chip taps ---------------------------------------------------------------

fn b_square(_a: u64, _b: u64, _n: f64) { aspect_to(1.0); }
fn b_wide(_a: u64, _b: u64, _n: f64) { aspect_to(2.0); }
fn b_tall(_a: u64, _b: u64, _n: f64) { aspect_to(0.5); }
fn b_normal(_a: u64, _b: u64, _n: f64) { dense_to(false); }
fn b_dense(_a: u64, _b: u64, _n: f64) { dense_to(true); }

// An aspect tap: write the atom, repaint the chips, remount the grid.
fn aspect_to(v: f64) {
    let aspect = stf_take(K_ASPECT) as u64;
    stf_put(K_ASPECT, aspect as f64);
    rs_set_f64(aspect, v);
    paint_chips();
    remount_grid();
}

// A density tap: same rail over the bool atom.
fn dense_to(d: bool) {
    let dense = stf_take(K_DENSE) as u64;
    stf_put(K_DENSE, dense as f64);
    rs_set_bool(dense, d);
    paint_chips();
    remount_grid();
}

// The five chip brushes over the live state (boa: derive-driven pills).
fn paint_chips() {
    let aspect = stf_take(K_ASPECT) as u64;
    stf_put(K_ASPECT, aspect as f64);
    let dense = stf_take(K_DENSE) as u64;
    stf_put(K_DENSE, dense as f64);
    let a = rs_get_f64(aspect);
    let d = rs_get_bool(dense);
    let sq = stf_take(K_SQ) as u64;
    stf_put(K_SQ, sq as f64);
    let wd = stf_take(K_WD) as u64;
    stf_put(K_WD, wd as f64);
    let tl = stf_take(K_TL) as u64;
    stf_put(K_TL, tl as f64);
    let nm = stf_take(K_NM) as u64;
    stf_put(K_NM, nm as f64);
    let ds = stf_take(K_DS) as u64;
    stf_put(K_DS, ds as f64);
    rs_set_brush(sq, chip_color(a > 0.5 && a < 1.5));
    rs_set_brush(wd, chip_color(a > 1.5));
    rs_set_brush(tl, chip_color(a < 0.5));
    rs_set_brush(nm, chip_color(!d));
    rs_set_brush(ds, chip_color(d));
}

fn chip_color(on: bool) -> u64 {
    if (on) {
        return CHIP_ON;
    }
    return CHIP_OFF;
}

// The rebuild channel: a fresh one-item list re-invokes the Each.
fn remount_grid() {
    let items = stf_take(K_ITEMS) as u64;
    stf_put(K_ITEMS, items as f64);
    rs_set_value(items, one_list());
}

// ---- the tile ramp ---------------------------------------------------------------

// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).
fn hsl_packed(h: f64, s: f64, l: f64) -> u64 {
    let sat: f64 = s / 100.0;
    let light: f64 = l / 100.0;
    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;
    let hue: f64 = h % 360.0;
    let hp: f64 = hue / 60.0;
    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));
    let mut r1: f64 = 0.0;
    let mut g1: f64 = 0.0;
    let mut b1: f64 = 0.0;
    if (hp < 1.0) {
        r1 = c;
        g1 = x;
    } else if (hp < 2.0) {
        r1 = x;
        g1 = c;
    } else if (hp < 3.0) {
        g1 = c;
        b1 = x;
    } else if (hp < 4.0) {
        g1 = x;
        b1 = c;
    } else if (hp < 5.0) {
        r1 = x;
        b1 = c;
    } else {
        r1 = c;
        b1 = x;
    }
    let m: f64 = light - c / 2.0;
    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;
    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;
    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;
    return r * 16777216 + g * 65536 + b * 256 + 255;
}

fn abs_f(v: f64) -> f64 {
    if (v < 0.0) {
        return -v;
    }
    return v;
}
