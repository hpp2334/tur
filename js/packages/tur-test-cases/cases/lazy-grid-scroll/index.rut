// lazy-grid-scroll: the boa design — 5000 cells over a hue ramp
// ((i·37) % 360 at 50/45), FIXED 60px rows (item_extent — the boa
// mainAxisExtent) with 6px cross/main gaps, max cross 120, overscan 2.
// Wheeling mounts only the visible window; the ramp IS the show (boa's
// dark zebra is gone).
use tur::mount;
use tur_kit::{ Container, LazyGrid, source_f64 };


fn cell(i: u64) -> opaque {
    return Container().color(hsl_packed(((i * 37) % 360) as f64, 50.0, 45.0)).build();
}

entry fn start() {
    let count = source_f64(5000.0);
    let grid = LazyGrid()
        .item_builder(cell)
        .count(count)
        .max_cross(120.0)
        .item_extent(60.0)
        .spacing(6.0, 6.0)
        .overscan(2)
        .query_key("lazy-grid-scroll")
        .build();
    mount(grid);
}

// ---- the tile ramp (the boa hslToHex) -------------------------------------

// hsl(h, s%, l%) → the packed 0xRRGGBBAA color.
fn hsl_packed(h: f64, s: f64, l: f64) -> u64 {
    let sat: f64 = s / 100.0;
    let light: f64 = l / 100.0;
    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;
    let hue: f64 = h % 360.0;
    let hp: f64 = hue / 60.0;
    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));
    let mut r1: f64 = 0.0;
    let mut g1: f64 = 0.0;
    let mut b1: f64 = 0.0;
    if (hp < 1.0) {
        r1 = c;
        g1 = x;
    } else if (hp < 2.0) {
        r1 = x;
        g1 = c;
    } else if (hp < 3.0) {
        g1 = c;
        b1 = x;
    } else if (hp < 4.0) {
        g1 = x;
        b1 = c;
    } else if (hp < 5.0) {
        r1 = x;
        b1 = c;
    } else {
        r1 = c;
        b1 = x;
    }
    let m: f64 = light - c / 2.0;
    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;
    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;
    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;
    return r * 16777216 + g * 65536 + b * 256 + 255;
}

fn abs_f(v: f64) -> f64 {
    if (v < 0.0) {
        return -v;
    }
    return v;
}
