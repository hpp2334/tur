// pointer-interact-in-column: two gesture pads stacked in a column.
use tur::{ CROSS_ALIGN_START, mount, rs_source_f64 };
use tur_kit::{ Column, Container, PointerInteract };


entry fn start() {
    let pad = rs_source_f64();
    let mut col = Column.builder();
    col.cross_alignment(CROSS_ALIGN_START);
    let mut a = Container.builder();
    a.width_height(80.0, 40.0);
    let mut b = Container.builder();
    b.width_height(60.0, 30.0);
    col.child(PointerInteract.builder().ids(pad, pad).child(a.build()).build());
    col.child(PointerInteract.builder().ids(pad, pad).child(b.build()).build());
    mount(col.build());
}
