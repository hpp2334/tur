// grid-aspect: aspect-ratio + fixed-extent grid cells (the boa port, plus
// the mainAxisExtent grid its header comment promises). The first grid
// tiles 10 hue cells at childAspectRatio 2 (each cell twice as wide as it
// is tall: cell_main = cell_cross / 2); the second exercises
// `main_extent`, which overrides the aspect with a fixed 40px row height.
// Both grids ride `max_cross` 160 for the column count.
use tur::{ CROSS_ALIGN_START, MAIN_SIZE_MIN, mount };
use tur_kit::{ Column, Container, Grid, ScrollView, SizedBox, Text };


let LABEL_FG: u64 = 0xFFFFFFFFu64;
let CAPTION_FG: u64 = 0x94A3B8FFu64;

entry fn start() {
    let page = Column()
        .cross_alignment(CROSS_ALIGN_START)
        .main_axis_size(MAIN_SIZE_MIN)
        .child(Text().text("aspect 2:1 (10 cells)").font_size(11.0).color(CAPTION_FG).build())
        .child(SizedBox(0.0, 6.0).build())
        .child(aspect_grid())
        .child(SizedBox(0.0, 16.0).build())
        .child(Text().text("mainAxisExtent 40 (10 cells)").font_size(11.0).color(CAPTION_FG).build())
        .child(SizedBox(0.0, 6.0).build())
        .child(extent_grid())
        .build();
    mount(ScrollView().child(page).build());
}

// The aspect-2 grid: 10 hue cells labeled #i.
fn aspect_grid() -> opaque {
    let mut grid = Grid().max_cross(160.0).aspect(2.0).spacing(6.0, 6.0).query_key("grid-aspect");
    let mut i: u64 = 0;
    while (i < 10) {
        let cell = Container()
            .color(hsl_packed(i as f64 * 36.0 + 40.0, 60.0, 55.0))
            .child(Text().text(f"#{i}").font_size(12.0).color(LABEL_FG).build());
        grid.child(cell.build());
        i = i + 1;
    }
    return grid.build();
}

// The fixed-extent grid: main_extent pins each row at 40px tall
// (overriding the aspect), same 10-cell ramp.
fn extent_grid() -> opaque {
    let mut grid = Grid().max_cross(160.0).main_extent(40.0).spacing(6.0, 6.0).query_key("grid-aspect-extent");
    let mut i: u64 = 0;
    while (i < 10) {
        let cell = Container()
            .color(hsl_packed(i as f64 * 36.0 + 40.0, 60.0, 55.0))
            .child(Text().text(f"#{i}").font_size(12.0).color(LABEL_FG).build());
        grid.child(cell.build());
        i = i + 1;
    }
    return grid.build();
}

// hsl(h, s%, l%) → the packed 0xRRGGBBAA color (the boa tile ramp).
fn hsl_packed(h: f64, s: f64, l: f64) -> u64 {
    let sat: f64 = s / 100.0;
    let light: f64 = l / 100.0;
    let c: f64 = (1.0 - abs_f(2.0 * light - 1.0)) * sat;
    let hue: f64 = h % 360.0;
    let hp: f64 = hue / 60.0;
    let x: f64 = c * (1.0 - abs_f(hp % 2.0 - 1.0));
    let mut r1: f64 = 0.0;
    let mut g1: f64 = 0.0;
    let mut b1: f64 = 0.0;
    if (hp < 1.0) {
        r1 = c;
        g1 = x;
    } else if (hp < 2.0) {
        r1 = x;
        g1 = c;
    } else if (hp < 3.0) {
        g1 = c;
        b1 = x;
    } else if (hp < 4.0) {
        g1 = x;
        b1 = c;
    } else if (hp < 5.0) {
        r1 = x;
        b1 = c;
    } else {
        r1 = c;
        b1 = x;
    }
    let m: f64 = light - c / 2.0;
    let r: u64 = ((r1 + m) * 255.0 + 0.5) as u64;
    let g: u64 = ((g1 + m) * 255.0 + 0.5) as u64;
    let b: u64 = ((b1 + m) * 255.0 + 0.5) as u64;
    return r * 16777216 + g * 65536 + b * 256 + 255;
}

fn abs_f(v: f64) -> f64 {
    if (v < 0.0) {
        return -v;
    }
    return v;
}
