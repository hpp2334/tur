// text-font-size: a Fragment of 14px and 28px Texts — the root's children
// stay flat (the fragment is layout-transparent).
use tur::{ mount };
use tur_kit::{ Fragment, Text };


entry fn start() {
    let mut small = Text.new();

    small.text("Hello");
    small.font_size(14.0);
    let mut large = Text.new();

    large.text("Hello");
    large.font_size(28.0);
    mount(Fragment.new().children([small.build(), large.build()]).build());
}
