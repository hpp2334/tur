// expanded-basic: a fixed-height child plus an Expanded filling the
// remaining main axis.
use tur::{ CROSS_ALIGN_START, mount };
use tur_kit::{ Column, Container, Expanded };


fn box_wh(w: f64, h: f64) -> opaque {
    let mut b = Container.new();
    b.width_height(w, h);
    return b.build();
}

entry fn start() {
    let mut col = Column.new();
    col.cross_alignment(CROSS_ALIGN_START);
    col.child(box_wh(0.0, 50.0));
    col.child(Expanded.new().flex(1.0).child(box_wh(0.0, 0.0)).build());
    mount(col.build());
}
