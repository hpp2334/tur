// drag-over-text: a Positioned -> Transform -> PointerInteract -> Text
// piece — a non-selectable Text must not steal touch drags from the
// PointerInteract beneath. The down count renders into `down-count`.
use tur::{ ALIGN_TOP_LEFT, mount };
use tur_kit::{ Container, MutationCtx, PointerEvent, PointerInteract, Readable, SizedBox, Stack,
    Text, mutate_ev, source_f64, source_str };
use tur_anim_kit::{ Transform };


entry fn start() -> u64 {
    let count: Readable<str> = source_str("0");
    let n: Readable<f64> = source_f64(0.0);
    let phase: Readable<str> = source_str("");

    let b_down = mutate_ev(fn (ctx: MutationCtx, _ev: PointerEvent) {
        ctx.set_f64(n, ctx.get_f64(n) + 1.0);
        ctx.set_str(count, f"{ctx.get_f64(n) as u64}");
        ctx.set_str(phase, "down");
    });
    let b_move = mutate_ev(fn (ctx: MutationCtx, _ev: PointerEvent) {
        ctx.set_str(phase, "move");
    });
    let b_up = mutate_ev(fn (ctx: MutationCtx, _ev: PointerEvent) {
        ctx.set_str(phase, "up");
    });

    let mut stack = Stack()
        .alignment(ALIGN_TOP_LEFT)
        .child(SizedBox(400.0, 400.0).child(Container().build()).build());

    let label = Text().text("drag me").font_size(14.0);
    let piece = Container().width_height(80.0, 40.0).query_key("drag-target").child(label.build());
    let pad = PointerInteract().on_pointer_down(b_down).on_pointer_move(b_move).on_pointer_up(b_up).query_key("rut/gesture").child(piece.build()).build();
    stack.child(Transform(1.0, 0.0, 60.0, 50.0).child(pad).build());

    let count_t = Text().text_bound(count).query_key("down-count");
    stack.child(count_t.build());
    mount(stack.build());
    return n.atom_id();
}
