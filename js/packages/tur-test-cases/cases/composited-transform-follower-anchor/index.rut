// composited-transform-follower-anchor: explicit follower anchor — the
// follower's BOTTOM_RIGHT lands on the target's top-left (the anchor
// math the subsystem solves).
use tur::{ ALIGN_BOTTOM_RIGHT, ALIGN_TOP_LEFT, el_box_new, box_color, box_size, el_build, el_child, el_ct_follower, el_ct_target, ct_link_new, el_positioned, el_sizedbox, el_stack, mount };

entry fn start() {
    let link = ct_link_new();
    let stack = el_stack();
    el_child(stack, el_sizedbox(400.0, 600.0, el_build(el_box_new())));
    let target_child = el_sizedbox(60.0, 40.0, el_build(el_box_new()));
    let target = el_ct_target(link, target_child);
    el_child(stack, el_positioned(100.0, 80.0, target));
    let red = el_box_new();
    box_size(red, 20.0, 20.0);
    box_color(red, 0xFF0000FFu64);
    let follower = el_ct_follower(link, ALIGN_TOP_LEFT, ALIGN_BOTTOM_RIGHT, 0.0, 0.0, el_build(red));
    el_child(stack, follower);
    mount(el_build(stack));
}
