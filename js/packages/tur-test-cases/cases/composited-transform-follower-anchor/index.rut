// composited-transform-follower-anchor: explicit follower anchor — the
// follower's BOTTOM_RIGHT lands on the target's top-left (the anchor
// math the subsystem solves).
use tur::{ ALIGN_BOTTOM_RIGHT, ALIGN_TOP_RIGHT, ct_link_new, mount };
use tur_kit::{ CompositedFollower, CompositedTarget, Container, Positioned, SizedBox, Stack };


entry fn start() {
    let link = ct_link_new();
    let mut stack = Stack.new();
    stack.child(SizedBox.new(400.0, 600.0).child(Container.new().build()).build());
    let target_child = SizedBox.new(60.0, 40.0).child(Container.new().build()).build();
    let target = CompositedTarget.new().link(link).child(target_child).build();
    stack.child(Positioned.new().left(100.0).top(80.0).child(target).build());
    let mut red = Container.new();
    red.width_height(60.0, 40.0);
    red.color(0x2563EBFFu64);
    red.color(0xFF0000FFu64);
    let follower = CompositedFollower.new().link(link).target_anchor(ALIGN_BOTTOM_RIGHT).follower_anchor(ALIGN_TOP_RIGHT).child(red.build()).build();
    stack.child(follower);
    mount(stack.build());
}
