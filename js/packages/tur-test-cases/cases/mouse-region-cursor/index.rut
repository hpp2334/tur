// mouse-region-cursor: a MouseRegion whose cursor + enter/exit drive the
// shell cursor and the bound state label.
use tur::{ CURSOR_COL_RESIZE, el_box_new, box_size, el_build, el_child, el_column, el_mouse_region, el_qkey, el_text_bound_new, mount, rs_set_str, rs_source_str };

entry fn start() -> u64 {
    let state = rs_source_str("");
    let col = el_column();
    let b = el_box_new();
    box_size(b, 100.0, 50.0);
    let t = el_text_bound_new(state);
    el_qkey(t, "mr-state");
    el_child(b, el_build(t));
    el_child(col, el_mouse_region(state, "mr_enter", "mr_exit", CURSOR_COL_RESIZE, 0, el_build(b)));
    mount(el_build(col));
    return state;
}

entry fn mr_enter(state: u64, _b: u64, _n: f64) {
    rs_set_str(state, "entered");
}

entry fn mr_exit(state: u64, _b: u64, _n: f64) {
    rs_set_str(state, "exited");
}
