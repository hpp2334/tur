// mouse-region-cursor: a MouseRegion whose cursor + enter/exit drive the
// shell cursor and the bound state label. The handlers are mutations over
// the MutationCtx; the state source rides by capture — no ids, no stash.
use tur::{ CURSOR_COL_RESIZE, mount };
use tur_kit::{ Column, Container, EnterEvent, ExitEvent, MouseRegion, MutationCtx, Readable, Text,
    mutate_enter, mutate_exit, source_str };


entry fn start() -> u64 {
    let state: Readable<str> = source_str("");
    let b_enter = mutate_enter(fn (ctx: MutationCtx, _ev: EnterEvent) {
        ctx.set<str>(state, "entered");
    });
    let b_exit = mutate_exit(fn (ctx: MutationCtx, _ev: ExitEvent) {
        ctx.set<str>(state, "exited");
    });
    let mut col = Column();
    let b = Container().width_height(100.0, 50.0).child(Text().text_bound(state).query_key("mr-state").build());
    col.child(MouseRegion().on_enter(b_enter).on_exit(b_exit).cursor(CURSOR_COL_RESIZE).behavior(0).child(b.build()).build());
    mount(col.build());
    return state.atom_id();
}
